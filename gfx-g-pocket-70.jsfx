  gfx_setfont(14); lcol(); TX(X0, y5 + 300, "DETUNE: 1 STEP = 0.2 CENT.  NOTE SHIFT: SEMITONES.  CC / PROGRAM CHANGES FOLLOW THE MIDI CHANNEL OF EACH PART.");
);

// row 3: data display (what the cursor or the mouse is on)
lcol(); RO(X0 + 94, Y0 + 68, 560, 34);
!dshow ? ( p70_page == 0 ? ( strcpy(#dn, cname(p70_cur)); strcpy(#dv, cval(p70_cur, z_[CTP[p70_cur]])); )
                         : ( strcpy(#dn, p70_page == 1 ? "Mixer" : "Tune"); sprintf(#dv, "Part %d", p70_part + 1); ); );
gfx_setfont(9); TX(X0 + 110, Y0 + 72, #dn); TR(X0 + 640, Y0 + 72, #dv);
// row 7: tabs
ty_ = Y0 + 492;
k = 0;
loop(3,
  tx_ = X0 + k*118; on_ = (k == 0 && p70_page == 1) || (k == 1 && p70_page == 2) || (k == 2 && p70_page == 0);
  lcol(); on_ ? R(tx_, ty_, 112, 26) : RO(tx_, ty_, 112, 26);
