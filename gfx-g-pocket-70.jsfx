dy_kst = 7; dy_ink = 0x2E3134; dy_ntick = 11;
TC(60, 400, "REVERB"); dy_knob(60*0.75, 440*0.75, 18*0.75, 3, 0, 100, 45, 0, 0x9DA2A8, "TIME", "");
dy_knob(130*0.75, 440*0.75, 18*0.75, 4, 0, 100, 70, 0, 0x9DA2A8, "LEVEL", "");
