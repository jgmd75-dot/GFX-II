pg(121, 6, 0, 1500, 0.3, 0, 0.5, 80, 500, 0.7, 300, 0, 0.5, 1, 300, 0, 10.5);
strcpy(200 + 121, "BrthNoiz");
pg(122, 6, 0, 900, 0.3, 0, 0.5, 900, 500, 0.7, 1500, 0, 0.5, 1, 300, 0, 12);
strcpy(200 + 122, "Seashore");
pg(123, 0, 24, 3000, 0.1, 1.5, 0.5, 5, 300, 0.5, 100, 0, 0.5, 0, 300, 80, 2);
strcpy(200 + 123, "Tweet");
pg(124, 3, 12, 4000, 0.1, 1.5, 0.5, 1, 100, 1, 50, 0, 0.5, 0, 300, 0, -6);
strcpy(200 + 124, "Telphone");
pg(125, 6, 0, 400, 0.6, 0, 0.5, 5, 500, 0.7, 300, 0, 0.5, 1, 300, 0, 12);
strcpy(200 + 125, "Helicptr");
pg(126, 6, 0, 4000, 0.3, 0, 0.5, 300, 500, 0.7, 800, 0, 0.5, 1, 300, 0, 6.5);
strcpy(200 + 126, "Applause");
pg(127, 6, 0, 1200, 0.2, 0, 0.5, 1, 300, 0, 300, 0, 0.5, 1, 300, 0, 12);
