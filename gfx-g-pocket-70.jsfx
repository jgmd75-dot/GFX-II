// ---------- parts ----------
// 0 program, 1 drum kit, 2 mono, 3 element reserve, 4 vel depth, 5 vel offset, 6 porta sw, 7 porta time,
// 8 MW pitch, 9 MW filter, 10 MW amp, 11 cutoff, 12 resonance, 13 attack, 14 decay, 15 release,
// 16 vib rate, 17 vib depth, 18 vib delay, 19 bend, 20 dry, 21 volume, 22 pan, 23 reverb, 24 chorus,
// 25 note shift, 26 detune, 27 mute
function part_reset(p) local(z) (
  z = PT + p*32; memset(z, 0, 32);
  z[1] = p == 9; z[3] = p == 9 ? 4 : 2; z[4] = 64; z[5] = 64; z[8] = 10; z[19] = 2; z[20] = 127;
  z[21] = 100; z[23] = 40;
);
function ctl_reset(c) local(z) ( z = CH + c*8; z[0] = 0; z[1] = 1; z[2] = 0; z[3] = 0; );
!p70_init ? ( k = 0; loop(16, part_reset(k); k += 1; ); p70_init = 1; );
k = 0; loop(16, ctl_reset(k); k += 1; );
memset(VS, 0, NV*64);

function pnm(p) ( 200 + min(max(floor(p + 0.5), 0), 127); );
function cat_name(c) (
  c == 0 ? "Piano" : c == 1 ? "Chrom Perc" : c == 2 ? "Organ" : c == 3 ? "Guitar" : c == 4 ? "Bass" : c == 5 ? "Strings" :
  c == 6 ? "Ensemble" : c == 7 ? "Brass" : c == 8 ? "Reed" : c == 9 ? "Pipe" : c == 10 ? "Synth Lead" : c == 11 ? "Synth Pad" :
  c == 12 ? "Synth FX" : c == 13 ? "Ethnic" : c == 14 ? "Percussive" : "Sound FX";
);
function cat_abbr(c) (
  c == 0 ? "Pf" : c == 1 ? "Cp" : c == 2 ? "Or" : c == 3 ? "Gt" : c == 4 ? "Ba" : c == 5 ? "St" : c == 6 ? "En" : c == 7 ? "Br" :
  c == 8 ? "Rd" : c == 9 ? "Pi" : c == 10 ? "Ld" : c == 11 ? "Pd" : c == 12 ? "Fx" : c == 13 ? "Et" : c == 14 ? "Pc" : "Se";
);

// ---------- drum kit (GM map): tone (frequency, pitch drop, its time, tone decay, tone level) + filtered noise ----------
function ms2c(ms) ( exp(-1/(max(ms, 0.1)*0.001*srate)); );
function dset(b, f, pe, pt, td, ta, na, nd, nf, hp, lv) local(g, k) (
  b[42] = f; b[43] = pe; b[44] = ms2c(pt); b[45] = ms2c(td); b[8] = ta; b[46] = na; b[47] = ms2c(nd); b[48] = hp;
  g = tan($pi*min(nf, srate*0.45)/srate); k = hp ? 1.4 : 0.9;
  b[20] = k; b[50] = 1/(1 + g*(g + k)); b[51] = g*b[50]; b[52] = g*b[51];
  b[38] = 1; b[39] = 1; b[40] = 1; b[62] *= lv;
);
function drum_setup(b, n) (
  n == 35 || n == 36 ? dset(b, 50, 2.2, 35, 320, 1, 0.08, 15, 3000, 0, 1.1) :
  n == 37 ? dset(b, 420, 0.3, 5, 40, 0.6, 0.4, 30, 2500, 0, 0.7) :
  n == 38 ? dset(b, 190, 0.5, 15, 110, 0.5, 0.75, 170, 3500, 1, 0.9) :
  n == 40 ? dset(b, 210, 0.5, 12, 90, 0.4, 0.85, 150, 5000, 1, 0.9) :
  n == 39 ? dset(b, 0, 0, 1, 1, 0, 1, 160, 1200, 0, 1) :
  n == 42 ? dset(b, 0, 0, 1, 1, 0, 0.6, 45, 8000, 1, 0.6) :
  n == 44 ? dset(b, 0, 0, 1, 1, 0, 0.55, 65, 7500, 1, 0.5) :
  n == 46 ? dset(b, 0, 0, 1, 1, 0, 0.55, 380, 7500, 1, 0.55) :
  n == 41 || n == 43 || n == 45 || n == 47 || n == 48 || n == 50 ?
    dset(b, n == 41 ? 80 : n == 43 ? 95 : n == 45 ? 110 : n == 47 ? 135 : n == 48 ? 155 : 180, 0.5, 60, 350, 1, 0.08, 40, 2000, 0, 0.9) :
  n == 49 || n == 57 || n == 52 ? dset(b, 0, 0, 1, 1, 0, 0.5, 1300, 5500, 1, 0.55) :
  n == 55 ? dset(b, 0, 0, 1, 1, 0, 0.5, 600, 6500, 1, 0.5) :
  n == 51 || n == 59 ? dset(b, 3100, 0, 1, 900, 0.12, 0.3, 1100, 7000, 1, 0.55) :
  n == 53 ? dset(b, 2300, 0, 1, 700, 0.5, 0.15, 600, 6000, 1, 0.55) :
  n == 54 ? dset(b, 0, 0, 1, 1, 0, 0.5, 160, 9000, 1, 0.5) :
  n == 56 ? dset(b, 560, 0, 1, 250, 0.6, 0.1, 80, 800, 0, 0.6) :
  n >= 60 && n <= 64 ? dset(b, n == 60 ? 300 : n == 61 ? 220 : n == 62 ? 200 : n == 63 ? 170 : 140, 0.3, 20, 180, 1, 0.1, 30, 2000, 0, 0.8) :
  n == 69 || n == 70 ? dset(b, 0, 0, 1, 1, 0, 0.45, 70, 7000, 1, 0.45) :
  n == 75 ? dset(b, 2500, 0, 1, 60, 0.8, 0, 1, 1000, 0, 0.6) :
  n == 76 || n == 77 ? dset(b, n == 76 ? 1700 : 1300, 0, 1, 70, 0.8, 0.05, 20, 2000, 0, 0.6) :
  dset(b, 600, 0.2, 10, 80, 0.4, 0.4, 60, 3000, 0, 0.5);
);

// ---------- voice allocation ----------
function part_count(p) local(i, n) ( n = 0; i = 0; loop(NV, VS[i*64] > 0 && VS[i*64 + 2] == p ? n += 1; i += 1; ); n; );
function v_alloc(p) local(i, b, best, ba, a) (
  best = -1;
  i = 0; loop(NV, best < 0 && VS[i*64] == 0 ? best = i; i += 1; );
  // steal: the oldest releasing voice, then the oldest voice of a part above its reserve, then the oldest
  best < 0 ? ( ba = 0; i = 0; loop(NV, b = VS + i*64; b[0] == 3 && (best < 0 || b[6] < ba) ? ( best = i; ba = b[6]; ); i += 1; ); );
  best < 0 ? ( ba = 0; i = 0; loop(NV, b = VS + i*64; a = PT + b[2]*32;
    part_count(b[2]) > a[3] && (best < 0 || b[6] < ba) ? ( best = i; ba = b[6]; ); i += 1; ); );
  best < 0 ? ( ba = 0; i = 0; loop(NV, b = VS + i*64; best < 0 || b[6] < ba ? ( best = i; ba = b[6]; ); i += 1; ); );
  best;
);
function v_release(b) ( b[0] > 0 && b[0] < 3 ? ( b[49] < 0 ? 0 : b[0] = 3; ); b[5] = 0; );

function note_on(c, n, vel) local(z, q, b, v, i, leg, f, at, de, re, vv, len, j, lp) (
  z = PT + c*32;
  !z[27] ? (
    vage += 1;
    leg = -1;
    !z[1] && z[2] ? ( i = 0; loop(NV, b = VS + i*64; b[0] > 0 && b[0] < 3 && b[2] == c && b[5] ? leg = i; i += 1; ); );
    leg >= 0 ? (
      b = VS + leg*64; b[3] = n; b[10] = n + z[25]; !(z[6] && z[7] > 0) ? b[9] = b[10]; b[6] = vage;
    ) : (
      z[1] && (n == 42 || n == 44) ? ( i = 0; loop(NV, b = VS + i*64; b[0] > 0 && b[2] == c && b[3] == 46 ? b[0] = 0; i += 1; ); );
      v = v_alloc(c); b = VS + v*64;
      memset(b, 0, 64);
      b[2] = c; b[3] = n; b[5] = 1; b[6] = vage; b[21] = 0;
      vv = min(max(vel*z[4]/64 + (z[5] - 64), 1), 127)/127;
      b[37] = (rand(2) - 1)*drift*3;                       // drift: a tiny tuning scatter per note
      z[1] ? (
        b[49] = -1; b[7] = -1; b[62] = vv*vv*1.6; b[0] = 2; b[1] = 1;
        drum_setup(b, n);
      ) : (
        b[7] = z[0]; q = PG + z[0]*16;
        b[49] = q[0]; b[9] = b[10] = n + z[25];
        at = q[6]*2^(z[13]/16); de = q[7]*2^(z[14]/16); re = q[9]*2^(z[15]/16);
        b[28] = 1/max(1, at*0.001*srate); b[29] = 1 - exp(-4.6/(max(de, 1)*0.001*srate)); b[30] = q[8];
        b[31] = 1 - exp(-4.6/(max(re, 1)*0.001*srate));
        b[55] = q[10] > 0 ? 2^(q[10]/1200) : 0; b[56] = q[11]; b[57] = q[12]; b[58] = q[13];
        b[59] = q[4]; b[60] = q[5];
        b[61] = min(max(q[2]*2^(z[11]/16), 30), srate*0.45);
        b[20] = 2*(1 - min(max(q[3] + z[12]/128, 0), 0.95));
        b[62] = vv*10^(q[15]/20)*0.5; b[63] = q[14];
        b[54] = q[12]; b[53] = q[0] == 4 ? exp(-1/(max(q[13], 5)*0.001*srate)) : 1; b[16] = q[12];
        b[0] = 1; b[1] = 0; b[24] = 0;
        q[0] == 5 ? (                                     // pluck: fill the line with a noise burst
          f = 440*2^((n + z[25] + q[1] - 69)/12);
          len = min(max(floor(srate/f), 2), 4090); b[26] = len; b[25] = 0;
          lp = 0; j = 0; loop(len, lp += (rand(2) - 1 - lp)*min(1, q[2]/8000 + 0.2); PK[v*4096 + j] = lp*2; j += 1; );
        );
      );
    );
  );
);
function note_off(c, n) local(i, b, z) (
  z = CH + c*8;
  i = 0; loop(NV, b = VS + i*64; b[0] > 0 && b[2] == c && b[3] == n && b[5] ? ( z[2] ? ( b[21] = 1; b[5] = 0; ) : v_release(b); ); i += 1; );
);
function sustain_off(c) local(i, b) ( i = 0; loop(NV, b = VS + i*64; b[0] > 0 && b[2] == c && b[21] ? ( b[21] = 0; v_release(b); ); i += 1; ); );
function all_off(c) local(i, b) ( i = 0; loop(NV, b = VS + i*64; b[0] > 0 && (c < 0 || b[2] == c) ? v_release(b); i += 1; ); );

// ---------- control rate (every 32 samples): pitch, vibrato, mod wheel, filter ----------
function vctl(b, v) local(z, c, q, vr, vd, ramp, vib, mw, st, f, oct, g, k, ac, tc) (
  z = PT + b[2]*32; c = CH + b[2]*8;
  b[49] >= 0 ? (
    q = PG + b[7]*16;
    z[6] && z[7] > 0 ? ( tc = 1 - exp(-32/(z[7]/127*1.5*srate + 1)); b[9] += (b[10] - b[9])*tc; ) : b[9] = b[10];
    vr = 5.5*2^(z[16]/32); vd = b[63] + z[17]*0.8;
    ramp = min(max((b[23]/srate - z[18]/127*2)/0.4, 0), 1);
    b[22] += vr*32/srate; b[22] -= floor(b[22]);
    vib = sin(2*$pi*b[22]);
    mw = c[0];
    st = b[9] + q[1] + z[26]*0.2/100 + c[3]*z[19] + (vib*(vd*ramp + mw*z[8]/127*100) + b[37])/100;
    f = 440*2^((st - 69)/12);
    b[11] = min(f/srate, 0.45);
    b[12] = b[55] > 0 ? min(b[11]*b[55], 0.45) : 0;
    oct = b[59]*(b[1] - 1) + b[60]*(b[3] - 60)/12 + mw*z[9]/127*2*vib;
    f = min(max(b[61]*2^oct, 30), srate*0.45);
    g = tan($pi*f/srate); k = b[20];
    b[50] = 1/(1 + g*(g + k)); b[51] = g*b[50]; b[52] = g*b[51];
    b[19] = 1 - mw*z[10]/127*0.45*(1 + vib);
  );
  // pan / sends from the mixer and controllers
  ac = z[21]/127*c[1];
  b[32] = ac*sqrt(0.5 - z[22]/128); b[33] = ac*sqrt(0.5 + z[22]/128);
  b[34] = z[23]/127; b[35] = z[24]/127; b[36] = z[20]/127;
);

// ---------- one voice, one sample ----------
function vrun(b, v) local(t, y, ph, s, p2, nz, v1, v2, v3, k, a1, a2, a3, i0, i1, o) (
  y = 0;
  b[49] < 0 ? (
    // drum
    b[38] *= b[44]; b[39] *= b[45]; b[40] *= b[47];
    b[42] > 0 ? ( b[13] += b[42]*(1 + b[43]*b[38])/srate; b[13] -= floor(b[13]); y = sin(2*$pi*b[13])*b[39]*b[8]; );
    b[46] > 0 ? (
      nz = rand(2) - 1;
      k = b[20]; a1 = b[50]; a2 = b[51]; a3 = b[52];
      v3 = nz - b[18]; v1 = a1*b[17] + a2*v3; v2 = b[18] + a2*b[17] + a3*v3; b[17] = 2*v1 - b[17]; b[18] = 2*v2 - b[18];
      y += (b[48] ? nz - k*v1 - v2 : k*v1)*b[40]*b[46];
    );
    b[39] < 0.0001 && b[40] < 0.0001 ? b[0] = 0;
    y *= b[62]*0.9;
  ) : (
    // amplitude envelope
    b[0] == 1 ? ( b[1] += b[28]; b[1] >= 1 ? ( b[1] = 1; b[0] = 2; ); ) :
    b[0] == 2 ? ( b[1] += (b[30] - b[1])*b[29]; ) :
    ( b[1] += (0 - b[1])*b[31]; b[1] < 0.0001 ? b[0] = 0; );
    (b[24] -= 1) <= 0 ? ( b[24] = 32; vctl(b, v); );
    b[23] += 1;
    t = b[49];
    b[13] += b[11]; b[13] -= floor(b[13]); ph = b[13];
    t == 0 ? ( y = sin(2*$pi*ph); b[57] > 0 ? ( b[27] += (rand(2) - 1 - b[27])*0.3; y += b[57]*b[27]*2; ); ) :
    t == 1 ? ( y = 1 - 4*abs(ph - 0.5); b[12] > 0 ? ( b[14] += b[12]; b[14] -= floor(b[14]); y = (y + 1 - 4*abs(b[14] - 0.5))*0.6; ); ) :
    t == 2 || t == 8 ? (
      y = 2*ph - 1 - vo_blep(ph, b[11]);
      b[12] > 0 ? ( b[14] += b[12]; b[14] -= floor(b[14]); y = (y + 2*b[14] - 1 - vo_blep(b[14], b[12]))*0.6; );
    ) :
    t == 3 ? (
      p2 = ph + 1 - b[56]; p2 -= floor(p2);
      y = (2*ph - 1 - vo_blep(ph, b[11])) - (2*p2 - 1 - vo_blep(p2, b[11]));
      b[12] > 0 ? ( b[14] += b[12]; b[14] -= floor(b[14]); p2 = b[14] + 1 - b[56]; p2 -= floor(p2);
                    y = (y + (2*b[14] - 1 - vo_blep(b[14], b[12])) - (2*p2 - 1 - vo_blep(p2, b[12])))*0.6; );
    ) :
    t == 4 ? (
      b[15] += b[11]*b[56]; b[15] -= floor(b[15]);
      b[16] = b[16]*b[53] + b[54]*0.15*(1 - b[53]);       // the index falls towards 15 % of its start
      y = sin(2*$pi*ph + b[16]*sin(2*$pi*b[15]));
    ) :
    t == 5 ? (
      o = PK + v*4096; i0 = b[25]; i1 = i0 + 1; i1 >= b[26] ? i1 = 0;
      y = o[i0]; o[i0] = (o[i0] + o[i1])*0.5*b[58]; b[25] = i1;
    ) :
    t == 6 ? ( y = rand(2) - 1; ) :
    t == 7 ? ( y = (sin(2*$pi*ph) + b[56]*sin(4*$pi*ph) + b[57]*sin(6*$pi*ph) + 0.35*sin(8*$pi*ph))*0.5; );
    // 12 dB state-variable low-pass
    a1 = b[50]; a2 = b[51]; a3 = b[52];
    v3 = y - b[18]; v1 = a1*b[17] + a2*v3; v2 = b[18] + a2*b[17] + a3*v3; b[17] = 2*v1 - b[17]; b[18] = 2*v2 - b[18];
    y = v2*b[1]*b[62]*b[19];
  );
  y;
);

// ---------- effects ----------
RVN = 0;
CML = 149000; CMB = 149010; CMP = 149020; CMF = 149030; APL = 149040; APB = 149050; APP = 149060;
memset(149000, 0, 70);
function rv_alloc(n) local(p) ( p = RV + RVN; RVN += n + 4; p; );
rs_ = srate/44100;
k = 0; loop(8, CML[k] = floor((k == 0 ? 1116 : k == 1 ? 1277 : k == 2 ? 1422 : k == 3 ? 1557 : k == 4 ? 1139 : k == 5 ? 1300 : k == 6 ? 1445 : 1580)*rs_);
  CMB[k] = rv_alloc(CML[k]); k += 1; );
k = 0; loop(4, APL[k] = floor((k == 0 ? 556 : k == 1 ? 441 : k == 2 ? 579 : 464)*rs_); APB[k] = rv_alloc(APL[k]); k += 1; );
CHB = rv_alloc(4096); chw = 0;
memset(RV, 0, RVN);
function comb(k, x) local(b, i, y) (
  b = CMB[k]; i = CMP[k]; y = b[i];
  CMF[k] = y*(1 - rv_damp) + CMF[k]*rv_damp;
  b[i] = x + CMF[k]*rv_fb; i += 1; i >= CML[k] ? i = 0; CMP[k] = i;
  y;
);
function allp(k, x) local(b, i, y) (
  b = APB[k]; i = APP[k]; y = b[i];
  b[i] = x + y*0.5; i += 1; i >= APL[k] ? i = 0; APP[k] = i;
  y - x;
);

// ---------- event queue ----------
function q_push(ofs, t, n, v, c) local(i) (
  qcount < 390 ? (
    i = qcount; while (i > 0 && EQO[i - 1] > ofs) ( EQO[i] = EQO[i - 1]; EQT[i] = EQT[i - 1]; EQN[i] = EQN[i - 1]; EQV[i] = EQV[i - 1]; EQC[i] = EQC[i - 1]; i -= 1; );
    EQO[i] = ofs; EQT[i] = t; EQN[i] = n; EQV[i] = v; EQC[i] = c; qcount += 1;
  );
);

function update() (
  drift = slider2/100;
  rv_fb = 0.7 + slider3/100*0.28; rv_damp = 0.35 - slider3/100*0.15; rv_lv = slider4/100*0.35;
  ch_dep = slider5/100;
  vol_t = 10^(slider1/20);
  ins_output_setup(6);
);
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
sm = 1 - exp(-1/(0.03*srate));
vage = 0; qcount = 0; chph = 0; kb_held = -1; kb_on = kb_off = 0;
!ui_dflt ? ( ui_sz = 2; p70_part = 0; p70_page = 0; p70_cur = 0; p70_oct = 0; );
!p70_fset ? ( p70_follow = 1; p70_fset = 1; );   // FOLLOW starts on (older projects too)
update(); vol_s = vol_t;
ui_dflt = 1;

@slider
update();

@block
update();
qcount = 0;
while (midirecv(mofs, m1, m2, m3)) (
  st = m1 & 0xF0; c = m1 & 0x0F; z = PT + c*32; zc = CH + c*8;
  st == 0x90 && m3 > 0 ? ( q_push(mofs, 1, m2, m3, c); ins_midi_hit(); midi_part = c; midi_t = time_precise(); p70_follow ? p70_part = c; ) :
  st == 0x80 || st == 0x90 ? q_push(mofs, 0, m2, 0, c) :
  st == 0xE0 ? zc[3] = ((m3*128 + m2) - 8192)/8192 :
  st == 0xC0 ? ( !z[1] ? z[0] = m2; ) :
  st == 0xB0 ? (
    m2 == 0 ? z[1] = (m3 == 127 || m3 == 126) ? 1 : (c == 9 && m3 == 0 ? 1 : 0) :
    m2 == 1 ? zc[0] = m3/127 :
    m2 == 5 ? z[7] = m3 :
    m2 == 7 ? z[21] = m3 :
    m2 == 10 ? z[22] = m3 - 64 :
    m2 == 11 ? zc[1] = m3/127 :
    m2 == 64 ? ( zc[2] = m3 >= 64; !zc[2] ? q_push(mofs, 2, 0, 0, c); ) :
    m2 == 65 ? z[6] = m3 >= 64 :
    m2 == 71 ? z[12] = m3 - 64 :
    m2 == 72 ? z[15] = m3 - 64 :
    m2 == 73 ? z[13] = m3 - 64 :
    m2 == 74 ? z[11] = m3 - 64 :
    m2 == 91 ? z[23] = m3 :
    m2 == 93 ? z[24] = m3 :
    m2 == 121 ? ( zc[0] = 0; zc[1] = 1; zc[3] = 0; zc[2] = 0; q_push(mofs, 2, 0, 0, c); ) :
    m2 == 120 || m2 == 123 ? q_push(mofs, 3, 0, 0, c);
  );
);
// the mini keyboard on the panel plays the selected part
kb_on > 0 ? ( q_push(0, 1, kb_on - 1, 100, p70_part); kb_on = 0; );
kb_off > 0 ? ( q_push(0, 0, kb_off - 1, 0, p70_part); kb_off = 0; );
panic_req ? ( q_push(0, 3, 0, 0, -1); panic_req = 0; );
eqi = 0; spos = 0;

@serialize
file_var(0, ui_sz);
file_var(0, p70_init);
file_var(0, p70_part);
file_var(0, p70_page);
file_mem(0, PT, 16*32);
file_avail(0) != 0 ? file_var(0, p70_follow);

@sample
while (eqi < qcount && EQO[eqi] <= spos) (
  et = EQT[eqi];
  et == 1 ? note_on(EQC[eqi], EQN[eqi], EQV[eqi]) : et == 0 ? note_off(EQC[eqi], EQN[eqi]) : et == 2 ? sustain_off(EQC[eqi]) : all_off(EQC[eqi]);
  eqi += 1;
);
spos += 1;

dL = dR = rvsnd = chsnd = 0;
vi = 0;
loop(NV,
  vb = VS + vi*64;
  vb[0] > 0 ? (
    vy = vrun(vb, vi);
    vb[49] < 0 ? ( (vb[24] -= 1) <= 0 ? ( vb[24] = 32; vctl(vb, vi); ); );
    vd = vy*vb[36];
    dL += vd*vb[32]; dR += vd*vb[33];
    rvsnd += vy*vb[34]*(vb[32] + vb[33]); chsnd += vy*vb[35]*(vb[32] + vb[33]);
  );
  vi += 1;
);
// reverb: four combs and two all-passes a side
rin = rvsnd*0.5;
rL = comb(0, rin) + comb(1, rin) + comb(2, rin) + comb(3, rin);
rR = comb(4, rin) + comb(5, rin) + comb(6, rin) + comb(7, rin);
rL = allp(1, allp(0, rL)); rR = allp(3, allp(2, rR));
// chorus: one line, two modulated taps
CHB[chw] = chsnd; chw = (chw + 1) & 4095;
chph += 0.6/srate; chph -= floor(chph);
cdl = (0.012 + 0.004*ch_dep*sin(2*$pi*chph))*srate; cdr = (0.012 + 0.004*ch_dep*cos(2*$pi*chph))*srate;
p_ = chw - cdl; p_ < 0 ? p_ += 4096; i_ = floor(p_); f_ = p_ - i_; cL = CHB[i_ & 4095]*(1 - f_) + CHB[(i_ + 1) & 4095]*f_;
p_ = chw - cdr; p_ < 0 ? p_ += 4096; i_ = floor(p_); f_ = p_ - i_; cR = CHB[i_ & 4095]*(1 - f_) + CHB[(i_ + 1) & 4095]*f_;
oL = dL + rL*rv_lv + cL*0.7;
oR = dR + rR*rv_lv + cR*0.7;
vol_s += (vol_t - vol_s)*sm;
oL = ostL.ost_band(oL*0.4)*vol_s;
oR = ostR.ost_band(oR*0.4)*vol_s;
ost_out(oL, oR);
spl0 = ost_l;
spl1 = ost_r;

@gfx 960 570
// =====================================================================
// GUI - the house rack layout: a top bar with the backlit LCD, the 16 part keys underneath, then
// page 1 (every program, click a name to give it to the selected part) or page 2 (EDIT: the selected part's
// voice, envelope, vibrato and mix, plus the effects). Design space 1280 x 760 at qs = 0.75 * sc.
// =====================================================================
ui_begin(960, 570);
qs = sc*0.75;
gfx_setfont(9, "Courier New", 24*qs, 'b');
gfx_setfont(10, "Courier New", 17*qs, 'b');
gfx_setfont(11, "Trebuchet MS", 15*qs, 'b');
gfx_setfont(12, "Trebuchet MS", 40*qs, 'b');
gfx_setfont(13, "Trebuchet MS", 17*qs, 'b');
gfx_setfont(14, "Trebuchet MS", 18*qs, 'b');
gfx_setfont(15, "Courier New", 16*qs, 'b');
gfx_setfont(16, "Trebuchet MS", 13*qs, 'b');
BG = 0xB9BDC1; BG2 = 0xC9CCCF; BG3 = 0xA7ABB0; INK = 0x22262A; INK2 = 0x51575D; ACC = 0x2F6FB8;
LB = 0xBFD0C4; LK = 0x16201C; KC = 0x6A6F76;

function R(x, y, w, h) ( gfx_rect(x*qs, y*qs, max(1, w*qs), max(1, h*qs)); );
function RR(x, y, w, h, r) ( rd_rr(x*qs, y*qs, w*qs, h*qs, r*qs); );
function TX(x, y, t) ( gfx_x = x*qs; gfx_y = y*qs; gfx_drawstr(t); );
function TC(cx, y, t) local(w, h) ( gfx_measurestr(t, w, h); gfx_x = cx*qs - w*0.5; gfx_y = y*qs; gfx_drawstr(t); );
function TR(rx, y, t) local(w, h) ( gfx_measurestr(t, w, h); gfx_x = rx*qs - w; gfx_y = y*qs; gfx_drawstr(t); );
function inbox(x, y, w, h) ( mouse_x >= x*qs && mouse_x < (x + w)*qs && mouse_y >= y*qs && mouse_y < (y + h)*qs; );
function hitbox(x, y, w, h) local(h_) ( h_ = pressed && drag_id == 0 && inbox(x, y, w, h); h_ ? drag_id = -1; h_; );
function pz() ( PT + p70_part*32; );
function key(x, y, w, h, on, c, cap) local(hit) (
  rd_sqbg = 0x55595E;
  hit = rd_sq(x*0.75, y*0.75, w*0.75, h*0.75, on, c, "");
  gfx_setfont(11); ui_col(INK); TC(x + w*0.5, y + h + 5, cap);
  hit;
);
function sect(x, y, w, h, t) (
  ui_col(BG3); RR(x, y, w, h, 6); ui_col(BG2); RR(x + 2, y + 2, w - 4, h - 4, 5);
  gfx_setfont(13); ui_col(ACC); TX(x + 12, y + 8, t);
);
// a knob on a part setting (memory, not a slider): drag, wheel, double-click resets; value on hover only
function pknob(off, cx, cy, r, lo, hi, def, cap, label, fmt) local(z, did, hov, f, a, v, i, t) (
  z = pz() + off; did = 5000 + off;
  hov = (mouse_x - cx*qs)^2 + (mouse_y - cy*qs)^2 <= ((r + 6)*qs)^2;
  pressed && hov && drag_id == 0 ? (
    time_precise() - pk_t < 0.35 && pk_id == did ? ( z[0] = def; drag_id = -1; pk_t = 0; ) :
    ( drag_id = did; pk_y = mouse_y; pk_v = z[0]; pk_t = time_precise(); pk_id = did; );
  );
  drag_id == did ? ( v = pk_v + (pk_y - mouse_y)/((mouse_cap & 8 ? 6 : 1.4)*sc)*(hi - lo)/127; z[0] = min(max(floor(v + 0.5), lo), hi); );
  hov && mouse_wheel != 0 && drag_id == 0 ? ( z[0] = min(max(z[0] + sign(mouse_wheel), lo), hi); mouse_wheel = 0; );
  f = (z[0] - lo)/(hi - lo); a = (-0.75 + 1.5*f)*$pi;
  i = 0; loop(11, t = (-0.75 + 1.5*i/10)*$pi; ui_cola(INK, 0.7);
    gfx_line((cx + sin(t)*(r + 4))*qs, (cy - cos(t)*(r + 4))*qs, (cx + sin(t)*(r + 9))*qs, (cy - cos(t)*(r + 9))*qs, 1); i += 1; );
  ui_cola(0x000000, 0.35); gfx_circle((cx + 1.5)*qs, (cy + 2.5)*qs, r*qs, 1, 1);
  ui_col(0x16181B); gfx_circle(cx*qs, cy*qs, r*qs, 1, 1);
  ui_col(cap); gfx_circle(cx*qs, cy*qs, r*0.72*qs, 1, 1);
  ui_cola(0xFFFFFF, 0.25); gfx_circle((cx - r*0.2)*qs, (cy - r*0.25)*qs, r*0.3*qs, 1, 1);
  ui_kline(cx*qs, cy*qs, a, r*0.15*qs, r*0.95*qs, 2.4, 0xF2F2EE);
  (hov || drag_id == did) ? ( ui_cola(0xFFFFFF, 0.15); gfx_circle(cx*qs, cy*qs, (r + 3)*qs, 0, 1); );
  gfx_setfont(11); ui_col(INK); TC(cx, cy + r + 12, label);
  hov || drag_id == did ? ( sprintf(#pkv, fmt, z[0]); gfx_setfont(10); ui_col(INK); TC(cx, cy + r + 30, #pkv); );
);
function prog_name(z) ( z[1] ? "Drum Kit" : pnm(z[0]); );

// ---------------------------------------------------------------------
ui_col(BG); gfx_rect(0, 0, gfx_w, gfx_h);
z_ = pz();

// ---- top bar ----
ui_col(0x2A2E33); R(0, 0, 1280, 150);
gfx_gradrect(0, 0, 1280*qs, 60*qs, 1, 1, 1, 0.05, 0, 0, 0, 0, 0, 0, 0, -0.05/(60*qs));
ui_col(ACC); gfx_circle(48*qs, 56*qs, 22*qs, 1, 1);
gfx_setfont(2); ui_col(0xFFFFFF); ui_text(48*qs, 49*qs, "GFX");
gfx_setfont(12); ui_col(0xEDEDEA); TX(82, 30, "G POCKET 70");
gfx_setfont(11); ui_col(0xA6ACB2); TX(84, 82, "16-PART TONE GENERATOR");
// the backlit LCD: part, program number and name
ui_col(0x101214); R(360, 18, 470, 114);
ui_col(LB); R(366, 24, 458, 102);
gfx_gradrect(366*qs, 24*qs, 458*qs, 102*qs, 1, 1, 1, 0.08, 0, 0, 0, 0, 0, 0, 0, -0.08/(102*qs));
ui_col(LK); gfx_setfont(10);
sprintf(#l1, "PART %02d   CH %02d   %s", p70_part + 1, p70_part + 1, z_[1] ? "DRUM" : cat_name(floor(z_[0]/8))); TX(378, 32, #l1);
gfx_setfont(9); z_[1] ? strcpy(#l2, "--- ") : sprintf(#l2, "%03d ", z_[0] + 1); strcat(#l2, prog_name(z_)); TX(378, 62, #l2);
gfx_setfont(10); time_precise() - midi_t < 0.15 ? ( sprintf(#l3, "MIDI IN  CH %d", midi_part + 1); TX(378, 98, #l3); );
ui_button(842*qs, 26*qs, 42*qs, 98*qs, "<", 0, 1) ? ( !z_[1] ? z_[0] = (z_[0] + 127) % 128; );
ui_button(888*qs, 26*qs, 42*qs, 98*qs, ">", 0, 1) ? ( !z_[1] ? z_[0] = (z_[0] + 1) % 128; );
rd_sqbg = 0x55595E; rd_sq(952*0.75, 24*0.75, 74*0.75, 32*0.75, p70_page == 0, ACC, "LIST") ? p70_page = 0;
rd_sq(1034*0.75, 24*0.75, 74*0.75, 32*0.75, p70_page != 0, 0xFFB030, "EDIT") ? p70_page = 1;
rd_sq(952*0.75, 82*0.75, 74*0.75, 28*0.75, p70_follow, 0x46D86A, "FOLLOW") ? p70_follow = !p70_follow;
rd_led(1050*0.75, 97*0.75, 6*0.75, ins_midi_lit(), 0x46D86A);
gfx_setfont(11); ui_col(0xA6ACB2); TX(1062, 90, "MIDI");
dy_kst = 7; dy_ink = 0xD8D8D2; dy_ntick = 11;
sprintf(#mv, "%+.1f dB", slider1); dy_knob(1172*0.75, 58*0.75, 24*0.75, 1, -24, 6, 0, 0, 0x9DA2A8, "VOLUME", #mv);
ui_size_picker(1124*qs, 120*qs);

// ---- the 16 part keys ----
k = 0;
loop(16,
  px_ = 12 + k*79; zz_ = PT + k*32; on_ = k == p70_part; act_ = part_count(k) > 0;
  ui_col(on_ ? ACC : zz_[27] ? 0x8A8E93 : 0x3A3E43); RR(px_, 158, 74, 52, 6);
  act_ ? ( ui_col(0x46D86A); gfx_circle((px_ + 64)*qs, (168)*qs, 4*qs, 1, 1); );
  gfx_setfont(13); ui_col(0xFFFFFF); sprintf(#pn_, "%d", k + 1); TX(px_ + 8, 162, #pn_);
  gfx_setfont(16); ui_col(on_ ? 0xFFFFFF : 0xC9CDD2); TX(px_ + 6, 188, zz_[1] ? "Drums" : pnm(zz_[0]));
  hitbox(px_, 158, 74, 52) ? p70_part = k;
  k += 1;
);

p70_page == 0 ? (
  // ---- page 1: all 128 programs (two categories a column) and the drum kit - click a name to load it ----
  c_ = 0;
  loop(8,
    cx_ = 12 + c_*158;
    j = 0;
    loop(2,
      ct_ = c_*2 + j; y_ = 222 + j*240;
      gfx_setfont(14); ui_col(ACC); TX(cx_ + 4, y_, cat_name(ct_)); ui_cola(ACC, 0.5); R(cx_ + 4, y_ + 22, 148, 1);
      i = 0;
      loop(8,
        pg_ = ct_*8 + i; ty_ = y_ + 26 + i*25.5;
        on_ = !z_[1] && z_[0] == pg_; hv_ = inbox(cx_, ty_, 152, 24);
        on_ ? ( ui_col(ACC); RR(cx_, ty_, 152, 24, 4); ) : hv_ ? ( ui_col(BG3); RR(cx_, ty_, 152, 24, 4); );
        gfx_setfont(15); ui_col(on_ ? 0xFFFFFF : INK2); sprintf(#pe, "%03d", pg_ + 1); TX(cx_ + 4, ty_ + 3, #pe);
        gfx_setfont(14); ui_col(on_ ? 0xFFFFFF : INK); TX(cx_ + 42, ty_ + 2, pnm(pg_));
        hitbox(cx_, ty_, 152, 24) ? ( z_[0] = pg_; z_[1] = 0; );
        i += 1;
      );
      j += 1;
    );
    c_ += 1;
  );
  // the drum kit, along the bottom
  on_ = z_[1]; hv_ = inbox(12, 706, 300, 30);
  ui_col(on_ ? 0xFFB030 : hv_ ? BG3 : BG2); RR(12, 706, 300, 30, 5);
  gfx_setfont(14); ui_col(INK); TX(24, 711, on_ ? "DRUM KIT  (GM MAP)  - ON" : "DRUM KIT  (GM MAP)");
  hitbox(12, 706, 300, 30) ? z_[1] = !z_[1];
  gfx_setfont(11); ui_col(INK2); TX(330, 714, "Click a name to give it to the selected part.  Each part plays on its own MIDI channel; channel 10 starts as drums.");
) : (
  // ---- page 2: EDIT the selected part, and the effects ----
  sect(12, 222, 300, 236, "VOICE");
  key(30, 262, 74, 30, z_[2], ACC, "MONO") ? z_[2] = !z_[2];
  key(122, 262, 74, 30, z_[6], ACC, "GLIDE") ? z_[6] = !z_[6];
  key(214, 262, 74, 30, z_[27], 0xD0503C, "MUTE") ? ( z_[27] = !z_[27]; z_[27] ? all_off(p70_part); );
  pknob(7, 70, 376, 24, 0, 127, 0, KC, "GLIDE TIME", "%d");
  pknob(4, 160, 376, 24, 0, 127, 64, KC, "VELOCITY", "%d");
  pknob(25, 250, 376, 24, -24, 24, 0, KC, "TRANSPOSE", "%+d st");

  sect(322, 222, 270, 236, "FILTER");
  pknob(11, 392, 330, 30, -64, 63, 0, 0x3D70CC, "CUTOFF", "%+d");
  pknob(12, 522, 330, 30, -64, 63, 0, 0x3D70CC, "RESONANCE", "%+d");
  gfx_setfont(11); ui_col(INK2); TC(457, 412, "relative to the voice");

  sect(602, 222, 360, 236, "ENVELOPE");
  pknob(13, 660, 330, 30, -64, 63, 0, 0x33A052, "ATTACK", "%+d");
  pknob(14, 782, 330, 30, -64, 63, 0, 0x33A052, "DECAY", "%+d");
  pknob(15, 904, 330, 30, -64, 63, 0, 0x33A052, "RELEASE", "%+d");
  // the envelope shape
  q_ = PG + z_[0]*16;
  ea_ = 10 + 60*min(max((log(max(q_[6], 1)*2^(z_[13]/16))/log(10))/3.5, 0), 1);
  ed_ = 10 + 70*min(max((log(max(q_[7], 1)*2^(z_[14]/16))/log(10))/4, 0), 1);
  er_ = 10 + 70*min(max((log(max(q_[9], 1)*2^(z_[15]/16))/log(10))/4, 0), 1);
  es_ = z_[1] ? 0 : q_[8]; gx_ = 640; gy_ = 448; gh_ = 40;
  ui_col(ACC);
  gfx_line(gx_*qs, gy_*qs, (gx_ + ea_)*qs, (gy_ - gh_)*qs, 1);
  gfx_line((gx_ + ea_)*qs, (gy_ - gh_)*qs, (gx_ + ea_ + ed_)*qs, (gy_ - es_*gh_)*qs, 1);
  gfx_line((gx_ + ea_ + ed_)*qs, (gy_ - es_*gh_)*qs, (gx_ + 300 - er_)*qs, (gy_ - es_*gh_)*qs, 1);
  gfx_line((gx_ + 300 - er_)*qs, (gy_ - es_*gh_)*qs, (gx_ + 300)*qs, gy_*qs, 1);

  sect(972, 222, 296, 236, "VIBRATO");
  pknob(16, 1022, 330, 24, -64, 63, 0, 0x8A6BD8, "RATE", "%+d");
  pknob(17, 1120, 330, 24, -64, 63, 0, 0x8A6BD8, "DEPTH", "%+d");
  pknob(18, 1218, 330, 24, -64, 63, 0, 0x8A6BD8, "DELAY", "%+d");
  pknob(8, 1120, 410, 18, 0, 127, 10, 0x8A6BD8, "MOD WHEEL", "%d");

  sect(12, 468, 620, 270, "MIX  -  THIS PART");
  pknob(21, 90, 580, 30, 0, 127, 100, 0x9DA2A8, "VOLUME", "%d");
  pknob(22, 230, 580, 30, -64, 63, 0, 0x9DA2A8, "PAN", "%+d");
  pknob(23, 370, 580, 30, 0, 127, 40, 0xC8862A, "REVERB", "%d");
  pknob(24, 510, 580, 30, 0, 127, 0, 0x2FB3A8, "CHORUS", "%d");
  pknob(19, 160, 680, 18, 0, 24, 2, 0x9DA2A8, "BEND RANGE", "%d st");
  pknob(26, 440, 680, 18, -64, 63, 0, 0x9DA2A8, "DETUNE", "%+d");

  sect(642, 468, 626, 270, "EFFECTS  -  ALL PARTS");
  dy_kst = 7; dy_ink = INK; dy_ntick = 11;
  sprintf(#e3, "%d%%", slider3); dy_knob(720*0.75, 580*0.75, 30*0.75, 3, 0, 100, 45, 0, 0xC8862A, "REVERB TIME", #e3);
  sprintf(#e4, "%d%%", slider4); dy_knob(860*0.75, 580*0.75, 30*0.75, 4, 0, 100, 70, 0, 0xC8862A, "REVERB LEVEL", #e4);
  sprintf(#e5, "%d%%", slider5); dy_knob(1000*0.75, 580*0.75, 30*0.75, 5, 0, 100, 50, 0, 0x2FB3A8, "CHORUS DEPTH", #e5);
  sprintf(#e2, "%d%%", slider2); dy_knob(1140*0.75, 580*0.75, 24*0.75, 2, 0, 100, 10, 0, 0x8A6BD8, "DRIFT", #e2);
  ins_io(1000*0.75, 668*0.75, 6, INK);
  gfx_setfont(11); ui_col(INK2); TX(670, 684, "OUTPUT STAGE");
);

pk_end();
ui_end();
