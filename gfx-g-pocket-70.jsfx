);
gfx_setfont(14); ui_col(0x4A4E53);
TC(287, 668, "MIXER"); TC(378, 668, "TUNE"); TC(469, 668, "VOICE"); TC(560, 668, "PART -"); TC(651, 668, "PART +"); TC(742, 668, "DRUM"); TC(924, 668, "PANIC");

// ---- left: part / octave keys, MIDI lamp ----
gfx_setfont(11); ui_col(0x2E3134); TC(95, 110, "PART");
bkey(40, 130, 50, 34, "-") ? p70_part = (p70_part + 15) % 16;
