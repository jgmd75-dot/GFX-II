// ---- mini keyboard (two octaves and a C), plays the selected part ----
kx0 = 196; ky0 = 690; kw_ = 808/15; kh_ = 140;
ui_col(0x26292C); RR(kx0 - 8, ky0 - 8, 824, kh_ + 16, 8);
kdown_ = -1;
mdown && mouse_y >= ky0*qs && mouse_y < (ky0 + kh_)*qs && mouse_x >= kx0*qs && mouse_x < (kx0 + 808)*qs && (drag_id == 0 || drag_id == 9000) ? (
