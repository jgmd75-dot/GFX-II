pg(115, 4, 12, 5000, 0.1, 1.5, 0.5, 1, 120, 0, 80, 0, 3.1, 3, 20, 0, 7);
strcpy(200 + 115, "WoodBlok");
pg(116, 6, -24, 200, 0.3, 2, 0.5, 1, 800, 0, 400, 0, 0.5, 0.3, 300, 0, 12);
strcpy(200 + 116, "TaikoDrm");
pg(117, 0, -12, 3000, 0.1, 0, 0.5, 1, 500, 0, 300, 0, 0.5, 0.1, 300, 0, 4.5);
strcpy(200 + 117, "MelodTom");
pg(118, 0, 0, 4000, 0.1, 1.5, 0.5, 1, 400, 0, 200, 0, 0.5, 0.05, 300, 0, 5);
strcpy(200 + 118, "Syn.Drum");
pg(119, 6, 0, 6000, 0.2, 0, 0.5, 1500, 100, 1, 200, 0, 0.5, 1, 300, 0, 12);
strcpy(200 + 119, "RevCymbl");
pg(120, 6, 0, 2500, 0.3, 0, 0.5, 1, 150, 0, 300, 0, 0.5, 1, 300, 0, 12);
