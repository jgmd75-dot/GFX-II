pg(113, 4, 12, 6000, 0.1, 1.5, 0.5, 1, 400, 0, 200, 0, 2.3, 2, 80, 0, 5.5);
strcpy(200 + 113, "Agogo");
pg(114, 4, 0, 6000, 0.1, 1.5, 0.5, 1, 1500, 0, 500, 0, 2, 1.5, 300, 0, 0);
