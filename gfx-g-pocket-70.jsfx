desc:GFX G Pocket 70
//tags: instrument multitimbral gm xg rompler sound module
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-output, gfx-ui, gfx-panel, gfx-instrument, gfx-voice, gfx-drift, gfx-dyn and gfx-faceplate (.jsfx-inc)
// in the same folder.
//
// A 16-part sound module in the spirit of the late-90s pocket sequencers: every MIDI channel plays its own
// part (channel 10 is the drum kit), and every part has the classic VOICE EDIT page.
// VOICES      128 GM-style programs (synthesised - no samples), grouped in 16 categories, plus a drum kit
//             on the GM drum map. Program change, bank select (MSB 127 = drums) and the usual controllers work.
// VOICE EDIT  per part: MONO / POLY, ELEMENT RESERVE (voices kept for the part), VELOCITY SENS depth and offset,
//             PORTAMENTO switch and time, MOD WHEEL LFO depth to pitch / filter / amplitude, FILTER cutoff and
//             resonance, EG attack / decay / release, VIBRATO rate / depth / delay, BEND range, DRY level.
// MIXER       per part: volume, pan, reverb and chorus sends, mute.     TUNE  per part: note shift, detune.
// EFFECTS     reverb and chorus buses (time / level / depth on the sliders), then the GFX output stage.
// POLYPHONY   16 voices shared by the parts (the reserve keeps voices for a part when the others are busy).
// DRIFT       a digital box: only a tiny tuning scatter on each note.
// MIDI CCs    0 / 32 bank, 1 mod wheel, 5 porta time, 7 volume, 10 pan, 11 expression, 64 sustain, 65 porta,
//             71 resonance, 72 release, 73 attack, 74 cutoff, 91 reverb, 93 chorus, 120 / 123 off, 121 reset.
// The mini keyboard plays the selected part. The part settings are saved with the project.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-voice.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:0<-24,6,0.1>-Master volume (dB)
slider2:10<0,100,1>-Drift (%)
slider3:45<0,100,1>-Reverb time (%)
slider4:70<0,100,1>-Reverb level (%)
slider5:50<0,100,1>-Chorus depth (%)
slider6:0<0,100,1>-Band sat (%)
slider7:30<0,100,1>-Bias (%)
slider8:120<40,400,1>-Sat low band (Hz)
slider9:6000<2000,16000,10>-Sat high band (Hz)
slider10:-0.3<-24,0,0.1>-Ceiling / limit threshold (dB)
slider11:1<0,2,1{Off,Clip,Limit}>-Output stage

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-pocket-70";
NV = 16;
PG = 70000;              // programs: 128 x 16
PT = 72100;              // parts: 16 x 32 (saved)
CH = 72700;              // per channel controllers: 16 x 8
VS = 73000;              // voices: 16 x 64
PK = 80000;              // pluck delay lines: 16 x 4096
RV = 150000;             // reverb / chorus memory
EQO = 146000; EQT = 146400; EQN = 146800; EQV = 147200; EQC = 147600;   // event queue

function pg(i, a, b, c, d, e, f, g, h, k, l, m, n, o, p, q, r) local(z) (
  z = PG + i*16;
  z[0] = a; z[1] = b; z[2] = c; z[3] = d; z[4] = e; z[5] = f; z[6] = g; z[7] = h;
  z[8] = k; z[9] = l; z[10] = m; z[11] = n; z[12] = o; z[13] = p; z[14] = q; z[15] = r;
);
// ---------- the 128 programs (type, octave, cutoff, resonance, filter env, key track, A, D, S, R,
//            detune 2nd osc, p1, p2, p3, vibrato, level) and their names ----------
