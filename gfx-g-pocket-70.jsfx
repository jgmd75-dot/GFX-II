gfx_setfont(11); ui_col(0x2E3134); TC(1105, 290, "VALUE");
p70_page == 0 ? (
  bkey(1040, 310, 60, 34, "-1/NO") ? ( zp_ = pz() + CTP[p70_cur]; zp_[0] = max(zp_[0] - 1, CMN[p70_cur]); );
  bkey(1110, 310, 60, 34, "+1/YES") ? ( zp_ = pz() + CTP[p70_cur]; zp_[0] = min(zp_[0] + 1, CMX[p70_cur]); );
) : ( bkey(1040, 310, 60, 34, "-1/NO"); bkey(1110, 310, 60, 34, "+1/YES"); );

// ---- the slider row: drift, reverb, chorus, master, output stage ----
