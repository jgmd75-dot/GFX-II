time_precise() - midi_t < 0.15 ? ( gfx_setfont(11); ui_col(0x2E3134); sprintf(#mp, "PART %d", midi_part + 1); TC(95, 336, #mp); );
// ---- right: cursor and value keys ----
gfx_setfont(11); ui_col(0x2E3134); TC(1105, 110, "CURSOR");
bkey(1080, 130, 50, 34, "^") ? p70_page == 0 ? p70_cur = p70_cur >= 9 ? max(p70_cur - 9, 0) : p70_cur;
bkey(1050, 170, 50, 34, "<") ? p70_page == 0 ? p70_cur = max(p70_cur - 1, 0) : p70_part = (p70_part + 15) % 16;
