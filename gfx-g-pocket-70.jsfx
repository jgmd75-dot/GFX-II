      mouse_x >= bx2_*qs && mouse_x < (bx2_ + kw_*0.6)*qs ? kdown_ = floor(j/7)*12 + (j % 7 == 0 ? 1 : j % 7 == 1 ? 3 : j % 7 == 3 ? 6 : j % 7 == 4 ? 8 : 10); ); j += 1; );
  );
);
