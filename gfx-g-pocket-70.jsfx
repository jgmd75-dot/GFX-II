  hitbox(tx_, ty_, 112, 26) ? p70_page = k == 0 ? 1 : k == 1 ? 2 : 0;
  k += 1;
);
lcol(); RO(X0 + W - 112, ty_, 112, 26); gfx_setfont(10); TC(X0 + W - 56, ty_ + 4, "PT1~16");

// ---- keys under the LCD ----
fy_ = 640;
k = 0;
loop(9,
  fx_ = 196 + k*91;
  bkey(fx_, fy_, 80, 24, k == 0 || k == 7 ? "SHIFT" : k == 8 ? "EXIT" : sprintf(#fk, "F%d", k)) ? (
    k == 1 ? p70_page = 1 : k == 2 ? p70_page = 2 : k == 3 ? p70_page = 0 :
    k == 4 ? p70_part = (p70_part + 15) % 16 : k == 5 ? p70_part = (p70_part + 1) % 16 :
    k == 6 ? ( (pz())[1] = !(pz())[1]; ) : k == 8 ? panic_req = 1;
