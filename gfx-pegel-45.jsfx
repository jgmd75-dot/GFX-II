desc:GFX Pegel 45
//tags: meter ppm vu peak correlation phase broadcast mastering analyser
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-ui and gfx-panel (.jsfx-inc) in the same folder.
//
// PEGEL 45. A stereo level meter in the spirit of the 1980s / 90s Eastern European broadcast and studio test
// gear: baked-enamel needle meters, vacuum-fluorescent bargraphs and chunky LED-block ladders.
// The audio is NOT touched: the plug-in only reads spl0 / spl1 and never writes them, so the output is
// bit-exact with the input. No output stage is needed (it is a meter), and the latency is 0.
//
// SCALE (lit keys on the panel):
//   PPM  - DIN-style quasi-peak programme meter. Full-wave rectifier with a 1.7 ms charge time constant:
//          a 10 ms tone burst reads 1 dB under the steady reading (5 ms: -2.6 dB, 3 ms: -4.5 dB at 5 kHz).
//          Return 20 dB in 1.5 s (linear in dB). Scale -50 .. +5 dB; 0 dB = the REF level.
//   VU   - volume indicator. The rectified (average) signal drives a modelled needle (mass + spring + damping,
//          a second-order system, natural frequency 13.6 rad/s, damping 0.81): 99 % of the reading in about
//          300 ms, about 1.3 % overshoot, the same on the way down. Scale -20 .. +3 VU; 0 VU = the REF level.
//   PEAK - sample peak: instant attack, a smooth, heavy return of 20 dB in 1.7 s. Scale -60 .. 0 dBFS.
//   All readings are sine-referenced (AES17 style): a sine whose peak is at the REF level reads 0 dB / 0 VU.
// REF  - the alignment level, 0 dB (PPM) or 0 VU (VU) = -9 / -12 / -14 / -15 / -18 / -20 dBFS.
//        PPM and VU keep their own REF (defaults: PPM -9 dBFS, the broadcast convention; VU -18 dBFS).
//        PEAK reads dBFS directly, so REF is greyed out there.
// HOLD - OFF / 2 S / 5 S / INF: a hold marker on each meter (needle: an orange drag pointer; bargraphs: one
//        bright segment), and the numeric PEAK HOLD readout (true sample peak in dBFS, per channel; with HOLD OFF
//        the numbers still hold each peak for 1 s so they can be read). OVER lights at 0 dBFS and above.
//        Click a meter or the readout to clear the holds.
// KORREL. - phase correlation, -1 .. +1 (integrated over about 200 ms): +1 = mono, 0 = wide / unrelated,
//        below 0 = out of phase (mono-incompatible).
// THEME - ENAMEL (bone-grey baked enamel, black needles, safety-orange over-zone), VFD (charcoal slate,
//         turquoise vacuum-fluorescent segments with ghost segments), MATRIX (battleship-grey anodised panel,
//         stacked LED blocks green -> amber -> red with the unlit cells visible). Stored in a slider, so it is
//         saved with the project and with presets.
// Ballistics run on the audio thread (@sample / @block); the panel only interpolates between block updates,
// with a time-based (frame-rate independent) smoother.
//
// GUI: click a key; click the LCD for the preset list. S / M / L / ? = size and help.

import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc

slider1:0<0,2,1{PPM,VU,Peak}>-Scale
slider2:0<0,5,1{-9 dBFS,-12 dBFS,-14 dBFS,-15 dBFS,-18 dBFS,-20 dBFS}>-PPM ref (0 dB =)
slider3:4<0,5,1{-9 dBFS,-12 dBFS,-14 dBFS,-15 dBFS,-18 dBFS,-20 dBFS}>-VU ref (0 VU =)
slider4:1<0,3,1{Off,2 s,5 s,Inf}>-Peak hold
slider5:0<0,2,1{Enamel,VFD,Matrix}>-Theme
slider6:0<0,1,1{ENG,DE}>-Label language

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-pegel-45";                               // the ? pop-up links to this manual
ext_nodenorm = 1;                                       // no anti-denormal noise added to the input: the pass-through stays bit-exact

// ---------- helpers ----------
function pg_g2db(g) ( 8.68588963807 * log(max(g, 0.00000001)) );    // floor -160 dB
function pg_refdb(i) ( i == 0 ? -9 : i == 1 ? -12 : i == 2 ? -14 : i == 3 ? -15 : i == 4 ? -18 : -20 );
function pg_holds(i) ( i == 0 ? 0 : i == 1 ? 2 : i == 2 ? 5 : 1000000 );   // hold time in seconds (INF = huge)

// ---------- audio-thread ballistics (shared with the panel through the pga_ variables) ----------
pga_pa = 1 - exp(-1 / (0.0017 * srate));                // PPM charge (10 ms burst -> -1 dB)
pga_pr = 10 ^ (-(20 / 1.5) / 20 / srate);               // PPM return: 20 dB in 1.5 s
pga_pcal = 1 / 0.97676;                                 // PPM: a steady sine reads its peak (rectifier ripple)
pga_w = 13.6; pga_z = 0.81;                             // VU needle: natural frequency (rad/s), damping
pga_w2 = pga_w * pga_w; pga_zw = 2 * pga_z * pga_w; pga_dt = 1 / srate;
pga_kr = 10 ^ (-(20 / 1.7) / 20 / srate);               // PEAK return: 20 dB in 1.7 s
pga_cc = 1 - exp(-1 / (0.2 * srate));                   // correlation integration (200 ms)
pga_p0 = pga_p1 = 0; pga_vy0 = pga_vy1 = 0; pga_vv0 = pga_vv1 = 0; pga_k0 = pga_k1 = 0;
pga_b0 = pga_b1 = 0; pga_cl = pga_cr = pga_cx = 0; pga_cor = 0;
pga_m0 = pga_m1 = -160; pga_h0 = pga_h1 = -160; pga_ht0 = pga_ht1 = 0;
pga_r0 = pga_r1 = -160; pga_rt0 = pga_rt1 = 0; pga_ov0 = pga_ov1 = 0;
pga_scl = -1; pga_req0 = pg_req;

// ---------- scale geometry (shared by all three themes) ----------
// position 0..1 along the scale for a reading d in the scale's own units (dB rel. REF, VU, or dBFS)
function pg_pos(d, s) local(v) (
  s == 0 ? (
    d = min(max(d, -52), 5.6);
    d < -20 ? (d + 50) * 0.01 : d < -10 ? 0.3 + (d + 20) * 0.016 : 0.46 + (d + 10) * 0.036;
  ) : s == 1 ? (
    v = 10 ^ (min(max(d, -40), 3.6) / 20);              // VU: the needle deflects with voltage
    (v - 0.1) / 1.3125;
  ) : (
    d = min(max(d, -62), 0.4);
    d < -30 ? (d + 60) * 0.01 : 0.3 + (d + 30) * 0.0233333;
  );
);
// tick tables: per scale up to 32 entries of (value, kind) - kind 2 = numbered, 1 = major (number on bargraphs
// only), 0 = minor
PG_TK = 0; PG_TN = 100;
function pg_tick(s, d, k) local(n) ( n = PG_TN[s]; PG_TK[s * 64 + n * 2] = d; PG_TK[s * 64 + n * 2 + 1] = k; PG_TN[s] = n + 1; );
PG_TN[0] = PG_TN[1] = PG_TN[2] = 0;
pg_tick(0, -50, 2); pg_tick(0, -45, 0); pg_tick(0, -40, 2); pg_tick(0, -35, 0); pg_tick(0, -30, 2); pg_tick(0, -25, 0);
pg_tick(0, -20, 2); pg_tick(0, -15, 0); pg_tick(0, -10, 2); pg_tick(0, -9, 0); pg_tick(0, -8, 0); pg_tick(0, -7, 0);
pg_tick(0, -6, 0); pg_tick(0, -5, 2); pg_tick(0, -4, 0); pg_tick(0, -3, 0); pg_tick(0, -2, 0); pg_tick(0, -1, 0);
pg_tick(0, 0, 2); pg_tick(0, 1, 0); pg_tick(0, 2, 0); pg_tick(0, 3, 0); pg_tick(0, 4, 0); pg_tick(0, 5, 2);
pg_tick(1, -20, 2); pg_tick(1, -15, 0); pg_tick(1, -10, 2); pg_tick(1, -7, 2); pg_tick(1, -5, 2); pg_tick(1, -4, 0);
pg_tick(1, -3, 2); pg_tick(1, -2, 2); pg_tick(1, -1, 2); pg_tick(1, -0.5, 0); pg_tick(1, 0, 2); pg_tick(1, 0.5, 0);
pg_tick(1, 1, 2); pg_tick(1, 1.5, 0); pg_tick(1, 2, 2); pg_tick(1, 2.5, 0); pg_tick(1, 3, 2);
pg_tick(2, -60, 2); pg_tick(2, -55, 0); pg_tick(2, -50, 1); pg_tick(2, -45, 0); pg_tick(2, -40, 2); pg_tick(2, -35, 0);
pg_tick(2, -30, 2); pg_tick(2, -27, 0); pg_tick(2, -24, 2); pg_tick(2, -21, 0); pg_tick(2, -18, 2); pg_tick(2, -15, 0);
pg_tick(2, -12, 2); pg_tick(2, -9, 1); pg_tick(2, -6, 2); pg_tick(2, -3, 2); pg_tick(2, 0, 2);

// ---------- presets: scale, PPM ref, VU ref, hold, theme ----------
function pg_set(s, rp, rv, h, t) (
  slider1 = s; slider2 = rp; slider3 = rv; slider4 = h; slider5 = t;
  slider_automate(31);                                  // sliders 1-5
);
function load_preset(p) (
  p == 1  ? pg_set(0, 0, 4, 1, 0) :                     // Init: PPM, -9 dBFS, ENAMEL
  p == 2  ? pg_set(0, 0, 4, 2, 0) :                     // Broadcast PPM -9
  p == 3  ? pg_set(0, 4, 4, 1, 1) :                     // PPM Align -18
  p == 4  ? pg_set(0, 1, 4, 1, 2) :                     // Live Desk PPM -12
  p == 5  ? pg_set(1, 0, 4, 0, 0) :                     // Tracking VU -18
  p == 6  ? pg_set(1, 0, 2, 1, 0) :                     // Mix VU -14
  p == 7  ? pg_set(1, 0, 1, 1, 1) :                     // Hot Master VU -12
  p == 8  ? pg_set(2, 0, 4, 3, 2) :                     // Mastering Peak
  p == 9  ? pg_set(2, 0, 4, 1, 1) :                     // VFD Peak
  p == 10 ? pg_set(0, 0, 4, 2, 1) :                     // VFD PPM
  p == 11 ? pg_set(0, 0, 4, 1, 2) :                     // Matrix PPM
  p == 12 ? pg_set(1, 0, 4, 0, 2);                      // Matrix VU
);

ui_thm = 5; ui_hw = 1;                                  // house keycaps for the preset bar and size picker
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );                  // new instances open in Large, on Init
ui_dflt = 1;

@slider
pga_sc = slider1;

@block
// ---- settings ----
pga_sc = slider1 | 0;
pga_ref = pga_sc == 0 ? pg_refdb(slider2) : pga_sc == 1 ? pg_refdb(slider3) : 0;
pga_hs = pg_holds(slider4);
pga_bdt = samplesblock / srate;
// the panel asks for a hold reset by bumping pg_req (a one-way mailbox: written only by the panel);
// a new scale or REF starts the hold markers afresh too
(pg_req != pga_req0 || pga_sc != pga_scl || pga_ref != pga_refl || slider4 != pga_hl) ? (
  pga_req0 = pg_req; pga_scl = pga_sc; pga_refl = pga_ref; pga_hl = slider4;
  pga_h0 = pga_h1 = -160; pga_r0 = pga_r1 = -160; pga_ov0 = pga_ov1 = 0;
  pga_b0 = pga_b1 = 0;                                  // and forget the block before the click
);
// ---- flush decayed states (no denormals after long silence) ----
pga_p0 < 0.000000001 ? pga_p0 = 0; pga_p1 < 0.000000001 ? pga_p1 = 0;
pga_k0 < 0.000000001 ? pga_k0 = 0; pga_k1 < 0.000000001 ? pga_k1 = 0;
abs(pga_vy0) + abs(pga_vv0) < 0.000000001 ? pga_vy0 = pga_vv0 = 0;
abs(pga_vy1) + abs(pga_vv1) < 0.000000001 ? pga_vy1 = pga_vv1 = 0;
pga_cl < 0.0000000001 ? pga_cl = 0; pga_cr < 0.0000000001 ? pga_cr = 0; abs(pga_cx) < 0.0000000001 ? pga_cx = 0;
// ---- the selected scale's reading (scale units) and its block maximum for the hold ----
pga_sc == 0 ? (
  pga_m0 = pg_g2db(pga_p0 * pga_pcal) - pga_ref; pga_m1 = pg_g2db(pga_p1 * pga_pcal) - pga_ref;
  pga_x0 = pga_m0; pga_x1 = pga_m1;
) : pga_sc == 1 ? (
  pga_m0 = pg_g2db(max(pga_vy0, 0)) - pga_ref; pga_m1 = pg_g2db(max(pga_vy1, 0)) - pga_ref;
  pga_x0 = pga_m0; pga_x1 = pga_m1;
) : (
  pga_m0 = pg_g2db(pga_k0); pga_m1 = pg_g2db(pga_k1);
  pga_x0 = pg_g2db(pga_b0); pga_x1 = pg_g2db(pga_b1);   // instant attack: hold the true block peak
);
// ---- hold markers: hold, then fall back at 20 dB/s onto the reading ----
pga_x0 >= pga_h0 ? ( pga_h0 = pga_x0; pga_ht0 = 0; ) : (
  pga_ht0 += pga_bdt; pga_ht0 > pga_hs ? pga_h0 = max(pga_m0, pga_h0 - 20 * pga_bdt); );
pga_x1 >= pga_h1 ? ( pga_h1 = pga_x1; pga_ht1 = 0; ) : (
  pga_ht1 += pga_bdt; pga_ht1 > pga_hs ? pga_h1 = max(pga_m1, pga_h1 - 20 * pga_bdt); );
// ---- numeric readout: true sample peak in dBFS, held (HOLD OFF still holds 1 s so it can be read) ----
pga_rh = slider4 == 0 ? 1 : pga_hs;
pga_d0 = pg_g2db(pga_b0); pga_d1 = pg_g2db(pga_b1);
pga_d0 >= pga_r0 ? ( pga_r0 = pga_d0; pga_rt0 = 0; ) : ( pga_rt0 += pga_bdt; pga_rt0 > pga_rh ? ( pga_r0 = pga_d0; pga_rt0 = 0; ); );
pga_d1 >= pga_r1 ? ( pga_r1 = pga_d1; pga_rt1 = 0; ) : ( pga_rt1 += pga_bdt; pga_rt1 > pga_rh ? ( pga_r1 = pga_d1; pga_rt1 = 0; ); );
pga_b0 >= 1 ? ( pga_ov0 = 1; pga_ot0 = 0; ) : ( pga_ot0 += pga_bdt; pga_ot0 > max(pga_rh, 2) ? pga_ov0 = 0; );
pga_b1 >= 1 ? ( pga_ov1 = 1; pga_ot1 = 0; ) : ( pga_ot1 += pga_bdt; pga_ot1 > max(pga_rh, 2) ? pga_ov1 = 0; );
pga_b0 = pga_b1 = 0;
// ---- correlation ----
pga_cd = sqrt(pga_cl * pga_cr);
pga_cor = pga_cd > 0.0000000001 ? min(max(pga_cx / pga_cd, -1), 1) : 0;
pga_blk += 1;                                           // block counter: the panel sees fresh values

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@sample
// read only: spl0 / spl1 are never written, so the audio passes through bit-exact
pga_a0 = abs(spl0); pga_a1 = abs(spl1);
// PPM: quasi-peak rectifier, fast charge, slow linear-in-dB return
pga_a0 > pga_p0 ? pga_p0 += (pga_a0 - pga_p0) * pga_pa : pga_p0 *= pga_pr;
pga_a1 > pga_p1 ? pga_p1 += (pga_a1 - pga_p1) * pga_pa : pga_p1 *= pga_pr;
// VU: the rectified signal (x pi/2: a sine reads its peak) drives the needle's mass-spring-damper
pga_vv0 += (pga_w2 * (pga_a0 * 1.5707963 - pga_vy0) - pga_zw * pga_vv0) * pga_dt; pga_vy0 += pga_vv0 * pga_dt;
pga_vv1 += (pga_w2 * (pga_a1 * 1.5707963 - pga_vy1) - pga_zw * pga_vv1) * pga_dt; pga_vy1 += pga_vv1 * pga_dt;
// PEAK: instant attack, heavy return
pga_a0 > pga_k0 ? pga_k0 = pga_a0 : pga_k0 *= pga_kr;
pga_a1 > pga_k1 ? pga_k1 = pga_a1 : pga_k1 *= pga_kr;
pga_b0 = max(pga_b0, pga_a0); pga_b1 = max(pga_b1, pga_a1);
// correlation sums
pga_cl += (spl0 * spl0 - pga_cl) * pga_cc;
pga_cr += (spl1 * spl1 - pga_cr) * pga_cc;
pga_cx += (spl0 * spl1 - pga_cx) * pga_cc;

@gfx 760 340
ui_begin(760, 340);

// =====================================================================
// Theme colours (the recipe's palette)
// =====================================================================
pgv_th = slider5 | 0; pgv_sc = slider1 | 0;
pgv_de = slider6 >= 0.5;                                // the language key: ENG / DE labels
pgv_th == 0 ? (                                         // ENAMEL: light industrial faceplate
  PGF  = 0xD6D2C4;                                      // bone-grey baked enamel (meter faces)
  PGP  = ui_mix(PGF, 0x000000, 0.10);                   // the panel around them, a shade deeper
  PGH  = ui_mix(PGF, 0x000000, 0.20);                   // header strip
  PGI  = 0x1C1C1C;                                      // deep charcoal print
  PGI2 = 0x4A4842;
  PGA  = 0xFF7900;                                      // raw safety orange
  PGN  = 0x101010;                                      // matte black needle
) : pgv_th == 1 ? (                                     // VFD: dark gas-discharge panel
  PGF  = 0x070808;                                      // display glass
  PGP  = 0x181A1B;                                      // charcoal-black slate
  PGH  = ui_mix(PGP, 0x000000, 0.35);
  PGI  = 0x4EE1DC;                                      // cold turquoise glow
  PGI2 = ui_mix(0x4EE1DC, PGP, 0.45);
  PGA  = 0xFF8C00;                                      // neon amber
  PGG  = 0x0D0E0F;                                      // unlit ghost segments
) : (                                                   // MATRIX: Eastern Bloc LED matrix
  PGP  = 0x222528;                                      // battleship-grey anodised aluminium
  PGF  = ui_mix(PGP, 0x000000, 0.45);
  PGH  = ui_mix(PGP, 0x000000, 0.30);
  PGI  = 0xC7BEB3;                                      // print: elephant's breath
  PGI2 = ui_mix(0xC7BEB3, PGP, 0.4);
  PGA  = 0xD4A373;                                      // pale mustard amber
  PGL1 = 0x1E5631; PGL2 = 0xD4A373; PGL3 = 0xBC3908;    // forest green -> mustard amber -> safety red
  PGG  = 0x2C302E;                                      // muddy olive-drab unlit cells
);

// =====================================================================
// Frame-rate independent display smoothing (the ballistics themselves run on the audio thread)
// =====================================================================
pgv_now = time_precise();
pgv_dt = pgv_t0 > 0 ? min(max(pgv_now - pgv_t0, 0), 0.25) : 1;   // first frame: snap to the reading
pgv_t0 = pgv_now;
pgv_k = 1 - exp(-pgv_dt / 0.012);
pgv_sc != pgv_scl ? ( pgv_k = 1; pgv_scl = pgv_sc; );   // a new scale: no swing from the old one
pgv_q0 += (pg_pos(pga_m0, pgv_sc) - pgv_q0) * pgv_k;
pgv_q1 += (pg_pos(pga_m1, pgv_sc) - pgv_q1) * pgv_k;
pgv_cr += (pga_cor - pgv_cr) * (1 - exp(-pgv_dt / 0.06));
pgv_hon = slider4 > 0;

// zone starts (position units): amber and over / red
pgv_sc == 0 ? ( pgv_zA = pg_pos(-6, 0); pgv_zR = pg_pos(0, 0); ) :
pgv_sc == 1 ? ( pgv_zA = pg_pos(-3, 1); pgv_zR = pg_pos(0, 1); ) :
              ( pgv_zA = pg_pos(-12, 2); pgv_zR = pg_pos(-3, 2); );

// fonts (the house face, bold; sizes in design pixels)
gfx_setfont(6,  "Trebuchet MS", 27 * sc, 'b');          // title
gfx_setfont(10, "Trebuchet MS", 15 * sc, 'b');          // scale numbers
gfx_setfont(11, "Trebuchet MS", 12 * sc, 'b');          // labels
gfx_setfont(12, "Trebuchet MS", 12.5 * sc, 'b');        // key captions
gfx_setfont(13, "Courier New", 23 * sc, 'b');           // readout digits
gfx_setfont(14, "Trebuchet MS", 20 * sc, 'b');          // big channel letters

function pg_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function pg_frame(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc, 0); );
function pg_txt(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function pg_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function pg_rtxt(rx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = rx * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );

// a flat, sharp-cornered lit key in the theme's manner; returns 1 when clicked
function pg_key(x, y, w, h, lbl, on, en) local(hov, hit) (
  hov = en && mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  pgv_th == 0 ? (
    ui_col(PGI); pg_r(x, y, w, h);
    on ? ui_col(PGA) : ui_col(hov ? 0xEDEAE0 : ui_mix(PGF, 0xFFFFFF, 0.35)); pg_r(x + 1, y + 1, w - 2, h - 2);
    on ? ( ui_cola(0xFFFFFF, 0.25); pg_r(x + 1, y + 1, w - 2, 1); );
    ui_cola(PGI, en ? 1 : 0.35);
  ) : pgv_th == 1 ? (
    ui_col(on ? PGI : ui_mix(PGI, PGP, 0.7)); pg_r(x, y, w, h);
    ui_col(0x0A0B0C); pg_r(x + 1, y + 1, w - 2, h - 2);
    on ? ( ui_cola(PGI, 0.22); pg_r(x + 1, y + 1, w - 2, h - 2); ui_cola(PGI, 0.12); pg_r(x - 2, y - 2, w + 4, h + 4); )
       : hov ? ( ui_cola(PGI, 0.08); pg_r(x + 1, y + 1, w - 2, h - 2); );
    on ? ui_col(ui_mix(PGI, 0xFFFFFF, 0.35)) : ui_cola(PGI, en ? 0.55 : 0.2);
  ) : (
    ui_col(0x0B0C0D); pg_r(x, y, w, h);
    on ? ui_col(PGL2) : ui_col(hov ? ui_mix(PGG, 0xFFFFFF, 0.06) : PGG); pg_r(x + 1, y + 1, w - 2, h - 2);
    on ? ( ui_cola(PGL2, 0.25); pg_r(x - 2, y - 2, w + 4, h + 4); ui_cola(0xFFFFFF, 0.3); pg_r(x + 1, y + 1, w - 2, 1); );
    on ? ui_col(0x17191B) : ui_cola(PGI, en ? 0.85 : 0.3);
  );
  gfx_setfont(12); pg_ctxt(x + w * 0.5, y + h * 0.5 + 0.5, lbl);
  hit;
);
function pg_lbl(x, y, s) ( gfx_setfont(11); ui_col(PGI2); pg_txt(x, y, s); );

// =====================================================================
// Panel and header
// =====================================================================
ui_col(PGP); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(PGH); pg_r(0, 0, 760, 54);
ui_col(pgv_th == 0 ? PGI : PGA); pg_r(0, 54, 760, 2);
// GFX badge and the name
ui_col(pgv_th == 0 ? PGI : pgv_th == 1 ? PGI : PGA); gfx_circle(31 * sc, 27 * sc, 16 * sc, 1, 1);
gfx_setfont(4); ui_col(pgv_th == 0 ? PGF : 0x111213); ui_text(31 * sc, 21.5 * sc, "GFX");
gfx_setfont(6); ui_col(pgv_th == 0 ? PGI : PGI); pg_txt(58, 12, "PEGEL 45");
gfx_setfont(11); ui_col(PGI2); pg_txt(196, 15, "STEREO"); pg_txt(196, 29, pgv_de ? "PEGELMESSER" : "LEVEL METER");
// the house preset bar: PRESETS, prev / next, LCD (click it for the list)
k_ = pk_preset(300 * sc, 10 * sc, 346 * sc, 34 * sc, pr_cur,
  "Init|Broadcast PPM -9|PPM Align -18|Live Desk PPM -12|Tracking VU -18|Mix VU -14|Hot Master VU -12|Mastering Peak|VFD Peak|VFD PPM|Matrix PPM|Matrix VU");
k_ > 0 ? ( load_preset(k_); pr_cur = k_; );
// the language key (ENG / DE) with its amber LED, left of the size picker
ui_button(666 * sc, 18 * sc, 27 * sc, 18 * sc, pgv_de ? "DE" : "ENG", 0, 1) ? ( slider6 = pgv_de ? 0 : 1; ui_auto(6); pgv_de = slider6 >= 0.5; );
ui_col(0x060607); gfx_circle(657 * sc, 27 * sc, 4.5 * sc, 1, 1);
pgv_de ? ( ui_cola(0xFFA126, 0.22); gfx_circle(657 * sc, 27 * sc, 7 * sc, 1, 1); ui_col(0xFFA126); ) : ui_col(ui_mix(0xFFA126, 0x000000, 0.78));
gfx_circle(657 * sc, 27 * sc, 3 * sc, 1, 1);
ui_cola(0xFFFFFF, pgv_de ? 0.6 : 0.15); gfx_circle(656.1 * sc, 25.95 * sc, 1.05 * sc, 1, 1);
ui_size_picker(694 * sc, 18 * sc);

// =====================================================================
// Meters (well: x 12..548, y 62..270)
// =====================================================================
pgv_wx = 12; pgv_wy = 62; pgv_ww = 536; pgv_wh = 208;
// click a meter (or the readout) to clear the holds
pressed && drag_id == 0 && mouse_x >= pgv_wx * sc && mouse_x < (pgv_wx + pgv_ww) * sc && mouse_y >= pgv_wy * sc &&
  mouse_y < (pgv_wy + pgv_wh) * sc ? ( pg_req += 1; drag_id = -1; );

strcpy(#pgv_sn, pgv_sc == 0 ? "PPM" : pgv_sc == 1 ? "VU" : pgv_de ? "SPITZE" : "PEAK");
pgv_sc == 0 ? sprintf(#pgv_ds, "0 dB = %d dBFS", pga_ref) :
pgv_sc == 1 ? sprintf(#pgv_ds, "0 VU = %d dBFS", pga_ref) : strcpy(#pgv_ds, pgv_de ? "SKALA dBFS" : "SCALE dBFS");
pgv_de ? (
  pgv_sc == 0 ? strcpy(#pgv_bl, "INTEGR. 10 ms   RÜCKLAUF 20 dB / 1,5 s") :
  pgv_sc == 1 ? strcpy(#pgv_bl, "ANSTIEG 300 ms   RÜCKLAUF 300 ms") : strcpy(#pgv_bl, "ABTASTSPITZE   RÜCKLAUF 20 dB / 1,7 s");
) : (
  pgv_sc == 0 ? strcpy(#pgv_bl, "INTEGR. 10 ms   RETURN 20 dB / 1.5 s") :
  pgv_sc == 1 ? strcpy(#pgv_bl, "RISE 300 ms   RETURN 300 ms") : strcpy(#pgv_bl, "SAMPLE PEAK   RETURN 20 dB / 1.7 s");
);

// tick label text
function pg_tlbl(s, d) (
  s == 1 ? sprintf(#pgv_t, "%d", abs(d)) : d > 0 ? sprintf(#pgv_t, "+%d", d) : sprintf(#pgv_t, "%d", d);
  #pgv_t;
);

// ---------- theme 0: needle meter ----------
pgv_span = 0.74;                                        // half the needle swing (rad)
function pg_needle_meter(x, y, w, h, q, hq, ch) local(cx, py, R, i, n, d, k, a, p, r1, r2, ca, sa, bw, bt, ox, oy) (
  ui_col(PGI); pg_r(x, y, w, h);
  ui_col(PGF); pg_r(x + 1.5, y + 1.5, w - 3, h - 3);
  cx = x + w * 0.5; py = y + h - 12; R = 150;
  // over-zone band (safety orange) and the scale arc
  ui_col(PGA); i = 0;                                   // (anti-aliased arcs every half pixel: a smooth band)
  loop(14 * sc, gfx_arc(cx * sc, py * sc, R * sc + i * 0.5, -pgv_span + 2 * pgv_span * pgv_zR, pgv_span, 1); i += 1; );
  ui_col(PGI); gfx_arc(cx * sc, py * sc, R * sc, -pgv_span, pgv_span, 1);
  gfx_arc(cx * sc, py * sc, R * sc - 1, -pgv_span, pgv_span, 1);
  // ticks and numbers
  gfx_setfont(10);
  n = PG_TN[pgv_sc]; i = 0;
  loop(n,
    d = PG_TK[pgv_sc * 64 + i * 2]; k = PG_TK[pgv_sc * 64 + i * 2 + 1];
    p = pg_pos(d, pgv_sc); a = -pgv_span + 2 * pgv_span * p; ca = cos(a); sa = sin(a);
    r1 = R - (k > 0 ? 11 : 6); r2 = R + (k > 0 ? 7 : 3);
    ui_col(PGI);
    gfx_line((cx + sa * r1) * sc, (py - ca * r1) * sc, (cx + sa * r2) * sc, (py - ca * r2) * sc, 1);
    k > 0 ? gfx_line((cx + sa * r1) * sc + 1, (py - ca * r1) * sc, (cx + sa * r2) * sc + 1, (py - ca * r2) * sc, 1);
    k == 2 ? ( ui_col(p >= pgv_zR - 0.001 && d > (pgv_sc == 2 ? -3.1 : 0) ? 0xB24A00 : PGI);
               pg_ctxt(cx + sa * (R + 19), py - ca * (R + 19), pg_tlbl(pgv_sc, d)); );
    i += 1;
  );
  // captions inside the arc
  gfx_setfont(14); ui_col(PGI); pg_txt(x + 14, y + h - 80, pgv_sc == 1 ? "VU" : "dB");
  gfx_setfont(11); ui_col(PGI2); pg_rtxt(x + w - 14, y + h - 66, pgv_de ? "PEGEL" : "LEVEL");
  // hold: an orange drag pointer
  pgv_hon && hq > 0.001 ? (
    a = -pgv_span + 2 * pgv_span * min(hq, 1.02); ca = cos(a); sa = sin(a);
    ui_col(0xD95F00);
    gfx_line((cx + sa * (R - 30)) * sc, (py - ca * (R - 30)) * sc, (cx + sa * (R + 4)) * sc, (py - ca * (R + 4)) * sc, 1);
    gfx_line((cx + sa * (R - 30)) * sc + 1, (py - ca * (R - 30)) * sc, (cx + sa * (R + 4)) * sc + 1, (py - ca * (R + 4)) * sc, 1);
    gfx_line((cx + sa * (R - 30)) * sc + 2, (py - ca * (R - 30)) * sc, (cx + sa * (R + 4)) * sc + 2, (py - ca * (R + 4)) * sc, 1);
  );
  // needle: tapered, matte black, a faint flat shadow
  a = -pgv_span + 2 * pgv_span * min(max(q, -0.03), 1.03); ca = cos(a); sa = sin(a);
  r1 = 34; r2 = R + 6; bw = 2.2; bt = 0.8;
  ox = ca; oy = sa;                                      // the needle's normal
  ui_cola(0x000000, 0.12);
  gfx_triangle((cx + sa * r1 - ox * bw + 2) * sc, (py - ca * r1 - oy * bw + 3) * sc, (cx + sa * r1 + ox * bw + 2) * sc, (py - ca * r1 + oy * bw + 3) * sc,
               (cx + sa * r2 + ox * bt + 2) * sc, (py - ca * r2 + oy * bt + 3) * sc, (cx + sa * r2 - ox * bt + 2) * sc, (py - ca * r2 - oy * bt + 3) * sc);
  ui_col(PGN);
  gfx_triangle((cx + sa * r1 - ox * bw) * sc, (py - ca * r1 - oy * bw) * sc, (cx + sa * r1 + ox * bw) * sc, (py - ca * r1 + oy * bw) * sc,
               (cx + sa * r2 + ox * bt) * sc, (py - ca * r2 + oy * bt) * sc, (cx + sa * r2 - ox * bt) * sc, (py - ca * r2 - oy * bt) * sc);
  // bottom band: the pivot cover, channel letter and alignment
  ui_col(PGI); pg_r(x + 1.5, y + h - 46, w - 3, 44.5);
  ui_col(ui_mix(PGI, PGF, 0.12)); pg_r(x + 1.5, y + h - 46, w - 3, 1);
  gfx_setfont(14); ui_col(PGF); pg_txt(x + 12, y + h - 36, ch);
  gfx_setfont(11); ui_col(ui_mix(PGF, PGI, 0.15)); pg_rtxt(x + w - 12, y + h - 24, #pgv_ds);
  gfx_setfont(11); ui_col(ui_mix(PGF, PGI, 0.3)); pg_txt(x + 40, y + h - 31, #pgv_sn);
);

// ---------- themes 1 and 2: horizontal bargraph ----------
function pg_segcol(p) (
  pgv_th == 1 ? ( p >= pgv_zR ? PGA : PGI ) : ( p >= pgv_zR ? PGL3 : p >= pgv_zA ? PGL2 : PGL1 );
);
function pg_bar(x, y, w, h, q, hq) local(n, i, sx, sw, p, lit, c, hold, hi, cy, ch) (
  n = pgv_th == 1 ? 70 : 35; sw = w / n;
  hi = pgv_hon && hq > 0.001 ? min(max(floor(min(hq, 1) * n - 0.0001), 0), n - 1) : -1;
  i = 0;
  loop(n,
    sx = x + i * sw; p = (i + 0.5) / n;
    lit = q >= (i + 0.5) / n;
    hold = i == hi;
    c = pg_segcol(p);
    pgv_th == 1 ? (
      lit || hold ? (
        ui_cola(c, 0.22); pg_r(sx - 0.5, y - 2, sw, h + 4);           // glow
        ui_col(hold && !lit ? ui_mix(c, 0xFFFFFF, 0.25) : c); pg_r(sx + 0.5, y, sw - 2, h);
        ui_cola(0xFFFFFF, hold ? 0.55 : 0.28); pg_r(sx + 0.5 + (sw - 2) * 0.5 - 0.5, y + 2, 1, h - 4);
      ) : (
        ui_col(PGG); pg_r(sx + 0.5, y, sw - 2, h);                    // ghost segment
        ui_cola(c, 0.05); pg_r(sx + 0.5, y, sw - 2, h);
      );
    ) : (
      ch = (h - 4) * 0.5;
      cy = y; loop(2,
        lit || hold ? (
          ui_cola(c, 0.16); pg_r(sx - 0.5, cy - 1, sw + 0, ch + 2);
          ui_col(hold && !lit ? ui_mix(c, 0xFFFFFF, 0.2) : c); pg_r(sx + 1, cy, sw - 3, ch);
          ui_cola(0xFFFFFF, 0.22); pg_r(sx + 1, cy, sw - 3, 1.5);
          ui_cola(0x000000, 0.18); pg_r(sx + 1, cy + ch - 1.5, sw - 3, 1.5);
        ) : (
          ui_col(PGG); pg_r(sx + 1, cy, sw - 3, ch);
          ui_cola(0x000000, 0.25); pg_r(sx + 1, cy + ch - 1, sw - 3, 1);
        );
        cy += ch + 4;
      );
    );
    i += 1;
  );
);
function pg_scaleband(x, y, w, h) local(n, i, d, k, p, xx) (
  n = PG_TN[pgv_sc]; i = 0;
  gfx_setfont(10);
  loop(n,
    d = PG_TK[pgv_sc * 64 + i * 2]; k = PG_TK[pgv_sc * 64 + i * 2 + 1];
    p = pg_pos(d, pgv_sc); xx = x + p * w;
    ui_col(p >= pgv_zR - 0.001 && d > (pgv_sc == 2 ? -3.1 : 0) ? PGA : PGI2);
    pg_r(xx - 0.5, y, 1, k > 0 ? 5 : 3); pg_r(xx - 0.5, y + h - (k > 0 ? 5 : 3), 1, k > 0 ? 5 : 3);
    k > 0 ? ( ui_col(p >= pgv_zR - 0.001 && d > (pgv_sc == 2 ? -3.1 : 0) ? PGA : PGI); pg_ctxt(xx, y + h * 0.5, pg_tlbl(pgv_sc, d)); );
    i += 1;
  );
);

pgv_th == 0 ? (
  pg_needle_meter(pgv_wx, pgv_wy, 262, pgv_wh, pgv_q0, pg_pos(pga_h0, pgv_sc), "L");
  pg_needle_meter(pgv_wx + 274, pgv_wy, 262, pgv_wh, pgv_q1, pg_pos(pga_h1, pgv_sc), "R");
) : (
  ui_col(pgv_th == 1 ? 0x2E3235 : 0x0B0C0D); pg_r(pgv_wx, pgv_wy, pgv_ww, pgv_wh);
  ui_col(PGF); pg_r(pgv_wx + 1, pgv_wy + 1, pgv_ww - 2, pgv_wh - 2);
  pgv_bx = 56; pgv_bw = 476;
  // caption row
  gfx_setfont(11); ui_col(PGI); pg_txt(26, 70, pgv_de ? "PEGEL" : "LEVEL"); ui_col(PGI2); pg_txt(78, 70, pgv_sc == 1 ? "VU" : "dB");
  ui_col(PGI2); pg_rtxt(pgv_bx + pgv_bw, 77, #pgv_ds);
  pgv_sc != 1 ? ( ui_col(PGI); pg_txt(116, 70, #pgv_sn); );
  // bars and scale
  gfx_setfont(14); ui_col(PGI); pg_ctxt(34, 112, "L"); pg_ctxt(34, 203, "R");
  pg_bar(pgv_bx, 88, pgv_bw, 48, pgv_q0, pg_pos(pga_h0, pgv_sc));
  pg_scaleband(pgv_bx, 140, pgv_bw, 36);
  pg_bar(pgv_bx, 180, pgv_bw, 48, pgv_q1, pg_pos(pga_h1, pgv_sc));
  // footer: the ballistics in print
  ui_col(pgv_th == 1 ? 0x1E2224 : 0x2C302E); pg_r(pgv_wx + 1, 240, pgv_ww - 2, 1);
  gfx_setfont(11); ui_col(PGI2); pg_txt(26, 249, #pgv_bl);
  ui_col(PGI2); pg_rtxt(pgv_bx + pgv_bw, 256, pgv_de ? "KLICK = HALTEN LÖSCHEN" : "CLICK = HOLD RESET");
);

// =====================================================================
// Correlation (x 12..548, y 278..332)
// =====================================================================
pgv_cy = 278; pgv_chh = 54; pgv_cbx = 112; pgv_cbw = 420;
pgv_th == 0 ? ( ui_col(PGI); pg_r(12, pgv_cy, 536, pgv_chh); ui_col(PGF); pg_r(13.5, pgv_cy + 1.5, 533, pgv_chh - 3); )
            : ( ui_col(pgv_th == 1 ? 0x2E3235 : 0x0B0C0D); pg_r(12, pgv_cy, 536, pgv_chh); ui_col(PGF); pg_r(13, pgv_cy + 1, 534, pgv_chh - 2); );
gfx_setfont(11); ui_col(PGI); pg_txt(24, pgv_cy + 12, pgv_de ? "KORREL." : "CORREL.");
ui_col(PGI2); pg_txt(24, pgv_cy + 28, "PHASE");
// scale: -1 .. +1
gfx_setfont(11);
pgv_i = 0;
loop(9,
  pgv_v = -1 + pgv_i * 0.25; pgv_x = pgv_cbx + (pgv_v + 1) * 0.5 * pgv_cbw;
  ui_col(pgv_v < 0 ? (pgv_th == 0 ? 0xB24A00 : PGA) : PGI2);
  pg_r(pgv_x - 0.5, pgv_cy + 22, 1, pgv_i % 2 == 0 ? 6 : 3);
  pgv_i % 4 == 0 ? ( ui_col(pgv_v < 0 ? (pgv_th == 0 ? 0xB24A00 : PGA) : PGI);
                     pg_ctxt(pgv_x, pgv_cy + 13, pgv_v < 0 ? "-1" : pgv_v > 0 ? "+1" : "0"); );
  pgv_i += 1;
);
pgv_cv = min(max(pgv_cr, -1), 1);
pgv_th == 0 ? (
  ui_col(PGI); pg_r(pgv_cbx, pgv_cy + 30, pgv_cbw, 1.5);
  ui_col(PGA); pg_r(pgv_cbx, pgv_cy + 33, pgv_cbw * 0.5, 2);
  pgv_x = pgv_cbx + (pgv_cv + 1) * 0.5 * pgv_cbw;
  ui_cola(0x000000, 0.12); pg_r(pgv_x - 1 + 2, pgv_cy + 25 + 2, 4, 22);
  ui_col(PGN); pg_r(pgv_x - 2, pgv_cy + 25, 4, 22);
) : (
  pgv_n = pgv_th == 1 ? 60 : 30; pgv_sw = pgv_cbw / pgv_n;
  pgv_i = 0;
  loop(pgv_n,
    pgv_x = pgv_cbx + pgv_i * pgv_sw; pgv_v = -1 + (pgv_i + 0.5) / pgv_n * 2;
    pgv_lit = pgv_cv >= 0 ? (pgv_v > 0 && pgv_v <= pgv_cv + 1 / pgv_n) : (pgv_v < 0 && pgv_v >= pgv_cv - 1 / pgv_n);
    abs(pgv_v) < 1.01 / pgv_n ? pgv_lit = 1;             // the centre segments always show where 0 is
    pgv_c = pgv_th == 1 ? (pgv_v < 0 ? PGA : PGI) : (abs(pgv_v) < 1.01 / pgv_n ? PGL2 : pgv_v < 0 ? PGL3 : PGL1);
    pgv_lit ? (
      ui_cola(pgv_c, 0.2); pg_r(pgv_x - 0.5, pgv_cy + 29, pgv_sw, 20);
      ui_col(pgv_c); pg_r(pgv_x + 0.5, pgv_cy + 30, pgv_sw - (pgv_th == 1 ? 2 : 3), 18);
      ui_cola(0xFFFFFF, 0.22); pg_r(pgv_x + 0.5, pgv_cy + 30, pgv_sw - (pgv_th == 1 ? 2 : 3), 1.5);
    ) : (
      ui_col(PGG); pg_r(pgv_x + 0.5, pgv_cy + 30, pgv_sw - (pgv_th == 1 ? 2 : 3), 18);
    );
    pgv_i += 1;
  );
);

// =====================================================================
// Right column: readout, SCALE, REF, HOLD, THEME (x 558..748)
// =====================================================================
pgv_rx = 558; pgv_rw = 190;
// ---------- PEAK HOLD readout window ----------
pgv_th == 0 ? ( ui_col(PGI); pg_r(pgv_rx, 62, pgv_rw, 64); ui_col(0x141414); pg_r(pgv_rx + 3, 65, pgv_rw - 6, 58); pgv_dc = PGA; )
: pgv_th == 1 ? ( ui_col(0x2E3235); pg_r(pgv_rx, 62, pgv_rw, 64); ui_col(PGF); pg_r(pgv_rx + 1, 63, pgv_rw - 2, 62); pgv_dc = PGI; )
: ( ui_col(0x0B0C0D); pg_r(pgv_rx, 62, pgv_rw, 64); ui_col(0x0E0F10); pg_r(pgv_rx + 1, 63, pgv_rw - 2, 62); pgv_dc = PGL2; );
pressed && drag_id == 0 && mouse_x >= pgv_rx * sc && mouse_x < (pgv_rx + pgv_rw) * sc && mouse_y >= 62 * sc && mouse_y < 126 * sc ?
  ( pg_req += 1; drag_id = -1; );
gfx_setfont(11); ui_cola(pgv_dc, 0.7); pg_txt(pgv_rx + 10, 69, pgv_de ? "SPITZE  dBFS" : "PEAK  dBFS");
// OVER lamps
pgv_i = 0;
loop(2,
  pgv_on = pgv_i ? pga_ov1 : pga_ov0;
  pgv_x = pgv_rx + pgv_rw - 46 + pgv_i * 20;
  pgv_on ? ( ui_cola(0xFF3A1A, 0.3); pg_r(pgv_x - 2, 67, 18, 13); ui_col(0xFF3A1A); ) : ui_col(0x2A1410);
  pg_r(pgv_x, 69, 14, 9);
  pgv_i += 1;
);
gfx_setfont(11); ui_cola(pgv_dc, 0.55); pg_rtxt(pgv_rx + pgv_rw - 52, 74, pgv_de ? "ÜBER" : "OVER");
// the numbers
pgv_i = 0;
loop(2,
  pgv_v = pgv_i ? pga_r1 : pga_r0;
  pgv_v < -99.9 ? strcpy(#pgv_num, " ---") : pgv_v > 0.05 ? sprintf(#pgv_num, "%+5.1f", pgv_v) : sprintf(#pgv_num, "%5.1f", pgv_v);
  pgv_x = pgv_rx + 10 + pgv_i * 92;
  gfx_setfont(11); ui_cola(pgv_dc, 0.7); pg_txt(pgv_x, 98, pgv_i ? "R" : "L");
  gfx_setfont(13); ui_col(pgv_dc); pg_txt(pgv_x + 12, 88, #pgv_num);
  pgv_i += 1;
);

// ---------- SCALE ----------
pg_lbl(pgv_rx, 133, pgv_de ? "SKALA" : "SCALE");
pg_key(pgv_rx,       148, 60, 24, "PPM",  pgv_sc == 0, 1) ? ( slider1 = 0; ui_auto(1); );
pg_key(pgv_rx + 65,  148, 60, 24, "VU",   pgv_sc == 1, 1) ? ( slider1 = 1; ui_auto(1); );
pg_key(pgv_rx + 130, 148, 60, 24, pgv_de ? "SPITZE" : "PEAK", pgv_sc == 2, 1) ? ( slider1 = 2; ui_auto(1); );
// ---------- REF (the active scale's own alignment) ----------
pgv_rs = pgv_sc == 1 ? 3 : 2; pgv_rv = slider(pgv_rs);
pg_lbl(pgv_rx, 179, pgv_de ? (pgv_sc == 1 ? "BEZUG  (dBFS = 0 VU)" : pgv_sc == 0 ? "BEZUG  (dBFS = 0 dB)" : "BEZUG  (SPITZE: dBFS)")
                    : (pgv_sc == 1 ? "REF LEVEL  (dBFS = 0 VU)" : pgv_sc == 0 ? "REF LEVEL  (dBFS = 0 dB)" : "REF LEVEL  (PEAK: dBFS)"));
pgv_i = 0;
loop(6,
  sprintf(#pgv_k, "%d", pg_refdb(pgv_i));
  pg_key(pgv_rx + (pgv_i % 3) * 65, 194 + floor(pgv_i / 3) * 27, 60, 22, #pgv_k, pgv_sc < 2 && pgv_rv == pgv_i, pgv_sc < 2) ?
    ( slider(pgv_rs) = pgv_i; ui_auto(pgv_rs); );
  pgv_i += 1;
);
// ---------- HOLD ----------
pg_lbl(pgv_rx, 249, pgv_de ? "HALTEN" : "HOLD");
pgv_i = 0;
loop(4,
  pg_key(pgv_rx + pgv_i * 49, 264, 45, 24, pgv_i == 0 ? (pgv_de ? "AUS" : "OFF") : pgv_i == 1 ? "2 S" : pgv_i == 2 ? "5 S" : (pgv_de ? "FEST" : "INF"), slider4 == pgv_i, 1) ?
    ( slider4 = pgv_i; ui_auto(4); );
  pgv_i += 1;
);
// ---------- THEME ----------
pg_lbl(pgv_rx, 294, pgv_de ? "OPTIK" : "THEME");
pg_key(pgv_rx,       308, 66, 24, pgv_de ? "EMAILLE" : "ENAMEL", pgv_th == 0, 1) ? ( slider5 = 0; ui_auto(5); );
pg_key(pgv_rx + 70,  308, 52, 24, "VFD",    pgv_th == 1, 1) ? ( slider5 = 1; ui_auto(5); );
pg_key(pgv_rx + 126, 308, 64, 24, "MATRIX", pgv_th == 2, 1) ? ( slider5 = 2; ui_auto(5); );

pk_end();
ui_end();
