desc:GFX G Piano
//tags: instrument piano grand upright physical-modeling waveguide
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel and gfx-instrument (.jsfx-inc) in the same folder.
//
// A physically modelled acoustic piano: no samples, every note is computed from the physics of hammer, strings,
// soundboard and the coupling between them.
//
// HAMMER    a mass on a non-linear, hysteretic felt spring (F = K (c^p + alpha d(c^p)/dt), c = felt compression).
//           MIDI velocity sets the hammer's speed; the strike is simulated sample by sample against the moving
//           string, so the contact time, the bounce and the energy handed over all come out of the physics:
//           a soft strike stays in contact longer (dark), a hard one compresses the stiff felt (bright).
//           HAMMER sets the felt (hardness, exponent, hysteresis). Soft pedal (CC67) shifts to softer felt.
// STRINGS   each string is a bidirectional digital waveguide: two delay lines carrying the travelling waves
//           towards the bridge and back to the agraffe, an inverting reflection at each end, the hammer
//           acting at its strike point (1/8 of the string on the grand, 1/9 on the upright). At the bridge
//           the wave passes a fractional Thiran tuner, the stiffness dispersion cascade (four all-passes in
//           the bass, two above, solved per key for a stiff-string inharmonicity curve so the partials
//           stretch sharp) and a loss filter that takes the top away faster than the fundamental.
//           The loop is re-tuned at every note-on, so the fundamental stays in pitch whatever the stiffness.
// UNISON    one string in the low bass, two in the tenor, three from the middle up, each micro-detuned
//           (UNISON) so they drift in and out of phase: beating, shimmer and the two-stage decay.
// SOUNDBOARD the bridge signal drives a network of 16 wooden-plate modes (grand: broad and low; upright:
//           higher and boxier). Each mode has the same Q, so the high modes die away much faster than the low.
// SYMPATHY  every string ends on one bridge junction: the incoming waves are summed, the bridge moves under
//           their combined force (a resistive bridge impedance) and every string's reflection carries that
//           motion back. Energy is only shared or lost there, so any number of coupled strings stays stable.
//           Strings with their dampers up (held keys, keys pressed silently, everything with the sustain pedal
//           down, the undamped top octaves) pick up the notes you play and ring in sympathy; with the pedal
//           down a bank of 36 open strings (E1 - D#4) joins the junction too. RESONANCE sets how light (how
//           responsive) the bridge is. Press a key silently (velocity 1 - 3) and hold it to hear its strings
//           answer the notes you play.
// DAMPERS   key up lowers the damper (DAMPER sets how hard it stops the string; the bass rings on longer).
// ROOM, SPREAD (bass left, treble right as the player hears it), TONE, GRAND / UPRIGHT.
// CPU       keys are retired as soon as their energy falls below audibility; the open-string bank only runs
//           while the pedal is down or it is still ringing.
// Drift: each note is tuned a few cents off, as on a piano some weeks after tuning.
// MIDI: sustain (CC64), soft pedal (CC67), all notes off (CC123 / 120). Re-striking a ringing key strikes the
// same strings again.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc

slider1:0<0,11,1{Concert Grand,Studio Grand,Bright Pop Grand,Ballad Grand,Jazz Club Grand,Cinematic Halo,Felt Piano,Rock Upright,Bar Upright,Honky-Tonk,Parlour Upright,Dark Lo-Fi}>-Patch
slider2:0<0,1,1{Grand,Upright}>-Model
slider3:50<0,100,1>-Hammer (%)
slider4:55<0,100,1>-Dynamics (%)
slider5:40<0,100,1>-Stiffness (%)
slider6:20<0,100,1>-Unison detune (%)
slider7:60<0,100,1>-Sustain (%)
slider8:45<0,100,1>-Damper (%)
slider9:55<0,100,1>-Body (%)
slider10:50<0,100,1>-Tone (%)
slider11:35<0,100,1>-Sympathetic resonance (%)
slider12:25<0,100,1>-Room (%)
slider13:60<0,100,1>-Spread (%)
slider14:15<0,100,1>-Drift (%)
slider15:0<-24,6,0.1>-Volume (dB)
slider16:0<0,100,1>-Band sat (%)
slider17:30<0,100,1>-Bias (%)
slider18:120<40,400,1>-Sat low band (Hz)
slider19:6000<2000,16000,10>-Sat high band (Hz)
slider20:-0.3<-24,0,0.1>-Ceiling / limit threshold (dB)
slider21:1<0,2,1{Off,Clip,Limit}>-Output stage
slider22:20<20,500,1>-Mono below (Hz, 20 = off)
slider23:0<0,100,1>-Stereo width (%)

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-piano";                                   // the ? pop-up links to this manual

// ---------- memory (allocated with nextmem, clear of the output stage at 20000) ----------
nextmem = 30000;
function alloc(n) local(ptr) ( ptr = nextmem; nextmem += n; memset(ptr, 0, n); ptr; );

NV = 16;                                  // keys sounding at once
MS = 3;                                   // strings per key (max)
NSTR = NV * MS;
RS = 4096; RM = RS - 1; RS2 = 2 * RS;     // one rail per direction per string (A0 at 192 kHz needs ~3500)
NY = 36; YS = 8192; YM = YS - 1;          // open-string bank (pedal down), E1 .. D#4
FSZ = 8192; FM = FSZ - 1;                 // room lines

// voices (keys)
v_act = alloc(NV); v_note = alloc(NV); v_held = alloc(NV); v_sus = alloc(NV); v_age = alloc(NV);
v_ns = alloc(NV); v_pl = alloc(NV); v_pr = alloc(NV); v_env = alloc(NV); v_t = alloc(NV);
v_nd = alloc(NV); v_sil = alloc(NV); v_ka = alloc(NV); v_kl = alloc(NV); v_gn = alloc(NV);
// hammers (one per key)
h_on = alloc(NV); h_y = alloc(NV); h_v = alloc(NV); h_ys = alloc(NV); h_im = alloc(NV);
h_K = alloc(NV); h_pw = alloc(NV); h_al = alloc(NV); h_cp = alloc(NV); h_fr = alloc(NV);
// strings
s_N = alloc(NSTR); s_h = alloc(NSTR); s_eta = alloc(NSTR); s_tx = alloc(NSTR); s_ty = alloc(NSTR);
s_a = alloc(NSTR); s_nap = alloc(NSTR);
s_x1 = alloc(NSTR); s_y1 = alloc(NSTR); s_x2 = alloc(NSTR); s_y2 = alloc(NSTR);
s_x3 = alloc(NSTR); s_y3 = alloc(NSTR); s_x4 = alloc(NSTR); s_y4 = alloc(NSTR);
s_p = alloc(NSTR); s_lp = alloc(NSTR); s_g = alloc(NSTR); s_gh = alloc(NSTR); s_gr = alloc(NSTR); s_w = alloc(NSTR);
s_yi = alloc(NSTR); s_ol = alloc(NSTR); v_dv = alloc(NV);
RAIL = alloc(NSTR * RS2);                 // string s: [RAIL + s*RS2] towards the bridge, [+ RS] back to the agraffe
// open-string bank
y_L = alloc(NY); y_eta = alloc(NY); y_tx = alloc(NY); y_ty = alloc(NY); y_p = alloc(NY); y_lp = alloc(NY);
y_g = alloc(NY); y_gd = alloc(NY); y_yi = alloc(NY);
YB = alloc(NY * YS);
// soundboard modes: 16 x (5 coefficients + 4 state)
BM = alloc(16 * 9); bm_g = alloc(16);
// room
FRM = alloc(4 * FSZ);
gw = 0;
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();   // 20000..24095

ins_drift_init();
agec = 0; sus_pedal = 0; soft_pedal = 0; sym_on = 0; sym_env = 0;
TP = 2 * $pi;

// ---------- tuning ----------
// phase delay (samples) of a first-order all-pass (a + z^-1) / (1 + a z^-1) at w
function ap_tau(a, w) ( -(atan2(-sin(w), a + cos(w)) - atan2(-a * sin(w), 1 + a * cos(w))) / w; );
// phase delay of the loss filter y = (1 - p) x + p y1 at w
function lp_tau(p, w) ( atan2(p * sin(w), 1 - p * cos(w)) / w; );
// dispersion coefficient that stretches the partials like a stiff string with inharmonicity B:
// partial k should sit at k f0 sqrt(1 + B k^2) / sqrt(1 + B). Bisection on the nap all-passes.
function disp_a(f, B, nap) local(w, per, kk, tgt, lo, hi, mid, dv) (
  w = TP * f / srate; per = srate / f;
  kk = min(8, floor(0.42 * srate / f));
  kk < 2 ? 0 : (
    tgt = per * (1 - sqrt(1 + B) / sqrt(1 + B * kk * kk));
    lo = -0.95; hi = 0;
    loop(22,
      mid = 0.5 * (lo + hi);
      dv = nap * (ap_tau(mid, w) - ap_tau(mid, kk * w));
      dv > tgt ? lo = mid : hi = mid;
    );
    0.5 * (lo + hi);
  );
);
// tune string s (two rails, round trip 2 x rail + bridge filters = one period) and set its losses
// (EEL names are case-insensitive: every local is kept distinct from the parameters)
function str_set(s, f, a, nap, p, t60, trel, beta) local(w, per, dl, rl, fd, eta, err, mag, kk) (
  w = TP * f / srate; per = srate / f;
  dl = per - nap * ap_tau(a, w) - lp_tau(p, w);
  kk = 0; loop(12, dl < 5 && a < -0.001 ? ( a *= 0.6; dl = per - nap * ap_tau(a, w) - lp_tau(p, w); ); kk += 1; );
  rl = max(1, floor((dl - 0.5) / 2)); fd = max(0.3, dl - 2 * rl);
  eta = (1 - fd) / (1 + fd);
  err = ap_tau(eta, w) - fd;                 // one correction pass for the Thiran tuner at this frequency
  fd = max(0.3, fd - err); eta = (1 - fd) / (1 + fd);   // (fd >= 0.3 keeps the all-pass pole well inside)
  s_N[s] = min(rl, RS - 4); s_eta[s] = eta; s_a[s] = a; s_nap[s] = nap; s_p[s] = p;
  s_h[s] = max(1, min(s_N[s] - 1, floor(beta * s_N[s] + 0.5)));
  mag = (1 - p) / sqrt(1 - 2 * p * cos(w) + p * p);
  // loop gain per period: the fundamental decays in t60; capped below 1 so the loop always dies away
  s_gh[s] = min(0.99995, 10 ^ (-3 / (t60 * f)) / mag);
  s_gr[s] = min(0.9995, 10 ^ (-3 / (trel * f)) / mag);
);
function str_clear(s) local(rb) (
  rb = RAIL + s * RS2; memset(rb, 0, RS2);
  s_tx[s] = s_ty[s] = s_x1[s] = s_y1[s] = s_x2[s] = s_y2[s] = s_x3[s] = s_y3[s] = s_x4[s] = s_y4[s] = s_lp[s] = 0;
);
// open string j of the bank: a single tuned loop (no hammer, no stiffness)
function sym_set(j) local(nt, f, w, per, rl, fd, eta, pp, mag, t60) (
  nt = 28 + j; f = 440 * 2 ^ ((nt - 69) / 12);
  w = TP * f / srate; per = srate / f;
  pp = 0.2 * 2 ^ (-(nt - 60) / 24);
  rl = floor(per - lp_tau(pp, w) - 0.5); fd = per - lp_tau(pp, w) - rl;
  eta = (1 - fd) / (1 + fd);
  y_L[j] = min(rl, YS - 4); y_eta[j] = eta; y_p[j] = pp;
  mag = (1 - pp) / sqrt(1 - 2 * pp * cos(w) + pp * pp);
  t60 = max(1.5, 14 * 2 ^ (-(nt - 21) / 23));
  y_g[j] = min(0.9999, 10 ^ (-3 / (t60 * f)) / mag);
  y_gd[j] = min(0.999, 10 ^ (-3 / (0.12 * f)) / mag);
);
j = 0; loop(NY, sym_set(j); j += 1; );

// ---------- notes ----------
function note_on(n, vel) local(i, best, ba, f, ns, kk, a, nap, pp, t60, trel, det, vv, pan, s, jit, beta, mr, tc, pw, v0, B, rstk) (
  best = -1;
  i = 0; loop(NV, v_act[i] && v_note[i] == n && best < 0 ? best = i; i += 1; );            // re-strike: same strings
  best < 0 ? ( i = 0; loop(NV, !v_act[i] && best < 0 ? best = i; i += 1; ); );               // free key
  best < 0 ? ( ba = 10 ^ 12; i = 0; loop(NV, !v_held[i] && v_age[i] < ba ? ( ba = v_age[i]; best = i; ); i += 1; ); );
  best < 0 ? ( ba = 10 ^ 12; i = 0; loop(NV, v_age[i] < ba ? ( ba = v_age[i]; best = i; ); i += 1; ); );
  i = best;
  rstk = v_act[i] && v_note[i] == n;
  f = 440 * 2 ^ ((n - 69) / 12) * ins_note_detune();
  ns = n <= 28 ? 1 : n < 48 ? 2 : 3;
  nap = n < 48 ? 4 : 2;
  // stiffness: inharmonicity B is lowest around the tenor break and rises to both ends; the upright's short
  // bass strings are much stiffer
  kk = n < 40 ? -4.3 + 0.042 * (40 - n) : -4.3 + 0.03 * (n - 40);
  model ? kk += n < 40 ? 0.45 : 0.15;
  B = 10 ^ kk * (0.1 + 2.4 * stiff ^ 1.5);
  a = disp_a(f, B, nap);
  // losses: how fast the top of each note dies against its fundamental; sustain and damping by key
  pp = min(0.5, max(0.01, (model ? 0.26 : 0.16) * (0.4 + 1.2 * (1 - tone_s)) * 2 ^ (-(n - 60) / 24)));
  t60 = max(0.35, sus_t * 17 * 2 ^ (-(n - 21) / 23) * (model ? 0.65 : 1));
  trel = n >= 89 ? t60 : max(0.04, dmp_t * 0.55 * 2 ^ (-(n - 21) / 34));
  beta = model ? 1 / 9 : 1 / 8;
  det = uni_c * (0.6 + 0.8 * (n / 108));                      // unison spread in cents
  s = MS * i;
  kk = 0;
  loop(MS,
    kk < ns ? (
      jit = ns == 1 ? 0 : (rand(2) - 1) * 0.15;
      str_set(s + kk, f * 2 ^ (((ns == 1 ? 0 : det * (kk / (ns - 1) - 0.5)) + jit) / 1200), a, nap, pp,
              t60 * (1 + 0.12 * kk), trel, beta);
      s_w[s + kk] = 1 / ns;
    ) : s_w[s + kk] = 0;
    !rstk ? str_clear(s + kk);
    s_g[s + kk] = s_gh[s + kk];
    kk += 1;
  );
  !rstk ? v_env[i] = 0;
  // hammer: speed from velocity; felt hardness, exponent and hysteresis from HAMMER and the key
  vel = vel / 127;
  v_sil[i] = vel < 0.03;                     // velocity 1 - 3: the key goes down silently (dampers up)
  v0 = vel ^ (0.6 + 1.6 * dyn) * (soft_pedal ? 0.85 : 1);
  mr = 0.06 * 2 ^ ((n - 21) / 24);           // hammer : string mass, the treble hammer outweighs its strings
  tc = srate * 0.001 * 2.6 * 2 ^ (-(n - 21) / 32) * (1.45 - 0.9 * ham) * (soft_pedal ? 1.35 : 1);
  tc = max(tc, max(6, 0.00015 * srate));
  pw = 2.2 + (n - 21) / 87 + 0.4 * ham;      // felt stiffening exponent
  h_im[i] = 1 / (mr * 2 * s_N[s] * ns);
  h_pw[i] = pw;
  h_K[i] = (1 / h_im[i]) * (3.2 * 0.5 ^ ((1 - pw) / (pw + 1)) / tc) ^ (pw + 1);
  h_al[i] = srate * 0.00001 * (2 + 4 * (1 - ham));
  h_y[i] = 0; h_ys[i] = 0; h_v[i] = v0; h_cp[i] = 0; h_fr[i] = 0;
  h_on[i] = !v_sil[i];
  v_t[i] = 0;
  v_ka[i] = v_sil[i] ? 0 : v0 * 0.012 * (model ? 1.3 : 1); v_kl[i] = 0;
  // pan: bass left, treble right
  pan = min(1, max(-1, (n - 64) / 44 * spread));
  v_pl[i] = cos((pan + 1) * $pi / 4); v_pr[i] = sin((pan + 1) * $pi / 4);
  v_gn[i] = 1.2 * 2 ^ ((n - 21) / 45);       // output level by key (the treble strings carry less energy)
  v_act[i] = 1; v_note[i] = n; v_held[i] = 1; v_sus[i] = 0; v_ns[i] = ns;
  v_nd[i] = n >= 89;                         // the top keys have no dampers
  agec += 1; v_age[i] = agec;
  ins_midi_hit();
);
function note_damp(i) local(s, kk) ( s = MS * i; kk = 0; loop(MS, s_g[s + kk] = s_gr[s + kk]; kk += 1; ); );
function note_off(n) local(i) (
  i = 0;
  loop(NV,
    v_act[i] && v_held[i] && v_note[i] == n ? (
      v_held[i] = 0;
      sus_pedal ? v_sus[i] = 1 : !v_nd[i] ? note_damp(i);
    );
    i += 1;
  );
);
function all_off() local(i) ( i = 0; loop(NV, v_held[i] = 0; v_sus[i] = 0; v_act[i] ? note_damp(i); i += 1; ); );

// ---------- soundboard: 16 plate modes, constant Q so the high modes decay fastest ----------
function bp_set(c, f, q) local(w, al, a0) (
  w = TP * min(f, srate * 0.45) / srate; al = sin(w) / (2 * q); a0 = 1 + al;
  c[0] = al / a0; c[1] = 0; c[2] = -al / a0; c[3] = -2 * cos(w) / a0; c[4] = (1 - al) / a0;
);
function bq(x, c) local(y) (
  y = c[0] * x + c[1] * c[5] + c[2] * c[6] - c[3] * c[7] - c[4] * c[8];
  c[6] = c[5]; c[5] = x; c[8] = c[7]; c[7] = y; y;
);
function body_setup(m) local(kk, f0, f1, f) (
  f0 = m ? 85 : 52; f1 = m ? 4200 : 3200;
  kk = 0;
  loop(16,
    f = f0 * (f1 / f0) ^ (kk / 15) * (1 + 0.07 * sin(kk * 2.7 + m));
    bp_set(BM + kk * 9, f, m ? 8 : 11);
    bm_g[kk] = 1 / (1 + 0.18 * kk);
    kk += 1;
  );
);

// ---------- patches (Drift and Volume stay as they are) ----------
function setp(m, hm, dy, st, un, su, dm, bo, to, pr, ro, sp) (
  slider2 = m; slider3 = hm; slider4 = dy; slider5 = st; slider6 = un; slider7 = su; slider8 = dm;
  slider9 = bo; slider10 = to; slider11 = pr; slider12 = ro; slider13 = sp;
);
function load_patch(p) (
  p == 0  ? setp(0, 50, 60, 40, 20, 60, 45, 55, 50, 35, 25, 60) :   // Concert Grand
  p == 1  ? setp(0, 55, 55, 40, 15, 55, 40, 45, 55, 25, 10, 50) :   // Studio Grand
  p == 2  ? setp(0, 75, 40, 45, 15, 50, 35, 40, 68, 20, 10, 45) :   // Bright Pop Grand
  p == 3  ? setp(0, 35, 65, 40, 22, 75, 55, 60, 42, 55, 35, 65) :   // Ballad Grand
  p == 4  ? setp(0, 45, 60, 45, 25, 55, 40, 55, 48, 30, 30, 50) :   // Jazz Club Grand
  p == 5  ? setp(0, 30, 70, 40, 20, 85, 60, 55, 40, 90, 60, 80) :   // Cinematic Halo
  p == 6  ? setp(1,  5, 50, 30, 20, 45, 30, 60, 32, 45, 15, 35) :   // Felt Piano
  p == 7  ? setp(1, 70, 45, 55, 25, 40, 35, 55, 62, 20, 15, 35) :   // Rock Upright
  p == 8  ? setp(1, 55, 50, 60, 45, 45, 40, 60, 50, 25, 25, 30) :   // Bar Upright
  p == 9  ? setp(1, 65, 45, 60, 90, 45, 40, 60, 58, 20, 25, 30) :   // Honky-Tonk
  p == 10 ? setp(1, 40, 55, 55, 35, 50, 45, 65, 45, 35, 20, 30) :   // Parlour Upright
            setp(1, 25, 40, 50, 40, 40, 35, 60, 25, 30, 20, 30);    // Dark Lo-Fi
  slider1 = p; last_patch = p; edited = 0;
  slider_automate(8191);                   // sliders 1-13
);
function patch_name(p) (
  p == 0 ? "CONCERT GRAND" : p == 1 ? "STUDIO GRAND" : p == 2 ? "BRIGHT POP" : p == 3 ? "BALLAD GRAND" :
  p == 4 ? "JAZZ CLUB" : p == 5 ? "CINEMATIC HALO" : p == 6 ? "FELT PIANO" : p == 7 ? "ROCK UPRIGHT" :
  p == 8 ? "BAR UPRIGHT" : p == 9 ? "HONKY-TONK" : p == 10 ? "PARLOUR" : "DARK LO-FI";
);

// ---------- parameters ----------
function update() (
  model = slider2 > 0.5;
  model != last_model ? ( body_setup(model); last_model = model; );
  ham = slider3 / 100; dyn = slider4 / 100; stiff = slider5 / 100;
  uni_c = (slider6 / 100) ^ 1.6 * 28;                         // 0 .. 28 cents (honky-tonk at the top)
  sus_t = 0.25 + 1.5 * (slider7 / 100) ^ 1.3;
  dmp_t = 0.25 + 2.75 * (slider8 / 100) ^ 1.5;
  body = slider9 / 100;
  tone_s = slider10 / 100; tilt = (tone_s - 0.5) * 1.1;
  res = slider11 / 100; room = slider12 / 100; spread = slider13 / 100;
  // bridge impedance (in string impedances): a lighter bridge couples the strings more strongly
  // The bridge takes a little energy whenever a key's strings swing together (the prompt sound), not when
  // they swing against each other (the aftersound): that is the piano's two-stage decay.
  zb = res > 0.005 ? 900 + 4000 * (1 - res) ^ 2 : 1000000000;
  drift = slider14 / 100;
  vol_t = 10 ^ (slider15 / 20);
  rm_g = 10 ^ (-3 * 0.015 / (0.5 + 0.8 * room));             // room T60 0.5 .. 1.3 s
  ins_output_setup(16); ins_stereo_setup(22);
);
last_model = -1;
tlc = 1 - exp(-TP * 900 / srate);
klc = 1 - exp(-TP * 700 / srate);
kdec = exp(-1 / (0.012 * srate));
hpc = 1 - exp(-TP * 30 / srate);
mlp = 1 - exp(-TP * 6500 / srate);
envc = 1 - exp(-1 / (0.02 * srate));
symc = 1 - exp(-1 / (0.05 * srate));
sm = 1 - exp(-1 / (0.03 * srate));
h_tmax = floor(0.06 * srate);
ml0 = floor(0.0073 * srate); ml1 = floor(0.0119 * srate); ml2 = floor(0.0171 * srate); ml3 = floor(0.0217 * srate);
OUTG = 0.5;                                // output calibration
update();
vol_s = vol_t;
!ui_dflt ? ( ui_thm = 9; ui_hw = 1; );                     // fixed black-lacquer-and-brass faceplate
last_patch = -1;
ui_dflt = 1;

@slider
last_patch < 0 ? ( last_patch = slider1; ) : ( slider1 != last_patch ? load_patch(slider1); );
update();

@block
update();
while (midirecv(mofs, m1, m2, m3)) (
  st = m1 & 0xF0;
  st == 0x90 && m3 > 0 ? ( m2 >= 21 && m2 <= 108 ? note_on(m2, m3); ) :     // the 88 keys, A0 - C8
  st == 0x80 || (st == 0x90 && m3 == 0) ? note_off(m2) :
  st == 0xB0 && m2 == 64 ? (
    sus_pedal = m3 >= 64;
    sus_pedal ? sym_on = 1 : (
      i = 0; loop(NV, v_act[i] && !v_held[i] && !v_nd[i] ? note_damp(i); v_sus[i] = 0; i += 1; );
    );
  ) :
  st == 0xB0 && m2 == 67 ? soft_pedal = m3 >= 64 :
  st == 0xB0 && (m2 == 123 || m2 == 120) ? ( all_off(); sus_pedal = 0; );
  midisend(mofs, m1, m2, m3);
);
ins_drift_block(drift, samplesblock);

@sample
sL = sR = 0; bsum = 0; bsy = 0; nj = 0;
wr = gw & RM;
// ---------- keys, pass 1: hammer, then each string's wave arriving at the bridge ----------
i = 0;
loop(NV,
  v_act[i] ? (
    ns = v_ns[i]; s0 = MS * i;
    // hammer against the string: compression of the felt, force, both bodies move
    dvh = 0;
    h_on[i] ? (
      vs = 0; s = s0;
      loop(ns, rb = RAIL + s * RS2; hh = s_h[s];
        vs += rb[(gw - hh) & RM] + rb[RS + ((gw - s_N[s] + hh) & RM)];
        s += 1; );
      // felt compression solved implicitly against the string's own reaction (its impedance, 2 x strings),
      // so even a stiff treble felt stays stable: c = c0 + (vh - vs_in) - F(c) / Zt, a few Newton steps
      vin = vs / ns; cn = h_y[i] - h_ys[i]; u = h_v[i] - vin;
      cmp = cn + u; pw = h_pw[i]; kz = h_K[i] / (2 * ns);
      cmp > 0 ? (
        loop(4,
          cpw = cmp ^ pw;
          cmp = max(0.0000000001, cmp - (cmp - cn - u + kz * cpw) / (1 + kz * pw * cpw / cmp));
        );
        cpw = cmp ^ pw;
      ) : cpw = 0;
      hfc = max(0, h_K[i] * (cpw + h_al[i] * (cpw - h_cp[i]))); h_cp[i] = cpw;
      h_ys[i] += vin + hfc / (2 * ns);
      h_y[i] += h_v[i];
      h_v[i] -= hfc * h_im[i];
      dvh = hfc * 0.5 / ns;                  // the force launches a velocity wave both ways on each string
      hfc > 0 ? h_fr[i] = 0 : h_fr[i] += 1;
      (h_fr[i] > 64 && h_v[i] < 0) || v_t[i] > h_tmax ? h_on[i] = 0;
    );
    v_dv[i] = dvh;
    vo = 0;
    s = s0;
    loop(ns,
      rb = RAIL + s * RS2;
      ri = (gw - s_N[s]) & RM;
      oR = rb[ri]; s_ol[s] = rb[RS + ri];
      // towards the bridge: fractional tuner, stiffness dispersion, losses
      e = s_eta[s]; y = e * oR + s_tx[s] - e * s_ty[s]; s_tx[s] = oR; s_ty[s] = y;
      a = s_a[s];
      o = a * y + s_x1[s] - a * s_y1[s]; s_x1[s] = y; s_y1[s] = o;
      y = a * o + s_x2[s] - a * s_y2[s]; s_x2[s] = o; s_y2[s] = y;
      s_nap[s] > 2 ? (
        o = a * y + s_x3[s] - a * s_y3[s]; s_x3[s] = y; s_y3[s] = o;
        y = a * o + s_x4[s] - a * s_y4[s]; s_x4[s] = o; s_y4[s] = y;
      );
      pp = s_p[s]; lp = (1 - pp) * y + pp * s_lp[s]; s_lp[s] = lp;
      y = s_g[s] * lp; s_yi[s] = y; bsy += y; nj += 1;
      vo += oR * s_w[s];
      s += 1;
    );
    // action knock
    v_ka[i] > 0.0000001 ? ( v_kl[i] += ((rand(2) - 1) * v_ka[i] - v_kl[i]) * klc; v_ka[i] *= kdec; ) : v_kl[i] = 0;
    vx = (vo + v_kl[i]) * v_gn[i];
    bsum += vx;
    sL += vx * v_pl[i]; sR += vx * v_pr[i];
    v_env[i] += (abs(vo) - v_env[i]) * envc;
  );
  i += 1;
);
// ---------- open strings (pedal down), pass 1 ----------
ysum = 0;
sym_on ? (
  j = 0;
  loop(NY,
    x = YB[j * YS + ((gw - y_L[j]) & YM)];
    e = y_eta[j]; y = e * x + y_tx[j] - e * y_ty[j]; y_tx[j] = x; y_ty[j] = y;
    pp = y_p[j]; lp = (1 - pp) * y + pp * y_lp[j]; y_lp[j] = lp;
    y = -(sus_pedal ? y_g[j] : y_gd[j]) * lp; y_yi[j] = y; bsy += y; nj += 1;
    ysum += x;
    j += 1;
  );
);
// ---------- the bridge: every string meets it at one junction ----------
// force balance  Zb vb = sum Z (v_in - v_out),  v_out = vb - v_in  ->  vb = 2 sum v_in / (Zb + N)
// lossless scattering into a resistive bridge: energy is only ever shared or lost, so any number of
// coupled strings stays stable. Strings with their dampers up ring in sympathy through it.
vb = 2 * bsy / (zb + nj);
// ---------- pass 2: reflections, hammer forces, retire silent keys ----------
i = 0;
loop(NV,
  v_act[i] ? (
    ns = v_ns[i]; s = MS * i; dvh = v_dv[i];
    loop(ns,
      rb = RAIL + s * RS2;
      rb[wr] = -s_ol[s];                     // agraffe: inverting reflection
      rb[RS + wr] = vb - s_yi[s];            // bridge junction
      dvh != 0 ? ( hh = s_h[s]; rb[(gw - hh) & RM] += dvh; rb[RS + ((gw - s_N[s] + hh) & RM)] += dvh; );
      s += 1;
    );
    v_t[i] += 1;
    v_t[i] > 2000 && !h_on[i] ? (
      ((v_env[i] < 0.00001 && !v_held[i] && !v_sus[i]) || (v_env[i] < 0.0000005 && !v_sil[i])) ? v_act[i] = 0;
    );
  );
  i += 1;
);
sym_on ? (
  wy = gw & YM;
  j = 0; loop(NY, YB[j * YS + wy] = vb - y_yi[j]; j += 1; );
  sym_env += (abs(ysum) - sym_env) * symc;
  !sus_pedal && sym_env < 0.000001 ? ( sym_on = 0; memset(YB, 0, NY * YS); memset(y_tx, 0, NY); memset(y_ty, 0, NY); memset(y_lp, 0, NY); );
);
gw = (gw + 1) & 1048575;

// ---------- soundboard: the bridge drives the plate modes ----------
m = (bsum + 0.5 * ysum) * OUTG;
hpz += (m - hpz) * hpc; mh = m - hpz;
bo = 0; be = 0; kk = 0;
loop(8,
  bo += bq(mh, BM + kk * 18) * bm_g[kk * 2];
  be += bq(mh, BM + kk * 18 + 9) * bm_g[kk * 2 + 1];
  kk += 1;
);
xL = (sL + 0.5 * ysum * 0.7) * OUTG * (1 - 0.4 * body) + body * 1.6 * (bo + 0.5 * be);
xR = (sR + 0.5 * ysum * 0.7) * OUTG * (1 - 0.4 * body) + body * 1.6 * (be + 0.5 * bo);
// ---------- tone (tilt about 900 Hz) ----------
tzL += (xL - tzL) * tlc; xL += tilt * (xL - 2 * tzL);
tzR += (xR - tzR) * tlc; xR += tilt * (xR - 2 * tzR);
// ---------- room (4-line feedback delay network) ----------
mm = 0.5 * (xL + xR);
q0 = FRM[(f_wp - ml0) & FM]; q1 = FRM[FSZ + ((f_wp - ml1) & FM)];
q2 = FRM[2 * FSZ + ((f_wp - ml2) & FM)]; q3 = FRM[3 * FSZ + ((f_wp - ml3) & FM)];
qz0 += (q0 - qz0) * mlp; qz1 += (q1 - qz1) * mlp; qz2 += (q2 - qz2) * mlp; qz3 += (q3 - qz3) * mlp;
qin = mm * room * 0.6;
FRM[f_wp]           = qin + 0.5 * rm_g * (qz0 + qz1 + qz2 + qz3);
FRM[FSZ + f_wp]     = qin + 0.5 * rm_g * (qz0 - qz1 + qz2 - qz3);
FRM[2 * FSZ + f_wp] = qin + 0.5 * rm_g * (qz0 + qz1 - qz2 - qz3);
FRM[3 * FSZ + f_wp] = qin + 0.5 * rm_g * (qz0 - qz1 - qz2 + qz3);
xL += room * (qz0 - qz2) * 0.7; xR += room * (qz1 - qz3) * 0.7;
f_wp = (f_wp + 1) & FM;

// ---------- volume + output stage ----------
vol_s += (vol_t - vol_s) * sm;
oL = ostL.ost_band(xL) * vol_s;
oR = ostR.ost_band(xR) * vol_s;
ins_stereo(oL, oR); ost_out(ins_sl, ins_sr);
spl0 = ost_l;
spl1 = ost_r;

@serialize
file_var(0, ui_sz);
file_var(0, edited);

@gfx 860 368
ui_thm = 9; ui_hw = 1;
ui_begin(860, 368);
INK = 0xE8D9B4; GOLD = 0xC9A043; GOLDL = 0xE8C66A; FELT = 0x5A1418;
// ---------- helpers ----------
function lbl(x, y, s, a) ( gfx_setfont(4); ui_cola(INK, a); ui_text(x * sc, y * sc, s); );
function stitle(cx, s) ( gfx_setfont(4); ui_col(GOLD); ui_text(cx * sc, 150 * sc, s); );
function divider(x) (
  ui_cola(0x000000, 0.55); gfx_line(x * sc, 150 * sc, x * sc, 296 * sc);
  ui_cola(0xFFFFFF, 0.06); gfx_line(x * sc + 1, 150 * sc, x * sc + 1, 296 * sc);
);
// brass-ringed LED key: returns 1 when clicked
function lkey(x, y, w, h, on, s) local(hit) (
  hit = pk_ledbtn(x * sc, y * sc, w * sc, h * sc, on, GOLDL);
  lbl(x + w * 0.5, y + h + 4, s, on ? 1 : 0.7);
  hit;
);
function pbtn(x, y, w, h) local(hit, inb) (
  inb = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hit = pressed && drag_id == 0 && inb; hit ? drag_id = -1;
  ui_keyshadow(x * sc, y * sc, w * sc, h * sc, 2 * sc);
  ui_col(0x141214); ui_rrs(x * sc, y * sc, w * sc, h * sc, 2 * sc);
  ui_col(mdown && inb ? 0x201C1E : 0x2A2527); ui_rrect((x + 2) * sc, (y + 2) * sc, (w - 4) * sc, (h - 5) * sc, 1.5 * sc);
  hit;
);

// ---------- cabinet: piano-black lacquer with a felt strip and brass pinstripe ----------
fh = 352;
ui_col(0x070707); gfx_rect(0, 0, gfx_w, gfx_h);
ui_cola(0x000000, 0.6); ui_rrect(10 * sc, 12 * sc, 844 * sc, fh * sc, 7 * sc);
ui_col(0x1A1718); ui_rrect(8 * sc, 8 * sc, 844 * sc, fh * sc, 7 * sc);
gfx_gradrect(9 * sc, 9 * sc, 842 * sc, (fh - 2) * sc, 0.10, 0.09, 0.095, 1, 0, 0, 0, 0, -0.07 / ((fh - 2) * sc), -0.065 / ((fh - 2) * sc), -0.065 / ((fh - 2) * sc), 0);
// lacquer sheen: a soft diagonal band
ui_cola(0xFFFFFF, 0.035); gfx_triangle(140 * sc, 9 * sc, 330 * sc, 9 * sc, 150 * sc, (fh + 6) * sc, -40 * sc, (fh + 6) * sc);
ui_cola(0xFFFFFF, 0.14); gfx_line(16 * sc, 9 * sc, 844 * sc, 9 * sc);
// felt strip
ui_col(FELT); gfx_rect(16 * sc, 12 * sc, 828 * sc, 6 * sc);
ui_cola(0x000000, 0.35); gfx_rect(16 * sc, 17 * sc, 828 * sc, 1 * sc);
// brass pinstripe
ui_col(GOLD); gfx_rect(20 * sc, 126 * sc, 820 * sc, 1 * sc);
ui_cola(GOLD, 0.45); gfx_rect(20 * sc, 300 * sc, 820 * sc, 1 * sc);

// ---------- brand ----------
ui_col(GOLD); gfx_circle(50 * sc, 58 * sc, 18 * sc, 1, 1);
ui_cola(0xFFFFFF, 0.25); gfx_circle(45 * sc, 52 * sc, 8 * sc, 1, 1);
gfx_setfont(2); ui_col(0x1A1408); ui_text(50 * sc, 51 * sc, "GFX");
gfx_setfont(6, "Georgia", 30 * sc, 'b'); ui_col(GOLDL); gfx_x = 80 * sc; gfx_y = 36 * sc; gfx_drawstr("G Piano");
gfx_setfont(4); ui_cola(INK, 0.7); gfx_x = 82 * sc; gfx_y = 76 * sc; gfx_drawstr("PHYSICAL MODEL GRAND & UPRIGHT");

// ---------- patch display ----------
ui_col(0x050505); ui_rrect(300 * sc, 34 * sc, 210 * sc, 56 * sc, 4 * sc);
gfx_gradrect(304 * sc, 38 * sc, 202 * sc, 48 * sc, 0.17, 0.11, 0.03, 1, 0, 0, 0, 0, -0.06 / (48 * sc), -0.04 / (48 * sc), -0.01 / (48 * sc), 0);
gfx_setfont(7, "Courier New", 15 * sc, 'b'); ui_col(GOLDL);
sprintf(#l1, edited ? "P%02d*%s" : "P%02d %s", slider1 + 1, patch_name(slider1));
gfx_x = 312 * sc; gfx_y = 45 * sc; gfx_drawstr(#l1);
gfx_setfont(8, "Courier New", 11 * sc, 'b'); ui_cola(GOLDL, 0.75);
drag_id >= 3 && drag_id <= 15 ? (
  drag_id == 3  ? sprintf(#l2, "HAMMER     %3.0f%%", slider3) :
  drag_id == 4  ? sprintf(#l2, "DYNAMICS   %3.0f%%", slider4) :
  drag_id == 5  ? sprintf(#l2, "STIFFNESS  %3.0f%%", slider5) :
  drag_id == 6  ? sprintf(#l2, "UNISON %5.1f cent", (slider6 / 100) ^ 1.6 * 28) :
  drag_id == 7  ? sprintf(#l2, "SUSTAIN    %3.0f%%", slider7) :
  drag_id == 8  ? sprintf(#l2, "DAMPER     %3.0f%%", slider8) :
  drag_id == 9  ? sprintf(#l2, "BODY       %3.0f%%", slider9) :
  drag_id == 10 ? sprintf(#l2, "TONE      %+4.0f", slider10 - 50) :
  drag_id == 11 ? sprintf(#l2, "RESONANCE  %3.0f%%", slider11) :
  drag_id == 12 ? sprintf(#l2, "ROOM       %3.0f%%", slider12) :
  drag_id == 13 ? sprintf(#l2, "SPREAD     %3.0f%%", slider13) :
  drag_id == 14 ? sprintf(#l2, "DRIFT      %3.0f%%", slider14) :
                  sprintf(#l2, "VOLUME  %5.1fdB", slider15);
) : (
  sprintf(#l2, "%s  PED:%s", slider2 > 0.5 ? "UPRIGHT" : "GRAND  ", sus_pedal ? "ON " : "OFF");
);
gfx_x = 312 * sc; gfx_y = 68 * sc; gfx_drawstr(#l2);
pressed && drag_id == 0 && mouse_x >= 300 * sc && mouse_x < 510 * sc && mouse_y >= 34 * sc && mouse_y < 90 * sc ? (
  drag_id = -1; #pm = "";
  strcat(#pm, ">Grand|"); slider1 == 0 ? strcat(#pm, "!"); strcat(#pm, "Concert Grand|");
  slider1 == 1 ? strcat(#pm, "!"); strcat(#pm, "Studio Grand|");
  slider1 == 2 ? strcat(#pm, "!"); strcat(#pm, "Bright Pop Grand|");
  slider1 == 3 ? strcat(#pm, "!"); strcat(#pm, "Ballad Grand|");
  slider1 == 4 ? strcat(#pm, "!"); strcat(#pm, "Jazz Club Grand|");
  strcat(#pm, "<"); slider1 == 5 ? strcat(#pm, "!"); strcat(#pm, "Cinematic Halo|");
  strcat(#pm, ">Upright|"); slider1 == 6 ? strcat(#pm, "!"); strcat(#pm, "Felt Piano|");
  slider1 == 7 ? strcat(#pm, "!"); strcat(#pm, "Rock Upright|");
  slider1 == 8 ? strcat(#pm, "!"); strcat(#pm, "Bar Upright|");
  slider1 == 9 ? strcat(#pm, "!"); strcat(#pm, "Honky-Tonk|");
  slider1 == 10 ? strcat(#pm, "!"); strcat(#pm, "Parlour Upright|");
  strcat(#pm, "<"); slider1 == 11 ? strcat(#pm, "!"); strcat(#pm, "Dark Lo-Fi");
  gfx_x = 300 * sc; gfx_y = 90 * sc; gsel = gfx_showmenu(#pm); gsel > 0 ? load_patch(gsel - 1);
);
ui_col(GOLDL); gfx_triangle(494 * sc, 78 * sc, 502 * sc, 78 * sc, 498 * sc, 83 * sc);
pbtn(518, 34, 34, 26) ? load_patch(slider1 >= 11 ? 0 : slider1 + 1);
pbtn(518, 64, 34, 26) ? load_patch(slider1 <= 0 ? 11 : slider1 - 1);
ui_col(INK);
gfx_line(529 * sc, 49 * sc, 535 * sc, 43 * sc, 1); gfx_line(535 * sc, 43 * sc, 541 * sc, 49 * sc, 1);
gfx_line(529 * sc, 74 * sc, 535 * sc, 80 * sc, 1); gfx_line(535 * sc, 80 * sc, 541 * sc, 74 * sc, 1);
lbl(535, 96, "PATCH", 0.6);

// ---------- model ----------
lkey(580, 40, 40, 38, slider2 < 0.5, "GRAND") ? ( slider2 = 0; ui_auto(2); edited = 1; );
lkey(630, 40, 40, 38, slider2 > 0.5, "UPRIGHT") ? ( slider2 = 1; ui_auto(2); edited = 1; );
ui_size_picker(770 * sc, 28 * sc);
lit = ins_midi_lit();
lit ? ( ui_cola(0x3ADF6A, 0.25); gfx_circle(780 * sc, 74 * sc, 5.5 * sc, 1, 1); ui_col(0x3ADF6A); ) : ui_col(0x123A1C);
gfx_circle(780 * sc, 74 * sc, 2.8 * sc, 1, 1); lbl(808, 69, "MIDI", 0.7);
sus_pedal ? ( ui_cola(GOLDL, 0.25); gfx_circle(780 * sc, 98 * sc, 5.5 * sc, 1, 1); ui_col(GOLDL); ) : ui_col(0x3A2E14);
gfx_circle(780 * sc, 98 * sc, 2.8 * sc, 1, 1); lbl(812, 93, "PEDAL", 0.7);

// ---------- knob sections ----------
C_INK = INK; C_KA = GOLD;
ui_section(2);
stitle(95, "HAMMER");
ui_knob(60 * sc, 196 * sc, 3, 0, 100, 50, 0, "HAMMER", "%.0f%%");
ui_knob(130 * sc, 196 * sc, 4, 0, 100, 55, 0, "DYNAMICS", "%.0f%%");
divider(170);
stitle(320, "STRINGS");
ui_knob(215 * sc, 196 * sc, 5, 0, 100, 40, 0, "STIFFNESS", "%.0f%%");
ui_knob(285 * sc, 196 * sc, 6, 0, 100, 20, 0, "UNISON", "%.0f%%");
ui_knob(355 * sc, 196 * sc, 7, 0, 100, 60, 0, "SUSTAIN", "%.0f%%");
ui_knob(425 * sc, 196 * sc, 8, 0, 100, 45, 0, "DAMPER", "%.0f%%");
divider(465);
stitle(545, "BODY");
ui_knob(510 * sc, 196 * sc, 9, 0, 100, 55, 0, "BODY", "%.0f%%");
ui_knob(580 * sc, 196 * sc, 10, 0, 100, 50, 0, "TONE", "%.0f");
divider(620);
stitle(700, "SPACE");
ui_knob(665 * sc, 196 * sc, 11, 0, 100, 35, 0, "RESONANCE", "%.0f%%");
ui_knob(735 * sc, 196 * sc, 12, 0, 100, 25, 0, "ROOM", "%.0f%%");
ui_knob(805 * sc, 196 * sc, 13, 0, 100, 60, 0, "SPREAD", "%.0f%%");
drag_id >= 3 && drag_id <= 13 ? edited = 1;

// ---------- master + IN / OUT strip ----------
C_INK = INK; ui_section(2);
ui_kmini = 1; ui_knob(300 * sc, 320 * sc, 14, 0, 100, 15, 0, "DRIFT", "%.0f%%"); ui_kmini = 0;
lbl(300, 336, "DRIFT", 0.9);
ui_kmini = 1; ui_knob(350 * sc, 320 * sc, 15, -24, 6, 0, 0, "VOLUME", "%.1f dB"); ui_kmini = 0;
lbl(350, 336, "VOLUME", 0.9);
ins_io(390, 307, 16, INK);
ins_stereo_mini(500, 307, 22, INK);
ui_end();
