desc:GFX Platte 140
//tags: reverb plate stereo studio broadcast vintage spring space
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-dyn and gfx-faceplate (.jsfx-inc) in the same folder.
//
// PLATTE 140 (work in progress)

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:2.2<0.4,5,0.01>-Damping: decay time (s)
slider2:10<0,250,1>-Pre-delay (ms)
slider3:100<20,600,1>-Low cut (Hz)
slider4:16000<2000,20000,10>-High cut (Hz)
slider5:20<0,100,1>-Drive (%)
slider6:30<0,100,1>-Mix (%)
slider7:100<0,150,1>-Width (%)
slider8:50<0,100,1>-Drift (%)
slider9:1<0,1,1{Off,On}>-Mono in
slider10:0<0,1,1{West,East}>-Version
slider11:0<0,100,1>-Spring (%)
slider12:0<-24,12,0.1>-Output (dB)
slider13:0<0,100,1>-Band sat (%)
slider14:30<0,100,1>-Bias (%)
slider15:120<40,400,1>-Sat low band (Hz)
slider16:6000<2000,16000,10>-Sat high band (Hz)
slider17:-0.3<-24,0,0.1>-Ceiling / limit threshold (dB)
slider18:1<0,2,1{Off,Clip,Limit}>-Output stage

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

options:maxmem=4194304

@init
#ui_man = "gfx-platte-140";                             // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
function pl_p2(n) local(p) ( p = 1; while (p < n) ( p *= 2; ); p; );
pl_bsz = pl_p2(0.1 * srate);   pl_bm = pl_bsz - 1;      // the 16 plate lines (up to 100 ms each)
pl_asz = pl_p2(0.02 * srate);  pl_am = pl_asz - 1;      // the allpasses inside the lines, and the input diffusers
pl_psz = pl_p2(0.26 * srate);  pl_pm = pl_psz - 1;      // pre-delay
pl_ssz = pl_p2(0.06 * srate);  pl_sm = pl_ssz - 1;      // the two torsion springs
pl_lb = alloc(16 * pl_bsz);
pl_ab = alloc(16 * pl_asz);
pl_db = alloc(8 * pl_asz);
pl_pb = alloc(2 * pl_psz);
pl_sb = alloc(2 * pl_ssz);
pl_tank0 = pl_lb; pl_tank1 = nextmem;                   // everything that rings (cleared on a WEST / EAST change)
pl_len = alloc(16);  pl_apl = alloc(16);  pl_g = alloc(16);  pl_kl = alloc(16); pl_ja = alloc(16); pl_jb = alloc(16);
pl_c = alloc(16);  pl_tpl = alloc(16); pl_tpr = alloc(16); pl_sgl = alloc(16); pl_sgr = alloc(16); pl_is = alloc(16);
pl_o = alloc(16);  pl_dv = alloc(16); pl_dr = alloc(64); pl_dln = alloc(8);  pl_dgn = alloc(8);  pl_sn = alloc(2);
pl_sgk = alloc(2);
pl_st0 = nextmem;                                       // filter states (cleared with the tank)
pl_lo = alloc(16); pl_y = alloc(16); pl_d1x = alloc(16); pl_d1y = alloc(16); pl_d2x = alloc(16); pl_d2y = alloc(16);
pl_dc = alloc(32); pl_sst = alloc(48); pl_slp = alloc(2);
pl_st1 = nextmem;
ost_init(alloc(4096));

pl_dn = 0.000000000000001;                              // anti-denormal: a -300 dB alternating whisper in the loops

// ---------- the plate: line lengths (ms) for the West plate; the East plate is the same sheet, thicker and longer ----------
function pl_lines(v) local(i, s, ms, ap, f) (
  s = v ? 1.22 : 1;
  i = 0;
  loop(16,
    ms = i == 0 ? 17.3 : i == 1 ? 19.9 : i == 2 ? 22.7 : i == 3 ? 24.1 : i == 4 ? 26.9 : i == 5 ? 29.3 : i == 6 ? 31.7 : i == 7 ? 33.1 :
         i == 8 ? 35.9 : i == 9 ? 38.3 : i == 10 ? 40.1 : i == 11 ? 43.7 : i == 12 ? 46.1 : i == 13 ? 49.3 : i == 14 ? 52.7 : 56.9;
    ap = i == 0 ? 3.1 : i == 1 ? 4.3 : i == 2 ? 5.3 : i == 3 ? 6.1 : i == 4 ? 2.7 : i == 5 ? 3.7 : i == 6 ? 4.9 : i == 7 ? 5.7 :
         i == 8 ? 2.3 : i == 9 ? 3.3 : i == 10 ? 4.1 : i == 11 ? 5.9 : i == 12 ? 6.7 : i == 13 ? 2.9 : i == 14 ? 3.9 : 4.7;
    pl_len[i] = floor(ms * s * 0.001 * srate) | 1;
    pl_apl[i] = floor(ap * s * 0.001 * srate) | 1;
    pl_g[i] = (i & 1 ? -1 : 1) * (v ? 0.66 : 0.62);
    // the two pickups: one tap per line each, spread along the line (some early, so the onset is immediate)
    f = 0.04 + 0.9 * (i * 0.6180339 + 0.13 - floor(i * 0.6180339 + 0.13)); pl_tpl[i] = max(floor(f * pl_len[i]), 1);
    f = 0.04 + 0.9 * (i * 0.3819661 + 0.71 - floor(i * 0.3819661 + 0.71)); pl_tpr[i] = max(floor(f * pl_len[i]), 1);
    pl_sgl[i] = (i == 1 || i == 2 || i == 6 || i == 9 || i == 11 || i == 12 || i == 13 || i == 15) ? -1 : 1;
    pl_sgr[i] = (i == 0 || i == 3 || i == 4 || i == 6 || i == 10 || i == 11 || i == 13 || i == 14) ? -1 : 1;
    pl_is[i] = (i == 2 || i == 3 || i == 6 || i == 7 || i == 9 || i == 12 || i == 13 || i == 14) ? -1 : 1;
    i += 1;
  );
  // input diffusers: four short allpasses per side (driver -> sheet)
  i = 0;
  loop(8,
    ms = i == 0 ? 0.93 : i == 1 ? 1.41 : i == 2 ? 2.73 : i == 3 ? 3.97 : i == 4 ? 1.07 : i == 5 ? 1.63 : i == 6 ? 2.39 : 4.31;
    pl_dln[i] = floor(ms * 0.001 * srate) | 1;
    pl_dgn[i] = (i & 3) < 2 ? 0.72 : 0.64;
    i += 1;
  );
  pl_sn[0] = floor(0.0331 * srate); pl_sn[1] = floor(0.0397 * srate);
  // the character of each plate
  v ? (
    pl_c0 = -0.55;      // dispersion (first-order allpasses in each line: the highs travel faster)
    pl_hipad = 1.45;    // how far the pad's effect reaches into the highs
    pl_thf = 1.35;      // the sheet's own high-frequency loss (s): darker
    pl_lomul = 1.0;
    pl_cal = 1.0;
  ) : (
    pl_c0 = -0.42;
    pl_hipad = 2.4;
    pl_thf = 2.9;
    pl_lomul = 1.1;
    pl_cal = 1.0;
  );
);
function pl_clear() (
  memset(pl_tank0, 0, pl_tank1 - pl_tank0);
  memset(pl_st0, 0, pl_st1 - pl_st0);
);

// ---------- drift sources in memory (a, b, phase, rate) ----------
function pl_dinit(p) ( p[0] = rand(2) - 1; p[1] = rand(2) - 1; p[2] = rand(1); p[3] = 0.7 + rand(0.6); );
function pl_dtick(p, inc) (
  p[2] += inc * p[3];
  p[2] >= 1 ? ( p[2] -= 1; p[0] = p[1]; p[1] = rand(2) - 1; );
  p[0] + (p[1] - p[0]) * (0.5 - 0.5 * cos($pi * p[2]));
);

// ---------- the send amplifier ----------
// WEST: a clean, symmetric transistor amp (soft, only when pushed)
function pl_satw(u) ( ost_tanh(u * 0.6) * 1.6666667 );
// EAST: input transformer (the lows saturate the core first) into a double triode (asymmetric: even harmonics)
pl_eb = ost_tanh(0.75 * 0.22); pl_en = 1 / (0.75 * (1 - pl_eb * pl_eb));
pl_xc = 1 - exp(-2 * $pi * 140 / srate);
function pl_sate(u) instance(lp) (
  lp += (u - lp) * pl_xc;
  u += 0.4 * (ost_tanh(lp * 1.3) * 0.7692308 - lp);
  (ost_tanh(0.75 * (u + 0.22)) - pl_eb) * pl_en;
);

// ---------- input diffusion: four allpasses (k0 = 0 side A, 4 side B) ----------
function pl_diff(x, k0) local(j, b, d, g, y) (
  j = 0;
  loop(4,
    b = pl_db + (k0 + j) * pl_asz; g = pl_dgn[k0 + j];
    d = b[(pl_dw - pl_dln[k0 + j]) & pl_am];
    y = d - g * x; b[pl_dw] = x + g * y; x = y;
    j += 1;
  );
  x;
);
// a short dispersion chain (driver to sheet: the highs arrive first)
function pl_disp(x, k0) local(j, p, y) (
  j = 0;
  loop(6,
    p = pl_dc + k0 + j * 2;
    y = -0.5 * x + p[0] + 0.5 * p[1]; p[0] = x; p[1] = y; x = y;
    j += 1;
  );
  x;
);

// ---------- one torsion spring (k = 0 / 1): delay, low-pass, a chirp chain (the highs travel slower) ----------
function pl_spr(x, k) local(b, s, j, y, yy, p) (
  b = pl_sb + k * pl_ssz;
  s = b[(pl_sw - pl_sn[k]) & pl_sm];
  pl_slp[k] += (s - pl_slp[k]) * pl_slc;
  y = pl_slp[k];
  j = 0;
  loop(12,
    p = pl_sst + k * 24 + j * 2;
    yy = 0.62 * y + p[0] - 0.62 * p[1]; p[0] = y; p[1] = yy; y = yy;
    j += 1;
  );
  b[pl_sw] = min(max(x + pl_sgk[k] * y + pl_dn, -4), 4);
  s;
);

// ---------- control rate (every 32 samples): decay -> the loss filters of all 16 lines ----------
pl_clo = 1 - exp(-2 * $pi * 300 / srate);               // the low-band split of the loss filter
pl_slc = 1 - exp(-2 * $pi * 4200 / srate);              // the springs' own low-pass
pl_tk = 1 - exp(-32 / (0.12 * srate));                  // DAMPING glide (no zipper)
pl_cdr = 0.035;                                         // modal detune range (dispersion coefficient wander)
function pl_ctl() local(i, T, Tl, Th, Ts, L, gl, gm, gh, a) (
  pl_ts += (pl_tt - pl_ts) * pl_tk;
  T = pl_ts * pl_cal * (1 + pl_ddv);
  Tl = T * pl_lomul;
  Th = 1 / (1 / (T * pl_hipad) + 1 / pl_thf);
  i = 0;
  loop(16,
    L = (pl_len[i] + pl_apl[i]) * -6.9077553 / srate;
    gl = exp(L / Tl); gm = exp(L / T); gh = exp(L / Th);
    pl_kl[i] = gl / gm - 1;
    a = (gm - gh) / (gm + gh); pl_ja[i] = a; pl_jb[i] = gm * (1 - a);
    pl_c[i] = pl_c0 + pl_cdr * pl_dv[i];
    i += 1;
  );
  Ts = min(T, 3.2) * 0.85;
  pl_sgk[0] = exp(-6.9077553 * pl_sn[0] / (Ts * srate));
  pl_sgk[1] = exp(-6.9077553 * pl_sn[1] / (Ts * srate));
  pl_wg = pl_wcal * (2.2 / pl_ts) ^ 0.3;                // longer plates are louder, but not by as much as the energy says
);
pl_wcal = 1;

// ---------- settings ----------
function update() (
  pl_tt = min(max(slider1, 0.4), 5);
  pl_pret = min(max(slider2, 0), 250) * 0.001 * srate;
  slider3 != pl_lcl ? ( pl_lcl = slider3; lcL.bq_set(1, slider3, 0.7071, 0); lcR.bq_set(1, slider3, 0.7071, 0); );
  slider4 != pl_hcl ? ( pl_hcl = slider4; hcL.bq_set(0, min(slider4, srate * 0.45), 0.7071, 0); hcR.bq_set(0, min(slider4, srate * 0.45), 0.7071, 0); );
  pl_hcon = slider4 < 19950;
  pl_dg = 10 ^ (slider5 / 100 * 24 / 20);
  pl_mxt = slider6 / 100;
  pl_wdt = slider7 / 100;
  drift_macro(slider8);
  pl_stt = slider9 >= 0.5 ? 0 : 1;
  pl_vtar = slider10 >= 0.5;
  pl_spt = slider11 / 100;
  pl_ot = 10 ^ (slider12 / 20);
  ost_setup(slider13 / 100, slider14 / 100, slider15, slider16, slider17, slider18);
);

// ---------- state ----------
in_init(); in_setup(0, 0);
ostL.ost_ch_init(); ostR.ost_ch_init();
pl_lcl = -1; pl_hcl = -1;
drvA.bq_set(1, 55, 0.6, 0); drvB.bq_set(1, 55, 0.6, 0);  // the driver: the sheet barely moves below 60 Hz
eqL.bq_set(2, 1400, 0.8, 3); eqR.bq_set(2, 1400, 0.8, 3);  // East: mid-focused return
pl_elc = 1 - exp(-2 * $pi * 8000 / srate);              // East: darker return
pl_smk = 1 - exp(-1 / (0.03 * srate));
pl_vfs = 1 / (0.03 * srate);
pl_vuc = 1 - exp(-1 / (0.3 * srate));
i = 0; loop(16, pl_dinit(pl_dr + i * 4); i += 1; );
drD.drift_init(0.8 + rand(0.5)); drH.drift_init(0.8 + rand(0.5));
update();
pl_ver = pl_vtar; pl_lines(pl_ver); pl_clear(); pl_vf = 1;
pl_ts = pl_tt; pl_ddv = 0; pl_ctl(); pl_cc = 0;
pl_mx = pl_mxt; pl_wd = pl_wdt; pl_o_ = pl_ot; pl_stm = pl_stt; pl_sp = pl_spt; pl_pre = pl_pret;
pl_w = 0; pl_aw = 0; pl_dw = 0; pl_pw = 0; pl_sw = 0; pl_hph = 0;
pl_vums = 0; pl_ovl = 0; pl_opkL = 0; pl_opkR = 0; pl_wpk = 0;

ui_thm = 5; ui_hw = 1;
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );                  // new instances open in Large, on Init
ui_dflt = 1;

@slider
update();

@block
update();
// DRIFT: plate tension wander - the decay and every line's dispersion (modal detune) wander slowly
pl_di = 0.12 * dm_s * samplesblock / srate;
pl_ddv = 0.045 * dm_a * drD.drift_tick(pl_di);
i = 0; loop(16, pl_dv[i] = dm_a * pl_dtick(pl_dr + i * 4, pl_di); i += 1; );
pl_hum = pl_ver ? 0.00005 * dm_a * (1 + 0.35 * drH.drift_tick(pl_di * 2)) : 0;
pl_hss = pl_ver ? 0.00004 * dm_a : 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@sample
in_process(spl0, spl1);
pl_l = in_l; pl_r = in_r;

// ---------- glides ----------
pl_mx  += (pl_mxt - pl_mx) * pl_smk;
pl_wd  += (pl_wdt - pl_wd) * pl_smk;
pl_o_  += (pl_ot - pl_o_) * pl_smk;
pl_stm += (pl_stt - pl_stm) * pl_smk;
pl_sp  += (pl_spt - pl_sp) * pl_smk;
pl_pre += (pl_pret - pl_pre) * 0.0004;
// WEST / EAST change: fade the return out, swap the plate, fade back in
pl_vtar != pl_ver ? (
  pl_vf -= pl_vfs;
  pl_vf <= 0 ? ( pl_vf = 0; pl_ver = pl_vtar; pl_lines(pl_ver); pl_clear(); pl_cc = 0; );
) : pl_vf < 1 ? pl_vf = min(pl_vf + pl_vfs, 1);
(pl_cc -= 1) <= 0 ? ( pl_cc = 32; pl_ctl(); );
pl_dn = -pl_dn;

// ---------- the send amplifier (DRIVE) and the driver ----------
pl_m = 0.5 * (pl_l + pl_r);
pl_xa = (pl_m + (pl_l - pl_m) * pl_stm) * pl_dg;        // MONO IN: one driver, fed L + R
pl_xb = (pl_m + (pl_r - pl_m) * pl_stm) * pl_dg;
pl_vums += (0.5 * (pl_xa * pl_xa + pl_xb * pl_xb) - pl_vums) * pl_vuc;
pl_ovl = max(pl_ovl, max(abs(pl_xa), abs(pl_xb)));
pl_ver ? ( pl_xa = saA.pl_sate(pl_xa); pl_xb = saB.pl_sate(pl_xb); )
       : ( pl_xa = pl_satw(pl_xa); pl_xb = pl_satw(pl_xb); );
pl_xa = drvA.bq_run(pl_xa / pl_dg); pl_xb = drvB.bq_run(pl_xb / pl_dg);

// ---------- pre-delay (gliding, linear interpolation) ----------
pl_pb[pl_pw] = pl_xa; pl_pb[pl_psz + pl_pw] = pl_xb;
pl_rp = pl_pw - pl_pre; pl_rp < 0 ? pl_rp += pl_psz;
pl_ri = floor(pl_rp); pl_rf = pl_rp - pl_ri;
pl_i0 = pl_ri & pl_pm; pl_i1 = (pl_ri + 1) & pl_pm;
pl_xa = pl_pb[pl_i0] + (pl_pb[pl_i1] - pl_pb[pl_i0]) * pl_rf;
pl_xb = pl_pb[pl_psz + pl_i0] + (pl_pb[pl_psz + pl_i1] - pl_pb[pl_psz + pl_i0]) * pl_rf;
pl_pw = (pl_pw + 1) & pl_pm;

// ---------- driver -> sheet: dispersion and diffusion ----------
pl_sx = 0.5 * (pl_xa + pl_xb);
pl_da = pl_diff(pl_disp(pl_xa, 0), 0) * 0.5;
pl_db_ = pl_diff(pl_disp(pl_xb, 16), 4) * 0.5;
pl_dw = (pl_dw + 1) & pl_am;

// ---------- the plate: 16 lines, loss filters, a 16 x 16 Hadamard, allpass + dispersion in each line ----------
pl_tl = 0; pl_tr = 0;
i = 0;
loop(16,
  pl_bb = pl_lb + i * pl_bsz;
  pl_v = pl_bb[(pl_w - pl_len[i]) & pl_bm];
  pl_tl += pl_sgl[i] * pl_bb[(pl_w - pl_tpl[i]) & pl_bm];
  pl_tr += pl_sgr[i] * pl_bb[(pl_w - pl_tpr[i]) & pl_bm];
  pl_lo[i] += (pl_v - pl_lo[i]) * pl_clo;
  pl_v += pl_kl[i] * pl_lo[i];
  pl_y[i] = pl_o[i] = pl_jb[i] * pl_v + pl_ja[i] * pl_y[i];
  i += 1;
);
pl_h = 1;
loop(4,
  i = 0;
  loop(16,
    (i & pl_h) == 0 ? ( pl_u = pl_o[i]; pl_v = pl_o[i + pl_h]; pl_o[i] = pl_u + pl_v; pl_o[i + pl_h] = pl_u - pl_v; );
    i += 1;
  );
  pl_h *= 2;
);
i = 0;
loop(16,
  pl_u = pl_o[i] * 0.25 + pl_is[i] * (i & 1 ? pl_db_ : pl_da);
  pl_bb = pl_ab + i * pl_asz;
  pl_v = pl_bb[(pl_aw - pl_apl[i]) & pl_am];
  pl_y_ = pl_v - pl_g[i] * pl_u; pl_bb[pl_aw] = pl_u + pl_g[i] * pl_y_;
  pl_cf = pl_c[i];
  pl_u = pl_cf * pl_y_ + pl_d1x[i] - pl_cf * pl_d1y[i]; pl_d1x[i] = pl_y_; pl_d1y[i] = pl_u;
  pl_v = pl_cf * pl_u + pl_d2x[i] - pl_cf * pl_d2y[i]; pl_d2x[i] = pl_u; pl_d2y[i] = pl_v;
  pl_bb = pl_lb + i * pl_bsz; pl_bb[pl_w] = min(max(pl_v + pl_dn, -4), 4);
  i += 1;
);
pl_w = (pl_w + 1) & pl_bm;
pl_aw = (pl_aw + 1) & pl_am;

pl_wl = pl_tl * 0.25 * pl_wg; pl_wr = pl_tr * 0.25 * pl_wg;

// ---------- springs (blend) ----------
pl_sp > 0.0005 ? (
  pl_shp += (pl_sx - pl_shp) * 0.026;
  pl_s0 = pl_spr(pl_sx - pl_shp, 0); pl_s1 = pl_spr(pl_sx - pl_shp, 1);
  pl_wl += pl_sp * (pl_s0 + 0.35 * pl_s1 - pl_wl * 0.5);
  pl_wr += pl_sp * (pl_s1 + 0.35 * pl_s0 - pl_wr * 0.5);
);
pl_sw = (pl_sw + 1) & pl_sm;

// ---------- the return amplifier: East colour, hum and hiss ----------
pl_ver ? (
  pl_wl = eqL.bq_run(pl_wl); pl_wr = eqR.bq_run(pl_wr);
  pl_elL += (pl_wl - pl_elL) * pl_elc; pl_elR += (pl_wr - pl_elR) * pl_elc;
  pl_wl = pl_elL; pl_wr = pl_elR;
  pl_hph += 50 / srate; pl_hph >= 1 ? pl_hph -= 1;
  pl_hv = sin(2 * $pi * pl_hph); pl_hv = pl_hum * (0.6 * pl_hv + 0.6 * (abs(pl_hv) - 0.6366));
  pl_wl += pl_hv + pl_hss * (rand(2) - 1); pl_wr += pl_hv + pl_hss * (rand(2) - 1);
);
// LOW CUT / HIGH CUT on the return
pl_wl = lcL.bq_run(pl_wl); pl_wr = lcR.bq_run(pl_wr);
pl_hcon ? ( pl_wl = hcL.bq_run(pl_wl); pl_wr = hcR.bq_run(pl_wr); );
// width
pl_em = 0.5 * (pl_wl + pl_wr); pl_es = 0.5 * (pl_wl - pl_wr) * pl_wd;
pl_wl = (pl_em + pl_es) * pl_vf; pl_wr = (pl_em - pl_es) * pl_vf;
pl_wpk = max(pl_wpk, max(abs(pl_wl), abs(pl_wr)));
// mix: dry full down to 50 %, wet full from 50 %
pl_gd = min(2 * (1 - pl_mx), 1); pl_gw = min(2 * pl_mx, 1);
pl_ol = pl_l * pl_gd + pl_wl * pl_gw;
pl_or = pl_r * pl_gd + pl_wr * pl_gw;

// ---------- output stage ----------
pl_ol = ostL.ost_band(pl_ol) * pl_o_;
pl_or = ostR.ost_band(pl_or) * pl_o_;
ost_out(pl_ol, pl_or);
spl0 = ost_l; spl1 = ost_r;
pl_opkL = max(pl_opkL, abs(spl0)); pl_opkR = max(pl_opkR, abs(spl1));

@gfx 820 320
ui_begin(820, 320);
ui_col(0x5E6B63); gfx_rect(0, 0, gfx_w, gfx_h);
ui_end();
