desc:GFX Compressor Q [comp + EQ]
//tags: compressor dynamics vca bus glue
//author: JGWizrad / Garden FX (GFX)
//
// Compressor Q: GFX Compressor with a four-band parametric EQ (the Equaliser engine) added below.
// EQ FIRST (into the compressor) or EQ AFTER. EQ: LO CUT, LOW / LO MID / HI MID / HIGH gain and frequency,
// LOW / HIGH SHELF, HI CUT.
//
// Requires gfx-drift, gfx-input, gfx-output and gfx-ui (.jsfx-inc) in the same folder.
//
// One compressor, three voicings:
//   VCA     - punchy RMS compressor with program-dependent timing; RATIO goes past infinity
//             into negative ratios (louder in = quieter out) for pumping, backwards effects
//   BUS     - stereo-linked glue / mastering compressor: peak-sensing, smooth, low colour
//   RIDE    - transparent "easy ride" leveller: wide knee, adaptive timing, very musical
//   OPTO    - optical cell: soft attack, two-stage release (lets go quickly, then slowly)
// AUTO timing: attack and release follow the programme (release lengthens on sustained reduction).
// Frequency knob, two modes (click its label to switch):
//   SC HPF - the detector ignores the lows (12 dB/oct high-pass), the whole signal is compressed
//   SPLIT  - only the lows below the frequency are compressed, via a Linkwitz-Riley (24 dB/oct)
//            crossover: flat response when nothing is compressed.
// MIX in MASTER = parallel compression.
// DRIFT: threshold and timing breathe slightly, the EQ bands wander. The DRIFT dial scales the compressor and EQ
// drift amounts (50% = the settings below, 100% = twice, 0 = none) and speeds the wander up with them.
// IN / OUT: TRIM (with the GUARD key), SAT and the OUT stage (OFF / CLIP / LIMIT) on the panel.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-lozenge.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:0<0,3,1{VCA,Bus,Ride,Opto}>-Voicing
slider2:-18<-50,0,0.1>-Threshold (dB)
slider3:0.75<0,2,0.001>-Ratio (slope: 0 = 1:1, 1 = inf, 2 = -1:1)
slider4:10<0.1,100,0.1>-Attack (ms)
slider5:150<20,2000,1>-Release (ms)
slider6:1<0,1,1{Off,On}>-Auto timing
slider7:6<0,18,0.1>-Knee (dB)
slider8:0<0,24,0.1>-Makeup (dB)
slider9:80<20,2000,1>-SC HPF / Split freq (Hz, 20 = off)
slider10:1<0,1,1{Off,On}>-Stereo link
slider11:5<0,50,1>-Threshold drift (%)
slider12:10<0,50,1>-Timing drift (%)
slider13:0.25<0.02,2,0.01>-Drift speed (Hz)
slider14:100<0,100,1>-Mix (%)
slider15:0<-24,12,0.1>-Output (dB)
slider16:0<0,100,1>-Band sat (%)
slider17:30<0,100,1>-Bias (%)
slider18:120<40,400,1>-Sat low band (Hz)
slider19:6000<2000,16000,10>-Sat high band (Hz)
slider20:-0.3<-24,0,0.1>-Ceiling / limit threshold (dB)
slider21:1<0,2,1{Off,Clip,Limit}>-Output stage
slider22:0<-24,12,0.1>-Input trim (dB)
slider23:1<0,1,1{Off,On}>-Input guard
slider24:1<0,1,1{Split,SC HPF}>-Frequency mode
slider25:0<0,1,1{Stereo,Mid/Side}>-EQ: Mode
slider26:100<20,500,1>-EQ: Low freq (Hz)
slider27:0<-16,16,0.1>-EQ: Low gain (dB, below -12 = notch)
slider28:1<0.05,4,0.01>-EQ: Low width (oct)
slider29:1<0,1,1{Bell,Shelf}>-EQ: Low shape
slider30:0<0,2,1{Both,Mid,Side}>-EQ: Low M/S target
slider31:400<80,2000,1>-EQ: Lo-mid freq (Hz)
slider32:0<-16,16,0.1>-EQ: Lo-mid gain (dB)
slider33:1<0.05,4,0.01>-EQ: Lo-mid width (oct)
slider34:0<0,2,1{Both,Mid,Side}>-EQ: Lo-mid M/S target
slider35:2500<400,8000,1>-EQ: Hi-mid freq (Hz)
slider36:0<-16,16,0.1>-EQ: Hi-mid gain (dB)
slider37:1<0.05,4,0.01>-EQ: Hi-mid width (oct)
slider38:0<0,2,1{Both,Mid,Side}>-EQ: Hi-mid M/S target
slider39:8000<1500,20000,10>-EQ: High freq (Hz)
slider40:0<-16,16,0.1>-EQ: High gain (dB)
slider41:1<0.05,4,0.01>-EQ: High width (oct)
slider42:1<0,1,1{Bell,Shelf}>-EQ: High shape
slider43:0<0,2,1{Both,Mid,Side}>-EQ: High M/S target
slider44:20<20,1000,1>-EQ: Low cut (Hz, 20 = off)
slider45:20000<2000,20000,10>-EQ: High cut (Hz, 20000 = off)
slider46:10<0,50,1>-EQ: Drift amount (%)
slider47:10<0,50,1>-EQ: (unused, was gain drift)
slider48:0.2<0.02,2,0.01>-EQ: Drift speed (Hz)
slider49:0<-24,12,0.1>-EQ: Output (dB)
slider50:0<0,3,1{x1 12 dB/oct,x2 24 dB/oct,x3 36 dB/oct,x4 48 dB/oct}>-EQ: Low cut slope
slider51:0<0,3,1{x1 12 dB/oct,x2 24 dB/oct,x3 36 dB/oct,x4 48 dB/oct}>-EQ: High cut slope
slider52:0<0,1,1{EQ then Comp,Comp then EQ}>-Order
// DRIFT dial: scales the threshold / timing wander (sliders 11-13) and the EQ band wander (sliders 46, 48); 50 % = as set.
slider53:50<0,100,1>-Drift (%)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-compressor-q";                                  // the ? pop-up links to this manual

function bq_hp(f) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * 0.70710678); n = 1 + al;
  b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function bq_lp(f) instance(b0, b1, b2, a1, a2) local(w0, cw, al, n) (
  w0 = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w0); al = sin(w0) / (2 * 0.70710678); n = 1 + al;
  b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function bq_run(x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = x; y2 = y1; y1 = y;
  y;
);

// detector: RMS (VCA, RIDE) or peak (BUS), result in dB
function comp_det(pw, pk) instance(e, pe) (
  voice == 1 ? ( pe = max(pk, pe * pkdec); 20 * log10(max(pe, 0.000001)); )
             : ( e += (pw - e) * crms;     10 * log10(max(e, 0.000000000001)); );
);

// static curve with soft knee; returns gain reduction in dB (positive)
function comp_curve(over) (
  kn < 0.05 ? ( over > 0 ? slope_e * over : 0; ) :
  2 * over < -kn ? 0 :
  2 * abs(over) <= kn ? slope_e * (over + kn * 0.5) * (over + kn * 0.5) / (2 * kn) :
  slope_e * over;
);

// gain-reduction smoothing with manual or programme-dependent timing
function comp_gr(ldb) instance(gr, grs, of, os) local(tg, a, r) (
  tg = comp_curve(ldb - thr_e);
  voice == 3 ? (
    // optical cell: a fast part and a slow part; soft attack, two-stage release
    of += (tg - of) * (tg > of ? opt_fa : opt_fr);
    os += (tg - os) * (tg > os ? opt_sa : opt_sr);
    gr = 0.6 * of + 0.4 * os;
  ) : (
  autot ? ( a = att_auto; r = 60 + rel_span * min(grs / 12, 1); ) : ( a = att_ms; r = rel_ms; );
  a *= tmul; r *= tmul;
  gr += (tg - gr) * (tg > gr ? 1 - exp(-1 / (0.001 * a * srate)) : 1 - exp(-1 / (0.001 * r * srate)));
  );
  grs += (gr - grs) * cslow;
  gr;
);

function ratio_text(rsl) (
  rsl < 0.995 ? sprintf(#rt, "%.1f:1", 1 / (1 - rsl)) :
  rsl <= 1.005 ? strcpy(#rt, "INF:1") :
  sprintf(#rt, "-%.1f:1", 1 / (rsl - 1));
  #rt;
);

function update() (
  voice = slider1;
  thr = slider2;
  slope = voice == 0 ? slider3 : min(slider3, 1);
  att_ms = slider4; rel_ms = slider5;
  autot = slider6;
  knee = slider7;
  mk = slider8;
  split = slider9; fmode = slider24;
  split > 20.5 ? ( lpL1.bq_lp(split); lpL2.bq_lp(split); lpR1.bq_lp(split); lpR2.bq_lp(split);
                   hpL1.bq_hp(split); hpL2.bq_hp(split); hpR1.bq_hp(split); hpR2.bq_hp(split);
                   scfL.bq_hp(split); scfR.bq_hp(split); );
  link = slider10;
  drift_macro(slider53);
  tdr = slider11 / 100 * dm_a; mdr = slider12 / 100 * dm_a;
  dspd = slider13 * dm_s;
  mix_t = slider14 / 100;
  out_t = 10 ^ (slider15 / 20);
  voice == 0 ? ( att_auto = 8;  rel_span = 900;  kn = knee; ) :
  voice == 1 ? ( att_auto = 20; rel_span = 800;  kn = knee; ) :
  voice == 2 ? ( att_auto = 15; rel_span = 1400; kn = max(knee, 10); ) :
               ( att_auto = 10; rel_span = 1500; kn = max(knee, 12); );
  in_setup(slider22, slider23);
  ost_setup(slider16 / 100, slider17 / 100, slider18, slider19, slider20, slider21);
);

// ---------- presets (leave Drift speed, Output and the I/O rows alone) ----------
function setp(v, th, rsl, at, re, au, kne, mk_, hp, lk, mx, fm) (
  slider1 = v; slider2 = th; slider3 = rsl; slider4 = at; slider5 = re; slider6 = au;
  slider7 = kne; slider8 = mk_; slider9 = hp; slider10 = lk; slider14 = mx; slider24 = fm;
);
function load_preset(p) (
  p == 1 ? setp(2, -20, 0.67, 15,  250, 1, 12, 3, 100, 1, 100, 1) :   // Vocal Ride
  p == 2 ? setp(0, -28, 0.83, 3,   80,  0, 2,  6, 60,  1, 100, 1) :   // Drum Smash
  p == 3 ? setp(0, -22, 0.75, 10,  150, 1, 6,  4, 120, 1, 100, 0) :   // Bass Glue
  p == 4 ? setp(1, -16, 0.5,  30,  300, 0, 6,  2, 90,  1, 100, 1) :   // Bus Glue
  p == 5 ? setp(0, -24, 1.5,  5,   200, 0, 3,  6, 80,  1, 100, 1) :   // Negative Pump
  p == 6 ? setp(2, -24, 0.5,  15,  400, 1, 15, 3, 80,  1, 100, 1) :   // Gentle Level
  p == 7 ? setp(0, -35, 0.9,  1,   60,  0, 0,  10, 80, 1, 40, 1) :    // Parallel Crush
  p == 8 ? setp(1, -10, 0.33, 30,  500, 1, 9,  1, 100, 1, 100, 1) :   // Mastering Touch
  p == 9 ? setp(3, -22, 0.75, 10,  150, 1, 12, 4, 80,  1, 100, 1) :   // Opto Vocal
  p == 10 ? setp(3, -26, 0.8, 10,  150, 1, 12, 3, 160, 1, 100, 0);    // Opto Lows Only
  p >= 1 && p <= 10 ? slider_automate(8397823);   // sliders 1-10, 14, 24
  p == 11 ? (                                  // Reset all to defaults
    slider1 = 0; slider2 = -18; slider3 = 0.75; slider4 = 10; slider5 = 150; slider6 = 1; slider7 = 6;
    slider8 = 0; slider9 = 80; slider10 = 1; slider11 = 5; slider12 = 10; slider13 = 0.25; slider14 = 100;
    slider15 = 0; slider16 = 0; slider17 = 30; slider18 = 120; slider19 = 6000; slider20 = -0.3; slider21 = 1;
    slider22 = 0; slider23 = 1; slider24 = 1; slider53 = 50;
    slider_automate(16777215); ui_auto(53);
  );
);

// ---------- memory / state ----------
grh = 0; grlen = 160; memset(grh, 0, grlen); grhi = 0;
sm    = 1 - exp(-1 / (0.03 * srate));
vuc   = 1 - exp(-1 / (0.01 * srate));
crms  = 1 - exp(-1 / (0.01 * srate));
pkdec = exp(-1 / (0.03 * srate));
cslow = 1 - exp(-1 / (1.0 * srate));
opt_fa = 1 - exp(-1 / (0.01 * srate));  opt_fr = 1 - exp(-1 / (0.06 * srate));   // opto fast part
opt_sa = 1 - exp(-1 / (0.25 * srate));  opt_sr = 1 - exp(-1 / (1.8 * srate));    // opto slow part
drT.drift_init(0.8 + rand(0.5));
drM.drift_init(0.8 + rand(0.5));
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
in_init();
pkL = 0; pkR = 0; vu_ms = 0; dispGr = 0; dispLdb = -60; grPk = 0;
!ui_dflt ? ui_thm = 17; !ui_dflt ? ui_hw = 0;   // defaults for new instances: Mint, flat (saved projects keep their own)

update();
mix_s = mix_t; out_s = out_t;


// ================= EQ (the Equaliser engine, names q_..., sliders 25 - 51) =================
// a preset mask of the EQ unit, one slider at a time
function cb_auto(m, off) local(k) ( k = 1; loop(63, m - 2 * floor(m / 2) ? ui_auto(k + off); m = floor(m / 2); k += 1; ); );
#ui_man = "gfx-compressor-q";                                  // the ? pop-up links to this manual

// ---------- state-variable filter (stable under modulation) ----------
// typ: 0 bell, 1 low shelf, 2 high shelf, 3 high-pass, 4 low-pass
function q_svf_set(f, q_ge, q, q_typ) instance(a1, a2, a3, q_m0, q_m1, q_m2) local(q_Ag, g, k) (
  g = tan($pi * min(f, srate * 0.45) / srate);
  q_Ag = 10 ^ (q_ge / 40);
  q_typ == 0 ? ( k = 1 / (q * q_Ag); q_m0 = 1; q_m1 = k * (q_Ag * q_Ag - 1); q_m2 = 0; ) :
  q_typ == 1 ? ( g /= sqrt(q_Ag); k = 1 / q; q_m0 = 1; q_m1 = k * (q_Ag - 1); q_m2 = q_Ag * q_Ag - 1; ) :
  q_typ == 2 ? ( g *= sqrt(q_Ag); k = 1 / q; q_m0 = q_Ag * q_Ag; q_m1 = k * (1 - q_Ag) * q_Ag; q_m2 = 1 - q_Ag * q_Ag; ) :
  q_typ == 3 ? ( k = 1 / q; q_m0 = 1; q_m1 = -k; q_m2 = -1; ) :
             ( k = 1 / q; q_m0 = 0; q_m1 = 0;  q_m2 = 1; );
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
);
function q_svf_run(x, c1, c2, c3, n0, n1, n2) instance(ic1, ic2) local(v1, v2, v3) (
  v3 = x - ic2;
  v1 = c1 * ic1 + c2 * v3;
  v2 = ic2 + c2 * ic1 + c3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  n0 * x + n1 * v1 + n2 * v2;
);

// ---------- band maths (shared by audio and display) ----------
function q_eff_gain(q_gs) ( q_gs >= -12 ? q_gs : -12 + (q_gs + 12) * 7 );           // -16 on the knob = -40 dB notch
function q_bell_q(w, q_ge) local(p) (
  p = 2 ^ w;
  sqrt(p) / (p - 1) * (0.75 + 0.5 * min(abs(q_ge) / 16, 1));                 // proportional width
);
function q_shelf_q(w) ( min(max(0.707 / sqrt(w), 0.3), 2) );
// Q of stage k (0-based) in an n-stage (order 2n) Butterworth filter
function q_bw_q(n, k) ( 1 / (2 * cos($pi * (2 * k + 1) / (4 * n))) );

// magnitude (dB) of one section at frequency f (matches the filters above)
function q_mag_db(f, q_typ, q_f0, q_ge, q) local(w, w2, q_Ag, n, d, s) (
  w = tan($pi * min(f, srate * 0.49) / srate) / tan($pi * min(q_f0, srate * 0.45) / srate);
  w2 = w * w; q_Ag = 10 ^ (q_ge / 40);
  q_typ == 0 ? ( n = sqr(1 - w2) + sqr(q_Ag * w / q); d = sqr(1 - w2) + sqr(w / (q_Ag * q)); ) :
  q_typ == 1 ? ( s = q_Ag * w2 / (q * q); n = q_Ag * q_Ag * (sqr(q_Ag - w2) + s); d = sqr(1 - q_Ag * w2) + s; ) :
  q_typ == 2 ? ( s = q_Ag * w2 / (q * q); n = q_Ag * q_Ag * (sqr(1 - q_Ag * w2) + s); d = sqr(q_Ag - w2) + s; ) :
  q_typ == 3 ? ( n = w2 * w2; d = sqr(1 - w2) + w2 / (q * q); ) :
             ( n = 1;       d = sqr(1 - w2) + w2 / (q * q); );
  10 * log10(max(n, 0.000000000001) / max(d, 0.000000000001));
);

// drawing-only copies (the screen runs alongside the audio, so it must not share the audio's functions)
function q_d_eff_gain(q_gs) ( q_gs >= -12 ? q_gs : -12 + (q_gs + 12) * 7 );
function q_d_bell_q(w, q_ge) local(p) ( p = 2 ^ w; sqrt(p) / (p - 1) * (0.75 + 0.5 * min(abs(q_ge) / 16, 1)); );
function q_d_shelf_q(w) ( min(max(0.707 / sqrt(w), 0.3), 2) );
function q_d_bw_q(n, k) ( 1 / (2 * cos($pi * (2 * k + 1) / (4 * n))) );

function q_freq_text(f) (
  f >= 1000 ? sprintf(#ft, "%.2f kHz", f / 1000) : sprintf(#ft, "%.0f Hz", f);
  #ft;
);
function q_gain_text(q_gs) local(q_ge) (
  q_ge = q_d_eff_gain(q_gs);
  q_ge < -12 ? sprintf(#gt, "NOTCH %.0f", q_ge) : sprintf(#gt, "%+.1f dB", q_ge);
  #gt;
);

// high cut sections at the glided frequency q_hc_f (follows slider45 in @sample)
function q_hc_coef() (
  lp1.q_svf_set(q_hc_f, 0, q_bw_q(q_lpn, 0), 4); lp2.q_svf_set(q_hc_f, 0, q_bw_q(q_lpn, 1), 4);
  q_lp3.q_svf_set(q_hc_f, 0, q_bw_q(q_lpn, 2), 4); q_lp4.q_svf_set(q_hc_f, 0, q_bw_q(q_lpn, 3), 4);
);

// ---------- parameters ----------
function q_update() (
  ms = slider25;
  q_tg0 = slider30; q_tg1 = slider34; q_tg2 = slider38; q_tg3 = slider43;
  q_sh0 = slider29 ? 1 : 0; q_sh3 = slider42 ? 2 : 0;
  q_hp_on = slider44 > 20.5; q_lp_on = slider45 < 19995;
  q_hpn = slider50 + 1; q_lpn = slider51 + 1;
  q_hp1.q_svf_set(slider44, 0, q_bw_q(q_hpn, 0), 3); q_hp2.q_svf_set(slider44, 0, q_bw_q(q_hpn, 1), 3);
  q_hp3.q_svf_set(slider44, 0, q_bw_q(q_hpn, 2), 3); q_hp4.q_svf_set(slider44, 0, q_bw_q(q_hpn, 3), 3);
  q_hc_coef();
  drift_macro(slider53);
  q_fdr = slider46 / 100 * dm_a; q_gdr = q_fdr; q_dspd = slider48 * dm_s;      // one AMOUNT moves frequencies and gains together
  q_out_t = 10 ^ (slider49 / 20);
  
  
);

// hi-mid band from its smoothed gain (q_hm_s glides to slider36 in q_proc)
function q_hm_coef() local(g) ( g = q_eff_gain(q_hm_s) * q_hm_gm; c2.q_svf_set(q_hm_f, g, q_bell_q(slider37, g), 0); );

// band coefficients with drift (called once per block)
function q_band_coefs(q_dinc) local(v, f, g) (
  v = q_dF0.drift_tick(q_dinc); f = slider26  * 2 ^ (q_fdr * 0.5 * v); v = q_dG0.drift_tick(q_dinc); g = q_eff_gain(slider27)  * (1 + q_gdr * 0.3 * v);
  q_c0.q_svf_set(f, g, q_sh0 ? q_shelf_q(slider28) : q_bell_q(slider28, g), q_sh0);
  v = q_dF1.drift_tick(q_dinc); f = slider31  * 2 ^ (q_fdr * 0.5 * v); v = q_dG1.drift_tick(q_dinc); g = q_eff_gain(slider32)  * (1 + q_gdr * 0.3 * v);
  c1.q_svf_set(f, g, q_bell_q(slider33, g), 0);
  v = q_dF2.drift_tick(q_dinc); q_hm_f = slider35 * 2 ^ (q_fdr * 0.5 * v); v = q_dG2.drift_tick(q_dinc); q_hm_gm = 1 + q_gdr * 0.3 * v;
  q_hm_coef();
  v = q_dF3.drift_tick(q_dinc); f = slider39 * 2 ^ (q_fdr * 0.5 * v); v = q_dG3.drift_tick(q_dinc); g = q_eff_gain(slider40) * (1 + q_gdr * 0.3 * v);
  c3.q_svf_set(f, g, q_sh3 ? q_shelf_q(slider41) : q_bell_q(slider41, g), q_sh3);
);

// ---------- presets (leave drift, output and the I/O rows alone) ----------
function q_pLo(f, g, w, s, t) ( slider26 = f;  slider27 = g;  slider28 = w;  slider29 = s;  slider30 = t; );
function q_pLm(f, g, w, t)    ( slider31 = f;  slider32 = g;  slider33 = w;  slider34 = t; );
function q_pHm(f, g, w, t)    ( slider35 = f; slider36 = g; slider37 = w; slider38 = t; );
function q_pHi(f, g, w, s, t) ( slider39 = f; slider40 = g; slider41 = w; slider42 = s; slider43 = t; );
function q_pCut(q_hpf, q_lpf, m)  ( slider44 = q_hpf; slider45 = q_lpf; slider25 = m; slider50 = 0; slider51 = 0; );
function q_load_preset(p) (
  p == 1 ? ( q_pLo(120, -2, 1, 1, 0);  q_pLm(300, -2, 1.2, 0); q_pHm(3000, 3, 1.2, 0);  q_pHi(10000, 3, 1, 1, 0);  q_pCut(80, 20000, 0); ) :   // Vocal Presence
  p == 2 ? ( q_pLo(60, 4, 1, 0, 0);    q_pLm(350, -4, 1.5, 0); q_pHm(3500, 3, 1, 0);    q_pHi(10000, 0, 1, 1, 0);  q_pCut(30, 20000, 0); ) :   // Kick Weight
  p == 3 ? ( q_pLo(80, 2, 1, 1, 0);    q_pLm(250, -3, 1.5, 0); q_pHm(800, 2, 1, 0);     q_pHi(5000, -2, 1, 1, 0);  q_pCut(35, 20000, 0); ) :   // Bass Clarity
  p == 4 ? ( q_pLo(100, -2, 1, 1, 0);  q_pLm(200, -2, 1.5, 0); q_pHm(5000, 2, 1.5, 0);  q_pHi(12000, 4, 1, 1, 0);  q_pCut(70, 20000, 0); ) :   // Acoustic Sparkle
  p == 5 ? ( q_pLo(100, 0, 1, 1, 0);   q_pLm(400, 0, 1, 0);    q_pHm(2500, 0, 1, 0);    q_pHi(15000, 3, 1.5, 1, 0); q_pCut(25, 20000, 0); ) :  // Mix Air
  p == 6 ? ( q_pLo(100, 0, 1, 1, 0);   q_pLm(300, -4, 1, 0);   q_pHm(2500, 0, 1, 0);    q_pHi(8000, 0, 1, 1, 0);   q_pCut(50, 20000, 0); ) :   // Mud Cut
  p == 7 ? ( q_pLo(100, 0, 1, 1, 0);   q_pLm(400, 0, 1, 0);    q_pHm(1500, 6, 1, 0);    q_pHi(8000, 0, 1, 1, 0);   q_pCut(400, 3500, 0); slider50 = 1; slider51 = 1; ) :   // Telephone
  p == 8 ? ( q_pLo(100, 0, 1, 1, 0);   q_pLm(400, 0, 1, 0);    q_pHm(3200, -4, 0.7, 0); q_pHi(7000, -3, 0.5, 0, 0); q_pCut(20, 20000, 0); ) :  // De-Harsh
  p == 9 ? ( q_pLo(50, -16, 0.05, 0, 0); q_pLm(100, -16, 0.05, 0); q_pHm(2500, 0, 1, 0); q_pHi(8000, 0, 1, 1, 0);  q_pCut(20, 20000, 0); ) :   // Hum Notch 50 Hz
  p == 10 ? ( q_pLo(120, -12, 1, 1, 2); q_pLm(300, -2, 1.5, 2); q_pHm(2500, 0, 1, 0);   q_pHi(10000, 4, 1, 1, 2);  q_pCut(20, 20000, 1); ) :   // M/S Wide Air
  p == 11 ? ( q_pLo(150, -10, 1, 1, 2); q_pLm(400, 0, 1, 0);    q_pHm(2000, 2, 1.5, 1); q_pHi(8000, 0, 1, 1, 0);   q_pCut(20, 20000, 1); );     // M/S Centre Focus
  p >= 1 && p <= 11 ? ( cb_auto(2097151, 24); slider_automate(slider50); slider_automate(slider51); );   // sliders 1-21, 34, 35
  p == 12 ? (                                     // Reset all to defaults
    q_pLo(100, 0, 1, 1, 0); q_pLm(400, 0, 1, 0); q_pHm(2500, 0, 1, 0); q_pHi(8000, 0, 1, 1, 0); q_pCut(20, 20000, 0);
    slider46 = 10; slider47 = 10; slider48 = 0.2; slider49 = 0;
    slider16 = 0; slider17 = 30; slider18 = 120; slider19 = 6000; slider20 = -0.3; slider21 = 1;
    slider22 = 0; slider23 = 0;
    cb_auto(1073741823, 24);                  // sliders 1-30
    slider_automate(slider21); slider_automate(slider22); slider_automate(slider23);
    slider_automate(slider50); slider_automate(slider51);
  );
);

// ---------- band group panel (drawn in @gfx) ----------
// ---------- the four bands in one row: alternating pyramids (two rows of controls each) ----------
// knob caps per section (as on a console): brown, blue, green, red
q_EQ_CLO = 0x8A5A34; q_EQ_CLM = 0x3A78A0; q_EQ_CHM = 0x3C9A6C; q_EQ_CHI = 0xB2423B;
// a band's controls; positions are unscaled (x, y = knob centres), kx / ky = the SHELF key (0 = none),
// mx / my = the M/S target key (shown in M/S mode)
function q_eq_tag(cx, y, title) local(tw, th) (
  gfx_setfont(4); gfx_measurestr(title, tw, th);
  ui_cola(C_INK, 0.85); ui_rrect(cx * sc - tw * 0.5 - 5 * sc, y * sc, tw + 10 * sc, 13 * sc, 2 * sc);
  ui_col(C_KA); gfx_x = cx * sc - tw * 0.5; gfx_y = y * sc + 2 * sc; gfx_drawstr(title);
);
// the narrow / wide Q symbols at the two ends of a width knob
function q_eq_qicon(x, y, q_wide) (
  ui_cola(C_INK, 0.85);
  q_wide ? (
    gfx_line((x - 7) * sc, y * sc, (x - 4) * sc, y * sc, 1); gfx_line((x - 4) * sc, y * sc, (x - 2) * sc, (y - 5) * sc, 1);
    gfx_line((x - 2) * sc, (y - 5) * sc, (x + 2) * sc, (y - 5) * sc, 1); gfx_line((x + 2) * sc, (y - 5) * sc, (x + 4) * sc, y * sc, 1);
    gfx_line((x + 4) * sc, y * sc, (x + 7) * sc, y * sc, 1);
  ) : (
    gfx_line((x - 6) * sc, y * sc, (x - 2) * sc, y * sc, 1); gfx_line((x - 2) * sc, y * sc, x * sc, (y - 6) * sc, 1);
    gfx_line(x * sc, (y - 6) * sc, (x + 2) * sc, y * sc, 1); gfx_line((x + 2) * sc, y * sc, (x + 6) * sc, y * sc, 1);
  );
);
function q_eq_band(q_fi, q_fmin, q_fmax, q_fdef, q_flbl, fx, fy, q_gx, q_gy, q_wx, q_wy, shp, q_kx, q_ky, ti, mx, my, cap) (
  ui_kcap = cap; ui_knob(fx * sc, fy * sc, (q_fi) + 24,     q_fmin, q_fmax, q_fdef, 1, q_flbl, q_freq_text(slider((q_fi) + 24)));
  ui_kcap = cap; ui_knob(q_gx * sc, q_gy * sc, (q_fi + 1) + 24, -16,  16,   0,    0, "dB", q_gain_text(slider((q_fi + 1) + 24)));
  ui_kcap = cap; ui_knob(q_wx * sc, q_wy * sc, (q_fi + 2) + 24, 0.05, 4,    1,    1, ui_hw ? "" : "Q", "%.2f oct");
  ui_hw ? ( q_eq_qicon(q_wx - 16, q_wy + 26, 0); q_eq_qicon(q_wx + 16, q_wy + 26, 1); );   // narrow ... wide
  shp > 0 ? (
    ui_keycap(q_kx * sc, q_ky * sc, 38 * sc, 22 * sc, "SH", slider((shp) + 24) == 1, 1) ?
      ( slider((shp) + 24) = 1 - slider((shp) + 24); slider_automate(2 ^ (shp - 1)); );
  );
  slider25 == 1 ? (
    ui_keycap(mx * sc, my * sc, 42 * sc, 22 * sc,
              slider((ti) + 24) == 1 ? "MID" : slider((ti) + 24) == 2 ? "SIDE" : "BOTH", slider((ti) + 24) > 0, 1) ?
      ( slider((ti) + 24) = (slider((ti) + 24) + 1) % 3; slider_automate(2 ^ (ti - 1)); );
  );
);
// engraved divider that steps across between a pyramid and an upside-down one
function q_eq_div(q_xt, q_xb, y) (
  ui_cola(0x000000, 0.25);
  gfx_line((q_xt + 1) * sc, (y + 8) * sc, (q_xt + 1) * sc, (y + 72) * sc); gfx_line((q_xt + 1) * sc, (y + 72) * sc, (q_xb + 1) * sc, (y + 96) * sc);
  gfx_line((q_xb + 1) * sc, (y + 96) * sc, (q_xb + 1) * sc, (y + 156) * sc);
  ui_cola(C_INK, 0.45);
  gfx_line(q_xt * sc, (y + 8) * sc, q_xt * sc, (y + 72) * sc); gfx_line(q_xt * sc, (y + 72) * sc, q_xb * sc, (y + 96) * sc);
  gfx_line(q_xb * sc, (y + 96) * sc, q_xb * sc, (y + 156) * sc);
);

// ---------- memory / state ----------
sm  = 1 - exp(-1 / (0.03 * srate));
q_vuc = 1 - exp(-1 / (0.01 * srate));
q_dF0.drift_init(0.8 + rand(0.5)); q_dG0.drift_init(0.8 + rand(0.5));
q_dF1.drift_init(0.8 + rand(0.5)); q_dG1.drift_init(0.8 + rand(0.5));
q_dF2.drift_init(0.8 + rand(0.5)); q_dG2.drift_init(0.8 + rand(0.5));
q_dF3.drift_init(0.8 + rand(0.5)); q_dG3.drift_init(0.8 + rand(0.5));
  

q_pkL = 0; q_pkR = 0; q_vu_ms = 0;
   // defaults for new instances: Petrol, hardware (saved projects keep their own)

q_hc_f = min(slider45, srate * 0.45); q_hc_n = 0;   // high cut frequency glide (~20 ms)
q_update();
q_hm_s = slider36; q_hm_k = 1 - exp(-16 / (0.02 * srate)); q_hm_n = 0;   // hi-mid gain glide (~20 ms, coefficients every 16 samples)
q_hcw = q_lp_on; q_hcxs = 1 / (0.02 * srate);                              // high cut fades in / out over 20 ms
q_band_coefs(0);
q_out_s = q_out_t;


function q_proc(cb_inl, cb_inr) (
  q_inL = cb_inl; q_inR = cb_inr;
  q_vu_ms += (0.5 * (q_inL * q_inL + q_inR * q_inR) - q_vu_ms) * q_vuc;
  q_out_s += (q_out_t - q_out_s) * sm;
  
  // A / B = left / right, or mid / side
  ms ? ( a = 0.5 * (q_inL + q_inR); b = 0.5 * (q_inL - q_inR); ) : ( a = q_inL; b = q_inR; );
  
  q_hp_on ? (
    ( a = q_hsA1.q_svf_run(a, q_hp1.a1, q_hp1.a2, q_hp1.a3, q_hp1.q_m0, q_hp1.q_m1, q_hp1.q_m2); b = q_hsB1.q_svf_run(b, q_hp1.a1, q_hp1.a2, q_hp1.a3, q_hp1.q_m0, q_hp1.q_m1, q_hp1.q_m2); );
    q_hpn > 1 ? ( a = q_hsA2.q_svf_run(a, q_hp2.a1, q_hp2.a2, q_hp2.a3, q_hp2.q_m0, q_hp2.q_m1, q_hp2.q_m2); b = q_hsB2.q_svf_run(b, q_hp2.a1, q_hp2.a2, q_hp2.a3, q_hp2.q_m0, q_hp2.q_m1, q_hp2.q_m2); );
    q_hpn > 2 ? ( a = q_hsA3.q_svf_run(a, q_hp3.a1, q_hp3.a2, q_hp3.a3, q_hp3.q_m0, q_hp3.q_m1, q_hp3.q_m2); b = q_hsB3.q_svf_run(b, q_hp3.a1, q_hp3.a2, q_hp3.a3, q_hp3.q_m0, q_hp3.q_m1, q_hp3.q_m2); );
    q_hpn > 3 ? ( a = q_hsA4.q_svf_run(a, q_hp4.a1, q_hp4.a2, q_hp4.a3, q_hp4.q_m0, q_hp4.q_m1, q_hp4.q_m2); b = q_hsB4.q_svf_run(b, q_hp4.a1, q_hp4.a2, q_hp4.a3, q_hp4.q_m0, q_hp4.q_m1, q_hp4.q_m2); );
  );
  q_hm_s != slider36 ? ( (q_hm_n += 1) >= 16 ? ( q_hm_n = 0; q_hm_s += (slider36 - q_hm_s) * q_hm_k; abs(slider36 - q_hm_s) < 0.001 ? q_hm_s = slider36; q_hm_coef(); ); );
  // high cut: always running (its state stays primed), faded in / out rather than switched; its frequency glides
  q_hc_t = min(slider45, srate * 0.45);
  q_hc_f != q_hc_t ? ( (q_hc_n += 1) >= 16 ? ( q_hc_n = 0; q_hc_f *= (q_hc_t / q_hc_f) ^ q_hm_k; abs(q_hc_f - q_hc_t) < 0.0005 * q_hc_t ? q_hc_f = q_hc_t; q_hc_coef(); ); );
  q_hcw = q_lp_on ? min(q_hcw + q_hcxs, 1) : max(q_hcw - q_hcxs, 0);
  q_hca = a; q_hcb = b;
  (
    ( a = q_lsA1.q_svf_run(a, lp1.a1, lp1.a2, lp1.a3, lp1.q_m0, lp1.q_m1, lp1.q_m2); b = q_lsB1.q_svf_run(b, lp1.a1, lp1.a2, lp1.a3, lp1.q_m0, lp1.q_m1, lp1.q_m2); );
    q_lpn > 1 ? ( a = q_lsA2.q_svf_run(a, lp2.a1, lp2.a2, lp2.a3, lp2.q_m0, lp2.q_m1, lp2.q_m2); b = q_lsB2.q_svf_run(b, lp2.a1, lp2.a2, lp2.a3, lp2.q_m0, lp2.q_m1, lp2.q_m2); );
    q_lpn > 2 ? ( a = q_lsA3.q_svf_run(a, q_lp3.a1, q_lp3.a2, q_lp3.a3, q_lp3.q_m0, q_lp3.q_m1, q_lp3.q_m2); b = q_lsB3.q_svf_run(b, q_lp3.a1, q_lp3.a2, q_lp3.a3, q_lp3.q_m0, q_lp3.q_m1, q_lp3.q_m2); );
    q_lpn > 3 ? ( a = q_lsA4.q_svf_run(a, q_lp4.a1, q_lp4.a2, q_lp4.a3, q_lp4.q_m0, q_lp4.q_m1, q_lp4.q_m2); b = q_lsB4.q_svf_run(b, q_lp4.a1, q_lp4.a2, q_lp4.a3, q_lp4.q_m0, q_lp4.q_m1, q_lp4.q_m2); );
  );
  q_hcw < 1 ? ( a = q_hca + (a - q_hca) * q_hcw; b = q_hcb + (b - q_hcb) * q_hcw; );
  
  (!ms || q_tg0 != 2) ? a = q_sA0.q_svf_run(a, q_c0.a1, q_c0.a2, q_c0.a3, q_c0.q_m0, q_c0.q_m1, q_c0.q_m2);
  (!ms || q_tg0 != 1) ? b = q_sB0.q_svf_run(b, q_c0.a1, q_c0.a2, q_c0.a3, q_c0.q_m0, q_c0.q_m1, q_c0.q_m2);
  (!ms || q_tg1 != 2) ? a = q_sA1.q_svf_run(a, c1.a1, c1.a2, c1.a3, c1.q_m0, c1.q_m1, c1.q_m2);
  (!ms || q_tg1 != 1) ? b = q_sB1.q_svf_run(b, c1.a1, c1.a2, c1.a3, c1.q_m0, c1.q_m1, c1.q_m2);
  (!ms || q_tg2 != 2) ? a = q_sA2.q_svf_run(a, c2.a1, c2.a2, c2.a3, c2.q_m0, c2.q_m1, c2.q_m2);
  (!ms || q_tg2 != 1) ? b = q_sB2.q_svf_run(b, c2.a1, c2.a2, c2.a3, c2.q_m0, c2.q_m1, c2.q_m2);
  (!ms || q_tg3 != 2) ? a = q_sA3.q_svf_run(a, c3.a1, c3.a2, c3.a3, c3.q_m0, c3.q_m1, c3.q_m2);
  (!ms || q_tg3 != 1) ? b = q_sB3.q_svf_run(b, c3.a1, c3.a2, c3.a3, c3.q_m0, c3.q_m1, c3.q_m2);
  
  ms ? ( q_oL = a + b; q_oR = a - b; ) : ( q_oL = a; q_oR = b; );
  
  // output stage
  q_oL = (q_oL) * q_out_s;
  q_oR = (q_oR) * q_out_s;
  q_pkL = max(q_pkL, abs(q_oL)); q_pkR = max(q_pkR, abs(q_oR));
  q_out_l = q_oL; q_out_r = q_oR;
);
q_ord = slider52;
ui_dflt = 1;   // theme defaults above apply once: @init re-runs (playback start, device reset) must not undo the saved theme

@slider
q_update();
q_ord = slider52;
update();

@block
q_update();
q_band_coefs(q_dspd * samplesblock / srate);
q_ord = slider52;
update();

@serialize
file_var(0, ui_thm);
file_var(0, ui_sz);
file_var(0, ui_hw);
file_avail(0) != 0 ? file_var(0, pr_cur);    // the preset in use (older projects end before it)

@sample
// input stage: DC block, trim, guard
in_process(spl0, spl1);
!q_ord ? ( q_proc(in_l, in_r); in_l = q_out_l; in_r = q_out_r; );   // EQ first
inL = in_l; inR = in_r;
vu_ms += (0.5 * (inL * inL + inR * inR) - vu_ms) * vuc;

// drift
dinc = dspd / srate;
vT = drT.drift_tick(dinc);
vM = drM.drift_tick(dinc);
thr_e = thr + tdr * 3 * vT;
tmul = 1 + 0.3 * mdr * vM;
slope_e = slope;

mix_s += (mix_t - mix_s) * sm;
out_s += (out_t - out_s) * sm;

// split: the lows (LR4 low-pass) are the sidechain and the only part that gets compressed
usesplit = split > 20.5 && fmode == 0;
usehpf   = split > 20.5 && fmode == 1;
usesplit ? ( sL = lpL2.bq_run(lpL1.bq_run(inL)); sR = lpR2.bq_run(lpR1.bq_run(inR));
             hiL = hpL2.bq_run(hpL1.bq_run(inL)); hiR = hpR2.bq_run(hpR1.bq_run(inR)); ) :
usehpf   ? ( sL = scfL.bq_run(inL); sR = scfR.bq_run(inR); )
         : ( sL = inL; sR = inR; );

link || voice == 1 ? (
  ld = dtL.comp_det(0.5 * (sL * sL + sR * sR), max(abs(sL), abs(sR)));
  grL = compL.comp_gr(ld); grR = grL;
) : (
  ldL = dtL.comp_det(sL * sL, abs(sL)); ldR = dtR.comp_det(sR * sR, abs(sR));
  grL = compL.comp_gr(ldL); grR = compR.comp_gr(ldR);
  ld = max(ldL, ldR);
);

gainL = 10 ^ ((mk - grL) / 20); gainR = 10 ^ ((mk - grR) / 20);
usesplit ? ( cL = hiL + sL * gainL; cR = hiR + sR * gainR; )   // LR4 bands sum flat, in phase
             : ( cL = inL * gainL; cR = inR * gainR; );
// VCA colour: a touch of even harmonics under heavy reduction
voice == 0 ? (
  cc = 0.04 * min(max(grL, grR) / 15, 1);
  cL += cc * cL * abs(cL); cR += cc * cR * abs(cR);
);

oL = inL * (1 - mix_s) + cL * mix_s;
oR = inR * (1 - mix_s) + cR * mix_s;

// output stage
q_ord ? ( q_proc(oL, oR); oL = q_out_l; oR = q_out_r; );   // EQ after
oL = ostL.ost_band(oL) * out_s;
oR = ostR.ost_band(oR) * out_s;
ost_out(oL, oR);
spl0 = ost_l;
spl1 = ost_r;
pkL = max(pkL, abs(spl0)); pkR = max(pkR, abs(spl1));

dispLdb = ld; grPk = max(grPk, max(grL, grR)); dispGr = max(grL, grR);

@gfx 1000 550
ui_begin(1000, 550);
ui_swb();   // drawn off-screen, then shown with the units in signal order (EQ FIRST / EQ AFTER)
lz_colours();
pk_shad = 0.3; pk_shoff = 0.8;

// the voicing selector: four coloured lit buttons, two rows of two, names outside (left column: names on the
// left, right column: names on the right); returns the chosen position
function vsel(x, y, pos) local(i, cx, cy, tw, th, s) (
  i = 0;
  loop(4,
    cx = x + (i % 2) * 46; cy = y + floor(i / 2) * 40;
    lz_lamp(cx, cy, pos == i, i == 0 ? 0xFF6FB4 : i == 1 ? 0x3A9CFF : i == 2 ? 0xFF9A22 : 0xFF3A2A, "") ? pos = i;
    s = i == 0 ? "VCA" : i == 1 ? "BUS" : i == 2 ? "RIDE" : "OPTO";
    gfx_setfont(6, "Arial", 11 * sc, 'b'); gfx_measurestr(s, tw, th);
    ui_cola(lz_ink, i == pos ? 1 : 0.65);
    gfx_x = i % 2 ? (cx + 19) * sc : (cx - 19) * sc - tw; gfx_y = (cy + 13) * sc - th * 0.5; gfx_drawstr(s);
    i += 1; );
  pos;
);

// ---------- the faceplate ----------
fh = 376 + 120 + 46;
ui_col(0x0B0C0C); gfx_rect(0, 0, gfx_w, gfx_h);
lz_chassis(6, 4, 988, fh);
lz_brand("COMPRESSOR Q");

// ---------- the graph section ----------
ui_swu((slider52 == 0 ? 492 - 372 : 0) + 46);
lz_sect(84, 12, 250, 358);
vdb = 10 * log10(max(vu_ms, 0.0000000001));
lz_led(102, 31, vdb > -50, 0x6AFF8A); lz_label(142, 24, "SIGNAL");
lz_small(220, 27, "INPUT", 1);
sprintf(#v, "%.1f dB", max(vdb, -60)); lz_lcd(284, 22, 70, #v);
// the transfer curve, -60 .. 0 dB
gx0 = 118; gy0 = 60; gs = 196;
ui_col(lz_dk); gfx_rect((gx0 - 22) * sc, (gy0 - 8) * sc, (gs + 32) * sc, (gs + 30) * sc);
gfx_gradrect((gx0 - 21) * sc, (gy0 - 7) * sc, (gs + 30) * sc, (gs + 28) * sc, 0.70, 0.80, 0.86, 1, 0, 0, 0, 0, -0.0006 / sc, -0.0005 / sc, -0.0004 / sc, 0);
gi = 0; loop(7, ui_col(gi % 3 == 0 ? 0xE4EEF4 : 0xC4D6E2);
  gfx_rect((gx0 + gi / 6 * gs) * sc, gy0 * sc, 1, gs * sc); gfx_rect(gx0 * sc, (gy0 + gi / 6 * gs) * sc, gs * sc, 1); gi += 1; );
gfx_setfont(6, "Arial", 9 * sc, 'b'); ui_col(0x2A3C46);
gi = 1; loop(5, sprintf(#gl, "%d", -60 + gi * 10);
  gfx_x = (gx0 + gi / 6 * gs - 7) * sc; gfx_y = (gy0 + gs + 6) * sc; gfx_drawstr(#gl);
  gfx_x = (gx0 - 18) * sc; gfx_y = (gy0 + gs - gi / 6 * gs - 4) * sc; gfx_drawstr(#gl); gi += 1; );
ui_col(0xD4E2EA); gfx_line(gx0 * sc, (gy0 + gs) * sc, (gx0 + gs) * sc, gy0 * sc, 1);
kn_d = slider1 == 2 ? max(slider7, 10) : slider1 == 3 ? max(slider7, 12) : slider7;
slope_d = slider1 == 0 ? slider3 : min(slider3, 1);
gi = 0;
loop(121,
  xin = -60 + gi * 0.5; ov = xin - slider2;
