gfx_setfont(8); ui_col(hw ? INK2 : NTX); TC(1095, 352, "STEREO");
mknob(22, 1032, 420, 19, 0, 100, 100, 0, CAP_GRY, "MIX", fpct(slider22)); touch(22, "MIX", fpct(slider22));
mknob(23, 1094, 420, 19, -24, 12, 0, 0, CAP_BLU, "OUTPUT", fdb(slider23)); touch(23, "OUTPUT", fdb(slider23));
ui_outkeys(1134*0.75, 392*0.75, 50*0.75, 14, 2, 24);
gfx_setfont(8); ui_col(hw ? INK2 : NTX); TC(1159, 456, "OUT");

pk_end();
ui_end();
