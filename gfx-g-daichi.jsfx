desc:GFX G Daichi
//tags: instrument synth poly virtual analogue lead bass pad fm sync unison arpeggiator
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-instrument, gfx-voice, gfx-arp, gfx-dyn and
// gfx-faceplate (.jsfx-inc) in the same folder.
//
// A virtual-analogue polysynth in the spirit of the much-loved early-2000s freeware VA, itself modelled on the
// classic red Swedish virtual-analogue lead synth: two oscillators, a sync / FM / ring section, a mod envelope,
// a multimode filter, two LFOs, unison, an arpeggiator and a compact effects strip.
//   OSC 1     sine, triangle, saw, square (pulse, PULSE WIDTH) or noise; SUB one octave down (sine or square);
//             FM: OSC 2 modulates OSC 1 (phase modulation on sine / triangle, through-zero-clamped FM on the others)
//   OSC 2     the same waves; PITCH (semitones), FINE, TRACK (off = fixed pitch, ignores the keyboard),
//             SYNC (hard sync to OSC 1, band-limited); RING (OSC 1 x OSC 2); MIX balances OSC 1 <-> OSC 2
//   MOD ENV   attack / decay envelope (AMOUNT +/-) to OSC 2 pitch, FM amount or pulse width
//   FILTER    12 dB LP, 24 dB LP (zero-delay ladder, self-oscillates at full RESONANCE, soft-limited), 12 dB HP,
//             12 dB BP (zero-delay state-variable); CUTOFF, RESONANCE, SATURATION, KEY track, ENV amount,
//             VELOCITY; its own ADSR
//   AMP       ADSR, GAIN, VELOCITY
//   LFO 1 / 2 sine, triangle, saw, square, S&H; RATE free (Hz) or SYNC to the project tempo; AMOUNT;
//             DEST: pitch, OSC 2 pitch, filter, amp, pan, FM, pulse width; KEY restarts it on every note
//   VOICE     POLY / MONO / LEGATO, VOICES (1-16), UNISON (1-8 voices per note, DETUNE, SPREAD - the unison
//             voices come out of the VOICES pool), PORTAMENTO, BEND range, mod WHEEL destination
//   ARP       the GFX arpeggiator: MODE, RANGE (1-4 octaves), RATE (1/4 - 1/32, triplets), GATE; tempo-locked
//   EFFECTS   DIST (drive or bit crush), PHASER, CHORUS / FLANGER, stereo tempo-synced DELAY (ping-pong)
//   MASTER    DRIFT, VOLUME, SAT and the OUT stage (OFF / CLIP / LIMIT)
// DRIFT (GFX instrument standard, 0-100 %): the tuning wanders, OSC 2 wanders against OSC 1, the filter
//   cutoff wanders, the chorus / phaser speed breathes, and every note lands slightly differently in tune.
// MIDI: pitch bend (BEND range), CC1 mod wheel (WHEEL destination), CC64 sustain, CC120 / CC123 all notes off.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-voice.jsfx-inc
import gfx-arp.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

// ---------- OSC 1 ----------
slider1:2<0,4,1{Sine,Triangle,Saw,Square,Noise}>-Osc 1 wave
slider2:0<0,1,1{Sine,Square}>-Sub wave
slider3:0<0,100,1>-Sub level (%)
slider4:0<0,100,1>-FM (osc 2 > osc 1, %)
// ---------- OSC 2 ----------
slider5:2<0,4,1{Sine,Triangle,Saw,Square,Noise}>-Osc 2 wave
slider6:0<-24,24,1>-Osc 2 pitch (st)
slider7:8<-50,50,0.1>-Osc 2 fine (cents)
slider8:1<0,1,1{Off,On}>-Osc 2 track
slider9:0<0,1,1{Off,On}>-Osc 2 sync
slider10:0<0,100,1>-Ring (%)
slider11:50<0,100,1>-Osc mix (1 <> 2, %)
slider12:50<5,95,1>-Pulse width (%)
// ---------- MOD ENV ----------
slider13:1<0.5,5000,0.1>-Mod env attack (ms)
slider14:300<5,5000,1>-Mod env decay (ms)
slider15:0<-100,100,1>-Mod env amount (%)
slider16:0<0,2,1{Osc 2 pitch,FM,Pulse width}>-Mod env destination
// ---------- FILTER ----------
slider17:1<0,3,1{LP 12,LP 24,HP 12,BP 12}>-Filter type
slider18:6000<20,20000,1>-Cutoff (Hz)
slider19:10<0,100,1>-Resonance (%)
slider20:0<0,100,1>-Filter saturation (%)
slider21:50<0,100,1>-Key track (%)
slider22:0<-100,100,1>-Filter env amount (%)
slider23:0<0,100,1>-Filter velocity (%)
slider24:1<0.5,5000,0.1>-Filter attack (ms)
slider25:400<5,8000,1>-Filter decay (ms)
slider26:50<0,100,1>-Filter sustain (%)
slider27:300<5,8000,1>-Filter release (ms)
// ---------- AMP ----------
slider28:1<0.5,5000,0.1>-Amp attack (ms)
slider29:300<5,8000,1>-Amp decay (ms)
slider30:100<0,100,1>-Amp sustain (%)
slider31:200<5,8000,1>-Amp release (ms)
slider32:0<-24,12,0.1>-Amp gain (dB)
slider33:50<0,100,1>-Amp velocity (%)
// ---------- LFO 1 ----------
slider34:0<0,4,1{Sine,Triangle,Saw,Square,S&H}>-LFO 1 shape
slider35:5<0.02,30,0.01>-LFO 1 rate (Hz)
slider36:0<0,1,1{Free,Sync}>-LFO 1 sync
slider37:5<0,11,1{4/1,2/1,1/1,1/2,1/2T,1/4,1/4T,1/8,1/8T,1/16,1/16T,1/32}>-LFO 1 synced rate
slider38:0<0,100,1>-LFO 1 amount (%)
slider39:2<0,6,1{Pitch,Osc 2 pitch,Filter,Amp,Pan,FM,Pulse width}>-LFO 1 destination
slider40:0<0,1,1{Off,On}>-LFO 1 key sync
// ---------- LFO 2 ----------
slider41:1<0,4,1{Sine,Triangle,Saw,Square,S&H}>-LFO 2 shape
slider42:0.5<0.02,30,0.01>-LFO 2 rate (Hz)
slider43:0<0,1,1{Free,Sync}>-LFO 2 sync
slider44:5<0,11,1{4/1,2/1,1/1,1/2,1/2T,1/4,1/4T,1/8,1/8T,1/16,1/16T,1/32}>-LFO 2 synced rate
slider45:0<0,100,1>-LFO 2 amount (%)
slider46:0<0,6,1{Pitch,Osc 2 pitch,Filter,Amp,Pan,FM,Pulse width}>-LFO 2 destination
slider47:0<0,1,1{Off,On}>-LFO 2 key sync
// ---------- VOICE ----------
slider48:0<0,2,1{Poly,Mono,Legato}>-Voice mode
slider49:8<1,16,1>-Voices
slider50:1<1,8,1>-Unison voices
slider51:15<0,50,0.1>-Unison detune (cents)
slider52:60<0,100,1>-Unison spread (%)
slider53:0<0,2000,1>-Portamento (ms)
slider54:2<0,24,1>-Pitch bend range (st)
slider55:1<0,4,1{Off,Vibrato,LFO 1 amount,Cutoff,FM}>-Mod wheel destination
// ---------- ARP ----------
slider56:0<0,1,1{Off,On}>-Arp
slider57:0<0,6,1{Up,Down,Up-Down,Down-Up,As played,Random,Chord}>-Arp mode
slider58:1<1,4,1>-Arp range (octaves)
slider59:4<0,6,1{1/4,1/4T,1/8,1/8T,1/16,1/16T,1/32}>-Arp rate
slider60:60<10,200,1>-Arp gate (%)
// ---------- EFFECTS ----------
slider61:0<0,1,1{Off,On}>-Distortion
slider62:0<0,1,1{Drive,Crush}>-Distortion type
slider63:30<0,100,1>-Distortion amount (%)
slider64:0<0,1,1{Off,On}>-Phaser
slider65:0.4<0.05,10,0.01>-Phaser rate (Hz)
slider66:60<0,100,1>-Phaser depth (%)
slider67:0<0,1,1{Off,On}>-Chorus
slider68:0<0,1,1{Chorus,Flanger}>-Chorus type
slider69:0.6<0.05,10,0.01>-Chorus rate (Hz)
slider70:50<0,100,1>-Chorus depth (%)
slider71:0<0,1,1{Off,On}>-Delay
slider72:4<0,7,1{1/2,1/4D,1/4,1/4T,1/8D,1/8,1/8T,1/16}>-Delay time
slider73:35<0,90,1>-Delay feedback (%)
slider74:25<0,100,1>-Delay mix (%)
slider75:1<0,1,1{Off,On}>-Delay ping-pong
// ---------- MASTER ----------
slider76:25<0,100,1>-Drift (%)
slider77:0<-24,6,0.1>-Volume (dB)
slider78:0<0,16,1>-MIDI channel (0 = omni)
slider79:0<0,100,1>-Band sat (%)
slider80:30<0,100,1>-Bias (%)
slider81:120<40,400,1>-Sat low band (Hz)
slider82:6000<2000,16000,10>-Sat high band (Hz)
slider83:-0.3<-24,0,0.1>-Ceiling / limit threshold (dB)
slider84:1<0,2,1{Off,Clip,Limit}>-Output stage

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-daichi";                                  // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();   // 20000 - 24095
arp_init(30000);                                           // 30000 - 34095
DV  = 40000;                                               // 16 voices x 64 slots
DHN = 41100;                                               // mono held-note stack (128)
DQO = 41300; DQT = 41600; DQN = 41900; DQV = 42200;        // note event queue (300 each)
DLEV = 42600; DACC = 42620; DTIE = 42640;                  // arp pattern: every step on
DEFM = 42700;                                              // the Init values of sliders 1-75
DTMP = 42800;                                              // preset parser scratch (400)
DCHL = 44000; DCHR = 52192; DCHM = 8191;                   // chorus / flanger lines (8192 each)
DDLL = 61000; DDLR = 61000 + 524288; DDLM = 524287;        // delay lines (2^19 each)
memset(DV, 0, 1024);
dh_i = 0; loop(16, DLEV[dh_i] = 1; DACC[dh_i] = 0; DTIE[dh_i] = 0; dh_i += 1; );
arp_pattern(DLEV, DACC, DTIE);
dh_i = 0; loop(16, DV[dh_i * 64] = -1; dh_i += 1; );
memset(DCHL, 0, 8192 * 2);
memset(DDLL, 0, 524288 * 2);

// voice slots (p = DV + 64 * voice):
//   0 note (-1 free)  1 key held  2 age  3 held by pedal  4 pitch now (st)  5 pitch target  6 velocity 0..1
//   7 note detune (st)  8 unison offset (st)  9 unison pan  10 osc 1 phase  11 osc 2 phase  12 sub phase
//   13 amp stage (0 idle, 1 att, 2 dec / sus, 3 rel)  14 amp level  15 filter env stage  16 its level
//   17 mod env stage (0 off, 1 att, 2 dec)  18 its level  19-22 filter states  23 osc 2 (one-sample delayed)
//   24 osc 1 inc  25 osc 2 inc  26-28 filter coefficients  29 pulse width  30 FM  31 / 32 pan gains L / R
//   33 osc 2 last output  34 voice gain  38 needs its control values now

L12 = log(2) / 12; LN2 = log(2);

// ---------- presets: the Init values, and each preset as "slider:value" changes from Init ----------
#dh_def = "2 0 0 0 2 0 8 1 0 0 50 50 1 300 0 0 1 6000 10 0 50 0 0 1 400 50 300 1 300 100 200 0 50 0 5 0 5 0 2 0 1 0.5 0 5 0 0 0 0 8 1 15 60 0 2 1 0 0 1 4 60 0 0 30 0 0.4 60 0 0 0.6 50 0 4 35 25 1";

// parse the numbers in s (separated by spaces or colons) into dst; returns the count
function dh_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
dh_nums(#dh_def, DEFM);

#dh_pm = "Init|Fat Saw Bass|Acid Line|FM Bass|Sub Bass|Sync Lead|Square Lead|Unison Lead|Soft Lead|PWM Strings|Warm Pad|Sweep Pad|Glass Pad|FM E-Piano|Bell Tines|Clav Pluck|Organ|Poly Brass|Brass Stab|Arp Pulse|Arp Glass|Chip Square|Chip Arp|Noise Sweep|Wind Riser|Laser Zap|Reso Pluck|Hoover|Bit Bass|Phase Keys|Fifth Lead|Dark Drone";
function dh_pstr(p) (
  p == 2  ? "1:2 5:2 6:-12 7:-9 11:45 3:40 17:1 18:420 19:22 22:55 24:1 25:380 26:25 27:160 28:0.5 29:600 30:85 31:120 49:1 48:2 53:30 50:2 51:9 52:30 20:30 32:-2" :
  p == 3  ? "1:2 5:3 11:0 17:1 18:300 19:78 20:45 22:70 21:30 24:0.5 25:220 26:0 27:120 28:0.5 29:300 30:90 31:80 48:2 49:1 53:60 23:30 32:-1" :
  p == 4  ? "1:0 5:0 6:12 7:0 11:0 4:45 15:-60 16:1 13:0.5 14:250 17:0 18:1800 19:0 22:30 25:300 26:20 3:30 2:0 28:0.5 29:700 30:60 31:150 48:1 49:1 32:1" :
  p == 5  ? "1:0 5:1 6:12 7:0 11:12 3:45 2:1 17:0 18:500 19:5 22:15 25:200 26:30 28:2 29:500 30:90 31:180 48:2 49:1 53:20 32:2" :
  p == 6  ? "1:2 5:2 9:1 6:7 11:100 15:45 16:0 13:0.5 14:900 17:1 18:5200 19:15 22:20 25:600 26:60 28:2 30:100 31:300 48:2 49:1 53:40 34:0 35:5.5 38:6 39:0 32:-3" :
  p == 7  ? "1:3 5:3 6:12 7:4 11:30 12:42 17:0 18:3600 19:20 22:25 25:500 26:55 28:2 31:250 48:2 49:1 53:50 34:1 35:5.2 38:7 39:0 41:0 42:0.3 45:20 46:6 32:-4" :
  p == 8  ? "1:2 5:2 6:0 7:12 11:50 17:1 18:7000 19:12 22:15 25:600 26:70 28:3 31:350 48:2 49:16 50:7 51:22 52:90 53:35 67:1 68:0 69:0.4 70:40 71:1 72:5 73:30 74:22 32:-5" :
  p == 9  ? "1:1 5:0 6:12 7:0 11:25 17:0 18:2600 19:5 22:25 24:20 25:800 26:40 28:25 29:500 30:90 31:400 48:2 49:1 53:80 34:0 35:5 38:6 39:0 71:1 72:4 73:40 74:25" :
  p == 10 ? "1:3 5:3 6:0 7:10 11:50 12:35 17:0 18:3500 19:8 22:10 24:300 25:900 26:80 27:900 28:350 29:600 30:90 31:900 34:1 35:0.7 38:55 39:6 41:1 42:0.45 45:40 46:6 67:1 69:0.5 70:60 49:8 32:-6" :
  p == 11 ? "1:2 5:2 6:0 7:12 11:50 17:1 18:1400 19:15 22:20 24:900 25:2500 26:60 27:2500 28:800 29:1500 30:85 31:2500 34:0 35:0.3 38:15 39:2 49:8 67:1 69:0.35 70:55 71:1 72:2 73:45 74:20 3:20 32:-6" :
  p == 12 ? "1:2 5:3 6:7 7:6 11:45 12:30 17:1 18:300 19:45 22:65 24:2500 25:5000 26:30 27:3000 28:1200 29:2000 30:90 31:3000 34:1 35:0.12 38:30 39:2 41:0 42:0.25 45:20 46:6 49:8 64:1 65:0.15 66:70 71:1 72:1 73:50 74:25 32:-7" :
  p == 13 ? "1:0 5:1 6:19 7:5 11:40 10:30 17:2 18:220 19:20 22:0 28:600 29:2000 30:80 31:2500 34:0 35:4.5 38:10 39:6 41:0 42:0.2 45:25 46:1 49:8 67:1 69:0.3 70:50 71:1 72:1 73:50 74:30 32:-2" :
  p == 14 ? "1:0 5:0 6:12 7:3 11:0 4:28 15:35 16:1 13:0.5 14:900 17:0 18:9000 19:0 28:0.5 29:2200 30:25 31:700 33:70 49:12 64:1 65:0.6 66:40 67:1 69:0.8 70:35 32:1" :
  p == 15 ? "1:0 5:0 6:28 7:14 11:0 4:35 15:40 16:1 13:0.5 14:1500 17:0 18:12000 19:0 28:0.5 29:3500 30:0 31:3000 33:60 49:12 71:1 72:2 73:35 74:22 32:2" :
  p == 16 ? "1:3 5:2 6:12 7:0 11:35 12:22 17:3 18:900 19:35 22:60 24:0.5 25:180 26:0 27:120 28:0.5 29:400 30:0 31:150 33:60 49:8 64:1 65:0.8 66:35 32:2" :
  p == 17 ? "1:0 5:0 6:12 7:0 11:45 3:60 2:0 17:0 18:9000 19:0 21:0 28:0.5 29:300 30:100 31:60 34:0 35:6.5 38:4 39:0 49:10 67:1 68:0 69:5.8 70:30 33:0 32:-4" :
  p == 18 ? "1:2 5:2 6:0 7:9 11:50 17:1 18:600 19:10 22:55 24:60 25:600 26:45 27:400 23:40 28:40 29:500 30:85 31:350 34:0 35:5 38:4 39:0 49:8 67:1 69:0.5 70:30 32:-5" :
  p == 19 ? "1:2 5:3 6:0 7:7 11:40 12:40 17:1 18:500 19:18 22:70 24:0.5 25:280 26:15 27:200 23:50 28:0.5 29:350 30:30 31:220 49:8 50:2 51:10 52:70 32:-4" :
  p == 20 ? "1:3 5:2 6:12 7:0 11:30 12:30 17:1 18:700 19:45 22:55 24:0.5 25:200 26:0 27:150 28:0.5 29:250 30:0 31:200 56:1 57:0 58:2 59:4 60:55 71:1 72:4 73:40 74:25 41:1 42:0.1 45:35 46:2 32:-2" :
  p == 21 ? "1:0 5:1 6:19 7:0 11:35 4:20 17:0 18:6000 19:10 28:0.5 29:500 30:0 31:400 56:1 57:2 58:3 59:4 60:70 71:1 72:3 73:50 74:30 67:1 70:40 32:-1" :
  p == 22 ? "1:3 5:3 6:12 7:0 11:20 12:25 17:0 18:20000 19:0 21:0 28:0.5 30:100 31:40 48:1 49:1 34:3 35:12 38:0 53:0 41:3 42:7 45:0 32:-8" :
  p == 23 ? "1:3 5:3 6:12 7:0 11:0 12:50 17:0 18:20000 19:0 21:0 28:0.5 29:150 30:0 31:60 56:1 57:2 58:3 59:6 60:50 32:-7" :
  p == 24 ? "1:4 5:4 11:0 17:3 18:200 19:55 21:0 22:100 24:3000 25:4000 26:0 27:1500 28:200 29:5000 30:0 31:1500 34:0 35:0.25 38:30 39:4 64:1 65:0.2 66:80 71:1 72:2 73:55 74:30 32:-3" :
  p == 25 ? "1:4 5:4 11:0 17:0 18:400 19:60 21:0 22:90 24:5000 25:8000 26:100 27:3000 28:4000 29:8000 30:100 31:3000 41:0 42:0.08 45:40 46:2 34:4 35:8 38:12 39:2 64:1 65:0.1 66:70 32:-4" :
  p == 26 ? "1:2 5:0 6:24 11:30 15:-100 16:0 13:0.5 14:180 4:30 17:1 18:3000 19:60 22:60 24:0.5 25:200 26:0 27:150 28:0.5 29:200 30:0 31:200 71:1 72:6 73:45 74:30 32:-5" :
  p == 27 ? "1:2 5:3 6:12 7:0 11:30 17:0 18:400 19:75 22:65 24:0.5 25:280 26:0 27:250 23:40 28:0.5 29:500 30:0 31:400 49:8 71:1 72:4 73:35 74:25 32:-3" :
  p == 28 ? "1:3 5:2 6:-12 7:0 11:50 12:20 17:1 18:1500 19:20 20:40 22:25 25:500 26:60 49:8 50:4 51:30 52:80 53:120 48:2 41:0 42:0.5 45:30 46:6 34:0 35:4.5 38:4 39:0 67:1 68:0 69:0.7 70:60 32:-5" :
  p == 29 ? "1:3 5:3 6:12 7:0 11:25 12:50 17:1 18:1200 19:25 22:45 24:0.5 25:300 26:20 27:120 28:0.5 29:400 30:70 31:100 48:2 49:1 61:1 62:1 63:55 3:30 2:1 32:-3" :
  p == 30 ? "1:2 5:1 6:12 7:0 11:30 17:0 18:3000 19:20 22:30 25:900 26:30 28:2 29:1200 30:40 31:600 49:8 64:1 65:0.35 66:75 71:1 72:4 73:30 74:20 32:-3" :
  p == 31 ? "1:2 5:2 6:7 7:4 11:45 17:1 18:3800 19:18 22:20 25:500 26:60 28:2 31:300 48:2 49:1 53:60 34:0 35:5.6 38:6 39:0 71:1 72:5 73:30 74:20 32:-4" :
  p == 32 ? "1:2 5:2 6:-12 7:7 11:50 3:50 2:0 17:1 18:180 19:40 20:35 21:0 22:15 24:2000 25:5000 26:60 27:3000 28:3000 29:5000 30:100 31:4000 34:0 35:0.07 38:25 39:2 41:2 42:0.15 45:10 46:1 49:4 64:1 65:0.07 66:60 71:1 72:0 73:45 74:20 32:-4" :
  "";
);
function load_preset(p) local(n, i) (
  i = 0; loop(75, slider(i + 1) = DEFM[i]; i += 1; );
  n = dh_nums(dh_pstr(p), DTMP);
  i = 0; loop(floor(n / 2), DTMP[i * 2] >= 1 && DTMP[i * 2] <= 75 ? slider(DTMP[i * 2]) = DTMP[i * 2 + 1]; i += 1; );
  i = 1; loop(75, ui_auto(i); i += 1; );
  pr_cur = p; dh_panic = 1;
);

// ---------- voices ----------
function dh_vrel(p) ( p[1] = 0; p[3] = 0; p[13] > 0 ? p[13] = 3; p[15] > 0 ? p[15] = 3; );
function dh_vstart(p, n, v, retrig, udet, upan, from) (
  p[13] == 0 ? (
    // a fresh voice: free-running phases (random, so unison and chords never line up), clean filter
    p[10] = rand(1); p[11] = rand(1); p[12] = rand(1); p[23] = 0; p[33] = 0;
    p[19] = p[20] = p[21] = p[22] = 0; p[14] = 0; p[16] = 0; p[18] = 0;
    p[4] = from;                                     // PORTAMENTO glides in from the last note played
  );
  dh_pc >= 1 ? p[4] = n;                             // no portamento: straight to the note
  p[0] = n; p[1] = 1; p[3] = 0; p[5] = n; p[6] = v / 127;
  p[8] = udet; p[9] = upan;
  retrig || p[13] == 0 || p[13] == 3 ? (
    p[7] = log(ins_note_detune()) / log(2) * 12;
    p[13] = 1; p[15] = 1; p[17] = 1;
  );
  p[34] = dh_gain * (1 - dh_avel + dh_avel * p[6]) * dh_uscl;
  p[38] = 1;
);
function dh_alloc() local(i, p, best, ba) (
  best = -1;
  i = 0; loop(dh_nv, p = DV + i * 64; p[13] == 0 && (best < 0 || p[2] < ba) ? ( best = i; ba = p[2]; ); i += 1; );
  best < 0 ? ( i = 0; loop(dh_nv, p = DV + i * 64; !p[1] && (best < 0 || p[2] < ba) ? ( best = i; ba = p[2]; ); i += 1; ); );
  best < 0 ? ( i = 0; loop(dh_nv, p = DV + i * 64; best < 0 || p[2] < ba ? ( best = i; ba = p[2]; ); i += 1; ); );
  DV + best * 64;
);
function dh_upos(k) ( dh_un > 1 ? k / (dh_un - 1) * 2 - 1 : 0; );
function dh_poly_on(n, v) local(i, p, k, from) (
  i = 0; loop(16, p = DV + i * 64; p[0] == n && p[1] ? dh_vrel(p); i += 1; );   // the same key again: a fresh note
  from = dh_last >= 0 && dh_porta > 0 ? dh_last : n;
  k = 0;
  loop(dh_un,
    p = dh_alloc();
    dh_age += 1; p[2] = dh_age;
    dh_vstart(p, n, v, 1, dh_upos(k) * dh_udet, dh_upos(k) * dh_uspr, from);
    k += 1;
  );
);
function dh_poly_off(n) local(i, p) (
  i = 0; loop(16, p = DV + i * 64; p[0] == n && p[1] ? ( dh_pedal ? p[3] = 1 : dh_vrel(p); ); i += 1; );
);
function dh_mono_go(n, v, retrig) local(k, p) (
  k = 0;
  loop(dh_un,
    p = DV + k * 64;
    dh_age += 1; p[2] = dh_age;
    dh_vstart(p, n, v, retrig, dh_upos(k) * dh_udet, dh_upos(k) * dh_uspr, p[13] > 0 ? p[4] : (dh_last >= 0 && dh_porta > 0 ? dh_last : n));
    k += 1;
  );
);
function dh_mono_on(n, v) local(i, f, held) (
  held = dh_hc > 0;
  f = -1; i = 0; loop(dh_hc, DHN[i] == n ? f = i; i += 1; );
  f >= 0 ? ( i = f; loop(dh_hc - f - 1, DHN[i] = DHN[i + 1]; i += 1; ); dh_hc -= 1; );
  dh_hc < 127 ? ( DHN[dh_hc] = n; dh_hc += 1; );
  dh_mono_go(n, v, !(held && dh_mode == 2));
);
function dh_mono_off(n) local(i, f, k, p) (
  f = -1; i = 0; loop(dh_hc, DHN[i] == n ? f = i; i += 1; );
  f >= 0 ? (
    i = f; loop(dh_hc - f - 1, DHN[i] = DHN[i + 1]; i += 1; ); dh_hc -= 1;
    dh_hc > 0 ? (
      // back to the note still held, without a new attack
      k = 0; loop(dh_un, p = DV + k * 64; p[0] = DHN[dh_hc - 1]; p[5] = p[0]; dh_pc >= 1 ? p[4] = p[0]; k += 1; );
    ) : (
      k = 0; loop(dh_un, p = DV + k * 64; dh_pedal ? p[3] = 1 : dh_vrel(p); k += 1; );
    );
  );
);
function dh_note_on(n, v) (
  ins_midi_hit();
  (dh_mode == 0 || dh_hc == 0 || dh_mode == 1) ? ( dh_k1 ? dh_l1ph = 0; dh_k2 ? dh_l2ph = 0; );
  dh_mode ? dh_mono_on(n, v) : dh_poly_on(n, v);
  dh_last = n;
);
function dh_note_off(n) ( dh_mode ? dh_mono_off(n) : dh_poly_off(n); );
function dh_all_off() local(i, p) (
  i = 0; loop(16, p = DV + i * 64; p[1] ? dh_vrel(p); p[0] = -1; i += 1; );
  dh_hc = 0;
);
function dh_pedal_up() local(i, p) ( i = 0; loop(16, p = DV + i * 64; p[3] ? dh_vrel(p); i += 1; ); );
function dh_qpush(ofs, t, n, v) local(i) (
  dh_qc < 300 ? (
    i = dh_qc; while (i > 0 && DQO[i - 1] > ofs) ( DQO[i] = DQO[i - 1]; DQT[i] = DQT[i - 1]; DQN[i] = DQN[i - 1]; DQV[i] = DQV[i - 1]; i -= 1; );
    DQO[i] = ofs; DQT[i] = t; DQN[i] = n; DQV[i] = v; dh_qc += 1;
  );
);

// ---------- names, rates ----------
function dh_lfo_beats(r) ( r == 0 ? 16 : r == 1 ? 8 : r == 2 ? 4 : r == 3 ? 2 : r == 4 ? 4 / 3 : r == 5 ? 1 : r == 6 ? 2 / 3 :
                          r == 7 ? 0.5 : r == 8 ? 1 / 3 : r == 9 ? 0.25 : r == 10 ? 1 / 6 : 0.125; );
function dh_arp_beats(r) ( r == 0 ? 1 : r == 1 ? 2 / 3 : r == 2 ? 0.5 : r == 3 ? 1 / 3 : r == 4 ? 0.25 : r == 5 ? 1 / 6 : 0.125; );
function dh_dly_beats(r) ( r == 0 ? 2 : r == 1 ? 1.5 : r == 2 ? 1 : r == 3 ? 2 / 3 : r == 4 ? 0.75 : r == 5 ? 0.5 : r == 6 ? 1 / 3 : 0.25; );

// LFO value for a shape at phase ph (s&h: the held value)
function dh_lfov(sh, ph, hv) (
  sh == 0 ? sin(2 * $pi * ph) : sh == 1 ? 1 - 4 * abs(ph - 0.5) : sh == 2 ? 2 * ph - 1 : sh == 3 ? (ph < 0.5 ? 1 : -1) : hv;
);
// adds one LFO's contribution to the modulation sums
function dh_lfo_to(v, d, a) (
  d == 0 ? dh_pmod += v * 12 * a * a :
  d == 1 ? dh_l2p += v * 24 * a * a :
  d == 2 ? dh_loct += v * 4 * a :
  d == 3 ? dh_trem *= 1 - a * (0.5 - 0.5 * v) :
  d == 4 ? dh_lpan += v * a :
  d == 5 ? dh_lfm += v * a * 0.75 :
           dh_lpw += v * a * 0.45;
);

// ---------- parameters ----------
function dh_c4(c) ( 1 - (1 - c) ^ 4; );
function update() local(r, g) (
  dh_w1 = slider1; dh_subw = slider2; dh_sub = slider3 / 100 * 0.8;
  dh_fm = sqr(slider4 / 100) * 1.5;
  dh_w2 = slider5; dh_o2st = slider6 + slider7 / 100; dh_trk = slider8; dh_sync = slider9;
  dh_ring = slider10 / 100; r = slider11 / 100;
  dh_m1 = (1 - r) * (1 - dh_ring); dh_m2 = r * (1 - dh_ring);
  dh_pw = slider12 / 100;
  dh_ma4 = dh_c4(vo_coef(slider13)); dh_md4 = dh_c4(vo_coef(slider14)); dh_mamt = slider15 / 100; dh_mdst = slider16;
  dh_ft = slider17; dh_cut = slider18; dh_res = slider19 / 100;
  dh_k = 2 - 1.985 * dh_res;                         // state-variable damping (12 dB types)
  dh_lk = dh_res * 4.15;                             // ladder feedback (24 dB): self-oscillates near the top
  dh_sat = slider20 / 100; dh_sg = 1 + dh_sat * 5; dh_sn = 1 / (1 + dh_sat * 1.6);
  dh_key = slider21 / 100; dh_fenv = slider22 / 100; dh_fvel = slider23 / 100;
  dh_fa4 = dh_c4(vo_coef(slider24)); dh_fd4 = dh_c4(vo_coef(slider25)); dh_fs = slider26 / 100; dh_fr4 = dh_c4(vo_coef(slider27));
  dh_aa = vo_coef(slider28); dh_ad = vo_coef(slider29); dh_as = slider30 / 100; dh_ar = vo_coef(slider31);
  dh_gain = 10 ^ (slider32 / 20) * 0.62; dh_avel = slider33 / 100;
  dh_l1s = slider34; dh_l1a = slider38 / 100; dh_l1d = slider39; dh_k1 = slider40;
  dh_l1b = dh_lfo_beats(slider37); dh_l1y = slider36;
  dh_l2s = slider41; dh_l2a = slider45 / 100; dh_l2d = slider46; dh_k2 = slider47;
  dh_l2b = dh_lfo_beats(slider44); dh_l2y = slider43;
  dh_tmp = tempo > 0 ? tempo : 120;
  dh_l1r = dh_l1y ? dh_tmp / 60 / dh_l1b : slider35;
  dh_l2r = dh_l2y ? dh_tmp / 60 / dh_l2b : slider42;
  dh_mode = slider48; dh_nv = max(1, min(16, floor(slider49 + 0.5)));
  dh_un = min(max(1, floor(slider50 + 0.5)), dh_nv); dh_uscl = 1 / sqrt(dh_un);
  dh_udet = slider51 / 100; dh_uspr = slider52 / 100;
  dh_porta = slider53; dh_pc = slider53 > 0 ? dh_c4(vo_coef(slider53)) : 1;
  dh_brng = slider54; dh_mwd = slider55;
  dh_dist = slider61; dh_dtyp = slider62; dh_damt = slider63 / 100;
  dh_dg = 1 + 30 * dh_damt * dh_damt; dh_dl = 1 / (1 + 0.9 * sqrt(dh_damt * 3));
  dh_bits = 2 ^ (12 - 9 * dh_damt); dh_hr = 1 / (1 + 15 * dh_damt * dh_damt);
  dh_phs = slider64; dh_phr = slider65; dh_phd = slider66 / 100;
  dh_cho = slider67; dh_chf = slider68; dh_chr = slider69; dh_chd = slider70 / 100;
  dh_dly = slider71; dh_dlb = dh_dly_beats(slider72); dh_dfb = slider73 / 100; dh_dmx = slider74 / 100; dh_dpp = slider75;
  dh_dlt = min(dh_dlb * 60 / dh_tmp * srate, DDLM - 4);
  dh_drift = slider76 / 100; dh_volt = 10 ^ (slider77 / 20); dh_chan = slider78;
  dh_fmax = srate * 0.45; dh_pis = $pi / srate; dh_440s = 440 / srate;
  ins_output_setup(79);
);

ins_drift_init();
dh_bend = 0; dh_mw = 0; dh_pedal = 0; dh_hc = 0; dh_age = 0; dh_last = -1; dh_qc = 0;
dh_wasarp = 0; dh_lastmode = -1; dh_ct = 0; dh_l1ph = dh_l2ph = 0; dh_l1h = dh_l2h = 0;
dh_dcxl = dh_dcyl = dh_dcxr = dh_dcyr = 0; dh_vol = 1; dh_wp = 0; dh_cwp = 0; dh_dts = -1;
dh_wasdly = 0; dh_wascho = 0; dh_phph = 0; dh_chph = 0; dh_vph = 0; dh_hold = 0; dh_holdr = 0; dh_hcnt = 0;
dh_sm = 1 - exp(-1 / (0.03 * srate));
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );            // a new instance opens Large, on Init
update();
dh_vol = dh_volt;
ui_dflt = 1;

@slider
update();

@block
dh_treq > 0 ? ( load_preset(dh_treq); dh_treq = 0; );     // a preset asked for from outside the panel (test hook)
update();
arp_params(slider57, dh_arp_beats(slider59), slider58, slider60 / 100, 0, 16, 0, 1, 0, 0, 0, 100, 0);

// MIDI in: notes go to the arp when it is on, otherwise into the queue (sample-accurate)
dh_qc = 0;
while (midirecv(mofs, m1, m2, m3)) (
  ins_chan_ok(m1, dh_chan) ? (
    dh_st = m1 & 0xF0;
    dh_st == 0x90 || dh_st == 0x80 ? (
      slider56 ? arp_key(m2, m3, 0, dh_st == 0x90 && m3 > 0) : dh_qpush(mofs, dh_st == 0x90 && m3 > 0, m2, m3);
      dh_st == 0x90 && m3 > 0 ? ins_midi_hit();
    ) :
    dh_st == 0xE0 ? dh_bend = (((m3 * 128 + m2) - 8192) / 8192) * dh_brng :
    dh_st == 0xB0 ? (
      m2 == 1 ? dh_mw = m3 / 127 :
      m2 == 64 ? ( dh_pedal = m3 >= 64; !dh_pedal ? dh_qpush(mofs, 2, 0, 0); ) :
      m2 == 123 || m2 == 120 ? dh_qpush(mofs, 3, 0, 0);
    );
  );
);
!slider56 && dh_wasarp ? ( arp_outn = 0; arp_flush(); arp_sn = 0; arp_pn = 0; dh_qpush(0, 3, 0, 0); );
slider56 && !dh_wasarp ? dh_qpush(0, 3, 0, 0);
dh_wasarp = slider56;
dh_mode != dh_lastmode ? ( dh_qpush(0, 3, 0, 0); dh_lastmode = dh_mode; );
slider56 ? (
  arp_block(play_state & 1, beat_position, dh_tmp, samplesblock);
  dh_i = 0; loop(arp_outn, dh_qpush(arp_out_ofs[dh_i], arp_out_on[dh_i], arp_out_note[dh_i], arp_out_vel[dh_i]); dh_i += 1; );
);
dh_panic ? ( dh_all_off(); dh_panic = 0; );
// fewer VOICES than are sounding: let the extra ones go
dh_i = dh_nv; loop(16 - dh_nv, dh_p = DV + dh_i * 64; dh_p[1] ? dh_vrel(dh_p); dh_i += 1; );
dh_eqi = 0; dh_spos = 0;

// synced LFOs follow the project's beat while it plays (unless KEY restarts them)
play_state & 1 ? (
  dh_l1y && !dh_k1 ? ( dh_l1ph = beat_position / dh_l1b; dh_l1ph -= floor(dh_l1ph); );
  dh_l2y && !dh_k2 ? ( dh_l2ph = beat_position / dh_l2b; dh_l2ph -= floor(dh_l2ph); );
);
// effects switched on: start from clean lines
dh_dly && !dh_wasdly ? ( memset(DDLL, 0, 524288 * 2); dh_dts = -1; ); dh_wasdly = dh_dly;
dh_cho && !dh_wascho ? memset(DCHL, 0, 8192 * 2); dh_wascho = dh_cho;
dh_dts < 0 ? dh_dts = dh_dlt;

ins_drift_block(dh_drift, samplesblock);
dh_dps = 12 * log(ins_pitch) / LN2;                 // drift as semitones

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@sample
while (dh_eqi < dh_qc && DQO[dh_eqi] <= dh_spos) (
  dh_et = DQT[dh_eqi];
  dh_et == 1 ? dh_note_on(DQN[dh_eqi], DQV[dh_eqi]) : dh_et == 0 ? dh_note_off(DQN[dh_eqi]) : dh_et == 2 ? dh_pedal_up() : dh_all_off();
  dh_eqi += 1;
);
dh_spos += 1;

// ---------- control rate (every 4 samples): LFOs and the modulation sums ----------
dh_ct += 1;
dh_tick = dh_ct >= 4;
dh_tick ? (
  dh_ct = 0;
  dh_l1ph += dh_l1r * 4 / srate; dh_l1ph >= 1 ? ( dh_l1ph -= floor(dh_l1ph); dh_l1h = rand(2) - 1; );
  dh_l2ph += dh_l2r * 4 / srate; dh_l2ph >= 1 ? ( dh_l2ph -= floor(dh_l2ph); dh_l2h = rand(2) - 1; );
  dh_l1 = dh_lfov(dh_l1s, dh_l1ph, dh_l1h);
  dh_l2 = dh_lfov(dh_l2s, dh_l2ph, dh_l2h);
  dh_pmod = dh_bend + dh_dps; dh_l2p = ins_aux; dh_loct = ins_cut; dh_trem = 1; dh_lpan = 0; dh_lfm = 0; dh_lpw = 0;
  dh_lfo_to(dh_l1, dh_l1d, dh_mwd == 2 ? dh_l1a + dh_mw * (1 - dh_l1a) : dh_l1a);
  dh_lfo_to(dh_l2, dh_l2d, dh_l2a);
  dh_mwd == 1 ? ( dh_vph += 5.5 * 4 / srate; dh_vph -= floor(dh_vph); dh_pmod += sin(2 * $pi * dh_vph) * dh_mw * 0.5; ) :
  dh_mwd == 3 ? dh_loct += dh_mw * 3 :
  dh_mwd == 4 ? dh_lfm += dh_mw * 0.8;
  dh_coct = 0;
);

// ---------- the voices ----------
dh_L = dh_R = 0;
dh_p = DV;
loop(16,
  dh_p[13] > 0 ? (
    (dh_tick || dh_p[38]) ? (
      dh_p[38] = 0;
      dh_p[4] += (dh_p[5] - dh_p[4]) * dh_pc;
      // filter envelope and mod envelope (control rate)
      dh_e = dh_p[16];
      dh_p[15] == 1 ? ( dh_e += (1.3 - dh_e) * dh_fa4; dh_e >= 1 ? ( dh_e = 1; dh_p[15] = 2; ); ) :
      dh_p[15] == 2 ? dh_e += (dh_fs - dh_e) * dh_fd4 :
      dh_p[15] == 3 ? dh_e -= dh_e * dh_fr4;
      dh_p[16] = dh_e;
      dh_m = dh_p[18];
      dh_p[17] == 1 ? ( dh_m += (1.3 - dh_m) * dh_ma4; dh_m >= 1 ? ( dh_m = 1; dh_p[17] = 2; ); ) :
      dh_p[17] == 2 ? dh_m -= dh_m * dh_md4;
      dh_p[18] = dh_m; dh_m *= dh_mamt;
      // pitch
      dh_b = dh_p[4] + dh_p[7] + dh_p[8] + dh_pmod;
      dh_p[24] = min(exp((dh_b - 69) * L12) * dh_440s, 0.45);
      dh_b2 = (dh_trk ? dh_b : 60 + dh_p[7] + dh_p[8] + dh_pmod) + dh_o2st + dh_l2p + (dh_mdst == 0 ? dh_m * 48 : 0);
      dh_p[25] = min(exp((dh_b2 - 69) * L12) * dh_440s, 0.45);
      // filter
      dh_v = dh_p[6];
      dh_o = dh_fenv * dh_e * (1 - dh_fvel + dh_fvel * dh_v) * 7 + dh_key * (dh_p[4] - 60) / 12 + dh_fvel * (dh_v - 0.7) * 1.5 + dh_loct;
      dh_g = tan(min(max(dh_cut * exp(dh_o * LN2), 16), dh_fmax) * dh_pis);
      dh_ft == 1 ? (
        dh_p[26] = dh_g / (1 + dh_g); dh_p[27] = 1 - dh_p[26]; dh_p[28] = sqr(sqr(dh_p[26]));
      ) : (
        dh_p[26] = 1 / (1 + dh_g * (dh_g + dh_k)); dh_p[27] = dh_g * dh_p[26]; dh_p[28] = dh_g * dh_p[27];
      );
      dh_p[29] = min(max(dh_pw + dh_lpw + (dh_mdst == 2 ? dh_m * 0.45 : 0), 0.03), 0.97);
      dh_p[30] = max(dh_fm + dh_lfm + (dh_mdst == 1 ? dh_m * 1.5 : 0), 0);
      dh_pn = min(max(dh_p[9] + dh_lpan, -1), 1);
      dh_p[31] = 1 - max(dh_pn, 0); dh_p[32] = 1 + min(dh_pn, 0);
    );

    // ----- OSC 1 (FM from OSC 2's last output) -----
    dh_i1 = dh_p[24]; dh_fmv = dh_p[30] * dh_p[33];
    dh_wr = 0;
    dh_w1 < 2 || dh_w1 == 4 ? (
      dh_ph = dh_p[10] + dh_i1; dh_ph >= 1 ? ( dh_ph -= 1; dh_wr = 1; dh_t = dh_ph / dh_i1; );
      dh_rp = dh_ph + dh_fmv * 0.5; dh_rp -= floor(dh_rp);
      dh_o1 = dh_w1 == 0 ? sin(2 * $pi * dh_rp) : dh_w1 == 1 ? 1 - 4 * abs(dh_rp - 0.5) : rand(2) - 1;
      dh_d = dh_i1;
    ) : (
      dh_d = min(max(dh_i1 * (1 + dh_fmv * 2), 0), 0.45);
      dh_ph = dh_p[10] + dh_d; dh_ph >= 1 ? ( dh_ph -= 1; dh_wr = 1; dh_t = dh_ph / dh_d; );
      dh_o1 = 2 * dh_ph - 1 - vo_blep(dh_ph, dh_d);
      dh_w1 == 3 ? ( dh_q = dh_ph + 1 - dh_p[29]; dh_q -= floor(dh_q); dh_o1 -= 2 * dh_q - 1 - vo_blep(dh_q, dh_d); );
    );
    dh_p[10] = dh_ph;
    // sub, one octave down
    dh_sub > 0 ? (
      dh_q = dh_p[12] + dh_i1 * 0.5; dh_q -= floor(dh_q); dh_p[12] = dh_q;
      dh_subw ? ( dh_r = dh_q + 0.5; dh_r -= floor(dh_r);
                  dh_su = (2 * dh_q - 1 - vo_blep(dh_q, dh_i1 * 0.5)) - (2 * dh_r - 1 - vo_blep(dh_r, dh_i1 * 0.5)); )
              : dh_su = sin(2 * $pi * dh_q);
    ) : dh_su = 0;

    // ----- OSC 2 (hard sync: band-limited by a step correction across the reset, one sample late) -----
    dh_i2 = dh_p[25]; dh_pw2 = dh_p[29];
    dh_sync && dh_wr ? (
      dh_q = dh_p[11] + dh_i2 * (1 - dh_t); dh_q -= floor(dh_q);           // where OSC 2 was when OSC 1 reset it
      dh_h = (dh_w2 == 0 ? 0 : dh_w2 == 1 ? -1 : dh_w2 == 2 ? -1 : dh_w2 == 3 ? 2 * dh_pw2 - 2 : 0)
           - (dh_w2 == 0 ? sin(2 * $pi * dh_q) : dh_w2 == 1 ? 1 - 4 * abs(dh_q - 0.5) : dh_w2 == 2 ? 2 * dh_q - 1 :
              dh_w2 == 3 ? (dh_q < dh_pw2 ? 2 * dh_pw2 - 2 : 2 * dh_pw2) : 0);
      dh_q = dh_i2 * dh_t;
      dh_o2n = dh_w2 == 0 ? sin(2 * $pi * dh_q) : dh_w2 == 1 ? 1 - 4 * abs(dh_q - 0.5) : dh_w2 == 2 ? 2 * dh_q - 1 :
               dh_w2 == 3 ? (dh_q < dh_pw2 ? 2 * dh_pw2 - 2 : 2 * dh_pw2) : rand(2) - 1;
      dh_o2 = dh_p[23] + dh_h * 0.5 * dh_t * dh_t;
      dh_p[23] = dh_o2n - dh_h * 0.5 * sqr(1 - dh_t);
    ) : (
      dh_q = dh_p[11] + dh_i2; dh_q -= floor(dh_q);
      dh_o2n = dh_w2 == 0 ? sin(2 * $pi * dh_q) : dh_w2 == 1 ? 1 - 4 * abs(dh_q - 0.5) :
               dh_w2 == 2 ? 2 * dh_q - 1 - vo_blep(dh_q, dh_i2) :
               dh_w2 == 3 ? ( dh_r = dh_q + 1 - dh_pw2; dh_r -= floor(dh_r);
                              (2 * dh_q - 1 - vo_blep(dh_q, dh_i2)) - (2 * dh_r - 1 - vo_blep(dh_r, dh_i2)); ) : rand(2) - 1;
      dh_o2 = dh_p[23]; dh_p[23] = dh_o2n;
    );
    dh_p[11] = dh_q; dh_p[33] = dh_o2;

    // ----- mix, saturation, filter -----
    dh_x = (dh_o1 * dh_m1 + dh_o2 * dh_m2 + dh_o1 * dh_o2 * dh_ring + dh_su * dh_sub) * 0.5;
    dh_sat > 0 ? dh_x = vo_tanh(dh_x * dh_sg) * dh_sn;
    dh_ft == 1 ? (
      // 24 dB: zero-delay ladder (four TPT one-poles), the feedback solved, the input soft-limited
      dh_G = dh_p[26]; dh_bb = dh_p[27];
      dh_y = (dh_p[28] * dh_x + dh_bb * (dh_G * (dh_G * (dh_G * dh_p[19] + dh_p[20]) + dh_p[21]) + dh_p[22])) / (1 + dh_lk * dh_p[28]);
      dh_u = dh_x - dh_lk * dh_y; dh_u = vo_tanh(dh_u * 0.8) * 1.25;
      dh_v = (dh_u - dh_p[19]) * dh_G; dh_y = dh_v + dh_p[19]; dh_p[19] = dh_y + dh_v;
      dh_v = (dh_y - dh_p[20]) * dh_G; dh_y = dh_v + dh_p[20]; dh_p[20] = dh_y + dh_v;
      dh_v = (dh_y - dh_p[21]) * dh_G; dh_y = dh_v + dh_p[21]; dh_p[21] = dh_y + dh_v;
      dh_v = (dh_y - dh_p[22]) * dh_G; dh_y = dh_v + dh_p[22]; dh_p[22] = dh_y + dh_v;
      dh_y *= 1 + dh_lk * 0.5;
    ) : (
      // 12 dB: zero-delay state-variable (low, high or band)
      dh_v3 = dh_x - dh_p[20]; dh_v1 = dh_p[26] * dh_p[19] + dh_p[27] * dh_v3; dh_v2 = dh_p[20] + dh_p[27] * dh_p[19] + dh_p[28] * dh_v3;
      dh_p[19] = 2 * dh_v1 - dh_p[19]; dh_p[20] = 2 * dh_v2 - dh_p[20];
      dh_y = dh_ft == 0 ? dh_v2 : dh_ft == 2 ? dh_x - dh_k * dh_v1 - dh_v2 : dh_v1 * sqrt(dh_k);
      abs(dh_p[19]) > 4 ? dh_p[19] = vo_tanh(dh_p[19] * 0.25) * 4;   // tames the ringing at full resonance
    );

    // ----- amp envelope -----
    dh_a = dh_p[14];
    dh_p[13] == 1 ? ( dh_a += (1.3 - dh_a) * dh_aa; dh_a >= 1 ? ( dh_a = 1; dh_p[13] = 2; ); ) :
    dh_p[13] == 2 ? dh_a += (dh_as - dh_a) * dh_ad :
    ( dh_a -= dh_a * dh_ar; dh_a < 0.00002 ? ( dh_a = 0; dh_p[13] = 0; dh_p[15] = 0; dh_p[17] = 0; dh_p[0] = -1; dh_p[19] = dh_p[20] = dh_p[21] = dh_p[22] = 0; ); );
    dh_p[14] = dh_a;
    dh_y *= dh_a * dh_p[34];
    dh_L += dh_y * dh_p[31]; dh_R += dh_y * dh_p[32];
  );
  dh_p += 64;
);
dh_L *= dh_trem; dh_R *= dh_trem;

// DC block (ring modulation and asymmetric drive can leave an offset)
dh_dcyl = dh_L - dh_dcxl + 0.9996 * dh_dcyl; dh_dcxl = dh_L; dh_L = dh_dcyl;
dh_dcyr = dh_R - dh_dcxr + 0.9996 * dh_dcyr; dh_dcxr = dh_R; dh_R = dh_dcyr;

// ---------- EFFECTS ----------
dh_dist ? (
  dh_dtyp == 0 ? (
    dh_L = (vo_tanh(dh_L * dh_dg + 0.12 * dh_damt) - vo_tanh(0.12 * dh_damt)) * dh_dl;
    dh_R = (vo_tanh(dh_R * dh_dg + 0.12 * dh_damt) - vo_tanh(0.12 * dh_damt)) * dh_dl;
    dh_tl += (dh_L - dh_tl) * 0.55; dh_tr += (dh_R - dh_tr) * 0.55; dh_L = dh_tl; dh_R = dh_tr;
  ) : (
    dh_hcnt += dh_hr; dh_hcnt >= 1 ? ( dh_hcnt -= 1; dh_hold = floor(dh_L * dh_bits + 0.5) / dh_bits; dh_holdr = floor(dh_R * dh_bits + 0.5) / dh_bits; );
    dh_L = dh_hold; dh_R = dh_holdr;
  );
);
dh_phs ? (
  dh_tick ? (
    dh_phph += dh_phr * (1 + 0.15 * ins_fx) * 4 / srate; dh_phph -= floor(dh_phph);
    dh_f = 280 * 2 ^ ((0.5 + 0.5 * sin(2 * $pi * dh_phph)) * dh_phd * 3.6) * dh_pis; dh_f *= 1 + dh_f * dh_f * 0.34; dh_pal = (dh_f - 1) / (dh_f + 1);
    dh_f = 280 * 2 ^ ((0.5 + 0.5 * cos(2 * $pi * dh_phph)) * dh_phd * 3.6) * dh_pis; dh_f *= 1 + dh_f * dh_f * 0.34; dh_par = (dh_f - 1) / (dh_f + 1);
  );
  dh_x = dh_L + dh_pfl * 0.5;
  dh_y = dh_pal * dh_x + dh_a1l; dh_a1l = dh_x - dh_pal * dh_y; dh_x = dh_y;
  dh_y = dh_pal * dh_x + dh_a2l; dh_a2l = dh_x - dh_pal * dh_y; dh_x = dh_y;
  dh_y = dh_pal * dh_x + dh_a3l; dh_a3l = dh_x - dh_pal * dh_y; dh_x = dh_y;
  dh_y = dh_pal * dh_x + dh_a4l; dh_a4l = dh_x - dh_pal * dh_y; dh_pfl = dh_y;
  dh_L = (dh_L + dh_y) * 0.5;
  dh_x = dh_R + dh_pfr * 0.5;
  dh_y = dh_par * dh_x + dh_a1r; dh_a1r = dh_x - dh_par * dh_y; dh_x = dh_y;
  dh_y = dh_par * dh_x + dh_a2r; dh_a2r = dh_x - dh_par * dh_y; dh_x = dh_y;
  dh_y = dh_par * dh_x + dh_a3r; dh_a3r = dh_x - dh_par * dh_y; dh_x = dh_y;
  dh_y = dh_par * dh_x + dh_a4r; dh_a4r = dh_x - dh_par * dh_y; dh_pfr = dh_y;
  dh_R = (dh_R + dh_y) * 0.5;
);
dh_cho ? (
  dh_chph += dh_chr * (1 + 0.15 * ins_fx) / srate; dh_chph -= floor(dh_chph);
  dh_tick ? (
    dh_cml = sin(2 * $pi * dh_chph); dh_cmr = sin(2 * $pi * (dh_chph + 0.25));
    dh_chf ? ( dh_cdl = (2.6 + 2.3 * dh_chd * dh_cml) * 0.001 * srate; dh_cdr = (2.6 + 2.3 * dh_chd * dh_cmr) * 0.001 * srate; )
           : ( dh_cdl = (8 + 5 * dh_chd * dh_cml) * 0.001 * srate;    dh_cdr = (8 + 5 * dh_chd * dh_cmr) * 0.001 * srate; );
  );
  dh_rp = dh_cwp - dh_cdl; dh_ri = floor(dh_rp); dh_rf = dh_rp - dh_ri;
  dh_wl = DCHL[dh_ri & DCHM] * (1 - dh_rf) + DCHL[(dh_ri + 1) & DCHM] * dh_rf;
  dh_rp = dh_cwp - dh_cdr; dh_ri = floor(dh_rp); dh_rf = dh_rp - dh_ri;
  dh_wr2 = DCHR[dh_ri & DCHM] * (1 - dh_rf) + DCHR[(dh_ri + 1) & DCHM] * dh_rf;
  DCHL[dh_cwp] = dh_L + (dh_chf ? dh_wl * 0.6 : 0);
  DCHR[dh_cwp] = dh_R + (dh_chf ? dh_wr2 * 0.6 : 0);
  dh_cwp = (dh_cwp + 1) & DCHM;
  dh_chf ? ( dh_L = (dh_L + dh_wl) * 0.6; dh_R = (dh_R + dh_wr2) * 0.6; )
         : ( dh_L = (dh_L + dh_wr2 * 0.8) * 0.72; dh_R = (dh_R + dh_wl * 0.8) * 0.72; );
);
dh_dly ? (
  dh_dts += (dh_dlt - dh_dts) * 0.0002;
  dh_rp = dh_wp - dh_dts; dh_ri = floor(dh_rp); dh_rf = dh_rp - dh_ri;
  dh_dl1 = DDLL[dh_ri & DDLM] * (1 - dh_rf) + DDLL[(dh_ri + 1) & DDLM] * dh_rf;
  dh_dr1 = DDLR[dh_ri & DDLM] * (1 - dh_rf) + DDLR[(dh_ri + 1) & DDLM] * dh_rf;
  dh_dfl += (dh_dl1 - dh_dfl) * 0.45; dh_dfr += (dh_dr1 - dh_dfr) * 0.45;        // darker repeats
  dh_dpp ? (
    DDLL[dh_wp] = (dh_L + dh_R) * 0.5 + vo_tanh(dh_dfr * dh_dfb);
    DDLR[dh_wp] = vo_tanh(dh_dfl * dh_dfb);
  ) : (
    DDLL[dh_wp] = dh_L + vo_tanh(dh_dfl * dh_dfb);
    DDLR[dh_wp] = dh_R + vo_tanh(dh_dfr * dh_dfb);
  );
  dh_wp = (dh_wp + 1) & DDLM;
  dh_L += dh_dl1 * dh_dmx; dh_R += dh_dr1 * dh_dmx;
);

// ---------- MASTER ----------
dh_vol += (dh_volt - dh_vol) * dh_sm;
dh_L = ostL.ost_band(dh_L * dh_vol); dh_R = ostR.ost_band(dh_R * dh_vol);
ost_out(dh_L, dh_R);
spl0 = ost_l; spl1 = ost_r;
dh_pk = max(dh_pk, max(abs(spl0), abs(spl1)));

@gfx 1200 560
ui_begin(1200, 560);
ui_col(0x8E9196); gfx_rect(0, 0, gfx_w, gfx_h);
rd_badge(36, 32, 16, 0xF4F5F2, 0x55585D);
rd_title(62, 16, "G-DAICHI", 26, 0x26282B);
gk_ = pk_preset(330 * sc, 16 * sc, 480 * sc, 34 * sc, pr_cur, #dh_pm);
gk_ > 0 ? load_preset(gk_);
ui_size_picker(1120 * sc, 24 * sc);
pk_end();
ui_end();
