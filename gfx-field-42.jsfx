desc:GFX Field 42
//tags: preamp channel strip transformer limiter field location mixer hpf
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-lfo, gfx-output, gfx-ui, gfx-panel, gfx-dyn and gfx-faceplate (.jsfx-inc) in the same folder.
//
// One input channel of a battery-powered location mixer, for a single track (mono or stereo; REAPER decides):
//   HPF        sweepable 80 - 240 Hz, 12 dB/oct, before the preamp; fully left = OFF.
//   TRIM       gain into a transformer-balanced preamp: clean at normal levels, iron and a soft rail when pushed.
//   IN LIMIT   the input "safety" limiter: fixed at -2 dBFS (+18 dBu), 20:1, 1 ms attack, 200 ms release.
//   Ø          polarity reverse.
//   PAN        constant loudness: +3 dB at hard left or right (a balance control on stereo tracks).
//   FADER      unity at 0 dB, -40 dB (off) to +10 dB.
//   OUT LIMIT  the output limiter: OFF, ON (each side on its own) or LINK (stereo-linked); THRESHOLD
//              +4 to +20 dBu (-16 to 0 dBFS), 20:1.
//   IRON       the custom output transformer: weight in the low mids, a softer top, when driven.
//   TONE       a line-up oscillator (1 kHz, 400 Hz or 100 Hz, -20 to +8 dBu) that replaces the signal.
// Levels: 0 dBu = -20 dBFS = 0 VU (as on location gear lined up to -20 dBFS).
// Meters: an input VU (after the preamp) on the left, the output LED ladder on the right.
// Parameter list only: input iron, limiter attack / release, and the GFX output stage.
//
// DRIFT (50% = standard): battery sag. The supply voltage wanders slowly and droops under heavy, sustained
// level, so the preamp's headroom, the limiter thresholds and the transformers' drive all move a little.
// 0% = a fresh battery (steady), 100% = twice the standard amount.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-lfo.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:75<75,240,1>-HPF (Hz, 75 = off)
slider2:0<-20,40,0.1>-Trim (dB)
slider3:1<0,1,1{Off,On}>-Input limiter
slider4:0<0,1,1{Normal,Reversed}>-Polarity
slider5:0<-100,100,1>-Pan
slider6:0<-40,10,0.1>-Fader (dB)
slider7:2<0,2,1{Off,On,Link}>-Output limiter
slider8:20<4,20,1>-Output limiter threshold (dBu)
slider9:30<0,100,1>-Iron (output transformer, %)
slider10:0<0,1,1{Off,On}>-Tone
slider11:0<0,2,1{1 kHz,400 Hz,100 Hz}>-Tone frequency
slider12:0<-20,8,1>-Tone level (dBu)
slider13:50<0,100,1>-Drift (%)
slider14:0<0,7,1{Init,Dialogue Boom,Lavalier,Acoustic,Drum Room,Kick and Bass,Hot Field,Safety Net}>-Preset
slider15:30<0,100,1>-Input iron (%)
slider16:1<0.1,10,0.1>-Limiter attack (ms)
slider17:200<50,1000,1>-Limiter release (ms)
slider18:0<0,100,1>-Band sat (%)
slider19:30<0,100,1>-Bias (%)
slider20:120<40,400,1>-Sat low band (Hz)
slider21:6000<2000,16000,10>-Sat high band (Hz)
slider22:-0.3<-24,0,0.1>-Ceiling / limit threshold (dB)
slider23:1<0,2,1{Off,Clip,Limit}>-Output stage

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-field-42";
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
drV.drift_init(0.8 + rand(0.5));

// ---------- building blocks ----------
function f4_hp(f) instance(b0, b1, b2, a1, a2) local(w, cw, al, d0) (
  w = 2 * $pi * f / srate; cw = cos(w); al = sin(w) / (2 * 0.7071); d0 = 1 + al;
  b0 = (1 + cw) / 2 / d0; b1 = -(1 + cw) / d0; b2 = (1 + cw) / 2 / d0; a1 = -2 * cw / d0; a2 = (1 - al) / d0;
);
function f4_bq(x) instance(b0, b1, b2, a1, a2, z1, z2) local(y) (
  y = b0 * x + z1; z1 = b1 * x - a1 * y + z2; z2 = b2 * x - a2 * y; y;
);
// a transformer: the core saturates on low-frequency flux (so the lows thicken first), with a little top rounding
function f4_iron(x, amt, drv) instance(lf, hf) local(d, c, sc_) (
  lf += (x - lf) * f4_ia;
  d = 1 + 5 * drv * amt;
  c = lf * d; sc_ = c / sqrt(1 + c * c);
  x += (sc_ - c) / d * (0.6 + 0.4 * amt) + amt * 0.03 * lf * lf * d;
  hf += (x - hf) * f4_ha;
  x + (hf - x) * amt * 0.35;
);
// the preamp rail: clean, then a soft wall (hv = headroom)
function f4_rail(x, hv) ( x / (1 + (abs(x) / hv) ^ 4) ^ 0.25; );

// presets: hpf, trim, in lim, pan, out lim, thr, iron, in iron (fader, polarity, tone, drift are left alone)
function setp(h, t, il, ol, th, ir, ii) ( slider1 = h; slider2 = t; slider3 = il; slider7 = ol; slider8 = th; slider9 = ir; slider15 = ii; );
function apply_preset(n) (
  n == 0 ? setp( 75,  0, 1, 2, 20, 30, 30) :     // Init
  n == 1 ? setp(120,  6, 1, 2, 18, 25, 25) :     // Dialogue Boom
  n == 2 ? setp(160,  4, 1, 2, 18, 20, 20) :     // Lavalier
  n == 3 ? setp( 85,  4, 1, 2, 20, 30, 35) :     // Acoustic
  n == 4 ? setp( 75, 12, 1, 2, 14, 60, 55) :     // Drum Room
  n == 5 ? setp( 75,  6, 1, 1, 18, 70, 60) :     // Kick and Bass
  n == 6 ? setp( 75, 18, 1, 2, 12, 80, 80) :     // Hot Field
           setp( 75,  0, 1, 2, 10, 20, 20);      // Safety Net
  slider_automate(2^0 + 2^1 + 2^2 + 2^6 + 2^7 + 2^8 + 2^14);
);
function pname(n) ( n = floor(n + 0.5);
  n == 0 ? "INIT" : n == 1 ? "DIALOGUE BOOM" : n == 2 ? "LAVALIER" : n == 3 ? "ACOUSTIC" :
  n == 4 ? "DRUM ROOM" : n == 5 ? "KICK AND BASS" : n == 6 ? "HOT FIELD" : "SAFETY NET"; );

function update() local(th) (
  hp_on = slider1 > 75.5;
  hpL.f4_hp(slider1); hpR.f4_hp(slider1);
  trim = 10 ^ (slider2 / 20);
  il_on = slider3 > 0.5; pol = slider4 > 0.5 ? -1 : 1;
  th = (slider5 / 100 + 1) * $pi / 4; pnL = cos(th) * sqrt(2); pnR = sin(th) * sqrt(2);    // +3 dB at the sides
  fad = slider6 <= -39.95 ? 0 : 10 ^ (slider6 / 20);
  ol_m = floor(slider7 + 0.5); ol_thr = slider8 - 20;
  iron_o = slider9 / 100; iron_i = slider15 / 100;
  tone_on = slider10 > 0.5; tone_f = slider11 < 0.5 ? 1000 : slider11 < 1.5 ? 400 : 100; tone_a = 10 ^ ((slider12 - 20) / 20) * sqrt(2);
  drift_macro(slider13);
  l_at = 1 - exp(-1 / (max(slider16, 0.05) * 0.001 * srate)); l_rl = 1 - exp(-1 / (slider17 * 0.001 * srate));
  ost_setup(slider18 / 100, slider19 / 100, slider20, slider21, slider22, floor(slider23 + 0.5));
);

f4_ia = 1 - exp(-2 * $pi * 110 / srate);           // the core's flux (low-frequency) band
f4_ha = 1 - exp(-2 * $pi * 14000 / srate);
vu_c = 1 - exp(-1 / (0.065 * srate));              // VU: about 300 ms to settle
sag_c = 1 - exp(-1 / (0.6 * srate));
lastp = slider14;                                   // adopt the saved preset without re-applying it
!ui_dflt ? ( ui_thm = 0; );
update();
ui_dflt = 1;

@slider
slider14 != lastp ? ( apply_preset(slider14); lastp = slider14; );
update();

@block
update();
// DRIFT: the battery's voltage wanders slowly; heavy level makes it droop (sag)
vV = drV.drift_tick(0.08 * dm_s * samplesblock / srate);
sup = 1 + 0.03 * dm_a * vV - 0.10 * dm_a * min(sag, 1);
il_thr = -2 + 20 * log10(sup);                     // the input limiter, at +18 dBu on a fresh battery
ol_t = ol_thr + 20 * log10(sup);

@sample
// HPF (before the preamp), TRIM, input transformer, rail
xL = spl0; xR = spl1;
hp_on ? ( xL = hpL.f4_bq(xL); xR = hpR.f4_bq(xR); );
xL *= trim; xR *= trim;
xL = iiL.f4_iron(xL, iron_i, sup); xR = iiR.f4_iron(xR, iron_i, sup);
hv = 1.58 * sup;                                   // the rail: about +24 dBu
xL = f4_rail(xL, hv); xR = f4_rail(xR, hv);
sag += (min((abs(xL) + abs(xR)) * 0.5, 2) - sag) * sag_c;

// VU (input, after the preamp)
vu_e += ((xL * xL + xR * xR) * 0.5 - vu_e) * vu_c;
pk_in = max(pk_in, max(abs(xL), abs(xR)));

// the input safety limiter (stereo-linked)
il_on ? (
  lv = max(abs(xL), abs(xR)); il_e += (lv - il_e) * (lv > il_e ? l_at : l_rl);
  il_gr = max(20 * log10(max(il_e, 0.000001)) - il_thr, 0) * 0.95;
  il_g = 10 ^ (-il_gr / 20); xL *= il_g; xR *= il_g;
  il_hit = max(il_hit, il_gr);
);

// polarity, FADER, PAN
xL *= pol * fad * pnL; xR *= pol * fad * pnR;

// TONE replaces the signal
tone_on ? ( tn_ph += tone_f / srate; tn_ph -= floor(tn_ph); xL = xR = tone_a * sin(2 * $pi * tn_ph); );

// the output limiter: ON = each side on its own, LINK = stereo-linked
ol_m > 0 ? (
  ol_m == 2 ? ( lv = max(abs(xL), abs(xR)); olL_e += (lv - olL_e) * (lv > olL_e ? l_at : l_rl); olR_e = olL_e; ) :
              ( lv = abs(xL); olL_e += (lv - olL_e) * (lv > olL_e ? l_at : l_rl); lv = abs(xR); olR_e += (lv - olR_e) * (lv > olR_e ? l_at : l_rl); );
  grL = max(20 * log10(max(olL_e, 0.000001)) - ol_t, 0) * 0.95; grR = max(20 * log10(max(olR_e, 0.000001)) - ol_t, 0) * 0.95;
  xL *= 10 ^ (-grL / 20); xR *= 10 ^ (-grR / 20);
  ol_hit = max(ol_hit, max(grL, grR));
);

// the output transformer, then the GFX output stage
xL = ioL.f4_iron(xL, iron_o, sup); xR = ioR.f4_iron(xR, iron_o, sup);
xL = ostL.ost_band(xL); xR = ostR.ost_band(xR);
ost_out(xL, xR);
spl0 = ost_l; spl1 = ost_r;
pkL = max(pkL, abs(spl0)); pkR = max(pkR, abs(spl1));

@gfx 960 300
ui_begin(960, 300);

KHAKI = 0xB9A97E; SH1 = 0xAE9E73; SH2 = 0xA6966B; INK = 0x1B1A16; DIMI = 0x4A4434; KEY = 0x3A372E; AMB = 0xFFB020; REDL = 0xFF3A22;
CAP = 0x4E3524; HPFC = 0xF2C83E; CAPW = 0xEEEFEA;
dy_ink = INK; dy_bg = KHAKI; dy_nov = 1; rd_sqbg = 0x2A2822;

function setv(idx, v) ( slider(idx) = v; ui_auto(idx); );
function sect(x, y, w, h, col, s) (
  ui_col(col); gfx_rect(x * sc, y * sc, w * sc, h * sc);
  ui_cola(0x000000, 0.25); gfx_rect(x * sc, y * sc, w * sc, 1 * sc); gfx_rect(x * sc, y * sc, 1 * sc, h * sc);
  ui_cola(0xFFFFFF, 0.25); gfx_rect(x * sc, (y + h - 1) * sc, w * sc, 1 * sc); gfx_rect((x + w - 1) * sc, y * sc, 1 * sc, h * sc);
  rd_sub(x + 10, y + 7, s, DIMI, 1);
);

// the khaki case: a powder-coat texture, darker lip, screws
ui_col(0x0B0C0D); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(KHAKI); gfx_rect(0, 0, 960 * sc, 300 * sc);
gi = 0;                                            // fine powder-coat speckle
loop(2400, ui_cola(rd_hash(gi + 51) > 0.5 ? 0xFFFFFF : 0x000000, 0.05 + 0.07 * rd_hash(gi + 919));
  gfx_rect(floor(rd_hash(gi) * 960 * sc), floor(rd_hash(gi + 4242) * 300 * sc), max(1, sc), max(1, sc)); gi += 1; );
ui_cola(0x000000, 0.35); gfx_rect(0, 0, 960 * sc, 2 * sc); gfx_rect(0, 296 * sc, 960 * sc, 4 * sc);
ui_col(INK); gfx_rect(0, 62 * sc, 960 * sc, 2 * sc);
rd_screw(10, 10); rd_screw(950, 10); rd_screw(10, 286); rd_screw(950, 286);

// header: badge, name, presets [PRESETS][◄][►][LCD], size
rd_badge(40, 32, 15, INK, KHAKI);
rd_title(64, 15, "FIELD 42", 26, INK);
rd_sub(204, 28, "LOCATION PREAMP", DIMI, 1);
pm_ = rd_sq(424, 16, 78, 32, 0, 0xD8CBA4, "PRESETS");
rd_sq(506, 16, 32, 32, 0, 0xD8CBA4, "◄") ? ( setv(14, (floor(slider14 + 0.5) + 7) % 8); apply_preset(slider14); lastp = slider14; );
rd_sq(542, 16, 32, 32, 0, 0xD8CBA4, "►") ? ( setv(14, (floor(slider14 + 0.5) + 1) % 8); apply_preset(slider14); lastp = slider14; );
pk_lcd(582 * sc, 9 * sc, 236 * sc, 46 * sc, 0);
pk_lcdfont(9, 10 * sc); ui_col(pk_lcdc);
sprintf(#plcd, "PRESET %02d/08", floor(slider14 + 0.5) + 1); gfx_x = 594 * sc; gfx_y = 15 * sc; gfx_drawstr(#plcd);
pk_lcdfont(9, 15 * sc); gfx_x = 594 * sc; gfx_y = 30 * sc; gfx_drawstr(pname(slider14));
pm_ || (pressed && drag_id == 0 && mouse_x >= 582 * sc && mouse_x < 818 * sc && mouse_y >= 9 * sc && mouse_y < 55 * sc) ? (
  drag_id = -1; strcpy(#pmenu, ""); k_ = 0;
  loop(8, k_ == floor(slider14 + 0.5) ? strcat(#pmenu, "!"); strcat(#pmenu, pname(k_)); k_ < 7 ? strcat(#pmenu, "|"); k_ += 1; );
  gfx_x = 424 * sc; gfx_y = 56 * sc; k_ = gfx_showmenu(#pmenu);
  k_ > 0 ? ( setv(14, k_ - 1); apply_preset(slider14); lastp = slider14; );
);
ui_size_picker(848 * sc, 24 * sc);

// ---------- INPUT VU ----------
sect(16, 76, 214, 208, SH1, "INPUT");
hw_ = ui_hw; ui_hw = 1;
vuI.ui_vu(26 * sc, 98 * sc, 194 * sc, 136 * sc, 10 * log10(max(vu_e, 0.0000000001)) + 20, "0 VU = -20 dBFS");
ui_hw = hw_;
rd_led(44, 254, 5, pk_in > 0.89, REDL); rd_lbl(44, 264, "PEAK", DIMI, 1);
rd_led(112, 254, 5, il_hit > 0.5, AMB); rd_lbl(112, 264, "IN LIM", DIMI, 1);
rd_led(184, 254, 5, ol_hit > 0.5, AMB); rd_lbl(184, 264, "OUT LIM", DIMI, 1);
pk_in *= 0.85; il_hit *= 0.8; ol_hit *= 0.8;

// ---------- PREAMP: HPF, TRIM, IN LIMIT, Ø ----------
sect(242, 76, 300, 208, SH2, "PREAMP");
slider1 <= 75.5 ? strcpy(#v, "OFF") : sprintf(#v, "%.0f Hz", slider1);
dy_kf = 1; dy_knob(296, 150, 26, 1, 75, 240, 75, 0, HPFC, "HPF", #v);     // the house HPF knob
sprintf(#v, "%+.1f dB", slider2);
dy_knob(410, 150, 34, 2, -20, 40, 0, 0, CAP, "TRIM", #v);
rd_sq(262, 226, 76, 30, slider3 > 0.5, AMB, "IN LIMIT") ? setv(3, 1 - slider3);
rd_sq(350, 226, 44, 30, slider4 > 0.5, CAPW, "Ø") ? setv(4, 1 - slider4);
sprintf(#v, "%.0f%%", slider15); dy_knob(492, 236, 15, 15, 0, 100, 30, 0, 0x9DA2A8, "IRON", #v);

// ---------- CHANNEL: PAN, FADER ----------
sect(554, 76, 188, 208, SH1, "CHANNEL");
abs(slider5) < 0.5 ? strcpy(#v, "C") : sprintf(#v, "%s %.0f", slider5 < 0 ? "L" : "R", abs(slider5));
dy_knob(600, 150, 22, 5, -100, 100, 0, 0, CAP, "PAN", #v);
slider6 <= -39.95 ? strcpy(#v, "OFF") : sprintf(#v, "%+.1f dB", slider6);
dy_knob(686, 150, 30, 6, -40, 10, 0, 0, CAPW, "FADER", #v);
rd_sq(568, 226, 38, 30, slider10 > 0.5, AMB, "TONE") ? setv(10, 1 - slider10);
rd_sq(610, 226, 56, 30, 0, 0xD8CBA4, slider11 < 0.5 ? "1 kHz" : slider11 < 1.5 ? "400 Hz" : "100 Hz") ? setv(11, (floor(slider11 + 0.5) + 1) % 3);
sprintf(#v, "%+.0f dBu", slider12); dy_knob(706, 240, 14, 12, -20, 8, 0, 0, 0x9DA2A8, "", #v);
rd_lbl(706, 262, "LEVEL", DIMI, 1);

// ---------- OUTPUT: limiter, iron, drift ----------
sect(754, 76, 140, 208, SH2, "OUTPUT");
rd_sq(764, 98, 38, 26, slider7 == 0, AMB, "OFF") ? setv(7, 0);
rd_sq(804, 98, 38, 26, slider7 == 1, AMB, "ON") ? setv(7, 1);
rd_sq(844, 98, 42, 26, slider7 == 2, AMB, "LINK") ? setv(7, 2);
sprintf(#v, "%+.0f dBu", slider8); dy_knob(790, 172, 20, 8, 4, 20, 20, 0, CAP, "LIMIT", #v);
sprintf(#v, "%.0f%%", slider9); dy_knob(858, 172, 20, 9, 0, 100, 30, 0, CAP, "IRON", #v);
sprintf(#v, "%.0f%%", slider13); dy_knob(824, 248, 14, 13, 0, 100, 50, 0, 0x9DA2A8, "", #v);
rd_lbl(860, 243, "DRIFT", DIMI, 1);

// ---------- output LED ladder ----------
mL.ui_ledm(906 * sc, 80 * sc, 12 * sc, 186 * sc, pkL); mR.ui_ledm(924 * sc, 80 * sc, 12 * sc, 186 * sc, pkR);
pkL *= 0.85; pkR *= 0.85;
rd_lbl(921, 272, "OUT", DIMI, 1);

pk_end();
ui_end();
