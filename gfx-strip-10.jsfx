desc:GFX Strip 10
// gfx-strip-10 - one input channel of a compact ten-channel analogue mixer, laid out sideways as a channel strip
//tags: channel strip dynamics compressor eq preamp mixer compact analog
//author: JGWizrad / Garden FX (GFX)
//
// One mono input channel of the little 2010s compact mixers (ten channels, a one-knob compressor on the mic
// inputs), its controls turned on their side so they run left to right in signal order. Designed from scratch
// in that spirit: a clean, honest preamp, a simple musical compressor, a broad three-band EQ, a pan pot and a fader.
//
// CHAIN   IN -> INPUT (mono sum or stereo) -> GAIN preamp -> 80 Hz HPF -> COMP -> HIGH / MID / LOW EQ -> PAN
//         -> LEVEL fader -> the GFX output stage.
// INPUT   MONO (default, as on the real channel): the two inputs are summed to mono at -6 dB each (a mono source
//         on a stereo track passes at unity); PAN places it with a constant-power law, normalised so the
//         centre is unity (hard left / right is +3 dB).
//         STEREO: both sides run through the same strip (the compressor is linked), and PAN becomes a BALANCE
//         control (unity in the centre, the far side fades out). Switching between them crossfades.
// GAIN    -20 .. +40 dB preamp trim. A clean op-amp style stage with about +14 dB of headroom above 0 dBFS:
//         transparent at sensible levels, a touch of even-harmonic warmth when pushed hard, then a soft
//         round limit at its rails. PEAK LED: lights (and holds) when the signal after the preamp or after
//         the EQ reaches -3 dBFS.
// HPF     80 Hz high-pass key, 12 dB/oct (Butterworth). Switching it crossfades, so it never clicks.
// COMP    the one-knob compressor: a single knob lowers the threshold (-2 to -26 dBFS), raises the ratio
//         (1:1 at 0, 4:1 at full) and adds matching automatic make-up gain (level-matched for peaks around
//         -12 dBFS) all together. Fast musical attack (about 5 ms), medium release (about 160 ms), a soft
//         8 dB knee, peak-sensing with a short hold so low notes do not ripple. The COMP LED glows with the
//         gain reduction. At 0 the compressor is out of circuit exactly.
// EQ      HIGH shelf 10 kHz +/-15 dB, MID peak 2.5 kHz +/-15 dB (fixed, as on such mixers), LOW shelf
//         100 Hz +/-15 dB. Gains glide (30 ms), coefficients are recomputed every 16 samples.
// PAN     constant-power pan (MONO) or balance (STEREO), see INPUT.
// LEVEL   the channel fader, -inf .. +10 dB, with a real fader taper (0 dB at three quarters of the travel);
//         the small LED meter beside it shows the output (dBFS).
// DRIFT   the mixer's supply is never quite even: the preamp gain, the EQ band gains (and their corner
//         frequencies, a hair) and the fader level ease very slightly up and down with the rail.
//         0 - 100 %, 15 % default (at 100 %: about +/-0.3 dB on the preamp, +/-3 % on the EQ gains).
// OUT     the GFX output stage: OFF / CLIP (soft clip at -0.3 dBFS) / LIMIT (3 ms lookahead).
//
// GUI: drag knobs (Shift = fine), double-click = reset; drag the fader cap sideways (Shift = fine, double-click
// = 0 dB, mouse wheel works on everything). Click PRESETS or the LCD for the preset list. S / M / L / ? = size
// and help.
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-dyn and gfx-faceplate (.jsfx-inc) in the same folder.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:0<-20,40,0.1>-Gain (dB)
slider2:0<0,1,1{Off,On}>-HPF 80 Hz
slider3:0<0,100,0.1>-Comp (%)
slider4:0<-15,15,0.1>-High 10 kHz (dB)
slider5:0<-15,15,0.1>-Mid 2.5 kHz (dB)
slider6:0<-15,15,0.1>-Low 100 Hz (dB)
slider7:0<-100,100,1>-Pan
slider8:0<-60,10,0.1>-Level (dB)
slider9:0<0,1,1{Mono (sum),Stereo (balance)}>-Input
slider10:15<0,100,1>-Drift (%)
slider11:1<0,2,1{Off,Clip,Limit}>-Output stage

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-strip-10";                                 // the ? pop-up links to this manual
nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
function db2g(d) ( exp(d*0.11512925465); );
ost_init(alloc(4096));

// ---------- filter design. c = [b0 b1 b2 a1 a2], y = b0 x + b1 x1 + b2 x2 - a1 y1 - a2 y2 ----------
function tn_hp(c, f) local(w, cs, al, a0) (                // Butterworth high-pass, 12 dB/oct
  w = 2*$pi*f/srate; cs = cos(w); al = sin(w)/(2*0.70711); a0 = 1 + al;
  c[0] = (1 + cs)*0.5/a0; c[1] = -(1 + cs)/a0; c[2] = c[0]; c[3] = -2*cs/a0; c[4] = (1 - al)/a0;
);
function tn_ls(c, f, g, q) local(A, w, cs, al, sa, a0) (   // low shelf
  A = 10^(g/40); w = 2*$pi*f/srate; cs = cos(w); al = sin(w)/(2*q); sa = 2*sqrt(A)*al;
  a0 = (A + 1) + (A - 1)*cs + sa;
  c[0] = A*((A + 1) - (A - 1)*cs + sa)/a0; c[1] = 2*A*((A - 1) - (A + 1)*cs)/a0; c[2] = A*((A + 1) - (A - 1)*cs - sa)/a0;
  c[3] = -2*((A - 1) + (A + 1)*cs)/a0; c[4] = ((A + 1) + (A - 1)*cs - sa)/a0;
);
function tn_hs(c, f, g, q) local(A, w, cs, al, sa, a0) (   // high shelf
  A = 10^(g/40); w = 2*$pi*min(f, srate*0.45)/srate; cs = cos(w); al = sin(w)/(2*q); sa = 2*sqrt(A)*al;
  a0 = (A + 1) - (A - 1)*cs + sa;
  c[0] = A*((A + 1) + (A - 1)*cs + sa)/a0; c[1] = -2*A*((A - 1) + (A + 1)*cs)/a0; c[2] = A*((A + 1) + (A - 1)*cs - sa)/a0;
  c[3] = 2*((A - 1) - (A + 1)*cs)/a0; c[4] = ((A + 1) - (A - 1)*cs - sa)/a0;
);
function tn_pk(c, f, g, q) local(A, w, cs, al, a0) (       // peak (constant-Q bell)
  A = 10^(g/40); w = 2*$pi*min(f, srate*0.45)/srate; cs = cos(w); al = sin(w)/(2*q); a0 = 1 + al/A;
  c[0] = (1 + al*A)/a0; c[1] = -2*cs/a0; c[2] = (1 - al*A)/a0; c[3] = -2*cs/a0; c[4] = (1 - al/A)/a0;
);
function tn_bq(x, c, s) local(y) (
  y = c[0]*x + c[1]*s[0] + c[2]*s[1] - c[3]*s[2] - c[4]*s[3];
  s[1] = s[0]; s[0] = x; s[3] = s[2]; s[2] = y;
  y;
);

// ---------- memory: coefficients and per-channel states ----------
tn_cHP = alloc(5); tn_cLS = alloc(5); tn_cPK = alloc(5); tn_cHS = alloc(5);
tn_sHP0 = alloc(4); tn_sHP1 = alloc(4); tn_sLS0 = alloc(4); tn_sLS1 = alloc(4);
tn_sPK0 = alloc(4); tn_sPK1 = alloc(4); tn_sHS0 = alloc(4); tn_sHS1 = alloc(4);
tn_hp(tn_cHP, 80);

// ---------- the preamp: clean op-amp stage, about +14 dB of headroom over 0 dBFS ----------
// a whisper of even harmonics that grows with the square of the level, then a soft round limit at the rails;
// what the stage adds is DC-blocked, so the clean part stays exact
function tn_pre(x) instance(dx, dy) local(u, y, d) (
  u = x*tn_ihP;
  y = min(max(u, -4), 4); y = u + 0.18*abs(y)*y*y;
  y = y/sqrt(sqrt(1 + sqr(sqr(y))));
  d = y - u;
  dy = d - dx + tn_dcR*dy; dx = d;
  (u + dy)*tn_hrP;
);

// ---------- parameters ----------
tn_hrP = db2g(14); tn_ihP = 1/tn_hrP;
tn_dcR = 1 - 2*$pi*5/srate;
tn_kS = 1 - exp(-16/(0.03*srate));                 // 30 ms glide, stepped every 16 samples (EQ)
tn_kD = 1 - exp(-1/(0.025*srate));                 // per-sample glide (gains, pan, crossfades)
tn_kC = 1 - exp(-1/(0.05*srate));                  // the COMP knob
tn_aAt = 1 - exp(-1/(0.005*srate));                // compressor attack ~5 ms
tn_aRl = 1 - exp(-1/(0.16*srate));                 // release ~160 ms
tn_hold = exp(-1/(0.012*srate));                   // peak detector: instant rise, 12 ms fall (no ripple on low notes)
tn_mDec = exp(-1/(0.3*srate));                     // meter fall
tn_vP = 0; tn_vE = 0; tn_vL = 0;
tn_dP.drift_init(0.8 + rand(0.5)); tn_dE.drift_init(0.8 + rand(0.5)); tn_dL.drift_init(0.8 + rand(0.5));
tn_cnt = 0; tn_env = 0; tn_gr = 0; tn_mGR = 0; tn_mL = 0; tn_mR = 0; tn_pkF = 0;

function tn_pan(p, st) local(a) (                  // target L / R gains: constant power (mono) or balance (stereo)
  a = (min(max(p, -100), 100)/100 + 1)*0.25*$pi;
  tn_tPl = st ? min(1, 1 - p/100) : 1.41421356*cos(a);
  tn_tPr = st ? min(1, 1 + p/100) : 1.41421356*sin(a);
);
function tn_targets() local(a, ek) (
  a = slider10/100;
  ek = 1 + 0.03*tn_vE*a;                           // the EQ band gains ease by up to 3 %
  tn_tH = slider4*ek; tn_tM = slider5*ek; tn_tL = slider6*ek;
  tn_tF = 1 + 0.005*tn_vE*a;                       // and their corners by up to 0.5 %
  tn_tG = db2g(slider1 + 0.3*tn_vP*a);             // the preamp by up to 0.3 dB
  tn_tLv = slider8 <= -59.9 ? 0 : db2g(slider8 + 0.15*tn_vL*a);
  tn_tHp = slider2 > 0.5; tn_tSt = slider9 > 0.5;
  tn_tC = min(max(slider3, 0), 100)/100;
  tn_pan(slider7, tn_tSt);
);
function tn_coefs() (
  tn_hs(tn_cHS, 10000*tn_F, tn_H, 0.6);
  tn_pk(tn_cPK, 2500*tn_F, tn_M, 0.9);
  tn_ls(tn_cLS, 100*tn_F, tn_L, 0.6);
);
function tn_glide() local(k) (
  k = tn_kS;
  abs(tn_tH - tn_H) + abs(tn_tM - tn_M) + abs(tn_tL - tn_L) + abs(tn_tF - tn_F) > 0.000001 ? (
    tn_H += (tn_tH - tn_H)*k; tn_M += (tn_tM - tn_M)*k; tn_L += (tn_tL - tn_L)*k; tn_F += (tn_tF - tn_F)*k;
    tn_coefs();
  );
);
tn_targets();
tn_H = tn_tH; tn_M = tn_tM; tn_L = tn_tL; tn_F = tn_tF;
tn_G = tn_tG; tn_Lv = tn_tLv; tn_hpM = tn_tHp; tn_st = tn_tSt; tn_C = tn_tC; tn_Pl = tn_tPl; tn_Pr = tn_tPr;
tn_coefs();

// ---------- presets (1-based, as the house preset bar counts) ----------
function tn_p(g, hp, cp, hi, mi, lo, pn, lv) (
  slider1 = g; slider2 = hp; slider3 = cp; slider4 = hi; slider5 = mi; slider6 = lo; slider7 = pn; slider8 = lv;
);
function load_preset(p) (
  p == 1 ? ( tn_p(0, 0, 0, 0, 0, 0, 0, 0); slider9 = 0; slider10 = 15; slider11 = 1; ) :   // Init (the defaults)
  p == 2 ? tn_p(2, 1, 45, 3, 1.5, -2, 0, -1.5) :                                            // Vocal
  p == 3 ? tn_p(0, 1, 30, 3.5, -2.5, -3, 0, -1) :                                           // Acoustic Guitar
  p == 4 ? tn_p(0, 0, 40, 0, 3, 5, 0, -3) :                                                 // Kick
  p == 5 ? tn_p(0, 0, 55, -3, 2, 3, 0, -2) :                                                // Bass DI
  p == 6 ? tn_p(0, 1, 45, 4, 2, -1.5, 0, -2) :                                              // Snare
  p == 7 ? tn_p(3, 1, 70, 2, 2.5, -1, 0, -2.5) :                                            // Podcast Voice
  p == 8 ? tn_p(0, 0, 20, 2, -1.5, 1, 0, -0.5);                                             // Keys
  slider_automate(2047);                            // sliders 1-11
);

!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );             // new instances open Large, on Init
ui_dflt = 1;
ui_thm = 5; ui_hw = 1;                             // the house hardware keycaps; the faceplate is the plug-in's own

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@slider
tn_targets();
ost_setup(0, 0, 120, 6000, -0.3, floor(slider11 + 0.5));

@block
// DRIFT: the supply rail wanders slowly (each part of the circuit feels it a little differently)
tn_ds = (0.06 + 0.1*slider10/100)*samplesblock/srate;
tn_vP = tn_dP.drift_tick(tn_ds); tn_vE = tn_dE.drift_tick(tn_ds*0.8); tn_vL = tn_dL.drift_tick(tn_ds*0.6);
tn_targets();
ost_setup(0, 0, 120, 6000, -0.3, floor(slider11 + 0.5));

@sample
tn_cnt <= 0 ? ( tn_glide(); tn_cnt = 16; ); tn_cnt -= 1;
tn_G += (tn_tG - tn_G)*tn_kD; tn_Lv += (tn_tLv - tn_Lv)*tn_kD;
tn_Pl += (tn_tPl - tn_Pl)*tn_kD; tn_Pr += (tn_tPr - tn_Pr)*tn_kD;
tn_hpM += (tn_tHp - tn_hpM)*tn_kD; abs(tn_hpM - tn_tHp) < 0.0001 ? tn_hpM = tn_tHp;
tn_st += (tn_tSt - tn_st)*tn_kD; abs(tn_st - tn_tSt) < 0.0001 ? tn_st = tn_tSt;
tn_C += (tn_tC - tn_C)*tn_kC; abs(tn_C - tn_tC) < 0.00001 ? tn_C = tn_tC;

// INPUT: mono sum or stereo (crossfaded); a whisper of DC keeps the filters out of denormals
tn_m_ = (spl0 + spl1)*0.5;
tn_a = tn_m_ + (spl0 - tn_m_)*tn_st + 0.000000000000000001;
tn_b = tn_m_ + (spl1 - tn_m_)*tn_st + 0.000000000000000001;

// GAIN: the preamp
tn_a = tn_pL.tn_pre(tn_a*tn_G); tn_b = tn_pR.tn_pre(tn_b*tn_G);
tn_pk_ = max(abs(tn_a), abs(tn_b));

// HPF 80 Hz (always running, so the key crossfades)
tn_h0 = tn_bq(tn_a, tn_cHP, tn_sHP0); tn_h1 = tn_bq(tn_b, tn_cHP, tn_sHP1);
tn_a += (tn_h0 - tn_a)*tn_hpM; tn_b += (tn_h1 - tn_b)*tn_hpM;

// COMP: one knob - threshold, ratio and make-up together; linked, peak-sensing with a short hold
tn_C > 0 ? (
  tn_lv_ = max(abs(tn_a), abs(tn_b));
  tn_env = tn_lv_ > tn_env ? tn_lv_ : tn_env*tn_hold;
  tn_thr = -2 - 24*tn_C; tn_slp = 1 - 1/(1 + 3*tn_C);
  tn_gt = -dy_curve(8.68588963807*log(max(tn_env, 0.0000001)) - tn_thr, 8)*tn_slp;
  tn_gr += (tn_gt - tn_gr)*(tn_gt < tn_gr ? tn_aAt : tn_aRl);
  tn_mk = dy_curve(-12 - tn_thr, 8)*tn_slp;       // auto make-up: level-matched for peaks around -12 dBFS
  tn_cg = db2g(tn_gr + tn_mk);
  tn_a *= tn_cg; tn_b *= tn_cg;
) : ( tn_gr = 0; tn_env = 0; );
tn_mGR = min(tn_mGR, tn_gr);

// EQ: HIGH 10 kHz shelf, MID 2.5 kHz peak, LOW 100 Hz shelf
tn_a = tn_bq(tn_bq(tn_bq(tn_a, tn_cHS, tn_sHS0), tn_cPK, tn_sPK0), tn_cLS, tn_sLS0);
tn_b = tn_bq(tn_bq(tn_bq(tn_b, tn_cHS, tn_sHS1), tn_cPK, tn_sPK1), tn_cLS, tn_sLS1);
tn_pk_ = max(tn_pk_, max(abs(tn_a), abs(tn_b)));
tn_pk_ > 0.708 ? tn_pkF = 1;                       // PEAK LED: -3 dBFS after the preamp or the EQ

// PAN and LEVEL, then the house output stage
ost_out(tn_a*tn_Pl*tn_Lv, tn_b*tn_Pr*tn_Lv);
spl0 = ost_l; spl1 = ost_r;
tn_a = abs(spl0); tn_mL = tn_a > tn_mL ? tn_a : tn_mL*tn_mDec;
tn_a = abs(spl1); tn_mR = tn_a > tn_mR ? tn_a : tn_mR*tn_mDec;

@gfx 1100 240
// =====================================================================
// GUI - a compact mixer's input channel turned on its side: a graphite header strip over a light silver-grey
// faceplate with dark grey print. GAIN, HPF, COMP, HIGH / MID / LOW, PAN and the LEVEL fader run left to right
// in signal order, the sections divided by thin printed lines. Design space 1100 x 240 at sc (size M).
// =====================================================================
ui_begin(1100, 240);

gfx_setfont(10, "Trebuchet MS", 15*sc, 'b');              // section titles
gfx_setfont(11, "Trebuchet MS", 14*sc, 'b');              // labels / key legends
gfx_setfont(12, "Trebuchet MS", 30*sc, 'b');              // name
gfx_setfont(13, "Trebuchet MS", 13*sc, 'b');              // scale print
gfx_setfont(14, "Trebuchet MS", 14*sc, 'b');              // value tags

TG_HDR = 0x34383D; TG_PNL = 0xC9CDD1; TG_PNL2 = 0xD2D5D8; TG_INK = 0x2E3237; TG_INK2 = 0x5C6168;
TG_RED = 0xFF3A2A; TG_AMB = 0xFFA53A; TG_GRN = 0x46D86A; TG_YEL = 0xF2C21B;
TG_CG = 0xE4E4DE; TG_CC = 0xE8782A; TG_CH = 0x3F8ED6; TG_CM = 0x3FA35A; TG_CL = 0xCC4438; TG_CP = 0x3A3D42;

function tg_R(x, y, w, h) ( gfx_rect(x*sc, y*sc, max(1, w*sc), max(1, h*sc)); );
function tg_TC(cx, y, t) local(w, h) ( gfx_measurestr(t, w, h); gfx_x = cx*sc - w*0.5; gfx_y = y*sc; gfx_drawstr(t); );
function tg_TCC(cx, cy, t) local(w, h) ( gfx_measurestr(t, w, h); gfx_x = cx*sc - w*0.5; gfx_y = cy*sc - h*0.52; gfx_drawstr(t); );
function tg_TX(x, y, t) ( gfx_x = x*sc; gfx_y = y*sc; gfx_drawstr(t); );
function tg_set(idx, v) ( slider(idx) = v; ui_auto(idx); );

// a section title printed on the faceplate, with a short rule in the section's colour
function tg_title(cx, s, col, rw) (
  gfx_setfont(10); ui_col(TG_INK); tg_TC(cx, 70, s);
  ui_col(col); tg_R(cx - rw*0.5, 89, rw, 3);
);
// value tag shown while a control is touched (house style: values on hover / drag only)
function tg_tag(cx, y, s) local(w, h) (
  gfx_setfont(14); gfx_measurestr(s, w, h);
  ui_cola(0x000000, 0.25); rd_rr(cx*sc - w*0.5 - 7*sc + 1, y*sc + 2, w + 14*sc, h + 4*sc, 4*sc);
  ui_col(0x24272B); rd_rr(cx*sc - w*0.5 - 7*sc, y*sc, w + 14*sc, h + 4*sc, 4*sc);
  ui_col(0xF4F1E8); gfx_x = cx*sc - w*0.5; gfx_y = y*sc + 2*sc; gfx_drawstr(s);
);
// printed scale ends (and an optional centre mark) round a knob
function tg_ends(cx, cy, r, s0, s1, sm) (
  gfx_setfont(13); ui_col(TG_INK2);
  tg_TCC(cx - (r + 17)*0.7071 - 4, cy + (r + 17)*0.7071 + 2, s0);
  tg_TCC(cx + (r + 17)*0.7071 + 4, cy + (r + 17)*0.7071 + 2, s1);
  strlen(sm) ? tg_TCC(cx, cy - r - 19, sm);
);
// the house coloured-cap knob (kst 7) or the small cap (kst 20); value tag below while touched
function tg_knob(idx, cx, cy, r, lo, hi, def, kst, cap, val) (
  dy_kst = kst; dy_ink = TG_INK; dy_ntick = 11;
  dy_knob(cx, cy, r, idx, lo, hi, def, 0, cap, "", "");
  dy_act ? tg_tag(cx, cy + r + 22, val);
);
function tg_fdb(v, d) local(q) (
  q = floor(v*10 + 0.5)/10; q > 0 ? sprintf(d, "+%.1f dB", q) : q < 0 ? sprintf(d, "%.1f dB", q) : strcpy(d, "0.0 dB"); d;
);
// a square lit key with its legend on it
function tg_key(x, y, w, h, on, col, bg, s) local(hit, tw, th, lm) (
  rd_sqbg = bg;
  hit = rd_sq(x, y, w, h, on, col, "");
  gfx_setfont(11); gfx_measurestr(s, tw, th);
  lm = (col & 255) + ((col >> 8) & 255) + ((col >> 16) & 255);
  ui_col(on ? (lm > 450 ? 0x141414 : 0xFFFFFF) : ((bg & 255) + ((bg >> 8) & 255) + ((bg >> 16) & 255) > 400 ? ui_mix(col, 0x000000, 0.62) : ui_mix(col, bg, 0.35)));
  gfx_x = (x + w*0.5)*sc - tw*0.5; gfx_y = (y + h*0.5)*sc - th*0.55; gfx_drawstr(s);
  hit;
);
// an LED with its glow following lvl (0 .. 1)
function tg_led(x, y, r, lvl, col) (
  lvl = min(max(lvl, 0), 1);
  ui_col(0x18191B); gfx_circle(x*sc, y*sc, (r + 1.6)*sc, 1, 1);
  lvl > 0.02 ? ( ui_cola(col, 0.28*lvl); gfx_circle(x*sc, y*sc, (r*2.3)*sc, 1, 1); );
  ui_col(ui_mix(ui_mix(col, 0x000000, 0.75), col, lvl)); gfx_circle(x*sc, y*sc, r*sc, 1, 1);
  ui_cola(0xFFFFFF, 0.18 + 0.5*lvl); gfx_circle((x - r*0.3)*sc, (y - r*0.32)*sc, r*0.32*sc, 1, 1);
);
// printed divider between sections
function tg_div(x) ( ui_col(0x8E949A); tg_R(x, 66, 1, 166); ui_cola(0xFFFFFF, 0.55); tg_R(x + 1, 66, 1, 166); );

// fader taper: travel 0 .. 1 <-> dB (off, -40, -20, -10, 0, +10 at 0, .175, .375, .5, .75, 1)
function tg_p2db(p) (
  p <= 0.175 ? -60 + p*20/0.175 : p <= 0.375 ? -40 + (p - 0.175)*100 : p <= 0.5 ? -20 + (p - 0.375)*80 :
  p <= 0.75 ? -10 + (p - 0.5)*40 : (p - 0.75)*40;
);
function tg_db2p(d) (
  d <= -40 ? max(0, (d + 60)*0.175/20) : d <= -20 ? 0.175 + (d + 40)/100 : d <= -10 ? 0.375 + (d + 20)/80 :
  d <= 0 ? 0.5 + (d + 10)/40 : min(1, 0.75 + d/40);
);

// ---------------------------------------------------------------------
ui_col(0x101214); gfx_rect(0, 0, gfx_w, gfx_h);

// ---- the header strip: roundel, name, presets, input mode, drift, output stage, size ----
ui_col(TG_HDR); tg_R(0, 0, 1100, 62);
gfx_gradrect(0, 0, 1100*sc, 30*sc, 1, 1, 1, 0.08, 0, 0, 0, 0, 0, 0, 0, -0.08/(30*sc));
ui_col(0x1E2125); tg_R(0, 60, 1100, 2);
ui_col(0xC8402A); gfx_circle(32*sc, 31*sc, 21*sc, 1, 1);
ui_cola(0xFFFFFF, 0.22); gfx_circle(27*sc, 25*sc, 8*sc, 1, 1);
gfx_setfont(2); ui_col(0xF2EEE4); ui_text(32*sc, 24*sc, "GFX");
gfx_setfont(12); ui_col(0xEEEFEA); tg_TX(64, 5, "STRIP 10");
gfx_setfont(13); ui_col(0xAEB6BE); tg_TX(66, 40, "MIXER CHANNEL");

tg_k = pk_preset(232*sc, 12*sc, 436*sc, 38*sc, pr_cur,
  "Init|Vocal|Acoustic Guitar|Kick|Bass DI|Snare|Podcast Voice|Keys");
tg_k > 0 ? ( load_preset(tg_k); pr_cur = tg_k; );

tg_key(690, 9, 54, 26, slider9 < 0.5, 0xEEEFEA, TG_HDR, "MONO") ? tg_set(9, 0);
tg_key(748, 9, 66, 26, slider9 > 0.5, 0xEEEFEA, TG_HDR, "STEREO") ? tg_set(9, 1);
gfx_setfont(13); ui_col(0xC9D0D6); tg_TC(752, 41, "INPUT");

dy_kst = 20; dy_ink = 0xD8DCE0; dy_ntick = 11;
dy_knob(858, 25, 15, 10, 0, 100, 15, 0, 0x8A6BD8, "", "");
gfx_setfont(13); ui_col(0xC9D0D6); tg_TC(858, 43, "DRIFT");
dy_act ? ( sprintf(#tg_dr, "%.0f %%", slider10); gfx_setfont(14); ui_col(0xF2D27A); tg_TX(880, 6, #tg_dr); );

ui_okfs = 1; ui_outkeys(918, 5, 64, 16, 3, 11); ui_okfs = 0.85;
gfx_setfont(8, "Trebuchet MS", 15*sc, 'b');
ui_size_picker(1030*sc, 22*sc);

// ---- the faceplate ----
ui_col(TG_PNL); tg_R(0, 62, 1100, 178);
gfx_gradrect(0, 62*sc, 1100*sc, 90*sc, 1, 1, 1, 0.14, 0, 0, 0, 0, 0, 0, 0, -0.14/(90*sc));
ui_col(TG_PNL2); tg_R(361, 62, 307, 178);                  // the EQ block a shade lighter, as printed
gfx_gradrect(361*sc, 62*sc, 307*sc, 90*sc, 1, 1, 1, 0.12, 0, 0, 0, 0, 0, 0, 0, -0.12/(90*sc));
ui_cola(0xFFFFFF, 0.5); tg_R(0, 62, 1100, 1);
ui_cola(0x000000, 0.28); tg_R(0, 238, 1100, 2);
tg_div(148); tg_div(232); tg_div(360); tg_div(668); tg_div(770);
rd_screw(8, 72); rd_screw(8, 230); rd_screw(1092, 72); rd_screw(1092, 230);

// ---- GAIN ----
tg_title(72, "GAIN", 0x9DA2A8, 50);
tg_ends(72, 150, 33, "-20", "+40", "");
sprintf(#tg_g, "%+.1f dB", slider1); slider1 == 0 ? strcpy(#tg_g, "0.0 dB");
tg_knob(1, 72, 150, 33, -20, 40, 0, 7, TG_CG, #tg_g);
tn_pkF ? ( tg_pkT = time_precise(); tn_pkF = 0; );
tg_led(128, 104, 5.5, time_precise() - tg_pkT < 0.25, TG_RED);
gfx_setfont(13); ui_col(TG_INK); tg_TC(128, 114, "PEAK");

// ---- HPF ----
tg_title(190, "HPF", TG_YEL, 40);
tg_key(160, 124, 60, 32, slider2 > 0.5, TG_YEL, TG_PNL, "80 Hz") ? tg_set(2, slider2 < 0.5);
// printed high-pass symbol
ui_col(TG_INK2); tg_k = 0;
loop(24, tg_x0 = 172 + tg_k*1.5; tg_y0 = 186 - 12*min(1, (tg_k/10)^1.6);
         tg_x1 = 173.5 + tg_k*1.5; tg_y1 = 186 - 12*min(1, ((tg_k + 1)/10)^1.6);
         gfx_line(tg_x0*sc, tg_y0*sc, tg_x1*sc, tg_y1*sc, 1); gfx_line(tg_x0*sc, tg_y0*sc + 1, tg_x1*sc, tg_y1*sc + 1, 1); tg_k += 1; );
gfx_setfont(13); ui_col(TG_INK); tg_TC(190, 196, "LOW CUT");

// ---- COMP ----
tg_title(290, "COMP", TG_CC, 54);
tg_ends(290, 150, 33, "0", "MAX", "");
tg_cn = slider3/100;
slider3 <= 0 ? strcpy(#tg_c, "OFF") : sprintf(#tg_c, "%.1f:1  %d dB", 1 + 3*tg_cn, floor(-2 - 24*tg_cn - 0.5));
tg_knob(3, 290, 150, 33, 0, 100, 0, 7, TG_CC, #tg_c);
tg_grv = max(-tn_mGR, tg_grv*0.85); tn_mGR = 0;
tg_led(342, 104, 5.5, tg_grv > 0.25 ? 0.35 + 0.65*min(1, (tg_grv - 0.25)/5) : 0, TG_AMB);
gfx_setfont(13); ui_col(TG_INK); tg_TC(342, 114, "COMP");

// ---- EQ: HIGH, MID, LOW ----
tg_title(412, "HIGH", TG_CH, 46);
tg_title(514, "MID", TG_CM, 46);
tg_title(616, "LOW", TG_CL, 46);
tg_ends(412, 150, 33, "-", "+", "0"); tg_ends(514, 150, 33, "-", "+", "0"); tg_ends(616, 150, 33, "-", "+", "0");
gfx_setfont(13); ui_col(TG_INK2);
tg_TC(412, 208, "10 kHz"); tg_TC(514, 208, "2.5 kHz"); tg_TC(616, 208, "100 Hz");
tg_knob(4, 412, 150, 33, -15, 15, 0, 7, TG_CH, tg_fdb(slider4, #tg_h));
tg_knob(5, 514, 150, 33, -15, 15, 0, 7, TG_CM, tg_fdb(slider5, #tg_m));
tg_knob(6, 616, 150, 33, -15, 15, 0, 7, TG_CL, tg_fdb(slider6, #tg_l));

// ---- PAN ----
tg_title(719, slider9 > 0.5 ? "BAL" : "PAN", TG_CP, 40);
tg_ends(719, 150, 31, "L", "R", "C");
slider7 == 0 ? strcpy(#tg_p, "C") : sprintf(#tg_p, "%s %d", slider7 < 0 ? "L" : "R", abs(slider7));
tg_knob(7, 719, 150, 31, -100, 100, 0, 20, TG_CP, #tg_p);

// ---- LEVEL: the horizontal fader and its meter ----
tg_fon = 0;   // the fader's value tag replaces the LEVEL title while it is touched (drawn below)
TG_FX0 = 806; TG_FX1 = 1052; TG_FY = 142; tg_fl = TG_FX1 - TG_FX0;
// scale print above the slot
gfx_setfont(13); tg_k = 0;
loop(6,
  tg_p_ = tg_k == 0 ? 0 : tg_k == 1 ? 0.175 : tg_k == 2 ? 0.375 : tg_k == 3 ? 0.5 : tg_k == 4 ? 0.75 : 1;
  tg_x0 = TG_FX0 + tg_p_*tg_fl;
  ui_col(tg_k == 4 ? TG_INK : TG_INK2);
  tg_TC(tg_x0, 101, tg_k == 0 ? "OFF" : tg_k == 1 ? "-40" : tg_k == 2 ? "-20" : tg_k == 3 ? "-10" : tg_k == 4 ? "0" : "+10");
  tg_R(tg_x0, 118, 1, 8); tg_R(tg_x0, 158, 1, 8);
  tg_k += 1;
);
ui_col(TG_INK2); tg_k = 0; loop(21, tg_x0 = TG_FX0 + tg_k*tg_fl/20; tg_R(tg_x0, 122, 1, 3); tg_R(tg_x0, 159, 1, 3); tg_k += 1; );
// the slot
ui_col(0x8E949A); tg_R(TG_FX0 - 8, TG_FY - 5, tg_fl + 16, 10);
ui_col(0x141517); tg_R(TG_FX0 - 7, TG_FY - 4, tg_fl + 14, 8);
ui_cola(0xFFFFFF, 0.6); tg_R(TG_FX0 - 8, TG_FY + 5, tg_fl + 16, 1);
// mouse: drag the cap sideways (a click on the slot jumps there first), Shift = fine, double-click = 0 dB, wheel
tg_fp = tg_db2p(slider8);
tg_cx = TG_FX0 + tg_fp*tg_fl;
tg_hov = mouse_x >= (TG_FX0 - 16)*sc && mouse_x <= (TG_FX1 + 16)*sc && mouse_y >= (TG_FY - 26)*sc && mouse_y <= (TG_FY + 26)*sc;
pressed && tg_hov && drag_id == 0 ? (
  time_precise() - tg_flt < 0.35 ? ( tg_set(8, 0); drag_id = -1; tg_flt = 0; ) : (
    tg_flt = time_precise(); drag_id = 3008;
    abs(mouse_x - tg_cx*sc) > 14*sc ? ( tg_fp = min(max((mouse_x/sc - TG_FX0)/tg_fl, 0), 1); tg_set(8, floor(tg_p2db(tg_fp)*10 + 0.5)/10); );
    tg_fmx = mouse_x; tg_fps = tg_fp;
  );
);
drag_id == 3008 ? (
  tg_fps = min(max(tg_fps + (mouse_x - tg_fmx)/(tg_fl*sc)*((mouse_cap & 8) ? 0.1 : 1), 0), 1); tg_fmx = mouse_x;
  tg_v = floor(tg_p2db(tg_fps)*10 + 0.5)/10; tg_v != slider8 ? tg_set(8, tg_v);
);
tg_hov && mouse_wheel != 0 && drag_id == 0 ? (
  tg_set(8, floor(tg_p2db(min(max(tg_db2p(slider8) + mouse_wheel/120*((mouse_cap & 8) ? 0.004 : 0.02), 0), 1))*10 + 0.5)/10);
  mouse_wheel = 0;
);
tg_fp = tg_db2p(slider8); tg_cx = TG_FX0 + tg_fp*tg_fl;
// the cap: dark, with a white line across its middle
ui_cola(0x000000, 0.35); rd_rr((tg_cx - 12 + 2)*sc, (TG_FY - 23 + 3)*sc, 24*sc, 46*sc, 3*sc);
ui_col(0x18191B); rd_rr((tg_cx - 12)*sc, (TG_FY - 23)*sc, 24*sc, 46*sc, 3*sc);
ui_col(0x2E3034); rd_rr((tg_cx - 10)*sc, (TG_FY - 21)*sc, 20*sc, 42*sc, 2*sc);
gfx_gradrect((tg_cx - 10)*sc, (TG_FY - 21)*sc, 20*sc, 21*sc, 1, 1, 1, 0.12, 0, 0, 0, 0, 0, 0, 0, -0.12/(21*sc));
tg_k = 0; loop(4, ui_cola(0x000000, 0.35); tg_R(tg_cx - 9, TG_FY - 17 + tg_k*4, 18, 1); ui_cola(0xFFFFFF, 0.08); tg_R(tg_cx - 9, TG_FY - 16 + tg_k*4, 18, 1);
  ui_cola(0x000000, 0.35); tg_R(tg_cx - 9, TG_FY + 4 + tg_k*4, 18, 1); ui_cola(0xFFFFFF, 0.08); tg_R(tg_cx - 9, TG_FY + 5 + tg_k*4, 18, 1); tg_k += 1; );
ui_col(0xF2F0EA); tg_R(tg_cx - 1, TG_FY - 21, 2, 42);
(tg_hov || drag_id == 3008) ? (
  slider8 <= -59.9 ? strcpy(#tg_f, "OFF") : tg_fdb(slider8, #tg_f);
  tg_tag(929, 68, #tg_f); tg_fon = 1;
);
!tg_fon ? tg_title(929, "LEVEL", 0x9DA2A8, 58);
// the meter: two rows of ten LEDs (dBFS)
tg_mvL = max(tn_mL, tg_mvL*0.82); tg_mvR = max(tn_mR, tg_mvR*0.82);
gfx_setfont(13); ui_col(TG_INK); tg_TCC(790, 190, "L"); tg_TCC(790, 206, "R");
ui_col(0x0E0F10); tg_R(TG_FX0 - 4, 182, tg_fl + 8, 32);
tg_k = 0;
loop(10,
  tg_d = tg_k == 0 ? -42 : tg_k == 1 ? -36 : tg_k == 2 ? -30 : tg_k == 3 ? -24 : tg_k == 4 ? -18 : tg_k == 5 ? -12 :
         tg_k == 6 ? -9 : tg_k == 7 ? -6 : tg_k == 8 ? -3 : -0.5;
  tg_c = tg_k == 9 ? TG_RED : tg_k >= 7 ? TG_AMB : TG_GRN;
  tg_x0 = TG_FX0 + tg_k*tg_fl/10;
  ui_col(20*log10(max(tg_mvL, 0.0000001)) >= tg_d ? tg_c : ui_mix(tg_c, 0x000000, 0.8)); tg_R(tg_x0 + 1, 185, tg_fl/10 - 3, 11);
  ui_col(20*log10(max(tg_mvR, 0.0000001)) >= tg_d ? tg_c : ui_mix(tg_c, 0x000000, 0.8)); tg_R(tg_x0 + 1, 200, tg_fl/10 - 3, 11);
  gfx_setfont(13); ui_col(TG_INK2);
  tg_k == 0 || tg_k == 2 || tg_k == 4 || tg_k == 7 || tg_k == 9 ? (
    tg_k == 9 ? strcpy(#tg_ml, "0") : sprintf(#tg_ml, "%d", tg_d);
    tg_TC(tg_x0 + tg_fl/20 - 1, 218, #tg_ml);
  );
  tg_k += 1;
);

pk_end();
ui_end();
