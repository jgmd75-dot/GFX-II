desc:gfx-piano1
//tags: piano physical-modeling waveguide string synthesis polyphony
//author: JGWizrad / DSP Dave

slider1:60<21,108,1>-MIDI Note (60 = Middle C)
slider2:0.5<0,1,0.01>-Hammer Hardness
slider3:0.98<0.9,0.999,0.0001>-Damper Decay
slider4:0.5<0,1,0.01>-Inharmonicity / Stiffness
slider5:0.7<0.1,0.99,0.01>-Resonance compass_q

in_pin:none
out_pin:left output
out_pin:right output

@init
ext_noinit = 1;
max_voices = 8;
max_delay = 16384; // Expanded to support full 88-key range down to A0
voice_stride = 6;

voices_base = 1000;
buffers_base = 10000;

i = 0;
loop(max_voices,
  v_ptr = voices_base + i * voice_stride;
  v_ptr[0] = 0; // state: 0 = off, 1 = active, 2 = releasing
  v_ptr[1] = 0; // midi note
  v_ptr[2] = 0.0; // delay length in samples
  v_ptr[3] = 0;   // write pointer index
  v_ptr[4] = buffers_base + i * max_delay; // buffer memory offset
  v_ptr[5] = 0.0; // allpass filter state
  
  memset(v_ptr[4], 0, max_delay);
  i += 1;
);

function note_to_delay(note) (
  freq = 440 * 2 ^ ((note - 69) / 12);
  srate > 0 ? srate / freq : 100;
);

@slider
hardness = slider2;
decay = slider3;
inharm = slider4;
compass_q = slider5;

@block
while (midirecv(offset, msg1, msg2, msg3)) (
  status = msg1 & 0xF0;
  
  // Note On
  status == 0x90 && msg3 > 0 ? (
    note = msg2;
    vel = msg3 / 127;
    hammer_force = (vel ^ 1.5) * hardness;
    target_delay = note_to_delay(note);
    
    // Find free voice slot
    v_idx = -1;
    i = 0;
    loop(max_voices,
      v_ptr = voices_base + i * voice_stride;
      v_ptr[0] == 0 ? ( v_idx = i; i = max_voices; );
      i += 1;
    );
    
    v_idx < 0 ? v_idx = 0; // Voice stealing fallback
    
    v_ptr = voices_base + v_idx * voice_stride;
    v_ptr[0] = 1;
    v_ptr[1] = note;
    v_ptr[2] = min(target_delay, max_delay - 2);
    v_ptr[3] = 0;
    v_ptr[5] = 0.0;
    
    // Clear buffer for this voice
    memset(v_ptr[4], 0, max_delay);
    
    // Inject impulse excitation directly into the start of the waveguide buffer
    buf_start = v_ptr[4];
    j = 0;
    loop(24,
      buf_start[j] = (rand(2) - 1) * hammer_force * (1 - j / 24);
      j += 1;
    );
  );
  
  // Note Off
  (status == 0x80) || (status == 0x90 && msg3 == 0) ? (
    note = msg2;
    i = 0;
    loop(max_voices,
      v_ptr = voices_base + i * voice_stride;
      v_ptr[0] == 1 && v_ptr[1] == note ? (
        v_ptr[0] = 2;
      );
      i += 1;
    );
  );
  
  midisend(offset, msg1, msg2, msg3);
);

@sample
out_l = 0;
out_r = 0;

i = 0;
loop(max_voices,
  v_ptr = voices_base + i * voice_stride;
  v_ptr[0] > 0 ? (
    dl_len = v_ptr[2];
    w_pos = v_ptr[3];
    buf_start = v_ptr[4];
    
    // Correct waveguide read position calculation
    r_pos = w_pos - dl_len;
    r_pos < 0 ? r_pos += max_delay;
    
    i1 = floor(r_pos);
    i2 = (i1 + 1) % max_delay;
    frac = r_pos - i1;
    
    s_val = buf_start[i1] * (1 - frac) + buf_start[i2] * frac;
    
    // Inharmonicity / stiffness allpass dispersion filter
    ap_val = s_val * inharm + v_ptr[5] * (1 - inharm);
    v_ptr[5] = ap_val;
    
    // Loop damping and compass_q resonance
    effective_decay = v_ptr[0] == 2 ? decay * 0.85 : decay;
    s_filtered = ap_val * effective_decay * compass_q;
    
    // Read any newly injected excitation at the current write position and feed back
    final_samp = s_filtered + buf_start[w_pos];
    buf_start[w_pos] = final_samp;
    
    // Advance write pointer
    w_pos += 1;
    w_pos >= max_delay ? w_pos = 0;
    v_ptr[3] = w_pos;
    
    out_l += final_samp;
    out_r += final_samp;
    
    // Kill voice when energy drops below noise floor
    abs(final_samp) < 0.00001 ? v_ptr[0] = 0;
  );
  i += 1;
);

spl0 = out_l * 0.2;
spl1 = out_r * 0.2;

@gfx 600 220
gfx_r = 0.16; gfx_g = 0.18; gfx_b = 0.20;
gfx_rect(0, 0, gfx_w, gfx_h);

gfx_setfont(1, "Arial", 14);
gfx_r = 0.90; gfx_g = 0.88; gfx_b = 0.85;

gfx_x = 24; gfx_y = 24;
gfx_printf("JGWIZRAD / DSP DAVE — GFX-PIANO1 PHYSICAL MODEL");

gfx_x = 24; gfx_y = 64;
gfx_printf("Active Voices    : %d / %d", max_voices, max_voices);

gfx_x = 24; gfx_y = 94;
gfx_printf("Hammer Hardness  : %.2f", slider2);

gfx_x = 24; gfx_y = 124;
gfx_printf("Damper Decay     : %.4f", slider3);

gfx_x = 24; gfx_y = 154;
gfx_printf("Resonance compass_q : %.2f", slider5);