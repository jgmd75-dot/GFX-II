k_ > 0 ? ( load_preset(k_); pr_cur = k_ > 11 ? 0 : k_; );
ui_size_picker(828 * sc, 22 * sc);

// the colour stripe under the header: the three cap colours
ui_col(CAP_T); gfx_rect(14 * sc, 60 * sc, 290 * sc, 3 * sc);
ui_col(CAP_R); gfx_rect(304 * sc, 60 * sc, 290 * sc, 3 * sc);
