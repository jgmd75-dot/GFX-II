mO.ui_ledm(712 * sc, 318 * sc, 128 * sc, 9 * sc, pkO);
lbl(700, 303, "IN", INK, 0.7); lbl(700, 317, "OUT", INK, 0.7);
pkI *= 0.85; pkO *= 0.85;
sprintf(#gt, "%.1f", min(s1.eL + s2.eL, 0)); lbl(856, 303, "GR", INK, 0.7); lbl(856, 317, #gt, INK, 0.9);

