desc:GFX Drive-45 [studio drive]
//tags: drive saturation distortion overdrive clipper console transformer studio parallel eq
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel, gfx-dyn and gfx-faceplate (.jsfx-inc) in the same folder.
//
// DRIVE-45. An eight-circuit studio drive: two half-rack units bolted side by side by a central mounting bracket
// (the 45 family). Studio and broadcast saturation for tracks and busses, not stompbox fuzz.
//   LEFT  - DRIVE 45 (STUDIO-VERZERRER), in the spirit of East German studio lab gear and transistor research:
//     1 STUDIO CLEAN BOOST  transparent op-amp gain into a studio transformer: the core saturates the lows first
//                           (odd, with a touch of even), the op-amp's rails round off only the loudest peaks.
//     2 GERMANIUM CONSOLE   an asymmetric germanium stage: the positive half bends early, the negative half late
//                           (warm 2nd harmonic), the bias floats with the level and the supply sags a little (the
//                           threshold drops with the envelope: soft glue). Rounded top before and after.
//     3 OP-AMP LINE DRIVER  a classic East German studio op-amp run out of rails: presence pre-emphasis, the
//                           op-amp's slew rate limit (0.08 FS / us, solved exactly between samples: loud highs turn
//                           triangular, edges become ramps), then a hard clip on slightly unequal rails
//                           (anti-aliased). Bright, aggressive.
//     4 TRANSISTOR MATRIX   three cascaded transistor-array stages, each with its own bias (alternating sign) and
//                           coupling / roll-off filters: the drive is shared between the stages, so the
//                           harmonics pile up thick and dense, the top rounds off stage by stage.
//   RIGHT - JDM-45 (BROADCAST-SÄTTIGUNGSEINHEIT), in the spirit of Japanese high-end consoles and broadcast mods:
//     1 CONSOLE OVERDRIVE   a channel amplifier with a clean, perfectly linear core up to its knee, then a smooth
//                           (C2) soft clip with a slightly unequal knee, plus the channel's faint 2nd harmonic.
//     2 BROADCAST LIMITER DRIVE  50 us pre-emphasis -> a symmetrical hard clip (anti-aliased) -> de-emphasis: the
//                           classic transmitter clipper. Transients and sibilance are slammed first; odd harmonics.
//     3 HARMONIC DISSONANCE a full-wave rectifier (anti-aliased) on the band above 700 Hz is mixed back in (more with
//                           DRIVE) and the sum saturates: even upper harmonics and intermodulation, presence and
//                           edge. Use BLEND to set how much.
//     4 STARVED RAIL        a stage on a weak supply: the rail sags with the current drawn (compression), the bias
//                           slides as it sags (asymmetric, dense), and the starved bias leaves a soft dead zone
//                           round zero that grows as the rail drops: the decay sputters out, gate-like.
//
// SIGNAL FLOW
//   input -> INPUT trim -> 4x oversampling (linear-phase Kaiser half-bands, 63 + 23 taps) -> the two units in
//   series (ORDER: DRIVE 45 -> JDM-45 or JDM-45 -> DRIVE 45) -> back to 1x -> OUTPUT -> the house output stage
//   (band SAT, soft clip always on).
//   Each unit: DRIVE (0 .. +30 dB into the circuit) -> the selected CIRCUIT -> DC blocker (5 Hz) -> level matched
//   (each circuit's small-signal gain is unity whatever the DRIVE, and a per-circuit calibration table removes the
//   loudness the circuits gain or lose at each DRIVE, measured on programme at -18 dBFS RMS) -> BLEND with the
//   unit's own input (inside the oversampled domain, so the dry and the wet line up sample for sample) -> OUTPUT
//   -> 3-band EQ (LOW shelf 100 Hz, MID bell 200 Hz - 8 kHz, Q 0.9, HIGH shelf 10 kHz, +/-15 dB; post-circuit,
//   on the unit's output) -> the ON key (10 ms fade). Changing CIRCUIT crossfades the two circuits (15 ms).
//   Latency: 37 samples (the oversampling; reported).
// DRIFT (0 - 100 %, 50 % = standard): component tolerance. The bias points and clip thresholds of every circuit
//   wander slowly (bias +/-0.03, threshold +/-3 %), the EQ frequencies wander (+/-2 %), and the left and right
//   channels never quite match (fixed tolerances: threshold +/-1 %, bias +/-0.012, redrawn per instance).
//   0 % = ideal components.
// METERS: each unit's display shows the selected circuit and VU bars for the unit's input and output
//   (Meter 45 calibration: a sine peaking at -18 dBFS reads 0 VU; 300 ms needle ballistics).
// GUI: drag a knob (SHIFT = fine, double-click = default, wheel); values show while a knob is touched; the CIRCUIT
//   switch: drag, wheel, or click a circuit's name; click a key; click the LCD (or PRESETS) for the preset list.
//   TOKYO / BERLIN keys change each unit's faceplate (charcoal VFD or baked enamel / battleship grey; BERLIN prints
//   German), not its sound. S / M / L / ? = size and help.

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:1<0,1,1{Off,On}>-Drive 45 on
slider2:1<0,1,1{Tokyo,Berlin}>-Drive 45 style
slider3:0<0,3,1{Studio Clean Boost,Germanium Console,Op-Amp Line Driver,Transistor Matrix}>-Drive 45 circuit
slider4:8<0,30,0.1>-Drive 45 drive (dB)
slider5:100<0,100,1>-Drive 45 blend (%)
slider6:0<-24,12,0.1>-Drive 45 output (dB)
slider7:0<-15,15,0.1>-Drive 45 low (dB)
slider8:0<-15,15,0.1>-Drive 45 mid (dB)
slider9:1000<200,8000,1>-Drive 45 mid freq (Hz)
slider10:0<-15,15,0.1>-Drive 45 high (dB)
slider11:1<0,1,1{Off,On}>-JDM-45 on
slider12:0<0,1,1{Tokyo,Berlin}>-JDM-45 style
slider13:0<0,3,1{Console Overdrive,Broadcast Limiter Drive,Harmonic Dissonance,Starved Rail}>-JDM-45 circuit
slider14:8<0,30,0.1>-JDM-45 drive (dB)
slider15:100<0,100,1>-JDM-45 blend (%)
slider16:0<-24,12,0.1>-JDM-45 output (dB)
slider17:0<-15,15,0.1>-JDM-45 low (dB)
slider18:0<-15,15,0.1>-JDM-45 mid (dB)
slider19:1000<200,8000,1>-JDM-45 mid freq (Hz)
slider20:0<-15,15,0.1>-JDM-45 high (dB)
slider21:0<0,1,1{Drive 45 first,JDM-45 first}>-Order
slider22:0<-24,12,0.1>-Input trim (dB)
slider23:50<0,100,1>-Drift (%)
slider24:0<-24,12,0.1>-Output (dB)
slider25:0<0,100,1>-Band sat (%)
slider26:30<0,100,1>-Bias (%)
slider27:120<40,400,1>-Sat low band (Hz)
slider28:6000<2000,16000,10>-Sat high band (Hz)
slider29:-0.3<-24,0,0.1>-Ceiling (dB)
slider30:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider31:0<0,1,1{ENG,DE}>-Label language

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-drive-45";                               // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
dq_H1 = alloc(64); dq_H2 = alloc(32);                   // half-band kernels
dq_EQ = alloc(32);                                      // EQ biquads: unit A bands 0-2, unit B bands 3-5 (5 each)
dq_MKT = alloc(96);
dq_eg = alloc(8);                                       // EQ gains as they glide (A low, mid, high, B low, mid, high)                                      // the level-matching table: 8 circuits x 11 DRIVE points
dq_ostm = alloc(4096);
dqAL.st = alloc(16); dqAR.st = alloc(16); dqBL.st = alloc(16); dqBR.st = alloc(16);   // anti-aliased stages' states

// ---------- oversampling: linear-phase half-bands (Kaiser windowed), polyphase ----------
function dq_bi0(x) local(s, t, k) ( s = 1; t = 1; k = 1; loop(30, t *= sqr(x / (2 * k)); s += t; k += 1; ); s; );
function dq_hbdesign(h, n, beta) local(c, t, k, w, x, se, i0) (
  c = (n - 1) / 2; i0 = dq_bi0(beta); t = 0;
  loop(n,
    k = t - c; x = 2 * t / (n - 1) - 1;
    w = dq_bi0(beta * sqrt(max(0, 1 - x * x))) / i0;
    h[t] = k == 0 ? 0.5 : sin($pi * k / 2) / ($pi * k) * w;
    t += 1;
  );
  se = 0; t = 0; loop((n + 1) / 2, se += h[2 * t]; t += 1; );
  t = 0; loop((n + 1) / 2, h[2 * t] *= 0.5 / se; t += 1; );      // each polyphase branch: unity at DC
);
// The kernels are symmetric, so each pair of taps shares one multiply; the delay lines are written twice (at w and
// w + sz) so every read is a plain offset, no wrap-around.
// up 2x: one sample in -> o0, o1 (the odd branch of a half-band is a pure delay)
function dq_upinit(n, h, sz) instance(buf, sz2, w, hu, np, mm, dd) local(j) (
  buf = alloc(2 * sz); sz2 = sz; w = 0; mm = (n + 1) / 2; np = mm / 2; dd = ((n - 1) / 2 - 1) / 2;
  hu = alloc(np); j = 0; loop(np, hu[j] = 2 * h[2 * j]; j += 1; );
);
function dq_up(x) instance(buf, sz2, w, hu, np, mm, dd, o0, o1) local(j, s, p) (
  w += 1; w >= sz2 ? w = 0; buf[w] = x; buf[w + sz2] = x;
  p = buf + w + sz2; s = 0; j = 0;
  loop(np, s += hu[j] * (p[-j] + p[j + 1 - mm]); j += 1; );
  o0 = s; o1 = p[-dd];
);
// down 2x: two samples in -> one out
function dq_dninit(n, h, sz) instance(buf, sz2, w, hu, np, mm, cc) local(j) (
  buf = alloc(2 * sz); sz2 = sz; w = 0; mm = (n + 1) / 2; np = mm / 2; cc = (n - 1) / 2;
  hu = alloc(np); j = 0; loop(np, hu[j] = h[2 * j]; j += 1; );
);
function dq_dn(x0, x1) instance(buf, sz2, w, hu, np, mm, cc) local(j, s, p) (
  w += 1; w >= sz2 ? w = 0; buf[w] = x0; buf[w + sz2] = x0;
  w += 1; w >= sz2 ? w = 0; buf[w] = x1; buf[w + sz2] = x1;
  p = buf + w + sz2 - 1; s = 0; j = 0;                  // the output sits on the even phase (x0), like the input
  loop(np, s += hu[j] * (p[-2 * j] + p[2 * (j + 1 - mm)]); j += 1; );
  s + 0.5 * p[-cc];
);
dq_hbdesign(dq_H1, 63, 8); dq_hbdesign(dq_H2, 23, 7);
dqu1L.dq_upinit(63, dq_H1, 64); dqu1R.dq_upinit(63, dq_H1, 64); dqd1L.dq_dninit(63, dq_H1, 64); dqd1R.dq_dninit(63, dq_H1, 64);
dqu2L.dq_upinit(23, dq_H2, 16); dqu2R.dq_upinit(23, dq_H2, 16); dqd2L.dq_dninit(23, dq_H2, 32); dqd2R.dq_dninit(23, dq_H2, 32);
dq_LAT = 37;                                            // the up / down chain's latency at 1x (measured)

// ---------- curves ----------
// tanh (Pade 3/2), exact 1 with zero slope at +/-3: smooth and cheap
function dq_th(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
// biased soft curve with unity small-signal gain and no static offset: saturates at about +/-1/d
function dq_cv(x, d, b) local(z0) (
  z0 = min(max(d * b, -2.9), 2.9);
  (dq_th(d * (x + b)) - dq_th(z0)) * 9 * sqr(3 + z0 * z0) / (d * sqr(9 - z0 * z0));
);
// hard clip's antiderivative (for the anti-aliased clippers)
function dq_hcF(u) ( abs(u) <= 1 ? 0.5 * u * u : abs(u) - 0.5; );
// dq_th's antiderivative, and the curves built on it, for the anti-aliased (first-order antiderivative) stages:
// each keeps its previous argument and antiderivative in two memory slots (st)
function dq_Fth(z) local(a) ( a = abs(z); a < 3 ? z * z / 18 + 1.3333333 * log(1 + z * z / 3) : a - 0.6516075; );
// dq_cv, anti-aliased
function dq_acv(x, d, b, st) local(z, F, dz, y, z0) (
  z = d * (x + b); F = dq_Fth(z); dz = z - st[0];
  y = abs(dz) > 0.00001 ? (F - st[1]) / dz : dq_th(0.5 * (z + st[0]));
  st[0] = z; st[1] = F;
  z0 = min(max(d * b, -2.9), 2.9);
  (y - dq_th(z0)) * 9 * sqr(3 + z0 * z0) / (d * sqr(9 - z0 * z0));
);
// the germanium curve: the positive half bends early, the negative half late
function dq_Fge(v) ( v >= 0 ? dq_Fth(v) : dq_Fth(0.55 * v) / 0.3025; );
function dq_age(v, st) local(F, dv, y) (
  F = dq_Fge(v); dv = v - st[0];
  y = abs(dv) > 0.00001 ? (F - st[1]) / dv : ( v = 0.5 * (v + st[0]); v >= 0 ? dq_th(v) : dq_th(0.55 * v) / 0.55; );
  st[0] = v + (abs(dv) > 0.00001 ? 0 : 0.5 * dv); st[1] = F;
  y;
);
// the console knee: perfectly linear up to k, then a smooth soft clip to 1 (k differs for the two halves)
function dq_Fkn(u, kp, kn) local(a, k) (
  k = u > 0 ? kp : kn; a = abs(u);
  a < k ? 0.5 * u * u : k * a - 0.5 * k * k + sqr(1 - k) * dq_Fth((a - k) / (1 - k));
);
function dq_akn(u, kp, kn, st) local(F, du, y, a, k, m) (
  F = dq_Fkn(u, kp, kn); du = u - st[0];
  abs(du) > 0.00001 ? y = (F - st[1]) / du : (
    m = 0.5 * (u + st[0]); k = m > 0 ? kp : kn; a = abs(m);
    y = a < k ? m : sign(m) * (k + (1 - k) * dq_th((a - k) / (1 - k)));
  );
  st[0] = u; st[1] = F;
  y;
);
// an ideal slew-rate limit, solved exactly for a target that moves in a straight line from y0 to y1 over the
// sample (so the corners fall where they really are, not on the sample grid): returns the new output
function dq_slx(o, y0, y1, S) local(m, e0, sg, den, tc, oc) (
  m = y1 - y0; e0 = y0 - o;
  abs(e0) < 0.000000001 ? (
    abs(m) <= S ? y1 : o + sign(m) * S;
  ) : (
    sg = e0 > 0 ? 1 : -1; den = S * sg - m;
    tc = den * sg > 0 ? e0 / den : 2;
    tc >= 1 ? o + sg * S : (
      oc = o + sg * S * tc;
      abs(m) <= S ? y1 : oc + sign(m) * S * (1 - tc);
    );
  );
);
// a soft dead zone round zero: y - d * th(y / d)
function dq_adz(y, d, st) local(F, dy, r) (
  F = 0.5 * y * y - d * d * dq_Fth(y / d); dy = y - st[0];
  r = abs(dy) > 0.00001 ? (F - st[1]) / dy : ( y = 0.5 * (y + st[0]); y - d * dq_th(y / d); );
  st[0] = y + (abs(dy) > 0.00001 ? 0 : 0.5 * dy); st[1] = F;
  r;
);

// ---------- the eight circuits, one channel (x in, the circuit's output at unity small-signal gain) ----------
// globals for the unit being run: dq_G drive gain, dq_G3 its cube root (matrix), dq_rx rectifier mix;
// per channel: dq_cb bias drift, dq_cg threshold drift
function dq_cir(c, x) instance(st, t1lo, t1lp, g2lp, g2env, g2lp2, o3e, o3x, o3F, o3sl, o3yp, o3p, o3lp,
                               m4h1, m4l1, m4h2, m4l2, m4l3, c5lp, b6ex, b6ey, b6x, b6F, b6dx, b6dy, b6lp,
                               h7a, h7x, h7F, h7b, h7lp, s8env, s8lp)
                     local(u, y, v, a, k, b, T, F, d, g) (
  c < 4 ? (
    c == 0 ? (                                          // 1 STUDIO CLEAN BOOST
      g = dq_G * dq_cg * 0.6; u = x * g;
      t1lo += (u - t1lo) * dq_k120;
      y = u - t1lo + dq_cv(t1lo, 1.4, 0.06 + dq_cb);    // the transformer core takes the lows first
      y = dq_cv(y, 0.35, 0.12 + dq_cb);                 // and a faint whole-band curve
      a = abs(y); a > 1.2 ? y = sign(y) * (1.2 + 0.25 * dq_th((a - 1.2) / 0.25));   // the op-amp's rails
      t1lp += (y - t1lp) * dq_k40k;
      t1lp / g;
    ) : c == 1 ? (                                      // 2 GERMANIUM CONSOLE
      g = dq_G * dq_cg; u = x * g;
      g2lp += (u - g2lp) * dq_k14k; u = g2lp;
      a = abs(u); g2env += (a - g2env) * (a > g2env ? dq_ka5 : dq_kr120);
      T = 1 / (1 + 0.25 * g2env);                       // the supply sags: the threshold follows the envelope
      b = 0.18 + dq_cb + 0.05 * min(g2env, 2);          // the bias floats with the level
      y = dq_age(u / T + b, st);                        // positive half bends early, negative late
      y = (y - dq_th(b)) * T * 9 * sqr(3 + b * b) / sqr(9 - b * b);
      g2lp2 += (y - g2lp2) * dq_k11k;
      g2lp2 / g;
    ) : c == 2 ? (                                      // 3 OP-AMP LINE DRIVER
      g = dq_G * dq_cg * 1.2; u = x * g;
      o3e += (u - o3e) * dq_k2500; u += 0.9 * (u - o3e);     // presence pre-emphasis (+5.6 dB)
      o3sl = dq_slx(o3sl, o3yp, u, dq_slew); o3yp = u;  // the slew rate limit (exact between samples)
      u = o3sl + 0.04 + dq_cb;                          // the rails are not quite equal
      F = dq_hcF(u); d = u - o3x;
      y = abs(d) > 0.00001 ? (F - o3F) / d : min(max(0.5 * (u + o3x), -1), 1);
      o3x = u; o3F = F;
      y -= 0.04 + dq_cb;
      o3p += (y - o3p) * dq_k2500; y -= 0.35 * (y - o3p);    // partial de-emphasis: it stays bright
      o3lp += (y - o3lp) * dq_k18k;
      o3lp / g;
    ) : (                                               // 4 TRANSISTOR MATRIX
      g = dq_G3 * dq_cg;
      v = x * g;
      m4h1 += (v - m4h1) * dq_k10; v -= m4h1;
      v = dq_cv(v, 1.3, 0.12 + dq_cb);
      v *= g; m4l1 += (v - m4l1) * dq_k18k; v = dq_cv(m4l1, 1.3, -0.08 - 0.5 * dq_cb);
      v *= g; m4h2 += (v - m4h2) * dq_k15; v -= m4h2;
      m4l2 += (v - m4l2) * dq_k14k; v = dq_cv(m4l2, 1.3, 0.1 + dq_cb);
      m4l3 += (v - m4l3) * dq_k11k;
      m4l3 / (g * g * g);
    );
  ) : (
    c == 4 ? (                                          // 1 CONSOLE OVERDRIVE
      g = dq_G * dq_cg * 0.9; u = x * g;
      y = dq_akn(u, 0.55 - dq_cb, 0.6 + dq_cb, st + 2);
      y += 0.05 * y * y;                                // the channel's faint 2nd
      c5lp += (y - c5lp) * dq_k20k;
      c5lp / g;
    ) : c == 5 ? (                                      // 2 BROADCAST LIMITER DRIVE
      g = dq_G * dq_cg * 1.4; u = x * g;
      y = dq_e0 * u + dq_e1 * b6ex - dq_ea * b6ey; b6ex = u; b6ey = y;  // 50 us pre-emphasis
      u = y + 0.3 * dq_cb;
      F = dq_hcF(u); d = u - b6x;
      y = abs(d) > 0.00001 ? (F - b6F) / d : min(max(0.5 * (u + b6x), -1), 1);
      b6x = u; b6F = F;
      y -= 0.3 * dq_cb;
      v = dq_de0 * y + dq_de1 * b6dx - dq_dea * b6dy; b6dx = y; b6dy = v;  // de-emphasis
      b6lp += (v - b6lp) * dq_k20k;
      b6lp / g;
    ) : c == 6 ? (                                      // 3 HARMONIC DISSONANCE
      g = dq_G * dq_cg * 0.8; u = x * g;
      h7a += (u - h7a) * dq_k700; v = u - h7a;          // the band above 700 Hz feeds the rectifier
      F = 0.5 * v * abs(v); d = v - h7x;                // full-wave rectifier, anti-aliased
      y = abs(d) > 0.00001 ? (F - h7F) / d : abs(0.5 * (v + h7x));
      h7x = v; h7F = F;
      h7b += (y - h7b) * dq_k150; y -= h7b;
      v = u + dq_rx * y;
      y = dq_acv(v, 0.9, 0.05 + dq_cb, st + 4);
      h7lp += (y - h7lp) * dq_k17k;
      h7lp / g;
    ) : (                                               // 4 STARVED RAIL
      g = dq_G * dq_cg * 1.1; u = x * g;
      T = 1 / (1 + 1.5 * s8env);                        // the rail sags with the current drawn
      b = 0.3 * (1 - T) + dq_cb;                        // and the bias slides as it sags
      y = T * dq_acv(u / T, 1, b, st + 6);
      a = abs(y); s8env += (a - s8env) * (a > s8env ? dq_ka1 : dq_kr90);
      d = 0.012 + 0.04 * (1 - T);                       // the starved bias: a soft dead zone round zero
      y = dq_adz(y, d, st + 8);
      s8lp += (y - s8lp) * dq_k13k;
      s8lp / g;
    );
  );
);
function dq_flush(c) instance(st, t1lo, t1lp, g2lp, g2env, g2lp2, o3e, o3x, o3F, o3sl, o3yp, o3p, o3lp,
                               m4h1, m4l1, m4h2, m4l2, m4l3, c5lp, b6ex, b6ey, b6x, b6F, b6dx, b6dy, b6lp,
                               h7a, h7x, h7F, h7b, h7lp, s8env, s8lp) (
  c == 0 ? ( t1lo = t1lp = 0; ) : c == 1 ? ( g2lp = g2env = g2lp2 = 0; memset(st, 0, 2); ) :
  c == 2 ? ( o3e = o3x = o3F = o3sl = o3yp = o3p = o3lp = 0; ) : c == 3 ? ( m4h1 = m4l1 = m4h2 = m4l2 = m4l3 = 0; ) :
  c == 4 ? ( c5lp = 0; memset(st + 2, 0, 2); ) : c == 5 ? ( b6ex = b6ey = b6x = b6F = b6dx = b6dy = b6lp = 0; ) :
  c == 6 ? ( h7a = h7x = h7F = h7b = h7lp = 0; memset(st + 4, 0, 2); ) : ( s8env = s8lp = 0; memset(st + 6, 0, 4); );
);
// denormal housekeeping (all states)
function dq_tiny(v) ( abs(v) < 0.000000000001 ? 0 : v; );
function dq_dnorm() instance(t1lo, t1lp, g2lp, g2env, g2lp2, o3e, o3x, o3F, o3sl, o3yp, o3p, o3lp,
                               m4h1, m4l1, m4h2, m4l2, m4l3, c5lp, b6ex, b6ey, b6x, b6F, b6dx, b6dy, b6lp,
                               h7a, h7x, h7F, h7b, h7lp, s8env, s8lp, dcx, dcy) (
  t1lo = dq_tiny(t1lo); t1lp = dq_tiny(t1lp); g2lp = dq_tiny(g2lp); g2env = dq_tiny(g2env); g2lp2 = dq_tiny(g2lp2);
  o3e = dq_tiny(o3e); o3sl = dq_tiny(o3sl); o3yp = dq_tiny(o3yp); o3p = dq_tiny(o3p); o3lp = dq_tiny(o3lp);
  m4h1 = dq_tiny(m4h1); m4l1 = dq_tiny(m4l1); m4h2 = dq_tiny(m4h2); m4l2 = dq_tiny(m4l2); m4l3 = dq_tiny(m4l3);
  c5lp = dq_tiny(c5lp); b6ey = dq_tiny(b6ey); b6dy = dq_tiny(b6dy); b6lp = dq_tiny(b6lp);
  h7a = dq_tiny(h7a); h7b = dq_tiny(h7b); h7lp = dq_tiny(h7lp); s8env = dq_tiny(s8env); s8lp = dq_tiny(s8lp);
  dcx = dq_tiny(dcx); dcy = dq_tiny(dcy);
);

// one unit channel: the circuit (crossfading on a change), level matched, DC blocked, BLEND with the input
function dq_ch(x) instance(dcx, dcy) local(w, y) (
  w = this.dq_cir(dq_uc, x) * dq_um;
  dq_uk < 1 ? w = w * dq_uk + this.dq_cir(dq_up, x) * dq_upm * (1 - dq_uk);
  y = w - dcx + dq_dcr * dcy; dcx = w; dcy = y;
  x + (y - x) * dq_ubl;
);
// a biquad (coefficients at c: b0 b1 b2 a1 a2)
function dq_bq(x, c) instance(z1, z2) local(y) (
  y = c[0] * x + z1; z1 = c[1] * x - c[3] * y + z2; z2 = c[2] * x - c[4] * y; y;
);
function dq_bqf() instance(z1, z2) ( z1 = dq_tiny(z1); z2 = dq_tiny(z2); );
function dq_bqz() instance(z1, z2) ( z1 = z2 = 0; );
// RBJ designs at the oversampled rate: t 0 low shelf, 1 bell, 2 high shelf
function dq_eqset(k, t, f, gdb, q) local(w0, cw, sw, al, A, sa, n, c) (
  w0 = 2 * $pi * min(f, 0.45 * dq_fso) / dq_fso; cw = cos(w0); sw = sin(w0); A = 10 ^ (gdb / 40); c = dq_EQ + k * 5;
  t == 1 ? (
    al = sw / (2 * q); n = 1 + al / A;
    c[0] = (1 + al * A) / n; c[1] = -2 * cw / n; c[2] = (1 - al * A) / n; c[3] = c[1]; c[4] = (1 - al / A) / n;
  ) : (
    al = sw / (2 * 0.7071); sa = 2 * sqrt(A) * al;
    t == 0 ? (
      n = (A + 1) + (A - 1) * cw + sa;
      c[0] = A * ((A + 1) - (A - 1) * cw + sa) / n; c[1] = 2 * A * ((A - 1) - (A + 1) * cw) / n;
      c[2] = A * ((A + 1) - (A - 1) * cw - sa) / n; c[3] = -2 * ((A - 1) + (A + 1) * cw) / n; c[4] = ((A + 1) + (A - 1) * cw - sa) / n;
    ) : (
      n = (A + 1) - (A - 1) * cw + sa;
      c[0] = A * ((A + 1) + (A - 1) * cw + sa) / n; c[1] = -2 * A * ((A - 1) + (A + 1) * cw) / n;
      c[2] = A * ((A + 1) + (A - 1) * cw - sa) / n; c[3] = 2 * ((A - 1) - (A + 1) * cw) / n; c[4] = ((A + 1) - (A - 1) * cw - sa) / n;
    );
  );
);

// ---------- the level-matching table (dB, DRIVE 0, 3, ... 30 dB), measured on programme at -18 dBFS RMS ----------
function dq_mkrow(c, a0, a1, a2, a3, a4, a5, a6, a7, a8, a9, a10) local(p) (
  p = dq_MKT + c * 11; p[0] = a0; p[1] = a1; p[2] = a2; p[3] = a3; p[4] = a4; p[5] = a5;
  p[6] = a6; p[7] = a7; p[8] = a8; p[9] = a9; p[10] = a10;
);
dq_mkrow(0, 0.24, 0.28, 0.36, 0.50, 0.74, 1.13, 1.71, 2.55, 3.74, 5.30, 7.20);
dq_mkrow(1, 0.59, 0.71, 0.93, 1.32, 1.97, 2.99, 4.52, 6.68, 9.61, 13.28, 17.55);
dq_mkrow(2, -0.09, -0.09, -0.01, 0.35, 1.28, 2.87, 4.95, 7.28, 9.75, 12.30, 14.94);
dq_mkrow(3, 1.47, 1.66, 1.95, 2.38, 3.00, 3.87, 5.04, 6.55, 8.40, 10.56, 12.99);
dq_mkrow(4, 0.28, 0.28, 0.30, 0.43, 0.82, 1.65, 3.00, 4.84, 7.07, 9.58, 12.26);
dq_mkrow(5, 0.28, 0.32, 0.60, 1.47, 3.13, 5.36, 7.94, 10.70, 13.57, 16.49, 19.45);
dq_mkrow(6, 0.37, 0.44, 0.56, 0.80, 1.23, 1.92, 2.96, 4.39, 6.23, 8.42, 10.89);
dq_mkrow(7, 1.95, 2.12, 2.64, 3.59, 5.01, 6.86, 9.06, 11.52, 14.18, 16.97, 19.85);
function dq_mk(c, d) local(p, i, f, q) (
  p = min(max(d, 0), 30) / 3; i = min(floor(p), 9); f = p - i; q = dq_MKT + c * 11;
  10 ^ ((q[i] * (1 - f) + q[i + 1] * f) / 20);
);

// ---------- settings ----------
function dq_update() local(t) (
  // DRIVE 45 (unit A: circuits 0-3) and JDM-45 (unit B: circuits 4-7)
  dq_tonA = slider1 >= 0.5; dq_tcA = min(max(slider3 | 0, 0), 3);
  dq_tdA = min(max(slider4, 0), 30); dq_tblA = min(max(slider5, 0), 100) / 100; dq_toA = 10 ^ (slider6 / 20);
  dq_tonB = slider11 >= 0.5; dq_tcB = 4 + min(max(slider13 | 0, 0), 3);
  dq_tdB = min(max(slider14, 0), 30); dq_tblB = min(max(slider15, 0), 100) / 100; dq_toB = 10 ^ (slider16 / 20);
  dq_tord = slider21 >= 0.5;
  dq_tin = 10 ^ (slider22 / 20);
  drift_macro(slider23);
  dq_tog = 10 ^ (slider24 / 20);
  ost_setup(slider25 / 100, slider26 / 100, slider27, slider28, slider29, 1);   // output stage: CLIP, always on
  pdc_bot_ch = 0; pdc_top_ch = 2;
  pdc_delay = dq_LAT;
);

// ---------- presets ----------
function dq_setA(on, ci, dr, bl, ou, lo, mi, fq, hi) (
  slider1 = on; slider3 = ci; slider4 = dr; slider5 = bl; slider6 = ou; slider7 = lo; slider8 = mi; slider9 = fq; slider10 = hi;
);
function dq_setB(on, ci, dr, bl, ou, lo, mi, fq, hi) (
  slider11 = on; slider13 = ci; slider14 = dr; slider15 = bl; slider16 = ou; slider17 = lo; slider18 = mi; slider19 = fq; slider20 = hi;
);
function dq_setG(od, it, df) (
  slider21 = od; slider22 = it; slider23 = df;
  slider_automate(8388607);                             // sliders 1-23 (the output section stays)
);
function load_preset(p) (
  p == 1  ? ( dq_setA(1, 0,  8, 100,  0,    0,    0, 1000,    0); dq_setB(1, 0,  8, 100,  0,    0,    0, 1000,    0); dq_setG(0, 0, 50); ) : // Init
  p == 2  ? ( dq_setA(1, 1,  9,  70,  0,  1.5,    0, 1000, -0.5); dq_setB(1, 0,  6,  60, -0.7,   0, -1.0,  400,  1.0); dq_setG(0, 0, 50); ) : // Bus Warmth
  p == 3  ? ( dq_setA(1, 1, 14, 100,  0,  1.0, -1.0,  320,    0); dq_setB(0, 0,  8, 100,  0,    0,    0, 1000,    0); dq_setG(0, 0, 40); ) : // Germanium Glue
  p == 4  ? ( dq_setA(1, 2, 18,  75,  0, -2.0,  3.0, 1800,  2.0); dq_setB(1, 0,  6, 100,  0,    0,    0, 1000,    0); dq_setG(0, 0, 50); ) : // Line Driver Snare
  p == 5  ? ( dq_setA(1, 3, 16,  80,  0,  2.0, -3.0,  500, -2.0); dq_setB(0, 0,  8, 100,  0,    0,    0, 1000,    0); dq_setG(0, 0, 50); ) : // Matrix Bass
  p == 6  ? ( dq_setA(1, 0,  6, 100,  0,    0,    0, 1000,    0); dq_setB(1, 0, 11, 100, 0.8, -1.5, -1.5,  350,  2.5); dq_setG(0, 0, 50); ) : // Console Vocal
  p == 7  ? ( dq_setA(1, 1,  6, 100,  0,  1.0,    0, 1000,    0); dq_setB(1, 1, 18, 100, -2.5, 1.0, -1.0,  450,  1.0); dq_setG(0, 0, 50); ) : // Broadcast Slam Drums
  p == 8  ? ( dq_setA(1, 3,  8, 100,  0,    0,    0, 1000,    0); dq_setB(1, 2, 16,  55,  0, -2.0,  2.0, 3000,  1.5); dq_setG(0, 0, 60); ) : // Dissonant Synth
  p == 9  ? ( dq_setA(0, 0,  8, 100,  0,    0,    0, 1000,    0); dq_setB(1, 3, 20, 100, -1.5, 3.0, -4.0,  400,  1.0); dq_setG(0, 0, 50); ) : // Starved Kick
  p == 10 ? ( dq_setA(1, 2, 24,  35,  0,    0,    0, 1000,  1.0); dq_setB(1, 1, 20,  30,  0,    0,  1.5, 2500,    0); dq_setG(0, 0, 50); ) : // Parallel Crunch
  p == 11 ? ( dq_setA(1, 1, 10, 100,  0,  1.0,    0, 1000, -1.0); dq_setB(1, 0, 10, 100,  0,    0, -1.0,  600,  1.5); dq_setG(1, 0, 60); ) : // Tokyo-Berlin Chain
  p == 12 ? ( dq_setA(1, 3, 30, 100, -1,  2.0,    0, 1000, -3.0); dq_setB(1, 3, 26, 100, -2,    0,  3.0, 1500,    0); dq_setG(0, 0, 80); ) : // Full Melt
  p == 13 ? (                                           // Reset all to defaults
    dq_setA(1, 0, 8, 100, 0, 0, 0, 1000, 0); dq_setB(1, 0, 8, 100, 0, 0, 0, 1000, 0); dq_setG(0, 0, 50);
    slider24 = 0; slider25 = 0; slider26 = 30; slider27 = 120; slider28 = 6000; slider29 = -0.3; slider30 = 1;
    slider_automate(1073741823);                        // sliders 1-30
  );
);

// ---------- state ----------
// everything that depends on the sample rate (run again from @block if the rate changes)
function dq_k(f) ( 1 - exp(-2 * $pi * min(f, 0.45 * dq_fso) / dq_fso); );
function dq_srinit() local(K, w1, w2) (
  dq_sr = srate; dq_fso = 4 * srate;
  dq_k10 = dq_k(10); dq_k15 = dq_k(15); dq_k120 = dq_k(120); dq_k150 = dq_k(150); dq_k700 = dq_k(700);
  dq_k2500 = dq_k(2500);  dq_k11k = dq_k(11000); dq_k13k = dq_k(13000);
  dq_k14k = dq_k(14000); dq_k17k = dq_k(17000); dq_k18k = dq_k(18000); dq_k20k = dq_k(20000);
  dq_k40k = dq_k(40000);
  dq_ka1 = 1 - exp(-1 / (0.001 * dq_fso)); dq_ka5 = 1 - exp(-1 / (0.005 * dq_fso));
  dq_kr90 = 1 - exp(-1 / (0.09 * dq_fso)); dq_kr120 = 1 - exp(-1 / (0.12 * dq_fso));
  dq_slew = 80000 / dq_fso;                             // the line driver's slew rate: FS per oversampled sample
  dq_dcr = 1 - 2 * $pi * 5 / dq_fso;
  // 50 us pre-emphasis (zero at 3183 Hz, pole at 15.9 kHz) and its exact inverse, bilinear with prewarping
  K = 2 * dq_fso; w1 = K * tan($pi * 3183 / dq_fso); w2 = K * tan($pi * 15915 / dq_fso);
  dq_e0 = (K + w1) * (w2 / w1) / (K + w2); dq_e1 = (w1 - K) * (w2 / w1) / (K + w2); dq_ea = (w2 - K) / (K + w2);
  dq_de0 = (K + w2) * (w1 / w2) / (K + w1); dq_de1 = (w2 - K) * (w1 / w2) / (K + w1); dq_dea = (w1 - K) / (K + w1);
  dq_sm  = 1 - exp(-1 / (0.02 * srate));                // knob glides
  dq_swc = 1 - exp(-1 / (0.01 * srate));                // ON fades
  dq_xfc = 1 / (0.015 * srate);                         // circuit crossfade
  dq_odc = 1 / (0.005 * srate);                         // ORDER change: 5 ms dip, swap, 5 ms back
  dq_vw = 13.6; dq_vz = 0.81; dq_vdt = 1 / srate;       // VU needles (as Meter 45)
  dq_eql = -1;                                          // recompute the EQs
  ost_init(dq_ostm);
);
dq_srinit();
// fixed tolerances (left / right never quite match), redrawn per instance
dq_sbAL = rand(2) - 1; dq_sbAR = rand(2) - 1; dq_sgAL = rand(2) - 1; dq_sgAR = rand(2) - 1;
dq_sbBL = rand(2) - 1; dq_sbBR = rand(2) - 1; dq_sgBL = rand(2) - 1; dq_sgBR = rand(2) - 1;
dfbAL.drift_init(0.8 + rand(0.4)); dfbAR.drift_init(0.8 + rand(0.4)); dfgAL.drift_init(0.8 + rand(0.4)); dfgAR.drift_init(0.8 + rand(0.4));
dfbBL.drift_init(0.8 + rand(0.4)); dfbBR.drift_init(0.8 + rand(0.4)); dfgBL.drift_init(0.8 + rand(0.4)); dfgBR.drift_init(0.8 + rand(0.4));
dfeA.drift_init(0.7 + rand(0.4)); dfeB.drift_init(0.7 + rand(0.4));
dqoL.ost_ch_init(); dqoR.ost_ch_init();
dq_update();
dq_ciA = dq_prA = dq_tcA; dq_ciB = dq_prB = dq_tcB; dq_kA = dq_kB = 1;
dq_dA = dq_tdA; dq_dB = dq_tdB; dq_blA = dq_tblA; dq_blB = dq_tblB; dq_oA = dq_toA; dq_oB = dq_toB;
dq_onA = dq_tonA; dq_onB = dq_tonB; dq_in = dq_tin; dq_og = dq_tog; dq_ord = dq_tord; dq_od = 1; dq_oh = 0;
dq_bAL = dq_bAR = dq_bBL = dq_bBR = 0; dq_gAL = dq_gAR = dq_gBL = dq_gBR = 1;
dq_vy0 = dq_vy1 = dq_vy2 = dq_vy3 = 0; dq_vv0 = dq_vv1 = dq_vv2 = dq_vv3 = 0;
dq_iA = dq_xA = dq_iB = dq_xB = 0; dq_pkA = dq_pkB = 0; dq_p1l = dq_p1r = 0;
dqa_pkA = dqa_pkB = 0;

ui_thm = 5; ui_hw = 1;                                  // house keycaps for the preset bar and size picker
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );                  // new instances open in Large, on Init
ui_dflt = 1;

@slider
dq_update();

@block
srate != dq_sr ? dq_srinit();
dq_update();                                            // knobs moved on the panel do not run @slider
// circuit changes: crossfade from the old circuit to the new one (its state cleared first)
dq_tcA != dq_ciA && dq_kA >= 1 ? ( dq_prA = dq_ciA; dq_ciA = dq_tcA; dq_kA = 0; dqAL.dq_flush(dq_ciA); dqAR.dq_flush(dq_ciA); );
dq_tcB != dq_ciB && dq_kB >= 1 ? ( dq_prB = dq_ciB; dq_ciB = dq_tcB; dq_kB = 0; dqBL.dq_flush(dq_ciB); dqBR.dq_flush(dq_ciB); );
// DRIFT: component tolerance - bias points and thresholds wander, the EQ points wander, L / R never match
dq_di = 0.12 * dm_s * samplesblock / srate;
dq_bAL = dm_a * (0.03 * dfbAL.drift_tick(dq_di) + 0.012 * dq_sbAL); dq_bAR = dm_a * (0.03 * dfbAR.drift_tick(dq_di) + 0.012 * dq_sbAR);
dq_bBL = dm_a * (0.03 * dfbBL.drift_tick(dq_di) + 0.012 * dq_sbBL); dq_bBR = dm_a * (0.03 * dfbBR.drift_tick(dq_di) + 0.012 * dq_sbBR);
dq_gAL = 1 + dm_a * (0.03 * dfgAL.drift_tick(dq_di) + 0.01 * dq_sgAL); dq_gAR = 1 + dm_a * (0.03 * dfgAR.drift_tick(dq_di) + 0.01 * dq_sgAR);
dq_gBL = 1 + dm_a * (0.03 * dfgBL.drift_tick(dq_di) + 0.01 * dq_sgBL); dq_gBR = 1 + dm_a * (0.03 * dfgBR.drift_tick(dq_di) + 0.01 * dq_sgBR);
dq_feA = 1 + 0.02 * dm_a * dfeA.drift_tick(dq_di * 0.8); dq_feB = 1 + 0.02 * dm_a * dfeB.drift_tick(dq_di * 0.8);
// the EQs (gains glide per block; recomputed while anything moves)
dq_gl = 1 - exp(-samplesblock / (0.03 * srate));
dq_i = 0;
loop(6,
  dq_t = slider((dq_i < 3 ? 7 : 14) + dq_i + ((dq_i % 3) == 2));
  dq_t = min(max(dq_t, -15), 15);
  dq_eg[dq_i] += (dq_t - dq_eg[dq_i]) * dq_gl;
  abs(dq_eg[dq_i] - dq_t) < 0.005 ? dq_eg[dq_i] = dq_t;
  dq_i += 1;
);
dq_fA = min(max(slider9, 200), 8000) * dq_feA; dq_fB = min(max(slider19, 200), 8000) * dq_feB;
dq_ek = dq_eg[0] + 3 * dq_eg[1] + 7 * dq_eg[2] + 13 * dq_eg[3] + 17 * dq_eg[4] + 19 * dq_eg[5] + dq_fA * 0.001 + dq_fB * 0.0013 + dq_feA + dq_feB;
dq_ek != dq_eql ? (
  dq_eql = dq_ek;
  dq_eqset(0, 0, 100 * dq_feA, dq_eg[0], 0.7071); dq_eqset(1, 1, dq_fA, dq_eg[1], 0.9); dq_eqset(2, 2, 10000 * dq_feA, dq_eg[2], 0.7071);
  dq_eqset(3, 0, 100 * dq_feB, dq_eg[3], 0.7071); dq_eqset(4, 1, dq_fB, dq_eg[4], 0.9); dq_eqset(5, 2, 10000 * dq_feB, dq_eg[5], 0.7071);
);
dq_eA0 = abs(dq_eg[0]) > 0.001; dq_eA1 = abs(dq_eg[1]) > 0.001; dq_eA2 = abs(dq_eg[2]) > 0.001;
dq_eB0 = abs(dq_eg[3]) > 0.001; dq_eB1 = abs(dq_eg[4]) > 0.001; dq_eB2 = abs(dq_eg[5]) > 0.001;
!dq_eA0 ? ( eAL0.dq_bqz(); eAR0.dq_bqz(); ); !dq_eA1 ? ( eAL1.dq_bqz(); eAR1.dq_bqz(); ); !dq_eA2 ? ( eAL2.dq_bqz(); eAR2.dq_bqz(); );
!dq_eB0 ? ( eBL0.dq_bqz(); eBR0.dq_bqz(); ); !dq_eB1 ? ( eBL1.dq_bqz(); eBR1.dq_bqz(); ); !dq_eB2 ? ( eBL2.dq_bqz(); eBR2.dq_bqz(); );
// denormal housekeeping
dqAL.dq_dnorm(); dqAR.dq_dnorm(); dqBL.dq_dnorm(); dqBR.dq_dnorm();
eAL0.dq_bqf(); eAR0.dq_bqf(); eAL1.dq_bqf(); eAR1.dq_bqf(); eAL2.dq_bqf(); eAR2.dq_bqf();
eBL0.dq_bqf(); eBR0.dq_bqf(); eBL1.dq_bqf(); eBR1.dq_bqf(); eBL2.dq_bqf(); eBR2.dq_bqf();
dq_vy0 = dq_tiny(dq_vy0); dq_vy1 = dq_tiny(dq_vy1); dq_vy2 = dq_tiny(dq_vy2); dq_vy3 = dq_tiny(dq_vy3);
dq_vv0 = dq_tiny(dq_vv0); dq_vv1 = dq_tiny(dq_vv1); dq_vv2 = dq_tiny(dq_vv2); dq_vv3 = dq_tiny(dq_vv3);
// the panel's meters (mailboxes: the audio thread writes, the panel reads)
dqa_vu0 = dq_vy0; dqa_vu1 = dq_vy1; dqa_vu2 = dq_vy2; dqa_vu3 = dq_vy3;
dqa_pkA = max(dqa_pkA, dq_pkA); dq_pkA = 0; dqa_pkB = max(dqa_pkB, dq_pkB); dq_pkB = 0;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@sample
// ---------- glides ----------
dq_in += (dq_tin - dq_in) * dq_sm;
dq_og += (dq_tog - dq_og) * dq_sm;
dq_dA += (dq_tdA - dq_dA) * dq_sm; dq_dB += (dq_tdB - dq_dB) * dq_sm;
dq_blA += (dq_tblA - dq_blA) * dq_sm; dq_blB += (dq_tblB - dq_blB) * dq_sm;
dq_oA += (dq_toA - dq_oA) * dq_sm; dq_oB += (dq_toB - dq_oB) * dq_sm;
dq_onA += (dq_tonA - dq_onA) * dq_swc; dq_onB += (dq_tonB - dq_onB) * dq_swc;
dq_onA < 0.000001 ? dq_onA = 0; dq_onB < 0.000001 ? dq_onB = 0;
dq_kA < 1 ? dq_kA = min(dq_kA + dq_xfc, 1); dq_kB < 1 ? dq_kB = min(dq_kB + dq_xfc, 1);
// drive gains and the level-matching makeup of the running circuits (cheap enough per sample at 1x)
dq_GA = 10 ^ (dq_dA / 20); dq_G3A = dq_GA ^ 0.3333333 * 0.9; dq_GB = 10 ^ (dq_dB / 20);
dq_mA = dq_mk(dq_ciA, dq_dA); dq_mpA = dq_kA < 1 ? dq_mk(dq_prA, dq_dA) : 1;
dq_mB = dq_mk(dq_ciB, dq_dB); dq_mpB = dq_kB < 1 ? dq_mk(dq_prB, dq_dB) : 1;
dq_rxB = 0.2 + 0.035 * dq_dB;

// ---------- one unit, both channels, one oversampled sample ----------
function dq_unitA(l, r) local(yl, yr) (
  dq_onA > 0 ? (
    dq_uc = dq_ciA; dq_up = dq_prA; dq_uk = dq_kA; dq_um = dq_mA; dq_upm = dq_mpA; dq_ubl = dq_blA;
    dq_G = dq_GA; dq_G3 = dq_G3A;
    dq_cb = dq_bAL; dq_cg = dq_gAL; yl = dqAL.dq_ch(l);
    dq_cb = dq_bAR; dq_cg = dq_gAR; yr = dqAR.dq_ch(r);
    yl *= dq_oA; yr *= dq_oA;
    dq_eA0 ? ( yl = eAL0.dq_bq(yl, dq_EQ); yr = eAR0.dq_bq(yr, dq_EQ); );
    dq_eA1 ? ( yl = eAL1.dq_bq(yl, dq_EQ + 5); yr = eAR1.dq_bq(yr, dq_EQ + 5); );
    dq_eA2 ? ( yl = eAL2.dq_bq(yl, dq_EQ + 10); yr = eAR2.dq_bq(yr, dq_EQ + 10); );
    dq_onA < 1 ? ( yl = l + (yl - l) * dq_onA; yr = r + (yr - r) * dq_onA; );
  ) : ( yl = l; yr = r; );
  dq_ph0 ? ( dq_iA = max(abs(l), abs(r)); dq_xA = max(abs(yl), abs(yr)); );
  dq_ol = yl; dq_or = yr;
);
function dq_unitB(l, r) local(yl, yr) (
  dq_onB > 0 ? (
    dq_uc = dq_ciB; dq_up = dq_prB; dq_uk = dq_kB; dq_um = dq_mB; dq_upm = dq_mpB; dq_ubl = dq_blB;
    dq_G = dq_GB; dq_rx = dq_rxB;
    dq_cb = dq_bBL; dq_cg = dq_gBL; yl = dqBL.dq_ch(l);
    dq_cb = dq_bBR; dq_cg = dq_gBR; yr = dqBR.dq_ch(r);
    yl *= dq_oB; yr *= dq_oB;
    dq_eB0 ? ( yl = eBL0.dq_bq(yl, dq_EQ + 15); yr = eBR0.dq_bq(yr, dq_EQ + 15); );
    dq_eB1 ? ( yl = eBL1.dq_bq(yl, dq_EQ + 20); yr = eBR1.dq_bq(yr, dq_EQ + 20); );
    dq_eB2 ? ( yl = eBL2.dq_bq(yl, dq_EQ + 25); yr = eBR2.dq_bq(yr, dq_EQ + 25); );
    dq_onB < 1 ? ( yl = l + (yl - l) * dq_onB; yr = r + (yr - r) * dq_onB; );
  ) : ( yl = l; yr = r; );
  dq_ph0 ? ( dq_iB = max(abs(l), abs(r)); dq_xB = max(abs(yl), abs(yr)); );
  dq_ol = yl; dq_or = yr;
);
function dq_proc(l, r) (
  dq_ord ? ( dq_unitB(l, r); dq_unitA(dq_ol, dq_or); ) : ( dq_unitA(l, r); dq_unitB(dq_ol, dq_or); );
);

// ---------- 4x: up, the units, down ----------
dq_xl = spl0 * dq_in; dq_xr = spl1 * dq_in;
dqu1L.dq_up(dq_xl); dqu1R.dq_up(dq_xr);
// the 2x stream runs one 2x sample late (0.5 sample at 1x), so the whole chain's latency is a whole number of samples
dq_a1l = dqu1L.o0; dq_a1r = dqu1R.o0;
dqu2L.dq_up(dq_p1l); dqu2R.dq_up(dq_p1r);
dq_p1l = dqu1L.o1; dq_p1r = dqu1R.o1;
dq_ph0 = 1; dq_proc(dqu2L.o0, dqu2R.o0); dq_ph0 = 0; dq_q0l = dq_ol; dq_q0r = dq_or;
dq_proc(dqu2L.o1, dqu2R.o1);
dq_h0l = dqd2L.dq_dn(dq_q0l, dq_ol); dq_h0r = dqd2R.dq_dn(dq_q0r, dq_or);
dqu2L.dq_up(dq_a1l); dqu2R.dq_up(dq_a1r);
dq_proc(dqu2L.o0, dqu2R.o0); dq_q0l = dq_ol; dq_q0r = dq_or;
dq_proc(dqu2L.o1, dqu2R.o1);
dq_h1l = dqd2L.dq_dn(dq_q0l, dq_ol); dq_h1r = dqd2R.dq_dn(dq_q0r, dq_or);
dq_yl = dqd1L.dq_dn(dq_h0l, dq_h1l); dq_yr = dqd1R.dq_dn(dq_h0r, dq_h1r);

// ---------- meters: VU needles for each unit's input and output ----------
dq_vv0 += (dq_vw * dq_vw * (dq_iA * 1.5707963 - dq_vy0) - 2 * dq_vz * dq_vw * dq_vv0) * dq_vdt; dq_vy0 += dq_vv0 * dq_vdt;
dq_vv1 += (dq_vw * dq_vw * (dq_xA * 1.5707963 - dq_vy1) - 2 * dq_vz * dq_vw * dq_vv1) * dq_vdt; dq_vy1 += dq_vv1 * dq_vdt;
dq_vv2 += (dq_vw * dq_vw * (dq_iB * 1.5707963 - dq_vy2) - 2 * dq_vz * dq_vw * dq_vv2) * dq_vdt; dq_vy2 += dq_vv2 * dq_vdt;
dq_vv3 += (dq_vw * dq_vw * (dq_xB * 1.5707963 - dq_vy3) - 2 * dq_vz * dq_vw * dq_vv3) * dq_vdt; dq_vy3 += dq_vv3 * dq_vdt;
dq_pkA = max(dq_pkA, dq_xA); dq_pkB = max(dq_pkB, dq_xB);

// ---------- ORDER changes dip the output for a moment while the units are re-patched ----------
dq_tord != dq_ord ? ( dq_od = max(dq_od - dq_odc, 0); dq_od == 0 ? ( dq_ord = dq_tord; dq_oh = dq_LAT + 8; ); ) :
  dq_oh > 0 ? dq_oh -= 1 : dq_od < 1 ? dq_od = min(dq_od + dq_odc, 1);   // (held silent until the swap has come through)
dq_od < 1 ? ( dq_yl *= dq_od; dq_yr *= dq_od; );

// ---------- OUTPUT and the house output stage ----------
dq_yl = dqoL.ost_band(dq_yl) * dq_og;
dq_yr = dqoR.ost_band(dq_yr) * dq_og;
ost_out(dq_yl, dq_yr);
spl0 = abs(ost_l) < 0.00000000000000000001 ? 0 : ost_l;      // nothing below -400 dB reaches the host
spl1 = abs(ost_r) < 0.00000000000000000001 ? 0 : ost_r;

@gfx 1100 340
ui_begin(1100, 340);
gfx_setfont(6,  "Trebuchet MS", 27 * sc, 'b');          // title
gfx_setfont(10, "Trebuchet MS", 12.5 * sc, 'b');        // scale numbers
gfx_setfont(11, "Trebuchet MS", 13 * sc, 'b');          // labels
gfx_setfont(12, "Trebuchet MS", 13 * sc, 'b');          // key captions
gfx_setfont(13, "Courier New", 30 * sc, 'b');           // display digits
gfx_setfont(14, "Trebuchet MS", 14 * sc, 'b');          // knob names
gfx_setfont(15, "Trebuchet MS", 27 * sc, 'b');          // model names
gfx_setfont(16, "Trebuchet MS", 13 * sc, 'b');          // display print, VU scale, circuit names
gfx_setfont(17, "Trebuchet MS", 15 * sc, 'b');          // display circuit name

function dv_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function dv_fr(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc, 0); );
function dv_txt(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function dv_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function dv_rtxt(rx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = rx * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function dv_ltxt(lx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = lx * sc; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function dv_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );
// the language key (slider31): ENG / DE labels; the TOKYO / BERLIN keys only set the look (and the sound)
dv_de = slider31 >= 0.5;
// DE prints decimal commas
function dv_dec(s) local(i) ( dv_de ? ( i = 0; loop(strlen(s), str_getchar(s, i) == '.' ? str_setchar(s, i, ','); i += 1; ); ); s; );

// =====================================================================
// The unit faces: u = 0 DRIVE 45 / 1 JDM-45, b = BERLIN
// =====================================================================
function dv_style(u, b) (
  dv_u = u; dv_b = b;
  b ? (
    u == 0 ? (                                          // cream-grey baked enamel, heavy black linework
      KF  = 0xD6D2C4; KS = ui_mix(KF, 0x000000, 0.07); KT = ui_mix(KF, 0x000000, 0.14);
      KI  = 0x1C1C1C; KI2 = 0x4A4842; KA = 0xFF7900; KL = 0x1C1C1C; KHI = 0xB24A00;
      KD  = 0xFF8C00; KW = 0x141414; KG = 0x2A1C12; KLW = 2;
    ) : (                                               // battleship grey, black linework, mustard lamps
      KF  = 0x222528; KS = ui_mix(KF, 0x000000, 0.28); KT = ui_mix(KF, 0x000000, 0.42);
      KI  = 0xC7BEB3; KI2 = ui_mix(0xC7BEB3, KF, 0.38); KA = 0xD4A373; KL = 0x0B0C0D; KHI = 0xD4A373;
      KD  = 0xD4A373; KW = 0x0E0F10; KG = 0x2C302E; KLW = 2;
    );
  ) : (                                                 // charcoal, VFD glow (DRIVE 45 cyan, JDM-45 amber)
    KF  = 0x181A1B; KS = 0x131516; KT = 0x0F1112;
    KI  = 0xD5DCDE; KI2 = 0x7D888C; KA = u == 0 ? 0x4EE1DC : 0xFF8C00; KL = 0x2E3235; KHI = KA;
    KD  = KA; KW = 0x070808; KG = ui_mix(KA, 0x070808, 0.92); KLW = 1;
  );
);

// a section on the face: BERLIN a sharp enamel face with its frame, TOKYO a shallow recess
function dv_sect(x, y, w, h) (
  dv_b ? (
    ui_col(KL); dv_r(x, y, w, h);
    ui_col(KS); dv_r(x + KLW, y + KLW, w - 2 * KLW, h - 2 * KLW);
  ) : (
    pk_inset((x + 3) * sc, (y + 3) * sc, (w - 6) * sc, (h - 6) * sc, KS);
  );
);

// a key that lights up; returns 1 when clicked
function dv_key(x, y, w, h, lbl, on) local(hov, hit) (
  hov = dv_hov(x, y, w, h);
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  dv_b ? (
    dv_u == 0 ? (
      ui_col(KL); dv_r(x, y, w, h);
      on ? ui_col(KA) : ui_col(hov ? 0xF1EEE5 : ui_mix(KF, 0xFFFFFF, 0.35)); dv_r(x + 2, y + 2, w - 4, h - 4);
      on ? ( ui_cola(0xFFFFFF, 0.28); dv_r(x + 2, y + 2, w - 4, 1); );
      ui_col(KI);
    ) : (
      on ? ( ui_cola(KA, 0.22); dv_r(x - 3, y - 3, w + 6, h + 6); );
      ui_col(0x0B0C0D); dv_r(x, y, w, h);
      on ? ui_col(KA) : ui_col(hov ? 0x353A37 : 0x2C302E); dv_r(x + 1.5, y + 1.5, w - 3, h - 4);
      ui_cola(0xFFFFFF, on ? 0.3 : 0.08); dv_r(x + 1.5, y + 1.5, w - 3, 1);
      on ? ui_col(0x17191B) : ui_col(KI);
    );
  ) : (
    ui_cola(0x000000, 0.55); rd_rr((x + 0.5) * sc, (y + 2) * sc, w * sc, h * sc, 5 * sc);
    on ? ( ui_cola(KA, 0.18); rd_rr((x - 3) * sc, (y - 3) * sc, (w + 6) * sc, (h + 6) * sc, 7 * sc); );
    ui_col(0x0A0B0C); rd_rr(x * sc, y * sc, w * sc, h * sc, 5 * sc);
    on ? ui_col(ui_mix(KA, 0x000000, 0.12)) : ui_col(hov ? 0x34383B : 0x2A2D30);
    rd_rr((x + 1) * sc, (y + 1) * sc, (w - 2) * sc, (h - 2) * sc, 4 * sc);
    on ? ui_col(0x0B0C0D) : ui_col(0xB4BDC0);
  );
  gfx_setfont(12); dv_ctxt(x + w * 0.5, y + h * 0.5 + 0.5, lbl);
  hit;
);

// a status lamp (x, y = centre)
function dv_lamp(x, y, r, on, col) (
  dv_b && dv_u == 0 ? (
    ui_col(0x141414); gfx_circle(x * sc, y * sc, (r + 2.5) * sc, 1, 1);
    ui_col(0x8A867A); gfx_circle(x * sc, y * sc, (r + 1) * sc, 1, 1);
    rd_lamp(x, y, r, on, col);
  ) : (
    on ? ( ui_cola(col, 0.25); gfx_circle(x * sc, y * sc, (r + 4) * sc, 1, 1); );
    ui_col(0x050606); gfx_circle(x * sc, y * sc, (r + 1.2) * sc, 1, 1);
    ui_col(on ? col : ui_mix(col, 0x000000, 0.8)); gfx_circle(x * sc, y * sc, r * sc, 1, 1);
    on ? ( ui_cola(0xFFFFFF, 0.6); gfx_circle((x - r * 0.3) * sc, (y - r * 0.3) * sc, r * 0.3 * sc, 1, 1); );
  );
);

// a display window: BERLIN black glass in a black bezel, TOKYO smoked VFD glass
function dv_glass(x, y, w, h) (
  dv_b ? (
    ui_col(KL); dv_r(x - 2, y - 2, w + 4, h + 4);
    ui_col(KW); dv_r(x, y, w, h);
    ui_cola(0xFFFFFF, 0.05); dv_r(x, y, w, h * 0.4);
  ) : (
    ui_col(0x2E3235); dv_r(x - 1, y - 1, w + 2, h + 2);
    ui_col(KW); dv_r(x, y, w, h);
    ui_cola(KA, 0.035); dv_r(x, y, w, h);
    ui_cola(0xFFFFFF, 0.04); dv_r(x, y, w, 1);
  );
);
// glowing digits, right-aligned at rx, with their unlit ghost behind
function dv_digits(rx, cy, s, ghost, col) (
  gfx_setfont(13);
  ui_col(KG); dv_rtxt(rx, cy, ghost);
  ui_cola(col, 0.22); dv_rtxt(rx + 0.8, cy + 0.8, s);
  ui_col(col); dv_rtxt(rx, cy, s);
);
// a segmented bar: n segments, q = 0..1 lit; zone starts zA / zR (0..1). TOKYO: VFD segments; BERLIN: LED blocks.
function dv_bar(x, y, w, h, n, q, zA, zR) local(i, sw, p, lit, c, sx) (
  sw = w / n; i = 0;
  loop(n,
    sx = x + i * sw;
    p = (i + 0.5) / n;
    lit = q >= p;
    dv_b ? (
      c = dv_u == 0 ? ( p >= zR ? 0xFF3A2A : p >= zA ? 0xFFB030 : 0x46D86A ) : ( p >= zR ? 0xBC3908 : p >= zA ? 0xD4A373 : 0x2E7A48 );
      lit ? (
        ui_cola(c, 0.18); dv_r(sx - 0.5, y - 1, sw + 1, h + 2);
        ui_col(c); dv_r(sx + 1, y, sw - 2.5, h);
        ui_cola(0xFFFFFF, 0.25); dv_r(sx + 1, y, sw - 2.5, 1.5);
      ) : (
        ui_col(ui_mix(c, 0x000000, 0.8)); dv_r(sx + 1, y, sw - 2.5, h);
      );
    ) : (
      c = p >= zR ? (dv_u == 0 ? 0xFF8C00 : 0xFF4A2A) : KD;
      lit ? (
        ui_cola(c, 0.2); dv_r(sx - 0.5, y - 1.5, sw, h + 3);
        ui_col(c); dv_r(sx + 0.5, y, sw - 2, h);
        ui_cola(0xFFFFFF, 0.25); dv_r(sx + 0.5 + (sw - 2) * 0.5 - 0.5, y + 2, 1, h - 4);
      ) : (
        ui_col(ui_mix(c, 0x070808, 0.9)); dv_r(sx + 0.5, y, sw - 2, h);
      );
    );
    i += 1;
  );
);
// VU scale position (the needle deflects with voltage): -20 .. +3 VU -> 0..1
function dv_vupos(vu) local(v) ( v = 10 ^ (min(max(vu, -40), 3.6) / 20); min(max((v - 0.1) / 1.3125, 0), 1); );

// ---------- knobs ----------
// kind: 0 linear, 2 log (FREQ)
function dv_v2n(kind, v, lo, hi) ( kind == 2 ? log(max(v, lo) / lo) / log(hi / lo) : (v - lo) / (hi - lo); );
function dv_n2v(kind, n, lo, hi) ( n = min(max(n, 0), 1); kind == 2 ? lo * (hi / lo) ^ n : lo + (hi - lo) * n; );
// a printed tick and its number at n (0..1) round a knob
function dv_tick(cx, cy, r, n, s, big) local(a, ca, sa) (
  a = -0.75 * $pi + n * 1.5 * $pi; ca = sin(a); sa = -cos(a);
  dv_b ? (                                              // (TOKYO: the knob's own value ring takes the place of the ticks)
    ui_col(KI2);
    gfx_line((cx + ca * (r + 4)) * sc, (cy + sa * (r + 4)) * sc, (cx + ca * (r + (big ? 8 : 6))) * sc, (cy + sa * (r + (big ? 8 : 6))) * sc, 1);
    big ? gfx_line((cx + ca * (r + 4)) * sc + 1, (cy + sa * (r + 4)) * sc, (cx + ca * (r + 8)) * sc + 1, (cy + sa * (r + 8)) * sc, 1);
  );
  strlen(s) ? ( gfx_setfont(10); ui_col(KI); dv_ctxt(cx + ca * (r + 14), cy + sa * (r + 13), s); );
);
// numbers from a list "a|b|c", evenly spread
function dv_scale(cx, cy, r, labels) local(i, k, k0, len, c, n) (
  len = strlen(labels); n = 1; k = 0; loop(len, str_getchar(labels, k) == 124 ? n += 1; k += 1; );
  k0 = 0; i = 0; k = 0;
  loop(len + 1,
    c = k < len ? str_getchar(labels, k) : 124;
    c == 124 ? ( strcpy_substr(#dv_sl, labels, k0, k - k0); dv_tick(cx, cy, r, i / max(n - 1, 1), #dv_sl, 1); i += 1; k0 = k + 1; );
    k += 1;
  );
);
// eleven plain ticks round a knob
function dv_ticks(cx, cy, r) local(i) ( i = 0; loop(11, dv_tick(cx, cy, r, i / 10, "", i == 0 || i == 5 || i == 10); i += 1; ); );
// a smooth thick arc (pixels): anti-aliased arcs every half pixel
function dv_arcw(cx, cy, r, a1, a2, w) local(k) (
  k = -w * 0.5; loop(max(1, floor(w * 2) + 1), gfx_arc(cx, cy, r + k, a1, a2, 1); k += 0.5; );
);
// a straight pointer line, w pixels wide (pixel coordinates)
function dv_ptr(cx, cy, a, r1, r2, w) local(ca, sa, k) (
  ca = sin(a); sa = -cos(a); k = -w * 0.5;
  loop(max(1, floor(w * 2) + 1), gfx_line(cx + ca * r1 - sa * k, cy + sa * r1 + ca * k, cx + ca * r2 - sa * k, cy + sa * r2 + ca * k, 1); k += 0.5; );
);
// TOKYO knob: a smooth black rubber body with one soft highlight; ring = a thin track with the value arc glowing
// in the display colour
function dv_tcap(cx, cy, r, n, ring) local(rr, a, a0) (
  a0 = -0.75 * $pi; a = a0 + n * 1.5 * $pi;
  ring ? (
    rr = r + 5 * sc;
    ui_col(0x2A2E30); dv_arcw(cx, cy, rr, a0, 0.75 * $pi, 1.4 * sc);
    n > 0.004 ? (
      ui_col(ui_mix(KA, KS, 0.78)); dv_arcw(cx, cy, rr, a0, a, 5 * sc);
      ui_col(KA); dv_arcw(cx, cy, rr, a0, a, 2.2 * sc);
      gfx_circle(cx + sin(a0) * rr, cy - cos(a0) * rr, 1.1 * sc, 1, 1); gfx_circle(cx + sin(a) * rr, cy - cos(a) * rr, 1.1 * sc, 1, 1);
    );
  );
  ui_cola(0x000000, 0.5); gfx_circle(cx + 1.5 * sc, cy + 3 * sc, r, 1, 1);
  ui_col(0x090A0B); gfx_circle(cx, cy, r, 1, 1);
  ui_col(0x1B1E20); gfx_circle(cx, cy, r - 1.5 * sc, 1, 1);
  ui_col(0x34383B); dv_arcw(cx, cy, r - 2.5 * sc, -0.66 * $pi, 0.06 * $pi, 1.2 * sc);
  ui_col(ui_mix(KA, 0xFFFFFF, 0.35)); dv_ptr(cx, cy, a, r * 0.3, r - 4 * sc, 2 * sc);
);
// BERLIN knob: a plain dark skirt, a flat satin-silver face with one soft highlight on its edge, a black pointer
function dv_bcap(cx, cy, r, a) (
  ui_cola(0x000000, 0.35); gfx_circle(cx + 1.5 * sc, cy + 3 * sc, r, 1, 1);
  ui_col(0x1A1B1E); gfx_circle(cx, cy, r, 1, 1);
  ui_col(0x5B6168); gfx_circle(cx, cy, r * 0.8, 1, 1);
  ui_col(0xB7BCC2); gfx_circle(cx, cy, r * 0.8 - 1.2 * sc, 1, 1);
  ui_col(0xDCDFE3); dv_arcw(cx, cy, r * 0.8 - 2.6 * sc, -0.66 * $pi, 0.06 * $pi, 1.3 * sc);
  ui_col(0x141416); dv_ptr(cx, cy, a, r * 0.2, r * 0.95, 2 * sc);
);
// a knob: cap 0 = the unit's main knob (TOKYO rubber / BERLIN cast aluminium), otherwise a small house knob with
// that cap colour. Its name below; the value replaces it while touched.
function dv_knob(cx, cy, r, idx, kind, lo, hi, def, cap, name, val, ly) local(v, n, dx, dy, hov, did, a, tw, th) (
  did = 1800 + idx; v = slider(idx);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 5) * sc);
  pressed && hov && drag_id == 0 ? (
    time_precise() - dv_lt < 0.35 && dv_lid == idx ? ( slider(idx) = def; ui_auto(idx); drag_id = -1; dv_lt = 0; ) : (
      drag_id = did; dv_y = mouse_y; dv_lt = time_precise(); dv_lid = idx; dv_n = dv_v2n(kind, v, lo, hi);
    );
  );
  drag_id == did ? (
    dv_n = min(max(dv_n + (dv_y - mouse_y) / (((mouse_cap & 8) ? 1200 : 220) * sc), 0), 1); dv_y = mouse_y;
    v = dv_n2v(kind, dv_n, lo, hi);
    v = kind == 2 ? floor(v + 0.5) : floor(v * 10 + 0.5) / 10;
    slider(idx) != v ? ( slider(idx) = v; ui_auto(idx); );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    n = min(max(dv_v2n(kind, v, lo, hi) + mouse_wheel / 120 * ((mouse_cap & 8) ? 0.005 : 0.025), 0), 1);
    v = dv_n2v(kind, n, lo, hi); v = kind == 2 ? floor(v + 0.5) : floor(v * 10 + 0.5) / 10;
    slider(idx) = v; ui_auto(idx); mouse_wheel = 0;
  );
  v = slider(idx); n = dv_v2n(kind, v, lo, hi); a = -0.75 * $pi + n * 1.5 * $pi;
  cap == 0 ? (
    dv_b ? dv_bcap(cx * sc, cy * sc, r * sc, a) : dv_tcap(cx * sc, cy * sc, r * sc, n, 1);
  ) : dy_fcap(cx * sc, cy * sc, r * sc, a, cap);
  dv_act = hov || drag_id == did;
  dv_act ? ( ui_cola(0xFFFFFF, 0.08); gfx_circle(cx * sc, cy * sc, (r + 3) * sc, 1, 1); );
  gfx_setfont(cap == 0 ? dv_kf : 11);
  dv_act ? ( gfx_measurestr(val, tw, th); ui_col(dv_bg); gfx_rect(cx * sc - tw * 0.5 - 3 * sc, (cy + ly) * sc - th * 0.5, tw + 6 * sc, th); );
  ui_col(dv_act ? KHI : KI);
  dv_ctxt(cx, cy + ly, dv_act ? val : name);
);

// ---------- the CIRCUIT switch: a stepped rotary, four detents (9, 11, 1 and 3 o'clock), the circuits printed
// round it; the numeral at the selected detent lights up
function dv_selang(i) ( (-90 + 60 * i) * $pi / 180; );
function dv_sel(cx, cy, r, idx, n1, n2, n3, n4) local(v, dx, dy, hov, did, a, i, ca, sa, lx, ly, nx, ny, s, tw, th, hit, on) (
  did = 1900 + idx; v = min(max(slider(idx) | 0, 0), 3);
  dx = mouse_x - cx * sc; dy = mouse_y - cy * sc; hov = dx * dx + dy * dy <= sqr((r + 6) * sc);
  pressed && hov && drag_id == 0 ? ( drag_id = did; dv_y = mouse_y; dv_sv = v; );
  drag_id == did ? (
    i = min(max(dv_sv + floor((dv_y - mouse_y) / (26 * sc) + 0.5), 0), 3);
    i != v ? ( slider(idx) = i; ui_auto(idx); v = i; );
  );
  hov && mouse_wheel != 0 && drag_id == 0 ? (
    v = min(max(v + sign(mouse_wheel), 0), 3); slider(idx) = v; ui_auto(idx); mouse_wheel = 0;
  );
  i = 0;
  loop(4,
    a = dv_selang(i); ca = sin(a); sa = -cos(a);
    s = i == 0 ? n1 : i == 1 ? n2 : i == 2 ? n3 : n4;
    on = i == v;
    // the detent's numeral
    nx = cx + ca * (r + 13); ny = cy + sa * (r + 13);
    gfx_setfont(14);
    on ? ( ui_cola(KA, 0.28); gfx_circle(nx * sc, ny * sc, 8.5 * sc, 1, 1); ui_col(dv_b && dv_u == 0 ? KHI : KA); ) : ui_col(KI2);
    sprintf(#dvn, "%d", i + 1); dv_ctxt(nx, ny + 0.5, #dvn);
    // the name beside it (click to select)
    gfx_setfont(16); gfx_measurestr(s, tw, th); tw /= sc; th /= sc;
    lx = i < 2 ? nx - 10 - tw : nx + 10; ly = ny;
    hit = (dv_hov(lx - 2, ly - th * 0.5 - 2, tw + 4, th + 4) || dv_hov(nx - 8, ny - 8, 16, 16)) && pressed && drag_id == 0;
    hit ? ( drag_id = -1; slider(idx) = i; ui_auto(idx); v = i; );
    ui_col(on ? KHI : KI); dv_ltxt(lx, ly, s);
    i += 1;
  );
  // the knob: a skirted pointer knob
  a = dv_selang(v);
  dv_b ? dv_bcap(cx * sc, cy * sc, r * sc, a) : dv_tcap(cx * sc, cy * sc, r * sc, (v * 60 + 45) / 270, 0);
  (hov || drag_id == did) ? ( ui_cola(0xFFFFFF, 0.08); gfx_circle(cx * sc, cy * sc, (r + 3) * sc, 1, 1); );
);

// =====================================================================
// A half-rack unit: case, corner screws, model plate, style keys and ON key
// =====================================================================
function dv_unit(x, y, w, h, model, s1, s2, sidx, oidx) local(tw, th) (
  ui_cola(0x000000, 0.45); dv_r(x + 2, y + 4, w, h);
  ui_col(dv_b ? KL : 0x050606); dv_r(x, y, w, h);
  ui_col(KF); dv_r(x + KLW, y + KLW, w - 2 * KLW, h - 2 * KLW);
  !dv_b ? ( ui_cola(0xFFFFFF, 0.06); dv_r(x + 1, y + 1, w - 2, 1); gfx_gradrect((x + 1) * sc, (y + 1) * sc, (w - 2) * sc, 40 * sc, 1, 1, 1, 0.03, 0, 0, 0, 0, 0, 0, 0, -0.03 / (40 * sc)); );
  rd_screw(x + 11, y + 11); rd_screw(x + w - 11, y + 11); rd_screw(x + 11, y + h - 11); rd_screw(x + w - 11, y + h - 11);
  // model plate
  gfx_setfont(15); ui_col(KI); dv_txt(x + 24, y + 8, model);
  gfx_measurestr(model, tw, th);
  dv_b ? ( ui_col(KA); dv_r(x + 24, y + 40, tw / sc, 3); ) : ( ui_col(KA); dv_r(x + 24, y + 41, tw / sc, 2); ui_cola(KA, 0.25); dv_r(x + 24, y + 40, tw / sc, 4); );
  gfx_setfont(11); ui_col(KI2); dv_txt(x + 29 + tw / sc, y + 11, s1); dv_txt(x + 29 + tw / sc, y + 26, s2);
  // style keys and ON
  dv_key(x + w - 176, y + 10, 56, 26, "TOKYO", !dv_b) ? ( slider(sidx) = 0; ui_auto(sidx); );
  dv_key(x + w - 116, y + 10, 60, 26, "BERLIN", dv_b) ? ( slider(sidx) = 1; ui_auto(sidx); );
  dv_key(x + w - 52, y + 10, 40, 26, dv_de ? "EIN" : "ON", slider(oidx) >= 0.5) ? ( slider(oidx) = slider(oidx) >= 0.5 ? 0 : 1; ui_auto(oidx); );
);

// =====================================================================
// A unit's controls (u = 0 / 1, x = its left edge, b = its first slider)
// =====================================================================
function dv_face(u, x, b, vi, vo, pk) local(c, on, dc, gx, gy, p, i, v, cx) (
  on = slider(b) >= 0.5; c = min(max(slider(b + 2) | 0, 0), 3);
  // ---------- the display: circuit number and name, IN / OUT VU ----------
  dv_sect(x + 12, 106, 214, 104);
  gx = x + 20; gy = 114; dv_glass(gx, gy, 198, 88);
  dc = on ? KD : ui_mix(KD, KW, 0.75);
  sprintf(#dvs, "%d", c + 1);
  dv_digits(gx + 30, gy + 20, #dvs, "8", dc);
  gfx_setfont(17); ui_col(dc);
  u == 0 ? (
    dv_de ? (
      dv_txt(gx + 40, gy + 5, c == 0 ? "STUDIO-" : c == 1 ? "GERMANIUM-" : c == 2 ? "OP-AMP-" : "TRANSISTOR-");
      dv_txt(gx + 40, gy + 21, c == 0 ? "VERSTÄRKUNG" : c == 1 ? "PULT" : c == 2 ? "LEITUNGSTREIBER" : "MATRIX");
    ) : (
      dv_txt(gx + 40, gy + 5, c == 0 ? "STUDIO" : c == 1 ? "GERMANIUM" : c == 2 ? "OP-AMP" : "TRANSISTOR");
      dv_txt(gx + 40, gy + 21, c == 0 ? "CLEAN BOOST" : c == 1 ? "CONSOLE" : c == 2 ? "LINE DRIVER" : "MATRIX");
    );
  ) : (
    dv_de ? (
      dv_txt(gx + 40, gy + 5, c == 0 ? "PULT-" : c == 1 ? "RUNDFUNK-" : c == 2 ? "HARMONISCHE" : "UNTER-");
      dv_txt(gx + 40, gy + 21, c == 0 ? "ÜBERSTEUERUNG" : c == 1 ? "BEGRENZER" : c == 2 ? "DISSONANZ" : "SPANNUNG");
    ) : (
      dv_txt(gx + 40, gy + 5, c == 0 ? "CONSOLE" : c == 1 ? "BROADCAST" : c == 2 ? "HARMONIC" : "STARVED");
      dv_txt(gx + 40, gy + 21, c == 0 ? "OVERDRIVE" : c == 1 ? "LIMITER DRIVE" : c == 2 ? "DISSONANCE" : "RAIL");
    );
  );
  // VU bars, the scale, and the clip lamp (the unit's output over full scale)
  gfx_setfont(16); ui_col(dv_b ? KD : KI2);
  dv_ltxt(gx + 7, gy + 49, dv_de ? "EIN" : "IN"); dv_ltxt(gx + 7, gy + 64, dv_de ? "AUS" : "OUT"); dv_ltxt(gx + 7, gy + 78, "VU");
  dv_bar(gx + 44, gy + 44, 118, 10, dv_b ? 18 : 36, on ? dv_vupos(vi) : 0, 0.463, 0.686);
  dv_bar(gx + 44, gy + 59, 118, 10, dv_b ? 18 : 36, on ? dv_vupos(vo) : 0, 0.463, 0.686);
  gfx_setfont(16); ui_col(dv_b ? ui_mix(KD, KW, 0.4) : KI2);
  i = 0;
  loop(5, v = i == 0 ? -20 : i == 1 ? -7 : i == 2 ? -3 : i == 3 ? 0 : 3;
    v > 0 ? sprintf(#dvs, "+%d", v) : sprintf(#dvs, "%d", v);
    dv_ctxt(gx + 44 + 118 * dv_vupos(v), gy + 78, #dvs); i += 1; );
  dv_lamp(gx + 180, gy + 49, 4, on && dv_now - pk < 0.3, 0xFF3A2A);
  gfx_setfont(16); ui_col(dv_b ? KD : KI2); dv_ctxt(gx + 180, gy + 64, "CLIP");

  // ---------- the CIRCUIT switch ----------
  dv_sect(x + 232, 106, 246, 104);
  cx = x + 352;
  u == 0 ? (
    dv_de ? dv_sel(cx, 156, 21, b + 2, "REIN", "GERMANIUM", "LEITUNG", "MATRIX")
         : dv_sel(cx, 156, 21, b + 2, "CLEAN", "GERMANIUM", "LINE DRV", "MATRIX");
  ) : (
    dv_de ? dv_sel(cx, 156, 21, b + 2, "PULT", "RUNDFUNK", "DISSONANZ", "UNTERSPG.")
         : dv_sel(cx, 156, 21, b + 2, "CONSOLE", "BROADCAST", "DISSONANCE", "STARVED");
  );
  gfx_setfont(14); ui_col(KI); dv_ctxt(cx, 192, dv_de ? "SCHALTUNG" : "CIRCUIT");

  // ---------- DRIVE, BLEND, OUTPUT ----------
  dv_sect(x + 12, 214, 246, 114);
  dv_bg = KS; dv_kf = 14;
  sprintf(#dvv, "+%.1f dB", slider(b + 3)); dv_dec(#dvv);
  dv_scale(x + 53, 268, 23, "0||15||30");
  dv_knob(x + 53, 268, 23, b + 3, 0, 0, 30, 8, 0, dv_de ? "ANTRIEB" : "DRIVE", #dvv, 44);
  sprintf(#dvv, "%.0f %%", slider(b + 4));
  dv_scale(x + 135, 268, 23, "0|5|10");
  dv_knob(x + 135, 268, 23, b + 4, 0, 0, 100, 100, 0, dv_de ? "MISCHUNG" : "BLEND", #dvv, 44);
  sprintf(#dvv, "%+.1f dB", slider(b + 5)); dv_dec(#dvv);
  dv_scale(x + 217, 268, 23, "-24||0|+12");
  dv_knob(x + 217, 268, 23, b + 5, 0, -24, 12, 0, 0, dv_de ? "PEGEL" : "OUTPUT", #dvv, 44);

  // ---------- EQ ----------
  dv_sect(x + 264, 214, 214, 114);
  gfx_setfont(11); ui_col(KI2); dv_ctxt(x + 371, 228, dv_de ? "ENTZERRER" : "STUDIO EQ");
  cx = x + 293; dv_kf = 16;
  sprintf(#dvv, "%+.1f dB", slider(b + 6)); dv_dec(#dvv);
  dv_ticks(cx, 272, 17); dv_knob(cx, 272, 17, b + 6, 0, -15, 15, 0, 0, dv_de ? "TIEFEN" : "LOW", #dvv, 40);
  sprintf(#dvv, "%+.1f dB", slider(b + 7)); dv_dec(#dvv);
  dv_ticks(cx + 52, 272, 17); dv_knob(cx + 52, 272, 17, b + 7, 0, -15, 15, 0, 0, dv_de ? "MITTEN" : "MID", #dvv, 40);
  v = slider(b + 8); v < 1000 ? sprintf(#dvv, "%.0f Hz", v) : sprintf(#dvv, "%.2f kHz", v / 1000); dv_dec(#dvv);
  dv_ticks(cx + 104, 272, 17); dv_knob(cx + 104, 272, 17, b + 8, 2, 200, 8000, 1000, 0, "FREQ", #dvv, 40);
  sprintf(#dvv, "%+.1f dB", slider(b + 9)); dv_dec(#dvv);
  dv_ticks(cx + 156, 272, 17); dv_knob(cx + 156, 272, 17, b + 9, 0, -15, 15, 0, 0, dv_de ? "HÖHEN" : "HIGH", #dvv, 40);
);

// =====================================================================
// Panel and header
// =====================================================================
KH = 0x2A2D30; KHI_ = 0xEEEFEA;
ui_col(0x1D1F21); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(KH); dv_r(0, 0, 1100, 54);
ui_cola(0xFFFFFF, 0.06); dv_r(0, 0, 1100, 1);
ui_col(0x111213); dv_r(0, 54, 1100, 2);
ui_col(KHI_); gfx_circle(31 * sc, 27 * sc, 16 * sc, 1, 1);
gfx_setfont(4); ui_col(KH); ui_text(31 * sc, 21.5 * sc, "GFX");
gfx_setfont(6); ui_col(KHI_); dv_txt(58, 12, "DRIVE-45");
gfx_setfont(11); ui_col(0xA99999); dv_txt(196, 14, dv_de ? "ACHT SCHALTUNGEN" : "EIGHT-CIRCUIT"); dv_txt(196, 29, dv_de ? "STUDIO-VERZERRER" : "STUDIO DRIVE RACK");
pk_pextra = "Reset all to defaults";                    // the house preset bar: PRESETS, prev / next, LCD
dv_k = pk_preset(380 * sc, 10 * sc, 600 * sc, 34 * sc, pr_cur,
  "Init|Bus Warmth|Germanium Glue|Line Driver Snare|Matrix Bass|Console Vocal|Broadcast Slam Drums|Dissonant Synth|Starved Kick|Parallel Crunch|Tokyo-Berlin Chain|Full Melt");
dv_k > 0 ? ( load_preset(dv_k); pr_cur = dv_k > 12 ? 1 : dv_k; );
// the language key (ENG / DE) with its amber LED, left of the size picker
ui_button(1004 * sc, 18 * sc, 27 * sc, 18 * sc, dv_de ? "DE" : "ENG", 0, 1) ? ( slider31 = dv_de ? 0 : 1; ui_auto(31); dv_de = slider31 >= 0.5; );
rd_led(995, 27, 3, dv_de, 0xFFA126);
ui_size_picker(1032 * sc, 18 * sc);

// ---------- meter readings (VU, sine-referenced: 0 VU = a sine peaking at -18 dBFS) ----------
dv_now = time_precise();
function dv_vu(y) ( 20 * log10(max(y, 0.000001)) + 18; );
dv_v0 = dv_vu(dqa_vu0); dv_v1 = dv_vu(dqa_vu1); dv_v2 = dv_vu(dqa_vu2); dv_v3 = dv_vu(dqa_vu3);
dqa_pkA >= 1 ? dv_ckA = dv_now; dqa_pkA = 0;
dqa_pkB >= 1 ? dv_ckB = dv_now; dqa_pkB = 0;

// =====================================================================
// LEFT UNIT: DRIVE 45 (x 8..500)
// =====================================================================
dv_style(0, slider2 >= 0.5);
dv_unit(8, 60, 492, 274, "DRIVE 45", dv_de ? "STUDIO-" : "STUDIO", dv_de ? "VERZERRER" : "DRIVE UNIT", 2, 1);
dv_face(0, 8, 1, dv_v0, dv_v1, dv_ckA);

// =====================================================================
// RIGHT UNIT: JDM-45 (x 600..1092)
// =====================================================================
dv_style(1, slider12 >= 0.5);
dv_unit(600, 60, 492, 274, "JDM-45", dv_de ? "RUNDFUNK-" : "BROADCAST", dv_de ? "SÄTTIGUNGSEINHEIT" : "SATURATION UNIT", 12, 11);
dv_face(1, 600, 11, dv_v2, dv_v3, dv_ckB);

// =====================================================================
// The central mounting bracket: ORDER, INPUT, DRIFT, OUTPUT and band SAT (x 490..610)
// =====================================================================
KF = 0x9DA2A8; KI = 0x1C1C1C; KI2 = 0x3A3D40; KHI = 0x8A2E00; dv_b = 1; dv_u = 0; dv_bg = 0xA3A8AE;
ui_cola(0x000000, 0.5); dv_r(492, 62, 120, 276);
rd_brushed(490, 58, 120, 278, 0x9AA0A6);
ui_cola(0x000000, 0.45); dv_fr(490, 58, 120, 278);
ui_cola(0xFFFFFF, 0.35); dv_r(491, 59, 118, 1);
ui_cola(0x000000, 0.25); dv_r(501, 66, 1, 264); dv_r(598, 66, 1, 264);
rd_screw(500, 70); rd_screw(600, 70); rd_screw(500, 324); rd_screw(600, 324);
gfx_setfont(11); ui_col(0x1C1C1C); dv_ctxt(550, 74, dv_de ? "KETTE" : "ORDER");
// ORDER: two lit keys, the chain drawn on the key
function dv_okey(y, rev) local(on, c) (
  on = (slider21 >= 0.5) == rev;
  ui_okey(512, y, 76, 20, on, 0x46D86A) ? ( slider21 = rev; ui_auto(21); );
  gfx_setfont(12); ui_col(0x141414);
  dv_rtxt(542, y + 10, rev ? "JDM" : "45");
  gfx_triangle(545 * sc, (y + 6) * sc, 545 * sc, (y + 14) * sc, 551 * sc, (y + 10) * sc);
  dv_ltxt(554, y + 10, rev ? "45" : "JDM");
);
dv_okey(86, 0); dv_okey(110, 1);
sprintf(#dvv, "%+.1f dB", slider22);
dv_ticks(526, 182, 13); dv_knob(526, 182, 13, 22, 0, -24, 12, 0, 0x9DA2A8, dv_de ? "EING." : "INPUT", #dvv, 27);
sprintf(#dvv, "%.0f %%", slider23);
dv_ticks(574, 182, 13); dv_knob(574, 182, 13, 23, 0, 0, 100, 50, 0x6F8794, "DRIFT", #dvv, 27);
sprintf(#dvv, "%+.1f dB", slider24);
dv_ticks(526, 262, 13); dv_knob(526, 262, 13, 24, 0, -24, 12, 0, 0x9DA2A8, dv_de ? "AUSG." : "OUTPUT", #dvv, 27);
sprintf(#dvv, "%.0f %%", slider25);
dv_ticks(574, 262, 13); dv_knob(574, 262, 13, 25, 0, 0, 100, 0, 0xD8B040, dv_de ? "SÄTT." : "SAT", #dvv, 27);

pk_end();
ui_end();
