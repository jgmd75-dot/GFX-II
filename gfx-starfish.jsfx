gs_ = slide(732, 116, 140, 2, slider13, 0xF2F4FA, "", "PATTERN  FREE / LOOP"); gs_ != slider13 ? ( slider13 = gs_; ui_auto(13); );
gs_ = slide(732, 156, 140, 3, slider1, 0xE0402E, "", "ENV / S&H / BOTH"); gs_ != slider1 ? ( slider1 = gs_; ui_auto(1); );

