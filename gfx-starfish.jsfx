sprintf(#v, "%+.1f dB", slider16); dy_knob(742, 236, 16, 16, -12, 12, 0, 0, WHT, "OUTPUT", #v);
starfish(830, 236, 30, 0.25); star(866, 206, 6, WHT); star(800, 204, 5, SKYB);

