gi = 0; loop(3, gx_ = 384 + gi * 26;
  ui_col(slider11 == gi ? WHT : BLUD); gfx_circle(gx_ * sc, 230 * sc, 10 * sc, 1, 1);
  ui_col(WHT); gfx_circle(gx_ * sc, 230 * sc, 10 * sc, 0, 1);
  gfx_setfont(6, "Arial", 11 * sc, 'b'); ui_col(slider11 == gi ? BLU : WHT); ui_text(gx_ * sc, 224 * sc, gi == 0 ? "1" : gi == 1 ? "2" : "4");
  pressed && drag_id == 0 && (mouse_x - gx_ * sc) ^ 2 + (mouse_y - 230 * sc) ^ 2 < (11 * sc) ^ 2 ? ( slider11 = gi; ui_auto(11); drag_id = -1; );
  gi += 1; );
gfx_setfont(5); ui_col(WHT); ui_text(410 * sc, 248 * sc, "MULT");
sprintf(#v, "%.0f%%", slider12); dy_knob(482, 236, 16, 12, 0, 100, 15, 0, WHT, "GLIDE", #v);
