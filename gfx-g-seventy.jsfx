desc:GFX G Seventy
//tags: instrument synth mono lead bass analog 70s
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-voice, gfx-output, gfx-ui, gfx-panel, gfx-instrument, gfx-dyn and gfx-faceplate (.jsfx-inc) in the same folder.
//
// A monophonic synth in the spirit of the mid-70s two-oscillator Japanese monos:
//   VCO 1      triangle, saw, square, pulse, or pulse-width modulated by the MG; six octaves, 64' to 2'.
//   VCO 2      saw, ring-modulated against VCO 1, or white / pink / red noise; TUNE offsets it from VCO 1.
//   BLEND      the mix of the two sources.
//   TRAVELER   the two horizontal sliders: a high-pass and a low-pass filter in series, 12 dB each,
//              with a three-step RESONANCE switch; EG and MG switches set how far the envelope and the MG move them.
//   AUTO BEND  a pitch bend into every new note (up or down, with its own time); VIBRATO has its own LFO.
//   ENVELOPE   attack, decay, sustain, release for the filter and the amp. Last-note priority, portamento.
//
// DRIFT (heavy, 70s unstable; 60% by default): the universal GFX instrument drift pushed harder - pitch,
// VCO 2 detune, pulse width and the Traveler filters wander, with a random tuning offset on each new note -
// and the envelope's timing wanders too, a little different on every note. 0% = steady.
// IN / OUT: the GFX band saturation and output stage (SAT and OFF / CLIP / LIM on the panel).

import gfx-drift.jsfx-inc
import gfx-voice.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:1<0,4,1{Triangle,Saw,Square,Pulse,PWM}>-VCO 1 wave
slider2:3<0,5,1{64',32',16',8',4',2'}>-VCO 1 octave
slider3:0<0,4,1{Saw,Ring,White noise,Pink noise,Red noise}>-VCO 2 source
slider4:0.1<-12,12,0.01>-VCO 2 tune (semitones)
slider5:30<0,100,1>-Blend (VCO 1 - VCO 2, %)
slider6:5<0.1,30,0.01>-MG rate (Hz)
slider7:50<0,100,1>-PWM depth (%)
slider8:5.5<1,12,0.01>-Vibrato rate (Hz)
slider9:0<0,100,1>-Vibrato depth (cents)
slider10:20<20,8000,1>-Traveler HPF (Hz)
slider11:2000<60,18000,1>-Traveler LPF (Hz)
slider12:0<0,2,1{Low,Mid,High}>-Resonance
slider13:1<0,2,1{Off,Half,Full}>-EG to filter
slider14:0<0,2,1{Off,Half,Full}>-MG to filter
slider15:5<1,5000,0.1>-Attack (ms)
slider16:600<10,8000,1>-Decay (ms)
slider17:60<0,100,1>-Sustain (%)
slider18:300<10,8000,1>-Release (ms)
slider19:0<-12,12,0.1>-Auto bend depth (semitones)
slider20:200<10,2000,1>-Auto bend time (ms)
slider21:0<0,1500,1>-Portamento (ms)
slider22:0<0,100,1>-Velocity (%)
slider23:60<0,100,1>-Drift (%)
slider24:0<-24,6,0.1>-Volume (dB)
slider25:0<0,11,1{Seventy Lead,64' Bass,Traveler Sweep,Ring Bells,PWM Strings,Auto Bend Brass,Whistle,Wind,Squelch,Theremin,Zap Drum,Hollow Pipe}>-Patch
slider26:0<0,100,1>-Band sat (%)
slider27:30<0,100,1>-Bias (%)
slider28:120<40,400,1>-Sat low band (Hz)
slider29:6000<2000,16000,10>-Sat high band (Hz)
slider30:-0.3<-24,0,0.1>-Ceiling / limit threshold (dB)
slider31:1<0,2,1{Off,Clip,Limit}>-Output stage

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-seventy";
HN = 1000; hcount = 0;                       // held-note stack (last-note priority)
memset(HN, 0, 128);
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
ins_drift_init();
sv_pal = 0;                                    // faceplate colour (trial)
sv_dE.drift_init(0.8 + rand(0.5));            // the envelope's slow timing wander
bend = 1; nd_mul = 1; cur = 60; tgt = 60; vel = 0.8; gate = 0; ab_v = 0;
sm = vo_coef(30);
dxp = dyp = 0; last_patch = -1; edited = 0;

// ---------- the Traveler filters: 12 dB state-variable (TPT), low-pass and high-pass outputs ----------
function sv_svf(x, fc, k) instance(ic1, ic2, lp, hp) local(g, a1, a2, a3, v1, v2, v3) (
  g = tan($pi * min(fc, srate * 0.45) / srate);
  a1 = 1 / (1 + g * (g + k)); a2 = g * a1; a3 = g * a2;
  v3 = x - ic2; v1 = a1 * ic1 + a2 * v3; v2 = ic2 + a2 * ic1 + a3 * v3;
  ic1 = 2 * v1 - ic1; ic2 = 2 * v2 - ic2;
  lp = v2; hp = x - k * v1 - v2;
);
// a naive triangle is clean enough (its harmonics fall fast); own phase
function sv_tri(inc) instance(ph) ( ph += inc; ph -= floor(ph); ph < 0.5 ? 4 * ph - 1 : 3 - 4 * ph; );

// per-patch level trim (keeps the hottest patches out of the output clipper; quieter ones are left alone)
function patch_trim(p) (
  p == 0 ? 1.000 : p == 1 ? 1.000 : p == 2 ? 0.440 : p == 3 ? 1.000 : p == 4 ? 0.720 : p == 5 ? 1.000 :
  p == 6 ? 0.320 : p == 7 ? 0.620 : p == 8 ? 1.000 : p == 9 ? 0.530 : p == 10 ? 1.000 : 1.000;
);

// ---------- patches ----------
function setvco(w, o, s2, tu, bl) ( slider1 = w; slider2 = o; slider3 = s2; slider4 = tu; slider5 = bl; );
function setmod(mr, pd, vr, vd) ( slider6 = mr; slider7 = pd; slider8 = vr; slider9 = vd; );
function settrv(hp, lp, rs, eg, mg) ( slider10 = hp; slider11 = lp; slider12 = rs; slider13 = eg; slider14 = mg; );
function setenv(a, d, s, r) ( slider15 = a; slider16 = d; slider17 = s; slider18 = r; );
function setperf(bd, bt, pt, vl) ( slider19 = bd; slider20 = bt; slider21 = pt; slider22 = vl; );
function load_patch(p) (
  p == 0  ? ( setvco(1, 3, 0, 0.12, 35); setmod(5, 50, 5.5, 12);  settrv(20, 1800, 1, 1, 0);  setenv(5, 700, 70, 300);   setperf(0, 200, 40, 0);   ) :   // Seventy Lead
  p == 1  ? ( setvco(2, 1, 0, 12.05, 30);setmod(5, 50, 5.5, 0);   settrv(20, 700, 1, 1, 0);   setenv(2, 450, 40, 120);   setperf(0, 200, 0, 30);   ) :   // 64' Bass (32' + VCO 2 an octave up)
  p == 2  ? ( setvco(1, 2, 0, 0.2, 50);  setmod(0.25, 50, 5, 0);  settrv(60, 900, 2, 0, 2);   setenv(10, 1000, 100, 600);setperf(0, 200, 0, 0);    ) :   // Traveler Sweep
  p == 3  ? ( setvco(2, 3, 1, 7.0, 75);  setmod(5, 50, 5, 0);     settrv(200, 6000, 1, 1, 0); setenv(1, 1600, 0, 1400);  setperf(0, 200, 0, 40);   ) :   // Ring Bells
  p == 4  ? ( setvco(4, 3, 0, 0.15, 25); setmod(0.6, 80, 5, 6);   settrv(150, 3200, 0, 0, 0); setenv(250, 800, 85, 700); setperf(0, 200, 0, 0);    ) :   // PWM Strings
  p == 5  ? ( setvco(1, 3, 0, 0.1, 40);  setmod(5, 50, 5.5, 8);   settrv(60, 1200, 1, 2, 0);  setenv(40, 500, 70, 250);  setperf(-1.5, 120, 0, 40);) :   // Auto Bend Brass
  p == 6  ? ( setvco(0, 4, 3, 0, 8);     setmod(5, 50, 6, 18);    settrv(400, 5000, 2, 0, 0); setenv(30, 300, 90, 400);  setperf(0.6, 90, 60, 0);  ) :   // Whistle
  p == 7  ? ( setvco(0, 3, 3, 0, 100);   setmod(0.15, 50, 5, 0);  settrv(300, 1500, 2, 0, 2); setenv(800, 2000, 90, 2000);setperf(0, 200, 0, 0);    ) :   // Wind
  p == 8  ? ( setvco(3, 2, 0, 0.1, 20);  setmod(5, 50, 5, 0);     settrv(20, 250, 2, 2, 0);   setenv(1, 280, 10, 120);   setperf(0, 200, 30, 50);  ) :   // Squelch
  p == 9  ? ( setvco(0, 3, 0, 0, 0);     setmod(5, 50, 6.2, 30);  settrv(20, 2500, 0, 0, 0); setenv(120, 500, 100, 500);setperf(0, 200, 180, 0);  ) :   // Theremin
  p == 10 ? ( setvco(0, 1, 2, 0, 35);    setmod(5, 50, 5, 0);     settrv(20, 3000, 1, 2, 0);  setenv(1, 180, 0, 150);    setperf(12, 70, 0, 60);   ) :   // Zap Drum
            ( setvco(2, 3, 0, 12.0, 45); setmod(4, 50, 5, 4);     settrv(250, 2200, 0, 1, 0); setenv(20, 600, 80, 350);  setperf(0, 200, 20, 20);  );    // Hollow Pipe
  slider25 = p; last_patch = p; edited = 0;
  slider_automate(2 ^ 22 - 1 + 2 ^ 24);          // sliders 1-22 and 25
);
function patch_name(p) (
  p == 0 ? "SEVENTY LEAD" : p == 1 ? "64' BASS" : p == 2 ? "TRAVELER SWEEP" : p == 3 ? "RING BELLS" :
  p == 4 ? "PWM STRINGS" : p == 5 ? "AUTO BEND BRASS" : p == 6 ? "WHISTLE" : p == 7 ? "WIND" :
  p == 8 ? "SQUELCH" : p == 9 ? "THEREMIN" : p == 10 ? "ZAP DRUM" : "HOLLOW PIPE";
);

// ---------- notes ----------
// the envelope's timing (DRIFT): slow wander plus a fresh offset on every new note
function env_times() local(f) (
  f = 2 ^ ((sv_ew + (rand(2) - 1) * 0.6) * drift * 0.35);
  aenv.vo_adsr_set(slider15 * f, slider16 * f, slider17 / 100, slider18 * f);
);
function note_on(n, v) local(i, f, legato) (
  legato = hcount > 0;
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? ( i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1; );
  hcount < 127 ? ( HN[hcount] = n; hcount += 1; );
  tgt = n; vel = v / 127;
  !legato ? ( nd_mul = ins_note_detune() * 2 ^ ((rand(2) - 1) * drift * 0.05 / 12); env_times(); );
  porta_ms <= 0 ? cur = n;                       // PORTA glides between every note when it is up
  ab_v = ab_d;                                    // AUTO BEND starts from its depth on every new note
  aenv.vo_adsr_gate(1, !legato);
  gate = 1;
  ins_midi_hit();
);
function note_off(n) local(i, f) (
  f = -1; i = 0; loop(hcount, HN[i] == n ? f = i; i += 1; );
  f >= 0 ? (
    i = f; loop(hcount - f - 1, HN[i] = HN[i + 1]; i += 1; ); hcount -= 1;
    hcount > 0 ? ( tgt = HN[hcount - 1]; porta_ms <= 0 ? cur = tgt; ) : ( aenv.vo_adsr_gate(0, 0); gate = 0; );
  );
);

// ---------- parameters ----------
function update() (
  w1 = floor(slider1 + 0.5); oc1 = 2 ^ (floor(slider2 + 0.5) - 3);
  src2 = floor(slider3 + 0.5); tune2 = slider4; blend = slider5 / 100;
  mg_rate = slider6; pwm_d = slider7 / 100; vib_r = slider8; vib_d = slider9;
  hpf = slider10; lpf = slider11;
  rk = floor(slider12 + 0.5); rk = rk == 0 ? 1.7 : rk == 1 ? 0.85 : 0.22;
  eg_i = floor(slider13 + 0.5) * 2.6; mg_i = floor(slider14 + 0.5) * 1.1;
  ab_d = slider19; ab_c = 1 - exp(-1 / (max(slider20, 1) * 0.001 * srate / 4.6));
  porta_ms = slider21; porta_c = slider21 > 0 ? vo_coef(slider21) : 1;
  velsens = slider22 / 100;
  drift = slider23 / 100 * 1.6;                   // heavy: the universal drift pushed further
  vol_t = 10 ^ (slider24 / 20);
  ins_output_setup(26);
);
// recessed front-panel section (the GFX instrument inset): sloped walls, corner creases, light from the top left
function inset(x, y, w, h, col) local(b, ox, oy, ow, oh) (
  x *= sc; y *= sc; w *= sc; h *= sc; b = 5 * sc;
  ox = x - b; oy = y - b; ow = w + 2 * b; oh = h + 2 * b;
  ui_col(ui_mix(col, 0x000000, 0.30)); gfx_triangle(ox, oy, ox + ow, oy, x + w, y, x, y);
  ui_col(ui_mix(col, 0x000000, 0.18)); gfx_triangle(ox, oy, x, y, x, y + h, ox, oy + oh);
  ui_col(ui_mix(col, 0xFFFFFF, 0.30)); gfx_triangle(ox, oy + oh, x, y + h, x + w, y + h, ox + ow, oy + oh);
  ui_col(ui_mix(col, 0xFFFFFF, 0.12)); gfx_triangle(ox + ow, oy, ox + ow, oy + oh, x + w, y + h, x + w, y);
  ui_col(col); gfx_rect(x, y, w, h);
  gfx_gradrect(x, y, w, 6 * sc, 0, 0, 0, 0.14, 0, 0, 0, 0, 0, 0, 0, -0.14 / (6 * sc));
  ui_cola(0x000000, 0.30); gfx_line(ox, oy, x, y, 1); gfx_line(ox + ow, oy, x + w, y, 1);
  ui_cola(0xFFFFFF, 0.35); gfx_line(ox, oy + oh, x, y + h, 1); gfx_line(ox + ow, oy + oh, x + w, y + h, 1);
);
update();
vol_s = vol_t;
env_times();
ui_dflt = 1;

@slider
last_patch < 0 ? ( last_patch = slider25; ) : ( slider25 != last_patch ? load_patch(slider25); );
update();

@block
update();
while (midirecv(mofs, m1, m2, m3)) (
  st = m1 & 0xF0;
  st == 0x90 && m3 > 0 ? note_on(m2, m3) :
  st == 0x80 || (st == 0x90 && m3 == 0) ? note_off(m2) :
  st == 0xB0 && (m2 == 123 || m2 == 120) ? ( hcount = 0; aenv.vo_adsr_gate(0, 0); gate = 0; ) :
  st == 0xE0 ? bend = ins_bend(m2, m3, 2);
  midisend(mofs, m1, m2, m3);
);
ins_drift_block(drift, samplesblock);              // GFX instrument drift (heavy)
sv_ew = sv_dE.drift_tick(0.3 * samplesblock / srate);

@sample
// pitch: portamento, auto bend, vibrato, drift
cur += (tgt - cur) * porta_c;
ab_v -= ab_v * ab_c;
vb_ph += vib_r / srate; vb_ph -= floor(vb_ph);
semi = cur + ab_v + sin(2 * $pi * vb_ph) * vib_d / 100;
f1 = 440 * 2 ^ ((semi - 69) / 12) * bend * ins_pitch * nd_mul * oc1;
inc1 = min(f1 / srate, 0.45);
inc2 = min(inc1 * 2 ^ ((tune2 + ins_aux) / 12), 0.45);

// MG: the main LFO (triangle), for PWM and the filters
mg_ph += mg_rate / srate; mg_ph -= floor(mg_ph);
mg = mg_ph < 0.5 ? 4 * mg_ph - 1 : 3 - 4 * mg_ph;

// VCO 1
v1 = w1 == 0 ? t1.sv_tri(inc1) : w1 == 1 ? o1.vo_saw(inc1) : w1 == 2 ? o1.vo_pulse(inc1, 0.5) :
     w1 == 3 ? o1.vo_pulse(inc1, min(max(0.25 + ins_cut * 0.04, 0.08), 0.92)) :
               o1.vo_pulse(inc1, min(max(0.5 + mg * pwm_d * 0.44 + ins_cut * 0.04, 0.06), 0.94));

// VCO 2: saw, ring (VCO 1 x VCO 2), or noise
wn = rand(2) - 1;
src2 == 0 ? v2 = o2.vo_saw(inc2) :
src2 == 1 ? v2 = v1 * o2.vo_saw(inc2) :
src2 == 2 ? v2 = wn :
src2 == 3 ? ( pb0 = 0.99765 * pb0 + wn * 0.0990460; pb1 = 0.96300 * pb1 + wn * 0.2965164; pb2 = 0.57000 * pb2 + wn * 1.0526913;
              v2 = (pb0 + pb1 + pb2 + wn * 0.1848) * 0.22; ) :
            ( rn += (wn - rn) * 0.03; v2 = rn * 4; );
y = (v1 * (1 - blend) + v2 * blend) * 0.45;

// the Traveler: HPF then LPF, moved by the EG and the MG (and DRIFT)
ae = aenv.vo_adsr();
oct = eg_i * ae + mg_i * mg + ins_cut;
fh.sv_svf(y, min(max(hpf * 2 ^ oct, 15), srate * 0.45), rk); y = fh.hp;
fl.sv_svf(y, min(max(lpf * 2 ^ oct, 30), srate * 0.45), rk); y = fl.lp;
y = vo_tanh(y * 0.8) / 0.8;

// VCA
y *= ae * (1 - velsens + velsens * vel);

// DC block, volume, the GFX output stage
dy = y - dxp + 0.9995 * dyp; dxp = y; dyp = dy; y = dy;      // DC block low enough for 64' notes
vol_s += (vol_t - vol_s) * sm;
y *= patch_trim(slider25) * vol_s;
oL = ostL.ost_band(y); oR = ostR.ost_band(y);
ost_out(oL, oR);
spl0 = ost_l; spl1 = ost_r;
pkL = max(pkL, abs(spl0));

@serialize
file_var(0, ui_sz);
file_var(0, edited);

@gfx 960 540
ui_begin(960, 540);

// faceplate colours (sv_pal: 0 cream, 1 oxblood, 2 olive, 3 petrol, 4 chocolate, 5 slate) - colour trial
ORG = 0xE0701E; CAPO = 0xE0701E; CAPC = 0xF6EFDF; CAPG = 0x9DA2A8;
sv_pal == 0 ? ( PANEL = 0xF2E8D0; SH1 = 0xEADDBF; SH2 = 0xE3D4B2; SH3 = 0xDCCBA6; INK = 0x3A2A1E; DIMI = 0x7A6450; CAPD = 0x3B2A20; SQBG = 0x5A4636; BTX = 0xF2E8D0; ) :
sv_pal == 1 ? ( PANEL = 0x4A1D1F; SH1 = 0x572427; SH2 = 0x502023; SH3 = 0x461B1D; INK = 0xF2E8D0; DIMI = 0xCDAEA2; CAPD = 0xF2E8D0; SQBG = 0x2A1113; BTX = 0xFFF6E8; ) :
sv_pal == 2 ? ( PANEL = 0x3F4227; SH1 = 0x4A4D2F; SH2 = 0x43462A; SH3 = 0x393C23; INK = 0xEFE9D4; DIMI = 0xBDB89A; CAPD = 0xEFE9D4; SQBG = 0x23251A; BTX = 0xFFF6E8; ORG = 0xE08A1E; CAPO = 0xE08A1E; ) :
sv_pal == 3 ? ( PANEL = 0x1E4448; SH1 = 0x255157; SH2 = 0x21494E; SH3 = 0x1B3E42; INK = 0xEAF0E8; DIMI = 0x9FBDB9; CAPD = 0xEAF0E8; SQBG = 0x10272A; BTX = 0xFFF6E8; ) :
sv_pal == 4 ? ( PANEL = 0x3E2B21; SH1 = 0x4A3428; SH2 = 0x433024; SH3 = 0x39281E; INK = 0xF2E8D0; DIMI = 0xC2A68F; CAPD = 0xF2E8D0; SQBG = 0x231811; BTX = 0xFFF6E8; ) :
              ( PANEL = 0x3A4552; SH1 = 0x445160; SH2 = 0x3E4A58; SH3 = 0x35404C; INK = 0xEEF0F2; DIMI = 0xA9B4C0; CAPD = 0xEEF0F2; SQBG = 0x1F252D; BTX = 0xFFF6E8; );
SLOT = ui_mix(PANEL, 0x000000, 0.65);
dy_ink = INK; dy_bg = PANEL; dy_nov = 1; rd_sqbg = SQBG;

function setv(idx, v) ( slider(idx) = v; slider_automate(2 ^ (idx - 1)); edited = 1; );
// section title: an orange band across the top of the inset
function band(x, y, w, s) ( ui_col(ORG); gfx_rect(x * sc, y * sc, w * sc, 18 * sc); gfx_setfont(4); ui_col(BTX); gfx_x = (x + 8) * sc; gfx_y = (y + 3) * sc; gfx_drawstr(s); );
// a row of lit keys for a stepped slider
function keys(x, y, w, h, gap, idx, n, names) local(i) (
  i = 0;
  loop(n,
    strcpy_substr(#kn, names, i * 4, 4);
    while (strlen(#kn) > 0 && str_getchar(#kn, strlen(#kn) - 1) == ' ') ( strcpy_substr(#kn, #kn, 0, strlen(#kn) - 1); );
    rd_sq(x + i * (w + gap), y, w, h, floor(slider(idx) + 0.5) == i, ORG, #kn) ? setv(idx, i);
    i += 1;
  );
);
// the wave symbols on the WAVE keys: 0 triangle, 1 saw, 2 square, 3 narrow pulse, 4 PWM (pulse with a width arrow)
function wglyph(cx, cy, t, on) local(x0, x1, y0, y1, w, k) (
  ui_col(on ? 0x1A1210 : 0xE8DCC6); w = 30; x0 = cx - w / 2; x1 = cx + w / 2; y0 = cy - 7; y1 = cy + 7;
  k = 0; loop(2,
    t == 0 ? ( gfx_line(x0 * sc, (y1 + k) * sc, (cx - 7.5) * sc, (y0 + k) * sc, 1); gfx_line((cx - 7.5) * sc, (y0 + k) * sc, (cx + 7.5) * sc, (y1 + k) * sc, 1);
               gfx_line((cx + 7.5) * sc, (y1 + k) * sc, x1 * sc, (y0 + k) * sc, 1); ) :
    t == 1 ? ( gfx_line(x0 * sc, (y1 + k) * sc, cx * sc, (y0 + k) * sc, 1); gfx_line(cx * sc, (y0 + k) * sc, cx * sc, (y1 + k) * sc, 1);
               gfx_line(cx * sc, (y1 + k) * sc, x1 * sc, (y0 + k) * sc, 1); gfx_line(x1 * sc, (y0 + k) * sc, x1 * sc, (y1 + k) * sc, 1); ) :
    ( w = t == 2 ? 7.5 : 3.5;
      gfx_line(x0 * sc, (y1 + k) * sc, x0 * sc, (y0 + k) * sc, 1); gfx_line(x0 * sc, (y0 + k) * sc, (x0 + w) * sc, (y0 + k) * sc, 1);
      gfx_line((x0 + w) * sc, (y0 + k) * sc, (x0 + w) * sc, (y1 + k) * sc, 1); gfx_line((x0 + w) * sc, (y1 + k) * sc, (x0 + 15) * sc, (y1 + k) * sc, 1);
      gfx_line((x0 + 15) * sc, (y1 + k) * sc, (x0 + 15) * sc, (y0 + k) * sc, 1); gfx_line((x0 + 15) * sc, (y0 + k) * sc, (x0 + 15 + w) * sc, (y0 + k) * sc, 1);
      gfx_line((x0 + 15 + w) * sc, (y0 + k) * sc, (x0 + 15 + w) * sc, (y1 + k) * sc, 1); gfx_line((x0 + 15 + w) * sc, (y1 + k) * sc, x1 * sc, (y1 + k) * sc, 1); );
    k += 0.6;
  );
  t == 4 ? ( gfx_line((x0 + 15 - 1) * sc, (cy + 10) * sc, (x0 + 15 + 9) * sc, (cy + 10) * sc, 1);
             gfx_line((x0 + 15 + 9) * sc, (cy + 10) * sc, (x0 + 15 + 6) * sc, (cy + 8) * sc, 1); gfx_line((x0 + 15 + 9) * sc, (cy + 10) * sc, (x0 + 15 + 6) * sc, (cy + 12) * sc, 1);
             gfx_line((x0 + 15 - 1) * sc, (cy + 10) * sc, (x0 + 15 + 2) * sc, (cy + 8) * sc, 1); gfx_line((x0 + 15 - 1) * sc, (cy + 10) * sc, (x0 + 15 + 2) * sc, (cy + 12) * sc, 1); );
);
// the Traveler: a horizontal slider (log), orange handle; double-click resets; value shows on hover
function trav(x, y, w, idx, lo, hi, def, label) local(v, n, hx, did, hov) (
  did = 1700 + idx; v = slider(idx); n = log(v / lo) / log(hi / lo); hx = x + n * w;
  hov = mouse_x >= (x - 10) * sc && mouse_x <= (x + w + 10) * sc && mouse_y >= (y - 14) * sc && mouse_y <= (y + 14) * sc;
  pressed && hov && drag_id == 0 ? (
    time_precise() - tv_lt < 0.35 && tv_lid == idx ? ( setv(idx, def); drag_id = -1; tv_lt = 0; ) :
    ( drag_id = did; tv_lt = time_precise(); tv_lid = idx; );
  );
  drag_id == did ? (
    n = min(max((mouse_x / sc - x) / w, 0), 1); v = lo * (hi / lo) ^ n;
    slider(idx) != v ? ( slider(idx) = v; slider_automate(2 ^ (idx - 1)); edited = 1; );
  );
  n = log(slider(idx) / lo) / log(hi / lo); hx = x + n * w;
  ui_col(SLOT); gfx_rect(x * sc, (y - 3) * sc, w * sc, 6 * sc);                            // the slot
  ui_cola(0xFFFFFF, 0.35); gfx_rect(x * sc, (y + 3) * sc, w * sc, 1 * sc);
  i = 0; loop(11, ui_cola(INK, 0.55); gfx_rect((x + i * w / 10) * sc, (y + 9) * sc, 1 * sc, (i % 5 == 0 ? 7 : 4) * sc); i += 1; );
  ui_cola(0x000000, 0.3); gfx_rect((hx - 9) * sc, (y - 10) * sc, 20 * sc, 22 * sc);      // the handle
  ui_col(ORG); gfx_rect((hx - 10) * sc, (y - 11) * sc, 20 * sc, 22 * sc);
  ui_cola(0xFFFFFF, 0.35); gfx_rect((hx - 10) * sc, (y - 11) * sc, 20 * sc, 3 * sc);
  ui_col(0xFFF6E8); gfx_rect((hx - 1) * sc, (y - 9) * sc, 2 * sc, 18 * sc);
  gfx_setfont(5); ui_col(INK); gfx_x = (x - 44) * sc; gfx_y = (y - 6) * sc; gfx_drawstr(label);
  (hov || drag_id == did) ? ( sprintf(#tv, "%.0f Hz", slider(idx)); rd_lbl(x + w + 34, y - 5, #tv, INK, 1); );
);

