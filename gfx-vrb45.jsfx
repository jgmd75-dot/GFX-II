desc:GFX VRB45 [reverb]
//tags: reverb room plate hall gated reverse 3d early reflections broadcast 12-bit european japanese digital
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-bverb, gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel and gfx-lozenge (.jsfx-inc).
//
// VRB45: the 45 series digital reverbs, eight models in one - REGION (EU / JP keys at the top right) picks the
// European or the Japanese rack, and each keeps its own panel and its own four models.
//   EUROPEAN (80s broadcast reverbs): ROOM SIM (no modulation in the tail), BROADCAST (warm plate and hall),
//     DIALOGUE (dense speech reverb), NON-LIN (gated / reverse).
//   JAPANESE (80s studio and broadcast reverbs): HALL (massive modular hall), 3D (reflection engine), FLAGSHIP 40
//     (40 reflections), 12-BIT (the pioneer).
// The two share the reflection / reverb settings, filters, drive, clock, width, drift and the house input / output;
// NON-LIN SHAPE belongs to the European rack and BITS to the Japanese.
// Switching REGION fades out, starts the other rack clean and fades back in.

slider1:0<0,3,1{Room Sim / Hall,Broadcast / 3D,Dialogue / Flagship 40,Non-Lin / 12-Bit}>-Model (European / Japanese)
slider2:8<0,120,1>-1st reflection delay (ms)
slider3:-6<-30,6,0.5>-1st reflection level (dB, -30 = off)
slider4:24<0,250,1>-Reverb delay (ms)
slider5:0<-30,6,0.5>-Reverb level (dB, -30 = off)
slider6:2.4<0.1,20,0.05>-Reverb time (s)
slider7:0.75<0.1,1.5,0.05>-Reverb time, high end (x)
slider8:1.1<0.5,2.5,0.05>-Reverb time, low end (x)
slider9:2000<10,12000,1>-Room size (m3)
slider10:60<0,100,1>-Reflection density (%)
slider11:60<0,100,1>-Diffusion (%)
slider12:80<20,1000,1>-Lo cut (Hz)
slider13:12000<1000,20000,10>-Hi cut (Hz)
slider14:15<0,100,1>-Drive (%)
slider15:0<0,1,1{Modern,Vintage}>-Clock
slider16:1<0,2,1{Room,Gate,Reverse}>-Non-lin shape
slider17:100<0,150,1>-Width (%)
slider18:20<0,100,1>-Drift (%)
slider19:0.15<0.02,2,0.01>-Drift speed (Hz)
slider20:30<0,100,1>-Mix (%)
slider21:0<-24,12,0.1>-Output (dB)
slider22:0<0,100,1>-Band sat (%)
slider23:30<0,100,1>-Bias (%)
slider24:120<40,400,1>-Sat low band (Hz)
slider25:6000<2000,16000,10>-Sat high band (Hz)
slider26:-0.3<-24,0,0.1>-(unused, was output ceiling)
slider27:1<0,1,1{Off,Clip}>-(unused, was output stage)
slider28:0<-24,12,0.1>-Input trim (dB)
slider29:0<0,1,1{Off,On}>-Input guard
slider30:0<0,2,1{12,16,24}>-Bits (vintage, Japanese)
slider31:0<0,1,1{European,Japanese}>-Region

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-lozenge.jsfx-inc
import gfx-bverb.jsfx-inc

@init
ext_noinit = 1;

// ======================== European: initialisation and functions ========================
function e_er_room(e_sz, e_dens, e_ear) local(e_el, e_er_, Lx, Ly, e_Lz, sx, sy, e_sz_, lx, ly, e_lz, i, j, k, n, dx, dy, e_dz, d, e_d0, t, g, e_az, e_cnt, e_sw, e_tt, e_gg, a) (
  Lx = 16 * e_sz; Ly = 11 * e_sz; e_Lz = 6 * e_sz;               // a 16 x 11 x 6 m room at 1000 m3
  sx = 0.35 * Lx; sy = 0.62 * Ly; e_sz_ = 0.3 * e_Lz; lx = 0.7 * Lx; ly = 0.45 * Ly; e_lz = 0.32 * e_Lz;
  e_d0 = sqrt(sqr(sx - lx) + sqr(sy - ly) + sqr(e_sz_ - e_lz));
  n = 0;
  i = -2; loop(5, j = -2; loop(5, k = -1; loop(3,
    a = abs(i) + abs(j) + abs(k);
    a > 0 && a <= 2 && n < 48 ? (
      dx = (i & 1 ? (i + 1) * Lx - sx : i * Lx + sx) - lx;
      dy = (j & 1 ? (j + 1) * Ly - sy : j * Ly + sy) - ly;
      e_dz = (k & 1 ? (k + 1) * e_Lz - e_sz_ : k * e_Lz + e_sz_) - e_lz;
      d = sqrt(dx * dx + dy * dy + e_dz * e_dz);
      t = (d - e_d0) / 343;                                  // seconds after the direct sound
      g = e_d0 / d * (a == 1 ? 0.8 : 0.55);                  // spreading and wall absorption
      e_az = atan2(dy, dx);
      er_tl[n] = t; er_gl[n] = g * (0.55 + 0.45 * cos(e_az - 0.9)); er_gr[n] = g * (0.55 + 0.45 * cos(e_az + 0.9));
      er_tr[n] = t + 0.00025 * sin(e_az);                    // a quarter of a millisecond between the ears
      n += 1;
    );
    k += 1; ); j += 1; ); i += 1; );
  // sort by time (simple), keep the first few by density
  e_sw = 1; while(e_sw) ( e_sw = 0; i = 0; loop(n - 1,
    er_tl[i] > er_tl[i + 1] ? ( e_tt = er_tl[i]; er_tl[i] = er_tl[i + 1]; er_tl[i + 1] = e_tt; e_tt = er_tr[i]; er_tr[i] = er_tr[i + 1]; er_tr[i + 1] = e_tt;
      e_gg = er_gl[i]; er_gl[i] = er_gl[i + 1]; er_gl[i + 1] = e_gg; e_gg = er_gr[i]; er_gr[i] = er_gr[i + 1]; er_gr[i + 1] = e_gg; e_sw = 1; );
    i += 1; ); );
  e_cnt = floor(8 + e_dens * (n - 8));
  // even out: no single reflection jumps out, both ears get the same energy, the whole set a fixed level
  e_el = e_er_ = 0; i = 0; loop(e_cnt, er_gl[i] = sign(er_gl[i]) * min(abs(er_gl[i]), 0.45); er_gr[i] = sign(er_gr[i]) * min(abs(er_gr[i]), 0.45);
    e_el += sqr(er_gl[i]); e_er_ += sqr(er_gr[i]); i += 1; );
  i = 0; loop(e_cnt, er_gl[i] *= sqrt(0.35 / max(e_el, 0.0001)); er_gr[i] *= sqrt(0.35 / max(e_er_, 0.0001));
    er_gl[i] *= i & 1 ? -1 : 1; er_gr[i] *= i & 2 ? -1 : 1;
    er_tl[i] = max(1, floor(er_tl[i] * srate)); er_tr[i] = max(1, floor(er_tr[i] * srate)); i += 1; );
  e_cnt;
);
function e_er_pattern(m, e_sz, e_dens) local(i, n, t, g, p) (
  bv_seed(m == 1 ? 911 : m == 2 ? 1747 : 2311);
  n = m == 1 ? 8 : m == 2 ? 14 : 0;
  n = floor(n * (0.5 + 0.5 * e_dens)) + 2;
  i = 0;
  loop(n,
    t = m == 1 ? (5 + i * 7.5 + 4 * bv_rnd()) * (0.6 + 0.4 * e_sz) : (2 + i * 1.6 + 1.2 * bv_rnd()) * (0.5 + 0.5 * e_sz);
    g = (m == 1 ? 0.7 : 0.45) * (1 - i / (n + 2)) * (bv_rnd() > 0.5 ? 1 : -1);
    p = bv_rnd();
    er_tl[i] = max(1, floor(t * 0.001 * srate)); er_tr[i] = max(1, floor(t * (1.03 + 0.05 * p) * 0.001 * srate));
    er_gl[i] = g * (0.6 + 0.4 * p); er_gr[i] = g * (1 - 0.4 * p);
    i += 1; );
  n;
);
function e_nl_shape(len, e_shp, e_dens) local(k, t, g, e, e_s2) (
  bv_seed(5167); e_s2 = 0; k = 0;
  loop(nl_n,
    t = (k + 0.3 + 0.4 * bv_rnd() * (0.4 + e_dens)) / nl_n;
    e = e_shp == 0 ? exp(-5.5 * t) : e_shp == 1 ? (t < 0.85 ? 1 - 0.15 * t : (1 - t) / 0.15 * 0.87) : (0.08 + 0.92 * t ^ 1.6) * (t < 0.95 ? 1 : (1 - t) * 20);
    g = e * (bv_rnd() > 0.5 ? 1 : -1) * (0.7 + 0.3 * bv_rnd());
    nl_t[k] = max(1, floor(t * len * srate)); nl_g[k] = g; e_s2 += g * g;
    k += 1; );
  k = 0; loop(nl_n, nl_g[k] *= 1.4 / sqrt(max(e_s2, 0.0001)); k += 1; );
);
function e_update() local(k, e_sz, L, e_lens, e_er_s, e_dens) (
  e_mdl = slider1;
  e_sz = (slider9 / 1000) ^ (1 / 3);                         // 1000 m3 = 1
  bv_t60 = slider6 * (e_mdl == 0 ? 1.12 : e_mdl == 2 ? 0.91 : 1); bv_rthi = slider7; bv_rtlo = slider8;   // calibrated: the measured fade matches REVERB TIME
  e_dens = slider10 / 100; e_diff = slider11 / 100;
  e_erd_s = slider2 * 0.001 * srate; e_revd_s = slider4 * 0.001 * srate;
  e_er_g = slider3 <= -29.9 ? 0 : 10 ^ (slider3 / 20);
  e_rv_g = slider5 <= -29.9 ? 0 : 10 ^ (slider5 / 20) * (e_mdl == 3 ? 1 : 1.3);
  bv_lox = 250; bv_hix = e_mdl == 1 ? 2400 : e_mdl == 2 ? 4500 : 3500;
  e_mdl == 0 ? (
    er_n = e_er_room(e_sz, e_dens, 0);
    e_lens = 2300; e_lens[0] = 31.7; e_lens[1] = 37.1; e_lens[2] = 41.3; e_lens[3] = 47.9; e_lens[4] = 53.3; e_lens[5] = 61.1; e_lens[6] = 70.7; e_lens[7] = 79.3;
    k = 0; loop(8, L = min(e_lens[k] * 0.001 * srate * (0.25 + 0.75 * e_sz), LN_N - 4); ln_len[k] = L; bv_loss(k, L); ln_mod[k] = 0; k += 1; );
    fdn_apg = 0;
  ) : e_mdl == 1 ? (
    er_n = e_er_pattern(1, e_sz, e_dens);
    e_lens = 2300; e_lens[0] = 29.7; e_lens[1] = 37.1; e_lens[2] = 41.1; e_lens[3] = 43.7; e_lens[4] = 31.3; e_lens[5] = 39.7;
    k = 0; loop(6, L = min(e_lens[k] * 0.001 * srate * (0.55 + 0.45 * e_sz), LN_N - 4); cb_len[k] = L; bv_loss(k, L); k += 1; );
  ) : e_mdl == 2 ? (
    er_n = e_er_pattern(2, e_sz, e_dens);
    L = 0.35 + 0.5 * min(e_sz, 1.6);
    tk_d[0] = 0.1417 * L * srate; tk_d[1] = 0.1063 * L * srate; tk_d[2] = 0.1496 * L * srate; tk_d[3] = 0.1250 * L * srate;
    tk_a[0] = 0.0226 * L * srate; tk_a[1] = 0.0605 * L * srate; tk_a[2] = 0.0305 * L * srate; tk_a[3] = 0.0892 * L * srate;
    bv_loss(0, tk_d[0] + tk_d[1] + tk_a[0] + tk_a[1]); bv_loss(2, tk_d[2] + tk_d[3] + tk_a[2] + tk_a[3]);
    bv_loss(1, 1); bv_loss(3, 1); LN_G[3] = 1; LN_G[9] = 1;
  ) : (
    er_n = 0;
    e_nl_len = min(0.06 + bv_t60 * 0.2, 1.25);
    e_nl_shape(e_nl_len * (0.5 + 0.5 * min(e_sz, 2)), slider16, e_dens);
  );
  bv_xover();
  e_lc_c = 1 - exp(-2 * $pi * slider12 / srate);
  e_hc_c = 1 - exp(-2 * $pi * min(slider13, srate * 0.45) / srate);
  e_drv = slider14 / 100 * (e_mdl == 1 ? 1.6 : 1);
  lofi_set(slider15, e_mdl == 0 ? 34000 : e_mdl == 1 ? 32000 : e_mdl == 2 ? 40000 : 31250, e_mdl == 1 ? 14 : 16);
  e_wid = slider17 / 100;
  e_dft = slider18 / 100; e_dspd = slider19 * (0.5 + 0.5 * slider18 / 20);   // the wander speeds up with DRIFT (1x at its default 20%)
  e_mix_t = slider20 / 100; e_out_t = 10 ^ (slider21 / 20);
  ost_setup(slider22 / 100, slider23 / 100, slider24, slider25, slider26, 0);   // output stage: straight through
  in_setup(slider28, slider29);
);
function e_setp(m, e_erd, e_erl, e_rvd, e_rvl, t, hi, lo, e_vol, dn, df, lc, e_hc, e_dr, e_ck, sh, e_wd, mx) (
  slider1 = m; slider2 = e_erd; slider3 = e_erl; slider4 = e_rvd; slider5 = e_rvl; slider6 = t; slider7 = hi; slider8 = lo; slider9 = e_vol;
  slider10 = dn; slider11 = df; slider12 = lc; slider13 = e_hc; slider14 = e_dr; slider15 = e_ck; slider16 = sh; slider17 = e_wd; slider20 = mx;
);
function e_load_preset(p) (
  p == 1 ? e_setp(0, 6, -6, 18, 0, 1.4, 0.7, 1.0, 600, 70, 60, 120, 14000, 10, 0, 1, 110, 25) :      // Vocal Air
  p == 2 ? e_setp(0, 12, -4, 30, 0, 2.2, 0.6, 1.2, 4000, 80, 70, 60, 11000, 15, 0, 1, 120, 30) :     // Concert Room
  p == 3 ? e_setp(0, 2, -2, 8, -3, 0.8, 0.8, 1.0, 180, 90, 50, 100, 12000, 25, 0, 1, 100, 25) :      // Drum Room
  p == 4 ? e_setp(1, 4, -12, 12, 0, 1.8, 0.5, 1.0, 900, 60, 80, 150, 9000, 30, 0, 1, 100, 25) :      // Broadcast Plate
  p == 5 ? e_setp(1, 10, -8, 35, 0, 3.0, 0.45, 1.3, 3500, 60, 70, 80, 8000, 35, 1, 1, 110, 30) :     // Warm Hall (vintage)
  p == 6 ? e_setp(2, 2, -10, 4, -2, 0.5, 0.8, 0.8, 60, 80, 90, 200, 10000, 10, 0, 1, 80, 20) :       // Voice-Over Booth
  p == 7 ? e_setp(2, 6, -8, 14, 0, 1.2, 0.7, 0.9, 400, 70, 85, 150, 11000, 10, 0, 1, 100, 22) :      // Narration Space
  p == 8 ? e_setp(3, 0, -30, 0, 0, 1.8, 1.0, 1.0, 1000, 70, 60, 120, 12000, 20, 0, 1, 120, 35) :     // Gated Snare
  p == 9 ? e_setp(3, 0, -30, 20, 0, 3.5, 1.0, 1.0, 1500, 60, 50, 100, 10000, 10, 0, 2, 120, 40) :    // Reverse Swell
  p == 10 ? e_setp(0, 3, -8, 5, -6, 0.4, 0.9, 1.0, 120, 60, 50, 200, 13000, 5, 0, 1, 90, 20);        // Tight Ambience
  p >= 1 && p <= 10 ? ( e_lastp = p; ui_auto(1); i = 2; loop(16, ui_auto(i); i += 1; ); ui_auto(17); ui_auto(20); );
  p == 11 ? (
    e_setp(0, 8, -6, 24, 0, 2.4, 0.75, 1.1, 2000, 60, 60, 80, 12000, 15, 0, 1, 100, 30);
    slider18 = 20; slider19 = 0.15; slider21 = 0; slider22 = 0; slider23 = 30; slider24 = 120; slider25 = 6000; slider26 = -0.3; slider27 = 1;
    slider28 = 0; slider29 = 0; e_lastp = 0;
    i = 1; loop(29, ui_auto(i); i += 1; );
  );
);
function e_pv_text(k) local(v) (
  v = pv_get(k);
  k == 1 || k == 3 ? ( v <= -29.9 ? strcpy(#e_pt, "OFF") : sprintf(#e_pt, "%.1f", v); ) :
  k == 4 || k == 6 ? sprintf(#e_pt, "%.2f", v) :
  k == 5 ? ( v < 10 ? sprintf(#e_pt, "%.2f", v) : sprintf(#e_pt, "%.1f", v); ) :
  k == 11 || k == 22 ? sprintf(#e_pt, "%.1f", v / 1000) :
  k == 16 || k == 17 || k == 23 ? sprintf(#e_pt, "%.1f", v) :
  k == 18 ? sprintf(#e_pt, "%.2f", v) :
  sprintf(#e_pt, "%d", floor(v + 0.5));
  #e_pt;
);
function e_init() (
#ui_man = "gfx-e-verb";                                  // the ? pop-up links to this manual
bv_alloc(100000);

// room simulator reflections: images of a source in a shoebox room (first and second order), mono in, two ears out

// fixed patterns (ms, gain) for the other models, stretched by size, thinned by density

// the non-linear line: 40 taps over len seconds, envelope by shape




// ---------- presets ----------



// ---------- the parameters on the displays ----------
pv_def(0, 2, 0, 120, 1, 8, 0, 0);       pv_def(1, 3, -30, 6, 0.5, -6, 0, 1);
pv_def(2, 4, 0, 250, 1, 24, 0, 0);      pv_def(3, 5, -30, 6, 0.5, 0, 0, 1);
pv_def(4, 7, 0.1, 1.5, 0.05, 0.75, 0, 2); pv_def(5, 6, 0.1, 20, 0.05, 2.4, 1, 2);
pv_def(6, 8, 0.5, 2.5, 0.05, 1.1, 0, 2); pv_def(7, 9, 10, 12000, 1, 2000, 1, 0);
pv_def(8, 10, 0, 100, 1, 60, 0, 0);     pv_def(9, 11, 0, 100, 1, 60, 0, 0);
pv_def(10, 12, 20, 1000, 1, 80, 1, 0);  pv_def(11, 13, 1000, 20000, 10, 12000, 1, 1);
pv_def(12, 14, 0, 100, 1, 15, 0, 0);    pv_def(13, 17, 0, 150, 1, 100, 0, 0);
pv_def(14, 18, 0, 100, 1, 20, 0, 0);    pv_def(15, 20, 0, 100, 1, 30, 0, 0);
pv_def(16, 28, -24, 12, 0.1, 0, 0, 1);  pv_def(17, 21, -24, 12, 0.1, 0, 0, 1);
pv_def(18, 19, 0.02, 2, 0.01, 0.15, 1, 2); pv_def(19, 22, 0, 100, 1, 0, 0, 0);
pv_def(20, 23, 0, 100, 1, 30, 0, 0);    pv_def(21, 24, 40, 400, 1, 120, 1, 0);
pv_def(22, 25, 2000, 16000, 10, 6000, 1, 1); pv_def(23, 26, -24, 0, 0.1, -0.3, 0, 1);
// the text a display shows for parameter k

e_vsel = 5;   // the display the data wheel works on

e_drA.drift_init(0.8 + rand(0.5)); e_drB.drift_init(0.8 + rand(0.5));
ost_init(20000); e_ostL.ost_ch_init(); e_ostR.ost_ch_init();
in_init();
e_sm = 1 - exp(-1 / (0.03 * srate));
e_pkL = e_pkR = 0; e_piL = e_piR = 0;
e_update();
e_mix_s = e_mix_t; e_out_s = e_out_t;
0;
);

function e_slider() (
e_update();
0;
);

function e_block() (
// panel edits change the sliders directly: re-apply them whenever any slider has moved
e_chk = 0; e_ci = 1; loop(29, e_chk += slider(e_ci) * (e_ci * 1.37 + 1); e_ci += 1; );
e_chk != e_last_chk ? ( e_last_chk = e_chk; e_update(); );
e_vA = e_drA.drift_tick(e_dspd * samplesblock / srate); e_vB = e_drB.drift_tick(e_dspd * samplesblock / srate);
// drift: the air absorption wanders (never the delay lengths - no pitch)
bv_hdrift = 1 + 0.25 * e_dft * e_vA; bv_xover();
e_mdl == 3 && e_dft > 0 ? ( k = 0; loop(nl_n, nl_g[k] *= 1 + 0.002 * e_dft * e_vB * (k & 1 ? 1 : -1); k += 1; ); );
0;
);

function e_sample() (
in_process(spl0, spl1);
e_inL = in_l; e_inR = in_r;
e_piL = max(e_piL, abs(e_inL)); e_piR = max(e_piR, abs(e_inR));
e_mix_s += (e_mix_t - e_mix_s) * e_sm; e_out_s += (e_out_t - e_out_s) * e_sm;

e_xl = e_xfL.xfm_run(e_inL, e_drv, 1); e_xr = e_xfR.xfm_run(e_inR, e_drv, 1);
e_xl = e_lfiL.lofi_in(e_xl); e_xr = e_lfiR.lofi_in(e_xr);
bv_pre(e_xl, e_xr);
// reflections from the mono sum, at the 1st reflection delay
er_run(0.5 * (pre_l(e_erd_s) + pre_r(e_erd_s)));
e_tl = pre_l(e_revd_s); e_tr = pre_r(e_revd_s);
e_mdl == 0 ? (
  dif_run(e_tl + 0.2 * er_ol, e_tr + 0.2 * er_or, e_diff * 0.7, 1);
  fdn_run(dif_l, dif_r); e_wl = fdn_l; e_wr = fdn_r;
) : e_mdl == 1 ? (
  dif_run(e_tl, e_tr, e_diff, 0.7);
  cmb_run(dif_l * 0.5, dif_r * 0.5); e_wl = cmb_l; e_wr = cmb_r;
) : e_mdl == 2 ? (
  dif_run(e_tl, e_tr, 0.6 + 0.4 * e_diff, 0.6);
  tank_run(dif_l, dif_r); e_wl = tank_l; e_wr = tank_r;
) : (
  dif_run(e_tl, e_tr, e_diff, 0.5);
  nl_run(dif_l, dif_r);
  e_wl = apr(8, nl_l, 0.0031 * srate, 0.5 * e_diff); e_wr = apr(9, nl_r, 0.0037 * srate, 0.5 * e_diff);
);
e_wl = e_er_g * er_ol + e_rv_g * e_wl; e_wr = e_er_g * er_or + e_rv_g * e_wr;
e_wl = e_lfoL.lofi_out(e_wl); e_wr = e_lfoR.lofi_out(e_wr);
// lo / hi cut on the reverb
e_lcL += (e_wl - e_lcL) * e_lc_c; e_wl -= e_lcL; e_lcR += (e_wr - e_lcR) * e_lc_c; e_wr -= e_lcR;
e_hcL += (e_wl - e_hcL) * e_hc_c; e_wl = e_hcL; e_hcR += (e_wr - e_hcR) * e_hc_c; e_wr = e_hcR;
// width
e_wm = 0.5 * (e_wl + e_wr); e_ws = 0.5 * (e_wl - e_wr) * e_wid; e_wl = e_wm + e_ws; e_wr = e_wm - e_ws;
e_rvl = max(e_rvl, max(abs(e_wl), abs(e_wr)));
oL = e_inL * (1 - e_mix_s) + e_wl * e_mix_s;
e_oR = e_inR * (1 - e_mix_s) + e_wr * e_mix_s;
oL = e_ostL.ost_band(oL) * e_out_s; e_oR = e_ostR.ost_band(e_oR) * e_out_s;
ost_out(oL, e_oR);
spl0 = ost_l; spl1 = ost_r;
e_pkL = max(e_pkL, abs(spl0)); e_pkR = max(e_pkR, abs(spl1));
0;
);

function e_serialize() (
file_var(0, ui_sz);
file_var(0, e_vsel);
file_var(0, e_lastp);
0;
);

// ======================== Japanese: initialisation and functions ========================
function j_er_grid(j_sz, j_dens) local(Lx, Ly, j_Lz, sx, sy, j_sz_, lx, ly, j_lz, i, j, k, n, dx, dy, j_dz, d, j_d0, t, g, j_az, j_el, j_sw, j_tt, j_gg, j_cnt, a) (
  Lx = 22 * j_sz; Ly = 15 * j_sz; j_Lz = 9 * j_sz;
  sx = 0.5 * Lx; sy = 0.3 * Ly; j_sz_ = 0.25 * j_Lz; lx = 0.5 * Lx; ly = 0.62 * Ly; j_lz = 0.3 * j_Lz;
  j_d0 = sqrt(sqr(sx - lx) + sqr(sy - ly) + sqr(j_sz_ - j_lz));
  n = 0;
  i = -2; loop(5, j = -2; loop(5, k = -2; loop(5,
    a = abs(i) + abs(j) + abs(k);
    a > 0 && a <= 2 && n < 48 ? (
      dx = (i & 1 ? (i + 1) * Lx - sx : i * Lx + sx) - lx;
      dy = (j & 1 ? (j + 1) * Ly - sy : j * Ly + sy) - ly;
      j_dz = (k & 1 ? (k + 1) * j_Lz - j_sz_ : k * j_Lz + j_sz_) - j_lz;
      d = sqrt(dx * dx + dy * dy + j_dz * j_dz);
      t = (d - j_d0) / 343; g = j_d0 / d * (a == 1 ? 0.75 : 0.5) * (k != 0 ? 0.8 : 1);
      j_az = atan2(dx, dy);
      er_tl[n] = t; er_tr[n] = t;
      er_gl[n] = g * sqrt(0.5 - 0.5 * sin(j_az)); er_gr[n] = g * sqrt(0.5 + 0.5 * sin(j_az));
      n += 1;
    );
    k += 1; ); j += 1; ); i += 1; );
  j_sw = 1; while(j_sw) ( j_sw = 0; i = 0; loop(n - 1,
    er_tl[i] > er_tl[i + 1] ? ( j_tt = er_tl[i]; er_tl[i] = er_tl[i + 1]; er_tl[i + 1] = j_tt; er_tr[i] = er_tl[i]; er_tr[i + 1] = er_tl[i + 1];
      j_gg = er_gl[i]; er_gl[i] = er_gl[i + 1]; er_gl[i + 1] = j_gg; j_gg = er_gr[i]; er_gr[i] = er_gr[i + 1]; er_gr[i + 1] = j_gg; j_sw = 1; );
    i += 1; ); );
  j_cnt = min(floor(8 + j_dens * 24), n);
  i = 0; loop(j_cnt, er_tl[i] = max(1, floor(er_tl[i] * srate)); er_tr[i] = er_tl[i]; i += 1; );
  j_cnt;
);
function j_er_forty(j_sz, j_dens) local(i, n, t, g, p, w) (
  bv_seed(4093); n = floor(8 + 32 * j_dens); w = 0.3 + 0.7 * j_dens;
  i = 0;
  loop(n,
    t = (3 + 95 * (i / 40) ^ 1.3 + 3 * bv_rnd()) * (0.4 + 0.6 * j_sz);
    g = 0.8 * exp(-2.2 * i / 40) * (bv_rnd() > 0.35 ? 1 : -1);
    p = (bv_rnd() * 2 - 1) * w;
    er_tl[i] = max(1, floor(t * 0.001 * srate)); er_tr[i] = max(1, floor(t * (1 + 0.02 * p) * 0.001 * srate));
    er_gl[i] = g * sqrt(0.5 - 0.5 * p); er_gr[i] = g * sqrt(0.5 + 0.5 * p);
    i += 1; );
  n;
);
function j_er_pattern(m, j_sz, j_dens) local(i, n, t, g, p) (
  bv_seed(m == 0 ? 3301 : 6007);
  n = m == 0 ? floor(6 + 8 * j_dens) : floor(3 + 4 * j_dens);
  i = 0;
  loop(n,
    t = (m == 0 ? 12 + i * 9 + 6 * bv_rnd() : 6 + i * 11 + 3 * bv_rnd()) * (0.5 + 0.5 * j_sz);
    g = 0.6 * (1 - i / (n + 3)) * (bv_rnd() > 0.5 ? 1 : -1); p = bv_rnd() * 2 - 1;
    er_tl[i] = max(1, floor(t * 0.001 * srate)); er_tr[i] = max(1, floor(t * (1.05 - 0.1 * (i & 1)) * 0.001 * srate));
    er_gl[i] = g * sqrt(0.5 - 0.45 * p); er_gr[i] = g * sqrt(0.5 + 0.45 * p);
    i += 1; );
  n;
);
function j_update() local(k, j_sz, L, j_lens, j_er_s, j_dens) (
  j_mdl = slider1;
  j_sz = (slider9 / 1000) ^ (1 / 3);                         // 1000 m3 = 1
  bv_t60 = slider6 * (j_mdl == 0 ? 1.1 : j_mdl == 1 || j_mdl == 2 ? 1.12 : 1); bv_rthi = slider7; bv_rtlo = slider8;   // calibrated: the measured fade matches REVERB TIME
  j_dens = slider10 / 100; j_diff = slider11 / 100;
  j_erd_s = slider2 * 0.001 * srate; j_revd_s = slider4 * 0.001 * srate;
  j_er_g = slider3 <= -29.9 ? 0 : 10 ^ (slider3 / 20);
  j_rv_g = slider5 <= -29.9 ? 0 : 10 ^ (slider5 / 20);
  bv_lox = 250; bv_hix = j_mdl == 3 ? 3000 : 5000;
  j_mdl == 0 ? (
    er_n = j_er_pattern(0, j_sz, j_dens);
    j_lens = 2300; j_lens[0] = 43.1; j_lens[1] = 49.7; j_lens[2] = 57.3; j_lens[3] = 61.9; j_lens[4] = 71.3; j_lens[5] = 79.1; j_lens[6] = 87.7; j_lens[7] = 97.3;
    k = 0; loop(8, L = min(j_lens[k] * 0.001 * srate * (0.3 + 0.7 * j_sz), LN_N - 40); ln_len[k] = L;
      ln_apl[k] = (4.1 + 1.3 * k) * 0.001 * srate * (0.5 + 0.5 * min(j_sz, 1.5)); bv_loss(k, L + ln_apl[k]); k += 1; );
    fdn_apg = 0.35 + 0.3 * j_diff;
  ) : j_mdl == 1 || j_mdl == 2 ? (
    er_n = j_mdl == 1 ? j_er_grid(j_sz, j_dens) : j_er_forty(j_sz, j_dens);
    j_lens = 2300; j_lens[0] = 29.3; j_lens[1] = 34.7; j_lens[2] = 39.1; j_lens[3] = 44.9; j_lens[4] = 50.3; j_lens[5] = 57.7; j_lens[6] = 64.1; j_lens[7] = 73.9;
    k = 0; loop(8, L = min(j_lens[k] * 0.001 * srate * (0.3 + 0.7 * j_sz), LN_N - 40); ln_len[k] = L; bv_loss(k, L); ln_mod[k] = 0; k += 1; );
    fdn_apg = 0;
  ) : (
    er_n = j_er_pattern(3, j_sz, j_dens);
    j_lens = 2300; j_lens[0] = 27.1; j_lens[1] = 33.7; j_lens[2] = 38.9; j_lens[3] = 42.3; j_lens[4] = 30.1; j_lens[5] = 36.3;
    k = 0; loop(6, L = min(j_lens[k] * 0.001 * srate * (0.5 + 0.5 * j_sz), LN_N - 4); cb_len[k] = L; bv_loss(k, L); k += 1; );
  );
  bv_xover();
  j_lc_c = 1 - exp(-2 * $pi * slider12 / srate);
  j_hc_c = 1 - exp(-2 * $pi * min(slider13, srate * 0.45) / srate);
  j_drv = slider14 / 100;
  lofi_set(slider15 || j_mdl == 3, j_mdl == 3 ? 31500 : j_mdl == 1 ? 48000 : 44100, slider30 == 0 ? 12 : slider30 == 1 ? 16 : 24);
  j_wid = slider17 / 100;
  j_dft = slider18 / 100; j_dspd = slider19 * (0.5 + 0.5 * slider18 / 20);   // the wander speeds up with DRIFT (1x at its default 20%)
  j_mix_t = slider20 / 100; j_out_t = 10 ^ (slider21 / 20);
  ost_setup(slider22 / 100, slider23 / 100, slider24, slider25, slider26, 0);   // output stage: straight through
  in_setup(slider28, slider29);
);
function j_setp(m, j_erd, j_erl, j_rvd, j_rvl, t, hi, lo, j_vol, dn, df, lc, j_hc, j_dr, j_ck, j_bt, j_wd, mx) (
  slider1 = m; slider2 = j_erd; slider3 = j_erl; slider4 = j_rvd; slider5 = j_rvl; slider6 = t; slider7 = hi; slider8 = lo; slider9 = j_vol;
  slider10 = dn; slider11 = df; slider12 = lc; slider13 = j_hc; slider14 = j_dr; slider15 = j_ck; slider30 = j_bt; slider17 = j_wd; slider20 = mx;
);
function j_load_preset(p) (
  p >= 1 ? j_jv_dst = 1;                         // duck the reverb, swap the settings at silence, fade it back in
  p == 1 ? j_setp(0, 14, -10, 40, 0, 4.5, 0.5, 1.2, 8000, 60, 80, 50, 10000, 0, 0, 1, 130, 30) :     // Massive Hall
  p == 2 ? j_setp(0, 10, -8, 30, 0, 2.6, 0.6, 1.0, 3000, 60, 70, 100, 13000, 0, 0, 1, 120, 25) :     // Vocal Hall
  p == 3 ? j_setp(0, 20, -12, 60, 0, 8.0, 0.5, 1.5, 12000, 50, 90, 50, 10000, 0, 0, 1, 140, 40) :    // Synth Pad Space
  p == 4 ? j_setp(1, 8, -4, 24, -2, 2.2, 0.6, 1.0, 6000, 80, 70, 50, 13000, 0, 0, 1, 110, 30) :      // 3D Scoring Stage
  p == 5 ? j_setp(1, 4, -2, 12, -4, 1.0, 0.7, 1.0, 900, 70, 60, 100, 13000, 0, 0, 1, 100, 25) :      // Film Room
  p == 6 ? j_setp(2, 2, -3, 8, -6, 0.7, 0.8, 1.0, 250, 100, 50, 100, 13000, 0, 0, 1, 110, 25) :      // Studio Room 40
  p == 7 ? j_setp(2, 4, -4, 14, -3, 1.3, 0.7, 0.9, 700, 80, 60, 100, 10000, 0, 1, 1, 120, 25) :      // Acoustic Guitar (vintage)
  p == 8 ? j_setp(3, 6, -12, 20, 0, 2.0, 0.5, 1.0, 1200, 50, 60, 100, 10000, 0, 1, 0, 110, 30) :     // 80s Vocal Plate
  p == 9 ? j_setp(3, 2, -8, 6, 0, 1.0, 0.6, 1.0, 400, 60, 40, 100, 10000, 20, 1, 0, 100, 30) :       // Drum Room 12-Bit
  p == 10 ? j_setp(0, 30, -14, 80, 0, 12, 0.4, 1.3, 12000, 40, 90, 100, 10000, 0, 1, 1, 150, 45);    // Synthwave Wash
  p >= 1 && p <= 10 ? ( j_lastp = p; i = 1; loop(17, ui_auto(i); i += 1; ); ui_auto(20); );
  p == 11 ? (
    j_setp(0, 8, -6, 24, 0, 2.8, 0.7, 1.0, 3000, 60, 60, 80, 12000, 0, 0, 0, 100, 30);
    slider18 = 20; slider19 = 0.15; slider21 = 0; slider22 = 0; slider23 = 30; slider24 = 120; slider25 = 6000; slider26 = -0.3; slider27 = 1;
    slider28 = 0; slider29 = 0; j_lastp = 0;
    i = 1; loop(29, ui_auto(i); i += 1; );
  );
);
function j_pv_text(k) local(v) (
  v = pv_get(k);
  k == 1 || k == 3 ? ( v <= -29.9 ? strcpy(#j_pt, "OFF") : sprintf(#j_pt, "%.1f", v); ) :
  k == 4 || k == 6 ? sprintf(#j_pt, "%.2f", v) :
  k == 5 ? ( v < 10 ? sprintf(#j_pt, "%.2f", v) : sprintf(#j_pt, "%.1f", v); ) :
  k == 11 || k == 22 ? sprintf(#j_pt, "%.1f", v / 1000) :
  k == 16 || k == 17 || k == 23 ? sprintf(#j_pt, "%.1f", v) :
  k == 18 ? sprintf(#j_pt, "%.2f", v) :
  sprintf(#j_pt, "%d", floor(v + 0.5));
  #j_pt;
);
function j_pv_unit(k) ( k == 1 || k == 3 || k == 16 || k == 17 || k == 23 ? "dB" : k == 7 ? "m3" : k == 4 || k == 6 ? "x" : k == 5 ? "SEC" :
  k == 0 || k == 2 ? "mSEC" : k == 10 || k == 21 ? "Hz" : k == 11 || k == 22 ? "kHz" : k == 18 ? "Hz" : "%"; );
function j_pv_name(k) ( k == 0 ? "E.RFL DELAY" : k == 1 ? "E.RFL LEVEL" : k == 2 ? "PRE DELAY" : k == 3 ? "REV LEVEL" : k == 4 ? "RT HIGH" : k == 5 ? "REVERB TIME" :
  k == 6 ? "RT LOW" : k == 7 ? "ROOM SIZE" : k == 8 ? "DENSITY" : k == 9 ? "DIFFUSION" : k == 10 ? "LOW CUT" : k == 11 ? "HIGH CUT" : k == 12 ? "DRIVE" :
  k == 13 ? "WIDTH" : k == 14 ? "DRIFT" : k == 15 ? "MIX" : k == 16 ? "TRIM" : k == 17 ? "LEVEL" : k == 18 ? "DRIFT SPEED" : k == 19 ? "SAT" :
  k == 20 ? "BIAS" : k == 21 ? "LO BAND" : k == 22 ? "HI BAND" : "CEILING"; );
function j_init() (
#ui_man = "gfx-j-verb";                                  // the ? pop-up links to this manual
bv_alloc(100000);

// a 3-D grid of reflections (image sources in a box, first and second order): levels only, one delay for both ears,
// so they can never cancel in mono

// up to 40 individual reflections: DENSITY sets how many and how widely they spread

// sparse wide reflections for the hall, a few for the 12-bit unit




// ---------- presets ----------



// ---------- the parameters (same table as E-Verb) ----------
pv_def(0, 2, 0, 120, 1, 8, 0, 0);       pv_def(1, 3, -30, 6, 0.5, -6, 0, 1);
pv_def(2, 4, 0, 250, 1, 24, 0, 0);      pv_def(3, 5, -30, 6, 0.5, 0, 0, 1);
pv_def(4, 7, 0.1, 1.5, 0.05, 0.7, 0, 2); pv_def(5, 6, 0.1, 20, 0.05, 2.8, 1, 2);
pv_def(6, 8, 0.5, 2.5, 0.05, 1.0, 0, 2); pv_def(7, 9, 10, 12000, 1, 3000, 1, 0);
pv_def(8, 10, 0, 100, 1, 60, 0, 0);     pv_def(9, 11, 0, 100, 1, 60, 0, 0);
pv_def(10, 12, 20, 1000, 1, 80, 1, 0);  pv_def(11, 13, 1000, 20000, 10, 12000, 1, 1);
pv_def(12, 14, 0, 100, 1, 0, 0, 0);     pv_def(13, 17, 0, 150, 1, 100, 0, 0);
pv_def(14, 18, 0, 100, 1, 20, 0, 0);    pv_def(15, 20, 0, 100, 1, 30, 0, 0);
pv_def(16, 28, -24, 12, 0.1, 0, 0, 1);  pv_def(17, 21, -24, 12, 0.1, 0, 0, 1);
pv_def(18, 19, 0.02, 2, 0.01, 0.15, 1, 2); pv_def(19, 22, 0, 100, 1, 0, 0, 0);
pv_def(20, 23, 0, 100, 1, 30, 0, 0);    pv_def(21, 24, 40, 400, 1, 120, 1, 0);
pv_def(22, 25, 2000, 16000, 10, 6000, 1, 1); pv_def(23, 26, -24, 0, 0.1, -0.3, 0, 1);



j_vsel = 1; j_dsel = 2; j_ksel = 5;   // the parameter on the LEVEL display / the keypad, and the one on the DELAY display

j_drA.drift_init(0.8 + rand(0.5)); j_drB.drift_init(0.8 + rand(0.5));
ost_init(20000); j_ostL.ost_ch_init(); j_ostR.ost_ch_init();
in_init();
j_sm = 1 - exp(-1 / (0.03 * srate));
j_pkL = j_pkR = 0; j_piL = j_piR = 0;
j_update();
j_mix_s = j_mix_t; j_out_s = j_out_t;
j_jv_dkr = 1 / (0.012 * srate); j_jv_dk = 1; j_jv_dst = 0;   // preset duck (the wet only): 12 ms out, 12 ms in
0;
);

function j_slider() (
j_jv_dst != 1 ? j_update();                        // during a preset duck the swap applies the new settings
0;
);

function j_block() (
// panel edits change the sliders directly: re-apply them whenever any slider has moved
j_chk = 0; j_ci = 1; loop(29, j_chk += slider(j_ci) * (j_ci * 1.37 + 1); j_ci += 1; );
j_jv_dst != 1 && j_chk != j_last_chk ? ( j_last_chk = j_chk; j_update(); );
j_vA = j_drA.drift_tick(j_dspd * samplesblock / srate); j_vB = j_drB.drift_tick(j_dspd * samplesblock / srate);
// drift: in the hall the read taps move by up to two samples (density, never pitch); elsewhere the air absorption wanders
j_mdl == 0 ? ( k = 0; loop(8, ln_mod[k] = j_dft * 2 * (k & 1 ? j_vA : j_vB) * (0.5 + 0.1 * k); k += 1; ); ) : ( bv_hdrift = 1 + 0.2 * j_dft * j_vA; bv_xover(); );
j_mdl == 3 ? ( lf_inc = 31500 * (1 + 0.0004 * j_dft * j_vB) / srate; );   // the old clock is not quite steady
0;
);

function j_sample() (
// preset duck-and-swap on the wet: model, size, delays and the lo-fi clock change in silence, and the reverb
// starts clean with its feed faded in (old audio at new line lengths would come round again as a click)
j_jv_dst == 1 ? ( j_jv_dk -= j_jv_dkr; j_jv_dk <= 0 ? (
  j_jv_dk = 0; j_update(); j_jv_dst = 2;
  memset(BV_PRE, 0, BV_END - BV_PRE); memset(ln_z1, 0, 30); memset(cb_z, 0, 10); memset(fdn_v, 0, 20);
); ) :
j_jv_dst == 2 ? ( j_jv_dk += j_jv_dkr; j_jv_dk >= 1 ? ( j_jv_dk = 1; j_jv_dst = 0; ); );
in_process(spl0, spl1);
j_inL = in_l; j_inR = in_r;
j_piL = max(j_piL, abs(j_inL)); j_piR = max(j_piR, abs(j_inR));
j_mix_s += (j_mix_t - j_mix_s) * j_sm; j_out_s += (j_out_t - j_out_s) * j_sm;

j_xl = j_xfL.xfm_run(j_inL, j_drv, 0); j_xr = j_xfR.xfm_run(j_inR, j_drv, 0);
j_xl = j_lfiL.lofi_in(j_xl); j_xr = j_lfiR.lofi_in(j_xr);
j_jv_dst ? ( j_jv_dkg = j_jv_dk * j_jv_dk * (3 - 2 * j_jv_dk); j_xl *= j_jv_dkg; j_xr *= j_jv_dkg; );
bv_pre(j_xl, j_xr);
// reflections from the mono sum, at the 1st reflection delay
er_run(0.5 * (pre_l(j_erd_s) + pre_r(j_erd_s)));
j_tl = pre_l(j_revd_s); j_tr = pre_r(j_revd_s);
j_mdl == 0 ? (
  dif_run(j_tl + 0.15 * er_ol, j_tr + 0.15 * er_or, j_diff, 1.3);
  fdn_run(dif_l, dif_r); j_wl = fdn_l; j_wr = fdn_r;
) : j_mdl == 1 || j_mdl == 2 ? (
  dif_run(j_tl + 0.3 * er_ol, j_tr + 0.3 * er_or, j_mdl == 1 ? 0.5 + 0.5 * j_diff : j_diff * 0.8, 1);
  fdn_run(dif_l, dif_r); j_wl = fdn_l; j_wr = fdn_r;
) : (
  dif_run(j_tl, j_tr, j_diff * 0.6, 0.6);
  cmb_run(dif_l * 0.5, dif_r * 0.5); j_wl = cmb_l; j_wr = cmb_r;
);
j_wl = j_er_g * er_ol + j_rv_g * j_wl; j_wr = j_er_g * er_or + j_rv_g * j_wr;
j_wl = j_lfoL.lofi_out(j_wl); j_wr = j_lfoR.lofi_out(j_wr);
j_jv_dst ? ( j_wl *= j_jv_dkg; j_wr *= j_jv_dkg; );
// lo / hi cut on the reverb
j_lcL += (j_wl - j_lcL) * j_lc_c; j_wl -= j_lcL; j_lcR += (j_wr - j_lcR) * j_lc_c; j_wr -= j_lcR;
j_hcL += (j_wl - j_hcL) * j_hc_c; j_wl = j_hcL; j_hcR += (j_wr - j_hcR) * j_hc_c; j_wr = j_hcR;
// width
j_wm = 0.5 * (j_wl + j_wr); j_ws = 0.5 * (j_wl - j_wr) * j_wid; j_wl = j_wm + j_ws; j_wr = j_wm - j_ws;
j_rvl = max(j_rvl, max(abs(j_wl), abs(j_wr)));
oL = j_inL * (1 - j_mix_s) + j_wl * j_mix_s;
j_oR = j_inR * (1 - j_mix_s) + j_wr * j_mix_s;
oL = j_ostL.ost_band(oL) * j_out_s; j_oR = j_ostR.ost_band(j_oR) * j_out_s;
ost_out(oL, j_oR);
spl0 = ost_l; spl1 = ost_r;
j_pkL = max(j_pkL, abs(spl0)); j_pkR = max(j_pkR, abs(spl1));
0;
);

function j_serialize() (
file_var(0, ui_sz);
file_var(0, j_vsel);
file_var(0, j_lastp);
0;
);

// ======================== the REGION switch ========================
rg_cur = slider31 >= 0.5; rg_g = 1; rg_f = 0;
rg_cur ? j_init() : e_init();
#ui_man = "gfx-vrb45";
rg_cur ? j_slider() : e_slider();

@slider
(slider31 >= 0.5) == rg_cur && !rg_f ? ( rg_cur ? j_slider() : e_slider(); );

@block
// REGION changed: fade out (10 ms), start the other engine clean at the silent point, fade back in (20 ms)
(slider31 >= 0.5) != rg_cur && !rg_f ? rg_f = 1;
rg_f == 2 ? ( rg_cur = slider31 >= 0.5; rg_cur ? j_init() : e_init(); #ui_man = "gfx-vrb45"; rg_cur ? j_slider() : e_slider(); rg_f = 3; );
rg_dn = 1 / (0.01 * srate); rg_up = 1 / (0.02 * srate);
rg_cur ? j_block() : e_block();

@serialize
e_serialize(); j_serialize();

@sample
rg_cur ? j_sample() : e_sample();
rg_f == 1 ? ( rg_g -= rg_dn; rg_g <= 0 ? ( rg_g = 0; rg_f = 2; ); ) : rg_f == 3 ? ( rg_g += rg_up; rg_g >= 1 ? ( rg_g = 1; rg_f = 0; ); );
rg_f ? ( spl0 *= rg_g; spl1 *= rg_g; );

@gfx 1440 320
function e_skin(m) (
  m == 0 ? ( e_S_FACE = 0x23253A; e_S_INK = 0xD6D8E4; e_S_LINE = 0x7A7C92; e_S_WIN = 0x0E0608; e_S_ON = 0xFF2A1C; e_S_OFF = 0x34100E;
             e_S_KEY = 0x585C66; e_S_KT = 0xE8EAF0; e_S_KE = 0x2E3038; e_S_ACC = 0xFF3A2A; e_S_TEX = 0; e_S_WHEEL = 0; e_S_KR = 3; ) :
  m == 1 ? ( e_S_FACE = 0xE2DCC8; e_S_INK = 0x2A2620; e_S_LINE = 0x7A7262; e_S_WIN = 0x120A08; e_S_ON = 0xFF3424; e_S_OFF = 0x3A1410;
