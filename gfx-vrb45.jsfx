  ui_col(ui_mix(j_S_IN, j_S_INK, 0.55)); gfx_rect(x * sc, (y + 4) * sc, w * sc, 1 * sc + 0.5);
  ui_col(j_S_IN); gfx_rect((x + w * 0.5) * sc - tw * 0.5 - 4 * sc, y * sc, tw + 8 * sc, 9 * sc);
  ui_col(j_S_INK); gfx_x = (x + w * 0.5) * sc - tw * 0.5; gfx_y = y * sc; gfx_drawstr(s);
);
function j_key(x, y, w, h, col, s, j_s2, led, j_rep) local(hit, inb, tw, th, dn, j_id) (
  j_id = 100000 + x * 1000 + y;
  inb = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc;
  hit = pressed && drag_id == 0 && inb;
  hit ? ( drag_id = j_id; j_k_tn = time_precise() + 0.4; );
  j_rep && drag_id == j_id && inb && time_precise() > j_k_tn ? ( hit = 1; j_k_tn = time_precise() + 0.07; );
  dn = drag_id == j_id && inb;
  ui_col(ui_mix(j_S_IN, 0x000000, 0.45)); lz_rr(x + 1, y + 2, w, h, 3);
  ui_col(ui_mix(col, 0x000000, 0.35)); lz_rr(x, y, w, h, 3);
  ui_col(dn ? ui_mix(col, 0x000000, 0.18) : col); lz_rr(x + 1, y + 1, w - 2, h - 3, 3);
  ui_hw ? ( ui_col(ui_mix(col, 0xFFFFFF, 0.22)); gfx_rect((x + 3) * sc, (y + 2) * sc, (w - 6) * sc, 1 * sc + 0.5); );
  led >= 0 ? ( ui_col(0x0A0A0A); gfx_circle((x + 7) * sc, (y + 7) * sc, 3.2 * sc, 1, 1);
               ui_col(led ? j_S_LED : ui_mix(j_S_LED, 0x0A0A0A, 0.75)); gfx_circle((x + 7) * sc, (y + 7) * sc, 2.4 * sc, 1, 1); );
  gfx_setfont(6, "Arial", (strlen(s) == 1 ? 16 : strlen(s) <= 5 && !strlen(j_s2) && led < 0 && h > 30 ? 13 : h <= 30 ? 11 : 10) * sc, 'b');
  ui_col(ui_ink(col) == 0x1A1A1C ? 0x1A1E26 : 0xFFFFFF);
  strlen(j_s2) ? (
    gfx_measurestr(s, tw, th); gfx_x = (x + w * 0.5) * sc - tw * 0.5; gfx_y = (y + h * 0.5 - 1) * sc - th; gfx_drawstr(s);
    gfx_measurestr(j_s2, tw, th); gfx_x = (x + w * 0.5) * sc - tw * 0.5; gfx_y = (y + h * 0.5 + 1) * sc; gfx_drawstr(j_s2);
  ) : ( gfx_measurestr(s, tw, th); gfx_x = (x + w * 0.5) * sc - tw * 0.5; gfx_y = (y + h * 0.5 + (led >= 0 ? 2 : 0)) * sc - th * 0.5; gfx_drawstr(s); );
  hit;
);
function j_win(k, x, y, w, n, s, j_unit, j_cp) local(inb, did, j_dw) (
  did = 1900 + k;
  inb = mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + 44) * sc;
  pressed && inb && drag_id == 0 ? (
    time_precise() - j_d_lt < 0.35 && j_d_lk == k ? ( pv_reset(k); drag_id = -1; ) : ( drag_id = did; j_d_y = mouse_y; j_d_lt = time_precise(); j_d_lk = k; );
    j_ksel = k;
  );
  drag_id == did && abs(mouse_y - j_d_y) >= 2 * sc ? ( pv_nudge(k, (j_d_y - mouse_y) / (((mouse_cap & 8) ? 1500 : 300) * sc)); j_d_y = mouse_y; );
  inb && mouse_wheel != 0 && drag_id == 0 ? ( pv_step(k, sign(mouse_wheel)); mouse_wheel = 0; j_ksel = k; );
  ui_col(j_ksel == k ? j_S_LED : ui_mix(j_S_IN, 0x000000, 0.5)); lz_rr(x - 1.5, y - 1.5, w + 3, 47, 5);
  ui_col(j_S_WIN); lz_rr(x, y, w, 44, 4);
  j_S_LCD && ui_hw ? gfx_gradrect(x * sc, y * sc, w * sc, 44 * sc, 1, 1, 1, 0.12, 0, 0, 0, 0, 0, 0, 0, -0.12 / (44 * sc));
  j_dw = min(13, (w - 26) / n / 1.38);
  seg_str((x + w - n * j_dw * 1.38 - 5) * sc, (y + 9) * sc, j_dw * sc, 27 * sc, n, s, j_S_ON, ui_mix(j_S_WIN, j_S_OFF, j_S_LCD ? 0.5 : 0.38));
  strlen(j_cp) ? j_ctxt(x + w * 0.5, y + 50, j_cp, 9, 0.9);
  gfx_setfont(6, "Arial", 9 * sc, 'b'); ui_col(ui_mix(j_S_WIN, j_S_ON, 0.8)); gfx_x = (x + 4) * sc; gfx_y = (y + 3) * sc; gfx_drawstr(j_unit);
);
function j_pmod(k, x, y, j_cp, n) (
  cap(x, y, 110, j_cp);
  j_win(k, x, y + 13, 110, n, j_pv_text(k), j_pv_unit(k), "");
  j_key(x, y + 63, 53, 26, j_S_KP, "DOWN", "", -1, 1) ? ( pv_step(k, -1); j_ksel = k; );
  j_key(x + 57, y + 63, 53, 26, j_S_KP, "UP", "", -1, 1) ? ( pv_step(k, 1); j_ksel = k; );
);
function j_lamps(x, y, s, k, j_v0, j_v1, j_v2, j_v3, j_l0, j_l1, j_l2, j_l3) local(i, v, j_tol) (
  cap(x, y, 170, s);
  i = 0;
  loop(4, v = i == 0 ? j_v0 : i == 1 ? j_v1 : i == 2 ? j_v2 : j_v3; j_tol = abs(v) * 0.02 + 0.001;
    j_key(x + i * 44, y + 14, 38, 30, j_S_KN, i == 0 ? j_l0 : i == 1 ? j_l1 : i == 2 ? j_l2 : j_l3, "", abs(pv_get(k) - v) < j_tol, 0) ? pv_set(k, v);
    i += 1; );
);
function j_gfx() (
ui_begin(1440, 380);
seg_clean = 1;   // readouts as plain bold figures (easier to read than segments)
ui_thm = 5; ui_hw = 1; ui_theme(5);

// ---------- the four faceplates ----------
// face, inset, ink, model / parameter / green / number / enter / clear keys, key text, LCD (1) or lit segments (0), window, on, off, LED



// a framed caption bar over a group of keys (as on the remote)

// a square key with an LED in its corner (led: -1 none, 0 off, 1 on); two lines of text allowed (s2)

// a display window: lit segments (LED / fluorescent) or a backlit LCD; drag / wheel adjust k, click selects it

// one parameter, all on the top level: caption bar, its display, DOWN / UP keys

// a row of four lamp keys that set a parameter to fixed values

// ---------- the panel ----------
j_skin(j_mdl);
fh = 372;
ui_col(0x0A0A0B); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(ui_mix(j_S_FACE, 0x000000, 0.4)); lz_rr(4, 4, 1432, fh, 9);
ui_col(j_S_FACE); lz_rr(5, 5, 1430, fh - 2, 8);
ui_col(ui_mix(j_S_IN, 0x000000, 0.25)); lz_rr(13, 41, 1414, fh - 48, 6);
ui_col(j_S_IN); lz_rr(14, 42, 1412, fh - 50, 5);
ui_hw ? gfx_gradrect(6 * sc, 6 * sc, 1428 * sc, 34 * sc, 1, 1, 1, 0.08, 0, 0, 0, 0, 0, 0, 0, -0.08 / (34 * sc));

// header (on the face): badge, name in outlined letters, the model's line, size / help
ui_col(j_S_INK); gfx_circle(34 * sc, 22 * sc, 12 * sc, 1, 1); gfx_setfont(4); ui_col(j_S_FACE); ui_text(34 * sc, 17 * sc, "GFX");
gfx_setfont(6, "Arial Black", 24 * sc, 'j_bi');
ui_col(j_S_TTL); j_gi = -1; loop(3, j_gj = -1; loop(3, gfx_x = (56 + j_gi) * sc; gfx_y = (8 + j_gj) * sc; gfx_drawstr("VRB45"); j_gj += 1; ); j_gi += 1; );
ui_col(j_S_FACE); gfx_x = 56 * sc; gfx_y = 8 * sc; gfx_drawstr("VRB45");
gfx_setfont(6, "Arial", 11 * sc, 'b'); ui_col(ui_mix(j_S_FACE, j_S_INK, 0.8)); gfx_x = 180 * sc; gfx_y = 17 * sc;
gfx_drawstr(j_mdl == 0 ? "MODULAR DIGITAL HALL SYSTEM" : j_mdl == 1 ? "DIGITAL BROADCAST REVERBERATOR  -  3D" : j_mdl == 2 ? "DIGITAL REVERBERATOR  -  40 REFLECTIONS" : "DIGITAL REVERBERATOR  -  PCM 12-BIT");
ui_size_picker(1360 * sc, 12 * sc);

// headroom (input) and reverb LEDs
cap(26, 52, 180, "HEADROOM");
j_gi = 0; loop(4, j_gd_ = j_gi == 0 ? -30 : j_gi == 1 ? -20 : j_gi == 2 ? -10 : 0;
  ui_col(0x0A0A0A); gfx_circle((44 + j_gi * 44) * sc, (74 + 0) * sc, 5 * sc, 1, 1);
  ui_col(20 * log10(max(max(j_piL, j_piR), 0.000001)) >= j_gd_ ? (j_gi == 3 ? 0xFF3020 : j_S_LED == 0xFF3020 ? 0x3AE06A : j_S_LED) : 0x2A2A2A); gfx_circle((44 + j_gi * 44) * sc, 74 * sc, 3.8 * sc, 1, 1);
  sprintf(#j_hl, j_gi == 3 ? "0dB" : "%d", -j_gd_); j_ctxt(44 + j_gi * 44, 82, #j_hl, 9, 0.8); j_gi += 1; );
j_piL *= 0.85; j_piR *= 0.85;

// ---------- MODEL keys (A - D), VINTAGE, BITS ----------
cap(26, 100, 180, "PROGRAM");
j_key(26, 114, 86, 46, j_S_KM, "A  HALL", "", j_mdl == 0, 0) ? ( slider1 = 0; ui_auto(1); j_update(); );
j_key(120, 114, 86, 46, j_S_KM, "B  3D", "", j_mdl == 1, 0) ? ( slider1 = 1; ui_auto(1); j_update(); );
j_key(26, 166, 86, 46, j_S_KM, "C  FLAGSHIP", "40", j_mdl == 2, 0) ? ( slider1 = 2; ui_auto(1); j_update(); );
j_key(120, 166, 86, 46, j_S_KM, "D  12-BIT", "", j_mdl == 3, 0) ? ( slider1 = 3; ui_auto(1); j_update(); );
j_key(26, 224, 86, 38, j_S_KG, "VINTAGE", "CLOCK", slider15 || j_mdl == 3, 0) ? ( slider15 = 1 - slider15; ui_auto(15); j_update(); );
j_key(120, 224, 86, 38, j_S_KG, "BITS", slider30 == 0 ? "12" : slider30 == 1 ? "16" : "24", -1, 0) ? ( slider30 = (slider30 + 1) % 3; ui_auto(30); j_update(); );
// presets and the last one recalled
j_key(26, 274, 86, 34, j_S_KN, "READ", "PRESETS", -1, 0) ? (
  gfx_x = 26 * sc; gfx_y = 308 * sc;
  j_load_preset(gfx_showmenu("Massive Hall|Vocal Hall|Synth Pad Space|3D Scoring Stage|Film Room|Studio Room 40|Acoustic Guitar (vintage)|80s Vocal Plate|Drum Room 12-Bit|Synthwave Wash|Reset all to defaults"));
);
ui_col(j_S_WIN); lz_rr(120, 274, 86, 34, 4);
seg_str(130 * sc, 280 * sc, 11 * sc, 22 * sc, 3, j_lastp > 0 ? sprintf(#j_pn, "P%d", j_lastp) : "P--", j_S_ON, ui_mix(j_S_WIN, j_S_OFF, 0.4));
// prev / next under them: step through the ten presets (wrapping round)
j_key(26, 316, 86, 26, j_S_KN, "", "", -1, 0) ? j_load_preset(j_lastp <= 1 ? 10 : j_lastp - 1);
j_key(120, 316, 86, 26, j_S_KN, "", "", -1, 0) ? j_load_preset(j_lastp >= 10 ? 1 : j_lastp + 1);
ui_col(ui_ink(j_S_KN) == 0x1A1A1C ? 0x1A1E26 : 0xFFFFFF); gfx_triangle(73.5 * sc, 322 * sc, 73.5 * sc, 334 * sc, 64.5 * sc, 328 * sc);
gfx_triangle(158.5 * sc, 322 * sc, 158.5 * sc, 334 * sc, 167.5 * sc, 328 * sc);   // the arrows

// ---------- the lamp rows: quick settings ----------
j_lamps(230, 52, "LOW CUT FREQ", 10, 30, 50, 100, 200, "30", "50", "100", "200");
j_lamps(418, 52, "HIGH CUT FREQ", 11, 2500, 5000, 10000, 13000, "2.5k", "5k", "10k", "13k");
j_lamps(230, 104, "RT LOW FREQ RANGE", 6, 0.5, 1.0, 1.5, 2.0, "x0.5", "x1.0", "x1.5", "x2.0");
j_lamps(418, 104, "RT HIGH FREQ RANGE", 4, 0.25, 0.35, 0.5, 1.0, "x0.25", "x0.35", "x0.5", "x1.0");

// ---------- the ER grid: a dot-matrix picture of the reflections (time across 0 - 240 ms, level up) ----------
cap(616, 52, 562, "EARLY REFLECTIONS   0 - 240 ms");
ui_col(0x080A0C); lz_rr(616, 66, 562, 94, 4);
j_gi = 0; loop(58, j_gj = 0; loop(9, ui_col(0x1A1E22); gfx_circle((626 + j_gi * 9.6) * sc, (74 + j_gj * 9.6) * sc, 2.4 * sc, 1, 1); j_gj += 1; ); j_gi += 1; );
j_er_g > 0 ? ( j_gi = 0; loop(er_n,
  j_gx_ = floor((er_tl[j_gi] / srate * 1000 + slider2) / 240 * 58); j_gh_ = floor(min(abs(er_gl[j_gi]) + abs(er_gr[j_gi]), 1.2) / 1.2 * 8 * min(j_er_g * 2, 1)) + 1;
  j_gx_ < 58 ? ( j_gj = 0; loop(j_gh_, ui_col(j_S_LCD ? 0x5AF07A : j_S_LED); gfx_circle((626 + j_gx_ * 9.6) * sc, (74 + (8 - j_gj) * 9.6) * sc, 2.6 * sc, 1, 1); j_gj += 1; ); );
  j_gi += 1; ); );
// the tail starts here (reverb delay)
j_gx_ = floor(slider4 / 240 * 58); j_gx_ < 58 ? ( j_gj = 0; loop(5, ui_col(ui_mix(j_S_LED, 0x080A0C, 0.6)); gfx_circle((626 + j_gx_ * 9.6) * sc, (74 + j_gj * 9.6) * sc, 2.6 * sc, 1, 1); j_gj += 2; ); );

// ---------- every parameter on the top level ----------
j_gi = 0;
loop(16,
  j_gk = j_gi == 0 ? 5 : j_gi == 1 ? 2 : j_gi == 2 ? 3 : j_gi == 3 ? 0 : j_gi == 4 ? 1 : j_gi == 5 ? 7 : j_gi == 6 ? 8 : j_gi == 7 ? 9 :
       j_gi == 8 ? 4 : j_gi == 9 ? 6 : j_gi == 10 ? 10 : j_gi == 11 ? 11 : j_gi == 12 ? 12 : j_gi == 13 ? 13 : j_gi == 14 ? 14 : 15;
  j_pmod(j_gk, 230 + (j_gi % 8) * 120, 172 + floor(j_gi / 8) * 98, j_pv_name(j_gk), j_gk == 7 ? 5 : 4);
  j_gi += 1; );

// ---------- IN / OUT (right column): trim + guard, the output level and saturation ----------
cap(1196, 52, 216, "IN / OUT");
j_win(16, 1196, 100, 104, 4, j_pv_text(16), "dB", "TRIM");
j_key(1308, 104, 104, 36, j_S_KG, "GUARD", "", slider29, 0) ? ( slider29 = 1 - slider29; ui_auto(29); j_update(); );
j_win(17, 1196, 212, 104, 4, j_pv_text(17), "dB", "LEVEL");
j_win(19, 1308, 212, 104, 3, j_pv_text(19), "%", "SAT");

pk_end();
ui_end();
0;
);
rg_cur ? j_gfx() : e_gfx();
// the REGION keys (EUROPE / JAPAN), drawn over the panel at its top right
function rg_key(x, y, w, h, on, s) local(hit, tw, th) (
  hit = mouse_cap & 1 && !rg_down && mouse_x >= x && mouse_x < x + w && mouse_y >= y && mouse_y < y + h;
  ui_col(0x101010); gfx_rect(x, y, w, h);
  ui_col(on ? 0xE8C060 : 0x3A3A3E); gfx_rect(x + 1, y + 1, w - 2, h - 2);
  gfx_setfont(1, "Arial", h * 0.62, 'b'); gfx_measurestr(s, tw, th); ui_col(on ? 0x101010 : 0xD8D8D8);
  gfx_x = x + (w - tw) * 0.5; gfx_y = y + (h - th) * 0.5; gfx_drawstr(s);
  hit;
);
rg_s = sc; rg_x = (ui_bw - 150) * rg_s; rg_y = 4 * rg_s;
rg_key(rg_x, rg_y, 30 * rg_s, 16 * rg_s, slider31 < 0.5, "EU") ? ( slider31 = 0; slider_automate(2 ^ (31 - 1)); );
rg_key(rg_x + 32 * rg_s, rg_y, 30 * rg_s, 16 * rg_s, slider31 >= 0.5, "JP") ? ( slider31 = 1; slider_automate(2 ^ (31 - 1)); );
rg_down = mouse_cap & 1;
