function e_wheel(cx, cy, r) local(hov, a, i, t) (
  hov = (mouse_x - cx * sc) ^ 2 + (mouse_y - cy * sc) ^ 2 <= (r * sc) ^ 2;
  pressed && hov && drag_id == 0 ? ( drag_id = 1995; e_w_y = mouse_y; );
  drag_id == 1995 ? ( e_w_a += (e_w_y - mouse_y) / (40 * sc); pv_nudge(e_vsel, (e_w_y - mouse_y) / (((mouse_cap & 8) ? 3000 : 600) * sc)); e_w_y = mouse_y; );
