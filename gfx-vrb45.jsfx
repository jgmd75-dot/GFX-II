function e_meter(x, y, v, s) local(i, d, c, lit) (
  i = 0;
  loop(10, d = i * 3; lit = 20 * log10(max(v, 0.000001)) >= -d - 1.5;
    c = i == 0 ? 0xFF3A2A : i < 3 ? 0xFFC030 : 0x3AE06A;
