function e_gfx() (
ui_begin(1440, 320);
ui_thm = 5; ui_hw = 1; ui_theme(5);

// ---------- the four faceplates ----------
// SK: face, ink, line, window, segment on, segment off, key, key text, key edge, accent (LEDs), texture (0 plain, 1 brushed)



// a rounded outline round a group, its name in a tab cut into the top line

// a key in the faceplate's style; returns 1 when clicked (with repeat while held if rep)

// a parameter display: caption, window with the value and its unit, - / + keys underneath.
// Click the window to give it the data wheel; drag it, or use the wheel / mouse wheel; double-click = default.

// the LED meter column (dB below full scale), one per channel pair

// the data wheel: drag (Shift = fine) or mouse wheel changes the display it is given


// ---------- the panel ----------
e_skin(e_mdl);
fh = 312;
ui_col(0x0A0A0B); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(ui_mix(e_S_FACE, 0x000000, 0.45)); lz_rr(4, 4, 1432, fh, 8);
ui_col(e_S_FACE); lz_rr(5, 5, 1430, fh - 2, 7);
e_S_TEX ? ( e_gi = 0; loop(floor(fh / 2), ui_col(ui_mix(e_S_FACE, e_gi % 3 ? 0xFFFFFF : 0x000000, e_gi % 2 ? 0.03 : 0.05)); gfx_rect(8 * sc, (6 + e_gi * 2) * sc, 1424 * sc, 1); e_gi += 1; ); );
ui_hw ? gfx_gradrect(6 * sc, 6 * sc, 1428 * sc, 40 * sc, 1, 1, 1, 0.06, 0, 0, 0, 0, 0, 0, 0, -0.06 / (40 * sc));
e_gi = 0; loop(4, pk_screw((e_gi % 2 ? 1422 : 18) * sc, (e_gi < 2 ? 18 : fh - 10) * sc); e_gi += 1; );

// header: badge, name, the model's line, presets / size / help
ui_col(e_S_INK); gfx_circle(48 * sc, 26 * sc, 13 * sc, 1, 1); gfx_setfont(4); ui_col(e_S_FACE); ui_text(48 * sc, 21 * sc, "GFX");
gfx_setfont(6, "Arial", 24 * sc, 'e_bi'); ui_col(e_S_INK); gfx_x = 70 * sc; gfx_y = 12 * sc; gfx_drawstr("VRB45");
e_txt(178, 21, e_mdl == 0 ? "DIGITAL ROOM SIMULATOR" : e_mdl == 1 ? "DIGITAL BROADCAST REVERBERATOR" : e_mdl == 2 ? "CONSOLE REVERBERATION UNIT" : "DIGITAL REVERBERATOR / PROCESSOR", 11, 0.75);
ui_size_picker(1360 * sc, 14 * sc);

// meters: input and reverb out
e_meter(30, 56, e_piL > e_piR ? e_piL : e_piR, "IN"); e_meter(62, 56, e_rvd, "REV");
e_rvd = max(e_rvl, e_rvd * 0.88); e_rvl = 0; e_piL *= 0.85; e_piR *= 0.85;

// ---------- MODEL ----------
e_group(96, 52, 120, 248, "MODEL");
e_key(108, 64, 96, 30, "ROOM SIM", e_mdl == 0, 0) ? ( slider1 = 0; ui_auto(1); e_update(); );
e_key(108, 100, 96, 30, "BROADCAST", e_mdl == 1, 0) ? ( slider1 = 1; ui_auto(1); e_update(); );
e_key(108, 136, 96, 30, "DIALOGUE", e_mdl == 2, 0) ? ( slider1 = 2; ui_auto(1); e_update(); );
e_key(108, 172, 96, 30, "NON-LIN", e_mdl == 3, 0) ? ( slider1 = 3; ui_auto(1); e_update(); );
e_ctxt(156, 210, e_mdl == 3 ? "SHAPE" : "", 10, 0.85);
e_mdl == 3 ? (
  e_key(108, 224, 30, 22, "RM", slider16 == 0, 0) ? ( slider16 = 0; ui_auto(16); e_update(); );
  e_key(141, 224, 30, 22, "GT", slider16 == 1, 0) ? ( slider16 = 1; ui_auto(16); e_update(); );
  e_key(174, 224, 30, 22, "RV", slider16 == 2, 0) ? ( slider16 = 2; ui_auto(16); e_update(); );
);
e_key(108, 260, 96, 30, "VINTAGE", slider15, 0) ? ( slider15 = 1 - slider15; ui_auto(15); e_update(); );

// ---------- displays, upper row ----------
e_group(226, 52, 200, 108, "1st REFLECTION"); e_disp(0, 232, 62, "DELAY", "ms"); e_disp(1, 332, 62, "LEVEL", "dB");
e_group(432, 52, 200, 108, "REVERB");         e_disp(2, 438, 62, "DELAY", "ms"); e_disp(3, 538, 62, "LEVEL", "dB");
e_group(762, 52, 300, 108, "REVERB TIME");    e_disp(4, 768, 62, "HIGH END", "x"); e_disp(5, 868, 62, "TIME", "SEC"); e_disp(6, 968, 62, "LOW END", "x");
e_group(1068, 52, 112, 108, "ROOM");          e_disp(7, 1080, 62, "SIZE", "m3");
// ---------- displays, lower row ----------
e_group(226, 192, 200, 108, "REFLECTIONS");   e_disp(8, 232, 202, "DENSITY", "%"); e_disp(9, 332, 202, "DIFFUSION", "%");
e_group(432, 192, 200, 108, "FILTER");        e_disp(10, 438, 202, "LO CUT", "Hz"); e_disp(11, 538, 202, "HI CUT", "kHz");
e_group(762, 192, 300, 108, "CHARACTER");     e_disp(12, 768, 202, "DRIVE", "%"); e_disp(13, 868, 202, "WIDTH", "%"); e_disp(14, 968, 202, "DRIFT", "%");
e_group(1068, 192, 112, 108, "OUTPUT");       e_disp(15, 1080, 202, "MIX", "%");

// ---------- the data wheel, the program display and the memory keys ----------
e_group(638, 52, 118, 248, "PARAMETERS");
e_wheel(697, 106, 34);
e_ctxt(697, 150, "SELECTED", 9, 0.6);
e_ctxt(697, 162, e_vsel == 0 ? "REFL DELAY" : e_vsel == 1 ? "REFL LEVEL" : e_vsel == 2 ? "REV DELAY" : e_vsel == 3 ? "REV LEVEL" : e_vsel == 4 ? "RT HIGH" :
     e_vsel == 5 ? "RT TIME" : e_vsel == 6 ? "RT LOW" : e_vsel == 7 ? "ROOM SIZE" : e_vsel == 8 ? "DENSITY" : e_vsel == 9 ? "DIFFUSION" : e_vsel == 10 ? "LO CUT" :
     e_vsel == 11 ? "HI CUT" : e_vsel == 12 ? "DRIVE" : e_vsel == 13 ? "WIDTH" : e_vsel == 14 ? "DRIFT" : e_vsel == 15 ? "MIX" : e_vsel == 16 ? "TRIM" : e_vsel == 17 ? "LEVEL" :
     e_vsel == 18 ? "DRIFT SPEED" : e_vsel == 19 ? "SAT" : e_vsel == 20 ? "BIAS" : e_vsel == 21 ? "LO BAND" : e_vsel == 22 ? "HI BAND" : "CEILING", 10, 0.95);
// program number + LIST (all presets by name), prev / next under them, then memory keys 1 - 9, 0 = 10
ui_col(e_S_WIN); lz_rr(650, 180, 46, 30, 4);
sprintf(#e_pn, e_lastp > 0 ? "P%d" : "P-", e_lastp); seg_str(654 * sc, 185 * sc, 8 * sc, 20 * sc, 3, e_lastp > 0 ? #e_pn : "P--", e_S_ON, e_S_OFF);
e_key(650, 214, 47, 20, "", -1, 0) ? e_load_preset(e_lastp <= 1 ? 10 : e_lastp - 1);
e_key(701, 214, 47, 20, "", -1, 0) ? e_load_preset(e_lastp >= 10 ? 1 : e_lastp + 1);
ui_col(e_S_KT); gfx_triangle(677.25 * sc, 219 * sc, 677.25 * sc, 229 * sc, 669.75 * sc, 224 * sc);
gfx_triangle(720.75 * sc, 219 * sc, 720.75 * sc, 229 * sc, 728.25 * sc, 224 * sc);   // the arrows
e_key(700, 180, 48, 30, "LIST", -1, 0) ? (
  gfx_x = 700 * sc; gfx_y = 210 * sc;
  e_load_preset(gfx_showmenu("Vocal Air|Concert Room|Drum Room|Broadcast Plate|Warm Hall (vintage)|Voice-Over Booth|Narration Space|Gated Snare|Reverse Swell|Tight Ambience|Reset all to defaults"));
);
e_gi = 0; loop(10, e_key(650 + (e_gi % 5) * 20, 242 + floor(e_gi / 5) * 23, 18, 20, e_gi == 9 ? "0" : sprintf(#e_kn, "%d", e_gi + 1), -1, 0) ? e_load_preset(e_gi + 1); e_gi += 1; );
// ---------- IN / OUT: trim + guard, the output level and saturation ----------
e_group(1192, 52, 232, 248, "IN / OUT");
e_disp(16, 1206, 64, "TRIM", "dB");
e_disp(17, 1206, 182, "LEVEL", "dB");
e_disp(19, 1316, 64, "SAT", "%");
e_key(1318, 215, 84, 22, "GUARD", slider29, 0) ? ( slider29 = 1 - slider29; ui_auto(29); e_update(); );

pk_end();
ui_end();
0;
);
