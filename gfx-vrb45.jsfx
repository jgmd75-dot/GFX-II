function j_txt(x, y, s, j_sz, a) ( gfx_setfont(6, "Arial", j_sz * sc, 'b'); ui_col(ui_mix(j_S_IN, j_S_INK, a)); gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
