function ch_pstr(p) (
  p == 2 ? "14:4.2 1:90 9:1 10:1 155:-55 156:12 157:250 7:0 103:0 104:10 105:-7 106:4 107:6 5:1 59:-1.5 60:180 62:-2 63:300 64:1.2 65:2.5 66:3200 67:1.2 68:3 69:12000 72:1 11:0 171:20" :
  p == 3 ? "14:-1.7 1:80 7:2 127:4.5 128:2 129:1 130:1 132:100 5:2 75:200 76:1.5 77:-2 79:450 80:1.2 81:-1.5 83:3500 84:1.2 85:2 87:11000 88:1.2 89:3 102:1 11:2 177:2.5 179:1" :
  p == 4 ? "1:30 9:2 10:1 158:-30 159:40 160:30 161:90 162:70 163:0 7:0 103:0 104:8 105:-6 106:3 107:6 5:0 29:4 30:1 31:5 32:0 33:0 34:-4 35:1 36:3 37:0 11:0 171:35" :
  p == 5 ? "14:2.8 1:80 9:2 10:1 158:-28 159:30 160:40 161:140 162:220 163:0 7:0 103:4 104:6 105:-6 106:5 107:5 110:70 5:1 59:2 60:200 61:1 62:-3 63:500 65:3 66:5000 67:1.4 68:2 69:10000 11:1 171:30" :
  p == 6 ? "14:-0.6 1:50 9:0 10:1 136:-36 137:30 140:120 141:400 143:2 148:60 149:3000 7:1 113:-22 114:4 115:5 116:200 117:4 5:1 59:3 60:100 61:1 62:-4 63:400 64:1.4 65:2 66:4000 11:0 171:25" :
  p == 7 ? "14:2.1 1:30 2:12000 7:0 103:0 104:9 105:-7 106:2 107:3 5:0 25:1 43:3 44:1 45:7 46:1 47:1 48:4 49:1 50:6 11:2 177:4.5 179:0 180:15" :
  p == 8 ? "1:90 2:9500 7:1 113:-20 114:3 115:8 116:250 117:3 5:1 62:-3 63:350 64:1 65:2 66:2200 67:0.8 68:-2 69:7000 70:1 11:1 171:25" :
  p == 9 ? "1:80 7:1 113:-20 114:2.5 115:10 116:300 117:2.5 5:2 75:150 76:1.5 77:-2.5 79:250 80:1.2 81:-2 83:4000 84:0.8 85:1.5 87:12000 88:1.5 89:3.5 102:1 11:3 196:2 197:-1.5 198:1 199:0 200:1" :
  p == 10 ? "14:-1.3 1:40 7:2 127:3 128:1 129:1 130:0 132:80 5:0 29:3 30:1 31:1 33:3 34:-2 35:4 36:2 37:1 11:0 171:15" :
  p == 11 ? "14:-4 1:30 7:1 113:-24 114:4 115:10 116:150 117:4 126:60 5:1 59:2 60:60 62:-1.5 63:400 68:2.5 69:12000 11:3 196:3 197:-2 198:2 199:2 200:1 201:100" :
  p == 12 ? "14:1.3 1:100 2:14000 9:1 10:1 155:-50 156:15 157:300 7:1 113:-26 114:4 115:2 116:150 117:6 118:-2 5:2 75:90 77:-3 79:250 80:1.5 81:1.5 83:2500 85:2.5 87:7000 89:-1.5 11:0 171:15" :
  p == 13 ? "14:1.1 1:60 7:0 103:4 104:18 105:-12 106:3 107:7 110:60 5:1 59:3 60:90 62:-3 63:600 68:4 69:9000 11:1 171:50" :
  p == 14 ? "14:2.2 1:200 2:5000 7:0 103:4 104:14 105:-10 106:6 107:6 5:0 25:1 47:2 48:8 11:3 196:8 197:-6 198:6 199:3 200:1 201:100" :
  "";
);
CH_PT = 900000;                                           // preset parser scratch
function ch_nums(s, dst) local(i, n, c, len, acc, neg, fr, scl, inn) (
  n = 0; i = 0; inn = 0; len = strlen(s);
  loop(len + 1,
    c = i < len ? str_getchar(s, i) : 32;
    c >= 48 && c <= 57 ? (
      !inn ? ( inn = 1; acc = 0; fr = 0; scl = 1; neg = 0; );
      fr ? ( scl *= 0.1; acc += (c - 48) * scl; ) : acc = acc * 10 + c - 48;
    ) : c == 46 ? (
      !inn ? ( inn = 1; acc = 0; scl = 1; neg = 0; ); fr = 1;
    ) : c == 45 ? (
      inn = 1; acc = 0; fr = 0; scl = 1; neg = 1;
    ) : (
      inn ? ( dst[n] = neg ? -acc : acc; n += 1; inn = 0; );
    );
    i += 1;
  );
  n;
);
// a preset: everything back to Init, then its changes. GUARD, DRIFT and the output stage stay as they are
// (Reset all to defaults, p < 0: those too)
function ch_load(p) local(n, i, k4, k15, k16, k17, k18, k19, k20) (
  k4 = slider4; k15 = slider15; k16 = slider16; k17 = slider17; k18 = slider18; k19 = slider19; k20 = slider20;
  ch_defaults();
  p > 0 ? (
    slider4 = k4; slider15 = k15; slider16 = k16; slider17 = k17; slider18 = k18; slider19 = k19; slider20 = k20;
    n = ch_nums(ch_pstr(p), CH_PT);
    i = 0; loop(floor(n / 2), slider(CH_PT[i * 2]) = CH_PT[i * 2 + 1]; i += 1; );
  );
  ch_pauto = 1;
);
function ch_ms(ms) ( 1 - exp(-1 / (max(ms, 0.01) * 0.001 * srate)); );
function ch_shp(x, p) ( x / (1 + abs(x) ^ p) ^ (1 / p); );
function ch_tanh(x) ( x = min(max(x, -3), 3); x * (27 + x * x) / (27 + 9 * x * x); );
// the dry path of slot k, delayed by lat samples (the ring is written every sample)
function ch_dry(k, x, lat) local(b) (
  b = CH_DQ + k * CH_DN;
  b[ch_dw] = x;
  lat > 0 ? b[(ch_dw - lat) & (CH_DN - 1)] : x;
);
// IN / OUT: a 10 ms crossfade between the slot's engine and its (latency matched) dry path
function ch_mix(g, w, d) ( g >= 1 ? w : g <= 0 ? d : d + (w - d) * g; );


// the engines a slot runs: start one clean (its constants, its @init, its @slider)
function ch_eq_start(m) (
  m == 0 ? ( eqt_consts(); eqt_init(); eqt_consts(); eqt_slider(); ch_eqlat = eqt_own_pdc_delay; ) :
  m == 1 ? ( eqb_consts(); eqb_init(); eqb_consts(); eqb_slider(); ch_eqlat = 0; ) :
           ( eqs_consts(); eqs_init(); eqs_consts(); eqs_slider(); ch_eqlat = 0; );
);
function ch_eq_slider() (
  ch_eqm == 0 ? ( eqt_consts(); eqt_slider(); ) : ch_eqm == 1 ? ( eqb_consts(); eqb_slider(); ) : ( eqs_consts(); eqs_slider(); );
);
function ch_cmp_start(m) (
  m == 0 ? ( cpf_consts(); cpf_init(); cpf_consts(); cpf_slider(); ch_cmplat = cpf_own_pdc_delay; ) :
  m == 1 ? ( cpo_consts(); cpo_init(); cpo_consts(); cpo_slider(); ch_cmplat = 0; ) :
           ( cps_consts(); cps_init(); cps_consts(); cps_slider(); ch_cmplat = 0; );
);
function ch_cmp_slider() (
  ch_cmpm == 0 ? ( cpf_consts(); cpf_slider(); ) : ch_cmpm == 1 ? ( cpo_consts(); cpo_slider(); ) : ( cps_consts(); cps_slider(); );
);
// the slot's gain reduction for the panel (dB, the most since the panel last looked)
function ch_cmp_gr() (
  ch_cmpm == 0 ? cpf_fda_gr : ch_cmpm == 1 ? -cpo_grm : cps_grdisp;
);
// ---------- DRUM GATE (new for the strip): a fast peak gate keyed through a band-pass (KEY), 4 dB of hysteresis,
// HOLD, RELEASE, FAST / SOFT attack, and 1 ms of look-ahead so the stick is never clipped
function dg_setup() (
  dg_thr = slider158; dg_rg = 10 ^ (-slider159 / 20);
  dg_hold = floor(slider160 * 0.001 * srate);
  dg_rc = 1 - exp(-3 / (max(slider161, 1) * 0.001 * srate));
  dg_ac = 1 - exp(-3 / ((slider163 >= 0.5 ? 1.5 : 0.08) * 0.001 * srate));
  dg_kb.bq_set(5, slider162, 1.2, 0);
  dg_la = floor(0.001 * srate + 0.5);
);
function dg_init() ( dg_env = 0; dg_g = 10 ^ (-slider159 / 20); dg_op = 0; dg_hc = 0; dg_setup(); dg_dec = exp(-1 / (0.008 * srate)); );
function dg_sample() local(k, lv) (
  k = abs(dg_kb.bq_run((ch_l + ch_r) * 0.5)) * 2;
  dg_env = k > dg_env ? k : dg_env * dg_dec;
  lv = 20 * log10(max(dg_env, 0.0000001));
  lv > dg_thr ? ( dg_op = 1; dg_hc = dg_hold; ) : lv < dg_thr - 4 ? ( dg_hc > 0 ? dg_hc -= 1 : dg_op = 0; );
  dg_g += ((dg_op ? 1 : dg_rg) - dg_g) * (dg_op ? dg_ac : dg_rc);
  dg_l = ch_dry(6, ch_l, dg_la) * dg_g; dg_r = ch_dry(7, ch_r, dg_la) * dg_g;
);
function ch_gate_lat() ( ch_gatem == 0 ? gtg_own_pdc_delay : ch_gatem == 2 ? dg_la : 0; );
function ch_gate_start(m) (
  m == 0 ? ( gtg_consts(); gtg_init(); gtg_consts(); gtg_slider(); gtg_block(); ) :
  m == 1 ? ( gxo_consts(); gxo_init(); gxo_consts(); gxo_slider(); ) : dg_init();
  ch_gatelat = ch_gate_lat();
);
function ch_gate_slider() (
  ch_gatem == 0 ? ( gtg_consts(); gtg_slider(); ) : ch_gatem == 1 ? ( gxo_consts(); gxo_slider(); ) : dg_setup();
);
// the gate's reduction for the panel (dB, positive) and whether it is open
function ch_gate_gr() ( ch_gatem == 0 ? -min(gtg_mGA, gtg_mGB) : ch_gatem == 1 ? -gxo_gtm : -20 * log10(max(dg_g, 0.00001)); );
function ch_sat_lat() ( ch_satm == 3 ? tsv_own_pdc_delay : 0; );
function ch_sat_start(m) (
  m == 2 ? ( sth_consts(); sth_init(); sth_consts(); sth_slider(); sth_block(); ) :
  m == 3 ? ( tsv_consts(); tsv_init(); tsv_consts(); tsv_slider(); tsv_block(); );
  ch_satlat = ch_sat_lat();
);
function ch_sat_slider() (
  ch_satm == 2 ? ( sth_consts(); sth_slider(); ) :
  ch_satm == 3 ? ( ch_t2 = slider204; slider204 = ch_tos; tsv_consts(); tsv_slider(); slider204 = ch_t2; );
);

function ch_latency() (
  ch_lat = ch_eqlat + ch_cmplat + ch_gatelat + ch_satlat;
  pdc_bot_ch = 0; pdc_top_ch = 2; pdc_delay = ch_lat;
);

function ch_update() local(q, tr) (
  in_setup(slider3, slider4 >= 0.5);
  ch_hpon = slider1 > 20.5; ch_lpon = slider2 < 21990;
  ch_eqt = slider6 >= 0.5; ch_cmpt = slider8 >= 0.5; ch_gatet = slider10 >= 0.5; ch_satt = slider12 >= 0.5;
  ch_lev = 10 ^ (slider14 / 20);
  drift_macro(slider15);
  // (HEAD's BOOST drives the band saturation as on the Headsmoother, on top of BAND SAT)
  ost_setup(min(slider16 / 100 + (ch_satm == 2 && slider12 >= 0.5 ? slider180 / 100 : 0), 1), slider17 / 100, slider18, slider19, slider20, 1);
  // SAT: IRON / TRANSISTOR (the output iron, or a transistor line stage)
  tr = ch_satm == 1;
  ch_od = slider171 / 100; ch_odr = 10 ^ (ch_od * 15 / 20); ch_oco = 1 / ch_odr ^ 0.85;
  ch_bl.bq_set(4, 70, 0.7, tr ? 0 : 0.6 + 0.8 * ch_od); ch_br.bq_set(4, 70, 0.7, tr ? 0 : 0.6 + 0.8 * ch_od);
  ch_pl.bq_set(3, min(7000, srate * 0.45), 0.7, tr ? 0.8 + 0.8 * ch_od : 0); ch_pr.bq_set(3, min(7000, srate * 0.45), 0.7, tr ? 0.8 + 0.8 * ch_od : 0);
  ch_isc = 1 - exp(-2 * $pi * min(19000 - 7000 * ch_od, srate * 0.45) / srate);
);

// a slot's switch-over: the engine (and the ORDER) change at the silent point of the fade
function ch_apply() (
  (slider5 | 0) != ch_eqm ? ( ch_eqm = slider5 | 0; ch_eq_start(ch_eqm); );
  (slider7 | 0) != ch_cmpm ? ( ch_cmpm = slider7 | 0; ch_cmp_start(ch_cmpm); );
  (slider9 | 0) != ch_gatem ? ( ch_gatem = slider9 | 0; ch_gate_start(ch_gatem); );
  (slider11 | 0) != ch_satm ? ( ch_satm = slider11 | 0; ch_sat_start(ch_satm); );
  ch_ord = slider13 >= 0.5;
  ch_gla = slider143; ch_gatem == 0 ? ( gtg_block(); ch_gatelat = ch_gate_lat(); );
  ch_tos = slider204; ch_satm == 3 ? ( tsv_slider(); tsv_block(); ch_satlat = ch_sat_lat(); );
  memset(CH_DQ, 0, 10 * CH_DN);
  ch_latency();
  ch_update();
);
function ch_pending() (
  (slider5 | 0) != ch_eqm || (slider7 | 0) != ch_cmpm || (slider9 | 0) != ch_gatem || (slider11 | 0) != ch_satm ||
  (slider13 >= 0.5) != ch_ord || slider143 != ch_gla || slider204 != ch_tos;
);

// ---------- EQ ----------
function ch_eq() local(wl, wr) (
  spl0 = ch_l * ch_ihd; spl1 = ch_r * ch_ihd;
  ch_eqm == 0 ? eqt_sample() : ch_eqm == 1 ? eqb_sample() : eqs_sample();
  wl = spl0 * ch_hd; wr = spl1 * ch_hd;
  ch_eqg = ch_eqt ? min(ch_eqg + ch_xs, 1) : max(ch_eqg - ch_xs, 0);
  ch_l = ch_mix(ch_eqg, wl, ch_dry(0, ch_l, ch_eqlat));
  ch_r = ch_mix(ch_eqg, wr, ch_dry(1, ch_r, ch_eqlat));
);
// ---------- COMP ----------
function ch_comp() local(wl, wr) (
  spl0 = ch_l * ch_ihd; spl1 = ch_r * ch_ihd;
  ch_cmpm == 0 ? cpf_sample() : ch_cmpm == 1 ? cpo_sample() : cps_sample();
  wl = spl0 * ch_hd; wr = spl1 * ch_hd;
  ch_cmpg = ch_cmpt ? min(ch_cmpg + ch_xs, 1) : max(ch_cmpg - ch_xs, 0);
  ch_l = ch_mix(ch_cmpg, wl, ch_dry(2, ch_l, ch_cmplat));
  ch_r = ch_mix(ch_cmpg, wr, ch_dry(3, ch_r, ch_cmplat));
);
function ch_gate() local(wl, wr) (
  ch_gatem == 2 ? ( dg_sample(); wl = dg_l; wr = dg_r; ) : (
    spl0 = ch_l; spl1 = ch_r;
    ch_gatem == 0 ? gtg_sample() : gxo_sample();
    wl = spl0; wr = spl1;
  );
  ch_gateg = ch_gatet ? min(ch_gateg + ch_xs, 1) : max(ch_gateg - ch_xs, 0);
  ch_l = ch_mix(ch_gateg, wl, ch_dry(4, ch_l, ch_gatelat));
  ch_r = ch_mix(ch_gateg, wr, ch_dry(5, ch_r, ch_gatelat));
);
// ---------- SAT ----------
function ch_sat() local(wl, wr, t, k) (
  ch_satg = ch_satt ? min(ch_satg + ch_xs, 1) : max(ch_satg - ch_xs, 0);
  ch_satm >= 2 ? (
    // HEAD (the Headsmoother's tape head) / TS-7: always running, the IN key crossfades (latency kept)
    spl0 = ch_l * ch_ihd; spl1 = ch_r * ch_ihd;
    ch_satm == 2 ? sth_sample() : tsv_sample();
    wl = spl0 * ch_hd; wr = spl1 * ch_hd;
    ch_l = ch_mix(ch_satg, wl, ch_dry(8, ch_l, ch_satlat)); ch_r = ch_mix(ch_satg, wr, ch_dry(9, ch_r, ch_satlat));
  ) : ch_satg > 0 ? (
    t = ch_hd * 1.1;
    ch_satm == 1 ? (
      // TRANSISTOR: a harder knee, a touch of asymmetry, a little brighter
      wl = ch_pl.bq_run(ch_l); wr = ch_pr.bq_run(ch_r);
      wl = (ch_shp(wl * ch_odr / t + 0.04, 5) - ch_shp(0.04, 5)) * t * ch_oco;
      wr = (ch_shp(wr * ch_odr / t + 0.04, 5) - ch_shp(0.04, 5)) * t * ch_oco;
      k = wl - ch_d3xl + ch_dcc * ch_d3yl; ch_d3xl = wl; ch_d3yl = k; wl = k;
      k = wr - ch_d3xr + ch_dcc * ch_d3yr; ch_d3xr = wr; ch_d3yr = k; wr = k;
    ) : (
      // IRON: the low band saturates first (the core), the whole wave rounds softly, the top softens with DRIVE
      wl = ch_bl.bq_run(ch_l); wr = ch_br.bq_run(ch_r);
      ch_lol += (wl - ch_lol) * ch_ilc; ch_lor += (wr - ch_lor) * ch_ilc;
      k = 1 + 3 * ch_od;
      wl += (ch_tanh(ch_lol * k / t) * t / k - ch_lol) * ch_od;
      wr += (ch_tanh(ch_lor * k / t) * t / k - ch_lor) * ch_od;
      wl = ch_shp(wl * ch_odr / t, 2.2) * t * ch_oco;
      wr = ch_shp(wr * ch_odr / t, 2.2) * t * ch_oco;
      ch_isl += (wl - ch_isl) * ch_isc; ch_isr += (wr - ch_isr) * ch_isc; wl = ch_isl; wr = ch_isr;
    );
    ch_l = ch_mix(ch_satg, wl, ch_l); ch_r = ch_mix(ch_satg, wr, ch_r);
  );
);

drV.drift_init(0.8 + rand(0.5));
function ch_srinit() (
  ch_sr = srate;
  in_init();
  ost_init(0); ostL.ost_ch_init(); ostR.ost_ch_init();
  ch_xs = 1 / (0.010 * srate);                            // IN / OUT crossfade: 10 ms
  ch_pdn = 1 / (0.012 * srate); ch_pup = 1 / (0.020 * srate);   // engine / ORDER / preset change: 12 ms out, 20 ms in
  ch_dcc = 1 - 2 * $pi * 8 / srate;                       // DC block after the transistor's asymmetry (8 Hz)
  ch_sga = ch_ms(80); ch_sgr = ch_ms(400);                // the supply's sag follower
  ch_ilc = 1 - exp(-2 * $pi * 150 / srate);               // IRON: the low band that saturates first
  ch_vuk = 1 - exp(-1 / (0.3 * srate));                   // VU ballistics (the needle has its own mass as well)
  ch_gla = slider143; ch_tos = slider204;
  ch_eqm = slider5 | 0; ch_cmpm = slider7 | 0; ch_gatem = slider9 | 0; ch_satm = slider11 | 0; ch_ord = slider13 >= 0.5;
  // every engine starts once (each keeps its own settings); the strip runs the chosen one per slot
  ch_eq_start(1); ch_eq_start(2); ch_eq_start(0); ch_eq_start(ch_eqm);
  ch_cmp_start(1); ch_cmp_start(2); ch_cmp_start(0); ch_cmp_start(ch_cmpm);
  ch_gate_start(1); ch_gate_start(2); ch_gate_start(0); ch_gate_start(ch_gatem);
  ch_sat_start(2); ch_sat_start(3); ch_sat_start(ch_satm);
  memset(CH_DQ, 0, 10 * CH_DN); ch_dw = 0;
  ch_latency();
  ch_update();
);
ch_srinit();
ch_eqg = ch_eqt; ch_cmpg = ch_cmpt; ch_gateg = ch_gatet; ch_satg = ch_satt;
ch_pcf = 0; ch_pcg = 1; ch_sag = 0; ch_hpw = ch_hpon; ch_lpw = ch_lpon; ch_hf = log(slider1); ch_lf = log(min(slider2, srate * 0.45));
ch_hl.bq_set(1, slider1, 0.7071, 0); ch_hr.bq_set(1, slider1, 0.7071, 0); ch_ll.bq_set(0, min(slider2, srate * 0.45), 0.7071, 0); ch_lr.bq_set(0, min(slider2, srate * 0.45), 0.7071, 0); ch_volt = 1; ch_hd = 1; ch_ihd = 1;
!ch_dflt ? pr_cur = 1;
ch_dflt = 1;

@slider
!ch_pcf && !ch_pcq ? ( ch_update(); ch_eq_slider(); ch_cmp_slider(); ch_gate_slider(); ch_sat_slider(); );

@block
srate != ch_sr ? ch_srinit();
// an engine, ORDER or preset change: fade out (12 ms), switch at the silent point, fade back in (20 ms)
(ch_pending() || ch_pcq) && !ch_pcf ? ( ch_pcf = 1; ch_pcq = 0; );
ch_pcf == 2 ? ( ch_pnext ? ( ch_load(ch_pnext); ch_pnext = 0; ); ch_apply(); ch_eq_slider(); ch_cmp_slider(); ch_gate_slider(); ch_sat_slider(); ch_pcf = 3; ch_pch = ch_lat + 32; );
ch_pcf != 1 ? ( ch_update(); ch_eq_slider(); ch_cmp_slider(); ch_gate_slider(); ch_sat_slider(); );
ch_eqm == 0 ? eqt_block() : ch_eqm == 1 ? eqb_block() : eqs_block();
ch_cmpm == 0 ? cpf_block() : ch_cmpm == 1 ? cpo_block() : cps_block();
// (the GATE's look-ahead changes the latency: the engine keeps the old one until the fade's silent point)
ch_gatem == 0 ? ( ch_t = slider143; slider143 = ch_gla; gtg_block(); slider143 = ch_t; ) : ch_gatem == 1 ? gxo_block() : 0;
// (TS-7's oversampling changes its latency too: the same hold until the silent point)
ch_satm == 2 ? sth_block() : ch_satm == 3 ? ( ch_t = slider204; slider204 = ch_tos; tsv_block(); slider204 = ch_t; );
// DRIFT: the supply voltage wanders slowly (its sag under load is followed per sample)
// LOW CUT / HIGH CUT: the corners glide (about 20 ms), the filters always run and fade in and out (10 ms)
ch_k = 1 - exp(-samplesblock / (0.02 * srate));
ch_hf += (log(slider1) - ch_hf) * ch_k; ch_lf += (log(min(slider2, srate * 0.45)) - ch_lf) * ch_k;
ch_hl.bq_set(1, exp(ch_hf), 0.7071, 0); ch_hr.bq_set(1, exp(ch_hf), 0.7071, 0);
ch_ll.bq_set(0, exp(ch_lf), 0.7071, 0); ch_lr.bq_set(0, exp(ch_lf), 0.7071, 0);
ch_vv = drV.drift_tick(0.12 * dm_s * samplesblock / srate);
ch_volt = 1 + 0.06 * dm_a * ch_vv;

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@sample
// ---------- INPUT: GAIN / GUARD ----------
in_process(spl0, spl1); ch_l = in_l; ch_r = in_r;
ch_ipl = max(ch_ipl, abs(ch_l)); ch_ipr = max(ch_ipr, abs(ch_r));
// the supply sags under load: a slow follower of the level pulls every stage's headroom down a little
ch_t = max(abs(ch_l), abs(ch_r));
ch_sag += (ch_t - ch_sag) * (ch_t > ch_sag ? ch_sga : ch_sgr);
ch_hd = ch_volt * (1 - 0.12 * dm_a * min(ch_sag, 1.5)); ch_ihd = 1 / ch_hd;
// ---------- LOW CUT / HIGH CUT ----------
ch_hpw = ch_hpon ? min(ch_hpw + ch_xs, 1) : max(ch_hpw - ch_xs, 0);
ch_lpw = ch_lpon ? min(ch_lpw + ch_xs, 1) : max(ch_lpw - ch_xs, 0);
ch_l = ch_mix(ch_hpw, ch_hl.bq_run(ch_l), ch_l); ch_r = ch_mix(ch_hpw, ch_hr.bq_run(ch_r), ch_r);
ch_l = ch_mix(ch_lpw, ch_ll.bq_run(ch_l), ch_l); ch_r = ch_mix(ch_lpw, ch_lr.bq_run(ch_r), ch_r);
// ---------- GATE, then EQ and COMP in ORDER, then SAT ----------
ch_gate();
ch_ord ? ( ch_comp(); ch_eq(); ) : ( ch_eq(); ch_comp(); );
ch_sat();
ch_dw = (ch_dw + 1) & (CH_DN - 1);
// ---------- OUTPUT ----------
ch_l *= ch_lev; ch_r *= ch_lev;
ch_pcf == 1 ? ( ch_pcg -= ch_pdn; ch_pcg <= 0 ? ( ch_pcg = 0; ch_pcf = 2; ); ) :
ch_pcf == 3 ? ( ch_pch > 0 ? ch_pch -= 1 : ch_pcg += ch_pup; ch_pcg >= 1 ? ( ch_pcg = 1; ch_pcf = 0; ); );
ch_pcf ? ( ch_l *= ch_pcg; ch_r *= ch_pcg; );
ch_l = ostL.ost_band(ch_l); ch_r = ostR.ost_band(ch_r);
ost_out(ch_l, ch_r);
spl0 = ost_l; spl1 = ost_r;
ch_vul += (spl0 * spl0 - ch_vul) * ch_vuk; ch_vur += (spl1 * spl1 - ch_vur) * ch_vuk;

@gfx 960 620
ui_begin(960, 620);

// ---------- the 45 family's enamel: bone-grey baked enamel modules on a charcoal frame, safety orange ----------
FRAME = 0x232426; FACE = 0xD6D2C4; FACE2 = 0xCBC6B7; INK = 0x1C1C1C; DIM = 0x4A4842; RULE = 0xA9A497;
ACC = 0xFF7900; GRN = 0x4CD06A; C_HPF = 0xF2C83E; C_LPF = 0x2A2A2E;
C_GAIN = 0xFF7900; C_FREQ = 0x4A4842; C_Q = 0x5E7182; C_DRV = 0xC8402A;
dy_ink = INK; dy_bg = FACE; dy_nov = 1; dy_kst = 35;

function setv(idx, v) ( slider(idx) = v; ui_auto(idx); );
// a module: the bone face, its title on a charcoal band, an optional IN key at the band's right end
function md(x, y, w, h, s) (
  ui_cola(0x000000, 0.35); gfx_rect((x + 1) * sc, (y + 2) * sc, w * sc, h * sc);
  ui_col(FACE); gfx_rect(x * sc, y * sc, w * sc, h * sc);
  ui_cola(0xFFFFFF, 0.35); gfx_rect(x * sc, y * sc, w * sc, 1 * sc);
  ui_col(INK); gfx_rect(x * sc, y * sc, w * sc, 18 * sc);
  rd_sub(x + 8, y + 2, s, FACE, 1);
);
function md_in(x, y, idx) ( rd_sq(x, y + 1, 30, 16, slider(idx) >= 0.5, GRN, "IN") ? setv(idx, slider(idx) >= 0.5 ? 0 : 1); );
// an engine key: lit when it is the slot's engine
function ek(x, y, w, idx, v, s) ( rd_sq(x, y, w, 20, (slider(idx) | 0) == v, ACC, s) ? setv(idx, v); );
function key(x, y, w, h, on, s) ( rd_sq(x, y, w, h, on, ACC, s); );
function rowlbl(x, y, s) ( rd_lbl(x, y - 6, s, DIM, 0.95); );
function hz(f) ( f >= 1000 ? sprintf(#v, "%.2f kHz", f / 1000) : sprintf(#v, "%.0f Hz", f); #v; );
// a stepped knob (n positions, ticks only); val is its printed value
function sk(cx, cy, r, idx, n, def, col, lab, val) (
  dy_step = n; strcpy(#sk_t, ""); loop(n - 1, strcat(#sk_t, "|"); ); dy_steps = #sk_t;
  dy_knob(cx, cy, r, idx, 0, n - 1, def, 0, col, lab, val);
);
// a knob that holds whole numbers (dB in 1 dB steps)
function wk(cx, cy, r, idx, lo, hi, def, col, lab, val) (
  dy_knob(cx, cy, r, idx, lo, hi, def, 0, col, lab, val);
  slider(idx) != floor(slider(idx) + 0.5) ? slider(idx) = floor(slider(idx) + 0.5);
);

// a compact 8-LED gain reduction row (1 2 3 4 6 9 12 20 dB)
function gr_row(x, y, gr) local(i, d, c) (
  rd_lbl(x - 14, y, "GR", DIM, 0.85);
  i = 0;
  loop(8,
    d = i == 0 ? 1 : i == 1 ? 2 : i == 2 ? 3 : i == 3 ? 4 : i == 4 ? 6 : i == 5 ? 9 : i == 6 ? 12 : 20;
    c = i < 4 ? 0x4CD06A : i < 6 ? 0xFFB020 : 0xFF3A22;
    ui_col(0x1A1A1C); gfx_rect((x + i * 34) * sc, (y - 6) * sc, 30 * sc, 12 * sc);
    ui_col(gr >= d ? c : ui_mix(c, 0x1A1A1C, 0.8)); gfx_rect((x + 1 + i * 34) * sc, (y - 5) * sc, 28 * sc, 10 * sc);
    gr_num ? ( sprintf(#v, "%d", d); rd_lbl(x + 15 + i * 34, y + 14, #v, DIM, 0.7); );
    i += 1;
  );
);

gr_num = 1;
// ---------- the frame ----------
ui_col(0x0A0A0B); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(FRAME); gfx_rect(0, 0, 960 * sc, 620 * sc);
ui_cola(0xFFFFFF, 0.05); gfx_rect(0, 0, 960 * sc, 1 * sc);

// ---------- header: badge, name, the 45 plate, presets, size ----------
rd_badge(26, 26, 15, FACE, FRAME);
rd_title(50, 9, "CHANNEL 45", 24, FACE);
rd_sub(52, 36, "MODULAR CHANNEL STRIP", RULE, 1);
ui_col(ACC); gfx_rect(232 * sc, 12 * sc, 46 * sc, 28 * sc);
rd_title(240, 13, "45", 20, INK);
pk_pextra = "Reset all to defaults";
k_ = pk_preset(300 * sc, 9 * sc, 440 * sc, 34 * sc, pr_cur, #ch_pm);
// the preset applies at the silent point of the strip's fade (no click), then the host hears every slider
k_ > 0 ? ( ch_pnext = k_ > ch_npre ? -1 : k_; pr_cur = k_ > ch_npre ? 1 : k_; ch_pcq = 1; );
ch_pauto ? ( gi = 1; loop(205, ui_auto(gi); gi += 1; ); ch_pauto = 0; );
ui_size_picker(862 * sc, 16 * sc);

// ======================== INPUT ========================
md(8, 58, 312, 112, "INPUT");
slider1 <= 20.5 ? strcpy(#v, "OFF") : hz(slider1);
dy_kf = 1; dy_knob(48, 114, 18, 1, 20, 500, 20, 1, C_HPF, "LOW CUT", #v);
slider2 >= 21990 ? strcpy(#v, "OFF") : hz(slider2);
dy_kf = 2; dy_knob(122, 114, 18, 2, 2000, 22000, 22000, 1, C_LPF, "HIGH CUT", #v);
sprintf(#v, "%+.1f dB", slider3); dy_knob(204, 114, 20, 3, -24, 24, 0, 0, C_GAIN, "GAIN", #v);
ui_guardclick(1600 + 3, 4, 204, 114, 29);
ch_im1.ui_ledm(272 * sc, 82 * sc, 10 * sc, 70 * sc, ch_ipl); ch_im2.ui_ledm(286 * sc, 82 * sc, 10 * sc, 70 * sc, ch_ipr);
ch_ipl *= 0.85; ch_ipr *= 0.85;
rd_lbl(284, 158, "IN", DIM, 0.8);

// ======================== COMP ========================
md(8, 176, 312, 220, "COMP"); md_in(282, 176, 8);
ek(16, 200, 94, 7, 0, "FET 45"); ek(114, 200, 94, 7, 1, "OB Q"); ek(212, 200, 100, 7, 2, "SMOOTH");
cm_ = slider7 | 0;
ch_grd = max(ch_grd * 0.8, ch_cmp_gr()); cpo_grm = 0; cps_grdisp = 0;
gr_row(34, 240, slider8 >= 0.5 ? ch_grd : 0);
CA = 290; CB = 356;
cm_ == 0 ? (
  // ---- FET 45: INPUT into a fixed threshold, OUTPUT, ATTACK / RELEASE (7 = fastest), RATIO keys, MIX, LINK
  sprintf(#v, "%+.1f dB", slider104); dy_knob(50, CA, 16, 104, -24, 24, 0, 0, C_GAIN, "INPUT", #v);
  sprintf(#v, "%+.1f dB", slider105); dy_knob(122, CA, 16, 105, -24, 24, 0, 0, C_FREQ, "OUTPUT", #v);
  sprintf(#v, "%.1f", slider106); dy_knob(194, CA, 16, 106, 1, 7, 3, 0, C_Q, "ATTACK", #v);
  sprintf(#v, "%.1f", slider107); dy_knob(266, CA, 16, 107, 1, 7, 7, 0, C_Q, "RELEASE", #v);
  gi = 0; loop(5, key(16 + gi * 40, CB - 12, 36, 20, (slider103 | 0) == gi, gi == 0 ? "4" : gi == 1 ? "8" : gi == 2 ? "12" : gi == 3 ? "20" : "ALL") ? setv(103, gi); gi += 1; );
  rd_lbl(112, CB + 16, "RATIO", INK, 0.9);
  sprintf(#v, "%.0f%%", slider110); dy_knob(240, CB, 14, 110, 0, 100, 100, 0, C_FREQ, "MIX", #v);
  key(274, CB - 12, 40, 20, slider109 >= 0.5, "LINK") ? setv(109, slider109 >= 0.5 ? 0 : 1);
) : cm_ == 1 ? (
  // ---- OB Q: THRESHOLD, RATIO, ATTACK, RELEASE; GAIN, LIMIT, MIX; TRANSFORMER, LINK
  sprintf(#v, "%.1f dB", slider113); dy_knob(50, CA, 16, 113, -40, 0, -18, 0, C_GAIN, "THRESH", #v);
  slider114 >= 19.95 ? strcpy(#v, "inf : 1") : sprintf(#v, "%.1f : 1", slider114); dy_knob(122, CA, 16, 114, 1, 20, 3, 1, C_GAIN, "RATIO", #v);
  sprintf(#v, "%.1f ms", slider115); dy_knob(194, CA, 16, 115, 0.1, 30, 3, 1, C_Q, "ATTACK", #v);
  sprintf(#v, "%.0f ms", slider116); dy_knob(266, CA, 16, 116, 30, 3000, 250, 1, C_Q, "RELEASE", #v);
  sprintf(#v, "%+.1f dB", slider117); dy_knob(50, CB, 16, 117, -10, 20, 0, 0, C_FREQ, "GAIN", #v);
  slider118 > -0.05 ? strcpy(#v, "OFF") : sprintf(#v, "%.1f dB", slider118); dy_knob(122, CB, 16, 118, -20, 0, 0, 0, C_DRV, "LIMIT", #v);
  sprintf(#v, "%.0f%%", slider126); dy_knob(194, CB, 16, 126, 0, 100, 100, 0, C_FREQ, "MIX", #v);
  key(244, CB - 22, 66, 20, slider124 >= 0.5, "XFMR") ? setv(124, slider124 >= 0.5 ? 0 : 1);
  key(244, CB + 2, 66, 20, slider125 >= 0.5, "LINK") ? setv(125, slider125 >= 0.5 ? 0 : 1);
) : (
  // ---- SMOOTH: COMPRESS, OUTPUT, BLEND, LIMIT; ATTACK and RELEASE keys
