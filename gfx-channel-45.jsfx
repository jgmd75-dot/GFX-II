  sprintf(#v, "%.0f dB", slider156); dy_knob(160, GA + 10, 18, 156, 0, 60, 20, 0, C_GAIN, "RANGE", #v);
  sprintf(#v, "%.0f ms", slider157); dy_knob(260, GA + 10, 18, 157, 20, 2000, 200, 1, C_Q, "RELEASE", #v);
