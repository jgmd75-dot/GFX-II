  eqt_hs != eqt_ths ? ( eqt_hw = max(eqt_hw - eqt_tq_kS, 0); eqt_hw <= 0 ? eqt_hs = eqt_ths; eqt_tq_mv = 1; ) : eqt_hw < 1 ? ( eqt_hw = min(eqt_hw + eqt_tq_kS, 1); eqt_tq_mv = 1; );
