  sprintf(#v, "%.0f ms", slider141); dy_knob(272, GA, 15, 141, 5, 4000, 150, 1, C_Q, "RELEASE", #v);
  slider148 <= 20.5 ? strcpy(#v, "OFF") : hz(slider148); dy_kf = 1; dy_knob(40, GB, 15, 148, 20, 5000, 20, 1, C_HPF, "KEY HPF", #v);
  slider149 >= 19999 ? strcpy(#v, "OFF") : hz(slider149); dy_kf = 2; dy_knob(98, GB, 15, 149, 100, 20000, 20000, 1, C_LPF, "KEY LPF", #v);
  sprintf(#v, "%.1f dB", slider142); dy_knob(156, GB, 15, 142, 0, 20, 4, 0, C_FREQ, "HYST", #v);
  sprintf(#v, "%.1f ms", slider143); dy_knob(214, GB, 15, 143, 0, 10, 0, 0, C_FREQ, "AHEAD", #v);
