function eqt_tq_nout(eqt_x, eqt_c) instance(eqt_v0, eqt_m2, eqt_ys, ph, eqt_sp, eqt_bm, eqt_ap1, eqt_ap2) local(v, eqt_q, y, d, s, eqt_k) (
  // op-amp: linear until it nears the rails, then the hard knee (ADAA on the residue), bias drift on the even term
