function eqt_tq_iron(eqt_m, eqt_c) instance(env, eqt_z, eqt_e2, eqt_dx, eqt_dy) local(eqt_k, v, a, e, h, u, eqt_q, eqt_cc, y, d) (
  eqt_k = eqt_c[107]; v = eqt_m * eqt_k; a = abs(v);
