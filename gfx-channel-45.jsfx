                  eqt_h18 = eqt_t18h ? min(eqt_h18 + eqt_tq_kX, 1) : max(eqt_h18 - eqt_tq_kX, 0); );
  eqt_l18 != eqt_t18l ? ( (eqt_l18 <= 0 || eqt_l18 >= 1) ? ( eqt_cl[110] = eqt_cr[110] = eqt_cl[110] | (eqt_l18 <= 0 ? 8 : 4); );
                  eqt_l18 = eqt_t18l ? min(eqt_l18 + eqt_tq_kX, 1) : max(eqt_l18 - eqt_tq_kX, 0); );
  eqt_cl[114] = eqt_cr[114] = (eqt_h18 - eqt_cl[97]) / (2 * eqt_tq_N); eqt_cl[115] = eqt_cr[115] = (eqt_l18 - eqt_cl[99]) / (2 * eqt_tq_N);
  // ---- filters on / off (off = glide to the end of the range, then out of circuit)
