function eqt_tq_tout(eqt_x, eqt_c) instance(eqt_s1a, eqt_s1b, eqt_s1c, eqt_sap, eqt_s2a, eqt_s2b, eqt_s2c, eqt_ir) local(eqt_lp, t, eqt_lo, eqt_hi1, eqt_mid, eqt_hi) (
  eqt_lp = eqt_s1a.eqt_tq_sv(eqt_x, eqt_c + 72); t = eqt_tq_hpo;
  eqt_lo = eqt_s1b.eqt_tq_sv(eqt_lp, eqt_c + 72);                           // LO = LP . LP (400 Hz)
