function eqt_tq_toutfl() instance(eqt_s1a, eqt_s1b, eqt_s1c, eqt_sap, eqt_s2a, eqt_s2b, eqt_s2c, eqt_ir) (
  eqt_s1a.eqt_tq_fl(); eqt_s1b.eqt_tq_fl(); eqt_s1c.eqt_tq_fl(); eqt_sap.eqt_tq_fl(); eqt_s2a.eqt_tq_fl(); eqt_s2b.eqt_tq_fl(); eqt_s2c.eqt_tq_fl();
