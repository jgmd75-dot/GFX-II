  i == 5 ? 1200 : i == 6 ? 1500 : i == 7 ? 1800 : i == 8 ? 2200 : i == 9 ? 2700 : i == 10 ? 3300 : 4000; );
function eqt_tq_fth(i) ( i = min(max(i | 0, 0), 6);  i == 0 ? 2500 : i == 1 ? 4000 : i == 2 ? 6000 : i == 3 ? 8000 : i == 4 ? 10000 : i == 5 ? 12500 : 16000; );
function eqt_tq_fnl(i) ( i = min(max(i | 0, 0), 4);  i == 0 ? 50 : i == 1 ? 100 : i == 2 ? 200 : i == 3 ? 300 : 400; );
function eqt_tq_fnm(i) ( i = min(max(i | 0, 0), 4);  i == 0 ? 400 : i == 1 ? 800 : i == 2 ? 1500 : i == 3 ? 3000 : 5000; );
