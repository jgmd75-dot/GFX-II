  // ---- HEAD (the Headsmoother's tape head): DRIVE, TRIM, BOOST; NORMAL / MEDIUM / BRIGHT
  sprintf(#v, "%.1f", slider177); dy_knob(690, 148, 20, 177, 0, 10, 3, 0, C_DRV, "DRIVE", #v);
  sprintf(#v, "%+.1f dB", slider178); dy_knob(770, 148, 16, 178, -24, 6, 0, 0, C_FREQ, "TRIM", #v);
  sprintf(#v, "%.0f%%", slider180); dy_knob(840, 148, 16, 180, 0, 100, 0, 0, C_GAIN, "BOOST", #v);
  gi = 0; loop(3, key(886, 118 + gi * 24, 58, 20, (slider179 | 0) == gi, gi == 0 ? "NORMAL" : gi == 1 ? "MEDIUM" : "BRIGHT") ? setv(179, gi); gi += 1; );
  rd_lbl(796, 204, "tape head: the lows skip the curve as it is driven", DIM, 0.7);
) : (
  // ---- TS-7: INPUT, WARMTH, MIX, OUTPUT; COMP OFF / TX / BUS / SLAM, IRON, 2x / 4x
  sprintf(#v, "%+.1f dB", slider196); dy_knob(676, 142, 16, 196, -12, 24, 0, 0, C_DRV, "INPUT", #v);
  sprintf(#v, "%d", slider198); sk(740, 142, 16, 198, 7, 0, C_GAIN, "WARMTH", slider198 < 0.5 ? "OFF" : #v);
  sprintf(#v, "%.0f%%", slider201); dy_knob(804, 142, 16, 201, 0, 100, 100, 0, C_FREQ, "MIX", #v);
  sprintf(#v, "%+.1f dB", slider197); dy_knob(868, 142, 16, 197, -24, 12, 0, 0, C_FREQ, "OUTPUT", #v);
  gi = 0; loop(4, key(648 + gi * 44, 194, 40, 20, (slider199 | 0) == gi, gi == 0 ? "OFF" : gi == 1 ? "TX" : gi == 2 ? "BUS" : "SLAM") ? setv(199, gi); gi += 1; );
  key(828, 194, 46, 20, slider200 >= 0.5, "IRON") ? setv(200, slider200 >= 0.5 ? 0 : 1);
  key(880, 194, 30, 20, slider204 < 0.5, "2x") ? setv(204, 0); key(914, 194, 30, 20, slider204 >= 0.5, "4x") ? setv(204, 1);
  rd_lbl(736, 222, "COMP", DIM, 0.75);
);

// ======================== OUTPUT ========================
md(640, 236, 312, 376, "OUTPUT");
ch_vu1.ui_vu(650 * sc, 266 * sc, 144 * sc, 100 * sc, 10 * log10(ch_vul + 0.0000000001) + 18 + 10 * log10(2), "L");
ch_vu2.ui_vu(798 * sc, 266 * sc, 144 * sc, 100 * sc, 10 * log10(ch_vur + 0.0000000001) + 18 + 10 * log10(2), "R");
// ORDER
rd_lbl(700, 404, "ORDER", DIM, 0.9);
key(652, 416, 96, 24, slider13 < 0.5, "EQ > COMP") ? setv(13, 0);
key(652, 444, 96, 24, slider13 >= 0.5, "COMP > EQ") ? setv(13, 1);
// LEVEL, DRIFT, the house output stage's band SAT; the CLIP lamp
sprintf(#v, "%+.1f dB", slider14); dy_knob(830, 450, 26, 14, -24, 12, 0, 0, C_GAIN, "LEVEL", #v);
sprintf(#v, "%.0f%%", slider15); dy_knob(700, 556, 14, 15, 0, 100, 50, 0, C_FREQ, "DRIFT", #v);
sprintf(#v, "%.0f%%", slider16); dy_knob(904, 556, 14, 16, 0, 100, 0, 0, C_Q, "BAND SAT", #v);
ch_clip_ = ost_clipped; ost_clipped = 0;
rd_led(918, 416, 5, ch_clip_, 0xFF3A22); rd_lbl(918, 428, "CLIP", DIM, 0.8);
ch_lat > 0 ? ( sprintf(#v, "latency %d", ch_lat); rd_lbl(800, 594, #v, DIM, 0.5); );

pk_end();
ui_end();
