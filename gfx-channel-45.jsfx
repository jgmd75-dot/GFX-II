  sprintf(#v, "%+.1f dB", slider128); dy_knob(136, CA, 16, 128, -12, 24, 0, 0, C_FREQ, "OUTPUT", #v);
  sprintf(#v, "%.0f%%", slider132); dy_knob(206, CA, 16, 132, 0, 100, 100, 0, C_FREQ, "BLEND", #v);
  key(250, CA - 10, 60, 20, slider131 >= 0.5, "LIMIT") ? setv(131, slider131 >= 0.5 ? 0 : 1);
