function eqt_tq_nres(v) local(a) ( a = abs(v); a <= eqt_tq_ka ? 0 : a < eqt_tq_kb ? -sign(v) * sqr(a - eqt_tq_ka) / (2 * eqt_tq_kw) : sign(v) * (1 - a); );
function eqt_tq_nR(v) local(a, eqt_k) ( a = abs(v); eqt_k = a - eqt_tq_ka;
