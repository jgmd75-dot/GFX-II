  eqt_q = abs(v) <= eqt_tq_ka && abs(eqt_v0) <= eqt_tq_ka ? 0 : abs(d) > 0.00001 ? (eqt_tq_nR(v) - eqt_tq_nR(eqt_v0)) / d : eqt_tq_nres(0.5 * (v + eqt_v0));
