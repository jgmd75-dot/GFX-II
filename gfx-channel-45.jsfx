  eqt_ls != eqt_tls ? ( eqt_lw = max(eqt_lw - eqt_tq_kS, 0); eqt_lw <= 0 ? eqt_ls = eqt_tls; eqt_tq_mv = 1; ) : eqt_lw < 1 ? ( eqt_lw = min(eqt_lw + eqt_tq_kS, 1); eqt_tq_mv = 1; );
