slider100:0<0,1,1{Out,In}>-EQ Skye: LPF In
slider101:0<0,1,1{Bell,Shelf}>-EQ Skye: Band 1 Shape
slider102:0<0,1,1{Bell,Shelf}>-EQ Skye: Band 4 Shape
slider171:20<0,100,1>-Sat Iron / Transistor: drive (%)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
ext_noinit = 1;
#ui_man = "gfx-channel-45";

// ---------- memory: the dry delay lines here; each engine has its own region (its nextmem starts there) ----------
CH_DQ = 0;                                                // 4 slots x 2 channels x a 512 ring: the dry signal, latency matched
CH_DN = 512;

// ======================== the engines ========================
// ======================== gfx-tony-q-550.jsfx (prefix eqt_; its sliders 1-32 at 25-56) ========================
function eqt_defaults() (
  slider(25) = 0;
  slider(26) = 1;
  slider(27) = 0;
  slider(28) = 0;
  slider(29) = 0;
  slider(30) = 2;
  slider(31) = 0;
  slider(32) = 1;
  slider(33) = 4;
  slider(34) = 0;
  slider(35) = 3;
  slider(36) = 0;
  slider(37) = 1;
  slider(38) = 20;
  slider(39) = 0;
  slider(40) = 22000;
  slider(41) = 0;
  slider(42) = 0;
  slider(43) = 0;
  slider(44) = 1;
  slider(45) = 5;
  slider(46) = 1;
  slider(47) = 2;
  slider(48) = 5;
  slider(49) = 2;
  slider(50) = 5;
  slider(51) = 1;
  slider(52) = 20;
  slider(53) = 0;
  slider(54) = 22000;
  slider(55) = 0;
  slider(56) = 0;
  0;
);
function eqt_consts() (
  eqt_s33 = 0;
  slider(26) = 1;
  slider(27) = 0;
  slider(28) = 0;
  0;
);
function eqt_alloc(n) local(p) ( p = eqt_nextmem; eqt_nextmem += n; memset(p, 0, n); p; );
function eqt_tq_i0(eqt_x) local(s, t, eqt_k) ( s = 1; t = 1; eqt_k = 1; loop(40, t *= sqr(eqt_x / (2 * eqt_k)); s += t; eqt_k += 1; ); s; );
function eqt_tq_conv(b) local(s, i, j) (
  s = 0; i = 0; j = 47;
  loop(24, s += eqt_tq_H[i] * (b[i] + b[j]); i += 1; j -= 1; );
  s;
);
function eqt_tq_sv(eqt_v0, eqt_c) instance(eqt_ic1, eqt_ic2) local(eqt_v1, eqt_v2, eqt_v3) (
  eqt_v3 = eqt_v0 - eqt_ic2;
  eqt_v1 = eqt_c[0] * eqt_ic1 + eqt_c[1] * eqt_v3;
  eqt_v2 = eqt_ic2 + eqt_c[1] * eqt_ic1 + eqt_c[2] * eqt_v3;
  eqt_ic1 = 2 * eqt_v1 - eqt_ic1; eqt_ic2 = 2 * eqt_v2 - eqt_ic2;
  eqt_tq_bpo = eqt_v1; eqt_tq_hpo = eqt_v0 - eqt_c[3] * eqt_v1 - eqt_v2;
  eqt_v2;
);
function eqt_tq_eq(eqt_v0, eqt_c) instance(eqt_ic1, eqt_ic2) local(eqt_v1, eqt_v2, eqt_v3) (
  eqt_v3 = eqt_v0 - eqt_ic2;
  eqt_v1 = eqt_c[0] * eqt_ic1 + eqt_c[1] * eqt_v3;
  eqt_v2 = eqt_ic2 + eqt_c[1] * eqt_ic1 + eqt_c[2] * eqt_v3;
  eqt_ic1 = 2 * eqt_v1 - eqt_ic1; eqt_ic2 = 2 * eqt_v2 - eqt_ic2;
  eqt_c[4] * eqt_v0 + eqt_c[5] * eqt_v1 + eqt_c[6] * eqt_v2;
);
function eqt_tq_op(eqt_x, eqt_c) instance(s) local(v, eqt_lp) ( v = (eqt_x - s) * eqt_c[0]; eqt_lp = v + s; s = eqt_lp + v; eqt_lp; );
function eqt_tq_z() instance(eqt_ic1, eqt_ic2, s) ( eqt_ic1 = eqt_ic2 = s = 0; );
function eqt_tq_zl(eqt_x) instance(eqt_ic1, eqt_ic2, s) ( eqt_ic1 = 0; eqt_ic2 = eqt_x; s = eqt_x; );
function eqt_tq_fl() instance(eqt_ic1, eqt_ic2, s) (
  abs(eqt_ic1) < 0.000000000001 ? eqt_ic1 = 0; abs(eqt_ic2) < 0.000000000001 ? eqt_ic2 = 0; abs(s) < 0.000000000001 ? s = 0;
);
function eqt_tq_cg(eqt_c, g, eqt_k) ( eqt_c[0] = 1 / (1 + g * (g + eqt_k)); eqt_c[1] = g * eqt_c[0]; eqt_c[2] = g * eqt_c[1]; eqt_c[3] = eqt_k; );
function eqt_tq_tn(f) ( tan($pi * min(max(f, 2), 0.47 * eqt_tq_fs2) / eqt_tq_fs2); );
function eqt_tq_cset(eqt_c, f, eqt_k) ( eqt_tq_cg(eqt_c, eqt_tq_tn(f), eqt_k); );
function eqt_tq_band(eqt_c, eqt_type, f, eqt_gdb, eqt_q) local(A, t, eqt_k) (
  A = exp(eqt_gdb * 0.0575646273); t = eqt_tq_tn(f);            // A = 10 ^ (dB / 40)
  eqt_type == 0 ? ( eqt_k = 1 / (eqt_q * A); eqt_tq_cg(eqt_c, t, eqt_k); eqt_c[4] = 1; eqt_c[5] = eqt_k * (A * A - 1); eqt_c[6] = 0; ) :
  eqt_type == 1 ? ( eqt_k = 1 / eqt_q; eqt_tq_cg(eqt_c, t / sqrt(A), eqt_k); eqt_c[4] = 1; eqt_c[5] = eqt_k * (A - 1); eqt_c[6] = A * A - 1; ) :
              ( eqt_k = 1 / eqt_q; eqt_tq_cg(eqt_c, t * sqrt(A), eqt_k); eqt_c[4] = A * A; eqt_c[5] = eqt_k * (1 - A) * A; eqt_c[6] = 1 - A * A; );
);
function eqt_tq_opset(eqt_c, f) local(g) ( g = eqt_tq_tn(f); eqt_c[0] = g / (1 + g); );
function eqt_tq_pre(eqt_x, eqt_c) instance(eqt_dx, eqt_dy) local(u, t, d) (
  eqt_c[105] > 0.00001 ? (
    u = eqt_tq_pd * (eqt_x * eqt_tq_pk + eqt_c[106]);
    t = exp(2 * min(max(u, -20), 20)); t = (t - 1) / (t + 1);
    t = (t - eqt_c[111]) * eqt_c[112];
    d = t - eqt_x;
    eqt_dy = d - eqt_dx + eqt_tq_dcd * eqt_dy; eqt_dx = d;
    eqt_x += eqt_c[105] * eqt_dy;
  );
  eqt_x;
);
function eqt_tq_lin(eqt_x, eqt_c) instance(eqt_h1, eqt_h2, eqt_h3, eqt_l1, eqt_l2, eqt_l3, b1, b2, eqt_b3) local(eqt_m, eqt_w, a, b, d) (
  eqt_m = eqt_c[110];
  eqt_m ? (
    eqt_c[110] = 0;
    eqt_m & 1 ? eqt_h1.eqt_tq_z(); eqt_m & 2 ? ( eqt_h2.eqt_tq_z(); eqt_h3.eqt_tq_z(); );
    eqt_m & 16 ? b1.eqt_tq_z(); eqt_m & 32 ? b2.eqt_tq_z(); eqt_m & 64 ? eqt_b3.eqt_tq_z();
  );
  eqt_c[96] ? (
    eqt_w = eqt_c[97]; d = eqt_x;
    eqt_w < 0.9999 ? ( eqt_h1.eqt_tq_sv(eqt_x, eqt_c + 24); a = eqt_tq_hpo; );
    eqt_w > 0.0001 ? ( eqt_h2.eqt_tq_sv(eqt_x, eqt_c + 32); b = eqt_tq_hpo; b -= eqt_h3.eqt_tq_op(b, eqt_c + 40); );
    eqt_x = eqt_w <= 0.0001 ? a : eqt_w >= 0.9999 ? b : a + (b - a) * eqt_w;
    eqt_c[116] < 0.9999 ? eqt_x = d + (eqt_x - d) * eqt_c[116];        // switching in / out: a 30 ms crossfade
  );
  eqt_c[100] ? eqt_x = b1.eqt_tq_eq(eqt_x, eqt_c);
  eqt_c[101] ? eqt_x = b2.eqt_tq_eq(eqt_x, eqt_c + 8);
  eqt_c[102] ? eqt_x = eqt_b3.eqt_tq_eq(eqt_x, eqt_c + 16);
  eqt_m & 4 ? eqt_l1.eqt_tq_zl(eqt_x); eqt_m & 8 ? ( eqt_l2.eqt_tq_zl(eqt_x); eqt_l3.eqt_tq_zl(eqt_x); );
  eqt_c[98] ? (
    eqt_w = eqt_c[99]; d = eqt_x;
    eqt_w < 0.9999 ? a = eqt_l1.eqt_tq_sv(eqt_x, eqt_c + 48);
    eqt_w > 0.0001 ? b = eqt_l3.eqt_tq_op(eqt_l2.eqt_tq_sv(eqt_x, eqt_c + 56), eqt_c + 64);
    eqt_x = eqt_w <= 0.0001 ? a : eqt_w >= 0.9999 ? b : a + (b - a) * eqt_w;
    eqt_c[118] < 0.9999 ? eqt_x = d + (eqt_x - d) * eqt_c[118];
  );
  eqt_x;
);
function eqt_tq_linfl() instance(eqt_h1, eqt_h2, eqt_h3, eqt_l1, eqt_l2, eqt_l3, b1, b2, eqt_b3) (
  eqt_h1.eqt_tq_fl(); eqt_h2.eqt_tq_fl(); eqt_h3.eqt_tq_fl(); eqt_l1.eqt_tq_fl(); eqt_l2.eqt_tq_fl(); eqt_l3.eqt_tq_fl(); b1.eqt_tq_fl(); b2.eqt_tq_fl(); eqt_b3.eqt_tq_fl();
);
function eqt_tq_iron(eqt_m, eqt_c) instance(env, eqt_z, eqt_e2, eqt_dx, eqt_dy) local(eqt_k, v, a, e, h, u, eqt_q, eqt_cc, y, d) (
  eqt_k = eqt_c[107]; v = eqt_m * eqt_k; a = abs(v);
  env = a > env ? env + (a - env) * eqt_tq_iat : env * eqt_tq_irl;
  // the backlash memory: z follows v with a soft dead band of +/- tq_iw
  e = v - eqt_z; e /= eqt_tq_iw; eqt_z += (e - e / sqrt(1 + e * e)) * eqt_tq_iw;
  h = env * env; h = eqt_tq_ihy * h / (1 + h);              // the loop opens up with level, nothing at low level
  u = v - h * (v - eqt_z);
  // the core: a soft knee, linear below it
  eqt_q = abs(u); eqt_cc = u / (1 + eqt_q * eqt_q * eqt_q) ^ 0.33333333;
  eqt_e2 += (eqt_cc * eqt_cc - eqt_e2) * eqt_tq_ce;
  eqt_cc += eqt_tq_iev * env / (1 + env) * (eqt_cc * eqt_cc - eqt_e2);
  y = eqt_cc / ((1 + eqt_tq_ibl * env * env) * eqt_k);
  d = y - eqt_m;
  eqt_dy = d - eqt_dx + eqt_tq_dcd * eqt_dy; eqt_dx = d;
  eqt_m + eqt_dy;
);
function eqt_tq_tout(eqt_x, eqt_c) instance(eqt_s1a, eqt_s1b, eqt_s1c, eqt_sap, eqt_s2a, eqt_s2b, eqt_s2c, eqt_ir) local(eqt_lp, t, eqt_lo, eqt_hi1, eqt_mid, eqt_hi) (
  eqt_lp = eqt_s1a.eqt_tq_sv(eqt_x, eqt_c + 72); t = eqt_tq_hpo;
  eqt_lo = eqt_s1b.eqt_tq_sv(eqt_lp, eqt_c + 72);                           // LO = LP . LP (400 Hz)
  eqt_s1c.eqt_tq_sv(t, eqt_c + 72); eqt_hi1 = eqt_tq_hpo;                     // the rest = HP . HP
  eqt_sap.eqt_tq_sv(eqt_lo, eqt_c + 80); eqt_lo -= 2 * eqt_c[83] * eqt_tq_bpo;        // LO gets the 5 kHz all-pass: the bands stay in phase
  eqt_lp = eqt_s2a.eqt_tq_sv(eqt_hi1, eqt_c + 80); t = eqt_tq_hpo;
  eqt_mid = eqt_s2b.eqt_tq_sv(eqt_lp, eqt_c + 80);
  eqt_s2c.eqt_tq_sv(t, eqt_c + 80); eqt_hi = eqt_tq_hpo;
  eqt_lo + eqt_ir.eqt_tq_iron(eqt_mid, eqt_c) + eqt_hi;
);
function eqt_tq_toutfl() instance(eqt_s1a, eqt_s1b, eqt_s1c, eqt_sap, eqt_s2a, eqt_s2b, eqt_s2c, eqt_ir) (
  eqt_s1a.eqt_tq_fl(); eqt_s1b.eqt_tq_fl(); eqt_s1c.eqt_tq_fl(); eqt_sap.eqt_tq_fl(); eqt_s2a.eqt_tq_fl(); eqt_s2b.eqt_tq_fl(); eqt_s2c.eqt_tq_fl();
  abs(eqt_ir.env) < 0.000000000001 ? eqt_ir.env = 0; abs(eqt_ir.eqt_e2) < 0.000000000001 ? eqt_ir.eqt_e2 = 0;
  abs(eqt_ir.eqt_dx) < 0.000000000001 ? eqt_ir.eqt_dx = 0; abs(eqt_ir.eqt_dy) < 0.000000000001 ? eqt_ir.eqt_dy = 0;
);
function eqt_tq_nres(v) local(a) ( a = abs(v); a <= eqt_tq_ka ? 0 : a < eqt_tq_kb ? -sign(v) * sqr(a - eqt_tq_ka) / (2 * eqt_tq_kw) : sign(v) * (1 - a); );
function eqt_tq_nR(v) local(a, eqt_k) ( a = abs(v); eqt_k = a - eqt_tq_ka;
  a <= eqt_tq_ka ? 0 : a < eqt_tq_kb ? 0 - eqt_k * eqt_k * eqt_k / (6 * eqt_tq_kw) : (a - eqt_tq_kb) - 0.5 * (a * a - eqt_tq_kb * eqt_tq_kb) - eqt_tq_kw * eqt_tq_kw / 6; );
function eqt_tq_nout(eqt_x, eqt_c) instance(eqt_v0, eqt_m2, eqt_ys, ph, eqt_sp, eqt_bm, eqt_ap1, eqt_ap2) local(v, eqt_q, y, d, s, eqt_k) (
  // op-amp: linear until it nears the rails, then the hard knee (ADAA on the residue), bias drift on the even term
  v = eqt_x / eqt_tq_nrl; d = v - eqt_v0;
  eqt_q = abs(v) <= eqt_tq_ka && abs(eqt_v0) <= eqt_tq_ka ? 0 : abs(d) > 0.00001 ? (eqt_tq_nR(v) - eqt_tq_nR(eqt_v0)) / d : eqt_tq_nres(0.5 * (v + eqt_v0));
  eqt_v0 = v; v += eqt_q;
  eqt_m2 += (v * v - eqt_m2) * eqt_tq_ce;
  y = eqt_tq_nrl * (v + eqt_tq_na2 * eqt_c[113] * (v * v - eqt_m2));
  // slew: the steepest edges of hot peaks are rounded
  d = (y - eqt_ys) / eqt_tq_slw; eqt_q = d * d; eqt_ys += eqt_tq_slw * d / sqrt(sqrt(1 + eqt_q * eqt_q)); y = eqt_ys;
  // the low-frequency bump (comes in with DRIVE)
  y = eqt_bm.eqt_tq_eq(y, eqt_c + 88);
  // output transformer: the core saturates on flux, so the low end goes first
  eqt_k = eqt_c[107];
  ph = ph * eqt_tq_xlk + y * eqt_tq_xc; ph = min(max(ph, -8), 8);
  s = exp(2 * min(max(ph * eqt_k, -20), 20)); s = (s - 1) / (s + 1);
  s = ph + eqt_tq_xw * (s / eqt_k - ph);
