function eqt_tq_linfl() instance(eqt_h1, eqt_h2, eqt_h3, eqt_l1, eqt_l2, eqt_l3, b1, b2, eqt_b3) (
  eqt_h1.eqt_tq_fl(); eqt_h2.eqt_tq_fl(); eqt_h3.eqt_tq_fl(); eqt_l1.eqt_tq_fl(); eqt_l2.eqt_tq_fl(); eqt_l3.eqt_tq_fl(); b1.eqt_tq_fl(); b2.eqt_tq_fl(); eqt_b3.eqt_tq_fl();
