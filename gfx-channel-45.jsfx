function eqt_tq_tch(eqt_x, eqt_c) instance(eqt_pre, eqt_lin, eqt_tro) local(g, i) (
  eqt_c[103] += eqt_c[108]; eqt_c[104] += eqt_c[109]; eqt_c[97] += eqt_c[114]; eqt_c[99] += eqt_c[115]; eqt_c[116] += eqt_c[119]; eqt_c[118] += eqt_c[120];
