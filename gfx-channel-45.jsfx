  gi = 0; loop(3, key(166 + gi * 48, CB - 12, 44, 20, (slider130 | 0) == gi, gi == 0 ? "SLOW" : gi == 1 ? "MED" : "FAST") ? setv(130, gi); gi += 1; );
  rd_lbl(82, CB + 16, "ATTACK", INK, 0.9); rd_lbl(236, CB + 16, "RELEASE", INK, 0.9);
);

// ======================== GATE ========================
md(8, 402, 312, 210, "GATE"); md_in(282, 402, 10);
ek(16, 426, 94, 9, 0, "GATE"); ek(114, 426, 94, 9, 1, "EXPANDER"); ek(212, 426, 100, 9, 2, "DRUM GATE");
gm_ = slider9 | 0;
ch_ggd = max(ch_ggd * 0.8, ch_gate_gr()); gxo_gtm = 0;
gr_num = 0; gr_row(34, 460, slider10 >= 0.5 ? ch_ggd : 0); gr_num = 1;
GA = 504; GB = 564;
gm_ == 0 ? (
  // ---- GATE (the GFX Gate): THRESH, RANGE, ATTACK, HOLD, RELEASE; KEY HPF / LPF, HYSTERESIS, LOOK-AHEAD; SOFT, LISTEN
  sprintf(#v, "%.1f dB", slider136); dy_knob(40, GA, 15, 136, -80, 0, -40, 0, C_GAIN, "THRESH", #v);
  sprintf(#v, "%.0f dB", slider137); dy_knob(98, GA, 15, 137, 0, 80, 60, 0, C_GAIN, "RANGE", #v);
  sprintf(#v, "%.2f ms", slider139); dy_knob(156, GA, 15, 139, 0.01, 100, 0.5, 1, C_Q, "ATTACK", #v);
