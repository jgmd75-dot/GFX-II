in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
ext_noinit = 1;
#ui_man = "gfx-channel-45";

// ---------- memory: the dry delay lines here; each engine has its own region (its nextmem starts there) ----------
CH_DQ = 0;                                                // 10 rings of 4096: the slots' dry signals (latency matched), the drum gate's look-ahead
CH_DN = 4096;                                             // (room for the GATE's 10 ms look-ahead at 192 kHz)

// ======================== the engines ========================
// ======================== gfx-tony-q-550.jsfx (prefix eqt_; its sliders 1-32 at 25-56) ========================
function eqt_defaults() (
  slider(25) = 0;
  slider(26) = 1;
  slider(27) = 0;
  slider(28) = 0;
  slider(29) = 0;
  slider(30) = 2;
  slider(31) = 0;
  slider(32) = 1;
  slider(33) = 4;
  slider(34) = 0;
  slider(35) = 3;
  slider(36) = 0;
  slider(37) = 1;
  slider(38) = 20;
  slider(39) = 0;
  slider(40) = 22000;
  slider(41) = 0;
  slider(42) = 0;
  slider(43) = 0;
  slider(44) = 1;
  slider(45) = 5;
  slider(46) = 1;
  slider(47) = 2;
  slider(48) = 5;
  slider(49) = 2;
  slider(50) = 5;
  slider(51) = 1;
  slider(52) = 20;
  slider(53) = 0;
  slider(54) = 22000;
  slider(55) = 0;
  slider(56) = 0;
  0;
);
function eqt_consts() (
  eqt_own_s33 = 0;
  slider(26) = 1;
  slider(27) = 0;
  slider(28) = 0;
  0;
);
function eqt_alloc(n) local(p) ( p = eqt_nextmem; eqt_nextmem += n; memset(p, 0, n); p; );
function eqt_tq_i0(eqt_x) local(s, t, eqt_k) ( s = 1; t = 1; eqt_k = 1; loop(40, t *= sqr(eqt_x / (2 * eqt_k)); s += t; eqt_k += 1; ); s; );
function eqt_tq_conv(b) local(s, i, j) (
  s = 0; i = 0; j = 47;
  loop(24, s += eqt_tq_H[i] * (b[i] + b[j]); i += 1; j -= 1; );
  s;
);
function eqt_tq_sv(eqt_v0, eqt_c) instance(eqt_ic1, eqt_ic2) local(eqt_v1, eqt_v2, eqt_v3) (
  eqt_v3 = eqt_v0 - eqt_ic2;
  eqt_v1 = eqt_c[0] * eqt_ic1 + eqt_c[1] * eqt_v3;
  eqt_v2 = eqt_ic2 + eqt_c[1] * eqt_ic1 + eqt_c[2] * eqt_v3;
  eqt_ic1 = 2 * eqt_v1 - eqt_ic1; eqt_ic2 = 2 * eqt_v2 - eqt_ic2;
  eqt_tq_bpo = eqt_v1; eqt_tq_hpo = eqt_v0 - eqt_c[3] * eqt_v1 - eqt_v2;
  eqt_v2;
);
function eqt_tq_eq(eqt_v0, eqt_c) instance(eqt_ic1, eqt_ic2) local(eqt_v1, eqt_v2, eqt_v3) (
  eqt_v3 = eqt_v0 - eqt_ic2;
  eqt_v1 = eqt_c[0] * eqt_ic1 + eqt_c[1] * eqt_v3;
  eqt_v2 = eqt_ic2 + eqt_c[1] * eqt_ic1 + eqt_c[2] * eqt_v3;
  eqt_ic1 = 2 * eqt_v1 - eqt_ic1; eqt_ic2 = 2 * eqt_v2 - eqt_ic2;
  eqt_c[4] * eqt_v0 + eqt_c[5] * eqt_v1 + eqt_c[6] * eqt_v2;
);
function eqt_tq_op(eqt_x, eqt_c) instance(s) local(v, eqt_lp) ( v = (eqt_x - s) * eqt_c[0]; eqt_lp = v + s; s = eqt_lp + v; eqt_lp; );
function eqt_tq_z() instance(eqt_ic1, eqt_ic2, s) ( eqt_ic1 = eqt_ic2 = s = 0; );
function eqt_tq_zl(eqt_x) instance(eqt_ic1, eqt_ic2, s) ( eqt_ic1 = 0; eqt_ic2 = eqt_x; s = eqt_x; );
function eqt_tq_fl() instance(eqt_ic1, eqt_ic2, s) (
  abs(eqt_ic1) < 0.000000000001 ? eqt_ic1 = 0; abs(eqt_ic2) < 0.000000000001 ? eqt_ic2 = 0; abs(s) < 0.000000000001 ? s = 0;
);
function eqt_tq_cg(eqt_c, g, eqt_k) ( eqt_c[0] = 1 / (1 + g * (g + eqt_k)); eqt_c[1] = g * eqt_c[0]; eqt_c[2] = g * eqt_c[1]; eqt_c[3] = eqt_k; );
function eqt_tq_tn(f) ( tan($pi * min(max(f, 2), 0.47 * eqt_tq_fs2) / eqt_tq_fs2); );
function eqt_tq_cset(eqt_c, f, eqt_k) ( eqt_tq_cg(eqt_c, eqt_tq_tn(f), eqt_k); );
function eqt_tq_band(eqt_c, eqt_type, f, eqt_gdb, eqt_q) local(A, t, eqt_k) (
  A = exp(eqt_gdb * 0.0575646273); t = eqt_tq_tn(f);            // A = 10 ^ (dB / 40)
  eqt_type == 0 ? ( eqt_k = 1 / (eqt_q * A); eqt_tq_cg(eqt_c, t, eqt_k); eqt_c[4] = 1; eqt_c[5] = eqt_k * (A * A - 1); eqt_c[6] = 0; ) :
  eqt_type == 1 ? ( eqt_k = 1 / eqt_q; eqt_tq_cg(eqt_c, t / sqrt(A), eqt_k); eqt_c[4] = 1; eqt_c[5] = eqt_k * (A - 1); eqt_c[6] = A * A - 1; ) :
              ( eqt_k = 1 / eqt_q; eqt_tq_cg(eqt_c, t * sqrt(A), eqt_k); eqt_c[4] = A * A; eqt_c[5] = eqt_k * (1 - A) * A; eqt_c[6] = 1 - A * A; );
);
function eqt_tq_opset(eqt_c, f) local(g) ( g = eqt_tq_tn(f); eqt_c[0] = g / (1 + g); );
function eqt_tq_pre(eqt_x, eqt_c) instance(eqt_dx, eqt_dy) local(u, t, d) (
  eqt_c[105] > 0.00001 ? (
    u = eqt_tq_pd * (eqt_x * eqt_tq_pk + eqt_c[106]);
    t = exp(2 * min(max(u, -20), 20)); t = (t - 1) / (t + 1);
    t = (t - eqt_c[111]) * eqt_c[112];
    d = t - eqt_x;
    eqt_dy = d - eqt_dx + eqt_tq_dcd * eqt_dy; eqt_dx = d;
    eqt_x += eqt_c[105] * eqt_dy;
  );
  eqt_x;
);
function eqt_tq_lin(eqt_x, eqt_c) instance(eqt_h1, eqt_h2, eqt_h3, eqt_l1, eqt_l2, eqt_l3, b1, b2, eqt_b3) local(eqt_m, eqt_w, a, b, d) (
  eqt_m = eqt_c[110];
  eqt_m ? (
    eqt_c[110] = 0;
    eqt_m & 1 ? eqt_h1.eqt_tq_z(); eqt_m & 2 ? ( eqt_h2.eqt_tq_z(); eqt_h3.eqt_tq_z(); );
    eqt_m & 16 ? b1.eqt_tq_z(); eqt_m & 32 ? b2.eqt_tq_z(); eqt_m & 64 ? eqt_b3.eqt_tq_z();
  );
  eqt_c[96] ? (
    eqt_w = eqt_c[97]; d = eqt_x;
    eqt_w < 0.9999 ? ( eqt_h1.eqt_tq_sv(eqt_x, eqt_c + 24); a = eqt_tq_hpo; );
    eqt_w > 0.0001 ? ( eqt_h2.eqt_tq_sv(eqt_x, eqt_c + 32); b = eqt_tq_hpo; b -= eqt_h3.eqt_tq_op(b, eqt_c + 40); );
    eqt_x = eqt_w <= 0.0001 ? a : eqt_w >= 0.9999 ? b : a + (b - a) * eqt_w;
    eqt_c[116] < 0.9999 ? eqt_x = d + (eqt_x - d) * eqt_c[116];        // switching in / out: a 30 ms crossfade
  );
  eqt_c[100] ? eqt_x = b1.eqt_tq_eq(eqt_x, eqt_c);
  eqt_c[101] ? eqt_x = b2.eqt_tq_eq(eqt_x, eqt_c + 8);
  eqt_c[102] ? eqt_x = eqt_b3.eqt_tq_eq(eqt_x, eqt_c + 16);
  eqt_m & 4 ? eqt_l1.eqt_tq_zl(eqt_x); eqt_m & 8 ? ( eqt_l2.eqt_tq_zl(eqt_x); eqt_l3.eqt_tq_zl(eqt_x); );
  eqt_c[98] ? (
    eqt_w = eqt_c[99]; d = eqt_x;
