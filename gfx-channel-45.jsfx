desc:GFX Channel 45 [modular channel strip]
//tags: channel strip eq compressor gate saturation console modular
//author: JGWizrad / Garden FX (GFX)
//
// A full channel strip built from the GFX range: pick an engine for each slot and mix and match.
//   INPUT   LOW CUT (12 dB/oct, fully left = off), HIGH CUT (12 dB/oct, fully right = off), GAIN.
//           Click GAIN for GUARD (the house input guard: eases hot sources down, catches fast peaks).
//   GATE    GATE / EXPANDER / DRUM GATE.
//   COMP    FET 45 / OB Q / SMOOTH.
//   EQ      TONY Q / BOARD / SKYE: the Tony Q 550, Board EQ and Skye engines, each with its own settings
//           (switch between them and each keeps what you set).
//   SAT     IRON / TRANS (the output iron or a transistor line stage) / HEAD / TS-7.
//   ORDER   EQ > COMP or COMP > EQ.
//   OUTPUT  LEVEL, the two VU meters, DRIFT and the house output stage (CLIP always on).
//   IN keys switch each slot in or out (a short crossfade, latency kept). Changing an engine or the ORDER fades the
//   strip out and back in (about 30 ms) so nothing clicks.
//   DRIFT   the supply voltage: it wanders slowly and sags under load, and every stage's headroom follows it -
//           each engine's own drift is off, the whole strip breathes from the one supply.
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-dyn, gfx-faceplate and gfx-instrument
// (.jsfx-inc) in the same folder.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-headsmooth.jsfx-inc

