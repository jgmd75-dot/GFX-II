  eqt_c[105] = min(eqt_dr / 2, 1);
  eqt_c[106] = 0.30 + eqt_bias;
  t = exp(2 * eqt_tq_pd * eqt_c[106]); t = (t - 1) / (t + 1);
  eqt_c[111] = t; eqt_c[112] = 1 / (eqt_tq_pd * eqt_tq_pk * (1 - t * t));
  eqt_c[113] = 1 + eqt_bias * 10;
