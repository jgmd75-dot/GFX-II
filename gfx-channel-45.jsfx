  eqt_l18 != eqt_t18l ? ( (eqt_l18 <= 0 || eqt_l18 >= 1) ? ( eqt_cl[110] = eqt_cr[110] = eqt_cl[110] | (eqt_l18 <= 0 ? 8 : 4); );
                  eqt_l18 = eqt_t18l ? min(eqt_l18 + eqt_tq_kX, 1) : max(eqt_l18 - eqt_tq_kX, 0); );
  eqt_cl[114] = eqt_cr[114] = (eqt_h18 - eqt_cl[97]) / (2 * eqt_tq_N); eqt_cl[115] = eqt_cr[115] = (eqt_l18 - eqt_cl[99]) / (2 * eqt_tq_N);
  // ---- filters on / off (off = glide to the end of the range, then out of circuit)
  // ---- filters in / out of circuit: a 30 ms crossfade (switching in, the corner glides up from 10 Hz / down
  //      from the top of the range)
  eqt_hon && !eqt_cl[96] ? ( eqt_cl[96] = eqt_cr[96] = 1; eqt_cl[110] = eqt_cr[110] = eqt_cl[110] | 3; eqt_cl[116] = eqt_cr[116] = eqt_hwt = 0;
                     eqt_ghp.eqt_tq_gli(10); eqt_hp = 10; eqt_tq_mv = 1; );
  eqt_lon && !eqt_cl[98] ? ( eqt_cl[98] = eqt_cr[98] = 1; eqt_cl[110] = eqt_cr[110] = eqt_cl[110] | 12; eqt_cl[118] = eqt_cr[118] = eqt_lwt = 0;
                     eqt_glp.eqt_tq_gli(eqt_tq_lpoff); eqt_lp = eqt_tq_lpoff; eqt_tq_mv = 1; );
  eqt_hwt = eqt_hon ? min(eqt_hwt + eqt_tq_kfw, 1) : max(eqt_hwt - eqt_tq_kfw, 0);
  eqt_lwt = eqt_lon ? min(eqt_lwt + eqt_tq_kfw, 1) : max(eqt_lwt - eqt_tq_kfw, 0);
  eqt_cl[119] = eqt_cr[119] = (eqt_hwt - eqt_cl[116]) / (2 * eqt_tq_N); eqt_cl[120] = eqt_cr[120] = (eqt_lwt - eqt_cl[118]) / (2 * eqt_tq_N);
  !eqt_hon && eqt_cl[96] && eqt_hwt <= 0 && eqt_cl[116] <= 0.00001 ? ( eqt_cl[96] = eqt_cr[96] = 0; );
  !eqt_lon && eqt_cl[98] && eqt_lwt <= 0 && eqt_cl[118] <= 0.00001 ? ( eqt_cl[98] = eqt_cr[98] = 0; );
  // ---- bands on / off: a band at 0 dB is exactly out, so it is skipped (and starts from rest when it comes back)
  eqt_on = abs(eqt_lg * eqt_lw) > 0.0001 || eqt_tlg != 0; eqt_on && !eqt_cl[100] ? ( eqt_cl[110] = eqt_cr[110] = eqt_cl[110] | 16; ); eqt_cl[100] = eqt_cr[100] = eqt_on;
  eqt_on = abs(eqt_mg) > 0.0001 || eqt_tmg != 0;      eqt_on && !eqt_cl[101] ? ( eqt_cl[110] = eqt_cr[110] = eqt_cl[110] | 32; ); eqt_cl[101] = eqt_cr[101] = eqt_on;
  eqt_on = abs(eqt_hg * eqt_hw) > 0.0001 || eqt_thg != 0; eqt_on && !eqt_cl[102] ? ( eqt_cl[110] = eqt_cr[110] = eqt_cl[110] | 64; ); eqt_cl[102] = eqt_cr[102] = eqt_on;
  // ---- drive and trim: per-sample ramps to the new values over the next tick
  g = exp(eqt_dr * 0.115129255);
  eqt_cl[108] = (g - eqt_cl[103]) / (2 * eqt_tq_N); eqt_cr[108] = (g - eqt_cr[103]) / (2 * eqt_tq_N);
  eqt_cl[109] = (eqt_tr - eqt_cl[104]) / (2 * eqt_tq_N); eqt_cr[109] = (eqt_tr - eqt_cr[104]) / (2 * eqt_tq_N);
  // ---- coefficients, per channel with its drift (while something moves; drift alone: once per block)
  eqt_sn |= eqt_cl[110] & 112;
  eqt_tq_mv || eqt_mv || (eqt_df && eqt_own_dm_a > 0) ? (
    this.eqt_tq_ech(eqt_cl, eqt_tq_D,     eqt_tq_D[6], eqt_tq_D[8], eqt_tq_D[10], eqt_sn);
    this.eqt_tq_ech(eqt_cr, eqt_tq_D + 3, eqt_tq_D[7], eqt_tq_D[9], eqt_tq_D[11], eqt_sn);
    eqt_df = 0;
  ) : eqt_cl[117] ? (                                       // nothing moved: land exactly on the targets
    t = 0; loop(23, eqt_cl[t] = eqt_cl[128 + t]; eqt_cr[t] = eqt_cr[128 + t]; t += 1; );
    eqt_cl[117] = eqt_cr[117] = 0;
  );
  eqt_sn = 0;
  eqt_mv = eqt_tq_mv;
);
function eqt_tq_srinit() local(eqt_c, i) (
  eqt_tq_sr = srate; eqt_tq_fs2 = 2 * srate;
  eqt_tq_dcd = 1 - 2 * $pi * 5 / eqt_tq_fs2;                    // DC blockers on the added parts, 5 Hz
  eqt_tq_iat = 1 - exp(-1 / (0.002 * eqt_tq_fs2)); eqt_tq_irl = exp(-1 / (0.150 * eqt_tq_fs2));   // the core's level follower
  eqt_tq_ce  = 1 - exp(-1 / (0.010 * eqt_tq_fs2));              // mean-square trackers (even terms DC-free), 10 ms
  eqt_tq_xc  = 2 * $pi * 40 / eqt_tq_fs2; eqt_tq_xlk = 1 - 2 * $pi * 5 / eqt_tq_fs2;   // flux: a 40 Hz sine's flux = its amplitude
  eqt_tq_slw = 2.2 * 1.8 * 96000 / eqt_tq_fs2;                  // op-amp slew (per 2x sample)
  eqt_tq_lpoff = min(0.45 * eqt_tq_fs2, 40000);                 // LPF 'off' end of its glide
  eqt_tq_N = 8;                                             // control rate: every 8 samples
  eqt_tq_kF = 1 - exp(-eqt_tq_N / (0.012 * srate)); eqt_tq_kG = 1 - exp(-eqt_tq_N / (0.008 * srate));   // two poles each
  eqt_tq_kS = eqt_tq_N / (0.008 * srate); eqt_tq_kX = eqt_tq_N / (0.020 * srate); eqt_tq_kfw = eqt_tq_N / (0.030 * srate);
  eqt_tq_xs = 1 / (0.030 * srate); eqt_tq_nwarm = floor(0.040 * srate);   // CITY: 40 ms settle, 30 ms crossfade
  eqt_tq_vdt = 1 / srate;
  eqt_tq_kI = 1 - exp(-1 / (0.005 * srate));                // INPUT TRIM glide: two 5 ms poles (about 20 ms)
  i = 0;
  loop(4,
    eqt_c = i == 0 ? eqt_tq_CTL : i == 1 ? eqt_tq_CTR : i == 2 ? eqt_tq_CNL : eqt_tq_CNR;
    eqt_tq_cset(eqt_c + 72, 400, 1.41421356); eqt_tq_cset(eqt_c + 80, 5000, 1.41421356);
    eqt_c[106] = 0.3; eqt_c[107] = 1; eqt_c[113] = 1;
    i += 1;
  );
  eqt_eT.init = eqt_eN.init = 1; eqt_eT.eqt_mv = eqt_eN.eqt_mv = 1;
  0;
);
function eqt_tq_update() (
  drift_macro(0);
  eqt_tq_om = slider(28) | 0;
  0;   // output stage: straight through
  eqt_own_pdc_bot = 0; eqt_own_pdc_top = 2;
  eqt_own_pdc_delay = eqt_tq_LAT;
  eqt_tq_tgt = slider(25) >= 0.5;
  eqt_tq_itt = exp(min(max(eqt_own_s33, -18), 18) * 0.115129255);   // INPUT TRIM target gain (exactly 1 at 0 dB)
);
function eqt_tq_pt(eqt_dr, eqt_lf, eqt_lg, eqt_lsh, eqt_mf, eqt_mg, eqt_hf, eqt_hg, eqt_hsh, eqt_hp, eqt_h18, eqt_lp, eqt_l18, o) (
  slider(29) = eqt_dr; slider(30) = eqt_lf; slider(31) = eqt_lg; slider(32) = eqt_lsh; slider(33) = eqt_mf; slider(34) = eqt_mg; slider(35) = eqt_hf; slider(36) = eqt_hg;
  slider(37) = eqt_hsh; slider(38) = eqt_hp; slider(39) = eqt_h18; slider(40) = eqt_lp; slider(41) = eqt_l18; slider(42) = o;
  slider(25) = 0; slider(26) = 1;
);
function eqt_tq_pn(eqt_dr, eqt_lf, eqt_lg, eqt_lsh, eqt_mf, eqt_mg, eqt_hf, eqt_hg, eqt_hsh, eqt_hp, eqt_h18, eqt_lp, eqt_l18, o) (
  slider(43) = eqt_dr; slider(44) = eqt_lf; slider(45) = eqt_lg; slider(46) = eqt_lsh; slider(47) = eqt_mf; slider(48) = eqt_mg; slider(49) = eqt_hf; slider(50) = eqt_hg;
  slider(51) = eqt_hsh; slider(52) = eqt_hp; slider(53) = eqt_h18; slider(54) = eqt_lp; slider(55) = eqt_l18; slider(56) = o;
  slider(25) = 1; slider(26) = 1;
);
function eqt_tq_pinit() (                                  // Init: TOKYO flat (and NEW YORK flat too)
  eqt_tq_pt(0, 2, 0, 1, 4, 0, 3, 0, 1, 20, 0, 22000, 0, 0);
  eqt_tq_pn(0, 1, 5, 1, 2, 5, 2, 5, 1, 20, 0, 22000, 0, 0); slider(25) = 0;
);
function eqt_load_preset(p) (
  p == 1  ? eqt_tq_pinit() :                                                        // Init
  p == 2  ? eqt_tq_pt(4,  3, -2, 1,  9,  5, 5,  3, 1,  90, 0, 22000, 0, -0.5) :     // Tokyo Vocal Bite
  p == 3  ? eqt_tq_pt(8,  4,  3, 0,  6, -3, 1,  6, 0, 100, 1, 22000, 0, -1.0) :     // Tokyo Snare Crack
  p == 4  ? eqt_tq_pt(10, 3, -3, 0,  4,  6, 3,  2, 1,  80, 0, 12000, 0, -1.5) :     // Tokyo Guitar Bloom
  p == 5  ? eqt_tq_pt(3,  2, -2, 1,  8,  3, 4,  4, 1,  60, 0, 22000, 0, -0.5) :     // Tokyo Keys Presence
  p == 6  ? eqt_tq_pt(5,  0,  2, 1,  3, -1, 5,  3, 1,  25, 0, 22000, 0, -0.5) :     // Tokyo Bus Gloss
  p == 7  ? eqt_tq_pt(12, 2,  0, 1,  7,  9, 3,  0, 1,  40, 0, 22000, 0, -2.5) :     // Tokyo Mid Push
  p == 8  ? eqt_tq_pn(6,  1,  8, 0,  0,  2, 0,  7, 0,  25, 0, 22000, 0, -1.0) :     // New York Kick
  p == 9  ? eqt_tq_pn(10, 2,  7, 0,  3,  8, 2,  7, 1,  80, 1, 22000, 0, -1.5) :     // New York Snare Snap
  p == 10 ? eqt_tq_pn(8,  1,  8, 1,  1,  6, 0,  4, 0,  30, 0, 10000, 0, -1.5) :     // New York Bass Punch
  p == 11 ? eqt_tq_pn(5,  2,  4, 1,  3,  7, 2,  7, 1,  80, 0, 22000, 0, -0.5) :     // New York Vocal
  p == 12 ? eqt_tq_pn(9,  1,  7, 1,  1,  4, 3,  7, 1,  30, 0, 22000, 0, -1.5) :     // New York Drum Bus
  p == 13 ? eqt_tq_pn(12, 2,  4, 0,  3,  7, 1,  6, 0, 100, 1, 14000, 0, -2.0) :     // New York Guitar
  p == 14 ? eqt_tq_pn(2,  1,  5, 1,  2,  5, 4,  8, 1,  20, 0, 22000, 0,  0.0) :     // New York Air
  p == 15 ? (                                                                   // Reset all to defaults
    eqt_tq_pinit(); slider(27) = 50; slider(28) = 1; eqt_own_s33 = 0; ui_auto(24 + 33);   // (INPUT TRIM: only here, not in presets)
  );
  p >= 1 ? 0;                 // sliders 1-32
);
function eqt_init() (
#eqt_own_ui_man = "gfx-tony-q-550";                             // the ? pop-up links to this manual
eqt_own_ext_noinit = 1;

// ---------- memory ----------
eqt_nextmem = 1000000;

eqt_tq_H   = eqt_alloc(48);                                     // half-band odd taps
eqt_tq_ubL = eqt_alloc(128); eqt_tq_ubR = eqt_alloc(128);               // 1x input history (mirrored rings of 64)
eqt_tq_aL  = eqt_alloc(128); eqt_tq_aR  = eqt_alloc(128);               // 2x output, first phase
eqt_tq_bL  = eqt_alloc(128); eqt_tq_bR  = eqt_alloc(128);               // 2x output, second phase
// per engine and channel: filter coefficients (12 sets of 8) and flags; TL / TR Tokyo, NL / NR New York
eqt_tq_CTL = eqt_alloc(192); eqt_tq_CTR = eqt_alloc(192); eqt_tq_CNL = eqt_alloc(192); eqt_tq_CNR = eqt_alloc(192);
eqt_tq_D   = eqt_alloc(16);                                     // drift factors
0;                                  // the house output stage
eqt_tq_wp = 0;
eqt_tq_LAT = 47;                                            // latency of the 2x engine (samples)
//   coefficient block layout: 0 LOW, 8 MID, 16 HIGH, 24 HPF 12, 32 HPF 18 (2-pole), 40 HPF 18 (1-pole),
//   48 LPF 12, 56 LPF 18 (2-pole), 64 LPF 18 (1-pole), 72 split 400 Hz, 80 split 5 kHz, 88 NY bump.
//   flags: 96 HPF on, 97 HPF 18 weight, 98 LPF on, 99 LPF 18 weight, 100 / 101 / 102 band on, 103 drive gain,
//   104 trim, 105 preamp fade, 106 preamp bias, 107 iron saturation point, 108 / 109 per-sample ramps,
//   110 reset mask, 111 / 112 preamp curve offset / normaliser, 113 op-amp even term, 114 / 115 slope ramps,
//   116 / 118 HPF / LPF in-circuit weight, 119 / 120 their ramps, 117 band coefficients gliding,
//   128..151 the bands' target coefficients, 152..175 their per-sample increments.

// ---------- the half-band (95 taps, Kaiser beta 8): the 48 non-zero odd taps h[2i - 47], i = 0..47 ----------

eqt_tq_i = 0; eqt_tq_s = 0; eqt_tq_bk = 8; eqt_tq_ib = eqt_tq_i0(eqt_tq_bk);
loop(48,
  eqt_tq_k = 2 * eqt_tq_i - 47;
  eqt_tq_H[eqt_tq_i] = sin($pi * eqt_tq_k * 0.5) / ($pi * eqt_tq_k) * eqt_tq_i0(eqt_tq_bk * sqrt(max(1 - sqr(eqt_tq_k / 48), 0))) / eqt_tq_ib;
  eqt_tq_s += eqt_tq_H[eqt_tq_i]; eqt_tq_i += 1;
);
eqt_tq_i = 0; loop(48, eqt_tq_H[eqt_tq_i] *= 0.5 / eqt_tq_s; eqt_tq_i += 1; );   // the odd taps sum to exactly 0.5 (unity at DC)


// ---------- filters: the TPT state-variable filter (stable under modulation) and a TPT one-pole ----------
// c[0..3] = a1, a2, a3, k; an EQ set adds the output mix c[4..6] = m0, m1, m2




   // a low-pass already settled on x

// coefficient sets (fs2 = the 2x rate)



// an EQ band: type 0 bell, 1 low shelf, 2 high shelf; gdb in dB



// ---------- the discrete preamp (drive domain): biased curve, level-matched; only its added part is DC-blocked ----------
eqt_tq_pk = 0.03; eqt_tq_pd = 1.0;                              // headroom scale, curve drive


// ---------- HPF -> LOW / MID / HIGH -> LPF (shared by both engines; the flags and sets live in c) ----------



// ---------- TOKYO: the mid-focused output transformer ----------
eqt_tq_iw = 0.12;                                           // the core's backlash width (memory)
eqt_tq_ihy = 0.35;                                          // how far the core lags at the turning points (full level)
eqt_tq_iev = 0.05;                                          // even (2nd) harmonic as the core is worked
eqt_tq_ibl = 0.08;                                          // bloom: the band eases down as the core fills




// ---------- NEW YORK: discrete op-amp + output transformer ----------
eqt_tq_nrl = 2.2;                                           // the op-amp's rails (drive domain): +4 dBFS
eqt_tq_na2 = 0.008;                                         // a trace of 2nd harmonic below the rails
eqt_tq_xw  = 0.7;                                           // how far the core curve bends
// the op-amp's curve: linear to 0.6 of the rail, a quadratic knee, flat at the rail from 1.4 (a hard knee near the
// rails). Only the residue (curve - input) is computed, with first-order antiderivative anti-aliasing (ADAA).
eqt_tq_ka = 0.6; eqt_tq_kb = 1.4; eqt_tq_kw = eqt_tq_kb - eqt_tq_ka;





// ---------- one engine, one channel (2x rate): drive gain in, preamp, filters, output stage, gain out, trim ----------





// ---------- the stepped tables ----------









// ---------- one engine's controls: glides (control rate, every 32 samples), flags and coefficients ----------
// b = its first slider, ny = 1 for NEW YORK, cl / cr = its two coefficient blocks

// two-pole glides (critically damped: they start and land gently, so a stepped switch never zippers)





// ---------- settings ----------

eqt_tq_srinit();
eqt_tq_vw = 13.6; eqt_tq_vz = 0.81;                             // VU needle: natural frequency, damping
eqt_tq_vw2 = eqt_tq_vw * eqt_tq_vw; eqt_tq_vzw = 2 * eqt_tq_vz * eqt_tq_vw;
eqt_tq_vref = 1.5707963 / 0.125892541;                      // rectified x pi/2: 0 VU = a sine peaking at -18 dBFS



// ---------- presets ----------
// Tokyo: drive, low f / lvl / shelf, mid f / lvl, high f / lvl / shelf, hpf, hpf 18, lpf, lpf 18, output

// New York: the same, gains as switch positions (5 = 0 dB, 6 / 7 / 8 / 9 / 10 = +2 / 4 / 6 / 9 / 12)




// ---------- state ----------
eqt_dB1L.drift_init(0.8 + rand(0.4)); eqt_dB1R.drift_init(0.8 + rand(0.4));
eqt_dB2L.drift_init(0.8 + rand(0.4)); eqt_dB2R.drift_init(0.8 + rand(0.4));
eqt_dB3L.drift_init(0.8 + rand(0.4)); eqt_dB3R.drift_init(0.8 + rand(0.4));
eqt_dGL.drift_init(0.9 + rand(0.5));  eqt_dGR.drift_init(0.9 + rand(0.5));
eqt_dBiL.drift_init(0.7 + rand(0.5)); eqt_dBiR.drift_init(0.7 + rand(0.5));
eqt_dKL.drift_init(0.6 + rand(0.4));  eqt_dKR.drift_init(0.6 + rand(0.4));
eqt_tq_mm1 = rand(2) - 1; eqt_tq_mm2 = rand(2) - 1; eqt_tq_mm3 = rand(2) - 1; eqt_tq_mm4 = rand(2) - 1;   // fixed L / R mismatch
eqt_tq_i = 0; loop(12, eqt_tq_D[eqt_tq_i] = 1; eqt_tq_i += 1; ); eqt_tq_D[8] = eqt_tq_D[9] = 0;
eqt_tq_update();
eqt_tq_it1 = eqt_tq_it2 = eqt_tq_itt;                               // INPUT TRIM glide starts on its value
eqt_tq_tg = eqt_tq_tgt; eqt_tq_w = eqt_tq_tgt; eqt_tq_wc = 0; eqt_tq_cc = 0;
eqt_tq_vy = eqt_tq_vv = 0; eqt_tqa_pl = eqt_tqa_pr = 0;

eqt_own_ui_thm = 5; eqt_own_ui_hw = 1;                                  // house keycaps for the preset bar and size picker
!eqt_ui_dflt ? ( eqt_own_ui_sz = 2; eqt_pr_cur = 1; );                  // new instances open in Large, on Init
eqt_ui_dflt = 1;
0;
);

function eqt_slider() (
eqt_tq_update();
0;
);

function eqt_block() (
srate != eqt_tq_sr ? eqt_tq_srinit();
eqt_tq_update();                                            // keys and knobs moved on the panel do not run @slider
// ---- DRIFT: component tolerance wander (band frequencies and gains, bias, the iron), each channel on its own
eqt_tq_di = 0.12 * eqt_own_dm_s * samplesblock / srate;
eqt_tq_D[0] = 1 + eqt_own_dm_a * (0.012 * eqt_dB1L.drift_tick(eqt_tq_di) + 0.004 * eqt_tq_mm1);
eqt_tq_D[3] = 1 + eqt_own_dm_a * (0.012 * eqt_dB1R.drift_tick(eqt_tq_di) - 0.004 * eqt_tq_mm1);
eqt_tq_D[1] = 1 + eqt_own_dm_a * (0.012 * eqt_dB2L.drift_tick(eqt_tq_di) + 0.004 * eqt_tq_mm2);
eqt_tq_D[4] = 1 + eqt_own_dm_a * (0.012 * eqt_dB2R.drift_tick(eqt_tq_di) - 0.004 * eqt_tq_mm2);
eqt_tq_D[2] = 1 + eqt_own_dm_a * (0.012 * eqt_dB3L.drift_tick(eqt_tq_di) + 0.004 * eqt_tq_mm3);
eqt_tq_D[5] = 1 + eqt_own_dm_a * (0.012 * eqt_dB3R.drift_tick(eqt_tq_di) - 0.004 * eqt_tq_mm3);
eqt_tq_D[6] = 1 + eqt_own_dm_a * (0.02 * eqt_dGL.drift_tick(eqt_tq_di) + 0.01 * eqt_tq_mm4);
eqt_tq_D[7] = 1 + eqt_own_dm_a * (0.02 * eqt_dGR.drift_tick(eqt_tq_di) - 0.01 * eqt_tq_mm4);
eqt_tq_D[8] = eqt_own_dm_a * 0.03 * eqt_dBiL.drift_tick(eqt_tq_di);  eqt_tq_D[9] = eqt_own_dm_a * 0.03 * eqt_dBiR.drift_tick(eqt_tq_di);
eqt_tq_D[10] = 1 + eqt_own_dm_a * 0.04 * eqt_dKL.drift_tick(eqt_tq_di); eqt_tq_D[11] = 1 + eqt_own_dm_a * 0.04 * eqt_dKR.drift_tick(eqt_tq_di);
eqt_eT.eqt_df = eqt_eN.eqt_df = 1;                                      // the drift moved: coefficients once per block
// ---- denormal housekeeping
eqt_tq_rT || eqt_tq_w < 1 ? ( eqt_TL.eqt_tq_tfl(); eqt_TR.eqt_tq_tfl(); );
eqt_tq_rN || eqt_tq_w > 0 ? ( eqt_NL.eqt_tq_nfl(); eqt_NR.eqt_tq_nfl(); );
abs(eqt_tq_vy) + abs(eqt_tq_vv) < 0.000000001 ? eqt_tq_vy = eqt_tq_vv = 0;
// ---- the meters' block values for the panel
eqt_tqa_v = eqt_tq_vy;
eqt_tqa_ol = eqt_tqa_pl; eqt_tqa_or = eqt_tqa_pr; eqt_tqa_pl = eqt_tqa_pr = 0;
eqt_tqa_blk += 1;
0;
);

function eqt_sample() (
// ---------- INPUT TRIM (-18 .. +18 dB, gliding): first in the path, so the VU and DRIVE see the trimmed level ----------
eqt_tq_it2 !== eqt_tq_itt ? (                                  // (!== : exact; EEL != has a 0.00001 tolerance)
  eqt_tq_it1 += (eqt_tq_itt - eqt_tq_it1) * eqt_tq_kI; eqt_tq_it2 += (eqt_tq_it1 - eqt_tq_it2) * eqt_tq_kI;
  abs(eqt_tq_it2 - eqt_tq_itt) < 0.000001 * eqt_tq_itt && abs(eqt_tq_it1 - eqt_tq_itt) < 0.000001 * eqt_tq_itt ? eqt_tq_it1 = eqt_tq_it2 = eqt_tq_itt;
);
eqt_tq_il = spl0 * eqt_tq_it2; eqt_tq_ir = spl1 * eqt_tq_it2;
// ---------- control rate (every 8 samples): glides, flags, coefficients ----------
(eqt_tq_cc -= 1) <= 0 ? (
  eqt_tq_cc = eqt_tq_N;
  // CITY: the incoming engine starts, settles 40 ms, then a 30 ms crossfade
  eqt_tq_tgt != eqt_tq_tg ? ( eqt_tq_tg = eqt_tq_tgt; eqt_tq_wc = eqt_tq_nwarm; );
  eqt_tq_rT = eqt_tq_w < 1 || !eqt_tq_tg; eqt_tq_rN = eqt_tq_w > 0 || eqt_tq_tg;
  eqt_tq_rT ? eqt_eT.eqt_tq_eng(5,  0, eqt_tq_CTL, eqt_tq_CTR) : eqt_eT.eqt_mv = 1;
  eqt_tq_rN ? eqt_eN.eqt_tq_eng(19, 1, eqt_tq_CNL, eqt_tq_CNR) : eqt_eN.eqt_mv = 1;
);
eqt_tq_wc > 0 ? eqt_tq_wc -= 1 : eqt_tq_w = eqt_tq_tg ? min(eqt_tq_w + eqt_tq_xs, 1) : max(eqt_tq_w - eqt_tq_xs, 0);
eqt_tq_xw2 = eqt_tq_w * eqt_tq_w * (3 - 2 * eqt_tq_w);
// ---------- 2x: up-sample, the engine(s), down-sample ----------
eqt_tq_wp = (eqt_tq_wp + 63) & 63;
eqt_tq_ubL[eqt_tq_wp] = eqt_tq_ubL[eqt_tq_wp + 64] = eqt_tq_il; eqt_tq_ubR[eqt_tq_wp] = eqt_tq_ubR[eqt_tq_wp + 64] = eqt_tq_ir;
eqt_tq_u0 = 2 * eqt_tq_conv(eqt_tq_ubL + eqt_tq_wp); eqt_tq_u1 = eqt_tq_ubL[eqt_tq_wp + 23];
eqt_tq_v0 = 2 * eqt_tq_conv(eqt_tq_ubR + eqt_tq_wp); eqt_tq_v1 = eqt_tq_ubR[eqt_tq_wp + 23];
eqt_tq_rT && eqt_tq_rN ? (
  eqt_tq_y0 = eqt_TL.eqt_tq_tch(eqt_tq_u0, eqt_tq_CTL); eqt_tq_y0 += (eqt_NL.eqt_tq_nch(eqt_tq_u0, eqt_tq_CNL) - eqt_tq_y0) * eqt_tq_xw2;
  eqt_tq_y1 = eqt_TL.eqt_tq_tch(eqt_tq_u1, eqt_tq_CTL); eqt_tq_y1 += (eqt_NL.eqt_tq_nch(eqt_tq_u1, eqt_tq_CNL) - eqt_tq_y1) * eqt_tq_xw2;
  eqt_tq_y2 = eqt_TR.eqt_tq_tch(eqt_tq_v0, eqt_tq_CTR); eqt_tq_y2 += (eqt_NR.eqt_tq_nch(eqt_tq_v0, eqt_tq_CNR) - eqt_tq_y2) * eqt_tq_xw2;
  eqt_tq_y3 = eqt_TR.eqt_tq_tch(eqt_tq_v1, eqt_tq_CTR); eqt_tq_y3 += (eqt_NR.eqt_tq_nch(eqt_tq_v1, eqt_tq_CNR) - eqt_tq_y3) * eqt_tq_xw2;
) : eqt_tq_rT ? (
  eqt_tq_y0 = eqt_TL.eqt_tq_tch(eqt_tq_u0, eqt_tq_CTL); eqt_tq_y1 = eqt_TL.eqt_tq_tch(eqt_tq_u1, eqt_tq_CTL);
  eqt_tq_y2 = eqt_TR.eqt_tq_tch(eqt_tq_v0, eqt_tq_CTR); eqt_tq_y3 = eqt_TR.eqt_tq_tch(eqt_tq_v1, eqt_tq_CTR);
) : (
  eqt_tq_y0 = eqt_NL.eqt_tq_nch(eqt_tq_u0, eqt_tq_CNL); eqt_tq_y1 = eqt_NL.eqt_tq_nch(eqt_tq_u1, eqt_tq_CNL);
  eqt_tq_y2 = eqt_NR.eqt_tq_nch(eqt_tq_v0, eqt_tq_CNR); eqt_tq_y3 = eqt_NR.eqt_tq_nch(eqt_tq_v1, eqt_tq_CNR);
);
eqt_tq_aL[eqt_tq_wp] = eqt_tq_aL[eqt_tq_wp + 64] = eqt_tq_y0;  eqt_tq_bL[eqt_tq_wp] = eqt_tq_bL[eqt_tq_wp + 64] = eqt_tq_y1;
eqt_tq_aR[eqt_tq_wp] = eqt_tq_aR[eqt_tq_wp + 64] = eqt_tq_y2;  eqt_tq_bR[eqt_tq_wp] = eqt_tq_bR[eqt_tq_wp + 64] = eqt_tq_y3;
eqt_tq_ol = 0.5 * eqt_tq_bL[eqt_tq_wp + 24] + eqt_tq_conv(eqt_tq_aL + eqt_tq_wp);
eqt_tq_or = 0.5 * eqt_tq_bR[eqt_tq_wp + 24] + eqt_tq_conv(eqt_tq_aR + eqt_tq_wp);
// ---------- the house output stage ----------
(ost_l = (eqt_tq_ol); ost_r = (eqt_tq_or));
spl0 = ost_l; spl1 = ost_r;
// ---------- meters: the input VU needle (mass + spring + damping), the output peaks ----------
eqt_tq_md = max(abs(eqt_tq_il), abs(eqt_tq_ir)) * eqt_tq_vref;
eqt_tq_vv += (eqt_tq_vw2 * (eqt_tq_md - eqt_tq_vy) - eqt_tq_vzw * eqt_tq_vv) * eqt_tq_vdt; eqt_tq_vy += eqt_tq_vv * eqt_tq_vdt;
eqt_tqa_pl = max(eqt_tqa_pl, abs(spl0)); eqt_tqa_pr = max(eqt_tqa_pr, abs(spl1));
0;
);

// ======================== gfx-board-q.jsfx (prefix eqb_; its sliders 1-18 at 57-74) ========================
function eqb_defaults() (
  slider(57) = 20;
  slider(58) = 22000;
  slider(59) = 0;
  slider(60) = 100;
  slider(61) = 0;
  slider(62) = 0;
  slider(63) = 600;
  slider(64) = 1;
  slider(65) = 0;
  slider(66) = 2500;
  slider(67) = 1;
  slider(68) = 0;
  slider(69) = 8000;
  slider(70) = 0;
  slider(71) = 1;
  slider(72) = 1;
  slider(73) = 0;
  slider(74) = 0;
  0;
);
function eqb_consts() (
  eqb_own_s19 = 0;
  eqb_own_s20 = 1;
  eqb_own_s21 = 0;
  eqb_own_s22 = 30;
  eqb_own_s23 = 120;
  eqb_own_s24 = 6000;
  eqb_own_s25 = -0.3;
  eqb_own_s26 = 1;
  slider(71) = 1;
  0;
);
function eqb_th(eqb_x) ( eqb_x = min(max(eqb_x, -3), 3); eqb_x * (27 + eqb_x * eqb_x) / (27 + 9 * eqb_x * eqb_x); );
function eqb_hp1(eqb_x) instance(x1, y1) ( y1 = eqb_hp1_a * (eqb_x - x1) + eqb_hp1_b * y1; x1 = eqb_x; y1; );
function eqb_hp1set(eqb_f) local(eqb_k) ( eqb_k = tan($pi * min(eqb_f, srate * 0.45) / srate); eqb_hp1_a = 1 / (1 + eqb_k); eqb_hp1_b = (1 - eqb_k) / (1 + eqb_k); );
function eqb_hp1db(eqb_f) local(eqb_w, eqb_wc) ( eqb_wc = slider(57); eqb_w = eqb_f / eqb_wc; 10 * log10(eqb_w * eqb_w / (1 + eqb_w * eqb_w)); );
function eqb_chain(eqb_x) instance() local(eqb_y) (
  eqb_hp_on ? eqb_x = this.eqb_h1.eqb_hp1(this.eqb_h2.bq_run(eqb_x));
  eqb_eq_on ? (
    eqb_x = this.eqb_lf.bq_run(eqb_x); eqb_lfx ? eqb_x = this.eqb_lx.bq_run(eqb_x);
    eqb_x = this.eqb_lm.bq_run(eqb_x); eqb_x = this.eqb_hm.bq_run(eqb_x);
    eqb_x = this.eqb_hf.bq_run(eqb_x); eqb_hfx ? eqb_x = this.eqb_hx.bq_run(eqb_x);
  );
  eqb_y = this.eqb_lp.bq_run(eqb_x);                     // the LPF always runs (primed) and is faded in / out, never switched
  eqb_bd_lpw >= 1 ? eqb_x = eqb_y : eqb_bd_lpw > 0 ? eqb_x += (eqb_y - eqb_x) * eqb_bd_lpw;
  eqb_x;
);
function eqb_setch() instance() local(eqb_q) (
  eqb_hp_on ? this.eqb_h2.bq_set(1, slider(57), 1, 0);
  this.eqb_lp.bq_set(0, eqb_bd_lpf, 0.707, 0);       // bd_lpf: the LPF frequency, glided in @sample
  // proportional Q on the black card
  this.eqb_lf.bq_set(slider(61) ? 2 : 4, slider(60), slider(61) ? (eqb_blk ? 0.6 + abs(slider(59)) / 15 * 0.9 : 0.55) : (eqb_blk ? 1.15 : 0.6), slider(59));
  this.eqb_lm.bq_set(2, slider(63), slider(64) * (eqb_blk ? 0.6 + abs(slider(62)) / 15 * 1.2 : 0.7), slider(62));
  this.eqb_hm.bq_set(2, slider(66), slider(67) * (eqb_blk ? 0.6 + abs(slider(65)) / 15 * 1.2 : 0.7), slider(65));
  this.eqb_hf.bq_set(slider(70) ? 2 : 3, slider(69), slider(70) ? (eqb_blk ? 0.6 + abs(slider(68)) / 15 * 0.9 : 0.55) : (eqb_blk ? 1.15 : 0.6), slider(68));
  // the black card's shelves: a small opposite dip just inside the corner
  eqb_lfx ? this.eqb_lx.bq_set(2, slider(60) * 2.2, 1.2, -slider(59) * 0.12);
  eqb_hfx ? this.eqb_hx.bq_set(2, slider(69) * 0.45, 1.2, -slider(68) * 0.12);
);
function eqb_update() local(b, eqb_cs) (
  eqb_cs = 0; b = 1; loop(18, eqb_cs += slider(56 + b) * (b * 7.31 + 1); b += 1; );
  eqb_cs != eqb_last_cs ? ( eqb_redraw = 1; eqb_last_cs = eqb_cs; );
  eqb_hp_on = slider(57) > 20.5; eqb_lp_on = slider(58) < 21990; eqb_eq_on = slider(71); eqb_blk = slider(72);
  eqb_lfx = eqb_blk && !slider(61); eqb_hfx = eqb_blk && !slider(70);
  eqb_hp1set(slider(57));
  eqb_CL.eqb_setch(); eqb_CR.eqb_setch();
  eqb_drv = slider(73) / 100; eqb_dk = 1 + eqb_drv * 3; eqb_dbias = eqb_drv * 0.15; eqb_dtb = eqb_th(eqb_dbias);
  eqb_og = 10 ^ (slider(74) / 20);
  0;
  0;   // output stage: straight through
);
function eqb_pq(eqb_hp, eqb_lp, eqb_lg, eqb_lf, eqb_lb, eqb_mg, eqb_mf, eqb_mq, eqb_hg, eqb_hf_, eqb_hq, eqb_fg, eqb_ff, eqb_fb, eqb_vo, eqb_dr) (
  slider(57) = eqb_hp; slider(58) = eqb_lp; slider(59) = eqb_lg; slider(60) = eqb_lf; slider(61) = eqb_lb; slider(62) = eqb_mg; slider(63) = eqb_mf; slider(64) = eqb_mq;
  slider(65) = eqb_hg; slider(66) = eqb_hf_; slider(67) = eqb_hq; slider(68) = eqb_fg; slider(69) = eqb_ff; slider(70) = eqb_fb; slider(71) = 1; slider(72) = eqb_vo; slider(73) = eqb_dr; slider(74) = 0;
);
function eqb_load_preset(eqb_p) (
  eqb_p == 1  ? eqb_pq(90, 22000, -2, 200, 1, -3, 350, 1.2, 4, 3500, 1.2, 3, 12000, 0, 1, 10) :      // Vocal Presence
  eqb_p == 2  ? eqb_pq(30, 22000, 5, 60, 1, -5, 380, 1.5, 3, 3000, 1.5, 0, 8000, 0, 1, 15) :         // Kick Punch
  eqb_p == 3  ? eqb_pq(80, 22000, 2, 200, 1, -2, 500, 1.2, 4, 5000, 1.4, 3, 10000, 0, 1, 20) :       // Snare Crack
  eqb_p == 4  ? eqb_pq(30, 9000, 4, 80, 0, -3, 250, 1.2, 2, 1200, 1.0, 0, 8000, 0, 0, 25) :          // Bass Weight
  eqb_p == 5  ? eqb_pq(70, 22000, -2, 150, 0, -2, 300, 1.0, 2, 4000, 0.8, 4, 12000, 0, 0, 0) :       // Acoustic Sparkle
  eqb_p == 6  ? eqb_pq(25, 22000, 1.5, 60, 0, 0, 600, 1, -1, 3000, 0.8, 2, 14000, 0, 0, 10) :        // Mix Bus Air
  eqb_p == 7  ? eqb_pq(400, 3500, 0, 100, 0, 6, 1500, 1.5, 0, 2500, 1, 0, 8000, 0, 1, 60) :          // Telephone
  eqb_p == 8  ? eqb_pq(60, 22000, 0, 100, 0, -5, 300, 1.0, 0, 2500, 1, 1, 10000, 0, 1, 0) :          // De-mud
  eqb_p == 9  ? eqb_pq(40, 16000, 3, 120, 0, 1, 800, 0.7, 1, 3000, 0.7, 2, 9000, 0, 0, 40) :         // Brown Warmth
  eqb_p == 10 ? eqb_pq(100, 22000, 0, 100, 0, 0, 600, 1, -4, 6500, 2.5, 2, 15000, 0, 1, 0);          // De-harsh
  eqb_p >= 1 && eqb_p <= 10 ? 0;     // sliders 1-18
  eqb_p == 11 ? (                                       // Reset all to defaults
    eqb_pq(20, 22000, 0, 100, 0, 0, 600, 1, 0, 2500, 1, 0, 8000, 0, 1, 0);
    eqb_own_s19 = 0; eqb_own_s20 = 1; eqb_own_s21 = 0; eqb_own_s22 = 30; eqb_own_s23 = 120; eqb_own_s24 = 6000; eqb_own_s25 = -0.3; eqb_own_s26 = 1;
    0;
  );
);
function eqb_init() (
#eqb_own_ui_man = "gfx-board-q";                                  // the ? pop-up links to this manual


// one-pole high-pass (the third pole of the 18 dB HPF)




// one channel's chain






// ---------- presets (leave INPUT and OUTPUT alone) ----------



0;
0; 0; 0;
!eqb_ui_dflt ? eqb_own_ui_thm = 5; !eqb_ui_dflt ? eqb_own_ui_hw = 1; eqb_RSP = 30000;
eqb_PNL = 0xB4B8BA; eqb_PRT = 0x1C1E21; eqb_SCR = 0x121517; eqb_CRED = 0xC8322A; eqb_CGRN = 0x2E8A4A; eqb_CBLU = 0x2C5FA8; eqb_CBRN = 0x6A4A32; eqb_CGRY = 0xE4E4E0; eqb_CBLK = 0x26272A; eqb_SLB = 0x3BA9E0; eqb_SDB = 0x34349A; eqb_SRD = 0xE0262B;
eqb_bd_lpf = min(slider(58), srate * 0.45); eqb_bd_lpk = 1 - exp(-16 / (0.02 * srate)); eqb_bd_lpn = 0;   // LPF glide (~20 ms)
eqb_update();
eqb_bd_lpw = eqb_lp_on; eqb_bd_lpxs = 1 / (0.02 * srate);   // LPF on / off fade: 20 ms
eqb_ui_dflt = 1;   // theme defaults above apply once: @init re-runs (playback start, device reset) must not undo the saved theme
0;
);

function eqb_slider() (
eqb_update();
0;
);

function eqb_block() (
eqb_update();
0;
);

function eqb_sample() (
(in_l = (spl0); in_r = (spl1); in_comp = 1);
eqb_bd_lpw = eqb_lp_on ? min(eqb_bd_lpw + eqb_bd_lpxs, 1) : max(eqb_bd_lpw - eqb_bd_lpxs, 0);
eqb_bd_lpt = min(slider(58), srate * 0.45);
eqb_bd_lpf != eqb_bd_lpt ? ( (eqb_bd_lpn += 1) >= 16 ? ( eqb_bd_lpn = 0; eqb_bd_lpf *= (eqb_bd_lpt / eqb_bd_lpf) ^ eqb_bd_lpk; abs(eqb_bd_lpf - eqb_bd_lpt) < 0.0005 * eqb_bd_lpt ? eqb_bd_lpf = eqb_bd_lpt;
  eqb_CL.eqb_lp.bq_set(0, eqb_bd_lpf, 0.707, 0); eqb_CR.eqb_lp.bq_set(0, eqb_bd_lpf, 0.707, 0); ); );
eqb_xl = eqb_CL.eqb_chain(in_l); eqb_xr = eqb_CR.eqb_chain(in_r);
eqb_drv > 0.001 ? (
  eqb_xl = (eqb_th(eqb_dk * eqb_xl + eqb_dbias) - eqb_dtb) / (eqb_dk * (1 - eqb_dtb * eqb_dtb));
  eqb_xr = (eqb_th(eqb_dk * eqb_xr + eqb_dbias) - eqb_dtb) / (eqb_dk * (1 - eqb_dtb * eqb_dtb));
);
eqb_xl *= eqb_og; eqb_xr *= eqb_og;
eqb_oL = (eqb_xl * in_comp); eqb_oR = (eqb_xr * in_comp);
(ost_l = (eqb_oL); ost_r = (eqb_oR));
spl0 = ost_l; spl1 = ost_r;
eqb_pkO = max(eqb_pkO, max(abs(spl0), abs(spl1)));
0;
);

// ======================== gfx-skye.jsfx (prefix eqs_; its sliders 2-29 at 75-102) ========================
function eqs_defaults() (
  slider(75) = 100;
  slider(76) = 1;
  slider(77) = 0;
  slider(78) = 1;
  slider(79) = 500;
  slider(80) = 1;
  slider(81) = 0;
  slider(82) = 1;
  slider(83) = 2500;
  slider(84) = 1;
  slider(85) = 0;
  slider(86) = 1;
  slider(87) = 8000;
  slider(88) = 1;
  slider(89) = 0;
  slider(90) = 1;
  slider(91) = 0;
  slider(92) = 1;
  slider(93) = 0;
  slider(94) = 0;
  slider(95) = 30;
  slider(96) = 0;
  slider(97) = 0;
  slider(98) = 18000;
  slider(99) = 0;
  slider(100) = 0;
  slider(101) = 0;
  slider(102) = 0;
  0;
);
function eqs_consts() (
  eqs_own_s1 = 0;
  slider(92) = 1;
  slider(93) = 0;
  slider(94) = 0;
  0;
);
function eqs_alloc(n) local(p) ( p = eqs_nextmem; eqs_nextmem += n; memset(p, 0, n); p; );
function eqs_db2g(d) ( exp(d*0.11512925465); );
function eqs_bwq(eqs_bw) local(p) ( p = 2^max(eqs_bw, 0.05); sqrt(p)/(p - 1); );
function eqs_shq(eqs_bw) ( min(max(0.7071*2^((1 - eqs_bw)*0.5), 0.4), 1.2); );
function eqs_nsec(s) ( s < 0.5 ? 1 : s < 1.5 ? 2 : 4; );
function eqs_hpf_set(f) local(n) (
  n = eqs_nsec(slider(96));
  n == 1 ? ( eqs_skHaL.bq_set(1, f, 0.70711, 0); eqs_skHaR.bq_set(1, f, 0.70711, 0); ) :
  n == 2 ? ( eqs_skHaL.bq_set(1, f, 0.54120, 0); eqs_skHaR.bq_set(1, f, 0.54120, 0);
             eqs_skHbL.bq_set(1, f, 1.30656, 0); eqs_skHbR.bq_set(1, f, 1.30656, 0); ) :
           ( eqs_skHaL.bq_set(1, f, 0.50980, 0); eqs_skHaR.bq_set(1, f, 0.50980, 0);
             eqs_skHbL.bq_set(1, f, 0.60134, 0); eqs_skHbR.bq_set(1, f, 0.60134, 0);
             eqs_skHcL.bq_set(1, f, 0.89998, 0); eqs_skHcR.bq_set(1, f, 0.89998, 0);
             eqs_skHdL.bq_set(1, f, 2.56292, 0); eqs_skHdR.bq_set(1, f, 2.56292, 0); );
  eqs_skHn = n;
);
function eqs_lpf_set(f) local(n) (
  n = eqs_nsec(slider(99));
  n == 1 ? ( eqs_skLaL.bq_set(0, f, 0.70711, 0); eqs_skLaR.bq_set(0, f, 0.70711, 0); ) :
  n == 2 ? ( eqs_skLaL.bq_set(0, f, 0.54120, 0); eqs_skLaR.bq_set(0, f, 0.54120, 0);
             eqs_skLbL.bq_set(0, f, 1.30656, 0); eqs_skLbR.bq_set(0, f, 1.30656, 0); ) :
           ( eqs_skLaL.bq_set(0, f, 0.50980, 0); eqs_skLaR.bq_set(0, f, 0.50980, 0);
             eqs_skLbL.bq_set(0, f, 0.60134, 0); eqs_skLbR.bq_set(0, f, 0.60134, 0);
             eqs_skLcL.bq_set(0, f, 0.89998, 0); eqs_skLcR.bq_set(0, f, 0.89998, 0);
             eqs_skLdL.bq_set(0, f, 2.56292, 0); eqs_skLdR.bq_set(0, f, 2.56292, 0); );
  eqs_skLn = n;
);
function eqs_setup() (
  eqs_eqin = slider(92) > 0.5; eqs_drA = slider(93)/100;
  eqs_outg = eqs_db2g(slider(91));
  0;   // output stage: straight through
);
function eqs_bands() local(eqs_v, eqs_fk, eqs_gk, eqs_q, t) (
  eqs_v = eqs_dV*eqs_drA;                                   // -1 .. +1 at 100%: the rail wandering about its nominal
  eqs_gk = 1 + 0.025*eqs_v; eqs_fk = 1 + 0.006*eqs_v;           // gains ease by up to 2.5 %, centres by up to 0.6 %
  eqs_on1 = slider(78) > 0.5;  eqs_on1 ? ( t = slider(101) > 0.5 ? 4 : 2; eqs_q = t == 4 ? eqs_shq(slider(76)) : eqs_bwq(slider(76));
                                eqs_b1L.bq_set(t, slider(75)*eqs_fk, eqs_q, slider(77)*eqs_gk);  eqs_b1R.bq_set(t, slider(75)*eqs_fk, eqs_q, slider(77)*eqs_gk); );
  eqs_on2 = slider(82) > 0.5;  eqs_on2 ? ( eqs_q = eqs_bwq(slider(80));  eqs_b2L.bq_set(2, slider(79)*eqs_fk, eqs_q, slider(81)*eqs_gk);  eqs_b2R.bq_set(2, slider(79)*eqs_fk, eqs_q, slider(81)*eqs_gk); );
  eqs_on3 = slider(86) > 0.5; eqs_on3 ? ( eqs_q = eqs_bwq(slider(84)); eqs_b3L.bq_set(2, slider(83)*eqs_fk, eqs_q, slider(85)*eqs_gk); eqs_b3R.bq_set(2, slider(83)*eqs_fk, eqs_q, slider(85)*eqs_gk); );
  eqs_on4 = slider(90) > 0.5; eqs_on4 ? ( t = slider(102) > 0.5 ? 3 : 2; eqs_q = t == 3 ? eqs_shq(slider(88)) : eqs_bwq(slider(88));
                                eqs_b4L.bq_set(t, slider(87)*eqs_fk, eqs_q, slider(89)*eqs_gk); eqs_b4R.bq_set(t, slider(87)*eqs_fk, eqs_q, slider(89)*eqs_gk); );
  eqs_skHon = slider(97) > 0.5; eqs_skHon ? eqs_hpf_set(slider(95)*eqs_fk);
  eqs_skLon = slider(100) > 0.5; eqs_skLon ? eqs_lpf_set(slider(98)*eqs_fk);
  eqs_hr = eqs_db2g(20 - 2.5*eqs_v);                         // op-amp headroom above 0 dBFS: about +20 dB, less when the rail sags
  eqs_ihr = 1/eqs_hr;
);
function eqs_pb(eqs_k, f, b, g) ( slider(73 + 2 + eqs_k*4) = f; slider(73 + 3 + eqs_k*4) = b; slider(73 + 4 + eqs_k*4) = g; slider(73 + 5 + eqs_k*4) = 1; );
function eqs_apply_preset(n) (
  slider(97) = 0; slider(100) = 0; slider(101) = 0; slider(102) = 0;   // every preset: filters out, BAND 1 and 4 as bells
  n == 0 ? ( eqs_pb(0, 100, 1, 0);    eqs_pb(1, 500, 1, 0);    eqs_pb(2, 2500, 1, 0);   eqs_pb(3, 8000, 1, 0);    slider(91) = 0; ) :   // Flat
  n == 1 ? ( eqs_pb(0, 120, 1.5, -2); eqs_pb(1, 350, 1.2, -2); eqs_pb(2, 3200, 1.2, 3); eqs_pb(3, 10000, 1.5, 2); slider(91) = 0; ) :   // Vocal Presence
  n == 2 ? ( eqs_pb(0, 60, 1, 4);     eqs_pb(1, 300, 1, -4);   eqs_pb(2, 2800, 1.5, 3); eqs_pb(3, 8000, 1, 0);    slider(91) = -1; ) :  // Kick and Bass
  n == 3 ? ( eqs_pb(0, 100, 1, 0);    eqs_pb(1, 500, 1, 0);    eqs_pb(2, 5000, 2, 1);   eqs_pb(3, 14000, 2, 4);   slider(91) = -1; ) :  // Air Lift
  n == 4 ? ( eqs_pb(0, 200, 2, -16);  eqs_pb(1, 1200, 1, 6);   eqs_pb(2, 2400, 1, 4);   eqs_pb(3, 6000, 2, -16);  slider(91) = -2; ) :  // Telephone
  n == 5 ? ( eqs_pb(0, 50, 0.1, -16); eqs_pb(1, 100, 0.1, -12); eqs_pb(2, 2500, 1, 0);  eqs_pb(3, 8000, 1, 0);    slider(91) = 0; ) :   // Hum Notch 50 Hz
  n == 6 ? ( eqs_pb(0, 50, 2, 2);     eqs_pb(1, 400, 2, -1);   eqs_pb(2, 3000, 2, -0.5); eqs_pb(3, 12000, 2, 2);  slider(91) = -1; ) :  // Mastering Smile
           ( eqs_pb(0, 90, 1, -3);    eqs_pb(1, 250, 1.5, 1.5); eqs_pb(2, 2500, 1, 2.5); eqs_pb(3, 7000, 1, -1.5); slider(91) = 0; );  // Broadcast Voice
);
function eqs_init() (
#eqs_own_ui_man = "gfx-skye";
eqs_nextmem = 1100000;


     // bandwidth (octaves) -> Q
       // SHELF mode: BW -> shelf slope Q (BW 1 = 0.707)
0;

// HPF / LPF: Butterworth chains of up to four biquads (x1 = 1 section, x2 = 2, x4 = 4)





// the band filters, re-set each block with the supply drift folded in

eqs_dV = 0; eqs_dT = 0; eqs_dW = 0; eqs_mOut = 0;

// ---------- presets: four bands (freq, bw, gain), output ----------


!eqs_ui_dflt ? ( eqs_own_ui_sz = 2; eqs_lastPreset = eqs_own_s1; );
eqs_ui_dflt = 1;
eqs_setup(); eqs_bands();
0;
);

function eqs_slider() (
eqs_own_s1 != eqs_lastPreset ? ( eqs_apply_preset(eqs_own_s1); eqs_lastPreset = eqs_own_s1; );
eqs_setup();
0;
);

function eqs_block() (
eqs_setup();
// DRIFT: the supply voltage - a slow random walk, eased so it never steps
eqs_dW -= samplesblock; eqs_dW <= 0 ? ( eqs_dW = srate*(0.7 + rand(2.3)); eqs_dT = rand(2) - 1; );
eqs_dV += (eqs_dT - eqs_dV)*min(1, samplesblock/(1.2*srate));
eqs_bands();
0;
);

function eqs_sample() (
eqs_xL = spl0; eqs_xR = spl1;
eqs_eqin ? (
  eqs_skHon ? (
    eqs_xL = eqs_skHaL.bq_run(eqs_xL); eqs_xR = eqs_skHaR.bq_run(eqs_xR);
    eqs_skHn > 1 ? ( eqs_xL = eqs_skHbL.bq_run(eqs_xL); eqs_xR = eqs_skHbR.bq_run(eqs_xR); );
    eqs_skHn > 2 ? ( eqs_xL = eqs_skHcL.bq_run(eqs_xL); eqs_xR = eqs_skHcR.bq_run(eqs_xR); eqs_xL = eqs_skHdL.bq_run(eqs_xL); eqs_xR = eqs_skHdR.bq_run(eqs_xR); );
  );
  eqs_on1 ? ( eqs_xL = eqs_b1L.bq_run(eqs_xL); eqs_xR = eqs_b1R.bq_run(eqs_xR); );
  eqs_on2 ? ( eqs_xL = eqs_b2L.bq_run(eqs_xL); eqs_xR = eqs_b2R.bq_run(eqs_xR); );
  eqs_on3 ? ( eqs_xL = eqs_b3L.bq_run(eqs_xL); eqs_xR = eqs_b3R.bq_run(eqs_xR); );
  eqs_on4 ? ( eqs_xL = eqs_b4L.bq_run(eqs_xL); eqs_xR = eqs_b4R.bq_run(eqs_xR); );
  eqs_skLon ? (
    eqs_xL = eqs_skLaL.bq_run(eqs_xL); eqs_xR = eqs_skLaR.bq_run(eqs_xR);
    eqs_skLn > 1 ? ( eqs_xL = eqs_skLbL.bq_run(eqs_xL); eqs_xR = eqs_skLbR.bq_run(eqs_xR); );
    eqs_skLn > 2 ? ( eqs_xL = eqs_skLcL.bq_run(eqs_xL); eqs_xR = eqs_skLcR.bq_run(eqs_xR); eqs_xL = eqs_skLdL.bq_run(eqs_xL); eqs_xR = eqs_skLdR.bq_run(eqs_xR); );
  );
  // op-amp headroom: transparent until a hot signal nears the rail
  eqs_xL = eqs_hr*eqs_xL*eqs_ihr/(1 + abs(eqs_xL*eqs_ihr)^4)^0.25; eqs_xR = eqs_hr*eqs_xR*eqs_ihr/(1 + abs(eqs_xR*eqs_ihr)^4)^0.25;
);
(ost_l = (eqs_xL*eqs_outg); ost_r = (eqs_xR*eqs_outg));
spl0 = ost_l; spl1 = ost_r;
eqs_a_ = max(abs(spl0), abs(spl1)); eqs_mOut = eqs_a_ > eqs_mOut ? eqs_a_ : eqs_mOut*0.9997;
0;
);

// ======================== gfx-fet-45.jsfx (prefix cpf_; its sliders 1-9 at 103-111) ========================
function cpf_defaults() (
  slider(103) = 0;
  slider(104) = 0;
  slider(105) = 0;
  slider(106) = 3;
  slider(107) = 7;
  slider(108) = 0;
  slider(109) = 1;
  slider(110) = 100;
  slider(111) = 0;
  0;
);
function cpf_consts() (
  cpf_own_s10 = 0;
  cpf_own_s11 = 1;
  cpf_own_s12 = 0;
  slider(111) = 0;
  0;
);
function cpf_alloc(n) local(p) ( p = cpf_nextmem; cpf_nextmem += n; memset(p, 0, n); p; );
function cpf_fd_i0(cpf_x) local(s, t, cpf_k) ( s = 1; t = 1; cpf_k = 1; loop(40, t *= sqr(cpf_x / (2 * cpf_k)); s += t; cpf_k += 1; ); s; );
function cpf_fd_conv(b) local(s, i, j) (
  s = 0; i = 0; j = 23;
  loop(12, s += cpf_fd_H[i] * (b[i] + b[j]); i += 1; j -= 1; );
  s;
);
function cpf_fd_q(u, cpf_k)  ( u <= -0.5 * cpf_k ? 0 : u >= 0.5 * cpf_k ? u : sqr(u + 0.5 * cpf_k) / (2 * cpf_k) );
function cpf_fd_qd(u, cpf_k) ( u <= -0.5 * cpf_k ? 0 : u >= 0.5 * cpf_k ? 1 : (u + 0.5 * cpf_k) / cpf_k );
function cpf_fd_C(u) local(cpf_c, d, cpf_ca, cpf_da) (
  cpf_c = cpf_fd_Rm1 * cpf_fd_q(u, cpf_fd_kn); d = cpf_fd_Rm1 * cpf_fd_qd(u, cpf_fd_kn);
  cpf_fd_wA > 0.0001 ? (
    cpf_ca = 39 * cpf_fd_q(u, 0.3) - 30 * cpf_fd_q(u - 0.25, 0.5);  // ALL: ~40:1 at first, bending over to ~12:1
    cpf_da = 39 * cpf_fd_qd(u, 0.3) - 30 * cpf_fd_qd(u - 0.25, 0.5);
    cpf_c += (cpf_ca - cpf_c) * cpf_fd_wA; d += (cpf_da - d) * cpf_fd_wA;
  );
  cpf_fd_cd = d;
  cpf_c;
);
function cpf_fd_det(cpf_lev, cpf_thr) instance(G, cpf_Gs, cpf_Gl, cpf_Ga, cpf_Hd) local(P, cpf_t0, cpf_Gn, cpf_c, h, cpf_fl) (
  P = 8.68588963807 * log(max(cpf_lev, 0.000001)) - cpf_thr;    // input over the threshold
  cpf_t0 = cpf_fd_C(P - G);
  cpf_t0 > G ? (
    // attack: implicit (zero-delay) step of the feedback loop, Gn = G + a (C(P - Gn) - Gn), by Newton
    cpf_Gn = G;
    loop(4,
      cpf_c = cpf_fd_C(P - cpf_Gn);
      h = cpf_Gn - G - cpf_fd_a * (cpf_c - cpf_Gn);
      cpf_Gn -= h / (1 + cpf_fd_a + cpf_fd_a * cpf_fd_cd);
      cpf_Gn = min(max(cpf_Gn, G), max(P, G) + 1);
    );
    G = cpf_Gn;
  ) : (
    // release: the fast stage falls towards the slow stage's memory, then both let go
    cpf_fl = cpf_fd_kap * cpf_Gs;
    G = G > cpf_fl ? cpf_fl + (G - cpf_fl) * cpf_fd_rf : G * cpf_fd_rs;
    G = max(G, cpf_t0);
  );
  // the slow stage charges only while the signal still holds the gain reduction (not while it is recovering)
  cpf_Hd = max(cpf_t0, cpf_Hd * cpf_fd_hd);                             // is the signal still there? (bridges the waveform's valleys)
  G > cpf_Gs && cpf_Hd > 0.85 * G ? cpf_Gs += (G - cpf_Gs) * cpf_fd_cs : cpf_Gs *= cpf_fd_rs;
  cpf_Gl += (G - cpf_Gl) * cpf_fd_cl;                               // ALL: the lagging copy for the overshoot
  G < 0.000001 ? G = 0; cpf_Gs < 0.000001 ? cpf_Gs = 0; cpf_Hd < 0.000001 ? cpf_Hd = 0; abs(cpf_Gl) < 0.000001 ? cpf_Gl = 0;
  cpf_Ga = max(G + cpf_fd_ov * (G - cpf_Gl), 0);
  cpf_Ga;
);
function cpf_fd_dcopy() instance(G, cpf_Gs, cpf_Gl, cpf_Ga, cpf_Hd) ( G = cpf_dL.G; cpf_Gs = cpf_dL.cpf_Gs; cpf_Gl = cpf_dL.cpf_Gl; cpf_Ga = cpf_dL.cpf_Ga; cpf_Hd = cpf_dL.cpf_Hd; );
function cpf_fd_nl(y, g) instance(cpf_e2, cpf_lo, cpf_e2l) local(v, s, cpf_s2, cpf_l2, cpf_gr1) (
  v = y * g; cpf_gr1 = 1 - g; cpf_gr1 *= cpf_gr1 * cpf_gr1;           // the FET's colour: next to nothing at light GR, grows fast with heavy GR
  s = v / sqrt(1 + v * v); cpf_s2 = s * s;                  // bounded copy for the distortion terms
  cpf_e2 += (cpf_s2 - cpf_e2) * cpf_fd_ce;                              // its running mean square (keeps the even terms DC-free)
  cpf_lo += (s - cpf_lo) * cpf_fd_clo; cpf_l2 = cpf_lo * cpf_lo; cpf_e2l += (cpf_l2 - cpf_e2l) * cpf_fd_ce;
  v += cpf_gr1 * (cpf_fd_cF * (cpf_s2 - cpf_e2) + cpf_fd_cFL * (cpf_l2 - cpf_e2l) - cpf_fd_c3 * s * cpf_s2);
  v *= cpf_fd_og;
  (ost_tanh(cpf_fd_ld * (v + cpf_fd_lb)) - cpf_fd_ltb) * cpf_fd_lnorm;   // class-A line amp: unity small-signal gain
);
function cpf_fd_xfm(cpf_x) instance(cpf_lo, cpf_dx, cpf_dy) local(y) (
  cpf_lo += (cpf_x - cpf_lo) * cpf_fd_cxf;
  cpf_x += cpf_lo / sqrt(1 + sqr(0.45 * cpf_lo)) - cpf_lo;
  y = cpf_x - cpf_dx + cpf_fd_dcr * cpf_dy; cpf_dx = cpf_x; cpf_dy = y;
  y;
);
function cpf_fd_flush() instance(G, cpf_Gs, cpf_Gl, cpf_e2, cpf_lo, cpf_e2l, cpf_dx, cpf_dy) (
  abs(cpf_e2) < 0.000000000001 ? cpf_e2 = 0; abs(cpf_lo) < 0.000000000001 ? cpf_lo = 0; abs(cpf_e2l) < 0.000000000001 ? cpf_e2l = 0;
  abs(cpf_dx) < 0.000000000001 ? cpf_dx = 0; abs(cpf_dy) < 0.000000000001 ? cpf_dy = 0;
);
function cpf_fd_update() local(cpf_rt, cpf_rs) (
  cpf_rt = slider(103) | 0;
  cpf_fd_tRm1 = cpf_rt == 0 ? 3 : cpf_rt == 1 ? 7 : cpf_rt == 2 ? 11 : 19;
  cpf_fd_tkn  = cpf_rt == 0 ? 3.2 : cpf_rt == 1 ? 1.3333 : cpf_rt == 2 ? 0.7692 : 0.381;   // knee width on the output side
  cpf_fd_twA  = cpf_rt == 4;
  cpf_fd_tin  = 10 ^ (slider(104) / 20);
  cpf_fd_tog  = 10 ^ (slider(105) / 20);
  cpf_fd_att  = 0.0008 * 0.025 ^ ((min(max(slider(106), 1), 7) - 1) / 6);           // 800 us (1) .. 20 us (7)
  cpf_fd_rel  = 1.1 * (0.05 / 1.1) ^ ((min(max(slider(107), 1), 7) - 1) / 6);      // 1.1 s (1) .. 50 ms (7)
  cpf_fd_mtr  = slider(108) | 0;
  cpf_fd_link = slider(109) >= 0.5;
  cpf_fd_tmix = slider(110) / 100;
  drift_macro(0);
  0;   // output stage: CLIP, always on
  cpf_own_pdc_bot = 0; cpf_own_pdc_top = 2;
  cpf_own_pdc_delay = cpf_fd_LAT;
  cpf_rs = (7 - min(max(slider(107), 1), 7)) / 6;               // 0 = fastest release .. 1 = slowest
  cpf_fd_smul = 2.5 - 0.9 * cpf_rs;                             // the slow stage: 2.5x the set time (fast) .. 1.6x (slow)
  cpf_fd_cF  = 0.07 * (1 + 2.6 * cpf_fd_twA);
  cpf_fd_cFL = 0.13 * (0.3 + 0.7 * cpf_rs) * (1 + cpf_fd_twA);
  cpf_fd_c3  = 0.6 * cpf_fd_twA;
);
function cpf_fd_set(r, i, o, a, l, cpf_m, cpf_k, cpf_x, d) (
  slider(103) = r; slider(104) = i; slider(105) = o; slider(106) = a; slider(107) = l; slider(108) = cpf_m; slider(109) = cpf_k; slider(110) = cpf_x; slider(111) = d;
  0;                                 // sliders 1-9
);
function cpf_load_preset(p) (
  p == 1  ? cpf_fd_set(0,   0,  0,   3, 7,   0, 1, 100, 50) :   // Init
  p == 2  ? cpf_fd_set(0,  14, -10,  4, 6,   0, 1, 100, 50) :   // Vocal Grab
  p == 3  ? cpf_fd_set(1,  12, -10,  2, 2.5, 0, 1, 100, 40) :   // Bass Even
  p == 4  ? cpf_fd_set(0,  16, -12,  1, 7,   0, 1, 100, 50) :   // Snare Crack
  p == 5  ? cpf_fd_set(4,  20, -15,  3, 7,   0, 1, 100, 60) :   // Room Smash (ALL)
  p == 6  ? cpf_fd_set(4,  18, -12,  4, 6,   0, 1,  35, 50) :   // Drum Bus Parallel
  p == 7  ? cpf_fd_set(1,  18, -13,  5, 3,   0, 1, 100, 50) :   // Guitar Sustain
  p == 8  ? cpf_fd_set(3,  10,  -6,  7, 5,   1, 1, 100, 30) :   // Broadcast Limit 20
  p == 9  ? cpf_fd_set(2,  14,  -9,  6, 4,   0, 1, 100, 85) :   // Ost Rundfunk
  p == 10 ? cpf_fd_set(0,  16, -11,  5, 6,   0, 1, 100, 30) :   // Tokio Vocal
  p == 11 ? cpf_fd_set(0,  14,  -9,  1, 6,   0, 1,  80, 50) :   // Kick Punch
  p == 12 ? cpf_fd_set(0,   2,  -5,  2, 3,   0, 1, 100, 40) :   // Gentle 4
  p == 13 ? (                                           // Reset all to defaults
    cpf_fd_set(0, 0, 0, 3, 7, 0, 1, 100, 50);
    cpf_own_s10 = 0; cpf_own_s11 = 1; 0;
  );
);
function cpf_fd_srinit() (
  cpf_fd_sr = srate;
  cpf_fd_sm  = 1 - exp(-1 / (0.02 * srate));                // knob smoothing
  cpf_fd_smr = 1 - exp(-1 / (0.03 * srate));                // ratio / mode glide
  cpf_fd_cs  = 1 - exp(-1 / (0.3 * srate));                 // slow release stage: charge
  cpf_fd_hd  = exp(-1 / (0.02 * srate));                    // signal-present hold, 20 ms
  cpf_fd_cl  = 1 - exp(-1 / (0.04 * srate));                // ALL: overshoot lag
  cpf_fd_ce  = 1 - exp(-1 / (0.01 * 2 * srate));            // (2x) mean-square tracker, 10 ms
  cpf_fd_clo = 1 - exp(-2 * $pi * 250 / (2 * srate));       // (2x) FET low-frequency weighting, 250 Hz
  cpf_fd_cxf = 1 - exp(-2 * $pi * 90 / srate);              // transformer low band, 90 Hz
  cpf_fd_dcr = 1 - 2 * $pi * 2 / srate;                     // DC blocker, 2 Hz
  cpf_fd_vdt = 1 / srate;
  0;                                       // the output stage again (resets it)
);
function cpf_init() (
#cpf_own_ui_man = "gfx-fet-45";                                // the ? pop-up links to this manual
cpf_own_ext_noinit = 1;

// ---------- memory ----------
cpf_nextmem = 1200000;

cpf_fd_H   = cpf_alloc(32);                                     // half-band odd taps
cpf_fd_xbL = cpf_alloc(64); cpf_fd_xbR = cpf_alloc(64);                 // input history (mirrored rings of 32)
cpf_fd_gbL = cpf_alloc(64); cpf_fd_gbR = cpf_alloc(64);                 // gain history (the detector runs ahead of the up-sampler)
cpf_fd_veL = cpf_alloc(64); cpf_fd_veR = cpf_alloc(64);                 // 2x even-phase output history
cpf_fd_voL = cpf_alloc(64); cpf_fd_voR = cpf_alloc(64);                 // 2x odd-phase output history
cpf_fd_rbL = cpf_alloc(64); cpf_fd_rbR = cpf_alloc(64);                 // dry history (for MIX)
0;                                  // the house output stage
cpf_fd_wp = 0;
cpf_fd_LAT = 23;                                            // total latency of the 2x stage, samples

// ---------- the half-band (47 taps, Kaiser beta 7): the 24 non-zero odd taps h[2i - 23], i = 0..23 ----------

cpf_fd_i = 0; cpf_fd_s = 0; cpf_fd_bk = 7; cpf_fd_ib = cpf_fd_i0(cpf_fd_bk);
loop(24,
  cpf_fd_k = 2 * cpf_fd_i - 23;
  cpf_fd_H[cpf_fd_i] = sin($pi * cpf_fd_k * 0.5) / ($pi * cpf_fd_k) * cpf_fd_i0(cpf_fd_bk * sqrt(max(1 - sqr(cpf_fd_k / 24), 0))) / cpf_fd_ib;
  cpf_fd_s += cpf_fd_H[cpf_fd_i]; cpf_fd_i += 1;
);
cpf_fd_i = 0; loop(24, cpf_fd_H[cpf_fd_i] *= 0.5 / cpf_fd_s; cpf_fd_i += 1; );   // the odd taps sum to exactly 0.5 (unity at DC)
// symmetric 24-tap convolution over a history pointer (b[0] = newest)


// ---------- the gain law (feedback domain: u = output level over the threshold, dB) ----------


// C(u): the gain reduction (dB) the loop settles on; its slope goes to fd_cd

// one detector: lev = the peak level into the FET (linear), thr = threshold (dBFS). Returns the applied GR (dB).



// ---------- the nonlinear stage, at 2x: FET gain element + its colour, OUTPUT, class-A line amp ----------
cpf_fd_ld = 0.3; cpf_fd_lb = 0.05;                              // line amp curve: drive, bias (clean until driven hot)
cpf_fd_ltb = ost_tanh(cpf_fd_ld * cpf_fd_lb); cpf_fd_lnorm = 1 / (cpf_fd_ld * (1 - cpf_fd_ltb * cpf_fd_ltb));

// output transformer (1x): low-frequency saturation, then a 2 Hz DC blocker



// ---------- settings ----------


// ---------- presets: ratio, input, output, attack, release, meter, link, mix, drift ----------



// ---------- state ----------
// everything that depends on the sample rate (run again from @block if the rate changes: ext_noinit keeps @init
// from running then)

cpf_fd_srinit();
cpf_fd_kap = 0.7;                                           // how much of the slow stage's memory holds the fast stage
cpf_fd_vw = 13.6; cpf_fd_vz = 0.81;                             // VU needle (as Meter 45): natural frequency, damping
cpf_fd_vw2 = cpf_fd_vw * cpf_fd_vw; cpf_fd_vzw = 2 * cpf_fd_vz * cpf_fd_vw;
cpf_fd_vref = 1.5707963 / 0.125892541;                      // rectified x pi/2, 0 VU = a sine peaking at -18 dBFS
cpf_drT.drift_init(0.8 + rand(0.4)); cpf_drR.drift_init(0.8 + rand(0.4));
cpf_drL.drift_init(0.8 + rand(0.5)); cpf_drM.drift_init(0.8 + rand(0.5));
cpf_drA.drift_init(0.9 + rand(0.5)); cpf_drB.drift_init(0.9 + rand(0.5));
cpf_fd_update();
cpf_fd_gin = cpf_fd_tin; cpf_fd_og = cpf_fd_tog; cpf_fd_mix = cpf_fd_tmix;
cpf_fd_Rm1 = cpf_fd_tRm1; cpf_fd_kn = cpf_fd_tkn; cpf_fd_wA = cpf_fd_twA;
cpf_fd_vy = cpf_fd_vv = 0; cpf_fda_grp = 0; cpf_fda_blk = 0;

cpf_own_ui_thm = 5; cpf_own_ui_hw = 1;                                  // house keycaps for the preset bar and size picker
!cpf_ui_dflt ? ( cpf_own_ui_sz = 2; cpf_pr_cur = 1; );                  // new instances open in Large, on Init
cpf_ui_dflt = 1;
0;
);

function cpf_slider() (
cpf_fd_update();
0;
);

function cpf_block() (
srate != cpf_fd_sr ? cpf_fd_srinit();
cpf_fd_update();                                            // knobs moved on the panel do not run @slider
// DRIFT: FET bias wander (threshold, release timing, channel tracking)
cpf_fd_di = 0.25 * cpf_own_dm_s * samplesblock / srate;
cpf_fd_thr = -12 + 0.5 * cpf_own_dm_a * cpf_drT.drift_tick(cpf_fd_di);
cpf_fd_tsl = cpf_fd_thr + 0.25 * cpf_own_dm_a * cpf_drA.drift_tick(cpf_fd_di);
cpf_fd_tsr = cpf_fd_thr + 0.25 * cpf_own_dm_a * cpf_drB.drift_tick(cpf_fd_di);
cpf_fd_drr = 1 + 0.08 * cpf_own_dm_a * cpf_drR.drift_tick(cpf_fd_di);
cpf_fd_mL = 0.015 * cpf_own_dm_a * cpf_drL.drift_tick(cpf_fd_di);
cpf_fd_mR = 0.015 * cpf_own_dm_a * cpf_drM.drift_tick(cpf_fd_di);
// timing coefficients (from the gliding ratio / mode)
cpf_fd_Rn = 1 + cpf_fd_Rm1 * (1 - cpf_fd_wA) + 39 * cpf_fd_wA;          // loop gain: the attack time stays the set time at any ratio
cpf_fd_a  = (exp(1 / (cpf_fd_att * (1 + 2 * cpf_fd_wA) * srate)) - 1) / cpf_fd_Rn;
cpf_fd_tr = cpf_fd_rel * (1 - 0.3 * cpf_fd_wA) * cpf_fd_drr;
cpf_fd_rf = exp(-1 / (cpf_fd_tr * srate));
cpf_fd_rs = exp(-1 / (cpf_fd_smul * cpf_fd_tr * srate));
cpf_fd_ov = 0.45 * cpf_fd_wA;
// denormal housekeeping
cpf_nL.cpf_fd_flush(); cpf_nR.cpf_fd_flush(); cpf_tL.cpf_fd_flush(); cpf_tR.cpf_fd_flush();
abs(cpf_fd_vy) + abs(cpf_fd_vv) < 0.000000001 ? cpf_fd_vy = cpf_fd_vv = 0;
// the meter's block values for the panel
cpf_fda_gr = cpf_fda_grp; cpf_fda_grp = 0;
cpf_fda_v = cpf_fd_vy;
cpf_fda_blk += 1;
0;
);

function cpf_sample() (
cpf_fd_il = spl0; cpf_fd_ir = spl1;
// ---------- glides ----------
cpf_fd_gin += (cpf_fd_tin - cpf_fd_gin) * cpf_fd_sm;
cpf_fd_og  += (cpf_fd_tog - cpf_fd_og) * cpf_fd_sm;
cpf_fd_mix += (cpf_fd_tmix - cpf_fd_mix) * cpf_fd_sm;
cpf_fd_Rm1 += (cpf_fd_tRm1 - cpf_fd_Rm1) * cpf_fd_smr;
cpf_fd_kn  += (cpf_fd_tkn - cpf_fd_kn) * cpf_fd_smr;
cpf_fd_wA  += (cpf_fd_twA - cpf_fd_wA) * cpf_fd_smr;
cpf_fd_wA < 0.00001 ? cpf_fd_wA = 0;

// ---------- INPUT and the detector ----------
cpf_fd_xl = cpf_fd_il * cpf_fd_gin; cpf_fd_xr = cpf_fd_ir * cpf_fd_gin;
cpf_fd_link ? (
  cpf_fd_G = cpf_dL.cpf_fd_det(max(abs(cpf_fd_xl), abs(cpf_fd_xr)), cpf_fd_thr);
  cpf_dR.cpf_fd_dcopy();
  cpf_fd_GL = cpf_fd_G * (1 + cpf_fd_mL); cpf_fd_GR = cpf_fd_G * (1 + cpf_fd_mR);
) : (
  cpf_fd_GL = cpf_dL.cpf_fd_det(abs(cpf_fd_xl), cpf_fd_tsl) * (1 + cpf_fd_mL);
  cpf_fd_GR = cpf_dR.cpf_fd_det(abs(cpf_fd_xr), cpf_fd_tsr) * (1 + cpf_fd_mR);
);
cpf_fd_kgl = exp(-0.115129255 * cpf_fd_GL); cpf_fd_kgr = exp(-0.115129255 * cpf_fd_GR);
cpf_fda_grp = max(cpf_fda_grp, max(cpf_fd_GL, cpf_fd_GR));

// ---------- 2x: up-sample, FET + line amp, down-sample ----------
cpf_fd_wp = (cpf_fd_wp + 31) & 31;
cpf_fd_xbL[cpf_fd_wp] = cpf_fd_xbL[cpf_fd_wp + 32] = cpf_fd_xl;  cpf_fd_xbR[cpf_fd_wp] = cpf_fd_xbR[cpf_fd_wp + 32] = cpf_fd_xr;
cpf_fd_gbL[cpf_fd_wp] = cpf_fd_gbL[cpf_fd_wp + 32] = cpf_fd_kgl;  cpf_fd_gbR[cpf_fd_wp] = cpf_fd_gbR[cpf_fd_wp + 32] = cpf_fd_kgr;
cpf_fd_rbL[cpf_fd_wp] = cpf_fd_rbL[cpf_fd_wp + 32] = cpf_fd_il;  cpf_fd_rbR[cpf_fd_wp] = cpf_fd_rbR[cpf_fd_wp + 32] = cpf_fd_ir;
// left
cpf_fd_v = cpf_nL.cpf_fd_nl(2 * cpf_fd_conv(cpf_fd_xbL + cpf_fd_wp), 0.5 * (cpf_fd_gbL[cpf_fd_wp + 11] + cpf_fd_gbL[cpf_fd_wp + 12]));
cpf_fd_veL[cpf_fd_wp] = cpf_fd_veL[cpf_fd_wp + 32] = cpf_fd_v;
cpf_fd_v = cpf_nL.cpf_fd_nl(cpf_fd_xbL[cpf_fd_wp + 11], cpf_fd_gbL[cpf_fd_wp + 11]);
cpf_fd_voL[cpf_fd_wp] = cpf_fd_voL[cpf_fd_wp + 32] = cpf_fd_v;
cpf_fd_ol = cpf_tL.cpf_fd_xfm(0.5 * cpf_fd_voL[cpf_fd_wp + 12] + cpf_fd_conv(cpf_fd_veL + cpf_fd_wp));
// right
cpf_fd_v = cpf_nR.cpf_fd_nl(2 * cpf_fd_conv(cpf_fd_xbR + cpf_fd_wp), 0.5 * (cpf_fd_gbR[cpf_fd_wp + 11] + cpf_fd_gbR[cpf_fd_wp + 12]));
cpf_fd_veR[cpf_fd_wp] = cpf_fd_veR[cpf_fd_wp + 32] = cpf_fd_v;
cpf_fd_v = cpf_nR.cpf_fd_nl(cpf_fd_xbR[cpf_fd_wp + 11], cpf_fd_gbR[cpf_fd_wp + 11]);
cpf_fd_voR[cpf_fd_wp] = cpf_fd_voR[cpf_fd_wp + 32] = cpf_fd_v;
cpf_fd_or = cpf_tR.cpf_fd_xfm(0.5 * cpf_fd_voR[cpf_fd_wp + 12] + cpf_fd_conv(cpf_fd_veR + cpf_fd_wp));

// ---------- MIX (dry delayed to match) and the house output stage ----------
cpf_fd_dl = cpf_fd_rbL[cpf_fd_wp + cpf_fd_LAT]; cpf_fd_dr = cpf_fd_rbR[cpf_fd_wp + cpf_fd_LAT];
(ost_l = (cpf_fd_dl + (cpf_fd_ol - cpf_fd_dl) * cpf_fd_mix); ost_r = (cpf_fd_dr + (cpf_fd_or - cpf_fd_dr) * cpf_fd_mix));
spl0 = ost_l; spl1 = ost_r;

// ---------- the meter's needle (mass + spring + damping, as Meter 45) ----------
cpf_fd_md = cpf_fd_mtr == 0 ? 0.5 * (cpf_fd_kgl + cpf_fd_kgr) :
        cpf_fd_mtr == 1 ? max(abs(spl0), abs(spl1)) * cpf_fd_vref :
        cpf_fd_mtr == 2 ? max(abs(cpf_fd_xl), abs(cpf_fd_xr)) * cpf_fd_vref : 0;   // IN: after INPUT (what drives the FET)
cpf_fd_vv += (cpf_fd_vw2 * (cpf_fd_md - cpf_fd_vy) - cpf_fd_vzw * cpf_fd_vv) * cpf_fd_vdt; cpf_fd_vy += cpf_fd_vv * cpf_fd_vdt;
0;
);

// ======================== gfx-ob-q.jsfx (prefix cpo_; its sliders 1-15 at 112-126) ========================
function cpo_defaults() (
  slider(112) = 1;
  slider(113) = -18;
  slider(114) = 3;
  slider(115) = 3;
  slider(116) = 250;
  slider(117) = 0;
  slider(118) = 0;
  slider(119) = 0;
  slider(120) = -50;
  slider(121) = 20;
  slider(122) = 200;
  slider(123) = 1;
  slider(124) = 1;
  slider(125) = 1;
  slider(126) = 100;
  0;
);
function cpo_consts() (
  cpo_own_s16 = 0;
  cpo_own_s17 = 0;
  cpo_own_s18 = 0;
  cpo_own_s19 = 30;
  cpo_own_s20 = 120;
  cpo_own_s21 = 6000;
  cpo_own_s22 = -0.3;
  cpo_own_s23 = 1;
  cpo_own_s24 = 20;
  cpo_own_s25 = 22000;
  cpo_own_s26 = 0;
  cpo_own_s27 = 100;
  cpo_own_s28 = 0;
  cpo_own_s29 = 0;
  cpo_own_s30 = 600;
  cpo_own_s31 = 1;
  cpo_own_s32 = 0;
  cpo_own_s33 = 2500;
  cpo_own_s34 = 1;
  cpo_own_s35 = 0;
  cpo_own_s36 = 8000;
  cpo_own_s37 = 0;
  cpo_own_s38 = 0;
  cpo_own_s39 = 1;
  cpo_own_s40 = 0;
  cpo_own_s41 = 0;
  cpo_own_s42 = 0;
  slider(119) = 0;
  0;
);
function cpo_ch_det(cpo_x) instance(cpo_ms, cpo_gms) (
  cpo_ms += (cpo_x * cpo_x - cpo_ms) * cpo_det_c;                       // compressor: quick RMS (~2 ms)
  cpo_gms += (cpo_x * cpo_x - cpo_gms) * cpo_gdet_c;                    // gate: a little slower, so it does not chatter
  10 * log10(cpo_ms + 0.0000000001) + 3;
);
function cpo_ch_glv() instance(cpo_gms) ( 10 * log10(cpo_gms + 0.0000000001) + 3 );
function cpo_ch_gate(cpo_lv) instance(cpo_ge) local(cpo_t, cpo_o) (
  cpo_g_on && cpo_gthr > -79.9 ? (
    cpo_o = cpo_lv - cpo_gthr;
    cpo_t = cpo_gmode ? max(min(cpo_o, 0), -cpo_grange) : (cpo_o < 0 ? -cpo_grange : 0);
    cpo_ge += (cpo_t - cpo_ge) * (cpo_t > cpo_ge ? cpo_gatt_c : cpo_grel_c);
  ) : cpo_ge = 0;
  cpo_ge;
);
function cpo_ch_comp(cpo_lv) instance(cpo_e) local(cpo_t) (
  cpo_c_on ? (
    cpo_t = -(1 - cpo_sl) * dy_curve(cpo_lv - cpo_thr, 3);
    cpo_e += (cpo_t - cpo_e) * (cpo_t < cpo_e ? cpo_ac : cpo_rc);
  ) : cpo_e = 0;
  cpo_e;
);
function cpo_ch_lim(cpo_x) instance(cpo_lg) local(cpo_t) (
  cpo_t = cpo_l_on && abs(cpo_x) > cpo_ltg ? cpo_ltg / abs(cpo_x) : 1;
  cpo_lg = cpo_t < cpo_lg ? cpo_t : cpo_lg + (1 - cpo_lg) * cpo_lim_r;
  cpo_lg;
);
function cpo_xf(cpo_x) instance(cpo_lo, cpo_hi) local(cpo_s) (
  cpo_lo += (cpo_x - cpo_lo) * cpo_xf_lc;
  cpo_s = cpo_lo * 1.6; cpo_s = cpo_s / (1 + abs(cpo_s) * 0.22) / 1.6;  // soft, level-dependent squash of the lows
  cpo_x = cpo_x - cpo_lo + cpo_s * 1.03;
  cpo_hi += (cpo_x - cpo_hi) * cpo_xf_hc;
  cpo_hi;
);
function cpo_update() (
  cpo_c_on = slider(112); cpo_thr = slider(113); cpo_sl = slider(114) >= 19.95 ? 0 : 1 / slider(114);
  cpo_ac = dy_ms(slider(115)); cpo_rc = dy_ms(slider(116)); cpo_mk = 10 ^ (slider(117) / 20);
  cpo_l_on = slider(118) < -0.05; cpo_ltg = 10 ^ (slider(118) / 20);
  cpo_g_on = slider(119); cpo_gthr = slider(120); cpo_grange = slider(121); cpo_grel_c = dy_ms(slider(122)); cpo_gmode = slider(123);
  cpo_xfm = slider(124); cpo_lnk = slider(125); cpo_mix_t = slider(126) / 100;
  0;
  0;   // output stage: straight through
);
function cpo_pg(cpo_on, cpo_t, cpo_r, cpo_rl, cpo_md) ( slider(119) = cpo_on; slider(120) = cpo_t; slider(121) = cpo_r; slider(122) = cpo_rl; slider(123) = cpo_md; );
function cpo_pc(cpo_on, cpo_t, cpo_r, a, cpo_rl, cpo_g, cpo_lm, cpo_xm, cpo_lk, cpo_mx) (
  slider(112) = cpo_on; slider(113) = cpo_t; slider(114) = cpo_r; slider(115) = a; slider(116) = cpo_rl; slider(117) = cpo_g; slider(118) = cpo_lm;
  slider(124) = cpo_xm; slider(125) = cpo_lk; slider(126) = cpo_mx;
);
function cpo_load_preset(cpo_p) (
  cpo_p == 1  ? ( cpo_pg(0, -50, 20, 200, 1); cpo_pc(1, -20, 2.5, 5, 300, 3, 0, 1, 1, 100); ) :      // Desk Glue
  cpo_p == 2  ? ( cpo_pg(1, -55, 12, 250, 1); cpo_pc(1, -26, 4, 2, 150, 6, -2, 1, 1, 100); ) :      // Presenter Voice
  cpo_p == 3  ? ( cpo_pg(1, -45, 40, 120, 0); cpo_pc(1, -22, 5, 1, 120, 5, -1, 1, 1, 100); ) :      // Tight Drums (gated)
  cpo_p == 4  ? ( cpo_pg(1, -40, 60, 80, 0);  cpo_pc(1, -24, 4, 0.5, 100, 4, 0, 1, 0, 100); ) :     // Kick / Snare Gate
  cpo_p == 5  ? ( cpo_pg(0, -50, 20, 200, 1); cpo_pc(1, -30, 8, 0.3, 80, 10, -3, 1, 1, 45); ) :     // Parallel Squash
  cpo_p == 6  ? ( cpo_pg(0, -50, 20, 200, 1); cpo_pc(1, -14, 20, 0.1, 50, 2, -1, 1, 1, 100); ) :    // Transmitter Limit
  cpo_p == 7  ? ( cpo_pg(1, -60, 10, 400, 1); cpo_pc(1, -20, 3, 10, 400, 3, 0, 1, 1, 100); ) :      // Acoustic Clean-up
  cpo_p == 8  ? ( cpo_pg(0, -50, 20, 200, 1); cpo_pc(1, -24, 4, 8, 250, 4, 0, 1, 1, 100); ) :       // Bass DI
  cpo_p == 9  ? ( cpo_pg(0, -50, 20, 200, 1); cpo_pc(0, -18, 3, 3, 250, 0, 0, 1, 1, 100); ) :       // Transformer Only
  cpo_p == 10 ? ( cpo_pg(1, -50, 15, 300, 1); cpo_pc(1, -16, 2, 20, 600, 2, -1, 1, 1, 100); );      // Gentle Programme Bus
  cpo_p >= 1 && cpo_p <= 10 ? 0;       // sliders 1-15
  cpo_p == 11 ? (                                       // Reset all to defaults
    cpo_pg(0, -50, 20, 200, 1); cpo_pc(1, -18, 3, 3, 250, 0, 0, 1, 1, 100);
    cpo_own_s16 = 0; cpo_own_s17 = 1; cpo_own_s18 = 0; cpo_own_s19 = 30; cpo_own_s20 = 120; cpo_own_s21 = 6000; cpo_own_s22 = -0.3; cpo_own_s23 = 1;
    0;                       // sliders 1-23
  );
);
function cpo_cb_auto(cpo_m, cpo_off) local(cpo_k) ( cpo_k = 1; loop(63, cpo_m - 2 * floor(cpo_m / 2) ? ui_auto(111 + cpo_k + cpo_off); cpo_m = floor(cpo_m / 2); cpo_k += 1; ); );
function cpo_th(cpo_x) ( cpo_x = min(max(cpo_x, -3), 3); cpo_x * (27 + cpo_x * cpo_x) / (27 + 9 * cpo_x * cpo_x); );
function cpo_q_hp1(cpo_x) instance(x1, y1) ( y1 = cpo_q_hp1_a * (cpo_x - x1) + cpo_q_hp1_b * y1; x1 = cpo_x; y1; );
function cpo_q_hp1set(cpo_f) local(cpo_k) ( cpo_k = tan($pi * min(cpo_f, srate * 0.45) / srate); cpo_q_hp1_a = 1 / (1 + cpo_k); cpo_q_hp1_b = (1 - cpo_k) / (1 + cpo_k); );
function cpo_q_hp1db(cpo_f) local(cpo_w, cpo_q_wc) ( cpo_q_wc = cpo_own_s24; cpo_w = cpo_f / cpo_q_wc; 10 * log10(cpo_w * cpo_w / (1 + cpo_w * cpo_w)); );
function cpo_q_chain(cpo_x) instance() local(cpo_y) (
  cpo_q_hp_on ? cpo_x = this.cpo_h1.cpo_q_hp1(this.cpo_h2.bq_run(cpo_x));
  cpo_q_eq_on ? (
    cpo_x = this.cpo_lf.bq_run(cpo_x); cpo_q_lfx ? cpo_x = this.cpo_lx.bq_run(cpo_x);
    cpo_x = this.cpo_lm.bq_run(cpo_x); cpo_x = this.cpo_hm.bq_run(cpo_x);
    cpo_x = this.cpo_hf.bq_run(cpo_x); cpo_q_hfx ? cpo_x = this.cpo_hx.bq_run(cpo_x);
  );
  cpo_y = this.cpo_lp.bq_run(cpo_x);                     // the LPF always runs (primed) and is faded in / out, never switched
  cpo_q_bd_lpw >= 1 ? cpo_x = cpo_y : cpo_q_bd_lpw > 0 ? cpo_x += (cpo_y - cpo_x) * cpo_q_bd_lpw;
  cpo_x;
);
function cpo_q_setch() instance() local(cpo_q) (
  cpo_q_hp_on ? this.cpo_h2.bq_set(1, cpo_own_s24, 1, 0);
  this.cpo_lp.bq_set(0, cpo_q_bd_lpf, 0.707, 0);     // q_bd_lpf: the LPF frequency, glided in q_proc
  // proportional Q on the black card
  this.cpo_lf.bq_set(cpo_own_s28 ? 2 : 4, cpo_own_s27, cpo_own_s28 ? (cpo_q_blk ? 0.6 + abs(cpo_own_s26) / 15 * 0.9 : 0.55) : (cpo_q_blk ? 1.15 : 0.6), cpo_own_s26);
  this.cpo_lm.bq_set(2, cpo_own_s30, cpo_own_s31 * (cpo_q_blk ? 0.6 + abs(cpo_own_s29) / 15 * 1.2 : 0.7), cpo_own_s29);
  this.cpo_hm.bq_set(2, cpo_own_s33, cpo_own_s34 * (cpo_q_blk ? 0.6 + abs(cpo_own_s32) / 15 * 1.2 : 0.7), cpo_own_s32);
  this.cpo_hf.bq_set(cpo_own_s37 ? 2 : 3, cpo_own_s36, cpo_own_s37 ? (cpo_q_blk ? 0.6 + abs(cpo_own_s35) / 15 * 0.9 : 0.55) : (cpo_q_blk ? 1.15 : 0.6), cpo_own_s35);
  // the black card's shelves: a small opposite dip just inside the corner
  cpo_q_lfx ? this.cpo_lx.bq_set(2, cpo_own_s27 * 2.2, 1.2, -cpo_own_s26 * 0.12);
  cpo_q_hfx ? this.cpo_hx.bq_set(2, cpo_own_s36 * 0.45, 1.2, -cpo_own_s35 * 0.12);
);
function cpo_q_update() local(b, cpo_q_cs) (
  cpo_q_cs = 0; b = 1; loop(18, cpo_q_cs += slider(111 + (b) + 23) * (b * 7.31 + 1); b += 1; );
  cpo_q_cs != cpo_q_last_cs ? ( cpo_q_redraw = 1; cpo_q_last_cs = cpo_q_cs; );
  cpo_q_hp_on = cpo_own_s24 > 20.5; cpo_q_lp_on = cpo_own_s25 < 21990; cpo_q_eq_on = cpo_own_s38; cpo_q_blk = cpo_own_s39;
  cpo_q_lfx = cpo_q_blk && !cpo_own_s28; cpo_q_hfx = cpo_q_blk && !cpo_own_s37;
  cpo_q_hp1set(cpo_own_s24);
  cpo_q_CL.cpo_q_setch(); cpo_q_CR.cpo_q_setch();
  cpo_q_drv = cpo_own_s40 / 100; cpo_q_dk = 1 + cpo_q_drv * 3; cpo_q_dbias = cpo_q_drv * 0.15; cpo_q_dtb = cpo_th(cpo_q_dbias);
  cpo_q_og = 10 ^ (cpo_own_s41 / 20);
  
     // no GFX output stage on this unit: its own character does that job
);
function cpo_q_pq(cpo_hp, cpo_lp, cpo_lg, cpo_lf, cpo_q_lb, cpo_q_mg, cpo_q_mf, cpo_q_mq, cpo_q_hg, cpo_q_hf_, cpo_q_hq, cpo_q_fg, cpo_q_ff, cpo_fb, cpo_q_vo, cpo_q_dr) (
  cpo_own_s24 = cpo_hp; cpo_own_s25 = cpo_lp; cpo_own_s26 = cpo_lg; cpo_own_s27 = cpo_lf; cpo_own_s28 = cpo_q_lb; cpo_own_s29 = cpo_q_mg; cpo_own_s30 = cpo_q_mf; cpo_own_s31 = cpo_q_mq;
  cpo_own_s32 = cpo_q_hg; cpo_own_s33 = cpo_q_hf_; cpo_own_s34 = cpo_q_hq; cpo_own_s35 = cpo_q_fg; cpo_own_s36 = cpo_q_ff; cpo_own_s37 = cpo_fb; cpo_own_s38 = 1; cpo_own_s39 = cpo_q_vo; cpo_own_s40 = cpo_q_dr; cpo_own_s41 = 0;
);
function cpo_q_load_preset(cpo_p) (
  cpo_p == 1  ? cpo_q_pq(90, 22000, -2, 200, 1, -3, 350, 1.2, 4, 3500, 1.2, 3, 12000, 0, 1, 10) :      // Vocal Presence
  cpo_p == 2  ? cpo_q_pq(30, 22000, 5, 60, 1, -5, 380, 1.5, 3, 3000, 1.5, 0, 8000, 0, 1, 15) :         // Kick Punch
  cpo_p == 3  ? cpo_q_pq(80, 22000, 2, 200, 1, -2, 500, 1.2, 4, 5000, 1.4, 3, 10000, 0, 1, 20) :       // Snare Crack
  cpo_p == 4  ? cpo_q_pq(30, 9000, 4, 80, 0, -3, 250, 1.2, 2, 1200, 1.0, 0, 8000, 0, 0, 25) :          // Bass Weight
  cpo_p == 5  ? cpo_q_pq(70, 22000, -2, 150, 0, -2, 300, 1.0, 2, 4000, 0.8, 4, 12000, 0, 0, 0) :       // Acoustic Sparkle
  cpo_p == 6  ? cpo_q_pq(25, 22000, 1.5, 60, 0, 0, 600, 1, -1, 3000, 0.8, 2, 14000, 0, 0, 10) :        // Mix Bus Air
  cpo_p == 7  ? cpo_q_pq(400, 3500, 0, 100, 0, 6, 1500, 1.5, 0, 2500, 1, 0, 8000, 0, 1, 60) :          // Telephone
  cpo_p == 8  ? cpo_q_pq(60, 22000, 0, 100, 0, -5, 300, 1.0, 0, 2500, 1, 1, 10000, 0, 1, 0) :          // De-mud
  cpo_p == 9  ? cpo_q_pq(40, 16000, 3, 120, 0, 1, 800, 0.7, 1, 3000, 0.7, 2, 9000, 0, 0, 40) :         // Brown Warmth
  cpo_p == 10 ? cpo_q_pq(100, 22000, 0, 100, 0, 0, 600, 1, -4, 6500, 2.5, 2, 15000, 0, 1, 0);          // De-harsh
  cpo_p >= 1 && cpo_p <= 10 ? cpo_cb_auto(262143, 23);     // sliders 1-18
  cpo_p == 11 ? (                                       // Reset all to defaults
    cpo_q_pq(20, 22000, 0, 100, 0, 0, 600, 1, 0, 2500, 1, 0, 8000, 0, 1, 0);
    cpo_own_s16 = 0; cpo_own_s17 = 1; cpo_own_s18 = 0; cpo_own_s19 = 30; cpo_own_s20 = 120; cpo_own_s21 = 6000; cpo_own_s22 = -0.3; cpo_own_s23 = 1;
    cpo_cb_auto(67108863, 23);
  );
);
function cpo_q_proc(cpo_cb_inl, cpo_cb_inr) (
  cpo_q_bd_lpw = cpo_q_lp_on ? min(cpo_q_bd_lpw + cpo_q_bd_lpxs, 1) : max(cpo_q_bd_lpw - cpo_q_bd_lpxs, 0);
  cpo_q_bd_lpt = min(cpo_own_s25, srate * 0.45);
  cpo_q_bd_lpf != cpo_q_bd_lpt ? ( (cpo_q_bd_lpn += 1) >= 16 ? ( cpo_q_bd_lpn = 0; cpo_q_bd_lpf *= (cpo_q_bd_lpt / cpo_q_bd_lpf) ^ cpo_q_bd_lpk; abs(cpo_q_bd_lpf - cpo_q_bd_lpt) < 0.0005 * cpo_q_bd_lpt ? cpo_q_bd_lpf = cpo_q_bd_lpt;
    cpo_q_CL.cpo_lp.bq_set(0, cpo_q_bd_lpf, 0.707, 0); cpo_q_CR.cpo_lp.bq_set(0, cpo_q_bd_lpf, 0.707, 0); ); );
  cpo_q_xl = cpo_q_CL.cpo_q_chain(cpo_cb_inl); cpo_q_xr = cpo_q_CR.cpo_q_chain(cpo_cb_inr);
  cpo_q_drv > 0.001 ? (
    cpo_q_xl = (cpo_th(cpo_q_dk * cpo_q_xl + cpo_q_dbias) - cpo_q_dtb) / (cpo_q_dk * (1 - cpo_q_dtb * cpo_q_dtb));
    cpo_q_xr = (cpo_th(cpo_q_dk * cpo_q_xr + cpo_q_dbias) - cpo_q_dtb) / (cpo_q_dk * (1 - cpo_q_dtb * cpo_q_dtb));
  );
  cpo_q_xl *= cpo_q_og; cpo_q_xr *= cpo_q_og;
  cpo_q_oL = (cpo_q_xl); cpo_q_oR = (cpo_q_xr);
  cpo_q_pkO = max(cpo_q_pkO, max(abs(cpo_q_oL), abs(cpo_q_oR)));
  cpo_q_out_l = cpo_q_oL; cpo_q_out_r = cpo_q_oR;
);
function cpo_init() (
#cpo_own_ui_man = "gfx-ob-q";                                       // the ? pop-up links to this manual

// one channel's detectors + gains (dB domain)





// output transformer: the lows saturate gently with level, the extreme top softens




// ---------- presets (leave INPUT and OUTPUT alone) ----------
// gate: in, threshold, range, release, mode; compressor: in, threshold, ratio, attack, release, gain; limit; xfmr; link; mix




0;
0; 0; 0;
cpo_det_c = 1 - exp(-1 / (0.002 * srate));
cpo_gdet_c = 1 - exp(-1 / (0.006 * srate));
cpo_gatt_c = 1 - exp(-1 / (0.0005 * srate));           // gate opens in 0.5 ms
cpo_lim_r = 1 - exp(-1 / (0.05 * srate));
cpo_xf_lc = 1 - exp(-2 * $pi * 120 / srate);
cpo_xf_hc = 1 - exp(-2 * $pi * min(24000, srate * 0.45) / srate);
cpo_sm = 1 - exp(-1 / (0.03 * srate));
cpo_L.cpo_lg = 1; cpo_R.cpo_lg = 1;
!cpo_ui_dflt ? cpo_own_ui_thm = 5; !cpo_ui_dflt ? cpo_own_ui_hw = 1;                              // fixed faceplate
cpo_PNL = 0x2C2C2E; cpo_INKC = 0xEDE6D8; cpo_BRN = 0x5C3A22; cpo_BRNL = 0x7A4E2E; cpo_ORG = 0xE8782A; cpo_YEL = 0xF0C030;
cpo_update();
cpo_mix_s = cpo_mix_t;


// ================= EQ (the Board EQ engine, names q_..., sliders 24 - 41) =================
// a preset mask of the EQ unit, one slider at a time

#cpo_own_ui_man = "gfx-ob-q";                                       // the ? pop-up links to this manual


// one-pole high-pass (the third pole of the 18 dB HPF)




// one channel's chain






// ---------- presets (leave INPUT and OUTPUT alone) ----------




  
 cpo_q_RSP = 30000;
cpo_q_PNL = 0xB4B8BA; cpo_q_PRT = 0x1C1E21; cpo_q_SCR = 0x121517; cpo_q_CRED = 0xC8322A; cpo_q_CGRN = 0x2E8A4A; cpo_q_CBLU = 0x2C5FA8; cpo_q_CBRN = 0x6A4A32; cpo_q_CGRY = 0xE4E4E0; cpo_q_CBLK = 0x26272A; cpo_q_SLB = 0x3BA9E0; cpo_SDB = 0x34349A; cpo_q_SRD = 0xE0262B;
cpo_q_bd_lpf = min(cpo_own_s25, srate * 0.45); cpo_q_bd_lpk = 1 - exp(-16 / (0.02 * srate)); cpo_q_bd_lpn = 0;   // LPF glide (~20 ms)
cpo_q_update();
cpo_q_bd_lpw = cpo_q_lp_on; cpo_q_bd_lpxs = 1 / (0.02 * srate);   // LPF on / off fade: 20 ms



cpo_q_ord = cpo_own_s42;
cpo_ui_dflt = 1;   // theme defaults above apply once: @init re-runs (playback start, device reset) must not undo the saved theme
0;
);

function cpo_slider() (
cpo_q_update();
cpo_q_ord = cpo_own_s42;
cpo_update();
0;
);

function cpo_block() (
cpo_q_update();
cpo_q_ord = cpo_own_s42;
cpo_update();
0;
);

function cpo_sample() (
(in_l = (spl0); in_r = (spl1); in_comp = 1);
!cpo_q_ord ? ( cpo_q_proc(in_l, in_r); in_l = cpo_q_out_l; in_r = cpo_q_out_r; );   // EQ first
cpo_dl = in_l; cpo_dr = in_r;
// gate (on the input)
cpo_gvL = (cpo_L.cpo_ch_det(cpo_dl); cpo_L.cpo_ch_glv()); cpo_gvR = (cpo_R.cpo_ch_det(cpo_dr); cpo_R.cpo_ch_glv());
cpo_lnk ? ( cpo_gvL = cpo_gvR = max(cpo_gvL, cpo_gvR); );
cpo_gL = cpo_L.cpo_ch_gate(cpo_gvL); cpo_gR = cpo_R.cpo_ch_gate(cpo_gvR);
cpo_xl = cpo_dl * 10 ^ (cpo_gL / 20); cpo_xr = cpo_dr * 10 ^ (cpo_gR / 20);
// compressor (its detector hears the gated signal)
cpo_cvL = 10 * log10(cpo_L.cpo_ms * 10 ^ (cpo_gL / 10) + 0.0000000001) + 3; cpo_cvR = 10 * log10(cpo_R.cpo_ms * 10 ^ (cpo_gR / 10) + 0.0000000001) + 3;
cpo_lnk ? ( cpo_cvL = cpo_cvR = max(cpo_cvL, cpo_cvR); );
cpo_eL = cpo_L.cpo_ch_comp(cpo_cvL); cpo_eR = cpo_R.cpo_ch_comp(cpo_cvR);
cpo_yl = cpo_xl * 10 ^ (cpo_eL / 20) * (cpo_c_on ? cpo_mk : 1); cpo_yr = cpo_xr * 10 ^ (cpo_eR / 20) * (cpo_c_on ? cpo_mk : 1);
// limiter
cpo_lL = cpo_L.cpo_ch_lim(cpo_yl); cpo_lR = cpo_R.cpo_ch_lim(cpo_yr);
cpo_lnk ? ( cpo_lL = cpo_lR = min(cpo_lL, cpo_lR); );
cpo_yl *= cpo_lL; cpo_yr *= cpo_lR;
// transformer
cpo_xfm ? ( cpo_yl = cpo_TL.cpo_xf(cpo_yl); cpo_yr = cpo_TR.cpo_xf(cpo_yr); );
cpo_grm = min(cpo_grm, min(cpo_eL, cpo_eR) + 20 * log10(min(cpo_lL, cpo_lR)));
cpo_gtm = min(cpo_gtm, min(cpo_gL, cpo_gR));
cpo_limm = max(cpo_limm, min(cpo_lL, cpo_lR) < 0.999);
// mix + output stage
cpo_mix_s += (cpo_mix_t - cpo_mix_s) * cpo_sm;
cpo_oL = cpo_dl + (cpo_yl - cpo_dl) * cpo_mix_s; cpo_oR = cpo_dr + (cpo_yr - cpo_dr) * cpo_mix_s;
cpo_q_ord ? ( cpo_q_proc(cpo_oL, cpo_oR); cpo_oL = cpo_q_out_l; cpo_oR = cpo_q_out_r; );   // EQ after
cpo_oL = (cpo_oL * in_comp); cpo_oR = (cpo_oR * in_comp);
(ost_l = (cpo_oL); ost_r = (cpo_oR));
spl0 = ost_l; spl1 = ost_r;
cpo_pkI = max(cpo_pkI, max(abs(cpo_dl), abs(cpo_dr)));
cpo_pkO = max(cpo_pkO, max(abs(spl0), abs(spl1)));
0;
);

// ======================== gfx-smooth.jsfx (prefix cps_; its sliders 1-6 at 127-132) ========================
function cps_defaults() (
  slider(127) = 3;
  slider(128) = 0;
  slider(129) = 1;
  slider(130) = 1;
  slider(131) = 0;
  slider(132) = 100;
  0;
);
function cps_consts() (
  cps_own_s7 = 0;
  cps_own_s8 = 0;
  cps_own_s9 = 0;
  cps_own_s10 = 0.25;
  cps_own_s11 = 0;
  cps_own_s12 = 30;
  cps_own_s13 = 120;
  cps_own_s14 = 6000;
  cps_own_s15 = -0.3;
  cps_own_s16 = 1;
  cps_own_s17 = 0;
  0;
);
function cps_hp_set(f) instance(b0, b1, b2, a1, a2) local(cps_w0, cps_cw, cps_al, n) (
  cps_w0 = 2 * $pi * f / srate; cps_cw = cos(cps_w0); cps_al = sin(cps_w0) / (2 * 0.70710678); n = 1 + cps_al;
  b0 = (1 + cps_cw) * 0.5 / n; b1 = -(1 + cps_cw) / n; b2 = b0; a1 = -2 * cps_cw / n; a2 = (1 - cps_al) / n;
);
function cps_sm_bq_unused(cps_x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * cps_x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = cps_x; y2 = y1; y1 = y;
  y;
);
function cps_tc(cps_ms) ( 1 - exp(-1 / (max(cps_ms, 0.05) * 0.001 * srate)); );
function cps_gr_curve(cps_lv) local(cps_o) (
  cps_o = cps_lv - cps_thr;
  cps_o <= -cps_kn * 0.5 ? 0 :
  cps_o >= cps_kn * 0.5 ? cps_o * (1 - 1 / cps_ratio) :
  (1 - 1 / cps_ratio) * (cps_o + cps_kn * 0.5) ^ 2 / (2 * cps_kn);
);
function cps_colour(cps_x, cps_k, b) local(cps_tb) (
  cps_tb = ost_tanh(b);
  (ost_tanh(cps_k * cps_x + b) - cps_tb) / (cps_k * (1 - cps_tb * cps_tb));
);
function cps_update() (
  cps_thr = -slider(127) * 3;
  cps_out_t = 10 ^ (slider(128) / 20);
  cps_lim = slider(131);
  cps_ratio = cps_lim ? 20 : 3; cps_kn = cps_lim ? 2 : 12;
  cps_att_ms = (slider(129) == 0 ? 25 : slider(129) == 1 ? 8 : 1.5) * (cps_lim ? 0.5 : 1);
  cps_rel_ms = slider(130) == 0 ? 900 : slider(130) == 1 ? 350 : 90;
  cps_catt = cps_tc(cps_att_ms);
  cps_blend_t = slider(132) / 100;
  drift_macro(0);                 // DRIFT dial: 50% = the drift settings, 100% = twice, 0 = none
  cps_drift = cps_own_s9 / 100 * cps_own_dm_a; cps_dspd = cps_own_s10 * cps_own_dm_s;
  0;
  0;   // output stage: straight through
);
function cps_init() (
#cps_own_ui_man = "gfx-smooth";                                  // the ? pop-up links to this manual





// static curve with soft knee: gain reduction (dB, positive) for a level (dB)


// colour stage: asymmetric tanh, small-signal gain 1




cps_scL.cps_hp_set(80); cps_scR.cps_hp_set(80);
cps_crms = cps_tc(5); cps_chold = cps_tc(1500);
cps_dKL.drift_init(0.8 + rand(0.5)); cps_dKR.drift_init(0.8 + rand(0.5));
cps_dBL.drift_init(0.8 + rand(0.5)); cps_dBR.drift_init(0.8 + rand(0.5));
0; 0; 0;
0;
cps_sm = cps_tc(30);
cps_env = 0; cps_gr = 0; cps_grpk = 0; cps_hold = 0; cps_grdisp = 0; cps_mpk = 0;
!cps_ui_dflt ? cps_own_ui_thm = 1; !cps_ui_dflt ? cps_own_ui_hw = 1;   // fixed blue and silver faceplate
!cps_ui_dflt ? cps_own_ui_kstyle = 0;
cps_update();
cps_out_s = cps_out_t; cps_blend_s = cps_blend_t;
cps_ui_dflt = 1;   // theme defaults above apply once: @init re-runs (playback start, device reset) must not undo the saved theme
0;
);

function cps_slider() (
cps_update();
0;
);

function cps_block() (
cps_update();
cps_dinc = cps_dspd * samplesblock / srate;
cps_vkL = cps_dKL.drift_tick(cps_dinc); cps_vkR = cps_dKR.drift_tick(cps_dinc);
cps_vbL = cps_dBL.drift_tick(cps_dinc); cps_vbR = cps_dBR.drift_tick(cps_dinc);
// colour drive and asymmetry, wandering with DRIFT
cps_kL = 1.2 * (1 + 0.6 * cps_drift * cps_vkL); cps_kR = 1.2 * (1 + 0.6 * cps_drift * cps_vkR);
cps_bL = 0.05 + 0.08 * cps_drift * cps_vbL;     cps_bR = 0.05 + 0.08 * cps_drift * cps_vbR;
0;
);

function cps_sample() (
(in_l = (spl0); in_r = (spl1); in_comp = 1);
cps_xL = in_l; cps_xR = in_r;

// detector: stereo-linked RMS of the signal without its deep lows
cps_dL = cps_scL.bq_run(cps_xL); cps_dR = cps_scR.bq_run(cps_xR);
cps_env += (0.5 * (cps_dL * cps_dL + cps_dR * cps_dR) - cps_env) * cps_crms;
cps_lv = 10 * log10(max(cps_env, 0.000000000001)) + 3;
cps_tgt = cps_gr_curve(cps_lv);
// optical-style timing, two stages: the first 40% of the reduction lets go quickly, the rest slowly -
// and the longer the reduction has been held, the slower that second stage
cps_hold += (cps_gr - cps_hold) * cps_chold;
cps_tgt > cps_gr ? ( cps_gr += (cps_tgt - cps_gr) * cps_catt; cps_grpk = cps_gr; )
         : cps_gr += (cps_tgt - cps_gr) * cps_tc(cps_gr > cps_grpk * 0.6 ? cps_rel_ms * 0.3 : cps_rel_ms * (1 + 2 * min(cps_hold / 6, 1)));
cps_g = 10 ^ (-cps_gr / 20);
cps_grdisp = max(cps_grdisp, cps_gr);

// compressed path with colour, then blend
cps_yL = cps_colour(cps_xL * cps_g * 0.5, cps_kL, cps_bL) * 2;
cps_yR = cps_colour(cps_xR * cps_g * 0.5, cps_kR, cps_bR) * 2;
cps_blend_s += (cps_blend_t - cps_blend_s) * cps_sm;
cps_out_s += (cps_out_t - cps_out_s) * cps_sm;
cps_oL = (cps_xL + (cps_yL - cps_xL) * cps_blend_s) * cps_out_s;
cps_oR = (cps_xR + (cps_yR - cps_xR) * cps_blend_s) * cps_out_s;
cps_oL = (cps_oL); cps_oR = (cps_oR);
(ost_l = (cps_oL); ost_r = (cps_oR));
spl0 = ost_l;
spl1 = ost_r;
cps_mpk = max(cps_mpk, max(abs(spl0), abs(spl1)));
0;
);

// ======================== gfx-gate.jsfx (prefix gtg_; its sliders 2-23 at 133-154) ========================
function gtg_defaults() (
  slider(133) = 0;
  slider(134) = 0;
  slider(135) = 0;
  slider(136) = -40;
  slider(137) = 60;
  slider(138) = 2;
  slider(139) = 0.5;
  slider(140) = 50;
  slider(141) = 150;
  slider(142) = 4;
  slider(143) = 0;
  slider(144) = 0;
  slider(145) = 0;
  slider(146) = 0;
  slider(147) = 100;
  slider(148) = 20;
  slider(149) = 20000;
  slider(150) = 1000;
  slider(151) = 0;
  slider(152) = 0;
  slider(153) = 100;
  slider(154) = 0;
  0;
);
function gtg_consts() (
  gtg_own_s1 = 0;
  slider(133) = 0;
  slider(134) = 0;
  slider(144) = 0;
  slider(145) = 0;
  slider(146) = 0;
  0;
);
function gtg_alloc(gtg_n) local(gtg_p) ( gtg_p = gtg_nextmem; gtg_nextmem += gtg_n; gtg_p; );
function gtg_db2g(gtg_d) ( exp(gtg_d*0.11512925465); );
function gtg_g2db(gtg_g) ( 8.68588963807*log(max(gtg_g, 0.00000001)); );
function gtg_cms(gtg_t) ( 1 - exp(-1/(max(0.000001, gtg_t)*srate)); );
function gtg_softk(gtg_o, gtg_w) ( gtg_o <= -gtg_w*0.5 ? 0 : gtg_o >= gtg_w*0.5 ? gtg_o : (gtg_o + gtg_w*0.5)*(gtg_o + gtg_w*0.5)/(2*gtg_w); );
function gtg_smst(gtg_v) ( gtg_v = max(0, min(1, gtg_v)); gtg_v*gtg_v*(3 - 2*gtg_v); );
function gtg_bqf(gtg_x, gtg_c, gtg_s) local(gtg_y) (
  gtg_y = gtg_c[0]*gtg_x + gtg_c[1]*gtg_s[0] + gtg_c[2]*gtg_s[1] - gtg_c[3]*gtg_s[2] - gtg_c[4]*gtg_s[3];
  gtg_s[1] = gtg_s[0]; gtg_s[0] = gtg_x; gtg_s[3] = gtg_s[2]; gtg_s[2] = gtg_y;
  gtg_y;
);
function gtg_cLP(gtg_c, gtg_f, gtg_q) local(gtg_w, gtg_cs, gtg_al, gtg_a0) (
  gtg_w = 2*$pi*min(gtg_f, srate*0.45)/srate; gtg_cs = cos(gtg_w); gtg_al = sin(gtg_w)/(2*gtg_q); gtg_a0 = 1 + gtg_al;
  gtg_c[0] = (1 - gtg_cs)*0.5/gtg_a0; gtg_c[1] = (1 - gtg_cs)/gtg_a0; gtg_c[2] = gtg_c[0]; gtg_c[3] = -2*gtg_cs/gtg_a0; gtg_c[4] = (1 - gtg_al)/gtg_a0;
);
function gtg_cHP(gtg_c, gtg_f, gtg_q) local(gtg_w, gtg_cs, gtg_al, gtg_a0) (
  gtg_w = 2*$pi*min(gtg_f, srate*0.45)/srate; gtg_cs = cos(gtg_w); gtg_al = sin(gtg_w)/(2*gtg_q); gtg_a0 = 1 + gtg_al;
  gtg_c[0] = (1 + gtg_cs)*0.5/gtg_a0; gtg_c[1] = -(1 + gtg_cs)/gtg_a0; gtg_c[2] = gtg_c[0]; gtg_c[3] = -2*gtg_cs/gtg_a0; gtg_c[4] = (1 - gtg_al)/gtg_a0;
);
function gtg_cPK(gtg_c, gtg_f, gtg_g, gtg_q) local(gtg_A, gtg_w, gtg_cs, gtg_al, gtg_a0) (
  gtg_A = 10^(gtg_g/40); gtg_w = 2*$pi*min(gtg_f, srate*0.45)/srate; gtg_cs = cos(gtg_w); gtg_al = sin(gtg_w)/(2*gtg_q); gtg_a0 = 1 + gtg_al/gtg_A;
  gtg_c[0] = (1 + gtg_al*gtg_A)/gtg_a0; gtg_c[1] = -2*gtg_cs/gtg_a0; gtg_c[2] = (1 - gtg_al*gtg_A)/gtg_a0; gtg_c[3] = -2*gtg_cs/gtg_a0; gtg_c[4] = (1 - gtg_al/gtg_A)/gtg_a0;
);
function gtg_tgain(gtg_L, gtg_op) local(gtg_g, gtg_te, gtg_b) (
  gtg_mdl == 0 ? (
    gtg_g = gtg_op ? 0 : (gtg_knee ? -gtg_rngDb*gtg_smst((gtg_thrDb - gtg_L)/12) : -gtg_rngDb);
  ) : (
    gtg_te = gtg_op ? gtg_thrDb - gtg_hyDb : gtg_thrDb;
    gtg_b = gtg_te - gtg_L;
    gtg_g = -min(gtg_rngDb, (gtg_knee ? gtg_softk(gtg_b, 10) : max(0, gtg_b))*(gtg_ratV - 1));
  );
  gtg_fnc ? gtg_g = -gtg_rngDb - gtg_g;                        // duck = the curve flipped inside the range
  gtg_g;
);
function gtg_envf(gtg_r) instance(gtg_env) (
  gtg_env = gtg_r > gtg_env ? gtg_r : gtg_env*gtg_dRel;
  gtg_env < 0.0000000001 ? gtg_env = 0;
  gtg_env;
);
function gtg_gstep(gtg_lv) instance(gtg_hl, gtg_hc, gtg_op, gtg_g, gtg_tg) local(gtg_above) (
  gtg_above = gtg_op ? (gtg_lv >= gtg_thrDb - gtg_hyDb) : (gtg_lv >= gtg_thrDb);
  gtg_above ? ( gtg_op = 1; gtg_hc = gtg_holdS; gtg_hl = gtg_lv; ) : (
    gtg_hc > 0 ? gtg_hc -= 1 : ( gtg_op = 0; gtg_hl = gtg_lv; );
  );
  gtg_tg = gtg_tgain(gtg_hl, gtg_op);
  gtg_tg > gtg_g ? gtg_g += (gtg_tg - gtg_g)*(gtg_fnc ? gtg_cRel : gtg_cAtk) : gtg_g += (gtg_tg - gtg_g)*(gtg_fnc ? gtg_cAtk : gtg_cRel);
  gtg_g;
);
function gtg_pdyn(gtg_m, gtg_f, gtg_kn, gtg_th, gtg_rg, gtg_ra, gtg_at, gtg_ho, gtg_re, gtg_hy, gtg_la) (
  slider(133) = gtg_m; slider(134) = gtg_f; slider(135) = gtg_kn; slider(136) = gtg_th; slider(137) = gtg_rg; slider(138) = gtg_ra;
  slider(139) = gtg_at; slider(140) = gtg_ho; slider(141) = gtg_re; slider(142) = gtg_hy; slider(143) = gtg_la;
);
function gtg_pkey(gtg_src, gtg_mi, gtg_st, gtg_lk, gtg_hp, gtg_lp, gtg_ff, gtg_fg) (
  slider(144) = gtg_src; slider(145) = gtg_mi; slider(146) = gtg_st; slider(147) = gtg_lk;
  slider(148) = gtg_hp; slider(149) = gtg_lp; slider(150) = gtg_ff; slider(151) = gtg_fg;
);
function gtg_apply_preset(gtg_n) (
  gtg_pdyn(0, 0, 0, -40, 60, 2, 0.5, 50, 150, 4, 0);
  gtg_pkey(0, 0, 0, 100, 20, 20000, 1000, 0);
  slider(152) = 0; slider(153) = 100; slider(154) = 0;
  gtg_n == 1  ? ( gtg_pdyn(0, 0, 0, -30, 60, 2, 0.1, 30, 90, 6, 2);       gtg_pkey(0, 0, 0, 100, 30, 400, 80, 6); ) :
  gtg_n == 2  ? ( gtg_pdyn(0, 0, 0, -28, 40, 2, 0.05, 40, 120, 6, 1.5);   gtg_pkey(0, 0, 0, 100, 150, 8000, 2000, 6); ) :
  gtg_n == 3  ? ( gtg_pdyn(0, 0, 1, -36, 30, 2, 1, 120, 400, 8, 2);       gtg_pkey(0, 0, 0, 100, 60, 3000, 120, 4); ) :
  gtg_n == 4  ? ( gtg_pdyn(0, 0, 0, -34, 24, 2, 0.05, 15, 60, 5, 1);      gtg_pkey(0, 0, 0, 100, 4000, 20000, 8000, 3); ) :
  gtg_n == 5  ? ( gtg_pdyn(1, 0, 1, -45, 12, 2, 2, 80, 250, 3, 0);        gtg_pkey(0, 0, 0, 100, 100, 20000, 3000, 0); ) :
  gtg_n == 6  ? ( gtg_pdyn(0, 0, 1, -55, 40, 2, 1, 60, 300, 8, 0);        gtg_pkey(0, 0, 0, 100, 80, 6000, 1000, 0); ) :
  gtg_n == 7  ? ( gtg_pdyn(1, 0, 0, -50, 30, 3, 3, 50, 200, 4, 0);        gtg_pkey(0, 0, 0, 100, 20, 20000, 1000, 0); ) :
  gtg_n == 8  ? ( gtg_pdyn(1, 0, 1, -40, 15, 1.5, 5, 20, 300, 2, 0);      gtg_pkey(0, 0, 0, 100, 20, 20000, 1000, 0); ) :
  gtg_n == 9  ? ( gtg_pdyn(1, 0, 1, -32, 18, 2.5, 2, 60, 350, 4, 0);      gtg_pkey(0, 0, 0, 100, 60, 20000, 1000, 0); ) :
  gtg_n == 10 ? ( gtg_pdyn(1, 0, 1, -48, 20, 2, 2, 100, 300, 4, 0);       gtg_pkey(0, 0, 0, 100, 120, 8000, 2500, 4); ) :
  gtg_n == 11 ? ( gtg_pdyn(0, 1, 1, -30, 9, 2, 5, 40, 250, 4, 0);         gtg_pkey(1, 0, 0, 100, 20, 200, 80, 0); ) :
  gtg_n == 12 ? ( gtg_pdyn(1, 1, 1, -40, 12, 4, 20, 200, 800, 3, 0);      gtg_pkey(1, 0, 0, 100, 150, 6000, 1500, 0); ) :
  gtg_n == 13 ? ( gtg_pdyn(0, 0, 0, -24, 80, 2, 0.05, 250, 40, 10, 0);    gtg_pkey(0, 0, 0, 100, 20, 20000, 1000, 0); ) :
  gtg_n == 14 ? ( gtg_pdyn(0, 0, 0, 0, 80, 2, 0.2, 0, 20, 0, 0);          gtg_pkey(0, 1, 0, 100, 20, 20000, 1000, 0); ) :
  gtg_n == 15 ? ( gtg_pdyn(0, 0, 0, -32, 50, 2, 0.01, 50, 100, 6, 5);     gtg_pkey(0, 0, 0, 100, 40, 20000, 1000, 0); );
);
function gtg_init() (
// =====================================================================
// Helpers
// =====================================================================
gtg_nextmem = 1300000;


      // floor -160 dB




// Biquad DF1: c = [b0 b1 b2 a1 a2], s = [x1 x2 y1 y2]





// ---- static gain computer: key level L (dB), open flag -> target gain (dB, <= 0) ----
// Used by the DSP and by the GUI transfer curve.


// ---- per-channel detector (instance state) ----

// level (dB) -> smoothed gain (dB): comparator with hysteresis + hold, RC in the dB domain


// ---- memory ----
gtg_DLN = 4096;                                    // lookahead delay (10 ms at 192 kHz = 1920)
gtg_bufA = gtg_alloc(gtg_DLN); gtg_bufB = gtg_alloc(gtg_DLN);
gtg_cH = gtg_alloc(5); gtg_cL = gtg_alloc(5); gtg_cP = gtg_alloc(5);
gtg_sH0 = gtg_alloc(4); gtg_sH1 = gtg_alloc(4); gtg_sL0 = gtg_alloc(4); gtg_sL1 = gtg_alloc(4); gtg_sP0 = gtg_alloc(4); gtg_sP1 = gtg_alloc(4);
gtg_mq = gtg_alloc(3*1024);                            // MIDI event queue (offset, channel, +1 / -1)
gtg_HN = 512; gtg_hb = gtg_alloc(gtg_HN*5);                    // level history: in, out, gain, open, key
memset(gtg_bufA, 0, gtg_DLN); memset(gtg_bufB, 0, gtg_DLN); memset(gtg_hb, 0, gtg_HN*5);
gtg_k = 0; loop(gtg_HN, gtg_hb[gtg_k*5] = -90; gtg_hb[gtg_k*5 + 1] = -90; gtg_hb[gtg_k*5 + 4] = -90; gtg_k += 1; );
gtg_dw = 0; gtg_hpos = 0; gtg_hcnt = 0; gtg_hInP = 0; gtg_hOutP = 0; gtg_hG = 0; gtg_hOp = 0; gtg_hKey = -160;
gtg_hstep = max(1, floor(srate*3.4/gtg_HN));
gtg_dRel = exp(-1/(0.015*srate));
gtg_nmA = 0; gtg_nmB = 0;
gtg_mIL = gtg_mIR = gtg_mOL = gtg_mOR = 0; gtg_mDec = exp(-1/(0.25*srate));
gtg_detA.gtg_g = 0; gtg_detB.gtg_g = 0; gtg_detA.gtg_op = 0; gtg_detB.gtg_op = 0;
gtg_lastF = -1;

// ---- presets ----




// GUI state
gtg_drag_id = -1; gtg_pcap = 0; gtg_lastS = 0; gtg_k_rst = -1; gtg_lcd_t = 0;
gtg_own_retina = 1;

gtg_q_init == 0 ? (
  gtg_lastPreset = gtg_own_s1;
  gtg_own_ui_sz = 2;                                   // open with large text
  gtg_q_init = 1;
);
0;
);

function gtg_slider() (
gtg_own_s1 != gtg_lastPreset ? ( gtg_apply_preset(gtg_own_s1); gtg_lastPreset = gtg_own_s1; );
0;
);

function gtg_block() (
// ---- parameters ----
gtg_mdl = slider(133) > 0.5; gtg_fnc = slider(134) > 0.5; gtg_knee = slider(135) > 0.5;
gtg_thrDb = slider(136); gtg_rngDb = slider(137); gtg_ratV = max(1, slider(138));
gtg_hyDb = slider(142);
gtg_cAtk = gtg_cms(slider(139)*0.001/3);                   // ~95% in the attack time
gtg_cRel = gtg_cms(slider(141)*0.001/3);
gtg_holdS = floor(slider(140)*0.001*srate);
gtg_la = min(gtg_DLN - 2, floor(slider(143)*0.001*srate + 0.5));
gtg_own_pdc_delay = gtg_la; gtg_own_pdc_bot = 0; gtg_own_pdc_top = 2;
gtg_ext = slider(144) > 0.5; gtg_midiOn = slider(145) > 0.5;
gtg_smode = floor(slider(146) + 0.5); gtg_lnk = slider(147)/100;
gtg_listen = slider(152) > 0.5;
gtg_mix = slider(153)/100; gtg_outG = gtg_db2g(slider(154));

// key filters (rebuilt only when changed)
gtg_fsum = slider(148) + slider(149)*3 + slider(150)*7 + slider(151)*11;
gtg_fsum != gtg_lastF ? (
  gtg_lastF = gtg_fsum;
  gtg_hpOn = slider(148) > 20.5;  gtg_hpOn ? gtg_cHP(gtg_cH, slider(148), 0.7071);
  gtg_lpOn = slider(149) < 19999; gtg_lpOn ? gtg_cLP(gtg_cL, slider(149), 0.7071);
  gtg_pkOn = abs(slider(151)) > 0.05; gtg_pkOn ? gtg_cPK(gtg_cP, slider(150), slider(151), 1.4);
);

// ---- MIDI: queue note on/off for sample-accurate triggering, pass everything through ----
gtg_qn = 0;
while (midirecv(gtg_mofs, gtg_m1, gtg_m2, gtg_m3)) (
  midisend(gtg_mofs, gtg_m1, gtg_m2, gtg_m3);
  gtg_mst = gtg_m1 & 0xF0; gtg_mch = gtg_m1 & 0x0F;
  (gtg_midiOn && gtg_mch <= 2 && (gtg_mst == 0x90 || gtg_mst == 0x80) && gtg_qn < 1024) ? (
    gtg_mq[gtg_qn*3] = gtg_mofs; gtg_mq[gtg_qn*3 + 1] = gtg_mch; gtg_mq[gtg_qn*3 + 2] = (gtg_mst == 0x90 && gtg_m3 > 0) ? 1 : -1;
    gtg_qn += 1;
  );
  (gtg_mst == 0xB0 && (gtg_m2 == 123 || gtg_m2 == 120)) ? ( gtg_nmA = 0; gtg_nmB = 0; );
);
!gtg_midiOn ? ( gtg_nmA = 0; gtg_nmB = 0; );
gtg_qi = 0; gtg_si = 0;
0;
);

function gtg_sample() (
// ---- MIDI events due at this sample ----
while (gtg_qi < gtg_qn && gtg_mq[gtg_qi*3] <= gtg_si) (
  gtg_mch = gtg_mq[gtg_qi*3 + 1]; gtg_md = gtg_mq[gtg_qi*3 + 2];
  gtg_mch == 0 ? ( gtg_nmA = max(0, gtg_nmA + gtg_md); gtg_nmB = max(0, gtg_nmB + gtg_md); ) :
  gtg_mch == 1 ? gtg_nmA = max(0, gtg_nmA + gtg_md) : gtg_nmB = max(0, gtg_nmB + gtg_md);
  gtg_qi += 1;
);
gtg_si += 1;

gtg_x0 = spl0; gtg_x1 = spl1;
gtg_ext ? ( gtg_k0 = spl2; gtg_k1 = spl3; ) : ( gtg_k0 = gtg_x0; gtg_k1 = gtg_x1; );
gtg_smode == 2 ? (
  gtg_a0 = (gtg_x0 + gtg_x1)*0.5; gtg_a1 = (gtg_x0 - gtg_x1)*0.5;
  gtg_kt = (gtg_k0 + gtg_k1)*0.5; gtg_k1 = (gtg_k0 - gtg_k1)*0.5; gtg_k0 = gtg_kt;
) : ( gtg_a0 = gtg_x0; gtg_a1 = gtg_x1; );

// ---- key filters ----
gtg_hpOn ? ( gtg_k0 = gtg_bqf(gtg_k0, gtg_cH, gtg_sH0); gtg_k1 = gtg_bqf(gtg_k1, gtg_cH, gtg_sH1); );
gtg_lpOn ? ( gtg_k0 = gtg_bqf(gtg_k0, gtg_cL, gtg_sL0); gtg_k1 = gtg_bqf(gtg_k1, gtg_cL, gtg_sL1); );
gtg_pkOn ? ( gtg_k0 = gtg_bqf(gtg_k0, gtg_cP, gtg_sP0); gtg_k1 = gtg_bqf(gtg_k1, gtg_cP, gtg_sP1); );

// ---- detectors ----
gtg_lvA = gtg_g2db(gtg_detA.gtg_envf(abs(gtg_k0)));
gtg_lvB = gtg_g2db(gtg_detB.gtg_envf(abs(gtg_k1)));
gtg_smode == 0 ? (
  gtg_lv = max(gtg_lvA, gtg_lvB);
  (gtg_nmA + gtg_nmB) > 0 ? gtg_lv = 40;
  gtg_gA = gtg_detA.gtg_gstep(gtg_lv); gtg_gB = gtg_gA;
  gtg_detB.gtg_op = gtg_detA.gtg_op; gtg_lvA = gtg_lvB = gtg_lv;
) : (
  gtg_mxl = max(gtg_lvA, gtg_lvB);
  gtg_lvA += gtg_lnk*(gtg_mxl - gtg_lvA); gtg_lvB += gtg_lnk*(gtg_mxl - gtg_lvB);
  gtg_nmA > 0 ? gtg_lvA = 40;
  gtg_nmB > 0 ? gtg_lvB = 40;
  gtg_gA = gtg_detA.gtg_gstep(gtg_lvA); gtg_gB = gtg_detB.gtg_gstep(gtg_lvB);
);

// ---- lookahead delay on the audio path ----
gtg_bufA[gtg_dw] = gtg_a0; gtg_bufB[gtg_dw] = gtg_a1;
gtg_rp = gtg_dw - gtg_la; gtg_rp < 0 ? gtg_rp += gtg_DLN;
gtg_d0 = gtg_bufA[gtg_rp]; gtg_d1 = gtg_bufB[gtg_rp];
gtg_dw += 1; gtg_dw >= gtg_DLN ? gtg_dw = 0;

// ---- VCA + mix ----
gtg_o0 = gtg_d0*(1 - gtg_mix + gtg_mix*gtg_db2g(gtg_gA));
gtg_o1 = gtg_d1*(1 - gtg_mix + gtg_mix*gtg_db2g(gtg_gB));
gtg_listen ? ( gtg_o0 = gtg_k0; gtg_o1 = gtg_k1; );
gtg_smode == 2 ? ( gtg_y0 = gtg_o0 + gtg_o1; gtg_y1 = gtg_o0 - gtg_o1; ) : ( gtg_y0 = gtg_o0; gtg_y1 = gtg_o1; );
spl0 = gtg_y0*gtg_outG; spl1 = gtg_y1*gtg_outG;

// ---- meters ----
gtg_mIL = max(abs(gtg_x0), gtg_mIL*gtg_mDec); gtg_mIR = max(abs(gtg_x1), gtg_mIR*gtg_mDec);
gtg_mOL = max(abs(spl0), gtg_mOL*gtg_mDec); gtg_mOR = max(abs(spl1), gtg_mOR*gtg_mDec);
gtg_mGA = gtg_gA; gtg_mGB = gtg_gB; gtg_mLv = max(gtg_lvA, gtg_lvB);
gtg_hInP = max(gtg_hInP, max(abs(gtg_x0), abs(gtg_x1)));
gtg_hOutP = max(gtg_hOutP, max(abs(spl0), abs(spl1)));
gtg_hG = min(gtg_hG, min(gtg_gA, gtg_gB));
gtg_hOp = gtg_hOp || gtg_detA.gtg_op || gtg_detB.gtg_op;
gtg_hKey = max(gtg_hKey, min(0, gtg_mLv));
gtg_hcnt += 1;
gtg_hcnt >= gtg_hstep ? (
  gtg_hp_ = gtg_hb + gtg_hpos*5;
  gtg_hp_[0] = gtg_g2db(gtg_hInP); gtg_hp_[1] = gtg_g2db(gtg_hOutP); gtg_hp_[2] = gtg_hG; gtg_hp_[3] = gtg_hOp; gtg_hp_[4] = gtg_hKey;
  gtg_hpos += 1; gtg_hpos >= gtg_HN ? gtg_hpos = 0;
  gtg_hcnt = 0; gtg_hInP = 0; gtg_hOutP = 0; gtg_hG = 0; gtg_hOp = 0; gtg_hKey = -160;
);
0;
);

// ======================== gfx-ob-q.jsfx (prefix gxo_; its sliders 9-11 at 155-157) ========================
function gxo_defaults() (
  slider(155) = -50;
  slider(156) = 20;
  slider(157) = 200;
  0;
);
function gxo_consts() (
  gxo_own_s1 = 0;
  gxo_own_s2 = -18;
  gxo_own_s3 = 3;
  gxo_own_s4 = 3;
  gxo_own_s5 = 250;
  gxo_own_s6 = 0;
  gxo_own_s7 = 0;
  gxo_own_s8 = 1;
  gxo_own_s12 = 1;
  gxo_own_s13 = 0;
  gxo_own_s14 = 1;
  gxo_own_s15 = 100;
  gxo_own_s16 = 0;
  gxo_own_s17 = 0;
  gxo_own_s18 = 0;
  gxo_own_s19 = 30;
  gxo_own_s20 = 120;
  gxo_own_s21 = 6000;
  gxo_own_s22 = -0.3;
  gxo_own_s23 = 1;
  gxo_own_s24 = 20;
  gxo_own_s25 = 22000;
  gxo_own_s26 = 0;
  gxo_own_s27 = 100;
  gxo_own_s28 = 0;
  gxo_own_s29 = 0;
  gxo_own_s30 = 600;
  gxo_own_s31 = 1;
  gxo_own_s32 = 0;
  gxo_own_s33 = 2500;
  gxo_own_s34 = 1;
  gxo_own_s35 = 0;
  gxo_own_s36 = 8000;
  gxo_own_s37 = 0;
  gxo_own_s38 = 0;
  gxo_own_s39 = 1;
  gxo_own_s40 = 0;
  gxo_own_s41 = 0;
  gxo_own_s42 = 0;
  0;
);
function gxo_ch_det(gxo_x) instance(gxo_ms, gxo_gms) (
  gxo_ms += (gxo_x * gxo_x - gxo_ms) * gxo_det_c;                       // compressor: quick RMS (~2 ms)
  gxo_gms += (gxo_x * gxo_x - gxo_gms) * gxo_gdet_c;                    // gate: a little slower, so it does not chatter
  10 * log10(gxo_ms + 0.0000000001) + 3;
);
function gxo_ch_glv() instance(gxo_gms) ( 10 * log10(gxo_gms + 0.0000000001) + 3 );
function gxo_ch_gate(gxo_lv) instance(gxo_ge) local(gxo_t, gxo_o) (
  gxo_g_on && gxo_gthr > -79.9 ? (
    gxo_o = gxo_lv - gxo_gthr;
    gxo_t = gxo_gmode ? max(min(gxo_o, 0), -gxo_grange) : (gxo_o < 0 ? -gxo_grange : 0);
    gxo_ge += (gxo_t - gxo_ge) * (gxo_t > gxo_ge ? gxo_gatt_c : gxo_grel_c);
  ) : gxo_ge = 0;
  gxo_ge;
);
function gxo_ch_comp(gxo_lv) instance(gxo_e) local(gxo_t) (
  gxo_c_on ? (
    gxo_t = -(1 - gxo_sl) * dy_curve(gxo_lv - gxo_thr, 3);
    gxo_e += (gxo_t - gxo_e) * (gxo_t < gxo_e ? gxo_ac : gxo_rc);
  ) : gxo_e = 0;
  gxo_e;
);
function gxo_ch_lim(gxo_x) instance(gxo_lg) local(gxo_t) (
  gxo_t = gxo_l_on && abs(gxo_x) > gxo_ltg ? gxo_ltg / abs(gxo_x) : 1;
  gxo_lg = gxo_t < gxo_lg ? gxo_t : gxo_lg + (1 - gxo_lg) * gxo_lim_r;
  gxo_lg;
);
function gxo_xf(gxo_x) instance(gxo_lo, gxo_hi) local(gxo_s) (
  gxo_lo += (gxo_x - gxo_lo) * gxo_xf_lc;
  gxo_s = gxo_lo * 1.6; gxo_s = gxo_s / (1 + abs(gxo_s) * 0.22) / 1.6;  // soft, level-dependent squash of the lows
  gxo_x = gxo_x - gxo_lo + gxo_s * 1.03;
  gxo_hi += (gxo_x - gxo_hi) * gxo_xf_hc;
  gxo_hi;
);
function gxo_update() (
  gxo_c_on = gxo_own_s1; gxo_thr = gxo_own_s2; gxo_sl = gxo_own_s3 >= 19.95 ? 0 : 1 / gxo_own_s3;
  gxo_ac = dy_ms(gxo_own_s4); gxo_rc = dy_ms(gxo_own_s5); gxo_mk = 10 ^ (gxo_own_s6 / 20);
  gxo_l_on = gxo_own_s7 < -0.05; gxo_ltg = 10 ^ (gxo_own_s7 / 20);
  gxo_g_on = gxo_own_s8; gxo_gthr = slider(155); gxo_grange = slider(156); gxo_grel_c = dy_ms(slider(157)); gxo_gmode = gxo_own_s12;
  gxo_xfm = gxo_own_s13; gxo_lnk = gxo_own_s14; gxo_mix_t = gxo_own_s15 / 100;
  0;
  0;   // output stage: straight through
);
function gxo_pg(gxo_on, gxo_t, gxo_r, gxo_rl, gxo_md) ( gxo_own_s8 = gxo_on; slider(155) = gxo_t; slider(156) = gxo_r; slider(157) = gxo_rl; gxo_own_s12 = gxo_md; );
function gxo_pc(gxo_on, gxo_t, gxo_r, a, gxo_rl, gxo_g, gxo_lm, gxo_xm, gxo_lk, gxo_mx) (
  gxo_own_s1 = gxo_on; gxo_own_s2 = gxo_t; gxo_own_s3 = gxo_r; gxo_own_s4 = a; gxo_own_s5 = gxo_rl; gxo_own_s6 = gxo_g; gxo_own_s7 = gxo_lm;
  gxo_own_s13 = gxo_xm; gxo_own_s14 = gxo_lk; gxo_own_s15 = gxo_mx;
);
function gxo_load_preset(gxo_p) (
  gxo_p == 1  ? ( gxo_pg(0, -50, 20, 200, 1); gxo_pc(1, -20, 2.5, 5, 300, 3, 0, 1, 1, 100); ) :      // Desk Glue
  gxo_p == 2  ? ( gxo_pg(1, -55, 12, 250, 1); gxo_pc(1, -26, 4, 2, 150, 6, -2, 1, 1, 100); ) :      // Presenter Voice
  gxo_p == 3  ? ( gxo_pg(1, -45, 40, 120, 0); gxo_pc(1, -22, 5, 1, 120, 5, -1, 1, 1, 100); ) :      // Tight Drums (gated)
  gxo_p == 4  ? ( gxo_pg(1, -40, 60, 80, 0);  gxo_pc(1, -24, 4, 0.5, 100, 4, 0, 1, 0, 100); ) :     // Kick / Snare Gate
  gxo_p == 5  ? ( gxo_pg(0, -50, 20, 200, 1); gxo_pc(1, -30, 8, 0.3, 80, 10, -3, 1, 1, 45); ) :     // Parallel Squash
  gxo_p == 6  ? ( gxo_pg(0, -50, 20, 200, 1); gxo_pc(1, -14, 20, 0.1, 50, 2, -1, 1, 1, 100); ) :    // Transmitter Limit
  gxo_p == 7  ? ( gxo_pg(1, -60, 10, 400, 1); gxo_pc(1, -20, 3, 10, 400, 3, 0, 1, 1, 100); ) :      // Acoustic Clean-up
  gxo_p == 8  ? ( gxo_pg(0, -50, 20, 200, 1); gxo_pc(1, -24, 4, 8, 250, 4, 0, 1, 1, 100); ) :       // Bass DI
  gxo_p == 9  ? ( gxo_pg(0, -50, 20, 200, 1); gxo_pc(0, -18, 3, 3, 250, 0, 0, 1, 1, 100); ) :       // Transformer Only
  gxo_p == 10 ? ( gxo_pg(1, -50, 15, 300, 1); gxo_pc(1, -16, 2, 20, 600, 2, -1, 1, 1, 100); );      // Gentle Programme Bus
  gxo_p >= 1 && gxo_p <= 10 ? 0;       // sliders 1-15
  gxo_p == 11 ? (                                       // Reset all to defaults
    gxo_pg(0, -50, 20, 200, 1); gxo_pc(1, -18, 3, 3, 250, 0, 0, 1, 1, 100);
    gxo_own_s16 = 0; gxo_own_s17 = 1; gxo_own_s18 = 0; gxo_own_s19 = 30; gxo_own_s20 = 120; gxo_own_s21 = 6000; gxo_own_s22 = -0.3; gxo_own_s23 = 1;
    0;                       // sliders 1-23
  );
);
function gxo_cb_auto(gxo_m, gxo_off) local(gxo_k) ( gxo_k = 1; loop(63, gxo_m - 2 * floor(gxo_m / 2) ? ui_auto(146 + gxo_k + gxo_off); gxo_m = floor(gxo_m / 2); gxo_k += 1; ); );
function gxo_th(gxo_x) ( gxo_x = min(max(gxo_x, -3), 3); gxo_x * (27 + gxo_x * gxo_x) / (27 + 9 * gxo_x * gxo_x); );
function gxo_q_hp1(gxo_x) instance(x1, y1) ( y1 = gxo_q_hp1_a * (gxo_x - x1) + gxo_q_hp1_b * y1; x1 = gxo_x; y1; );
function gxo_q_hp1set(gxo_f) local(gxo_k) ( gxo_k = tan($pi * min(gxo_f, srate * 0.45) / srate); gxo_q_hp1_a = 1 / (1 + gxo_k); gxo_q_hp1_b = (1 - gxo_k) / (1 + gxo_k); );
function gxo_q_hp1db(gxo_f) local(gxo_w, gxo_q_wc) ( gxo_q_wc = gxo_own_s24; gxo_w = gxo_f / gxo_q_wc; 10 * log10(gxo_w * gxo_w / (1 + gxo_w * gxo_w)); );
function gxo_q_chain(gxo_x) instance() local(gxo_y) (
  gxo_q_hp_on ? gxo_x = this.gxo_h1.gxo_q_hp1(this.gxo_h2.bq_run(gxo_x));
  gxo_q_eq_on ? (
    gxo_x = this.gxo_lf.bq_run(gxo_x); gxo_q_lfx ? gxo_x = this.gxo_lx.bq_run(gxo_x);
    gxo_x = this.gxo_lm.bq_run(gxo_x); gxo_x = this.gxo_hm.bq_run(gxo_x);
    gxo_x = this.gxo_hf.bq_run(gxo_x); gxo_q_hfx ? gxo_x = this.gxo_hx.bq_run(gxo_x);
  );
  gxo_y = this.gxo_lp.bq_run(gxo_x);                     // the LPF always runs (primed) and is faded in / out, never switched
  gxo_q_bd_lpw >= 1 ? gxo_x = gxo_y : gxo_q_bd_lpw > 0 ? gxo_x += (gxo_y - gxo_x) * gxo_q_bd_lpw;
  gxo_x;
);
function gxo_q_setch() instance() local(gxo_q) (
  gxo_q_hp_on ? this.gxo_h2.bq_set(1, gxo_own_s24, 1, 0);
  this.gxo_lp.bq_set(0, gxo_q_bd_lpf, 0.707, 0);     // q_bd_lpf: the LPF frequency, glided in q_proc
  // proportional Q on the black card
  this.gxo_lf.bq_set(gxo_own_s28 ? 2 : 4, gxo_own_s27, gxo_own_s28 ? (gxo_q_blk ? 0.6 + abs(gxo_own_s26) / 15 * 0.9 : 0.55) : (gxo_q_blk ? 1.15 : 0.6), gxo_own_s26);
  this.gxo_lm.bq_set(2, gxo_own_s30, gxo_own_s31 * (gxo_q_blk ? 0.6 + abs(gxo_own_s29) / 15 * 1.2 : 0.7), gxo_own_s29);
  this.gxo_hm.bq_set(2, gxo_own_s33, gxo_own_s34 * (gxo_q_blk ? 0.6 + abs(gxo_own_s32) / 15 * 1.2 : 0.7), gxo_own_s32);
  this.gxo_hf.bq_set(gxo_own_s37 ? 2 : 3, gxo_own_s36, gxo_own_s37 ? (gxo_q_blk ? 0.6 + abs(gxo_own_s35) / 15 * 0.9 : 0.55) : (gxo_q_blk ? 1.15 : 0.6), gxo_own_s35);
  // the black card's shelves: a small opposite dip just inside the corner
  gxo_q_lfx ? this.gxo_lx.bq_set(2, gxo_own_s27 * 2.2, 1.2, -gxo_own_s26 * 0.12);
  gxo_q_hfx ? this.gxo_hx.bq_set(2, gxo_own_s36 * 0.45, 1.2, -gxo_own_s35 * 0.12);
);
function gxo_q_update() local(b, gxo_q_cs) (
  gxo_q_cs = 0; b = 1; loop(18, gxo_q_cs += slider(146 + (b) + 23) * (b * 7.31 + 1); b += 1; );
  gxo_q_cs != gxo_q_last_cs ? ( gxo_q_redraw = 1; gxo_q_last_cs = gxo_q_cs; );
  gxo_q_hp_on = gxo_own_s24 > 20.5; gxo_q_lp_on = gxo_own_s25 < 21990; gxo_q_eq_on = gxo_own_s38; gxo_q_blk = gxo_own_s39;
  gxo_q_lfx = gxo_q_blk && !gxo_own_s28; gxo_q_hfx = gxo_q_blk && !gxo_own_s37;
  gxo_q_hp1set(gxo_own_s24);
  gxo_q_CL.gxo_q_setch(); gxo_q_CR.gxo_q_setch();
  gxo_q_drv = gxo_own_s40 / 100; gxo_q_dk = 1 + gxo_q_drv * 3; gxo_q_dbias = gxo_q_drv * 0.15; gxo_q_dtb = gxo_th(gxo_q_dbias);
  gxo_q_og = 10 ^ (gxo_own_s41 / 20);
  
     // no GFX output stage on this unit: its own character does that job
);
function gxo_q_pq(gxo_hp, gxo_lp, gxo_lg, gxo_lf, gxo_q_lb, gxo_q_mg, gxo_q_mf, gxo_q_mq, gxo_q_hg, gxo_q_hf_, gxo_q_hq, gxo_q_fg, gxo_q_ff, gxo_fb, gxo_q_vo, gxo_q_dr) (
  gxo_own_s24 = gxo_hp; gxo_own_s25 = gxo_lp; gxo_own_s26 = gxo_lg; gxo_own_s27 = gxo_lf; gxo_own_s28 = gxo_q_lb; gxo_own_s29 = gxo_q_mg; gxo_own_s30 = gxo_q_mf; gxo_own_s31 = gxo_q_mq;
  gxo_own_s32 = gxo_q_hg; gxo_own_s33 = gxo_q_hf_; gxo_own_s34 = gxo_q_hq; gxo_own_s35 = gxo_q_fg; gxo_own_s36 = gxo_q_ff; gxo_own_s37 = gxo_fb; gxo_own_s38 = 1; gxo_own_s39 = gxo_q_vo; gxo_own_s40 = gxo_q_dr; gxo_own_s41 = 0;
);
function gxo_q_load_preset(gxo_p) (
  gxo_p == 1  ? gxo_q_pq(90, 22000, -2, 200, 1, -3, 350, 1.2, 4, 3500, 1.2, 3, 12000, 0, 1, 10) :      // Vocal Presence
  gxo_p == 2  ? gxo_q_pq(30, 22000, 5, 60, 1, -5, 380, 1.5, 3, 3000, 1.5, 0, 8000, 0, 1, 15) :         // Kick Punch
  gxo_p == 3  ? gxo_q_pq(80, 22000, 2, 200, 1, -2, 500, 1.2, 4, 5000, 1.4, 3, 10000, 0, 1, 20) :       // Snare Crack
  gxo_p == 4  ? gxo_q_pq(30, 9000, 4, 80, 0, -3, 250, 1.2, 2, 1200, 1.0, 0, 8000, 0, 0, 25) :          // Bass Weight
  gxo_p == 5  ? gxo_q_pq(70, 22000, -2, 150, 0, -2, 300, 1.0, 2, 4000, 0.8, 4, 12000, 0, 0, 0) :       // Acoustic Sparkle
  gxo_p == 6  ? gxo_q_pq(25, 22000, 1.5, 60, 0, 0, 600, 1, -1, 3000, 0.8, 2, 14000, 0, 0, 10) :        // Mix Bus Air
  gxo_p == 7  ? gxo_q_pq(400, 3500, 0, 100, 0, 6, 1500, 1.5, 0, 2500, 1, 0, 8000, 0, 1, 60) :          // Telephone
  gxo_p == 8  ? gxo_q_pq(60, 22000, 0, 100, 0, -5, 300, 1.0, 0, 2500, 1, 1, 10000, 0, 1, 0) :          // De-mud
  gxo_p == 9  ? gxo_q_pq(40, 16000, 3, 120, 0, 1, 800, 0.7, 1, 3000, 0.7, 2, 9000, 0, 0, 40) :         // Brown Warmth
  gxo_p == 10 ? gxo_q_pq(100, 22000, 0, 100, 0, 0, 600, 1, -4, 6500, 2.5, 2, 15000, 0, 1, 0);          // De-harsh
  gxo_p >= 1 && gxo_p <= 10 ? gxo_cb_auto(262143, 23);     // sliders 1-18
  gxo_p == 11 ? (                                       // Reset all to defaults
    gxo_q_pq(20, 22000, 0, 100, 0, 0, 600, 1, 0, 2500, 1, 0, 8000, 0, 1, 0);
    gxo_own_s16 = 0; gxo_own_s17 = 1; gxo_own_s18 = 0; gxo_own_s19 = 30; gxo_own_s20 = 120; gxo_own_s21 = 6000; gxo_own_s22 = -0.3; gxo_own_s23 = 1;
    gxo_cb_auto(67108863, 23);
  );
);
function gxo_q_proc(gxo_cb_inl, gxo_cb_inr) (
  gxo_q_bd_lpw = gxo_q_lp_on ? min(gxo_q_bd_lpw + gxo_q_bd_lpxs, 1) : max(gxo_q_bd_lpw - gxo_q_bd_lpxs, 0);
  gxo_q_bd_lpt = min(gxo_own_s25, srate * 0.45);
  gxo_q_bd_lpf != gxo_q_bd_lpt ? ( (gxo_q_bd_lpn += 1) >= 16 ? ( gxo_q_bd_lpn = 0; gxo_q_bd_lpf *= (gxo_q_bd_lpt / gxo_q_bd_lpf) ^ gxo_q_bd_lpk; abs(gxo_q_bd_lpf - gxo_q_bd_lpt) < 0.0005 * gxo_q_bd_lpt ? gxo_q_bd_lpf = gxo_q_bd_lpt;
    gxo_q_CL.gxo_lp.bq_set(0, gxo_q_bd_lpf, 0.707, 0); gxo_q_CR.gxo_lp.bq_set(0, gxo_q_bd_lpf, 0.707, 0); ); );
  gxo_q_xl = gxo_q_CL.gxo_q_chain(gxo_cb_inl); gxo_q_xr = gxo_q_CR.gxo_q_chain(gxo_cb_inr);
  gxo_q_drv > 0.001 ? (
    gxo_q_xl = (gxo_th(gxo_q_dk * gxo_q_xl + gxo_q_dbias) - gxo_q_dtb) / (gxo_q_dk * (1 - gxo_q_dtb * gxo_q_dtb));
    gxo_q_xr = (gxo_th(gxo_q_dk * gxo_q_xr + gxo_q_dbias) - gxo_q_dtb) / (gxo_q_dk * (1 - gxo_q_dtb * gxo_q_dtb));
  );
  gxo_q_xl *= gxo_q_og; gxo_q_xr *= gxo_q_og;
  gxo_q_oL = (gxo_q_xl); gxo_q_oR = (gxo_q_xr);
  gxo_q_pkO = max(gxo_q_pkO, max(abs(gxo_q_oL), abs(gxo_q_oR)));
  gxo_q_out_l = gxo_q_oL; gxo_q_out_r = gxo_q_oR;
);
function gxo_init() (
#gxo_own_ui_man = "gfx-ob-q";                                       // the ? pop-up links to this manual

// one channel's detectors + gains (dB domain)





// output transformer: the lows saturate gently with level, the extreme top softens




// ---------- presets (leave INPUT and OUTPUT alone) ----------
// gate: in, threshold, range, release, mode; compressor: in, threshold, ratio, attack, release, gain; limit; xfmr; link; mix




0;
0; 0; 0;
gxo_det_c = 1 - exp(-1 / (0.002 * srate));
gxo_gdet_c = 1 - exp(-1 / (0.006 * srate));
gxo_gatt_c = 1 - exp(-1 / (0.0005 * srate));           // gate opens in 0.5 ms
gxo_lim_r = 1 - exp(-1 / (0.05 * srate));
gxo_xf_lc = 1 - exp(-2 * $pi * 120 / srate);
gxo_xf_hc = 1 - exp(-2 * $pi * min(24000, srate * 0.45) / srate);
gxo_sm = 1 - exp(-1 / (0.03 * srate));
gxo_L.gxo_lg = 1; gxo_R.gxo_lg = 1;
!gxo_ui_dflt ? gxo_own_ui_thm = 5; !gxo_ui_dflt ? gxo_own_ui_hw = 1;                              // fixed faceplate
gxo_PNL = 0x2C2C2E; gxo_INKC = 0xEDE6D8; gxo_BRN = 0x5C3A22; gxo_BRNL = 0x7A4E2E; gxo_ORG = 0xE8782A; gxo_YEL = 0xF0C030;
gxo_update();
gxo_mix_s = gxo_mix_t;


// ================= EQ (the Board EQ engine, names q_..., sliders 24 - 41) =================
// a preset mask of the EQ unit, one slider at a time

#gxo_own_ui_man = "gfx-ob-q";                                       // the ? pop-up links to this manual


// one-pole high-pass (the third pole of the 18 dB HPF)




// one channel's chain






// ---------- presets (leave INPUT and OUTPUT alone) ----------




  
 gxo_q_RSP = 30000;
gxo_q_PNL = 0xB4B8BA; gxo_q_PRT = 0x1C1E21; gxo_q_SCR = 0x121517; gxo_q_CRED = 0xC8322A; gxo_q_CGRN = 0x2E8A4A; gxo_q_CBLU = 0x2C5FA8; gxo_q_CBRN = 0x6A4A32; gxo_q_CGRY = 0xE4E4E0; gxo_q_CBLK = 0x26272A; gxo_q_SLB = 0x3BA9E0; gxo_SDB = 0x34349A; gxo_q_SRD = 0xE0262B;
gxo_q_bd_lpf = min(gxo_own_s25, srate * 0.45); gxo_q_bd_lpk = 1 - exp(-16 / (0.02 * srate)); gxo_q_bd_lpn = 0;   // LPF glide (~20 ms)
gxo_q_update();
gxo_q_bd_lpw = gxo_q_lp_on; gxo_q_bd_lpxs = 1 / (0.02 * srate);   // LPF on / off fade: 20 ms



gxo_q_ord = gxo_own_s42;
gxo_ui_dflt = 1;   // theme defaults above apply once: @init re-runs (playback start, device reset) must not undo the saved theme
0;
);

function gxo_slider() (
gxo_q_update();
gxo_q_ord = gxo_own_s42;
gxo_update();
0;
);

function gxo_block() (
gxo_q_update();
gxo_q_ord = gxo_own_s42;
gxo_update();
0;
);

function gxo_sample() (
(in_l = (spl0); in_r = (spl1); in_comp = 1);
!gxo_q_ord ? ( gxo_q_proc(in_l, in_r); in_l = gxo_q_out_l; in_r = gxo_q_out_r; );   // EQ first
gxo_dl = in_l; gxo_dr = in_r;
// gate (on the input)
gxo_gvL = (gxo_L.gxo_ch_det(gxo_dl); gxo_L.gxo_ch_glv()); gxo_gvR = (gxo_R.gxo_ch_det(gxo_dr); gxo_R.gxo_ch_glv());
gxo_lnk ? ( gxo_gvL = gxo_gvR = max(gxo_gvL, gxo_gvR); );
gxo_gL = gxo_L.gxo_ch_gate(gxo_gvL); gxo_gR = gxo_R.gxo_ch_gate(gxo_gvR);
gxo_xl = gxo_dl * 10 ^ (gxo_gL / 20); gxo_xr = gxo_dr * 10 ^ (gxo_gR / 20);
// compressor (its detector hears the gated signal)
gxo_cvL = 10 * log10(gxo_L.gxo_ms * 10 ^ (gxo_gL / 10) + 0.0000000001) + 3; gxo_cvR = 10 * log10(gxo_R.gxo_ms * 10 ^ (gxo_gR / 10) + 0.0000000001) + 3;
gxo_lnk ? ( gxo_cvL = gxo_cvR = max(gxo_cvL, gxo_cvR); );
gxo_eL = gxo_L.gxo_ch_comp(gxo_cvL); gxo_eR = gxo_R.gxo_ch_comp(gxo_cvR);
gxo_yl = gxo_xl * 10 ^ (gxo_eL / 20) * (gxo_c_on ? gxo_mk : 1); gxo_yr = gxo_xr * 10 ^ (gxo_eR / 20) * (gxo_c_on ? gxo_mk : 1);
// limiter
gxo_lL = gxo_L.gxo_ch_lim(gxo_yl); gxo_lR = gxo_R.gxo_ch_lim(gxo_yr);
gxo_lnk ? ( gxo_lL = gxo_lR = min(gxo_lL, gxo_lR); );
gxo_yl *= gxo_lL; gxo_yr *= gxo_lR;
// transformer
gxo_xfm ? ( gxo_yl = gxo_TL.gxo_xf(gxo_yl); gxo_yr = gxo_TR.gxo_xf(gxo_yr); );
gxo_grm = min(gxo_grm, min(gxo_eL, gxo_eR) + 20 * log10(min(gxo_lL, gxo_lR)));
gxo_gtm = min(gxo_gtm, min(gxo_gL, gxo_gR));
gxo_limm = max(gxo_limm, min(gxo_lL, gxo_lR) < 0.999);
// mix + output stage
gxo_mix_s += (gxo_mix_t - gxo_mix_s) * gxo_sm;
gxo_oL = gxo_dl + (gxo_yl - gxo_dl) * gxo_mix_s; gxo_oR = gxo_dr + (gxo_yr - gxo_dr) * gxo_mix_s;
gxo_q_ord ? ( gxo_q_proc(gxo_oL, gxo_oR); gxo_oL = gxo_q_out_l; gxo_oR = gxo_q_out_r; );   // EQ after
gxo_oL = (gxo_oL * in_comp); gxo_oR = (gxo_oR * in_comp);
(ost_l = (gxo_oL); ost_r = (gxo_oR));
spl0 = ost_l; spl1 = ost_r;
gxo_pkI = max(gxo_pkI, max(abs(gxo_dl), abs(gxo_dr)));
gxo_pkO = max(gxo_pkO, max(abs(spl0), abs(spl1)));
0;
);

// ======================== gfx-headsmoother.jsfx (prefix sth_; its sliders 1-4 at 177-180) ========================
function sth_defaults() (
  slider(177) = 3;
  slider(178) = 0;
  slider(179) = 0;
  slider(180) = 0;
  0;
);
function sth_consts() (
  sth_own_s5 = 0;
  sth_own_s6 = 1;
  sth_own_s7 = 1;
  sth_own_s8 = 0;
  sth_own_s9 = 100;
  sth_own_s10 = 1;
  sth_own_s11 = 0;
  sth_own_s12 = 0;
  sth_own_s13 = 1;
  sth_own_s14 = 0;
  sth_own_s15 = 0;
  sth_own_s16 = 0;
  sth_own_s17 = 0.25;
  sth_own_s18 = 0;
  sth_own_s19 = 0;
  sth_own_s20 = 120;
  sth_own_s21 = 6000;
  sth_own_s22 = -0.3;
  sth_own_s23 = 1;
  sth_own_s24 = 0;
  0;
);
function sth_hs_bqset(sth_type, f, sth_q, sth_gdb, sth_fs) instance(b0, b1, b2, a1, a2) local(sth_w0, sth_cw, sth_sw, sth_al, sth_amp, sth_sa, n) (
  sth_w0 = 2 * $pi * min(f, sth_fs * 0.45) / sth_fs; sth_cw = cos(sth_w0); sth_sw = sin(sth_w0); sth_al = sth_sw / (2 * sth_q);
  sth_amp = 10 ^ (sth_gdb / 40);
  sth_type == 0 ? (                                    // low-pass
    n = 1 + sth_al; b0 = (1 - sth_cw) * 0.5 / n; b1 = (1 - sth_cw) / n; b2 = b0; a1 = -2 * sth_cw / n; a2 = (1 - sth_al) / n;
  ) : sth_type == 1 ? (                                // high-pass
    n = 1 + sth_al; b0 = (1 + sth_cw) * 0.5 / n; b1 = -(1 + sth_cw) / n; b2 = b0; a1 = -2 * sth_cw / n; a2 = (1 - sth_al) / n;
  ) : sth_type == 2 ? (                                // peak
    n = 1 + sth_al / sth_amp; b0 = (1 + sth_al * sth_amp) / n; b1 = -2 * sth_cw / n; b2 = (1 - sth_al * sth_amp) / n; a1 = b1; a2 = (1 - sth_al / sth_amp) / n;
  ) : (                                            // high shelf
    sth_sa = 2 * sqrt(sth_amp) * sth_al;
    n = (sth_amp + 1) - (sth_amp - 1) * sth_cw + sth_sa;
    b0 = sth_amp * ((sth_amp + 1) + (sth_amp - 1) * sth_cw + sth_sa) / n; b1 = -2 * sth_amp * ((sth_amp - 1) + (sth_amp + 1) * sth_cw) / n;
    b2 = sth_amp * ((sth_amp + 1) + (sth_amp - 1) * sth_cw - sth_sa) / n; a1 = 2 * ((sth_amp - 1) - (sth_amp + 1) * sth_cw) / n;
    a2 = ((sth_amp + 1) - (sth_amp - 1) * sth_cw - sth_sa) / n;
  );
);
function sth_hs_bqrun(sth_x) instance(b0, b1, b2, a1, a2, x1, x2, y1, y2) local(y) (
  y = b0 * sth_x + b1 * x1 + b2 * x2 - a1 * y1 - a2 * y2;
  x2 = x1; x1 = sth_x; y2 = y1; y1 = y;
  y;
);
function sth_tc(sth_ms) ( 1 - exp(-1 / (max(sth_ms, 0.05) * 0.001 * srate)); );
function sth_hd_aa() instance(sth_u1, sth_u2, sth_u3, sth_u4, sth_d1, sth_d2, sth_d3, sth_d4) local(sth_fc, sth_fs2) (
  sth_fs2 = 2 * srate; sth_fc = min(0.42 * srate, 20000);
  sth_u1.sth_hs_bqset(0, sth_fc, 0.5098, 0, sth_fs2); sth_u2.sth_hs_bqset(0, sth_fc, 0.6013, 0, sth_fs2);
  sth_u3.sth_hs_bqset(0, sth_fc, 0.9000, 0, sth_fs2); sth_u4.sth_hs_bqset(0, sth_fc, 2.5629, 0, sth_fs2);
  sth_d1.sth_hs_bqset(0, sth_fc, 0.5098, 0, sth_fs2); sth_d2.sth_hs_bqset(0, sth_fc, 0.6013, 0, sth_fs2);
  sth_d3.sth_hs_bqset(0, sth_fc, 0.9000, 0, sth_fs2); sth_d4.sth_hs_bqset(0, sth_fc, 2.5629, 0, sth_fs2);
);
function sth_hd_eq(sth_gapmul) instance(sth_emp, sth_dem, sth_vpre, sth_vpost, sth_bump, sth_gap, sth_dcb, sth_lop) (
  sth_emp.sth_hs_bqset(3, 3000, 0.7, 4, srate);  sth_dem.sth_hs_bqset(3, 3000, 0.7, -4, srate);
  sth_voice == 1 ? ( sth_vpre.sth_hs_bqset(2, 1400, 0.6, 3.5, srate); sth_vpost.sth_hs_bqset(2, 1400, 0.6, -1.5, srate); ) :
  sth_voice == 2 ? ( sth_vpre.sth_hs_bqset(3, 6000, 0.7, 5, srate);   sth_vpost.sth_hs_bqset(3, 6000, 0.7, -2, srate); ) :
               ( sth_vpre.sth_hs_bqset(2, 1000, 0.7, 0, srate);   sth_vpost.sth_hs_bqset(2, 1000, 0.7, 0, srate); );
  sth_bump.sth_hs_bqset(2, 70, 0.9, sth_hd_bump, srate);
  sth_gap.sth_hs_bqset(0, (sth_voice == 2 ? 21000 : sth_voice == 1 ? 18000 : 16000) * sth_gapmul, 0.55, 0, srate);
  sth_dcb.sth_hs_bqset(1, 10, 0.7, 0, srate);
  sth_lop.sth_hs_bqset(0, 250, 0.6, 0, srate);               // the low band that bypasses the curve
);
function sth_hd_sat(sth_x, b) local(sth_tb, sth_c) (
  sth_tb = ost_tanh(b);
  sth_c = 0.25 / ((ost_tanh(sth_hd_g * 0.125 + b) - sth_tb) - (ost_tanh(-sth_hd_g * 0.125 + b) - sth_tb));
  (ost_tanh(sth_hd_g * sth_x + b) - sth_tb) * sth_c;
);
function sth_hd_run(sth_x, b) instance(sth_emp, sth_dem, sth_vpre, sth_vpost, sth_bump, sth_gap, sth_dcb, sth_lop, sth_u1, sth_u2, sth_u3, sth_u4, sth_d1, sth_d2, sth_d3, sth_d4) local(y, sth_z, sth_lo) (
  sth_lo = sth_lop.sth_hs_bqrun(sth_x) * sth_hd_lb;                      // the part of the lows that bypasses the curve
  y = sth_vpre.sth_hs_bqrun(sth_emp.sth_hs_bqrun(sth_x - sth_lo)) * 0.5;       // into the curve with 6 dB of headroom
  // 2x: zero-stuffed upsample, filter, curve, filter, keep every second sample
  sth_z = sth_u4.sth_hs_bqrun(sth_u3.sth_hs_bqrun(sth_u2.sth_hs_bqrun(sth_u1.sth_hs_bqrun(y * 2))));
  sth_d4.sth_hs_bqrun(sth_d3.sth_hs_bqrun(sth_d2.sth_hs_bqrun(sth_d1.sth_hs_bqrun(sth_hd_sat(sth_z, b)))));
  sth_z = sth_u4.sth_hs_bqrun(sth_u3.sth_hs_bqrun(sth_u2.sth_hs_bqrun(sth_u1.sth_hs_bqrun(0))));
  y = sth_d4.sth_hs_bqrun(sth_d3.sth_hs_bqrun(sth_d2.sth_hs_bqrun(sth_d1.sth_hs_bqrun(sth_hd_sat(sth_z, b))))) * 2;
  sth_dcb.sth_hs_bqrun(sth_gap.sth_hs_bqrun(sth_bump.sth_hs_bqrun(sth_vpost.sth_hs_bqrun(sth_dem.sth_hs_bqrun(y)) + sth_lo * sth_hd_lg)));
);
function sth_head_proc(l, r) (
  sth_hon_s += (sth_own_s10 - sth_hon_s) * sth_sm;                // ON fades over ~30 ms (no click)
  sth_hl = sth_hL.sth_hd_run(l, sth_bL) * sth_trim_s; sth_hr = sth_hR.sth_hd_run(r, sth_bR) * sth_trim_s;
  sth_hl = l + (sth_hl - l) * sth_hon_s; sth_hr = r + (sth_hr - r) * sth_hon_s;
  sth_hpk = max(sth_hpk, max(abs(sth_hl), abs(sth_hr)));
);
function sth_gr_curve(sth_lv) local(sth_o) (
  sth_o = sth_lv - sth_thr;
  sth_o <= -sth_kn * 0.5 ? 0 :
  sth_o >= sth_kn * 0.5 ? sth_o * (1 - 1 / sth_ratio) :
  (1 - 1 / sth_ratio) * (sth_o + sth_kn * 0.5) ^ 2 / (2 * sth_kn);
);
function sth_colour(sth_x, sth_k, b) local(sth_tb) (
  sth_tb = ost_tanh(b);
  (ost_tanh(sth_k * sth_x + b) - sth_tb) / (sth_k * (1 - sth_tb * sth_tb));
);
function sth_smooth_proc(l, r) local(sth_dl, sth_dr, sth_lv, sth_tgt, sth_g, sth_yl, sth_yr) (
  sth_son_s += (sth_own_s11 - sth_son_s) * sth_sm;
  sth_dl = sth_scL.sth_hs_bqrun(l); sth_dr = sth_scR.sth_hs_bqrun(r);
  sth_env += (0.5 * (sth_dl * sth_dl + sth_dr * sth_dr) - sth_env) * sth_crms;
  sth_lv = 10 * log10(max(sth_env, 0.000000000001)) + 3;
  sth_tgt = sth_gr_curve(sth_lv);
  sth_hold += (sth_gr - sth_hold) * sth_chold;
  sth_tgt > sth_gr ? ( sth_gr += (sth_tgt - sth_gr) * sth_catt; sth_grpk = sth_gr; )
           : sth_gr += (sth_tgt - sth_gr) * sth_tc(sth_gr > sth_grpk * 0.6 ? sth_rel_ms * 0.3 : sth_rel_ms * (1 + 2 * min(sth_hold / 6, 1)));
  sth_g = 10 ^ (-sth_gr / 20);
  sth_grdisp = max(sth_grdisp, sth_gr * sth_son_s);
  sth_own_s13 ? ( sth_yl = sth_colour(l * sth_g * 0.5, sth_kL, sth_cbL) * 2; sth_yr = sth_colour(r * sth_g * 0.5, sth_kR, sth_cbR) * 2; )
           : ( sth_yl = l * sth_g; sth_yr = r * sth_g; );
  sth_cl = (l + (sth_yl - l) * sth_blend_s) * sth_mk_s; sth_cr = (r + (sth_yr - r) * sth_blend_s) * sth_mk_s;
  sth_cl = l + (sth_cl - l) * sth_son_s; sth_cr = r + (sth_cr - r) * sth_son_s;
  sth_spk = max(sth_spk, max(abs(sth_cl), abs(sth_cr)));
);
function sth_update() (
  sth_hd_g = 10 ^ (slider(177) * 2.2 / 20);
  sth_own_s18 = slider(180) * sth_own_s10;                  // Link saturation amount to BOOST, but only while Head is On -
                                                    // the output stage runs unconditionally, so otherwise BOOST
                                                    // kept leaking saturation into the signal even with Head off.
  sth_hd_b0 = (slider(180) / 100) * 0.2;                  // Scale tape asymmetry from BOOST (0 to 0.20)
  sth_hd_lb = (slider(177) / 10) ^ 1.2;                    // how much of the low band bypasses the curve
  // the bypassed lows rejoin at the curve's gain around 0 VU (-18 dBFS): between its quiet-signal gain
  // and its unity gain at -12 dBFS, so the low end keeps its place as the drive goes up
  sth_hd_c = 0.25 / ((ost_tanh(sth_hd_g * 0.125 + sth_hd_b0) - ost_tanh(sth_hd_b0)) - (ost_tanh(-sth_hd_g * 0.125 + sth_hd_b0) - ost_tanh(sth_hd_b0)));
  sth_hd_lg = sqrt(sth_hd_g * sth_hd_c * (1 - ost_tanh(sth_hd_b0) ^ 2));
  sth_hd_bump = 1.5 * (1 - 0.5 * slider(177) / 10);        // a gentler head bump as the drive goes up
  sth_voice = slider(179);
  sth_trim_t = 10 ^ (slider(178) / 20);
  sth_thr = 0;
  sth_mk_t = 10 ^ (sth_own_s5 / 20);
  sth_ratio = sth_own_s8 ? 20 : 3; sth_kn = sth_own_s8 ? 2 : 12;
  sth_att_ms = (sth_own_s6 == 0 ? 25 : sth_own_s6 == 1 ? 8 : 1.5) * (sth_own_s8 ? 0.5 : 1);
  sth_rel_ms = sth_own_s7 == 0 ? 900 : sth_own_s7 == 1 ? 350 : 90;
  sth_catt = sth_tc(sth_att_ms);
  sth_blend_t = sth_own_s9 / 100;
  drift_macro(0);                 // DRIFT dial: 50% = the drift settings, 100% = twice, 0 = none
  sth_drift = sth_own_s16 / 100 * sth_own_dm_a; sth_dspd = sth_own_s17 * sth_own_dm_s;
  0;
  0;   // output stage: CLIP, always on
);
function sth_init() (
#sth_own_ui_man = "gfx-headsmoother";                                  // the ? pop-up links to this manual

// ---------- biquads (RBJ); fs = the rate the filter runs at ----------




// ================= HEAD: tape stage (as GFX Head) =================

// voicing + tape EQ (the gap loss follows this side's drift)

// the curve: tanh with a small fixed bias ("tight bias"): mostly odd harmonics with a little even-order
// warmth that no longer grows with the drive. The gain is set so a signal peaking around -12 dBFS comes
// out at the same level whatever the drive: DRIVE changes the character, not the loudness.

// The lows are split off with a complementary filter (low + rest = the input exactly); as DRIVE goes up,
// more of the low band skips the curve and rejoins untouched afterwards, so the bass stops pushing the
// mids and highs in and out of saturation (no "clumping").

// the whole unit, stereo: result in hl / hr


// ================= SMOOTH: optical compressor (as GFX Smooth) =================


// result in cl / cr




sth_sm = sth_tc(30);
sth_hL.sth_hd_aa(); sth_hR.sth_hd_aa();
sth_scL.sth_hs_bqset(1, 80, 0.70710678, 0, srate); sth_scR.sth_hs_bqset(1, 80, 0.70710678, 0, srate);
sth_crms = sth_tc(5); sth_chold = sth_tc(1500);
sth_dBL.drift_init(0.8 + rand(0.5)); sth_dBR.drift_init(0.8 + rand(0.5));      // head: bias
sth_dGL.drift_init(0.8 + rand(0.5)); sth_dGR.drift_init(0.8 + rand(0.5));      // head: gap loss
sth_dKL.drift_init(0.8 + rand(0.5)); sth_dKR.drift_init(0.8 + rand(0.5));      // smooth: colour drive
sth_dCL.drift_init(0.8 + rand(0.5)); sth_dCR.drift_init(0.8 + rand(0.5));      // smooth: colour asymmetry
0; 0; 0;
0;
sth_env = 0; sth_gr = 0; sth_grpk = 0; sth_hold = 0; sth_grdisp = 0; sth_hpk = 0; sth_spk = 0;
!sth_ui_dflt ? sth_own_ui_hw = 1; !sth_ui_dflt ? sth_own_ui_kstyle = 0;
sth_update();
sth_trim_s = sth_trim_t; sth_mk_s = sth_mk_t; sth_blend_s = sth_blend_t; sth_hon_s = sth_own_s10; sth_son_s = sth_own_s11;
sth_ui_dflt = 1;   // theme defaults above apply once: @init re-runs (playback start, device reset) must not undo the saved theme
0;
);

function sth_slider() (
sth_update();
0;
);

function sth_block() (
sth_update();
sth_dinc = sth_dspd * samplesblock / srate;
sth_vbL = sth_dBL.drift_tick(sth_dinc); sth_vbR = sth_dBR.drift_tick(sth_dinc);
sth_vgL = sth_dGL.drift_tick(sth_dinc); sth_vgR = sth_dGR.drift_tick(sth_dinc);
sth_bL = sth_hd_b0 + sth_vbL * sth_drift * 0.06; sth_bR = sth_hd_b0 + sth_vbR * sth_drift * 0.06;
sth_hL.sth_hd_eq(2 ^ (sth_vgL * sth_drift * 0.25)); sth_hR.sth_hd_eq(2 ^ (sth_vgR * sth_drift * 0.25));
sth_vkL = sth_dKL.drift_tick(sth_dinc); sth_vkR = sth_dKR.drift_tick(sth_dinc);
sth_vcL = sth_dCL.drift_tick(sth_dinc); sth_vcR = sth_dCR.drift_tick(sth_dinc);
sth_kL = 1.2 * (1 + 0.6 * sth_drift * sth_vkL); sth_kR = 1.2 * (1 + 0.6 * sth_drift * sth_vkR);
sth_cbL = 0.05 + 0.08 * sth_drift * sth_vcL;    sth_cbR = 0.05 + 0.08 * sth_drift * sth_vcR;
0;
);

function sth_sample() (
sth_trim_s += (sth_trim_t - sth_trim_s) * sth_sm; sth_mk_s += (sth_mk_t - sth_mk_s) * sth_sm; sth_blend_s += (sth_blend_t - sth_blend_s) * sth_sm;
sth_own_s12 ? (
  sth_head_proc(spl0, spl1); sth_smooth_proc(sth_hl, sth_hr); sth_oL = sth_cl; sth_oR = sth_cr;
) : (
  sth_smooth_proc(spl0, spl1); sth_head_proc(sth_cl, sth_cr); sth_oL = sth_hl; sth_oR = sth_hr;
);
sth_oL = (sth_oL); sth_oR = (sth_oR);
(ost_l = (sth_oL); ost_r = (sth_oR));
spl0 = ost_l;
spl1 = ost_r;
0;
);

// ======================== gfx-ts7.jsfx (prefix tsv_; its sliders 2-11 at 196-205) ========================
function tsv_defaults() (
  slider(196) = 0;
  slider(197) = 0;
  slider(198) = 0;
  slider(199) = 0;
  slider(200) = 1;
  slider(201) = 100;
  slider(202) = 0;
  slider(203) = 1;
  slider(204) = 1;
  slider(205) = 0;
  0;
);
function tsv_consts() (
  tsv_own_s1 = 0;
  slider(202) = 0;
  slider(205) = 0;
  0;
);
function tsv_alloc(n) local(p) ( p = tsv_nextmem; tsv_nextmem += n; memset(p, 0, n); p; );
function tsv_db2g(d) ( exp(d*0.11512925465); );
function tsv_g2db(g) ( 8.68588963807*log(max(g, 0.0000000001)); );
function tsv_tanh(tsv_v) ( tsv_v = max(-20, min(20, tsv_v)); 1 - 2/(exp(2*tsv_v) + 1); );
function tsv_bi0(tsv_x) local(s, t, tsv_k) ( s = 1; t = 1; tsv_k = 1; loop(30, t *= (tsv_x/(2*tsv_k))^2; s += t; tsv_k += 1; ); s; );
function tsv_hb_design(h, n, tsv_beta) local(tsv_c, t, tsv_k, tsv_w, tsv_x, tsv_se, tsv_i0) (
  tsv_c = (n - 1)/2; tsv_i0 = tsv_bi0(tsv_beta); t = 0;
  loop(n,
    tsv_k = t - tsv_c; tsv_x = 2*t/(n - 1) - 1;
    tsv_w = tsv_bi0(tsv_beta*sqrt(max(0, 1 - tsv_x*tsv_x)))/tsv_i0;
    h[t] = tsv_k == 0 ? 0.5 : sin($pi*tsv_k/2)/($pi*tsv_k)*tsv_w;
    t += 1;
  );
  tsv_se = 0; t = 0; loop((n + 1)/2, tsv_se += h[2*t]; t += 1; );
  t = 0; loop((n + 1)/2, h[2*t] *= 0.5/tsv_se; t += 1; );          // each polyphase branch: unity at DC
);
function tsv_hbu_init(n, h, tsv_sz) instance(tsv_buf, tsv_m, tsv_w, tsv_hh, tsv_nt, tsv_cc) ( tsv_buf = tsv_alloc(tsv_sz); tsv_m = tsv_sz - 1; tsv_w = 0; tsv_hh = h; tsv_nt = n; tsv_cc = (n - 1)/2; );
function tsv_hbu(tsv_x) instance(tsv_buf, tsv_m, tsv_w, tsv_hh, tsv_nt, tsv_cc, tsv_o0, tsv_o1) local(j, s) (
  tsv_w = (tsv_w + 1) & tsv_m; tsv_buf[tsv_w] = tsv_x;
  s = 0; j = 0; loop((tsv_nt + 1)/2, s += tsv_hh[2*j]*tsv_buf[(tsv_w - j) & tsv_m]; j += 1; );
  tsv_o0 = 2*s; tsv_o1 = tsv_buf[(tsv_w - (tsv_cc - 1)/2) & tsv_m];
);
function tsv_hbd_init(n, h, tsv_sz) instance(tsv_buf, tsv_m, tsv_w, tsv_hh, tsv_nt, tsv_cc) ( tsv_buf = tsv_alloc(tsv_sz); tsv_m = tsv_sz - 1; tsv_w = 0; tsv_hh = h; tsv_nt = n; tsv_cc = (n - 1)/2; );
function tsv_hbd(tsv_x0, x1) instance(tsv_buf, tsv_m, tsv_w, tsv_hh, tsv_nt, tsv_cc) local(j, s) (
  tsv_w = (tsv_w + 1) & tsv_m; tsv_buf[tsv_w] = tsv_x0; tsv_w = (tsv_w + 1) & tsv_m; tsv_buf[tsv_w] = x1;
  s = 0; j = 0; loop((tsv_nt + 1)/2, s += tsv_hh[2*j]*tsv_buf[(tsv_w - 2*j) & tsv_m]; j += 1; );
  s + 0.5*tsv_buf[(tsv_w - tsv_cc) & tsv_m];
);
function tsv_iron(tsv_x) instance(tsv_lp, env, tsv_dx, tsv_dy) local(tsv_lo, b, y) (
  env += (abs(tsv_x) - env)*(abs(tsv_x) > env ? tsv_irA : tsv_irR);
  tsv_lp += (tsv_x - tsv_lp)*tsv_irC;
  b = 0.06 + 0.24*min(1, env) + tsv_irBw;                // the asymmetry grows with level (+ the supply wander)
  tsv_lo = (tsv_tanh(tsv_lp*1.6*tsv_irDw + b) - tsv_tanh(b))/(1.6*tsv_irDw);  // the low band saturates the core first
  y = tsv_lo + (tsv_x - tsv_lp);
  y = (tsv_tanh(y*0.85 + 0.5*b) - tsv_tanh(0.5*b))/0.85;     // gentle whole-band asymmetric soft clip
  tsv_dy = y - tsv_dx + tsv_dcR*tsv_dy; tsv_dx = y;                      // the bias leaves no DC
  tsv_dy;
);
function tsv_proc(l, r) local(e, tsv_lev, tsv_over, tsv_gt, g, d, tsv_pl_, tsv_pr_, tsv_ms_) (
  tsv_ironOn ? ( l = tsv_irL.tsv_iron(l); r = tsv_irR.tsv_iron(r); );
  // WARMTH: linked HF side-chain, fast down, slow back
  tsv_wLpL += (l - tsv_wLpL)*tsv_wmC; tsv_wLpR += (r - tsv_wLpR)*tsv_wmC;
  tsv_wmOn ? (
    e = max(abs(l - tsv_wLpL), abs(r - tsv_wLpR));
    tsv_wmE += (e - tsv_wmE)*(e > tsv_wmE ? tsv_wmA : tsv_wmR);
    tsv_gt = min(14, max(0, tsv_g2db(tsv_wmE) - tsv_wmThr)*0.67);
    tsv_wmG += (tsv_gt - tsv_wmG)*(tsv_gt > tsv_wmG ? tsv_wmGA : tsv_wmGR);
    g = tsv_db2g(-tsv_wmG);
    l = tsv_wLpL + (l - tsv_wLpL)*g; r = tsv_wLpR + (r - tsv_wLpR)*g;
  ) : tsv_wmG = 0;
  tsv_pl_ = l; tsv_pr_ = r;
  // COMP
  tsv_cMode ? (
    e = tsv_cFb ? max(abs(tsv_cYL), abs(tsv_cYR)) : max(abs(l), abs(r));
    tsv_cPk ? tsv_ms_ = e*e : ( tsv_cMs += (e*e - tsv_cMs)*tsv_cRms; tsv_ms_ = tsv_cMs; );
    tsv_lev = 10*log10(max(tsv_ms_, 0.0000000001));
    tsv_over = tsv_lev - tsv_cThr;
    tsv_cFb ? tsv_gt = max(0, tsv_over)*tsv_cSlope : (
      tsv_gt = tsv_over <= -tsv_cKn*0.5 ? 0 : tsv_over >= tsv_cKn*0.5 ? tsv_over*tsv_cSlope : tsv_cSlope*(tsv_over + tsv_cKn*0.5)^2/(2*tsv_cKn);
    );
    tsv_gt = min(tsv_gt, 30);
    tsv_cGf += (tsv_gt - tsv_cGf)*(tsv_gt > tsv_cGf ? tsv_cAf : tsv_cRf);         // fast envelope: the peaks
    tsv_cGs += (tsv_gt - tsv_cGs)*(tsv_gt > tsv_cGs ? tsv_cAs : tsv_cRs);         // slow envelope: the body
    tsv_cGr = max(tsv_cGf, tsv_cGs);
    g = tsv_db2g(-tsv_cGr);
    l *= g; r *= g;
    tsv_cYL = l; tsv_cYR = r;                               // SLAM's feedback detector listens here (before make-up)
    g = tsv_db2g(tsv_cMk); l *= g; r *= g;
    d = tsv_cDrv;
    l = (tsv_tanh(l*d + tsv_cBias) - tsv_tanh(tsv_cBias))/d; r = (tsv_tanh(r*d + tsv_cBias) - tsv_tanh(tsv_cBias))/d;
    l = tsv_pl_ + (l - tsv_pl_)*tsv_mix; r = tsv_pr_ + (r - tsv_pr_)*tsv_mix;
  ) : ( tsv_cGr = 0; tsv_cGf = tsv_cGs = 0; );
  tsv_pOL = l; tsv_pOR = r;
);
function tsv_setup() local(tsv_fso) (
  tsv_os4 = slider(204) > 0.5; tsv_osf = tsv_os4 ? 4 : 2; tsv_fso = srate*tsv_osf;
  tsv_inG = tsv_db2g(slider(196)); tsv_outG = tsv_db2g(slider(197));
  tsv_ironOn = slider(200) > 0.5;
  tsv_irC = 1 - exp(-2*$pi*120/tsv_fso); tsv_irA = 1 - exp(-1/(0.002*tsv_fso)); tsv_irR = 1 - exp(-1/(0.2*tsv_fso)); tsv_dcR = exp(-2*$pi*8/tsv_fso);
  tsv_wmL = floor(slider(198) + 0.5); tsv_wmOn = tsv_wmL > 0;
  tsv_wmThr = -6 - 4*(tsv_wmL - 1);
  tsv_wmC = 1 - exp(-2*$pi*3500/tsv_fso);
  tsv_wmA = 1 - exp(-1/(0.0003*tsv_fso)); tsv_wmR = 1 - exp(-1/(0.03*tsv_fso));
  tsv_wmGA = 1 - exp(-1/(0.0005*tsv_fso)); tsv_wmGR = 1 - exp(-1/(0.12*tsv_fso));
  tsv_cMode = floor(slider(199) + 0.5);
  // thr, ratio, knee, attack ms, fast rel ms, slow rel ms, rms ms (0 = peak), make-up, drive, bias, feedback
  tsv_cMode == 1 ? ( tsv_cThr = -14; tsv_cR = 2;  tsv_cKn = 10; tsv_cAt = 8;   tsv_cRF = 150; tsv_cRS = 1200; tsv_cRm = 10; tsv_cMk = 3;  tsv_cDrv = 1.6; tsv_cBias = 0.06; tsv_cFb = 0; ) :
  tsv_cMode == 2 ? ( tsv_cThr = -18; tsv_cR = 3;  tsv_cKn = 6;  tsv_cAt = 15;  tsv_cRF = 120; tsv_cRS = 900;  tsv_cRm = 5;  tsv_cMk = 5;  tsv_cDrv = 1.1; tsv_cBias = 0.03; tsv_cFb = 0; ) :
  tsv_cMode == 3 ? ( tsv_cThr = -24; tsv_cR = 6;  tsv_cKn = 0;  tsv_cAt = 0.1; tsv_cRF = 40;  tsv_cRS = 250;  tsv_cRm = 0;  tsv_cMk = 12; tsv_cDrv = 2.2; tsv_cBias = 0.08; tsv_cFb = 1; );
  tsv_cSlope = tsv_cFb ? tsv_cR - 1 : 1 - 1/tsv_cR;
  tsv_cPk = tsv_cRm == 0; tsv_cRms = 1 - exp(-1/(max(tsv_cRm, 0.1)*0.001*tsv_fso));
  tsv_cAf = 1 - exp(-1/(tsv_cAt*0.001*tsv_fso)); tsv_cAs = 1 - exp(-1/(tsv_cAt*5*0.001*tsv_fso));
  tsv_cRf = 1 - exp(-1/(tsv_cRF*0.001*tsv_fso)); tsv_cRs = 1 - exp(-1/(tsv_cRS*0.001*tsv_fso));
  tsv_mix = slider(201)/100;
  tsv_byp = slider(202) > 0.5;
  tsv_osLat = tsv_os4 ? 36 : 31;
  0;   // output stage: straight through
  tsv_own_pdc_delay = tsv_osLat; tsv_own_pdc_bot = 0; tsv_own_pdc_top = 2;
);
function tsv_pset(i, o, tsv_w, tsv_c, tsv_ir, tsv_m) ( slider(196) = i; slider(197) = o; slider(198) = tsv_w; slider(199) = tsv_c; slider(200) = tsv_ir; slider(201) = tsv_m; );
function tsv_apply_preset(n) (
  tsv_t7_dst = 1;                                 // duck the output, swap the settings at silence, fade back in
  tsv_pset(0, 0, 0, 0, 1, 100); slider(202) = 0;
  n == 1 ? tsv_pset(3, -2, 2, 2, 1, 100) :      // Tape Glue Bus
  n == 2 ? tsv_pset(6, -4, 3, 3, 1, 100) :      // Drum Slam
  n == 3 ? tsv_pset(4, -2, 2, 1, 1, 100) :      // Vocal Tx
  n == 4 ? tsv_pset(2, -1, 1, 2, 1, 60) :       // Warm Master
  n == 5 ? tsv_pset(8, -6, 0, 1, 1, 100) :      // Bass Iron
  n == 6 ? tsv_pset(8, -3, 2, 3, 1, 35) :       // Parallel Smash
  n == 7 ? tsv_pset(12, -8, 6, 3, 1, 100);      // Lo-Fi Tape
);
function tsv_pname(n) (
  n == 0 ? "INIT" : n == 1 ? "TAPE GLUE BUS" : n == 2 ? "DRUM SLAM" : n == 3 ? "VOCAL TX" :
  n == 4 ? "WARM MASTER" : n == 5 ? "BASS IRON" : n == 6 ? "PARALLEL SMASH" : "LO-FI TAPE";
);
function tsv_init() (
#tsv_own_ui_man = "gfx-ts7";
tsv_nextmem = 1400000;





// ---------- oversampling: linear-phase halfband filters (Kaiser windowed) ----------


// up 2x: one input sample -> o0, o1 (polyphase; the odd branch is a pure delay in a halfband)


// down 2x: two input samples -> one output


tsv_N1 = 63; tsv_N2 = 23;
tsv_H1 = tsv_alloc(tsv_N1); tsv_H2 = tsv_alloc(tsv_N2);
tsv_hb_design(tsv_H1, tsv_N1, 8); tsv_hb_design(tsv_H2, tsv_N2, 7);
tsv_uL1.tsv_hbu_init(tsv_N1, tsv_H1, 64); tsv_uR1.tsv_hbu_init(tsv_N1, tsv_H1, 64); tsv_dL1.tsv_hbd_init(tsv_N1, tsv_H1, 64); tsv_dR1.tsv_hbd_init(tsv_N1, tsv_H1, 64);
tsv_uL2.tsv_hbu_init(tsv_N2, tsv_H2, 16); tsv_uR2.tsv_hbu_init(tsv_N2, tsv_H2, 16); tsv_dL2.tsv_hbd_init(tsv_N2, tsv_H2, 32); tsv_dR2.tsv_hbd_init(tsv_N2, tsv_H2, 32);
tsv_BPN = 64; tsv_BPL = tsv_alloc(tsv_BPN); tsv_BPR = tsv_alloc(tsv_BPN); tsv_bpw = 0;      // latency-matched dry for BYPASS
0;

// ---------- stage A: the transformer ----------


// ---------- one oversampled sample through IRON -> WARMTH -> COMP (+ MIX) ----------


// ---------- parameters ----------


// ---------- presets: input, output, warmth, comp, iron, mix ----------




tsv_TH = tsv_alloc(16); tsv_CL = tsv_alloc(16); tsv_LB = tsv_alloc(16);       // GUI tables
tsv_irDw = 1; tsv_irBw = 0; tsv_drA = tsv_drB = 0; tsv_drSa = tsv_drSb = tsv_drTa = tsv_drTb = 0;
tsv_bpS = 0; mIn = tsv_mOut = 0; tsv_mWm = tsv_mGr = 0;
tsv_mDec = exp(-1/(0.3*srate));
!tsv_ui_dflt ? ( tsv_own_ui_hw = 1; tsv_lastPreset = tsv_own_s1; );
tsv_ui_dflt = 1;
tsv_setup();
tsv_t7_dkr = 1 / (0.012*srate); tsv_t7_dk = 1; tsv_t7_dst = 0;   // preset duck: 12 ms out, hold through the latency, 12 ms in
0;
);

function tsv_slider() (
tsv_own_s1 != tsv_lastPreset ? ( tsv_apply_preset(tsv_own_s1); tsv_lastPreset = tsv_own_s1; );
tsv_t7_dst != 1 ? tsv_setup();                        // during a preset duck the swap applies the new settings
0;
);

function tsv_block() (
tsv_t7_dst != 1 ? tsv_setup();
// DRIFT: an uneven supply under the iron - two slow random walks (drive, asymmetry), level-neutral
tsv_drA -= samplesblock; tsv_drA <= 0 ? ( tsv_drA = srate*(0.6 + rand(1.4)); tsv_drTa = rand(2) - 1; );
tsv_drB -= samplesblock; tsv_drB <= 0 ? ( tsv_drB = srate*(0.25 + rand(0.5)); tsv_drTb = rand(2) - 1; );
tsv_drSa += (tsv_drTa - tsv_drSa)*min(1, samplesblock/(0.5*srate)); tsv_drSb += (tsv_drTb - tsv_drSb)*min(1, samplesblock/(0.15*srate));
tsv_drAmt = slider(205)/100;
tsv_irDw = 1 + tsv_drAmt*(0.10*tsv_drSa + 0.03*tsv_drSb); tsv_irBw = tsv_drAmt*(0.03*tsv_drSa + 0.015*tsv_drSb);
0;
);

function tsv_sample() (
// preset duck-and-swap: comp mode, warmth, levels and oversampling change in silence
tsv_t7_dst == 1 ? ( tsv_t7_dk -= tsv_t7_dkr; tsv_t7_dk <= 0 ? ( tsv_t7_dk = 0; tsv_setup(); tsv_t7_hc = tsv_osLat + floor(0.002*srate); tsv_t7_dst = 2; ); ) :
tsv_t7_dst == 2 ? ( tsv_t7_hc > 0 ? tsv_t7_hc -= 1 : ( tsv_t7_dk += tsv_t7_dkr; tsv_t7_dk >= 1 ? ( tsv_t7_dk = 1; tsv_t7_dst = 0; ); ); );
tsv_xL = spl0*tsv_inG; tsv_xR = spl1*tsv_inG;
tsv_a_ = max(abs(tsv_xL), abs(tsv_xR)); mIn = tsv_a_ > mIn ? tsv_a_ : mIn*tsv_mDec;
// latency-matched dry for BYPASS
tsv_bpw = (tsv_bpw + 1) & (tsv_BPN - 1); tsv_BPL[tsv_bpw] = spl0; tsv_BPR[tsv_bpw] = spl1;
tsv_dryL = tsv_BPL[(tsv_bpw - tsv_osLat) & (tsv_BPN - 1)]; tsv_dryR = tsv_BPR[(tsv_bpw - tsv_osLat) & (tsv_BPN - 1)];

tsv_uL1.tsv_hbu(tsv_xL); tsv_uR1.tsv_hbu(tsv_xR);
!tsv_os4 ? (
  tsv_proc(tsv_uL1.tsv_o0, tsv_uR1.tsv_o0); tsv_q0L = tsv_pOL; tsv_q0R = tsv_pOR;
  tsv_proc(tsv_uL1.tsv_o1, tsv_uR1.tsv_o1);
  tsv_yL = tsv_dL1.tsv_hbd(tsv_q0L, tsv_pOL); tsv_yR = tsv_dR1.tsv_hbd(tsv_q0R, tsv_pOR);
) : (
  tsv_a1L = tsv_uL1.tsv_o1; tsv_a1R = tsv_uR1.tsv_o1;
  tsv_uL2.tsv_hbu(tsv_uL1.tsv_o0); tsv_uR2.tsv_hbu(tsv_uR1.tsv_o0);
  tsv_proc(tsv_uL2.tsv_o0, tsv_uR2.tsv_o0); tsv_q0L = tsv_pOL; tsv_q0R = tsv_pOR;
  tsv_proc(tsv_uL2.tsv_o1, tsv_uR2.tsv_o1);
  tsv_h0L = tsv_dL2.tsv_hbd(tsv_q0L, tsv_pOL); tsv_h0R = tsv_dR2.tsv_hbd(tsv_q0R, tsv_pOR);
  tsv_uL2.tsv_hbu(tsv_a1L); tsv_uR2.tsv_hbu(tsv_a1R);
  tsv_proc(tsv_uL2.tsv_o0, tsv_uR2.tsv_o0); tsv_q0L = tsv_pOL; tsv_q0R = tsv_pOR;
  tsv_proc(tsv_uL2.tsv_o1, tsv_uR2.tsv_o1);
  tsv_h1L = tsv_dL2.tsv_hbd(tsv_q0L, tsv_pOL); tsv_h1R = tsv_dR2.tsv_hbd(tsv_q0R, tsv_pOR);
  tsv_yL = tsv_dL1.tsv_hbd(tsv_h0L, tsv_h1L); tsv_yR = tsv_dR1.tsv_hbd(tsv_h0R, tsv_h1R);
);
tsv_mWm = max(tsv_mWm*tsv_mDec, tsv_wmG); tsv_mGr = max(tsv_mGr*tsv_mDec, tsv_cGr);

tsv_yL *= tsv_outG; tsv_yR *= tsv_outG;
tsv_t7_dst ? ( tsv_t7_dkg = tsv_t7_dk*tsv_t7_dk*(3 - 2*tsv_t7_dk); tsv_yL *= tsv_t7_dkg; tsv_yR *= tsv_t7_dkg; );
tsv_bpS += ((tsv_byp ? 1 : 0) - tsv_bpS)*0.002;
tsv_yL += (tsv_dryL - tsv_yL)*tsv_bpS; tsv_yR += (tsv_dryR - tsv_yR)*tsv_bpS;
(ost_l = (tsv_yL); ost_r = (tsv_yR));
spl0 = ost_l; spl1 = ost_r;
tsv_a_ = max(abs(spl0), abs(spl1)); tsv_mOut = tsv_a_ > tsv_mOut ? tsv_a_ : tsv_mOut*tsv_mDec;
0;
);


// ======================== the strip ========================
