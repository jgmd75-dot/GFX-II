);
function eqt_tq_gl(t) instance(v, eqt_w) ( v != t || eqt_w != t ? ( eqt_w += (t - eqt_w) * eqt_tq_kG; v += (eqt_w - v) * eqt_tq_kG;
  abs(v - t) < 0.0005 && abs(eqt_w - t) < 0.0005 ? v = eqt_w = t; eqt_tq_mv = 1; ); v; );
function eqt_tq_glf(t) instance(v, eqt_w) ( v != t || eqt_w != t ? ( eqt_w *= (t / eqt_w) ^ eqt_tq_kF; v *= (eqt_w / v) ^ eqt_tq_kF;
  abs(v / t - 1) < 0.0002 && abs(eqt_w / t - 1) < 0.0002 ? v = eqt_w = t; eqt_tq_mv = 1; ); v; );
function eqt_tq_gli(t) instance(v, eqt_w) ( v = eqt_w = t; );
function eqt_tq_eng(b, eqt_ny, eqt_cl, eqt_cr) instance(eqt_lf, eqt_lg, eqt_mf, eqt_mg, eqt_hf, eqt_hg, eqt_ls, eqt_lw, eqt_hs, eqt_hw, eqt_hp, eqt_lp, eqt_h18, eqt_l18, eqt_dr, eqt_tr, init, eqt_mv, eqt_df, eqt_hwt, eqt_lwt, eqt_sn,
  eqt_glf, eqt_glg, eqt_gmf, eqt_gmg, eqt_ghf, eqt_ghg, eqt_ghp, eqt_glp, eqt_gdr, eqt_gtr)
  local(eqt_eq, eqt_tlf, eqt_tlg, eqt_tmf, eqt_tmg, eqt_thf, eqt_thg, eqt_tls, eqt_ths, eqt_thp, eqt_tlp, eqt_hon, eqt_lon, eqt_t18h, eqt_t18l, eqt_tdr, eqt_ttr, eqt_on, g, t, eqt_x) (
  this.eqt_ny = eqt_ny;
  eqt_eq = slider(26) >= 0.5;
  eqt_ny ? (
    eqt_tlf = eqt_tq_fnl(slider(24 + b + 1)); eqt_tlg = eqt_tq_gny(slider(24 + b + 2)); eqt_tmf = eqt_tq_fnm(slider(24 + b + 4)); eqt_tmg = eqt_tq_gny(slider(24 + b + 5));
    eqt_thf = eqt_tq_fnh(slider(24 + b + 6)); eqt_thg = eqt_tq_gny(slider(24 + b + 7));
  ) : (
    eqt_tlf = eqt_tq_ftl(slider(24 + b + 1)); eqt_tlg = eqt_tq_gtk(slider(24 + b + 2)); eqt_tmf = eqt_tq_ftm(slider(24 + b + 4)); eqt_tmg = eqt_tq_gtk(slider(24 + b + 5));
    eqt_thf = eqt_tq_fth(slider(24 + b + 6)); eqt_thg = eqt_tq_gtk(slider(24 + b + 7));
  );
  eqt_tlg *= eqt_eq; eqt_tmg *= eqt_eq; eqt_thg *= eqt_eq;
  eqt_tls = slider(24 + b + 3) >= 0.5; eqt_ths = slider(24 + b + 8) >= 0.5;
  t = slider(24 + b + 9);  eqt_hon = t > 20.5;  eqt_thp = eqt_hon ? min(t, 400) : 10;
  t = slider(24 + b + 11); eqt_lon = t < 21990; eqt_tlp = eqt_lon ? max(t, 3000) : eqt_tq_lpoff;
  eqt_t18h = slider(24 + b + 10) >= 0.5; eqt_t18l = slider(24 + b + 12) >= 0.5;
  eqt_tdr = min(max(slider(24 + b), 0), 24); eqt_ttr = exp(min(max(slider(24 + b + 13), -12), 12) * 0.115129255);
  init ? (
    eqt_glf.eqt_tq_gli(eqt_tlf); eqt_glg.eqt_tq_gli(eqt_tlg); eqt_gmf.eqt_tq_gli(eqt_tmf); eqt_gmg.eqt_tq_gli(eqt_tmg); eqt_ghf.eqt_tq_gli(eqt_thf); eqt_ghg.eqt_tq_gli(eqt_thg);
    eqt_ghp.eqt_tq_gli(eqt_thp); eqt_glp.eqt_tq_gli(eqt_tlp); eqt_gdr.eqt_tq_gli(eqt_tdr); eqt_gtr.eqt_tq_gli(eqt_ttr);
    eqt_ls = eqt_tls; eqt_hs = eqt_ths; eqt_lw = eqt_hw = 1; eqt_h18 = eqt_t18h; eqt_l18 = eqt_t18l;
    eqt_cl[96] = eqt_cr[96] = eqt_hon; eqt_cl[98] = eqt_cr[98] = eqt_lon; eqt_cl[97] = eqt_cr[97] = eqt_h18; eqt_cl[99] = eqt_cr[99] = eqt_l18;
    eqt_hwt = eqt_cl[116] = eqt_cr[116] = eqt_hon; eqt_lwt = eqt_cl[118] = eqt_cr[118] = eqt_lon; eqt_sn = 112;
    eqt_cl[103] = eqt_cr[103] = exp(eqt_tdr * 0.115129255); eqt_cl[104] = eqt_cr[104] = eqt_ttr;
    init = 0; eqt_mv = 1;
  );
  eqt_tq_mv = 0;
  // ---- glides: frequencies (log, about 30 ms), gains (about 20 ms), drive, trim
  eqt_lf = eqt_glf.eqt_tq_glf(eqt_tlf); eqt_mf = eqt_gmf.eqt_tq_glf(eqt_tmf); eqt_hf = eqt_ghf.eqt_tq_glf(eqt_thf);
  eqt_lg = eqt_glg.eqt_tq_gl(eqt_tlg);  eqt_mg = eqt_gmg.eqt_tq_gl(eqt_tmg);  eqt_hg = eqt_ghg.eqt_tq_gl(eqt_thg);
  eqt_hp = eqt_ghp.eqt_tq_glf(eqt_thp); eqt_lp = eqt_glp.eqt_tq_glf(eqt_tlp);
  eqt_dr = eqt_gdr.eqt_tq_gl(eqt_tdr);  eqt_x = eqt_tq_mv; eqt_tr = eqt_gtr.eqt_tq_gl(eqt_ttr); eqt_tq_mv = eqt_x;
