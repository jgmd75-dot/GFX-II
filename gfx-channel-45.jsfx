);
function eqt_tq_noutfl() instance(eqt_v0, eqt_m2, eqt_ys, ph, eqt_sp, eqt_bm, eqt_ap1, eqt_ap2) (
  eqt_bm.eqt_tq_fl(); eqt_ap1.eqt_tq_fl(); eqt_ap2.eqt_tq_fl();
