// ======================== EQ ========================
md(326, 58, 308, 554, "EQ"); md_in(596, 58, 6);
ek(334, 82, 94, 5, 0, "TONY Q"); ek(432, 82, 94, 5, 1, "BOARD"); ek(530, 82, 96, 5, 2, "SKYE");
eq_ = slider5 | 0;
// four rows (FREQ, GAIN, and a Q / BW where the engine has one), keys on the right, extras at the foot
R1 = 160; R2 = 260; R3 = 360; R4 = 460; RX = 560;
X1 = 392; X2 = 460; X3 = 528; XK = 568;
ui_cola(RULE, 0.8); gi = 0; loop(4, gfx_rect(334 * sc, (R1 + 48 + gi * 100) * sc, 292 * sc, 1 * sc); gi += 1; );
eq_ == 0 ? (
  // ---- TONY Q: the city's three bands, its DRIVE and OUTPUT; TOKYO / NEW YORK
  ny_ = slider25 >= 0.5; b_ = ny_ ? 43 : 29;
  rowlbl(350, R1, "HIGH"); rowlbl(350, R2, "MID"); rowlbl(350, R3, "LOW");
  ny_ ? (
    #tf_h = "5 kHz|7 kHz|10 kHz|12.5 kHz|15 kHz"; #tf_m = "400 Hz|800 Hz|1.5 kHz|3 kHz|5 kHz"; #tf_l = "50 Hz|100 Hz|200 Hz|300 Hz|400 Hz";
    #tg = "-12 dB|-9 dB|-6 dB|-4 dB|-2 dB|0 dB|+2 dB|+4 dB|+6 dB|+9 dB|+12 dB";
