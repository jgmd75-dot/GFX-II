  gi = 0; loop(4, rd_lbl(350, R1 + gi * 100 - 14, "BAND", DIM, 0.95); sprintf(#v, "%d", 4 - gi); rd_lbl(350, R1 + gi * 100 + 2, #v, DIM, 0.95); gi += 1; );
  gi = 0;
