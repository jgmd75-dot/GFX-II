  // ---- glides: frequencies (log, about 30 ms), gains (about 20 ms), drive, trim
  eqt_lf = eqt_glf.eqt_tq_glf(eqt_tlf); eqt_mf = eqt_gmf.eqt_tq_glf(eqt_tmf); eqt_hf = eqt_ghf.eqt_tq_glf(eqt_thf);
  eqt_lg = eqt_glg.eqt_tq_gl(eqt_tlg);  eqt_mg = eqt_gmg.eqt_tq_gl(eqt_tmg);  eqt_hg = eqt_ghg.eqt_tq_gl(eqt_thg);
  eqt_hp = eqt_ghp.eqt_tq_glf(eqt_thp); eqt_lp = eqt_glp.eqt_tq_glf(eqt_tlp);
  eqt_dr = eqt_gdr.eqt_tq_gl(eqt_tdr);  eqt_x = eqt_tq_mv; eqt_tr = eqt_gtr.eqt_tq_gl(eqt_ttr); eqt_tq_mv = eqt_x;
