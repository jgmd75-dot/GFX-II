  eqt_ap2.eqt_tq_sv(y, eqt_c + 80); y -= 2 * eqt_c[83] * eqt_tq_bpo;
  y;
);
function eqt_tq_noutfl() instance(eqt_v0, eqt_m2, eqt_ys, ph, eqt_sp, eqt_bm, eqt_ap1, eqt_ap2) (
  eqt_bm.eqt_tq_fl(); eqt_ap1.eqt_tq_fl(); eqt_ap2.eqt_tq_fl();
  abs(eqt_m2) < 0.000000000001 ? eqt_m2 = 0; abs(eqt_ys) < 0.000000000001 ? eqt_ys = 0;
  abs(ph) < 0.000000000001 ? ph = 0; abs(eqt_sp) < 0.000000000001 ? eqt_sp = 0;
);
function eqt_tq_tch(eqt_x, eqt_c) instance(eqt_pre, eqt_lin, eqt_tro) local(g, i) (
  eqt_c[103] += eqt_c[108]; eqt_c[104] += eqt_c[109]; eqt_c[97] += eqt_c[114]; eqt_c[99] += eqt_c[115]; eqt_c[116] += eqt_c[119]; eqt_c[118] += eqt_c[120];
  eqt_c[117] ? ( i = 0; loop(23, eqt_c[i] += eqt_c[152 + i]; i += 1; ); );
  g = eqt_c[103];
  eqt_x = eqt_pre.eqt_tq_pre(eqt_x * g, eqt_c);
  eqt_x = eqt_lin.eqt_tq_lin(eqt_x, eqt_c);
  eqt_tro.eqt_tq_tout(eqt_x, eqt_c) * eqt_c[104] / g;
);
function eqt_tq_nch(eqt_x, eqt_c) instance(eqt_pre, eqt_lin, eqt_nyo) local(g, i) (
  eqt_c[103] += eqt_c[108]; eqt_c[104] += eqt_c[109]; eqt_c[97] += eqt_c[114]; eqt_c[99] += eqt_c[115]; eqt_c[116] += eqt_c[119]; eqt_c[118] += eqt_c[120];
  eqt_c[117] ? ( i = 0; loop(23, eqt_c[i] += eqt_c[152 + i]; i += 1; ); );
  g = eqt_c[103];
  eqt_x = eqt_pre.eqt_tq_pre(eqt_x * g, eqt_c);
  eqt_x = eqt_lin.eqt_tq_lin(eqt_x, eqt_c);
  eqt_nyo.eqt_tq_nout(eqt_x, eqt_c) * eqt_c[104] / g;
);
function eqt_tq_tfl() instance(eqt_pre, eqt_lin, eqt_tro) (
  eqt_lin.eqt_tq_linfl(); eqt_tro.eqt_tq_toutfl(); abs(eqt_pre.eqt_dx) < 0.000000000001 ? eqt_pre.eqt_dx = 0; abs(eqt_pre.eqt_dy) < 0.000000000001 ? eqt_pre.eqt_dy = 0;
);
function eqt_tq_nfl() instance(eqt_pre, eqt_lin, eqt_nyo) (
  eqt_lin.eqt_tq_linfl(); eqt_nyo.eqt_tq_noutfl(); abs(eqt_pre.eqt_dx) < 0.000000000001 ? eqt_pre.eqt_dx = 0; abs(eqt_pre.eqt_dy) < 0.000000000001 ? eqt_pre.eqt_dy = 0;
);
function eqt_tq_ftl(i) ( i = min(max(i | 0, 0), 5);  i == 0 ? 50 : i == 1 ? 80 : i == 2 ? 120 : i == 3 ? 180 : i == 4 ? 250 : 400; );
function eqt_tq_ftm(i) ( i = min(max(i | 0, 0), 11); i == 0 ? 500 : i == 1 ? 600 : i == 2 ? 700 : i == 3 ? 800 : i == 4 ? 1000 :
  i == 5 ? 1200 : i == 6 ? 1500 : i == 7 ? 1800 : i == 8 ? 2200 : i == 9 ? 2700 : i == 10 ? 3300 : 4000; );
function eqt_tq_fth(i) ( i = min(max(i | 0, 0), 6);  i == 0 ? 2500 : i == 1 ? 4000 : i == 2 ? 6000 : i == 3 ? 8000 : i == 4 ? 10000 : i == 5 ? 12500 : 16000; );
function eqt_tq_fnl(i) ( i = min(max(i | 0, 0), 4);  i == 0 ? 50 : i == 1 ? 100 : i == 2 ? 200 : i == 3 ? 300 : 400; );
function eqt_tq_fnm(i) ( i = min(max(i | 0, 0), 4);  i == 0 ? 400 : i == 1 ? 800 : i == 2 ? 1500 : i == 3 ? 3000 : 5000; );
function eqt_tq_fnh(i) ( i = min(max(i | 0, 0), 4);  i == 0 ? 5000 : i == 1 ? 7000 : i == 2 ? 10000 : i == 3 ? 12500 : 15000; );
function eqt_tq_gny(i) ( i = min(max(i | 0, 0), 10); i == 0 ? -12 : i == 1 ? -9 : i == 2 ? -6 : i == 3 ? -4 : i == 4 ? -2 : i == 5 ? 0 :
  i == 6 ? 2 : i == 7 ? 4 : i == 8 ? 6 : i == 9 ? 9 : 12; );
function eqt_tq_gtk(v) ( min(max(floor(v + 0.5), -15), 15); );
function eqt_tq_ech(eqt_c, eqt_d0, eqt_gm, eqt_bias, eqt_ks, eqt_sn) instance(eqt_lf, eqt_lg, eqt_mf, eqt_mg, eqt_hf, eqt_hg, eqt_ls, eqt_lw, eqt_hs, eqt_hw, eqt_hp, eqt_lp, eqt_h18, eqt_l18, eqt_dr, eqt_ny)
  local(eqt_q, e, t) (
  // the three bands (drift: d0 = the band frequency factors, gm = the gain factor)
  e = eqt_lg * eqt_lw * eqt_lw * (3 - 2 * eqt_lw) * eqt_gm;
  eqt_q = eqt_ny ? (eqt_ls ? 1.0 : 0.22 + 0.19 * abs(e)) : (eqt_ls ? 0.70710678 : 1.0);
  eqt_c[100] ? eqt_tq_band(eqt_c + 128, eqt_ls ? 1 : 0, eqt_lf * eqt_d0[0], e, eqt_q);
  e = eqt_mg * eqt_gm;
  eqt_q = eqt_ny ? 0.22 + 0.19 * abs(e) : 1.2;
  eqt_c[101] ? eqt_tq_band(eqt_c + 136, 0, eqt_mf * eqt_d0[1], e, eqt_q);
  e = eqt_hg * eqt_hw * eqt_hw * (3 - 2 * eqt_hw) * eqt_gm;
  eqt_q = eqt_ny ? (eqt_hs ? 1.0 : 0.22 + 0.19 * abs(e)) : (eqt_hs ? 0.70710678 : 1.0);
  eqt_c[102] ? eqt_tq_band(eqt_c + 144, eqt_hs ? 2 : 0, eqt_hf * eqt_d0[2], e, eqt_q);
  // the bands glide to their new coefficients sample by sample (a band starting from rest snaps)
  t = 0;
  loop(23,
    (eqt_sn & (t < 8 ? 16 : t < 16 ? 32 : 64)) ? ( eqt_c[t] = eqt_c[128 + t]; eqt_c[152 + t] = 0; ) : eqt_c[152 + t] = (eqt_c[128 + t] - eqt_c[t]) / (2 * eqt_tq_N);
    t += 1;
  );
  eqt_c[117] = 1;
  // filters (they drift with the LOW / HIGH band factors)
  eqt_c[96] ? ( t = eqt_hp * eqt_d0[0]; eqt_tq_cset(eqt_c + 24, t, 1.41421356); eqt_tq_cset(eqt_c + 32, t, 1); eqt_tq_opset(eqt_c + 40, t); );
  eqt_c[98] ? ( t = min(eqt_lp * eqt_d0[2], 0.47 * eqt_tq_fs2); eqt_tq_cset(eqt_c + 48, t, 1.41421356); eqt_tq_cset(eqt_c + 56, t, 1); eqt_tq_opset(eqt_c + 64, t); );
  // NEW YORK: the transformer's bump comes in with DRIVE
