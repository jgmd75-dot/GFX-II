desc:GFX Raum 45
//tags: chorus spatial stereo widener bbd ensemble modulation space
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-dyn and gfx-faceplate (.jsfx-inc) in the same folder.
//
// RAUM 45. A four-button stereo space processor in the spirit of the classic late-70s Japanese studio rack
// "spatial" choruses, dressed as Eastern European studio gear (third of the family with Pegel 45 and Stimm 45).
// It is not a chorus you hear wobble: the image opens out and the sound gets a little bigger and smoother,
// and it folds back to mono cleanly.
//
// SIGNAL FLOW
//   input -> INPUT trim (with a red overload LED, -3 dBFS) -> the dry path, untouched, straight to the output matrix
//   input -> MONO: L + R summed to mono for the wet path (as on the hardware) / STEREO: L feeds line A, R feeds line B
//   -> two bucket-brigade delay lines (about 3.2 ms each), each with a 2-pole anti-alias low-pass (9.5 kHz) before
//      the delay, a very gentle saturation in the line and a 4-pole reconstruction low-pass (9 kHz) after it.
//      No compander (the original was very quiet), so there is no pumping and no compander breathing.
//   -> one LFO, a smoothed triangle (rounded at the turns, as on the hardware), sweeps line A; line B gets the
//      inverted copy, so the two delays always move in opposite directions.
//   -> the output matrix:  L = dry L + w * (A - k * B)     R = dry R + w * (B - k * A)
//      Each line goes back to its own side and, polarity-inverted, to the other side. With k close to 1 the wet
//      signal is almost all "side": in the mono sum (L + R) the two wet lines nearly cancel and what is left is the
//      dry signal, so there is no comb filtering when the mix is folded to mono. At low frequencies A and B are
//      nearly identical, so A - B cancels there as well: the bass stays dry and centred.
//      k = 0.9 x WIDTH (100 % = the hardware's matrix); WIDTH 0 = no cross-feed (each side its own chorus line).
//      The wet part of each side then passes a 2-pole 110 Hz low cut, so each side's low end stays dry and steady.
//   -> MIX (100 % = the hardware's fixed blend, 0 = dry) -> level trim -> OUTPUT -> the house output stage
//      (band SAT, OFF / CLIP / LIMIT). MONO SUM (the SUM key) folds the output to mono to check the collapse.
//
// THE FOUR BUTTONS (each a fixed rate / depth pairing, 1 subtlest ... 4 strongest; approximations of the hardware):
//   1  0.25 Hz  +/-0.35 ms      2  0.25 Hz  +/-0.65 ms      3  0.25 Hz  +/-1.00 ms      4  0.50 Hz  +/-1.35 ms
//   (the wet level also rises from 1 to 4: about -6, -4.7, -3.6 and -2.5 dB under the dry). Two buttons at once give the combination modes, as when two
//   buttons are held in on the hardware: the rate is the average of the two, the depth a little more than either
//   (1+4 is the deepest-sounding of the gentle settings). All changes glide (no zipper, no pitch jump).
//   Click = that button alone (click the lit button again = all out = OFF, dry). SHIFT- or CTRL-click, or the COMBI
//   key, adds / removes a second button. OFF releases all buttons.
//
// DRIFT (0 - 100 %, 50 % = standard): BBD clock wander. Each delay line's clock wanders slowly on its own (the delay
//   times move apart by up to about +/-2.5 % at 50 %), the LFO rate wanders (+/-4 %), and a touch of BBD hiss
//   (about -103 dBFS at 50 %, -97 dBFS at 100 %, filtered like the real thing) rides on the wet signal. 0 % = perfectly steady and silent.
//
// THEME - ENAMEL (bone-grey baked enamel, amber-lit keys), VFD (charcoal slate, cold turquoise glow),
//         MATRIX (battleship-grey, chunky keys, mustard amber with forest-green status blocks). Saved in a slider.
// GUI: click a key; drag a knob (shift = fine, double-click = default); click the LCD for the preset list.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc

slider1:2<0,10,1{Off,1,2,3,4,1+2,1+3,1+4,2+3,2+4,3+4}>-Mode (buttons)
slider2:0<-24,12,0.1>-Input trim (dB)
slider3:100<0,100,1>-Mix (%)
slider4:100<0,100,1>-Width (%)
slider5:0<0,1,1{Mono,Stereo}>-Wet input
slider6:50<0,100,1>-Drift (%)
slider7:0<-24,12,0.1>-Output (dB)
slider8:0<0,1,1{Off,On}>-Mono sum check
slider9:0<0,2,1{Enamel,VFD,Matrix}>-Theme
slider10:0<0,100,1>-Band sat (%)
slider11:30<0,100,1>-Bias (%)
slider12:120<40,400,1>-Sat low band (Hz)
slider13:6000<2000,16000,10>-Sat high band (Hz)
slider14:-0.3<-24,0,0.1>-Ceiling / limit threshold (dB)
slider15:1<0,2,1{Off,Clip,Limit}>-Output stage

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-raum-45";                                // the ? pop-up links to this manual
ext_noinit = 1;

// ---------- memory ----------
nextmem = 0;
function alloc(n) local(p) ( p = nextmem; nextmem += n; memset(p, 0, n); p; );
// the two lines (A, B) and the house output stage are allocated in rz_srinit() below (their size follows the rate)
rz_den = 0.000000000000000001;                          // keeps the filter states clear of denormals

// ---------- the buttons: mode index <-> button bits (1, 2, 4, 8) ----------
function rz_bits(m) (
  m = m | 0;
  m == 0 ? 0 : m <= 4 ? 2 ^ (m - 1) : m == 5 ? 3 : m == 6 ? 5 : m == 7 ? 9 : m == 8 ? 6 : m == 9 ? 10 : 12;
);
function rz_idx(b) (
  b == 1 ? 1 : b == 2 ? 2 : b == 4 ? 3 : b == 8 ? 4 : b == 3 ? 5 : b == 5 ? 6 : b == 9 ? 7 :
  b == 6 ? 8 : b == 10 ? 9 : b == 12 ? 10 : 0;
);
// one button's settings (i = 0..3): rate Hz, depth ms (+/-), wet level
function rz_brate(i) ( i == 3 ? 0.5 : 0.25 );
function rz_bdep(i)  ( i == 0 ? 0.35 : i == 1 ? 0.65 : i == 2 ? 1.00 : 1.35 );
function rz_bwet(i)  ( i == 0 ? 0.50 : i == 1 ? 0.58 : i == 2 ? 0.66 : 0.75 );
// the mode's targets: rz_rt (Hz), rz_dt (ms), rz_wt (wet, 0 = off)
function rz_modeset(m) local(b, i, n, a, c) (
  b = rz_bits(m); n = 0; a = -1; c = -1;
  i = 0; loop(4, b & (2 ^ i) ? ( n += 1; a < 0 ? (a = i) : (c = i); ); i += 1; );
  n == 0 ? ( rz_wt = 0; ) :
  n == 1 ? ( rz_rt = rz_brate(a); rz_dt = rz_bdep(a); rz_wt = rz_bwet(a); ) : (
    rz_rt = 0.5 * (rz_brate(a) + rz_brate(c));
    rz_dt = 1.1 * sqrt(sqr(rz_bdep(a)) + sqr(rz_bdep(c)));
    rz_wt = max(rz_bwet(a), rz_bwet(c)) + 0.02;
  );
  rz_on = n > 0;
);

// ---------- filters ----------
// biquad low-pass coefficients (Audio EQ Cookbook) into this namespace
function rz_lpset(f, q) instance(b0, b1, b2, a1, a2) local(w, cw, al, n) (
  w = 2 * $pi * min(f, srate * 0.45) / srate; cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  b0 = (1 - cw) * 0.5 / n; b1 = (1 - cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
// anti-alias (before the bucket brigade): 2-pole Butterworth, 9.5 kHz; reconstruction: 4-pole Butterworth, 9 kHz,
// in two sections (set in rz_srinit() below)
// the wet's low cut: 2-pole high-pass, 110 Hz, so the low end of each side stays dry, steady and centred
function rz_hpset(f, q) instance(b0, b1, b2, a1, a2) local(w, cw, al, n) (
  w = 2 * $pi * f / srate; cw = cos(w); al = sin(w) / (2 * q); n = 1 + al;
  b0 = (1 + cw) * 0.5 / n; b1 = -(1 + cw) / n; b2 = b0; a1 = -2 * cw / n; a2 = (1 - al) / n;
);
function rz_hp(x) instance(z1, z2) local(y) (
  y = rzH.b0 * x + z1; z1 = rzH.b1 * x - rzH.a1 * y + z2; z2 = rzH.b2 * x - rzH.a2 * y; y;
);

// fractional delay read, 4-point Hermite (d in samples)
function rz_rd(buf, d) local(rp, i, f, xm1, x0, x1, x2) (
  rp = rz_wp - d; rp < 0 ? rp += rz_bsz;
  i = floor(rp); f = rp - i;
  xm1 = buf[(i + rz_bsz - 1) & rz_mask];
  x0  = buf[i & rz_mask];
  x1  = buf[(i + 1) & rz_mask];
  x2  = buf[(i + 2) & rz_mask];
  ((((0.5 * (x2 - xm1) + 1.5 * (x0 - x1)) * f
     + (xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2)) * f
     + 0.5 * (x1 - xm1)) * f + x0);
);
// one bucket-brigade line: anti-alias low-pass, delay, very mild saturation, reconstruction low-pass
function rz_line(x, buf, d) instance(p1, p2, q1, q2, r1, r2) local(y, v) (
  x += rz_den;
  y = rzP.b0 * x + p1; p1 = rzP.b1 * x - rzP.a1 * y + p2; p2 = rzP.b2 * x - rzP.a2 * y;
  buf[rz_wp] = y;
  v = rz_rd(buf, d);
  v = ost_tanh(v * 0.7) * 1.4285714;                    // under 0.3 dB of squash at -6 dBFS
  y = rzQ.b0 * v + q1; q1 = rzQ.b1 * v - rzQ.a1 * y + q2; q2 = rzQ.b2 * v - rzQ.a2 * y;
  v = rzR.b0 * y + r1; r1 = rzR.b1 * y - rzR.a1 * v + r2; r2 = rzR.b2 * y - rzR.a2 * v;
  v;
);

// ---------- settings ----------
function update() (
  rz_modeset(slider1);
  in_setup(slider2, 0);
  rz_mxt = slider3 / 100;
  rz_kt = 0.9 * slider4 / 100;
  rz_st = slider5 > 0.5;
  drift_macro(slider6);
  rz_ot = 10 ^ (slider7 / 20);
  rz_sumt = slider8 > 0.5;
  rz_hs = slider6 / 100 * 0.00007;                      // BBD hiss (uniform noise, filtered: about -103 dBFS rms at 50 %)
  ost_setup(slider10 / 100, slider11 / 100, slider12, slider13, slider14, slider15);
);

// ---------- presets (the theme and the output stage are left alone) ----------
function rz_set(m, tr, mx, wd, st, dr, ou, sm) (
  slider1 = m; slider2 = tr; slider3 = mx; slider4 = wd; slider5 = st; slider6 = dr; slider7 = ou; slider8 = sm;
  slider_automate(255);                                 // sliders 1-8
);
function load_preset(p) (
  p == 1  ? rz_set( 2, 0, 100, 100, 0, 50, 0, 0) :     // Init: button 2
  p == 2  ? rz_set( 1, 0, 100, 100, 0, 40, 0, 0) :     // Vocal Air
  p == 3  ? rz_set( 3, 0, 100, 100, 1, 50, 0, 0) :     // Keys Wide (stereo in: the keyboard's own image stays)
  p == 4  ? rz_set( 1, 0,  70, 100, 0, 30, 0, 0) :     // Bass Safe
  p == 5  ? rz_set( 4, 0, 100, 100, 0, 60, 0, 0) :     // Guitar Double
  p == 6  ? rz_set( 7, 0, 100, 100, 0, 50, 0, 0) :     // 1+4 Deep
  p == 7  ? rz_set(10, 0, 100, 100, 1, 70, 0, 0) :     // Strings Bloom
  p == 8  ? rz_set( 9, 0, 100, 100, 1, 60, 0, 0) :     // Pad Halo (2+4)
  p == 9  ? rz_set( 6, 0,  80,  85, 0, 45, 0, 0) :     // Backing Vocals (1+3)
  p == 10 ? rz_set( 5, 0,  60,  60, 0, 35, 0, 0) :     // Drum Room (1+2, gentle)
  p == 11 ? rz_set( 2, 0, 100, 100, 0, 50, 0, 1) :     // Mono Check: Init with the output summed to mono
  p == 12 ? (                                           // Reset all to defaults
    rz_set(2, 0, 100, 100, 0, 50, 0, 0);
    slider9 = 0; slider10 = 0; slider11 = 30; slider12 = 120; slider13 = 6000; slider14 = -0.3; slider15 = 1;
    slider_automate(32767);
  );
);

// ---------- state ----------
// everything that depends on the sample rate (run again from @block if the rate changes: ext_noinit keeps @init
// from running then)
function rz_srinit() (
  rz_sr = srate;
  rz_bsz = srate > 100000 ? 8192 : 4096; rz_mask = rz_bsz - 1;
  nextmem = 0;
  rz_bufA = alloc(rz_bsz);                              // line A
  rz_bufB = alloc(rz_bsz);                              // line B
  ost_init(alloc(4096));                                // the house output stage
  rz_wp = 0;
  rzP.rz_lpset(9500, 0.7071); rzQ.rz_lpset(9000, 0.5412); rzR.rz_lpset(9000, 1.3066);
  rzH.rz_hpset(110, 0.7071);
  in_init();
  rz_msr = srate / 1000;
  rz_sms = 1 - exp(-1 / (0.35 * srate));                // rate / depth glide on a button change
  rz_smw = 1 - exp(-1 / (0.12 * srate));                // wet fade (OFF / ON)
  rz_smk = 1 - exp(-1 / (0.03 * srate));                // the knobs
  rz_smd = 1 - exp(-1 / (0.5 * srate));                 // clock drift smoothing
);
rz_srinit(); ostL.ost_ch_init(); ostR.ost_ch_init();
rz_cen = 3.2;                                           // the lines' resting delay, ms (1024-stage line, clock ~160 kHz)
rz_hpc = 0;
rz_ph = rand(1);
drA.drift_init(0.8 + rand(0.5)); drB.drift_init(0.8 + rand(0.5)); drR.drift_init(0.8 + rand(0.5));
rz_ipk = 0; rz_opkL = 0; rz_opkR = 0;
update();
rz_r = rz_rt; rz_d = rz_dt; rz_w = rz_wt; rz_mx = rz_mxt; rz_k = rz_kt; rz_o = rz_ot; rz_sum = rz_sumt; rz_stm = rz_st;
rz_cA = 0; rz_cB = 0; rz_dvA = 0; rz_dvB = 0; rz_rv = 0;

ui_thm = 5; ui_hw = 1;                                  // house keycaps for the preset bar and size picker
!ui_dflt ? ( ui_sz = 2; pr_cur = 1; );                  // new instances open in Large, on Init
ui_dflt = 1;

@slider
update();

@block
srate != rz_sr ? rz_srinit();
update();                                               // knobs moved on the panel do not run @slider
// DRIFT: BBD clock wander (each line its own clock) and LFO rate wander, eased per sample below
rz_di = 0.2 * dm_s * samplesblock / srate;
rz_dvA = 0.025 * dm_a * drA.drift_tick(rz_di);
rz_dvB = 0.025 * dm_a * drB.drift_tick(rz_di);
rz_rv  = 0.04  * dm_a * drR.drift_tick(rz_di);

@serialize
file_var(0, ui_sz);
file_var(0, pr_cur);

@sample
// ---------- input ----------
in_process(spl0, spl1);
rz_l = in_l; rz_r0 = in_r;
rz_ipk = max(rz_ipk, max(abs(rz_l), abs(rz_r0)));

// ---------- glides ----------
rz_r  += (rz_rt - rz_r) * rz_sms;
rz_d  += (rz_dt - rz_d) * rz_sms;
rz_w  += (rz_wt - rz_w) * rz_smw;
rz_mx += (rz_mxt - rz_mx) * rz_smk;
rz_k  += (rz_kt - rz_k) * rz_smk;
rz_o  += (rz_ot - rz_o) * rz_smk;
rz_sum += (rz_sumt - rz_sum) * rz_smw;
rz_stm += (rz_st - rz_stm) * rz_smw;
rz_cA += (rz_dvA - rz_cA) * rz_smd;
rz_cB += (rz_dvB - rz_cB) * rz_smd;

// ---------- the LFO: smoothed triangle (rounded turns), line B gets the inverted copy ----------
rz_ph += rz_r * (1 + rz_rv) / srate; rz_ph >= 1 ? rz_ph -= 1;
rz_t = rz_ph < 0.5 ? 4 * rz_ph - 1 : 3 - 4 * rz_ph;
rz_lv = rz_t * (1.5 - 0.5 * rz_t * rz_t);

// ---------- the two bucket-brigade lines ----------
rz_m = 0.5 * (rz_l + rz_r0);
rz_xa = rz_m + (rz_l - rz_m) * rz_stm;                  // MONO: both lines get L + R; STEREO: A <- L, B <- R
rz_xb = rz_m + (rz_r0 - rz_m) * rz_stm;
rz_hs > 0 ? ( rz_xa += rz_hs * (rand(2) - 1); rz_xb += rz_hs * (rand(2) - 1); );
rz_dA = max((rz_cen * (1 + rz_cA) + rz_d * rz_lv) * rz_msr, 2);
rz_dB = max((rz_cen * (1 + rz_cB) - rz_d * rz_lv) * rz_msr, 2);
rz_a = lnA.rz_line(rz_xa, rz_bufA, rz_dA);
rz_b = lnB.rz_line(rz_xb, rz_bufB, rz_dB);
rz_wp = (rz_wp + 1) & rz_mask;

// ---------- the output matrix ----------
rz_g = rz_w * rz_mx;
rz_cmp = 1 / sqrt(sqrt(1 + 2 * rz_g * rz_g));           // half the wet's added power taken back (stereo up a touch, mono down a touch)
rz_ol = (rz_l  + rz_g * hwL.rz_hp(rz_a - rz_k * rz_b)) * rz_cmp;
rz_or = (rz_r0 + rz_g * hwR.rz_hp(rz_b - rz_k * rz_a)) * rz_cmp;
// MONO SUM check
rz_mm = 0.5 * (rz_ol + rz_or);
rz_ol += (rz_mm - rz_ol) * rz_sum; rz_or += (rz_mm - rz_or) * rz_sum;

// ---------- output stage: band saturation -> OUTPUT -> clipper / limiter ----------
rz_ol = ostL.ost_band(rz_ol) * rz_o;
rz_or = ostR.ost_band(rz_or) * rz_o;
ost_out(rz_ol, rz_or);
spl0 = ost_l; spl1 = ost_r;
rz_opkL = max(rz_opkL, abs(spl0)); rz_opkR = max(rz_opkR, abs(spl1));

@gfx 760 260
ui_begin(760, 260);

// =====================================================================
// Theme colours (the family palette: Pegel 45 / Stimm 45)
// =====================================================================
rq_th = slider9 | 0;
rq_th == 0 ? (                                          // ENAMEL: light industrial laboratory
  RQF  = 0xD6D2C4;                                      // bone-grey baked enamel (the section faces)
  RQP  = ui_mix(RQF, 0x000000, 0.10);                   // the panel around them, a shade deeper
  RQH  = ui_mix(RQF, 0x000000, 0.20);                   // header strip
  RQS  = ui_mix(RQF, 0xFFFFFF, 0.08);                   // the button field, a shade lighter
  RQI  = 0x1C1C1C;                                      // deep charcoal print
  RQI2 = 0x4A4842;
  RQA  = 0xFF7900;                                      // safety orange (rules, readout)
  RQL  = 0xFFA126;                                      // the keys' lamp: warm amber behind a milky cap
  RQG  = 0x141414;                                      // readout glass
  RQD  = 0xFF8C00;                                      // readout glow
  RQRED = 0xE0281A;
) : rq_th == 1 ? (                                      // VFD: cold gas-discharge
  RQF  = 0x0F1112;
  RQP  = 0x181A1B;                                      // charcoal slate
  RQH  = ui_mix(RQP, 0x000000, 0.35);
  RQS  = ui_mix(RQP, 0x000000, 0.22);
  RQI  = 0x4EE1DC;                                      // cold turquoise glow
  RQI2 = ui_mix(0x4EE1DC, RQP, 0.45);
  RQA  = 0xFF8C00;                                      // neon amber
  RQL  = 0x4EE1DC;
  RQG  = 0x070808;
  RQD  = 0x4EE1DC;
  RQRED = 0xFF3A2A;
) : (                                                   // MATRIX: military LED matrix
  RQP  = 0x222528;                                      // battleship grey
  RQF  = ui_mix(RQP, 0x000000, 0.25);
  RQH  = ui_mix(RQP, 0x000000, 0.30);
  RQS  = ui_mix(RQP, 0x000000, 0.40);
  RQI  = 0xC7BEB3;                                      // print: elephant's breath
  RQI2 = ui_mix(0xC7BEB3, RQP, 0.4);
  RQA  = 0xD4A373;                                      // mustard amber
  RQL  = 0xD4A373;
  RQG  = 0x0E0F10;
  RQD  = 0xD4A373;
  RQRED = 0xBC3908;
);
RQGRN = 0x1E5631; RQOLV = 0x2C302E;                     // forest-green status blocks, olive-drab unlit cells

gfx_setfont(6,  "Trebuchet MS", 27 * sc, 'b');          // title
gfx_setfont(11, "Trebuchet MS", 12 * sc, 'b');          // labels
gfx_setfont(12, "Trebuchet MS", 12.5 * sc, 'b');        // key captions
gfx_setfont(13, "Courier New", 15 * sc, 'b');           // readout
gfx_setfont(15, "Trebuchet MS", 34 * sc, 'b');          // the big button numerals

function rq_r(x, y, w, h) ( gfx_rect(x * sc, y * sc, w * sc, h * sc); );
function rq_txt(x, y, s) ( gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function rq_ctxt(cx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = cx * sc - tw * 0.5; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function rq_rtxt(rx, cy, s) local(tw, th) ( gfx_measurestr(s, tw, th); gfx_x = rx * sc - tw; gfx_y = cy * sc - th * 0.5; gfx_drawstr(s); );
function rq_lbl(x, y, s) ( gfx_setfont(11); ui_col(RQI2); rq_txt(x, y, s); );
function rq_hov(x, y, w, h) ( mouse_x >= x * sc && mouse_x < (x + w) * sc && mouse_y >= y * sc && mouse_y < (y + h) * sc; );

// a flat, sharp-cornered lit key in the theme's manner (as on Pegel 45); returns 1 when clicked
function rq_key(x, y, w, h, lbl, on) local(hov, hit) (
  hov = rq_hov(x, y, w, h);
  hit = hov && pressed && drag_id == 0; hit ? drag_id = -1;
  rq_th == 0 ? (
    ui_col(RQI); rq_r(x, y, w, h);
    on ? ui_col(RQA) : ui_col(hov ? 0xEDEAE0 : ui_mix(RQF, 0xFFFFFF, 0.35)); rq_r(x + 1, y + 1, w - 2, h - 2);
    on ? ( ui_cola(0xFFFFFF, 0.25); rq_r(x + 1, y + 1, w - 2, 1); );
    ui_col(RQI);
  ) : rq_th == 1 ? (
    ui_col(on ? RQI : ui_mix(RQI, RQP, 0.7)); rq_r(x, y, w, h);
    ui_col(0x0A0B0C); rq_r(x + 1, y + 1, w - 2, h - 2);
    on ? ( ui_cola(RQI, 0.22); rq_r(x + 1, y + 1, w - 2, h - 2); ui_cola(RQI, 0.12); rq_r(x - 2, y - 2, w + 4, h + 4); )
       : hov ? ( ui_cola(RQI, 0.08); rq_r(x + 1, y + 1, w - 2, h - 2); );
    on ? ui_col(ui_mix(RQI, 0xFFFFFF, 0.35)) : ui_cola(RQI, 0.55);
  ) : (
    ui_col(0x0B0C0D); rq_r(x, y, w, h);
    on ? ui_col(RQA) : ui_col(hov ? ui_mix(RQOLV, 0xFFFFFF, 0.06) : RQOLV); rq_r(x + 1, y + 1, w - 2, h - 2);
    on ? ( ui_cola(RQA, 0.25); rq_r(x - 2, y - 2, w + 4, h + 4); ui_cola(0xFFFFFF, 0.3); rq_r(x + 1, y + 1, w - 2, 1); );
    on ? ui_col(0x17191B) : ui_cola(RQI, 0.85);
  );
  gfx_setfont(12); rq_ctxt(x + w * 0.5, y + h * 0.5 + 0.5, lbl);
  hit;
);

// a section: sharp-cornered face with a thin frame and its name
function rq_sect(x, y, w, h, col, name) (
  rq_th == 0 ? ( ui_col(ui_mix(col, 0x000000, 0.45)); rq_r(x, y, w, h); ui_col(col); rq_r(x + 1, y + 1, w - 2, h - 2); )
             : ( ui_col(rq_th == 1 ? ui_mix(RQI, RQP, 0.78) : 0x0B0C0D); rq_r(x, y, w, h); ui_col(col); rq_r(x + 1, y + 1, w - 2, h - 2); );
  rq_lbl(x + 9, y + 6, name);
);

// the round panel LED (ENAMEL / VFD) or a square block (MATRIX)
function rq_led(x, y, on, col) (
  rq_th == 2 ? (
    ui_col(0x0B0C0D); rq_r(x - 6, y - 4, 12, 8);
    ui_col(on ? col : ui_mix(col, RQOLV, 0.8)); rq_r(x - 5, y - 3, 10, 6);
    on ? ( ui_cola(col, 0.25); rq_r(x - 8, y - 6, 16, 12); ui_cola(0xFFFFFF, 0.3); rq_r(x - 5, y - 3, 10, 1); );
  ) : rd_led(x, y, 3.2, on, col);
);

// ---------- the four big square lit push-buttons ----------
function rq_big(x, y, w, h, s, on) local(hov, dn, k, c, i) (
  hov = rq_hov(x, y, w, h);
  dn = on ? 2 : 0;                                      // a latched key sits a little lower
  // the well
  ui_cola(0x000000, rq_th == 0 ? 0.28 : 0.5); rq_r(x + 1, y + 3, w, h);
  ui_col(0x0A0A0B); rq_r(x - 2, y - 2, w + 4, h + 4);
  rq_th == 0 ? (                                        // ENAMEL: milky cap, amber lamp behind it
    on ? (
      ui_cola(RQL, 0.30); rq_r(x - 5, y - 5, w + 10, h + 10);
      ui_col(ui_mix(RQL, 0xFFF4DC, 0.35)); rq_r(x, y + dn, w, h - dn);
      i = 0; loop(8, ui_cola(0xFFFFFF, 0.05); gfx_circle((x + w * 0.5) * sc, (y + dn + (h - dn) * 0.5) * sc, (w * 0.46 - i * 3) * sc, 1, 1); i += 1; );
      gfx_gradrect(x * sc, (y + dn) * sc, w * sc, (h - dn) * 0.35 * sc, 1, 1, 1, 0.25, 0, 0, 0, 0, 0, 0, 0, -0.25 / ((h - dn) * 0.35 * sc));
      ui_col(0x3A1E00);
    ) : (
      ui_col(0xC9C4B5); rq_r(x, y, w, h);
      ui_col(hov ? 0xF3F0E6 : 0xEAE6DA); rq_r(x + 1, y + 1, w - 2, h - 5);
      ui_cola(0xFFFFFF, 0.5); rq_r(x + 1, y + 1, w - 2, 1);
      ui_col(0x34322D);
    );
  ) : rq_th == 1 ? (                                    // VFD: smoked glass, turquoise glow
    on ? (
      ui_cola(RQL, 0.10); rq_r(x - 4, y - 4, w + 8, h + 8);
      ui_col(ui_mix(RQL, 0x000000, 0.72)); rq_r(x, y + dn, w, h - dn);
      i = 0; loop(8, ui_cola(RQL, 0.045); gfx_circle((x + w * 0.5) * sc, (y + dn + (h - dn) * 0.5) * sc, (w * 0.48 - i * 3) * sc, 1, 1); i += 1; );
      ui_col(RQL); gfx_rect(x * sc, (y + dn) * sc, w * sc, h * sc - dn * sc, 0);
      ui_col(ui_mix(RQL, 0xFFFFFF, 0.55));
    ) : (
      ui_col(ui_mix(RQL, RQP, 0.82)); rq_r(x, y, w, h);
      ui_col(hov ? 0x1A1E1F : 0x121516); rq_r(x + 1, y + 1, w - 2, h - 2);
      ui_cola(0xFFFFFF, 0.05); rq_r(x + 1, y + 1, w - 2, (h - 2) * 0.45);
      ui_col(ui_mix(RQL, 0x121516, 0.78));
    );
  ) : (                                                 // MATRIX: chunky block key, deep side walls
    k = on ? 2 : 5;
    ui_col(on ? ui_mix(RQL, 0x000000, 0.45) : 0x1A1C1B); rq_r(x, y, w, h);          // front wall
    on ? ( ui_cola(RQL, 0.22); rq_r(x - 5, y - 5, w + 10, h + 10); );
    ui_col(on ? RQL : (hov ? ui_mix(RQOLV, 0xFFFFFF, 0.07) : RQOLV)); rq_r(x + 2, y + 2 + dn, w - 4, h - k - 2 - dn);
    ui_cola(0xFFFFFF, on ? 0.35 : 0.1); rq_r(x + 2, y + 2 + dn, w - 4, 1);
    ui_cola(0x000000, 0.25); rq_r(x + 2, y + h - k - 1, w - 4, 1);
    ui_col(on ? 0x17191B : ui_mix(RQI, RQOLV, 0.35));
  );
  gfx_setfont(15); rq_ctxt(x + w * 0.5, y + h * 0.5 + dn * 0.5 - (rq_th == 2 ? 1.5 : 0), s);
  rq_th == 1 && on ? ( ui_cola(RQL, 0.25); gfx_setfont(15); rq_ctxt(x + w * 0.5 + 0.6, y + h * 0.5 + dn * 0.5 + 0.6, s); );
  hov ? ( ui_cola(0xFFFFFF, 0.06); rq_r(x, y, w, h); );
  hov && pressed && drag_id == 0 ? ( drag_id = -1; 1; ) : 0;
);

// =====================================================================
// Panel and header (the family layout)
// =====================================================================
ui_col(RQP); gfx_rect(0, 0, gfx_w, gfx_h);
ui_col(RQH); rq_r(0, 0, 760, 54);
ui_col(rq_th == 0 ? RQI : RQA); rq_r(0, 54, 760, 2);
ui_col(rq_th == 2 ? RQA : RQI); gfx_circle(31 * sc, 27 * sc, 16 * sc, 1, 1);
gfx_setfont(4); ui_col(rq_th == 0 ? RQF : 0x111213); ui_text(31 * sc, 21.5 * sc, "GFX");
gfx_setfont(6); ui_col(RQI); rq_txt(58, 12, "RAUM 45");
gfx_setfont(11); ui_col(RQI2); rq_txt(196, 15, "STEREO"); rq_txt(196, 29, "RAUMEFFEKT");
pk_pextra = "Reset all to defaults";                    // the house preset bar: PRESETS, prev / next, LCD
k_ = pk_preset(300 * sc, 10 * sc, 386 * sc, 34 * sc, pr_cur,
  "Init|Vocal Air|Keys Wide|Bass Safe|Guitar Double|1+4 Deep|Strings Bloom|Pad Halo|Backing Vocals|Drum Room|Mono Check");
k_ > 0 ? ( load_preset(k_); pr_cur = k_ > 11 ? 1 : k_; );
ui_size_picker(694 * sc, 18 * sc);

dy_ink = RQI; dy_bg = RQF; dy_ntick = 11;

// =====================================================================
// INPUT section: INPUT trim (overload LED), DRIFT, MONO / STEREO
// =====================================================================
rq_sect(10, 64, 142, 144, RQF, "INPUT");
dy_kst = 20; dy_nov = 1;
sprintf(#rqv, "%+.1f dB", slider2); dy_knob(46, 114, 17, 2, -24, 12, 0, 0, 0x9DA2A8, "INPUT", #rqv);
rq_ipk_ = rz_ipk; rz_ipk = 0;
rq_ipk_ > 0.7079 ? rq_ovt = time_precise();
rq_led(71, 89, time_precise() - rq_ovt < 0.3, RQRED);
sprintf(#rqv, "%.0f%%", slider6); dy_knob(116, 114, 14, 6, 0, 100, 50, 0, rq_th == 0 ? 0x6F8794 : RQI2, "DRIFT", #rqv);
rq_lbl(20, 171, "WET IN");
rq_key(20, 184, 60, 18, "MONO", slider5 < 0.5) ? ( slider5 = 0; ui_auto(5); );
rq_key(84, 184, 60, 18, "STEREO", slider5 >= 0.5) ? ( slider5 = 1; ui_auto(5); );

// =====================================================================
// MODE section: the four buttons, COMBI / OFF and the readout
// =====================================================================
rq_sect(160, 64, 314, 144, RQS, "MODE");
gfx_setfont(11); ui_col(RQI2); rq_rtxt(464, 12 + 64 - 6 + 6, "1 SUBTLE  >  4 STRONG");
rq_bits = rz_bits(slider1);
rq_i = 0;
loop(4,
  rq_bx = 176 + rq_i * 74;
  rq_on = rq_bits & (2 ^ rq_i);
  // status block / lamp above each key
  rq_th == 2 ? ( ui_col(0x0B0C0D); rq_r(rq_bx + 19, 160, 24, 6); ui_col(rq_on ? 0x3FA45F : RQGRN); rq_r(rq_bx + 20, 161, 22, 4);
                 rq_on ? ( ui_cola(0x3FA45F, 0.3); rq_r(rq_bx + 17, 158, 28, 10); ); )
             : ( ui_col(rq_on ? RQL : ui_mix(RQL, RQS, 0.75)); rq_r(rq_bx + 20, 161, 22, 3);
                 rq_on ? ( ui_cola(RQL, 0.3); rq_r(rq_bx + 18, 159, 26, 7); ); );
  sprintf(#rqn, "%d", rq_i + 1);
  rq_big(rq_bx, 90, 62, 62, #rqn, rq_on) ? (
    rq_b = 2 ^ rq_i;
    (mouse_cap & 8) || (mouse_cap & 4) || rq_combi ? (
      rq_bits & rq_b ? ( rq_bits -= rq_b; ) :                           // take this one out
      rq_bits == 0 || rq_bits == 1 || rq_bits == 2 || rq_bits == 4 || rq_bits == 8 ? ( rq_bits |= rq_b; ) :
      ( rq_bits = rq_b | ((rq_bits & rq_last) ? rq_last : 0); );         // two in already: keep the one pressed last
    ) : (
      rq_bits = rq_bits == rq_b ? 0 : rq_b;
    );
    rq_last = rq_b;
    slider1 = rz_idx(rq_bits); ui_auto(1);
  );
  rq_i += 1;
);
rq_key(176, 172, 58, 28, "COMBI", rq_combi) ? rq_combi = !rq_combi;
rq_key(240, 172, 46, 28, "OFF", slider1 < 0.5) ? ( slider1 = 0; ui_auto(1); );
// the readout: mode, rate, depth and the two lines' sweep (A and B move in opposite directions)
rq_dx = 296; rq_dy = 170; rq_dw = 166; rq_dh = 32;
ui_col(rq_th == 1 ? 0x2E3235 : 0x0B0C0D); rq_r(rq_dx, rq_dy, rq_dw, rq_dh);
ui_col(RQG); rq_r(rq_dx + 1, rq_dy + 1, rq_dw - 2, rq_dh - 2);
gfx_setfont(13);
slider1 < 0.5 ? strcpy(#rqm, "OFF") : (
  rq_bits = rz_bits(slider1); strcpy(#rqm, "");
  rq_i = 0; loop(4, rq_bits & (2 ^ rq_i) ? ( strlen(#rqm) ? strcat(#rqm, "+"); sprintf(#rqn, "%d", rq_i + 1); strcat(#rqm, #rqn); ); rq_i += 1; );
);
ui_col(RQD); rq_txt(rq_dx + 7, rq_dy + 2, #rqm);
slider1 >= 0.5 ? ( sprintf(#rqv, "%.2fHz %.2fms", rz_rt, rz_dt); ui_cola(RQD, 0.85); rq_rtxt(rq_dx + rq_dw - 7, rq_dy + 10, #rqv); );
// sweep: a track with marks A (above) and B (below)
rq_tx = rq_dx + 8; rq_tw = rq_dw - 16; rq_ty = rq_dy + 24;
ui_cola(RQD, 0.35); rq_r(rq_tx, rq_ty, rq_tw, 1);
rq_i = 0; loop(9, rq_r(rq_tx + rq_i * rq_tw / 8, rq_ty - 2, 1, 5); rq_i += 1; );
rq_sw = slider1 >= 0.5 ? rz_lv * min(rz_d / 1.5, 1) : 0;
ui_col(RQD); rq_r(rq_tx + rq_tw * (0.5 + 0.5 * rq_sw) - 2, rq_ty - 5, 4, 4);
ui_cola(RQD, 0.7); rq_r(rq_tx + rq_tw * (0.5 - 0.5 * rq_sw) - 2, rq_ty + 2, 4, 4);

// =====================================================================
// SPACE section: MIX and WIDTH
// =====================================================================
rq_sect(482, 64, 130, 144, RQF, "SPACE");
dy_kst = 31; dy_nov = 1;
sprintf(#rqv, "%.0f%%", slider3); dy_knob(516, 112, 20, 3, 0, 100, 100, 0, RQL, "MIX", #rqv);
sprintf(#rqv, "%.0f%%", slider4); dy_knob(580, 112, 20, 4, 0, 100, 100, 0, RQL, "WIDTH", #rqv);
gfx_setfont(11); ui_col(RQI2);
rq_ctxt(547, 182, "L = D + A - kB"); rq_ctxt(547, 197, "R = D + B - kA");

// =====================================================================
// OUTPUT section: OUTPUT, SAT, OFF / CLIP / LIMIT, MONO SUM
// =====================================================================
rq_sect(620, 64, 130, 144, RQF, "OUTPUT");
dy_kst = 20;
sprintf(#rqv, "%+.1f dB", slider7); dy_knob(656, 108, 13, 7, -24, 12, 0, 0, 0x9DA2A8, "OUTPUT", #rqv);
sprintf(#rqv, "%.0f%%", slider10); dy_knob(656, 168, 11, 10, 0, 100, 0, 0, 0xD8B040, "SAT", #rqv);
ui_outkeys(690, 84, 50, 15, 4, 15);
rq_key(690, 152, 50, 22, "SUM", slider8 >= 0.5) ? ( slider8 = slider8 >= 0.5 ? 0 : 1; ui_auto(8); );
gfx_setfont(11); ui_col(RQI2); rq_ctxt(715, 186, "MONO");
dy_kst = 7; dy_nov = 0;

// =====================================================================
// bottom strip: THEME keys and the plate
// =====================================================================
rq_lbl(14, 228, "THEME");
rq_key(64, 222, 66, 24, "ENAMEL", rq_th == 0) ? ( slider9 = 0; ui_auto(9); );
rq_key(134, 222, 52, 24, "VFD", rq_th == 1) ? ( slider9 = 1; ui_auto(9); );
rq_key(190, 222, 64, 24, "MATRIX", rq_th == 2) ? ( slider9 = 2; ui_auto(9); );
gfx_setfont(11); ui_col(RQI2);
rq_txt(276, 228, "SHIFT-CLICK OR COMBI: TWO BUTTONS");
rq_rtxt(748, 234, "BBD STEREO RAUMEFFEKT  TYP 45");
ui_col(rq_th == 0 ? ui_mix(RQI, RQP, 0.6) : ui_mix(RQI, RQP, 0.75)); rq_r(10, 214, 740, 1);

pk_end();
ui_end();
