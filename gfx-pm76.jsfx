desc:GFX PM76
//tags: mastering compressor upward limiter lookahead transparent
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-instrument and gfx-dyn (.jsfx-inc) in the same folder.
//
// PM76: transparent, low-level dynamics for mastering, in the spirit of boutique mastering processors (personal use; the
// sound is designed from scratch). Two stages:
//   UPWARD    - true upward compression: only what falls BELOW the threshold is lifted, by (distance below) x (1 - 1/RATIO),
//               never more than MAX BOOST. Anything above the threshold passes untouched. ATTACK is how fast the lift
//               backs off when the level rises (keep it fast so transients are not boosted), RELEASE how gently it
//               comes back. Below FLOOR the lift fades out, so silence and noise are not pulled up.
//   PEAK LOOP - an error-loop peak controller. Its detector watches its own output (a look-ahead copy of it) and
//               measures the error between that and the CEILING; the loop closes on that error, so it applies only
//               the gain reduction needed to bring each peak down to the ceiling - no more - and lets go along the
//               RELEASE (AUTO stretches the release when it has been working hard for a while). LOOP sets how fast
//               it closes (never slower than a third of the look-ahead, so peaks are always caught), LOOK AHEAD how far ahead it sees (that is the plug-in's latency, reported to REAPER).
//   GAIN      - level into the peak loop (push it to get louder at the same ceiling). MIX blends the dry signal
//               back in; DELTA plays only what the processing adds or removes; LINK shares one gain across both sides.
// The diagnostic window shows input and output level (with the threshold and ceiling), and the lift (teal, up)
// against the peak reduction (amber, down) over time; the bars on the right show the same, live.
// PRESETS, and the OUTPUT button folds out INPUT and the GFX output stage below the panel.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-dyn.jsfx-inc

slider1:1<0,1,1{Out,In}>-Upward in
slider2:-36<-60,-10,0.1>-Upward threshold (dB)
slider3:2<1,4,0.01>-Upward ratio
slider4:6<0,12,0.1>-Max boost (dB)
slider5:2<0.2,50,0.01>-Upward attack (ms)
slider6:300<20,2000,1>-Upward release (ms)
slider7:-70<-90,-50,0.1>-Floor (dB)
slider8:1<0,1,1{Out,In}>-Peak loop in
slider9:-1<-18,0,0.1>-Ceiling (dB)
slider10:0.3<0.05,2,0.01>-Loop (ms)
slider11:1.5<0.5,5,0.01>-Look ahead (ms)
slider12:120<10,1000,1>-Release (ms)
slider13:1<0,1,1{Off,On}>-Auto release
slider14:0<-12,12,0.1>-Gain (dB)
slider15:100<0,100,1>-Mix (%)
slider16:1<0,1,1{Off,On}>-Link
slider17:0<0,1,1{Off,On}>-Delta
slider18:0<-24,12,0.1>-Input trim (dB)
slider19:1<0,1,1{Off,On}>-Input guard
slider20:0<0,100,1>-Band sat (%)
slider21:30<0,100,1>-Bias (%)
slider22:120<40,400,1>-Sat low band (Hz)
slider23:6000<2000,16000,10>-Sat high band (Hz)
slider24:-0.3<-24,0,0.1>-Ceiling / limit threshold (dB)
slider25:0<0,2,1{Off,Clip,Limit}>-Output stage

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-pm76";                                     // the ? pop-up links to this manual

BUFL = 0; BUFR = 4096; BSZ = 4096;                  // look-ahead lines (5 ms at 384 kHz fits)
HN = 300; HIN = 10000; HOUT = 10400; HB = 10800; HT = 11200;   // diagnostic history
memset(0, 0, 12000);
gi = 0; loop(HN, HIN[gi] = HOUT[gi] = -100; gi += 1; );

// upward detector: RMS with a peak guard, so a transient pulls the lift away at once
function up_det(x) instance(ms, pk) (
  ms += (x * x - ms) * urms_c;
  pk = abs(x) > pk ? abs(x) : pk * upk_rel;
  max(10 * log10(ms + 0.000000000001) + 3, 20 * log10(pk + 0.000000000001) - 3);
);
function up_env(lv) instance(b) local(t) (
  u_on ? (
    t = min(max((uthr - lv) * uslp, 0), umax);
    lv < ufloor ? t *= max(0, 1 - (ufloor - lv) / 12);
    b += (t - b) * (t < b ? uatk : urel);
  ) : b = 0;
  b;
);
// peak loop: hold the predicted peak for the look-ahead time, then close the loop on the error against the ceiling
function pl_det(a) instance(ph, hold) (
  a > ph ? ( ph = a; hold = la_n; ) : hold > 0 ? hold -= 1 : ph *= ph_rel;
  ph;
);
function pl_loop(ph) instance(t, avg) local(err, rl) (
  l_on ? (
    err = 20 * log10(ph + 0.000000000001) + t - cthr;
    err > 0 ? t -= err * kl : (
      rl = auto_r ? rel_ms * (1 + 3 * min(avg / 6, 1)) : rel_ms;
      t += min(-err, -t) / (1 + rl * 0.001 * srate);
    );
    avg += (-t - avg) * avg_c;
  ) : ( t = 0; avg = 0; );
  t;
);

function update() (
  u_on = slider1; uthr = slider2; uslp = 1 - 1 / slider3; umax = slider4;
  uatk = dy_ms(slider5); urel = dy_ms(slider6); ufloor = slider7;
  l_on = slider8; cthr = slider9;
  kl = 1 / (1 + min(slider10, slider11 * 0.35) * 0.001 * srate);   // the loop always closes within the look-ahead
  la_n = max(1, floor(slider11 * 0.001 * srate)); rel_ms = slider12; auto_r = slider13;
  mk = 10 ^ (slider14 / 20); mix_t = slider15 / 100; lnk = slider16; dlt = slider17;
  in_setup(slider18, slider19);
  ins_output_setup(20);
  pdc_delay = la_n + (slider25 == 2 ? ost_N : 0); pdc_bot_ch = 0; pdc_top_ch = 2;
);

// ---------- presets (leave INPUT and OUTPUT alone) ----------
function pu(on, t, r, mb, a, rl, fl) ( slider1 = on; slider2 = t; slider3 = r; slider4 = mb; slider5 = a; slider6 = rl; slider7 = fl; );
function pp(on, c, lp, la, rl, au, g, mx, lk) (
  slider8 = on; slider9 = c; slider10 = lp; slider11 = la; slider12 = rl; slider13 = au; slider14 = g; slider15 = mx; slider16 = lk; slider17 = 0;
);
function pname(p) (
  p == 1 ? "Master Polish" :
  p == 2 ? "Gentle Detail" :
  p == 3 ? "Lift the Quiet Bits" :
  p == 4 ? "Loud & Clean" :
  p == 5 ? "Transparent Peak Catch" :
  p == 6 ? "Classical / Acoustic" :
  p == 7 ? "Dialogue Leveller" :
  p == 8 ? "Parallel Upward" :
  p == 9 ? "Wide Mix (unlinked)" :
  p == 10 ? "Peak Sculpt (fast)" :
  "Reset all to defaults";
);
function load_preset(p) (
  p == 1 ? ( pu(1, -36, 2, 6, 2, 300, -70); pp(1, -1, 0.3, 1.5, 120, 1, 2, 100, 1); ) :      // Master Polish
  p == 2 ? ( pu(1, -42, 1.6, 4, 3, 500, -72); pp(1, -1, 0.4, 2, 200, 1, 0, 100, 1); ) :      // Gentle Detail
  p == 3 ? ( pu(1, -30, 3, 10, 1, 200, -65); pp(1, -1, 0.3, 1.5, 100, 1, 3, 100, 1); ) :     // Lift the Quiet Bits
  p == 4 ? ( pu(0, -36, 2, 6, 2, 300, -70); pp(1, -0.5, 0.1, 1, 60, 1, 6, 100, 1); ) :       // Loud & Clean
  p == 5 ? ( pu(0, -36, 2, 6, 2, 300, -70); pp(1, -1, 0.5, 3, 250, 1, 0, 100, 1); ) :        // Transparent Peak Catch
  p == 6 ? ( pu(1, -40, 2.5, 8, 2, 800, -68); pp(1, -3, 0.5, 2, 300, 1, 2, 100, 1); ) :      // Classical / Acoustic
  p == 7 ? ( pu(1, -34, 2, 9, 1.5, 250, -60); pp(1, -1.5, 0.3, 1.5, 120, 1, 2, 100, 1); ) :  // Dialogue Leveller
  p == 8 ? ( pu(1, -38, 4, 12, 1, 400, -66); pp(1, -1, 0.3, 1.5, 120, 1, 0, 50, 1); ) :      // Parallel Upward
  p == 9 ? ( pu(1, -36, 2, 6, 2, 300, -70); pp(1, -1, 0.3, 1.5, 120, 1, 2, 100, 0); ) :      // Wide Mix (unlinked)
  p == 10 ? ( pu(1, -36, 2, 6, 2, 300, -70); pp(1, -6, 0.05, 0.5, 40, 0, 0, 100, 1); );      // Peak Sculpt (fast)
  p >= 1 && p <= 10 ? slider_automate(131071);     // sliders 1-17
  p == 11 ? (                                       // Reset all to defaults
    pu(1, -36, 2, 6, 2, 300, -70); pp(1, -1, 0.3, 1.5, 120, 1, 0, 100, 1);
    slider18 = 0; slider19 = 1; slider20 = 0; slider21 = 30; slider22 = 120; slider23 = 6000; slider24 = -0.3; slider25 = 0;
    slider_automate(33554431);                      // sliders 1-25
  );
);

in_init();
ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
urms_c = 1 - exp(-1 / (0.003 * srate));
upk_rel = exp(-1 / (0.02 * srate));
ph_rel = exp(-1 / (0.003 * srate));
avg_c = 1 - exp(-1 / (1.0 * srate));
sm = 1 - exp(-1 / (0.03 * srate));
ui_thm = 14; ui_hw = 1;                              // fixed faceplate
PNL = 0x41506C; TAN = 0xC9A266; KEYG = 0xA6ACB8; DEEP = 0x0B1218; INKP = 0xDCE4EC; TEAL = 0x2EE6C8; ICE = 0x7FD8FF; MINT = 0x8CF5B0; AMBR = 0xFFB02E;
cur_preset = 1;
update();
mix_s = mix_t;
wp = 0;

@slider
update();

@block
update();

@serialize
file_var(0, ui_sz);

@sample
in_process(spl0, spl1);
dl = in_l; dr = in_r;
// upward: detector on the incoming (look-ahead) signal
lvL = UL.up_det(dl); lvR = UR.up_det(dr);
lnk ? (
  bL = bR = UL.up_env(max(lvL, lvR));
) : ( bL = UL.up_env(lvL); bR = UR.up_env(lvR); );
guL = 10 ^ (bL / 20) * mk; guR = 10 ^ (bR / 20) * mk;
// peak loop: predicted output peak (look-ahead copy, after the lift and gain)
phL = PL.pl_det(abs(dl) * guL); phR = PR.pl_det(abs(dr) * guR);
lnk ? ( tL = tR = PL.pl_loop(max(phL, phR)); ) : ( tL = PL.pl_loop(phL); tR = PR.pl_loop(phR); );
// look-ahead lines
BUFL[wp] = dl; BUFR[wp] = dr;
rp = (wp - la_n + BSZ) & (BSZ - 1);
xl = BUFL[rp]; xr = BUFR[rp];
wp = (wp + 1) & (BSZ - 1);
yl = xl * guL * 10 ^ (tL / 20); yr = xr * guR * 10 ^ (tR / 20);
ovm = max(ovm, l_on && max(abs(yl), abs(yr)) > 10 ^ ((cthr + 0.05) / 20));
// mix / delta + output stage
mix_s += (mix_t - mix_s) * sm;
dlt ? ( oL = yl - xl; oR = yr - xr; ) : ( oL = xl + (yl - xl) * mix_s; oR = xr + (yr - xr) * mix_s; );
oL = ostL.ost_band(oL * in_comp); oR = ostR.ost_band(oR * in_comp);
ost_out(oL, oR);
spl0 = ost_l; spl1 = ost_r;
bmL = max(bmL, bL); bmR = max(bmR, bR); tmL = min(tmL, tL); tmR = min(tmR, tR);
piL = max(piL, abs(xl)); piR = max(piR, abs(xr)); poL = max(poL, abs(spl0)); poR = max(poR, abs(spl1));

@gfx 960 352
ui_begin(960, ins_show_out ? 476 : 352);
dy_ink = INKP; dy_bg = PNL; dy_kst = 31;

function db(v) ( 20 * log10(max(v, 0.000001)) );
// horizontal multi-segment bar: v = 0..1 of the length, from the left
function hbar(x, y, w, v, col) local(n, i, sw) (
  n = floor(w / 5); sw = w / n; i = 0;
  loop(n, ui_col(i < v * n ? col : ui_mix(col, DEEP, 0.85)); gfx_rect((x + i * sw) * sc, y * sc, (sw - 1.5) * sc, 7 * sc); i += 1; );
);
// centre-zero bar: peak reduction (amber) grows to the left, lift (teal) to the right, 0 - 12 dB each
function czbar(x, y, w, t, b) local(n, i, sw, h) (
  h = w * 0.5; n = floor(h / 5); sw = h / n; i = 0;
  loop(n,
    ui_col(i < -t / 12 * n ? AMBR : ui_mix(AMBR, DEEP, 0.86)); gfx_rect((x + h - (i + 1) * sw) * sc, y * sc, (sw - 1.5) * sc, 9 * sc);
    ui_col(i < b / 12 * n ? TEAL : ui_mix(TEAL, DEEP, 0.86)); gfx_rect((x + h + i * sw + 1.5) * sc, y * sc, (sw - 1.5) * sc, 9 * sc);
    i += 1;
  );
  ui_col(INKP); gfx_rect((x + h - 0.5) * sc, (y - 2) * sc, 1 * sc, 13 * sc);
);
function lbl(x, y, s, col, a) ( gfx_setfont(4); ui_cola(col, a); gfx_x = x * sc; gfx_y = y * sc; gfx_drawstr(s); );
function sbtn(x, y, on, col, s) local(hit, inb) (
  inb = mouse_x >= x * sc && mouse_x < (x + 26) * sc && mouse_y >= y * sc && mouse_y < (y + 16) * sc;
  hit = pressed && drag_id == 0 && inb; hit ? drag_id = -1;
  ui_cola(0x000000, 0.4); gfx_rect((x + 1) * sc, (y + 2) * sc, 26 * sc, 16 * sc);
  ui_col(mdown && inb ? 0x8A90A0 : KEYG); gfx_rect(x * sc, y * sc, 26 * sc, 16 * sc);
  ui_cola(0xFFFFFF, 0.35); gfx_rect(x * sc, y * sc, 26 * sc, 1 * sc);
  pk_led((x + 33) * sc, (y + 8) * sc, 3 * sc, on, col);
  lbl(x + 41, y + 4, s, INKP, 0.85);
  hit;
);
// a knob with a black value box above it and a tan name tag below
function kn(cx, idx, lo, hi, def, lg, col, nm, val) (
  ui_col(0x0A0A0B); gfx_rect((cx - 28) * sc, 242 * sc, 56 * sc, 13 * sc);
  gfx_setfont(4); ui_col(0xFFFFFF); ui_text(cx * sc, 244 * sc, val);
  dy_knob(cx, 284, 17, idx, lo, hi, def, lg, col, "", "");
  ui_col(TAN); gfx_rect((cx - 34) * sc, 314 * sc, 68 * sc, 15 * sc);
  ui_cola(0xFFFFFF, 0.2); gfx_rect((cx - 34) * sc, 314 * sc, 68 * sc, 1 * sc);
  gfx_setfont(4); ui_col(0x3A2E1A); ui_text(cx * sc, 317 * sc, nm);
);
// a section: header strip with a thin coloured rule
function sect(x, w, s, col) (
  ui_cola(0xFFFFFF, 0.09); gfx_rect(x * sc, 214 * sc, w * sc, 126 * sc);
  ui_cola(0xFFFFFF, 0.05); gfx_rect(x * sc, 214 * sc, w * sc, 22 * sc);
  ui_col(col); gfx_rect(x * sc, 236 * sc, w * sc, 1 * sc);
  gfx_setfont(6, "Arial", 12 * sc, 'b'); ui_col(col); gfx_x = (x + 10) * sc; gfx_y = 219 * sc; gfx_drawstr(s);
);

// ---------- panel: anodised slate, fine brushed grain ----------
fh = ins_show_out ? 468 : 344;
ui_col(0x0B0B0C); gfx_rect(0, 0, gfx_w, gfx_h);
pk_chassis(8 * sc, 4 * sc, 944 * sc, fh * sc, PNL);
gi = 0; loop(floor(fh / 3), ui_cola(gi % 3 ? 0xFFFFFF : 0x000000, gi % 2 ? 0.018 : 0.03); gfx_rect(10 * sc, (6 + gi * 3) * sc, 940 * sc, 1 * sc); gi += 1; );
ui_col(ICE); gfx_circle(36 * sc, 32 * sc, 13 * sc, 0, 1); gfx_circle(36 * sc, 32 * sc, 12 * sc, 0, 1);
gfx_setfont(4); ui_col(ICE); ui_text(36 * sc, 27 * sc, "GFX");
gfx_setfont(6, "Arial", 26 * sc, 'b'); ui_col(INKP); gfx_x = 58 * sc; gfx_y = 17 * sc; gfx_drawstr("PM76");
ui_col(0x0A0A0B); gfx_rect(140 * sc, 18 * sc, 150 * sc, 14 * sc); lbl(146, 21, "UPWARD COMPRESSOR", TEAL, 1);
ui_col(0x0A0A0B); gfx_rect(140 * sc, 34 * sc, 150 * sc, 14 * sc); lbl(146, 37, "ERROR-LOOP PEAK CONTROL", ICE, 1);
ui_button(578 * sc, 18 * sc, 26 * sc, 28 * sc, "<", 0, 1) ? (
  cur_preset = cur_preset <= 1 ? 11 : cur_preset - 1;
  load_preset(cur_preset);
);
ui_button(606 * sc, 18 * sc, 26 * sc, 28 * sc, ">", 0, 1) ? (
  cur_preset = cur_preset >= 11 ? 1 : cur_preset + 1;
  load_preset(cur_preset);
);
ui_button(640 * sc, 18 * sc, 90 * sc, 28 * sc, "PRESETS", 0, 1) ? (
  gfx_x = 640 * sc; gfx_y = 46 * sc;
  cur_preset = gfx_showmenu("Master Polish|Gentle Detail|Lift the Quiet Bits|Loud & Clean|Transparent Peak Catch|Classical / Acoustic|Dialogue Leveller|Parallel Upward|Wide Mix (unlinked)|Peak Sculpt (fast)|Reset all to defaults");
  cur_preset > 0 ? load_preset(cur_preset);
);
ui_size_picker(750 * sc, 20 * sc);
pk_lcd(810 * sc, 14 * sc, 120 * sc, 32 * sc, 0);
pk_lcdfont(9, 9 * sc); ui_col(pk_lcdc);
gfx_x = 816 * sc; gfx_y = 17 * sc; gfx_drawstr("PATCH");
pk_lcdfont(9, 10 * sc); ui_col(pk_lcdc);
gfx_x = 816 * sc; gfx_y = 31 * sc; gfx_drawstr(pname(cur_preset));

ins_out_button(832, 19, INKP, ICE);

// ---------- diagnostic window ----------
ui_col(0x05080B); gfx_rect(16 * sc, 62 * sc, 928 * sc, 146 * sc);
ui_col(DEEP); gfx_rect(18 * sc, 64 * sc, 600 * sc, 142 * sc); gfx_rect(624 * sc, 64 * sc, 318 * sc, 142 * sc);
// history: push one point per frame
bfL = max(bmL, bmR); tfL = min(tmL, tmR);
gi = 0; loop(HN - 1, HIN[gi] = HIN[gi + 1]; HOUT[gi] = HOUT[gi + 1]; HB[gi] = HB[gi + 1]; HT[gi] = HT[gi + 1]; gi += 1; );
HIN[HN - 1] = db(max(piL, piR)); HOUT[HN - 1] = db(max(poL, poR)); HB[HN - 1] = bfL; HT[HN - 1] = tfL;
// level pane (-60 .. 0 dBFS), y 66 .. 132
ui_cola(INKP, 0.08); gi = 0; loop(5, gy_ = 66 + gi / 4 * 66; gfx_rect(22 * sc, gy_ * sc, 592 * sc, 1 * sc); gi += 1; );
gy_ = 132 - (slider2 + 60) / 60 * 66; ui_cola(TEAL, 0.6); gi = 0; loop(74, gfx_rect((22 + gi * 8) * sc, gy_ * sc, 4 * sc, 1 * sc); gi += 1; );
gy_ = 132 - (slider9 + 60) / 60 * 66; ui_cola(AMBR, 0.6); gi = 0; loop(74, gfx_rect((22 + gi * 8) * sc, gy_ * sc, 4 * sc, 1 * sc); gi += 1; );
gi = 1; loop(HN - 1,
  gx0 = 22 + (gi - 1) / (HN - 1) * 592; gx1 = 22 + gi / (HN - 1) * 592;
  ui_cola(0x8A98A8, 0.8); gfx_line(gx0 * sc, (132 - (max(HIN[gi - 1], -60) + 60) / 60 * 66) * sc, gx1 * sc, (132 - (max(HIN[gi], -60) + 60) / 60 * 66) * sc, 1);
  ui_cola(0xFFFFFF, 0.95); gfx_line(gx0 * sc, (132 - (max(HOUT[gi - 1], -60) + 60) / 60 * 66) * sc, gx1 * sc, (132 - (max(HOUT[gi], -60) + 60) / 60 * 66) * sc, 1);
  gi += 1; );
lbl(24, 68, "LEVEL", INKP, 0.55); lbl(70, 68, "IN", 0x8A98A8, 0.9); lbl(88, 68, "OUT", 0xFFFFFF, 0.9);
// gain pane: lift up (teal), peak reduction down (amber), +-12 dB, centre y 170
ui_cola(INKP, 0.25); gfx_rect(22 * sc, 170 * sc, 592 * sc, 1 * sc);
ui_cola(INKP, 0.07); gfx_rect(22 * sc, 138 * sc, 592 * sc, 1 * sc); gfx_rect(22 * sc, 202 * sc, 592 * sc, 1 * sc);
gi = 0; loop(HN,
  gx0 = 22 + gi / (HN - 1) * 592;
  HB[gi] > 0.05 ? ( ui_cola(TEAL, 0.85); gfx_rect(gx0 * sc, (170 - min(HB[gi], 12) / 12 * 32) * sc, 2 * sc, min(HB[gi], 12) / 12 * 32 * sc + 1); );
  HT[gi] < -0.05 ? ( ui_cola(AMBR, 0.9); gfx_rect(gx0 * sc, 171 * sc, 2 * sc, min(-HT[gi], 12) / 12 * 32 * sc + 1); );
  gi += 1; );
lbl(24, 140, "LIFT", TEAL, 0.8); lbl(24, 192, "PEAK", AMBR, 0.8); lbl(596, 140, "+12", INKP, 0.5); lbl(596, 192, "-12", INKP, 0.5);
// live bars
gfx_setfont(4);
lbl(632, 70, "IN", INKP, 0.6); lbl(632, 100, "OUT", INKP, 0.6);
hbar(660, 70, 270, (max(db(piL), -60) + 60) / 60, ICE); hbar(660, 80, 270, (max(db(piR), -60) + 60) / 60, ICE);
hbar(660, 100, 270, (max(db(poL), -60) + 60) / 60, MINT); hbar(660, 110, 270, (max(db(poR), -60) + 60) / 60, MINT);
lbl(632, 136, "L", INKP, 0.6); lbl(632, 152, "R", INKP, 0.6);
bdL = max(bmL, bdL * 0.9); bdR = max(bmR, bdR * 0.9); tdL = min(tmL, tdL * 0.9); tdR = min(tmR, tdR * 0.9);
czbar(660, 134, 270, tdL, bdL); czbar(660, 150, 270, tdR, bdR);
lbl(660, 166, "PEAK  -12", AMBR, 0.7); lbl(898, 166, "+12  LIFT", TEAL, 0.7);
sprintf(#v, "LIFT %+.1f dB", max(bdL, bdR)); lbl(660, 186, #v, TEAL, 0.95);
sprintf(#v, "PEAK %.1f dB", min(tdL, tdR)); lbl(770, 186, #v, AMBR, 0.95);
ovd = ovm ? 1 : ovd * 0.9; ovm = 0;
ui_col(ovd > 0.1 ? 0xFF3A2A : 0x3A1C1C); gfx_rect(880 * sc, 184 * sc, 50 * sc, 12 * sc);
lbl(892, 186, "OVER", ovd > 0.1 ? 0xFFFFFF : 0x9A6A6A, 1);
bmL = bmR = 0; tmL = tmR = 0; piL = piR = poL = poR = 0;

// ---------- UPWARD ----------
sect(18, 456, "UPWARD", TEAL);
sbtn(420, 216, slider1, TEAL, "IN") ? ( slider1 = 1 - slider1; ui_auto(1); );
sprintf(#v, "%.1f dB", slider2); kn(58, 2, -60, -10, -36, 0, TEAL, "THRESHOLD", #v);
slider3 <= 1.005 ? strcpy(#v, "OFF") : sprintf(#v, "%.2f:1", slider3); kn(134, 3, 1, 4, 2, 0, TEAL, "RATIO", #v);
