slider72:0<-12,6,0.1>-Patch level (dB)

in_pin:none
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-g-m1k";
NV = 6;
VN = 50000; VG = 50010; VT = 50020; VS = 50030;    // per voice: note (-1 free), gate, age, held by sustain
HN = 50100;                                        // mono: held-note stack
EQO = 50300; EQT = 50600; EQN = 50900; EQV = 51200; // note event queue (300 each)
PB = 60000;                                        // patch bank: 100 x 64
MS = 59000; MA = 59010; MD = 59020;                // active matrix slots (built each block)
gi = 0; loop(NV, VN[gi] = -1; VG[gi] = 0; VT[gi] = 0; VS[gi] = 0; gi += 1; );

function pp(p, j, a, b, c, d, e, f, g, h, i, k) local(o) (
  o = PB + p*64 + j;
  o[0] = a; o[1] = b; o[2] = c; o[3] = d; o[4] = e; o[5] = f; o[6] = g; o[7] = h; o[8] = i; o[9] = k;
);
function pn(p, s) ( strcpy(100 + p, s); );
// banks: first patch of each, and their names
function cat_start(c) ( c == 0 ? 0 : c == 1 ? 16 : c == 2 ? 30 : c == 3 ? 42 : c == 4 ? 62 : c == 5 ? 76 : c == 6 ? 88 : 100; );
function cat_of(p) local(c) ( c = 0; loop(6, p >= cat_start(c + 1) ? c += 1; ); c; );
function cat_name(c) ( c == 0 ? "KEYBOARD" : c == 1 ? "STRINGS" : c == 2 ? "WIND+PERC" : c == 3 ? "SYNTH" : c == 4 ? "BASS" : c == 5 ? "LEAD" : "EFFECTS"; );
function src_name(s) ( s == 1 ? "ENV 1" : s == 2 ? "ENV 2" : s == 3 ? "ENV 3" : s == 4 ? "LFO 1" : s == 5 ? "LFO 2" : s == 6 ? "RAMP 1" : s == 7 ? "RAMP 2" :
  s == 8 ? "VELOCITY" : s == 9 ? "KEYBOARD" : s == 10 ? "MOD WHEEL" : s == 11 ? "AFTERTOUCH" : "OFF"; );
function dst_name(d) ( d == 1 ? "DCO 1 PITCH" : d == 2 ? "DCO 2 PITCH" : d == 3 ? "BOTH PITCH" : d == 4 ? "PW" : d == 5 ? "DCO 1 SHAPE" : d == 6 ? "DCO 2 SHAPE" :
  d == 7 ? "MIX" : d == 8 ? "CUTOFF" : d == 9 ? "RESONANCE" : d == 10 ? "AMP" : d == 11 ? "FM" : d == 12 ? "VIBRATO" : "OFF"; );
function lfo_name(w) ( w == 0 ? "TRIANGLE" : w == 1 ? "SAW UP" : w == 2 ? "SAW DOWN" : w == 3 ? "SQUARE" : w == 4 ? "RANDOM" : "NOISE"; );

