desc:GFX G-Loop
//tags: loop player sampler tempo sync time-stretch
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-output, gfx-ui, gfx-panel and gfx-instrument (.jsfx-inc) in the same folder.
//
// Tempo-synced loop player. Plays an audio file (WAV, AIFF, FLAC, OGG, MP3 - anything Reaper reads) as a loop,
// locked to Reaper's tempo and beat position, and starts / stops with the transport.
//   LOADING - drag a file from Explorer / Finder or the Media Explorer onto the panel, or put loops in
//             REAPER/Data/gfx-loops and click the display for the list (< FILE > steps through it).
//             A dropped file is remembered by its full path, so keep it where it is.
//   BEATS   - how long the loop is. Set on load from a tempo in the file name ("drums_120bpm.wav"), or else
//             the length nearest the project tempo; AUTO does it again. Right-click AUTO to switch the
//             on-load detection off.
//   START   - which beat of the project the loop starts on (shifts it against the bar).
//   STRETCH - follows the tempo and keeps the pitch (two overlapping grains, each lined up with the last).
//             GRAIN sets the grain length: shorter keeps drums tight, longer keeps pads smooth. PITCH transposes.
//   TAPE    - follows the tempo by changing the speed, so the pitch follows too (cleanest on drums).
//   REV     - plays the loop backwards.  FREE - also plays while the transport is stopped, at the
//             project tempo (otherwise it waits for the transport).
// The incoming audio passes through untouched; the loop is added to it.
// The OUTPUT button folds out STEREO and the GFX output stage below the panel.

options:maxmem=16777216

import gfx-drift.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-instrument.jsfx-inc

slider1:/gfx-loops:none:-Loop file
slider2:/gfx-loops:none:-Loop list (browse)
slider3:1<0,1,1{Off,On}>-Play
slider4:0<0,1,1{Stretch,Tape}>-Mode
slider5:8<1,64,1>-Beats
slider6:0<0,63.75,0.25>-Start (beats)
slider7:0<-12,12,1>-Pitch (st)
slider8:60<20,200,1>-Grain (ms)
slider9:0<0,1,1{Off,On}>-Reverse
slider10:0<-24,12,0.1>-Level (dB)
slider11:0<0,1,1{Silent,Free-run}>-When stopped
slider12:1<0,1,1{Off,On}>-Auto beats on load
slider13:0<0,100,1>-Band sat (%)
slider14:30<0,100,1>-Bias (%)
slider15:120<40,400,1>-Sat low band (Hz)
slider16:6000<2000,16000,10>-Sat high band (Hz)
slider17:-0.3<-24,0,0.1>-Ceiling / limit threshold (dB)
slider18:1<0,2,1{Off,Clip,Limit}>-Output stage
slider19:20<20,500,1>-Mono below (Hz, 20 = off)
slider20:0<0,100,1>-Stereo width (%)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
ext_noinit = 1;                                    // keep the loaded loop when playback starts

// ---------- memory map ----------
OVW = 150000; NOV = 512;                           // waveform overview for the display
TMP = 200000; CHUNK = 32768;                       // read buffer (frames, up to 8 channels)
BL = 500000; MAXF = 7500000; BR = BL + MAXF;       // the loop, left and right (~156 s at 48 kHz)

!inited ? ( inited = 1; lh = -1; src = 0; load_req = 1; );
smp_len == 0 && !loading ? load_req = 1;

// ---------- file names ----------
function basename(dst, p) local(i, k, c) (
  k = 0; i = 0;
  loop(strlen(p), c = str_getchar(p, i); (c == 47 || c == 92) ? k = i + 1; i += 1; );
  strcpy_substr(dst, p, k);
);
// a tempo in the name: "120bpm", "120 BPM", "92.5_bpm" ... (0 if none)
function parse_bpm(s) local(n, i, j, c, v, sc_, dig) (
  n = strlen(s); v = 0; i = 0;
  while (i + 2 < n && v == 0) (
    (str_getchar(s, i) | 32) == 'b' && (str_getchar(s, i + 1) | 32) == 'p' && (str_getchar(s, i + 2) | 32) == 'm' ? (
      j = i - 1;
      while (j >= 0 && ((c = str_getchar(s, j)) == ' ' || c == '_' || c == '-')) ( j -= 1; );
      sc_ = 1; dig = 0;
      while (j >= 0 && (((c = str_getchar(s, j)) >= '0' && c <= '9') || c == '.')) (
        c == '.' ? ( v /= sc_; sc_ = 1; ) : ( v += (c - '0') * sc_; sc_ *= 10; dig += 1; );
        j -= 1;
      );
      (dig == 0 || v < 40 || v > 300) ? v = 0;
    );
    i += 1;
  );
  v;
);
// files in REAPER/Data/gfx-loops (stops at the end of the list, whether Reaper clamps or returns nothing)
function count_files() local(i, more) (
  i = 0; more = 1; strcpy(#cprev, "");
  while (more && i < 512) (
    slider2 = i; strcpy_fromslider(#cfn, slider2);
    (strlen(#cfn) == 0 || (i > 0 && strcmp(#cfn, #cprev) == 0)) ? more = 0 : ( strcpy(#cprev, #cfn); i += 1; );
  );
  i;
);

// ---------- loading (in @block, a few chunks per block) ----------
function build_overview() local(b, i0, i1, st, m, i) (
  b = 0;
  loop(NOV,
    i0 = floor(b * smp_len / NOV); i1 = floor((b + 1) * smp_len / NOV);
    st = max(1, floor((i1 - i0) / 256)); m = 0; i = i0;
    while (i < i1) ( m = max(m, max(abs(BL[i]), abs(BR[i]))); i += st; );
    OVW[b] = m; b += 1;
  );
);
// BEATS from the tempo in the name, or else the power-of-two length nearest the project tempo
function auto_beats() local(dur, b, best, bd, d) (
  smp_len > 0 ? (
    dur = smp_len / fsr;
    name_bpm > 0 ? ( best = floor(dur * name_bpm / 60 + 0.5); ) : (
      best = 4; bd = 1000; b = 1;
      loop(7, d = abs(log(b * 60 / dur / tempo)); d < bd ? ( bd = d; best = b; ); b *= 2; );
    );
    slider5 = min(max(best, 1), 64); slider_automate(16);
  );
);
function start_load() (
  lh >= 0 ? file_close(lh);
  smp_len = 0; loading = 0; ld_err = 0;
  lh = src ? file_open(#path) : file_open(slider1);
  lh >= 0 ? (
    lnch = 0; lsr = 0; file_riff(lh, lnch, lsr);
    lnch > 0 && lsr > 0 ? (
      ld_tot = min(floor(file_avail(lh) / lnch), MAXF); ld_w = 0; loading = 1;
      src ? basename(#nm, #path) : ( strcpy_fromslider(#tmpn, slider1); basename(#nm, #tmpn); );
    ) : ( file_close(lh); lh = -1; );
  );
  !loading ? ( (user_load || src) ? ld_err = 1; strcpy(#nm, ""); user_load = 0; );
);
function load_step() local(k, n, got, i, j) (
  k = 0;
  while (loading && k < 4) (
    n = min(CHUNK, MAXF - ld_w);
    ld_tot > 0 ? n = min(n, ld_tot - ld_w);
    got = n > 0 ? file_mem(lh, TMP, n * lnch) : 0;
    n = floor(got / lnch);
    n > 0 ? (
      i = ld_w; j = TMP;
      lnch == 1 ? loop(n, BL[i] = BR[i] = j[0]; j += 1; i += 1; )
                : loop(n, BL[i] = j[0]; BR[i] = j[1]; j += lnch; i += 1; );
      ld_w += n;
    );
    n < CHUNK || ld_w >= MAXF || (ld_tot > 0 && ld_w >= ld_tot) ? (
      file_close(lh); lh = -1; loading = 0;
      ld_w > 16 ? (
        smp_len = ld_w; fsr = lsr; build_overview();
        name_bpm = parse_bpm(#nm);
        user_load && slider12 ? auto_beats();
        lsrc = src; lsl = slider1; strcpy(#lpath, #path); resetg = 1;
      ) : ( ld_err = 1; strcpy(#nm, ""); );
      user_load = 0;
    );
    k += 1;
  );
);

// ---------- playback ----------
function herm(xm1, x0, x1, x2, f) local(c1, c2, c3) (
  c1 = 0.5 * (x1 - xm1); c2 = xm1 - 2.5 * x0 + 2 * x1 - 0.5 * x2; c3 = 0.5 * (x2 - xm1) + 1.5 * (x0 - x1);
  ((c3 * f + c2) * f + c1) * f + x0;
);
function wrapi(i) ( i - floor(i / smp_len) * smp_len; );
// read both channels at frame position p (wraps round the loop, so the seam is continuous)
function rd2(p) local(i, f, a, b, c, d) (
  i = floor(p); f = p - i;
  a = wrapi(i - 1); b = wrapi(i); c = wrapi(i + 1); d = wrapi(i + 2);
  rdL = herm(BL[a], BL[b], BL[c], BL[d], f);
  rdR = herm(BR[a], BR[b], BR[c], BR[d], f);
);

// WSOLA: a new grain should start where its waveform lines up with the grain it fades into, or the two
// partly cancel and the pitch smears. Search +/-8 ms around s0 for the best match with the next quarter
// grain of the continuing grain (read from opos), coarse then fine.
function wsola(s0, opos) local(n, stp, o, o0, c, bc, best, p, q, k) (
  n = 128; stp = max(1, gln * 0.25 / n) * ldir * gsp;
  bc = -1000000000000; best = 0;
  k = 0;
  loop(2,
    o0 = best; o = k ? o0 - wstep + 1 : -wsrch;
    while (o <= (k ? o0 + wstep - 1 : wsrch)) (
      c = 0; p = opos; q = s0 + o;
      loop(n, c += (BL[wrapi(floor(p))] + BR[wrapi(floor(p))]) * (BL[wrapi(floor(q))] + BR[wrapi(floor(q))]); p += stp; q += stp; );
      c > bc ? ( bc = c; best = o; );
      o += k ? 1 : wstep;
    );
    k += 1;
  );
  s0 + best;
);

function update() (
  lbeats = slider5; lstart = floor(slider6 * 4 + 0.5) / 4;
  ltape = slider4; ldir = slider9 ? -1 : 1;
  lvl_t = 10 ^ (slider10 / 20);
  ins_output_setup(13); ins_stereo_setup(19);
);

ost_init(20000); ostL.ost_ch_init(); ostR.ost_ch_init();
sm = 1 - exp(-1 / (0.03 * srate));
fcoef = 1 - exp(-1 / (0.004 * srate));             // 4 ms fade in / out
pkL = 0; pkR = 0;
ui_thm = 5; ui_hw = 1;   // fixed charcoal faceplate with coloured section bars
ui_kstyle = 0;
PNL = 0x2A2B2F; INKL = 0xE8E6E0; TEAL = 0x2FB3A0; REDL = 0xFF3A2A; AMBL = 0xFFB030;
SH1 = 0x232428; SH2 = 0x202125; SH3 = 0x1C1D21;
function lgroup(x, y, w, h, sec, title, shade) (
  pk_inset(x * sc, y * sc, w * sc, h * sc, shade);
  pk_box(x * sc, y * sc, w * sc, h * sc, TEAL, title);
  ui_section(sec); C_INK = INKL;
);
// < FILE > : the next / previous file in REAPER/Data/gfx-loops
function file_step(d) local(nf) (
  nf = count_files();
  nf > 0 ? (
    slider1 = src ? (d > 0 ? 0 : nf - 1) : (slider1 + d + nf) % nf; slider_automate(1);
    src = 0; user_load = 1; load_force = 1; load_req = 1;
  );
);
update();
lvl_s = lvl_t;

@slider
update();

@block
update();                                          // knobs moved on the panel do not run @slider, so read them here

// a file dropped on the panel, a pick from the list, or a project / preset being restored
drop_req ? ( drop_req = 0; strcpy(#path, #dpath); src = 1; user_load = 1; load_force = 1; load_req = 1; );
load_req ? (
  load_req = 0;
  // an undo restores the same loop: keep what is loaded
  load_force || loading || smp_len == 0 || src != lsrc || (src ? strcmp(#path, #lpath) != 0 : slider1 != lsl) ? start_load();
  load_force = 0;
);
loading ? load_step();
auto_req ? ( auto_req = 0; auto_beats(); );

// where the loop is: the project's beat position, or a free-running count while stopped
tp = play_state & 1;
lrun = slider3 && smp_len > 0 && (tp || slider11);
bps = tempo / 60 / srate;
tp ? (
  b0 = beat_position;
  (!was_tp || abs(b0 - b_exp) > 0.05) ? resetg = 1;      // transport started or jumped
) : (
  (was_tp || !was_run) ? ( fbeat = 0; resetg = 1; );
  b0 = fbeat; lrun ? fbeat += samplesblock * bps;
);
b_exp = b0 + samplesblock * bps;
was_tp = tp; was_run = lrun;

// stretch: grains play at the file's own speed (times PITCH), and restart where the beat says
smp_len > 0 ? (
  rr = fsr / srate;
  gsp = rr * 2 ^ (slider7 / 12);
  gln = max(floor(slider8 * 0.001 * srate), 64);
  wsrch = floor(0.008 * fsr); wstep = max(1, floor(fsr / 12000));
  obpm = lbeats * 60 * fsr / smp_len;
);
spos = 0;

@serialize
file_var(0, ui_sz);
file_var(0, src);
file_string(0, #path);
file_avail(0) >= 0 ? load_req = 1;                 // reading: a project, preset or undo restores the loop

@sample
in0 = spl0; in1 = spl1;
yL = 0; yR = 0;
smp_len > 0 && (lrun || genv > 0.00001) ? (
  genv += (lrun - genv) * fcoef;
  ph = (b0 + spos * bps - lstart) / lbeats; ph -= floor(ph);
  tgt = (ldir > 0 ? ph : 1 - ph) * smp_len;
  disp_pos = tgt / smp_len; disp_beat = floor(ph * lbeats) + 1;
  ltape ? (
    rd2(tgt); yL = rdL; yR = rdR; resetg = 0;
  ) : (
    resetg ? (
      glA = glB = gln; aA = 0; aB = floor(gln / 2);
      sA = tgt - ldir * gsp * gln * 0.5; sB = tgt - ldir * gsp * gln;
      resetg = 0;
    );
    aA >= glA ? ( glA = gln; aA = 0; sA = wsola(tgt - ldir * gsp * glA * 0.5, sB + ldir * gsp * aB); );
    aB >= glB ? ( glB = gln; aB = 0; sB = wsola(tgt - ldir * gsp * glB * 0.5, sA + ldir * gsp * aA); );
    wA = sin($pi * aA / glA); wA *= wA;            // two Hann windows half a grain apart sum to 1
    wB = sin($pi * aB / glB); wB *= wB;
    rd2(sA + ldir * gsp * aA); yL = rdL * wA; yR = rdR * wA;
    rd2(sB + ldir * gsp * aB); yL += rdL * wB; yR += rdR * wB;
    aA += 1; aB += 1;
  );
  lvl_s += (lvl_t - lvl_s) * sm;
  yL *= genv * lvl_s; yR *= genv * lvl_s;
) : genv = 0;
spos += 1;

oL = ostL.ost_band(yL);
oR = ostR.ost_band(yR);
ins_stereo(oL, oR); ost_out(ins_sl, ins_sr);           // mono-maker / widener, then the output stage
spl0 = in0 + ost_l;
spl1 = in1 + ost_r;
pkL = max(pkL, abs(ost_l)); pkR = max(pkR, abs(ost_r));

@gfx 780 440
ui_begin(780, 440);

// a file dropped anywhere on the panel (loaded in @block)
gfx_getdropfile(0, #drop) ? ( strcpy(#dpath, #drop); drop_req = 1; gfx_getdropfile(-1); );

// ---------- chassis ----------
fh = ins_show_out ? 432 : 300;                     // the output section folds out below
ui_col(0x0B0C0D); gfx_rect(0, 0, gfx_w, gfx_h);
pk_chassis(8 * sc, 8 * sc, 764 * sc, fh * sc, PNL);
C_INK = INKL;

// header
ui_col(INKL); gfx_circle(40 * sc, 38 * sc, 14 * sc, 1, 1);
gfx_setfont(4); ui_col(PNL); ui_text(40 * sc, 33 * sc, "GFX");
gfx_setfont(6, "Trebuchet MS", 24 * sc, 'b'); ui_col(INKL); gfx_x = 62 * sc; gfx_y = 24 * sc; gfx_drawstr("G-LOOP");
gfx_setfont(4); ui_cola(INKL, 0.6); gfx_x = 170 * sc; gfx_y = 34 * sc; gfx_drawstr("TEMPO-SYNCED LOOP PLAYER");
ui_size_picker(520 * sc, 31 * sc);
ins_out_button(610, 29, INKL, REDL);
ui_col(TEAL); gfx_rect(14 * sc, 70 * sc, 752 * sc, 3 * sc);

// ---------- display: name, tempo, waveform + playhead (click for the loop list) ----------
pk_lcd(24 * sc, 84 * sc, 732 * sc, 100 * sc, 1);
pk_lcdfont(7, 13 * sc); ui_col(pk_lcdc);
gfx_x = 34 * sc; gfx_y = 90 * sc;
gfx_drawstr(strlen(#nm) ? #nm : "NO LOOP LOADED");
pk_lcdfont(8, 10 * sc);
smp_len > 0 ? (
  sprintf(#inf, "%d BEATS   LOOP %.1f > %.1f BPM   x%.3f   %s", lbeats, obpm, tempo, tempo / obpm, slider4 ? "TAPE" : "STRETCH");
  !slider4 && slider7 != 0 ? ( sprintf(#tt, "  %+d ST", slider7); strcat(#inf, #tt); );
  slider9 ? strcat(#inf, "   REV");
  gfx_x = 34 * sc; gfx_y = 110 * sc; gfx_drawstr(#inf);
);
loading ? sprintf(#st, "LOADING %d%%", ld_tot > 0 ? floor(100 * ld_w / ld_tot) : 0) :
ld_err ? strcpy(#st, "CAN'T READ FILE") :
smp_len == 0 ? strcpy(#st, "") :
!slider3 ? strcpy(#st, "OFF") :
genv > 0.01 ? sprintf(#st, "%sBEAT %d/%d", (play_state & 1) ? "" : "FREE  ", disp_beat, lbeats) :
strcpy(#st, "WAITING FOR TRANSPORT");
gfx_measurestr(#st, gtw, gth); gfx_x = 746 * sc - gtw; gfx_y = 110 * sc; gfx_drawstr(#st);

gwx = 32 * sc; gww = 716 * sc; gwy = 126 * sc; gwh = 52 * sc; gwc = gwy + gwh * 0.5;
smp_len > 0 ? (
  ui_cola(pk_lcdc, 0.3);                           // a line on every beat (every bar on long loops)
  gbs = lbeats > 16 ? 4 : 1;
  gi = 0; loop(floor(lbeats / gbs) + 1, gx = gwx + gi * gbs / lbeats * gww; gfx_line(gx, gwy, gx, gwy + gwh); gi += 1; );
  ui_cola(pk_lcdc, 0.8);
  gi = 0; loop(NOV, gx = gwx + gi * gww / NOV; ga = min(OVW[gi], 1) * gwh * 0.5; gfx_line(gx, gwc - ga, gx, gwc + ga); gi += 1; );
  genv > 0.01 ? ( ui_col(pk_lcdc); gfx_rect(gwx + disp_pos * gww - 1 * sc, gwy - 3 * sc, max(2, 3 * sc), gwh + 6 * sc); );
) : (
  gfx_x = 34 * sc; gfx_y = 140 * sc; ui_cola(pk_lcdc, 0.8);
  gfx_drawstr("DRAG AN AUDIO FILE ONTO THE PANEL  -  OR CLICK HERE FOR THE LOOPS IN REAPER/Data/gfx-loops");
);
pressed && drag_id == 0 && mouse_x >= 24 * sc && mouse_x < 756 * sc && mouse_y >= 84 * sc && mouse_y < 184 * sc ? (
  drag_id = -1;
  gnf = count_files();
  strcpy(#menu, "");
  gi = 0;
  loop(gnf,
    slider2 = gi; strcpy_fromslider(#cfn, slider2);
    gi > 0 ? strcat(#menu, "|");
    !src && gi == slider1 ? strcat(#menu, "!");
    strcat(#menu, #cfn);
    gi += 1;
  );
  gnf == 0 ? strcpy(#menu, "#No files in REAPER/Data/gfx-loops|#(or drag a file onto the panel)");
  strcat(#menu, "|Reload loop");
  gfx_x = 24 * sc; gfx_y = 184 * sc;
  gsel = gfx_showmenu(#menu);
  gsel > 0 && gsel <= gnf ? ( slider1 = gsel - 1; slider_automate(1); src = 0; user_load = 1; load_force = 1; load_req = 1; ) :
  gsel == max(gnf, 2) + 1 ? ( user_load = 1; load_force = 1; load_req = 1; );
);

// ---------- LOOP ----------
lgroup(24, 194, 232, 92, 2, "LOOP", SH1);
pk_ledbtn(38 * sc, 208 * sc, 36 * sc, 40 * sc, slider3, REDL) ? ( slider3 = 1 - slider3; slider_automate(4); );
pk_ledbtn(80 * sc, 208 * sc, 36 * sc, 40 * sc, slider9, AMBL) ? ( slider9 = 1 - slider9; slider_automate(256); );
pk_ledbtn(122 * sc, 208 * sc, 36 * sc, 40 * sc, slider11, AMBL) ? ( slider11 = 1 - slider11; slider_automate(1024); );
pk_ledbtn(172 * sc, 208 * sc, 32 * sc, 40 * sc, 0, TEAL) ? file_step(-1);
pk_ledbtn(210 * sc, 208 * sc, 32 * sc, 40 * sc, 0, TEAL) ? file_step(1);
gfx_setfont(4); ui_col(INKL);
ui_text(56 * sc, 254 * sc, "PLAY"); ui_text(98 * sc, 254 * sc, "REV"); ui_text(140 * sc, 254 * sc, "FREE");
ui_text(207 * sc, 254 * sc, "< FILE >");

// ---------- SYNC ----------
lgroup(264, 194, 264, 92, 2, "SYNC", SH2);
pk_ledbtn(278 * sc, 208 * sc, 40 * sc, 40 * sc, slider4 == 0, TEAL) ? ( slider4 = 0; slider_automate(8); );
pk_ledbtn(322 * sc, 208 * sc, 40 * sc, 40 * sc, slider4 == 1, TEAL) ? ( slider4 = 1; slider_automate(8); );
pk_ledbtn(366 * sc, 208 * sc, 40 * sc, 40 * sc, slider12, AMBL) ? auto_req = 1;
pk_rclick ? ( slider12 = 1 - slider12; slider_automate(2048); );   // right-click AUTO: detect on load on / off
gfx_setfont(4); ui_col(INKL);
ui_text(298 * sc, 254 * sc, "STRETCH"); ui_text(342 * sc, 254 * sc, "TAPE"); ui_text(386 * sc, 254 * sc, "AUTO");
knob_step = 1; ui_knob(446 * sc, 240 * sc, 5, 1, 64, 8, 0, "BEATS", "%.0f");
ui_knob(502 * sc, 240 * sc, 6, 0, 63.75, 0, 0, "START", "%.2f b");

// ---------- SOUND ----------
lgroup(536, 194, 176, 92, 1, "SOUND", SH3);
knob_step = 1; ui_knob(566 * sc, 240 * sc, 7, -12, 12, 0, 0, "PITCH", "%+.0f st");
ui_knob(624 * sc, 240 * sc, 8, 20, 200, 60, 1, "GRAIN", "%.0f ms");
ui_knob(682 * sc, 240 * sc, 10, -24, 12, 0, 0, "LEVEL", "%+.1f dB");

// ---------- meter ----------
mL.ui_ledm(722 * sc, 202 * sc, 12 * sc, 66 * sc, pkL);
mR.ui_ledm(738 * sc, 202 * sc, 12 * sc, 66 * sc, pkR);
pkL *= 0.85; pkR *= 0.85;
gfx_setfont(4); ui_col(INKL); ui_text(736 * sc, 272 * sc, "OUT");

// ---------- fold-out: STEREO + OUTPUT ----------
ins_show_out ? (
  ui_col(TEAL); gfx_rect(14 * sc, 298 * sc, 752 * sc, 2 * sc);
  ins_stereo_box(24, 312, 19, SH3, INKL);
  ins_output_tray(206, 312, 13, SH3, INKL, REDL);
);

pk_end();
ui_end();
