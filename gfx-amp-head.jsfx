desc:GFX Amp Head [guitar / bass amp]
//tags: amp amplifier guitar bass valve tube cabinet reverb spring di tuner
//author: JGWizrad / Garden FX (GFX)
//
// Requires gfx-drift, gfx-input, gfx-output, gfx-ui, gfx-panel, gfx-dyn, gfx-faceplate, gfx-instrument, gfx-headsmooth and gfx-amp
// (.jsfx-inc) in the same folder.
//
// AMP HEAD - two all-valve amp heads in one plug-in; the MODEL keys choose which one is in the circuit (it replaces the
// former Guitar Head and Bass Head). Each model is the original plug-in ported sample for sample (it nulls against
// it), with its own controls and faceplate (personal use; the sound is designed from scratch).
//
//   GUITAR  an all-valve guitar amp with spring reverb and a 2x12 or 4x12 cabinet, in the spirit of the classic
//           50-watt heads.
//           GAIN        - the preamp. CLEAN: one valve, sparkly to edge-of-breakup. DRIVE: a second cascaded valve.
//           BRIGHT      - a treble lift ahead of the gain, strongest at low gain (as the real bright cap).
//           BASS / MIDDLE / TREBLE - the tone stack, 0..10 (5 = flat).
//           PRESENCE    - the top end after the power stage, 0..10.
//           REVERB      - a spring tank between the preamp and the power stage.
//           MASTER      - how hard the EL34-style power stage is driven: headroom, then sag and crunch.
//           CAB / MIC   - off (line out), 2x12 open back or 4x12 closed back, and the mic from on axis to off axis.
//           GATE        - a noise gate before the amp (fully down = off).   TUNER - shows the note and mutes the output.
//           TRUE STEREO, linked: L and R each go through their own identical amp channel (preamp, tone stack, spring
//           tank, power stage, cabinet) at twice the sample rate, with every control shared. The two power stages
//           share one supply (one amp, one sag), the gate is linked, the two spring tanks are slightly different
//           lengths and the two mics sit a hair apart, so a mono source still opens up. MONO IN sums the input and
//           feeds both channels (for a mono guitar); off (the default), stereo sources stay stereo.
//   BASS    a big all-valve bass amp and an 8x10 cabinet, in the spirit of the classic 300-watt heads.
//           GAIN        - the preamp valve: clean and round low down, growling as it goes up.
//           ULTRA LO    - deep low lift with a scooped midrange.   ULTRA HI - a bright top-end lift.
//           BASS / TREBLE - shelves, +/-12 dB.   MIDRANGE - +/-12 dB at 220 / 450 / 800 / 1.6k / 3k (FREQUENCY).
//           MASTER      - how hard the push-pull power stage is driven: headroom, then sag and compression.
//           CAB / MIC   - the 8x10 cabinet on or off (line out), and the mic from on axis (bright) to off axis (dark).
//           DI BLEND    - the clean DI signal mixed under the amp.
//           GATE        - a noise gate before the amp (fully down = off).   TUNER - shows the note and mutes the output.
//           The amp runs in mono (as a real amp) at twice the sample rate; both outputs carry it.
//
// THEME colours the control panel, pinstripe and lamp (Graphite: red for GUITAR, blue for BASS); HW switches between
//   the faceplate and the flat look.
// DRIFT (parameter list only): the valves' bias wanders slightly. The DRIFT dial scales it (50% = the drift amount /
//   speed settings, 100% = twice, 0 = none). Shared by both models, as are the input TRIM / GUARD and the output stage.
// OUTPUT: the house output stage, CLIP always on (no keys; band SAT, BIAS, LOW / HIGH bands and CEILING in the
//   parameter list, as on the originals).
// MODEL SWITCH: only the selected model runs (CPU = that model). A change crossfades the outgoing model (frozen at
//   its settings) into the incoming one over 20 ms; the incoming model starts from a clean, reset state.
// PRESETS: the house preset bar. "Init" = GUITAR at its defaults, "BASS: Init" = BASS at its defaults; choosing one
//   also selects its model. "Reset all to defaults" (in the list) resets both models, the MODEL and the shared
//   settings. A preset for the model in use changes without a click (the output ducks for a moment while the new
//   settings go in); one for the other model crossfades.

import gfx-drift.jsfx-inc
import gfx-input.jsfx-inc
import gfx-output.jsfx-inc
import gfx-ui.jsfx-inc
import gfx-panel.jsfx-inc
import gfx-dyn.jsfx-inc
import gfx-faceplate.jsfx-inc
import gfx-instrument.jsfx-inc
import gfx-headsmooth.jsfx-inc
import gfx-amp.jsfx-inc

slider1:0<0,1,1{Guitar,Bass}>-Model
slider2:5<0,10,0.1>-GUITAR Gain
slider3:0<0,1,1{Off,On}>-GUITAR Bright
slider4:0<0,1,1{Clean,Drive}>-GUITAR Channel
slider5:5<0,10,0.1>-GUITAR Bass
slider6:5<0,10,0.1>-GUITAR Middle
slider7:5<0,10,0.1>-GUITAR Treble
slider8:5<0,10,0.1>-GUITAR Presence
slider9:4<0,10,0.1>-GUITAR Master
slider10:2<0,10,0.1>-GUITAR Reverb
slider11:-80<-80,-20,0.5>-GUITAR Gate threshold (dB, -80 = off)
slider12:1<0,2,1{Off,2x12 open,4x12 closed}>-GUITAR Cabinet
slider13:3<0,10,0.1>-GUITAR Mic position (on - off axis)
slider14:0<-24,12,0.1>-GUITAR Output (dB)
slider15:0<0,1,1{Off,On}>-GUITAR Tuner (mutes)
slider16:0<0,1,1{Off,On}>-GUITAR Mono in
slider17:4<0,10,0.1>-BASS Gain
slider18:0<0,1,1{Off,On}>-BASS Ultra lo
slider19:0<0,1,1{Off,On}>-BASS Ultra hi
slider20:0<-12,12,0.1>-BASS Bass (dB)
slider21:0<-12,12,0.1>-BASS Midrange (dB)
slider22:1<0,4,1{220 Hz,450 Hz,800 Hz,1.6 kHz,3 kHz}>-BASS Midrange frequency
slider23:0<-12,12,0.1>-BASS Treble (dB)
slider24:4<0,10,0.1>-BASS Master
slider25:-80<-80,-20,0.5>-BASS Gate threshold (dB, -80 = off)
slider26:1<0,1,1{Off,On}>-BASS Cabinet
slider27:3<0,10,0.1>-BASS Mic position (on - off axis)
slider28:0<0,100,1>-BASS DI blend (%)
slider29:0<-24,12,0.1>-BASS Output (dB)
slider30:0<0,1,1{Off,On}>-BASS Tuner (mutes)
slider31:0<-24,12,0.1>-Input trim (dB)
slider32:0<0,1,1{Off,On}>-Input guard
slider33:25<0,100,1>-Drift amount (%)
slider34:0.25<0.02,2,0.01>-Drift speed (Hz)
// DRIFT dial: scales how far the valves' bias wanders (the preamp valves and the power stage) and how fast
slider35:50<0,100,1>-Drift (%)
slider36:0<0,100,1>-Band sat (%)
slider37:30<0,100,1>-Bias (%)
slider38:120<40,400,1>-Sat low band (Hz)
slider39:6000<2000,16000,10>-Sat high band (Hz)
slider40:-0.3<-24,0,0.1>-Ceiling (dB)

in_pin:left input
in_pin:right input
out_pin:left output
out_pin:right output

@init
#ui_man = "gfx-amp-head";                         // the ? pop-up links to this manual
ext_noinit = 1;                                    // @init runs once; a sample-rate change re-inits from @block
// host automation for a run of sliders
function ah_autor(a, b) local(i) ( i = a; loop(b - a + 1, ui_auto(i); i += 1; ); );

// memory: GUITAR spring tanks 200000 (L) and 300000 (R); the tuner (gfx-amp) 960000 - 966143. BASS uses none.

// ================================================================ GUITAR (ported from gfx-guitar-head)
// ---------- the amp core, run at twice the sample rate ----------
// output transformer: the core saturates on flux (integrate, saturate, differentiate)
function ga_xf_run(ga_x, ga_k) instance(ga_ph, ga_sp) local(ga_s, ga_y) (
  ga_ph = ga_ph * ga_xf_lk + ga_x * ga_xf_c; ga_s = am_tanh(ga_ph * ga_k) / ga_k; ga_y = (ga_s - ga_sp * ga_xf_lk) / ga_xf_c; ga_sp = ga_s; ga_y;
);
// one amp channel (instance: ghL / ghR), in two halves: the preamp and its spring tank, then (after the two tank
// returns are blended, see GH_RVX) the power stage. The power supply (sup) is shared by both channels.
function ga_amp_pre(ga_x) instance(ga_ihp, ga_brt, ga_mil, ga_d2hp, ga_d2lp, ga_tb, ga_tm, ga_tt, ga_rv, ga_py, ga_ry) local(ga_y) (
  ga_y = ga_ihp.am_run(ga_x);
  ga_y = ga_brt.am_run(ga_y);                                // bright cap
  ga_y = am_tube(ga_y * ga_g1, ga_b1);                       // V1
  ga_y = ga_mil.am_run(ga_y);
  ga_s_drive ? (                                             // DRIVE: a second cascaded valve
    ga_y = ga_d2hp.am_run(ga_y); ga_y = ga_d2lp.am_run(ga_y);
    ga_y = am_tube(ga_y * ga_g2, ga_b2) * ga_c2;
  ) : ga_y *= ga_c1;
  ga_y = ga_tb.am_run(ga_y); ga_y = ga_tm.am_run(ga_y); ga_y = ga_tt.am_run(ga_y);     // tone stack
  ga_py = ga_y; ga_ry = ga_rv.am_spring_run(ga_y, 0.5);      // spring reverb tank
);
function ga_amp_post(ga_r) instance(ga_phc, ga_pres, ga_xfo, ga_py, ga_pa) local(ga_y) (
  ga_y = ga_py + ga_r * ga_rvw;                              // spring reverb return
  ga_y = am_tube(ga_y * 0.9, -0.04);                         // phase inverter
  ga_y = ga_phc.am_run(ga_y) * ga_pm;                        // into the power stage (MASTER)
  ga_y = ga_sup * am_tube(ga_y / ga_sup, 0.22);              // EL34-style push-pull: asymmetric, with supply sag
  ga_pa = abs(ga_y);                                         // what this channel draws from the shared supply
  ga_y = ga_pres.am_run(ga_y);                               // presence (after the power stage)
  ga_y = ga_xfo.ga_xf_run(ga_y + ga_pbias * ga_y * ga_y, 0.6);
  ga_y * ga_mk;
);
// the shared supply sags on whichever channel draws the most (one amp, one power supply)
function ga_amp_sag() local(ga_a) (
  ga_a = max(ga_ghL.ga_pa, ga_ghR.ga_pa);
  ga_sgenv += (ga_a - ga_sgenv) * (ga_a > ga_sgenv ? ga_sg_att : ga_sg_rel);
  ga_sup = 1 - 0.35 * min(ga_sgenv, 1);
);
// a spring tank with its delay lengths scaled by k (the two channels' tanks differ slightly: decorrelated L / R)
// (its members are the spring's own, see am_spring_init)
function ga_gh_tank(ga_mem, ga_fs, ga_k) instance(b1, b2, n1, n2, w1, w2) (
  b1 = ga_mem; n1 = floor(0.0371 * ga_k * ga_fs); b2 = ga_mem + n1 + 8; n2 = floor(0.0433 * ga_k * ga_fs);
  memset(ga_mem, 0, n1 + n2 + 16); w1 = 0; w2 = 0;
);
// one channel's filters (both channels get identical coefficients: the controls are linked)
function ga_amp_set() instance(ga_ihp, ga_brt, ga_mil, ga_d2hp, ga_d2lp, ga_tb, ga_tm, ga_tt, ga_phc, ga_pres) local(ga_fs2) (
  ga_fs2 = 2 * srate;
  ga_ihp.am_bq(1, 70, 0.7, 0, ga_fs2);
  ga_brt.am_bq(3, 2500, 0.6, slider3 ? 9 * (1 - slider2 / 13) : 0, ga_fs2);
  ga_mil.am_bq(0, slider4 ? 9000 : 12000, 0.7, 0, ga_fs2);
  ga_d2hp.am_bq(1, 160, 0.7, 0, ga_fs2);                     // tight low end into the second valve
  ga_d2lp.am_bq(0, 6500, 0.7, 0, ga_fs2);
  ga_tb.am_bq(4, 110, 0.7, (slider5 - 5) * 2.4, ga_fs2);
  ga_tm.am_bq(2, 700, 0.8, (slider6 - 5) * 2.4 - 2, ga_fs2);
  ga_tt.am_bq(3, 3200, 0.7, (slider7 - 5) * 2.4, ga_fs2);
  ga_pres.am_bq(3, 4500, 0.7, slider8 * 1.1 - 3, ga_fs2);
  ga_phc.am_bq(1, 40, 0.7, 0, ga_fs2);
);
function ga_update() (
  ga_g1 = 10 ^ ((slider2 * 3.4 - 4) / 20); ga_c1 = 1 / sqrt(ga_g1);             // -4 .. +30 dB into V1
  ga_g2 = 10 ^ ((slider2 * 1.4 + 6) / 20); ga_c2 = 0.32 * max(1, 2.2 - slider2 * 0.3);   // +6 .. +20 dB into V2 (DRIVE)
  ga_pm = 10 ^ ((slider9 * 3.2 - 14) / 20); ga_mk = 0.5 / (ga_pm ^ 0.55);       // -14 .. +18 dB into the power stage
  ga_ghL.ga_amp_set(); ga_ghR.ga_amp_set();
  ga_rvw = (slider10 / 10) ^ 1.5 * 0.9;
  ga_ghcabL.am_cab_set(slider12 == 1 ? 2 : slider12 == 2 ? 3 : 0, max(slider13 - 0.15, 0));    // the two mics a hair apart
  ga_ghcabR.am_cab_set(slider12 == 1 ? 2 : slider12 == 2 ? 3 : 0, min(slider13 + 0.15, 10));
  ga_out_t = 10 ^ (slider14 / 20);
  drift_macro(slider35);
  ga_drift = slider33 / 100 * dm_a; ga_dspd = slider34 * dm_s;
  // the switches the audio reads (held with the rest of the settings while a model is frozen or a preset ducks)
  ga_s_drive = slider4; ga_s_gate = slider11; ga_s_tun = slider15; ga_s_mono = slider16;
);
function ga_reset() (
  // all state back to zero (as a fresh instance), then the original @init
  ga_b1 = ga_b2 = ga_c1 = ga_c2 = ga_dinc = ga_drift = ga_dspd = ga_g1 = ga_g2 = ga_gh_g = ga_gh_mono = 0;
  ga_gh_rvx = ga_gh_w = ga_gh_xl = ga_gh_xr = ga_gh_yr = ga_mk = ga_mute_s = ga_out_s = ga_out_t = ga_pbias = 0;
  ga_pm = ga_rvw = ga_s_drive = ga_s_gate = ga_s_mono = ga_s_tun = ga_sg_att = ga_sg_rel = ga_sgenv = ga_sm = 0;
  ga_sup = ga_x = ga_xf_c = ga_xf_lk = ga_y = ga_z = ga_db1.a = ga_db1.b = ga_db1.ph = ga_db1.rm = ga_db1.v = 0;
  ga_db2.a = ga_db2.b = ga_db2.ph = ga_db2.rm = ga_db2.v = ga_ghcabl.c1.a1 = ga_ghcabl.c1.a2 = ga_ghcabl.c1.b0 = 0;
  ga_ghcabl.c1.b1 = ga_ghcabl.c1.b2 = ga_ghcabl.c1.x1 = ga_ghcabl.c1.x2 = ga_ghcabl.c1.y1 = ga_ghcabl.c1.y2 = 0;
  ga_ghcabl.c2.a1 = ga_ghcabl.c2.a2 = ga_ghcabl.c2.b0 = ga_ghcabl.c2.b1 = ga_ghcabl.c2.b2 = ga_ghcabl.c2.x1 = 0;
  ga_ghcabl.c2.x2 = ga_ghcabl.c2.y1 = ga_ghcabl.c2.y2 = ga_ghcabl.c3.a1 = ga_ghcabl.c3.a2 = ga_ghcabl.c3.b0 = 0;
  ga_ghcabl.c3.b1 = ga_ghcabl.c3.b2 = ga_ghcabl.c3.x1 = ga_ghcabl.c3.x2 = ga_ghcabl.c3.y1 = ga_ghcabl.c3.y2 = 0;
  ga_ghcabl.c4.a1 = ga_ghcabl.c4.a2 = ga_ghcabl.c4.b0 = ga_ghcabl.c4.b1 = ga_ghcabl.c4.b2 = ga_ghcabl.c4.x1 = 0;
  ga_ghcabl.c4.x2 = ga_ghcabl.c4.y1 = ga_ghcabl.c4.y2 = ga_ghcabl.c5.a1 = ga_ghcabl.c5.a2 = ga_ghcabl.c5.b0 = 0;
  ga_ghcabl.c5.b1 = ga_ghcabl.c5.b2 = ga_ghcabl.c5.x1 = ga_ghcabl.c5.x2 = ga_ghcabl.c5.y1 = ga_ghcabl.c5.y2 = 0;
  ga_ghcabl.c6.a1 = ga_ghcabl.c6.a2 = ga_ghcabl.c6.b0 = ga_ghcabl.c6.b1 = ga_ghcabl.c6.b2 = ga_ghcabl.c6.x1 = 0;
  ga_ghcabl.c6.x2 = ga_ghcabl.c6.y1 = ga_ghcabl.c6.y2 = ga_ghcabl.c7.a1 = ga_ghcabl.c7.a2 = ga_ghcabl.c7.b0 = 0;
  ga_ghcabl.c7.b1 = ga_ghcabl.c7.b2 = ga_ghcabl.c7.x1 = ga_ghcabl.c7.x2 = ga_ghcabl.c7.y1 = ga_ghcabl.c7.y2 = 0;
  ga_ghcabr.c1.a1 = ga_ghcabr.c1.a2 = ga_ghcabr.c1.b0 = ga_ghcabr.c1.b1 = ga_ghcabr.c1.b2 = ga_ghcabr.c1.x1 = 0;
  ga_ghcabr.c1.x2 = ga_ghcabr.c1.y1 = ga_ghcabr.c1.y2 = ga_ghcabr.c2.a1 = ga_ghcabr.c2.a2 = ga_ghcabr.c2.b0 = 0;
  ga_ghcabr.c2.b1 = ga_ghcabr.c2.b2 = ga_ghcabr.c2.x1 = ga_ghcabr.c2.x2 = ga_ghcabr.c2.y1 = ga_ghcabr.c2.y2 = 0;
  ga_ghcabr.c3.a1 = ga_ghcabr.c3.a2 = ga_ghcabr.c3.b0 = ga_ghcabr.c3.b1 = ga_ghcabr.c3.b2 = ga_ghcabr.c3.x1 = 0;
  ga_ghcabr.c3.x2 = ga_ghcabr.c3.y1 = ga_ghcabr.c3.y2 = ga_ghcabr.c4.a1 = ga_ghcabr.c4.a2 = ga_ghcabr.c4.b0 = 0;
  ga_ghcabr.c4.b1 = ga_ghcabr.c4.b2 = ga_ghcabr.c4.x1 = ga_ghcabr.c4.x2 = ga_ghcabr.c4.y1 = ga_ghcabr.c4.y2 = 0;
  ga_ghcabr.c5.a1 = ga_ghcabr.c5.a2 = ga_ghcabr.c5.b0 = ga_ghcabr.c5.b1 = ga_ghcabr.c5.b2 = ga_ghcabr.c5.x1 = 0;
  ga_ghcabr.c5.x2 = ga_ghcabr.c5.y1 = ga_ghcabr.c5.y2 = ga_ghcabr.c6.a1 = ga_ghcabr.c6.a2 = ga_ghcabr.c6.b0 = 0;
  ga_ghcabr.c6.b1 = ga_ghcabr.c6.b2 = ga_ghcabr.c6.x1 = ga_ghcabr.c6.x2 = ga_ghcabr.c6.y1 = ga_ghcabr.c6.y2 = 0;
  ga_ghcabr.c7.a1 = ga_ghcabr.c7.a2 = ga_ghcabr.c7.b0 = ga_ghcabr.c7.b1 = ga_ghcabr.c7.b2 = ga_ghcabr.c7.x1 = 0;
  ga_ghcabr.c7.x2 = ga_ghcabr.c7.y1 = ga_ghcabr.c7.y2 = ga_ghdnl.f1.a1 = ga_ghdnl.f1.a2 = ga_ghdnl.f1.b0 = 0;
  ga_ghdnl.f1.b1 = ga_ghdnl.f1.b2 = ga_ghdnl.f1.x1 = ga_ghdnl.f1.x2 = ga_ghdnl.f1.y1 = ga_ghdnl.f1.y2 = 0;
  ga_ghdnl.f2.a1 = ga_ghdnl.f2.a2 = ga_ghdnl.f2.b0 = ga_ghdnl.f2.b1 = ga_ghdnl.f2.b2 = ga_ghdnl.f2.x1 = 0;
  ga_ghdnl.f2.x2 = ga_ghdnl.f2.y1 = ga_ghdnl.f2.y2 = ga_ghdnl.f3.a1 = ga_ghdnl.f3.a2 = ga_ghdnl.f3.b0 = 0;
  ga_ghdnl.f3.b1 = ga_ghdnl.f3.b2 = ga_ghdnl.f3.x1 = ga_ghdnl.f3.x2 = ga_ghdnl.f3.y1 = ga_ghdnl.f3.y2 = 0;
  ga_ghdnl.f4.a1 = ga_ghdnl.f4.a2 = ga_ghdnl.f4.b0 = ga_ghdnl.f4.b1 = ga_ghdnl.f4.b2 = ga_ghdnl.f4.x1 = 0;
  ga_ghdnl.f4.x2 = ga_ghdnl.f4.y1 = ga_ghdnl.f4.y2 = ga_ghdnr.f1.a1 = ga_ghdnr.f1.a2 = ga_ghdnr.f1.b0 = 0;
  ga_ghdnr.f1.b1 = ga_ghdnr.f1.b2 = ga_ghdnr.f1.x1 = ga_ghdnr.f1.x2 = ga_ghdnr.f1.y1 = ga_ghdnr.f1.y2 = 0;
  ga_ghdnr.f2.a1 = ga_ghdnr.f2.a2 = ga_ghdnr.f2.b0 = ga_ghdnr.f2.b1 = ga_ghdnr.f2.b2 = ga_ghdnr.f2.x1 = 0;
  ga_ghdnr.f2.x2 = ga_ghdnr.f2.y1 = ga_ghdnr.f2.y2 = ga_ghdnr.f3.a1 = ga_ghdnr.f3.a2 = ga_ghdnr.f3.b0 = 0;
  ga_ghdnr.f3.b1 = ga_ghdnr.f3.b2 = ga_ghdnr.f3.x1 = ga_ghdnr.f3.x2 = ga_ghdnr.f3.y1 = ga_ghdnr.f3.y2 = 0;
  ga_ghdnr.f4.a1 = ga_ghdnr.f4.a2 = ga_ghdnr.f4.b0 = ga_ghdnr.f4.b1 = ga_ghdnr.f4.b2 = ga_ghdnr.f4.x1 = 0;
  ga_ghdnr.f4.x2 = ga_ghdnr.f4.y1 = ga_ghdnr.f4.y2 = ga_ghl.ga_brt.a1 = ga_ghl.ga_brt.a2 = ga_ghl.ga_brt.b0 = 0;
  ga_ghl.ga_brt.b1 = ga_ghl.ga_brt.b2 = ga_ghl.ga_brt.x1 = ga_ghl.ga_brt.x2 = ga_ghl.ga_brt.y1 = 0;
  ga_ghl.ga_brt.y2 = ga_ghl.ga_d2hp.a1 = ga_ghl.ga_d2hp.a2 = ga_ghl.ga_d2hp.b0 = ga_ghl.ga_d2hp.b1 = 0;
  ga_ghl.ga_d2hp.b2 = ga_ghl.ga_d2hp.x1 = ga_ghl.ga_d2hp.x2 = ga_ghl.ga_d2hp.y1 = ga_ghl.ga_d2hp.y2 = 0;
  ga_ghl.ga_d2lp.a1 = ga_ghl.ga_d2lp.a2 = ga_ghl.ga_d2lp.b0 = ga_ghl.ga_d2lp.b1 = ga_ghl.ga_d2lp.b2 = 0;
  ga_ghl.ga_d2lp.x1 = ga_ghl.ga_d2lp.x2 = ga_ghl.ga_d2lp.y1 = ga_ghl.ga_d2lp.y2 = ga_ghl.ga_ihp.a1 = 0;
  ga_ghl.ga_ihp.a2 = ga_ghl.ga_ihp.b0 = ga_ghl.ga_ihp.b1 = ga_ghl.ga_ihp.b2 = ga_ghl.ga_ihp.x1 = 0;
  ga_ghl.ga_ihp.x2 = ga_ghl.ga_ihp.y1 = ga_ghl.ga_ihp.y2 = ga_ghl.ga_mil.a1 = ga_ghl.ga_mil.a2 = 0;
  ga_ghl.ga_mil.b0 = ga_ghl.ga_mil.b1 = ga_ghl.ga_mil.b2 = ga_ghl.ga_mil.x1 = ga_ghl.ga_mil.x2 = 0;
  ga_ghl.ga_mil.y1 = ga_ghl.ga_mil.y2 = ga_ghl.ga_pa = ga_ghl.ga_phc.a1 = ga_ghl.ga_phc.a2 = ga_ghl.ga_phc.b0 = 0;
